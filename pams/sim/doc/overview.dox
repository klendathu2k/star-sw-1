/**
 * @defgroup PamsSim pams/sim — Simulation Interface Layer
 * @ingroup Pams
 * @{
 *
 * @brief GEANT-to-STAF bridge: converts raw GEANT banks into STAF tables
 *        and drives the GSTAR AGE geometry/physics engine.
 *
 * @details
 * `pams/sim/` is the simulation interface layer within the STAF (STAR Analysis
 * Framework).  It lives between the GEANT 3.21 / AGE simulation back-end and the
 * STAF table-based reconstruction chain.  Its main responsibilities are:
 *
 *  - Driving the GSTAR AGE geometry and physics engine (`gstar/`).
 *  - Controlling event flow, filtering, and HBOOK diagnostics (`control/`).
 *  - Converting raw GEANT hit banks into STAF table rows for every STAR detector
 *    via the GEANT-to-Table (g2t) converters (`g2t/`).
 *  - Digitising TPC pad signals in AGE (`dig/`).
 *  - Bridging the FORTRAN `agustep` step hook to the C++ maker infrastructure
 *    (`flux/`).
 *  - Supplying physics cross-section data files used by FLUKA, CALOR, and GHEISHA
 *    (`gphysdata/`).
 *  - Defining the shared IDL schemas for all simulation output tables (`idl/`).
 *
 * @par Subdirectories
 *
 * | Directory    | Contents                                                     |
 * |:-------------|:-------------------------------------------------------------|
 * | `g2t/`       | 40 FORTRAN converter functions, matching IDL schemas, helpers |
 * | `gstar/`     | `gstar.g` core, extra particles, input utility, pseudo-physics generator |
 * | `control/`   | `control.g` — `AGUDIGI` event filter and HBOOK histograms    |
 * | `dig/`       | `tpcedig.g` — TPC pad-response digitiser                     |
 * | `flux/`      | `agustep.cxx` — C++ bridge from FORTRAN `agustep` hook       |
 * | `gphysdata/` | `bertaf.dat`, `chetc.dat`, `flukaaf.dat`, `xsneut96.dat`     |
 * | `idl/`       | 36 shared IDL table schemas for simulation output            |
 *
 * @par Data flow
 *
 * @code
 * St_geant_Maker (C++)
 *   |
 *   +-- agustep() [FORTRAN hook] --> flux/agustep.cxx --> St_geant_Maker::usflux()
 *   |
 *   +-- AGUDIGI (AGE) --> control/control.g  [event filter, histograms]
 *   |
 *   +-- G2T_GET_KINE()  --> g2t_track, g2t_vertex
 *   +-- G2T_GET_EVENT() --> g2t_event, g2t_pythia
 *   +-- G2T_PARTICLE()  --> g2t_gepart
 *   +-- G2T_TPC()       --> g2t_tpc_hit   (+ tpcedig digitisation)
 *   +-- G2T_SVT()       --> g2t_svt_hit
 *   +-- G2T_EMC()       --> g2t_emc_hit
 *   ... (one call per detector)
 *   |
 *   v
 * STAF tables consumed by reconstruction makers
 * @endcode
 */

/* =========================================================================
 * FORTRAN functions — g2t/
 * =========================================================================*/

/**
 * @fn INTEGER G2T_GET_KINE(p_vert_h, p_vert, g2t_track_h, g2t_track, g2t_vertex_h, g2t_vertex)
 * @brief Convert GEANT kinematic banks into the track and vertex tables.
 *
 * @param[in]  p_vert_h        Header of the primary-vertex input table
 * @param[in]  p_vert          Primary-vertex input table array
 * @param[out] g2t_track_h     Header of the output g2t_track table
 * @param[out] g2t_track       Output g2t_track table array (one row per GEANT track)
 * @param[out] g2t_vertex_h    Header of the output g2t_vertex table
 * @param[out] g2t_vertex      Output g2t_vertex table array (one row per vertex)
 * @returns STAFCV_OK on success.
 *
 * @details
 * Iterates over all GEANT tracks (`GCKINE`), resolves track/vertex linkage, and
 * fills kinematic quantities (`p`, `pt`, `e`, `charge`, `eta`, `rapidity`).
 * Close secondary vertices are grouped to suppress artificially split vertices.
 * The function also resolves linked-list pointers between tracks and vertices
 * (`start_vertex_p`, `stop_vertex_p`, `daughter_p`, `parent_p`).
 */

/**
 * @fn INTEGER G2T_GET_EVENT(g2t_event_h, g2t_event, g2t_pythia_h, g2t_pythia)
 * @brief Fill the per-event header table from GEANT and PYTHIA common blocks.
 *
 * @param[out] g2t_event_h     Header of the output g2t_event table
 * @param[out] g2t_event       Output g2t_event table (one row per event)
 * @param[out] g2t_pythia_h    Header of the output g2t_pythia table
 * @param[out] g2t_pythia      Output g2t_pythia table (one row per event, if PYTHIA)
 * @returns STAFCV_OK on success.
 *
 * @details
 * Reads GEANT random seeds, event and run numbers, primary-vertex pointer, and
 * heavy-ion geometry (`b_impact`, `phi_impact`, participant nucleon counts).
 * When a PYTHIA subprocess is present the hard-scattering kinematics (Mandelstam
 * variables, Bjorken-x, `subprocess_id`, `MSTU72`, `MSTU73`, `MSTP111`) are
 * written to `g2t_pythia`.
 */

/**
 * @fn INTEGER G2T_GET_PYTHIA(g2t_pythia_h, g2t_pythia)
 * @brief Fill the PYTHIA hard-subprocess table from PYTHIA common blocks.
 *
 * @param[out] g2t_pythia_h    Header of the output g2t_pythia table
 * @param[out] g2t_pythia      Output g2t_pythia table array
 * @returns STAFCV_OK on success.
 *
 * @details
 * Reads PYSUBS/PYDAT common blocks to store Mandelstam invariants, Bjorken-x
 * values, pT of the hard subprocess, and selected MSTU/MSTP variables.
 */

/**
 * @fn INTEGER G2T_PARTICLE(particle_h, particle)
 * @brief Fill the particle-property table from GEANT particle definitions.
 *
 * @param[out] particle_h  Header of the output g2t_gepart table
 * @param[out] particle    Output g2t_gepart table array (one row per particle type)
 * @returns STAFCV_OK on success.
 *
 * @details
 * Iterates over all defined GEANT particles and copies name, GEANT PID, PDG PID,
 * event-generator PID, mass, charge, and lifetime into `g2t_gepart`.
 */

/**
 * @fn SUBROUTINE G2R_GET_SYS(Cset, Cdet, Iprin, Idigi)
 * @brief Query AGE hit-set flags to retrieve print and digitisation control codes.
 *
 * @param[in]  Cset   Four-character AGE set name (e.g. `'TPCE'`)
 * @param[in]  Cdet   Four-character AGE detector name (e.g. `'TPAD'`)
 * @param[out] Iprin  Print verbosity level; negative value means skip this detector
 * @param[out] Idigi  Digitisation mode flag (0 = global coords, ≥2 = local coords)
 *
 * @details
 * Calls `ISLFLAG` and `AgHITSET` to look up whether the hit set is active.
 * Returns `Iprin < 0` when the set is disabled so that callers can return early.
 */

/**
 * @fn INTEGER G2T_TPC(g2t_track_h, g2t_track, g2t_tpc_hit_h, g2t_tpc_hit)
 * @brief GEANT-to-Table converter for the Time Projection Chamber.
 *
 * @param[in]  g2t_track_h      Header of the input g2t_track table
 * @param[in]  g2t_track        Input g2t_track array (for per-track linkage)
 * @param[out] g2t_tpc_hit_h    Header of the output g2t_tpc_hit table
 * @param[out] g2t_tpc_hit      Output g2t_tpc_hit array (one row per pad-row crossing)
 * @returns STAFCV_OK on success.
 *
 * @details
 * Iterates over GEANT steps in the TPC via `G2R_GET_HIT('tpc')`.  Applies a
 * magnetic-field correction to the straight-line parametrisation when
 * `Idigi < 2`.  Short after-steps on the same track/volume are suppressed.
 * Fills `volume_id` as `100000*isdet + 100*sector + row` and stores energy
 * deposition, path length, global coordinates, momentum, TOF, track length,
 * and `lgam = log10(E_kin/m)`.
 */

/**
 * @fn INTEGER G2T_SVT(g2t_track_h, g2t_track, g2t_svt_hit_h, g2t_svt_hit)
 * @brief GEANT-to-Table converter for the Silicon Vertex Tracker.
 *
 * @param[in]  g2t_track_h    Header of the input g2t_track table
 * @param[in]  g2t_track      Input g2t_track array
 * @param[out] g2t_svt_hit_h  Header of the output g2t_svt_hit table
 * @param[out] g2t_svt_hit    Output g2t_svt_hit array
 * @returns STAFCV_OK on success.
 *
 * @details
 * Reads SVT GEANT hits and fills position, local momentum, energy loss, step
 * size, and TOF.  Local coordinate mode is active by default (`Local=.true.`).
 */

/**
 * @fn INTEGER G2T_EMC(g2t_track_h, g2t_track, g2t_emc_hit_h, g2t_emc_hit)
 * @brief GEANT-to-Table converter for the Barrel Electromagnetic Calorimeter.
 *
 * @param[in]  g2t_track_h    Header of the input g2t_track table
 * @param[in]  g2t_track      Input g2t_track array
 * @param[out] g2t_emc_hit_h  Header of the output g2t_emc_hit table
 * @param[out] g2t_emc_hit    Output g2t_emc_hit array
 * @returns STAFCV_OK on success.
 *
 * @details
 * Fills global (x, y, z) hit position and energy deposition.  Uses local
 * coordinates internally (`Local=.true.`).
 */

/**
 * @fn INTEGER G2T_BBC(g2t_track_h, g2t_track, g2t_bbc_hit_h, g2t_bbc_hit)
