 * @fn INTEGER G2T_WCA(g2t_track_h, g2t_track, g2t_wca_hit_h, g2t_wca_hit)
 * @brief GEANT-to-Table converter for the West Calorimeter.
 * @param[in]  g2t_track_h    Input track table header
 * @param[in]  g2t_track      Input track table
 * @param[out] g2t_wca_hit_h  Output hit table header
 * @param[out] g2t_wca_hit    Output hit table
 * @returns STAFCV_OK on success.
 */

/**
 * @fn INTEGER G2T_ZDC(g2t_track_h, g2t_track, g2t_zdc_hit_h, g2t_zdc_hit)
 * @brief GEANT-to-Table converter for the Zero Degree Calorimeter.
 * @param[in]  g2t_track_h    Input track table header
 * @param[in]  g2t_track      Input track table
 * @param[out] g2t_zdc_hit_h  Output hit table header
 * @param[out] g2t_zdc_hit    Output hit table
 * @returns STAFCV_OK on success.
 */

/* =========================================================================
 * IDL table structs — idl/
 * =========================================================================*/

/**
 * @struct g2t_track
 * @brief One row per GEANT track; central table of the simulation output.
 *
 * Defined in `idl/g2t_track.idl`.
 *
 * @var g2t_track::id
 *   Primary key (1-based track index).
 * @var g2t_track::eg_label
 *   Event-generator label; 0 for pure GEANT secondary tracks.
 * @var g2t_track::eg_pid
 *   Event-generator particle identifier.
 * @var g2t_track::ge_pid
 *   GEANT particle identifier.
 * @var g2t_track::p
 *   3-momentum vector (GeV/c).
 * @var g2t_track::pt
 *   Transverse momentum (GeV/c).
 * @var g2t_track::ptot
 *   Total momentum magnitude (GeV/c).
 * @var g2t_track::e
 *   Total energy (GeV).
 * @var g2t_track::charge
 *   Electric charge in units of the elementary charge.
 * @var g2t_track::eta
 *   Pseudorapidity.
 * @var g2t_track::rapidity
 *   Rapidity.
 * @var g2t_track::is_shower
 *   1 if this is a shower track, 0 otherwise.
 * @var g2t_track::start_vertex_p
 *   Pointer to the production vertex in @ref g2t_vertex.
 * @var g2t_track::stop_vertex_p
 *   Pointer to the absorption/decay vertex in @ref g2t_vertex.
 * @var g2t_track::next_parent_p
 *   Next track that shares the same parent vertex.
 * @var g2t_track::next_vtx_trk_p
 *   Next sibling track from the same start vertex.
 * @var g2t_track::itrmd_vertex_p
 *   Head of the linked list of intermediate vertices on this track.
 * @var g2t_track::hit_tpc_p
 *   Head of the linked list of TPC hits in @ref g2t_tpc_hit.
 * @var g2t_track::n_tpc_hit
 *   Number of TPC hits; upper bits (after shift by 8) encode the TpcRS
 *   real-hit count.
 * @var g2t_track::hit_svt_p
 *   Head of the linked list of SVT hits (and similarly for every other
 *   detector: hit_emc_p, hit_tof_p, …, hit_epd_p).
 */

/**
 * @struct g2t_vertex
 * @brief One row per GEANT production or decay vertex.
 *
 * Defined in `idl/g2t_vertex.idl`.
 *
 * @var g2t_vertex::id
 *   Primary key.
 * @var g2t_vertex::ge_x
 *   GEANT vertex position in cm (Cartesian global).
 * @var g2t_vertex::ge_tof
 *   GEANT vertex production time in seconds.
 * @var g2t_vertex::ge_medium
 *   GEANT medium number at the vertex.
 * @var g2t_vertex::ge_proc
 *   GEANT process code; 0 indicates an event-generator vertex.
 * @var g2t_vertex::ge_volume
 *   Four-character GEANT volume name at the vertex.
 * @var g2t_vertex::eg_x
 *   Event-generator vertex coordinates in cm.
 * @var g2t_vertex::eg_tof
 *   Event-generator vertex production time in seconds.
 * @var g2t_vertex::eg_label
 *   Generator label (0 if this is a pure GEANT vertex).
 * @var g2t_vertex::eg_proc
 *   Generator production mechanism code.
 * @var g2t_vertex::n_daughter
 *   Number of outgoing (daughter) tracks.
 * @var g2t_vertex::n_parent
 *   Number of incoming (parent) tracks.
 * @var g2t_vertex::daughter_p
 *   Pointer to the first daughter track in @ref g2t_track.
 * @var g2t_vertex::parent_p
 *   Pointer to the first parent track in @ref g2t_track.
 * @var g2t_vertex::is_itrmd
 *   Flags this as an intermediate (secondary) vertex.
 * @var g2t_vertex::next_prim_v_p
 *   Next primary vertex in the linked list.
 * @var g2t_vertex::next_itrmd_p
 *   Next intermediate vertex in the linked list.
 * @var g2t_vertex::event_p
 *   Pointer to the owning row in @ref g2t_event.
 */

/**
 * @struct g2t_tpc_hit
 * @brief One row per TPC pad-row crossing (GEANT step in a TPC pad volume).
 *
 * Defined in `idl/g2t_tpc_hit.idl`.
 *
 * @var g2t_tpc_hit::id
 *   Primary key.
 * @var g2t_tpc_hit::track_p
 *   Pointer to the parent track in @ref g2t_track.
 * @var g2t_tpc_hit::next_tr_hit_p
 *   Next TPC hit on the same track (linked list).
 * @var g2t_tpc_hit::volume_id
 *   Encoded as @c 100000*isdet + 100*sector + row, where isdet = 1 (inner)
 *   or 2 (outer TPC).
 * @var g2t_tpc_hit::x
 *   Global hit position in cm.
 * @var g2t_tpc_hit::p
 *   Global track momentum at the hit in GeV/c.
 * @var g2t_tpc_hit::de
 *   Energy deposition from GEANT in GeV.
 * @var g2t_tpc_hit::ds
 *   Path length within the pad row in cm.
 * @var g2t_tpc_hit::tof
 *   Time of flight from the primary interaction vertex in seconds.
 * @var g2t_tpc_hit::length
 *   Track length from its origin to this hit in cm.
 * @var g2t_tpc_hit::lgam
 *   log₁₀(E_kin / m); used for Bethe–Bloch dE/dx evaluation.
 * @var g2t_tpc_hit::np
 *   Number of primary ionisation clusters.
 * @var g2t_tpc_hit::ne
 *   Number of conducting electrons.
 * @var g2t_tpc_hit::adc
 *   Digitised ADC signal after `tpcedig` pad-response digitisation.
 * @var g2t_tpc_hit::pad
 *   Pad position used in the digitisation.
 * @var g2t_tpc_hit::timebucket
 *   Time-bucket position used in the digitisation.
 * @var g2t_tpc_hit::adcs
 *   ADC signal in the three neighbouring rows: row−1, row, row+1.
 * @var g2t_tpc_hit::dNdx
 *   dN/dx at the local track momentum, filled by TpcRS.
 * @var g2t_tpc_hit::dSSum
 *   Accumulated dx in the TpcRS simulation in cm.
 * @var g2t_tpc_hit::dESum
 *   Accumulated dE in the TpcRS simulation in GeV.
 */

/**
 * @struct g2t_event
 * @brief Per-event metadata and heavy-ion geometry.
 *
 * Defined in `idl/g2t_event.idl`.  One row per simulated event.
 *
 * @var g2t_event::n_event
 *   Event number within the run.
 * @var g2t_event::n_run
 *   Run number.
 * @var g2t_event::b_impact
 *   Impact parameter in fm.
 * @var g2t_event::phi_impact
 *   Azimuthal angle of the reaction plane in radians.
 * @var g2t_event::prim_vertex_p
 *   Pointer to the first primary vertex in @ref g2t_vertex.
 * @var g2t_event::n_track_prim
 *   Number of primary tracks (tracks with no parent).
 * @var g2t_event::n_track_eg_fs
 *   Number of final-state event-generator tracks.
 * @var g2t_event::ge_rndm
 *   GEANT random seeds at the start of the event (two integers).
 * @var g2t_event::event_type
 *   Classifies the event: trigger, pileup, cosmic, or laser.
 * @var g2t_event::subprocess_id
 *   PYTHIA subprocess identifier (0 if not a PYTHIA event).
 * @var g2t_event::n_binary
 *   Number of binary nucleon–nucleon collisions (heavy-ion).
 * @var g2t_event::n_wounded_east
 *   Number of wounded nucleons in the east nucleus.
 * @var g2t_event::n_wounded_west
 *   Number of wounded nucleons in the west nucleus.
 * @var g2t_event::n_rejected
 *   Number of events rejected prior to this one (by control.g filter).
 */

/**
 * @struct g2t_gepart
 * @brief GEANT particle property table (one row per particle type).
 *
 * Defined in `idl/g2t_gepart.idl`.
 *
 * @var g2t_gepart::pid
 *   GEANT particle identifier.
 * @var g2t_gepart::pdg_pid
 *   PDG Monte Carlo particle identifier.
 * @var g2t_gepart::eg_pid
 *   Event-generator particle identifier.
 * @var g2t_gepart::napart
 *   32-character particle name.
 * @var g2t_gepart::amass
 *   Mass in GeV/c².
 * @var g2t_gepart::charge
 *   Charge in units of e.
 * @var g2t_gepart::tlife
 *   Lifetime in seconds.
 */

/**
 * @struct g2t_svt_hit
 * @brief One row per SVT GEANT hit.
 *
 * Defined in `idl/g2t_svt_hit.idl`.  Canonical silicon hit schema reused
 * (with minor variations) by IST, SSD, PIX, IGT, and FST converters.
 *
 * @var g2t_svt_hit::id            Primary key.
 * @var g2t_svt_hit::track_p       Parent track pointer in @ref g2t_track.
 * @var g2t_svt_hit::next_tr_hit_p Next SVT hit on the same track.
 * @var g2t_svt_hit::volume_id     STAR volume identifier.
 * @var g2t_svt_hit::x             Hit position in local coordinates (cm).
 * @var g2t_svt_hit::p             Local track momentum (GeV/c).
 * @var g2t_svt_hit::de            Energy loss (GeV).
 * @var g2t_svt_hit::ds            Step size within the volume (cm).
 * @var g2t_svt_hit::tof           Time of flight (s).
 */

/**
 * @struct g2t_pythia
 * @brief PYTHIA hard-subprocess kinematics; one row per PYTHIA event.
 *
 * Defined in `idl/g2t_pythia.idl`.
 *
 * @var g2t_pythia::subprocess_id  PYTHIA subprocess identifier.
 * @var g2t_pythia::mand_s         Mandelstam s of the hard subprocess (GeV²).
 * @var g2t_pythia::mand_t         Mandelstam t (GeV²).
 * @var g2t_pythia::mand_u         Mandelstam u (GeV²).
 * @var g2t_pythia::hard_p         pT of the hard subprocess in the partonic CM frame (GeV/c).
 * @var g2t_pythia::cos_th         cos θ of the hard subprocess in the partonic CM frame.
 * @var g2t_pythia::bjor_1         Bjorken x of the first parton after initial-state radiation.
 * @var g2t_pythia::bjor_2         Bjorken x of the second parton after initial-state radiation.
 * @var g2t_pythia::mstu72         PYTHIA internal variable MSTU(72).
 * @var g2t_pythia::mstu73         PYTHIA internal variable MSTU(73).
 * @var g2t_pythia::mstp111        PYTHIA internal variable MSTP(111).
 */

/** @} */ /* end group PamsSim */
