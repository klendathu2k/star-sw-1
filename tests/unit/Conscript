# StBFChain tests require the StBFChain shared library and its dependencies
# (St_db_Maker, StIOMaker, StTreeMaker, StarMagField).  The test uses only the
# parts of StBFChain that do not require a full STAR runtime (struct layout,
# construction, ParseString, SetTFile/GetTFile, StBFChainOpt delegation).
my $envBFC = $envTest->clone(
    'LIBS' => "-lStBFChain -lSt_db_Maker -lStIOMaker -lStTreeMaker -lStarMagField "
            . "-lStChallenger "
            . $envTest->{LIBS},
);
my @bfc_objs = Objects $envBFC "StBFChain/test_StBFChain.cxx";
Program $envBFC "test_StBFChain", (@catch_obj, @bfc_objs);
Install $envBFC $BIN, "test_StBFChain";

