                         _attribute = attr;           
                   }        
                   /// Material KAPTON         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Kapton");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Tubs");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=hbdarcrmin;           
                         shape.par("rmax")=hbdarcrmax;           
                         shape.par("phi1")=90.0;           
                         shape.par("phi2")=270.0;           
                         shape.par("dz")=halfhbdarclen;           
                         /// Shape Tubs rmin=hbdarcrmin rmax=hbdarcrmax phi1=90.0 phi2=270.0 dz=halfhbdarclen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBHC;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("IHCA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IHCA           
                         Create("IHCA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IHCA");           
                         place.SetMother("IBHC");           
                         /// Add daughter volume IHCA to mother IBHC           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-airinhbdhalflen+halfhbdarclen);           
                         /// Translate z = -airinhbdhalflen+halfhbdarclen           
                         _stacker -> Position( AgBlock::Find("IHCA"), place );           
                   } // end placement of IHCA        
                   END_OF_IBHC:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBHC  
