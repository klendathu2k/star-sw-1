                   }        
                   /// Loop on nsc from 1 to 2 step=1        
                   for ( nsc=1; (1>0)? (nsc<=2):(nsc>=2); nsc+=1 )        
                   {           
                         _create = AgCreate("ISCM");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ISCM              
                               Create("ISCM");               
                         }           
                         x=halfladwdt-halfendcapmomwdt-0.15;           
                         y=-halfladthk+2.4244+2*halfendcapmomthk-0.2845;           
                         istdgeo1a_trans_to_ibam( x,y,tilt,xp,yp );// CALL istdgeo1a_trans_to_ibam           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ISCM");              
                               place.SetMother("IBAM");              
                               /// Add daughter volume ISCM to mother IBAM              
                               place.TranslateX(xp);              
                               /// Translate x = xp              
                               place.TranslateY(yp);              
                               /// Translate y = yp              
                               place.TranslateZ(-halfladlen+outsidetubeeastlen+0.75+(1.5+halfcomblen)*(2*nsc-2));              
                               /// Translate z = -halfladlen+outsidetubeeastlen+0.75+(1.5+halfcomblen)*(2*nsc-2)              
                               place.par("only")=AgPosition::kMany;              
                               /// Overlap: agposition::kmany              
                               place.AlphaZ(-1.0*tilt);              
                               /// Rotate: AlphaZ = -1.0*tilt              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ISCM"), place );              
                         } // end placement of ISCM           
                   }        
                   /// Loop on ns from 1 to 2 step=1        
                   for ( ns=1; (1>0)? (ns<=2):(ns>=2); ns+=1 )        
                   {           
                         _create = AgCreate("IBSR");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create IBSR              
                               Create("IBSR");               
                         }           
                         x=halfladwdt-1.0*halfsrmomwdt;           
                         y=halfsrmomthk-1.0*halfladthk;           
                         istdgeo1a_trans_to_ibam( x,y,tilt,xp,yp );// CALL istdgeo1a_trans_to_ibam           
                         {              
                               AgPosition  place;              
                               place.SetBlock("IBSR");              
                               place.SetMother("IBAM");              
                               /// Add daughter volume IBSR to mother IBAM              
                               place.TranslateX(xp);              
                               /// Translate x = xp              
                               place.TranslateY(yp);              
                               /// Translate y = yp              
                               place.TranslateZ(-halfladlen+9.9143+halfsrmomlen+58.88*(ns-1));              
                               /// Translate z = -halfladlen+9.9143+halfsrmomlen+58.88*(ns-1)              
                               place.par("only")=AgPosition::kMany;              
                               /// Overlap: agposition::kmany              
                               place.AlphaZ(-1.0*tilt);              
                               /// Rotate: AlphaZ = -1.0*tilt              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("IBSR"), place );              
                         } // end placement of IBSR           
                   }        
                   END_OF_IBAM:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBAM  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *ILCC::mInstance = 0;  
       AgBlock *ILCC::Instance(){     
                if ( mInstance==0 ) mInstance = new ILCC();     
                return mInstance;     
       }  
       void ILCC::Block( AgCreate create )  
       {      
             ///@addtogroup ILCC_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   { AgAttribute attr = AgAttribute("ILCC");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfcombwdt;           
                         shape.par("dy")=halfcombthk;           
                         shape.par("dz")=halfcomblen;           
                         /// Shape Bbox dx=halfcombwdt dy=halfcombthk dz=halfcomblen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ILCC;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICCU");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICCU           
                         Create("ICCU");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICCU");           
                         place.SetMother("ILCC");           
                         /// Add daughter volume ICCU to mother ILCC           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halfcomblen+halfcomblenconnect);           
                         /// Translate z = -halfcomblen+halfcomblenconnect           
                         _stacker -> Position( AgBlock::Find("ICCU"), place );           
                   } // end placement of ICCU        
                   _create = AgCreate("ICCD");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICCD           
                         Create("ICCD");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICCD");           
                         place.SetMother("ILCC");           
                         /// Add daughter volume ICCD to mother ILCC           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfcomblenconnect);           
                         /// Translate z = halfcomblenconnect           
                         _stacker -> Position( AgBlock::Find("ICCD"), place );           
                   } // end placement of ICCD        
                   END_OF_ILCC:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ILCC  
