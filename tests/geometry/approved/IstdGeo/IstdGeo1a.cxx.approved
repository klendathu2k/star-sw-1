                     Bool_t _same_shape = true;        
                   /// Material Silicon         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Silicon");           
                         _material = mat;           
                   }        
                   /// Material PassiveSilicon isvol=0         
                   { AgMaterial &mat = AgMaterial::Get("Passivesilicon");           
                         mat.par("isvol")=0;           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBTS");           
                         attr.par("seen")=1;           
                         attr.par("colo")=2;           
                         attr.Inherit( AgBlock::previous() );            
