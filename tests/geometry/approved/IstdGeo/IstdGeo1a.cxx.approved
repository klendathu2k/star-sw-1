 void istdgeo1a_trans_to_ibam(Float_t  x,Float_t  y,Float_t  tilt,Float_t &xpos,Float_t &ypos) {    
    ///@addtogroup IstdGeo1a_vars     
    ///@{        
          double sint,cost,degrad,radius=13.9254;        
          //        
          /// double sint,cost,degrad,radius=13.9254        
    ///@}     
    degrad=3.1415926/180.0;     
    sint=sin(degrad*tilt);     
    cost=cos(degrad*tilt);     
    xpos=0.0+cost*x+sint*y;     
    ypos=radius-sint*x+cost*y;     
    return;     
 } // subroutine istdgeo1a_trans_to_ibam  
