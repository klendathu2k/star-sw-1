       AgBlock *IBSR::mInstance = 0;  
       AgBlock *IBSR::Instance(){     
                if ( mInstance==0 ) mInstance = new IBSR();     
                return mInstance;     
       }  
       void IBSR::Block( AgCreate create )  
       {      
             ///@addtogroup IBSR_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBSR");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfsrmomwdt;           
                         shape.par("dy")=halfsrmomthk;           
                         shape.par("dz")=halfsrmomlen;           
                         /// Shape Bbox dx=halfsrmomwdt dy=halfsrmomthk dz=halfsrmomlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBSR;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ISRR");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRR           
                         Create("ISRR");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRR");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRR to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.15-0.5*0.207);           
                         /// Translate x = halfsrmomwdt-0.15-0.5*0.207           
                         place.TranslateY(halfsrmomthk-0.7148-0.3-0.5*1.3553);           
                         /// Translate y = halfsrmomthk-0.7148-0.3-0.5*1.3553           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         _stacker -> Position( AgBlock::Find("ISRR"), place );           
                   } // end placement of ISRR        
                   _create = AgCreate("ISRB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRB           
                         Create("ISRB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRB");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRB to mother IBSR           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(halfsrmomthk-0.7148-0.5*0.3);           
                         /// Translate y = halfsrmomthk-0.7148-0.5*0.3           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         place.par("only")=AgPosition::kMany;           
                         /// Overlap: agposition::kmany           
                         _stacker -> Position( AgBlock::Find("ISRB"), place );           
                   } // end placement of ISRB        
                   _create = AgCreate("IRBA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IRBA           
                         Create("IRBA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IRBA");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume IRBA to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.15-0.5*0.3);           
                         /// Translate x = halfsrmomwdt-0.15-0.5*0.3           
                         place.TranslateY(halfsrmomthk-0.7148);           
                         /// Translate y = halfsrmomthk-0.7148           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         _stacker -> Position( AgBlock::Find("IRBA"), place );           
                   } // end placement of IRBA        
                   _create = AgCreate("ISRL");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRL           
                         Create("ISRL");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRL");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRL to mother IBSR           
                         place.TranslateX(-halfsrmomwdt+0.5*0.7452+0.23755);           
                         /// Translate x = -halfsrmomwdt+0.5*0.7452+0.23755           
                         place.TranslateY(halfsrmomthk-0.7148-0.3-0.1105-0.88655);           
                         /// Translate y = halfsrmomthk-0.7148-0.3-0.1105-0.88655           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         place.par("only")=AgPosition::kMany;           
                         /// Overlap: agposition::kmany           
                         place.AlphaZ(-75.0);           
                         /// Rotate: AlphaZ = -75.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISRL"), place );           
                   } // end placement of ISRL        
                   _create = AgCreate("ISRC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRC           
                         Create("ISRC");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRC");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRC to mother IBSR           
                         place.TranslateX(-halfsrmomwdt+0.3652);           
                         /// Translate x = -halfsrmomwdt+0.3652           
                         place.TranslateY(halfsrmomthk-0.7148-0.3-0.5*0.1105);           
                         /// Translate y = halfsrmomthk-0.7148-0.3-0.5*0.1105           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         _stacker -> Position( AgBlock::Find("ISRC"), place );           
                   } // end placement of ISRC        
                   _create = AgCreate("ISRA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRA           
                         Create("ISRA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRA");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRA to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.15+0.0882*moduleinnerradius);           
                         /// Translate x = halfsrmomwdt-0.15+0.0882*moduleinnerradius           
                         place.TranslateY(halfsrmomthk-0.7148-0.3-1.3553-0.153-0.9961*moduleinnerradius);           
                         /// Translate y = halfsrmomthk-0.7148-0.3-1.3553-0.153-0.9961*moduleinnerradius           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("ISRA"), place );           
                   } // end placement of ISRA        
                   _create = AgCreate("ISRO");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRO           
                         Create("ISRO");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRO");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRO to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.5*0.15);           
                         /// Translate x = halfsrmomwdt-0.5*0.15           
                         place.TranslateY(halfsrmomthk-0.5*0.7148);           
                         /// Translate y = halfsrmomthk-0.5*0.7148           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         _stacker -> Position( AgBlock::Find("ISRO"), place );           
                   } // end placement of ISRO        
                   _create = AgCreate("IROA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IROA           
                         Create("IROA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IROA");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume IROA to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.15);           
                         /// Translate x = halfsrmomwdt-0.15           
                         place.TranslateY(halfsrmomthk-0.1-0.5*0.2);           
                         /// Translate y = halfsrmomthk-0.1-0.5*0.2           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         place.AlphaZ(90.0);           
                         /// Rotate: AlphaZ = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("IROA"), place );           
                   } // end placement of IROA        
                   _create = AgCreate("ISRS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRS           
                         Create("ISRS");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRS");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRS to mother IBSR           
                         place.TranslateX(halfsrmomwdt-0.15-0.5*0.3116);           
                         /// Translate x = halfsrmomwdt-0.15-0.5*0.3116           
                         place.TranslateY(halfsrmomthk-0.5*0.1);           
                         /// Translate y = halfsrmomthk-0.5*0.1           
                         place.TranslateZ(-halfsrmomlen+0.5*0.9525);           
                         /// Translate z = -halfsrmomlen+0.5*0.9525           
                         _stacker -> Position( AgBlock::Find("ISRS"), place );           
                   } // end placement of ISRS        
                   _create = AgCreate("ISRH");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISRH           
                         Create("ISRH");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISRH");           
                         place.SetMother("IBSR");           
                         /// Add daughter volume ISRH to mother IBSR           
                         place.TranslateX(-halfsrmomwdt+0.3572);           
                         /// Translate x = -halfsrmomwdt+0.3572           
                         place.TranslateY(halfsrmomthk-0.7148-0.5*1.2438);           
                         /// Translate y = halfsrmomthk-0.7148-0.5*1.2438           
                         place.TranslateZ(-halfsrmomlen+0.47625);           
                         /// Translate z = -halfsrmomlen+0.47625           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISRH"), place );           
                   } // end placement of ISRH        
                   END_OF_IBSR:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBSR  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *ISRR::mInstance = 0;  
       AgBlock *ISRR::Instance(){     
                if ( mInstance==0 ) mInstance = new ISRR();     
                return mInstance;     
       }  
       void ISRR::Block( AgCreate create )  
       {      
             ///@addtogroup ISRR_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material PEEKCF30         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Peekcf30");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("ISRR");           
                         attr.par("seen")=1;           
                         attr.par("colo")=3;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=0.5*0.207;           
                         shape.par("dy")=0.5*1.3553;           
                         shape.par("dz")=0.5*0.9525;           
                         /// Shape Bbox dx=0.5*0.207 dy=0.5*1.3553 dz=0.5*0.9525            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ISRR;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_ISRR:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ISRR  
       // ---------------------------------------------------------------------------------------------------  
