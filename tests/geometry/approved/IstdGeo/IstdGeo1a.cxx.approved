             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("ISRH");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=0.0;           
                         shape.par("rmax")=0.5*0.3454;           
                         shape.par("dz")=0.5*1.2438;           
                         /// Shape Tube rmin=0.0 rmax=0.5*0.3454 dz=0.5*1.2438            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ISRH;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_ISRH:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ISRH  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *IBLM::mInstance = 0;  
       AgBlock *IBLM::Instance(){     
                if ( mInstance==0 ) mInstance = new IBLM();     
                return mInstance;     
       }  
       void IBLM::Block( AgCreate create )  
       {      
             ///@addtogroup IBLM_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBLM");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfsenmomwdt;           
                         shape.par("dy")=halfsenmomthk;           
                         shape.par("dz")=halfsenmomlen;           
                         /// Shape Bbox dx=halfsenmomwdt dy=halfsenmomthk dz=halfsenmomlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBLM;           
                         _stacker -> Build(this);           
                   }        
                   if ( istc.misalign==0||istc.misalign==2 )        
                   {           
                         _create = AgCreate("IBSS");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create IBSS              
                               Create("IBSS");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("IBSS");              
                               place.SetMother("IBLM");              
                               /// Add daughter volume IBSS to mother IBLM              
                               place.TranslateX(halfsenmomwdt-halfsensorwdt-2*halfsensoredget);              
                               /// Translate x = halfsenmomwdt-halfsensorwdt-2*halfsensoredget              
                               place.TranslateY(0.0);              
                               /// Translate y = 0.0              
                               place.TranslateZ(0.0);              
                               /// Translate z = 0.0              
                               place.AlphaZ(180);              
                               /// Rotate: AlphaZ = 180              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("IBSS"), place );              
                         } // end placement of IBSS           
                   }        
                   _create = AgCreate("IBTE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IBTE           
                         Create("IBTE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IBTE");           
                         place.SetMother("IBLM");           
                         /// Add daughter volume IBTE to mother IBLM           
                         place.TranslateX(halfsenmomwdt-halfsensoredget);           
                         /// Translate x = halfsenmomwdt-halfsensoredget           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IBTE"), place );           
                   } // end placement of IBTE        
                   _create = AgCreate("IBBE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IBBE           
                         Create("IBBE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IBBE");           
                         place.SetMother("IBLM");           
                         /// Add daughter volume IBBE to mother IBLM           
                         place.TranslateX(2*halfapvwdt+apvsensorgapsize+halfsensoredgeb-halfsenmomwdt);           
                         /// Translate x = 2*halfapvwdt+apvsensorgapsize+halfsensoredgeb-halfsenmomwdt           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IBBE"), place );           
                   } // end placement of IBBE        
                   _create = AgCreate("IBLE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IBLE           
                         Create("IBLE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IBLE");           
                         place.SetMother("IBLM");           
                         /// Add daughter volume IBLE to mother IBLM           
                         place.TranslateX(halfsenmomwdt-2.0);           
                         /// Translate x = halfsenmomwdt-2.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfsenmomlen-halfsensoredgelr-0.5*sensorgapsize);           
                         /// Translate z = halfsenmomlen-halfsensoredgelr-0.5*sensorgapsize           
                         _stacker -> Position( AgBlock::Find("IBLE"), place );           
                   } // end placement of IBLE        
                   _create = AgCreate("IBRE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IBRE           
                         Create("IBRE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IBRE");           
                         place.SetMother("IBLM");           
                         /// Add daughter volume IBRE to mother IBLM           
                         place.TranslateX(halfsenmomwdt-2.0);           
                         /// Translate x = halfsenmomwdt-2.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfsensoredgelr+0.5*sensorgapsize-halfsenmomlen);           
                         /// Translate z = halfsensoredgelr+0.5*sensorgapsize-halfsenmomlen           
                         _stacker -> Position( AgBlock::Find("IBRE"), place );           
                   } // end placement of IBRE        
                   /// Loop on num from 1 to napvunit step=1        
                   for ( num=1; (1>0)? (num<=napvunit):(num>=napvunit); num+=1 )        
                   {           
                         _create = AgCreate("IBAP");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create IBAP              
                               Create("IBAP");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("IBAP");              
                               place.SetMother("IBLM");              
                               /// Add daughter volume IBAP to mother IBLM              
                               place.TranslateX(-halfsenmomwdt+halfapvwdt);              
                               /// Translate x = -halfsenmomwdt+halfapvwdt              
                               place.TranslateY(0.0);              
                               /// Translate y = 0.0              
                               place.TranslateZ(-halfsenmomlen+halfapvlen*(2*num-1)+apvgapsize*(num-1)+0.36875);              
                               /// Translate z = -halfsenmomlen+halfapvlen*(2*num-1)+apvgapsize*(num-1)+0.36875              
                               _stacker -> Position( AgBlock::Find("IBAP"), place );              
                         } // end placement of IBAP           
                   }        
                   END_OF_IBLM:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBLM  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *IBTE::mInstance = 0;  
       AgBlock *IBTE::Instance(){     
                if ( mInstance==0 ) mInstance = new IBTE();     
                return mInstance;     
