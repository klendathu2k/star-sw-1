                         shape.par("dx")=halfhbdwdttb;           
                         shape.par("dy")=halfhbdthktbconnect;           
                         shape.par("dz")=halfhbdlentbconnect;           
                         /// Shape Bbox dx=halfhbdwdttb dy=halfhbdthktbconnect dz=halfhbdlentbconnect            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IHBC;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_IHBC:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IHBC  
