       AgBlock *ISCT::mInstance = 0;  
       AgBlock *ISCT::Instance(){     
                if ( mInstance==0 ) mInstance = new ISCT();     
                return mInstance;     
       }  
       void ISCT::Block( AgCreate create )  
       {      
             ///@addtogroup ISCT_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("ISCT");           
                         attr.par("seen")=0;           
                         attr.par("colo")=6;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=0;           
                         shape.par("rmax")=0.5*1.8331;           
                         shape.par("dz")=0.5*8.4642;           
                         /// Shape Tube rmin=0 rmax=0.5*1.8331 dz=0.5*8.4642            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ISCT;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICTJ");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTJ           
                         Create("ICTJ");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTJ");           
                         place.SetMother("ISCT");           
                         /// Add daughter volume ICTJ to mother ISCT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.5*8.4642-0.5*2.8889);           
                         /// Translate z = 0.5*8.4642-0.5*2.8889           
                         _stacker -> Position( AgBlock::Find("ICTJ"), place );           
                   } // end placement of ICTJ        
                   _create = AgCreate("ICTA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTA           
                         Create("ICTA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTA");           
                         place.SetMother("ISCT");           
                         /// Add daughter volume ICTA to mother ISCT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.5*8.4642-2.8889-0.5*0.1778);           
                         /// Translate z = 0.5*8.4642-2.8889-0.5*0.1778           
                         _stacker -> Position( AgBlock::Find("ICTA"), place );           
                   } // end placement of ICTA        
                   _create = AgCreate("ICTB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTB           
                         Create("ICTB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTB");           
                         place.SetMother("ISCT");           
                         /// Add daughter volume ICTB to mother ISCT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-0.5*8.4642+0.5*5.3975);           
                         /// Translate z = -0.5*8.4642+0.5*5.3975           
                         _stacker -> Position( AgBlock::Find("ICTB"), place );           
                   } // end placement of ICTB        
                   _create = AgCreate("ICLE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICLE           
                         Create("ICLE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICLE");           
                         place.SetMother("ISCT");           
                         /// Add daughter volume ICLE to mother ISCT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("ICLE"), place );           
                   } // end placement of ICLE        
                   END_OF_ISCT:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ISCT  
       // ---------------------------------------------------------------------------------------------------  
