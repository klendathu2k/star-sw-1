          /// Material CARBONFOAM a=12 z=6 dens=0.09 radl=42.7      
          { AgMaterial &mat = AgMaterial::Get("Carbonfoam");        
                mat.par("a")=12;        
                mat.par("z")=6;        
                mat.par("dens")=0.09;        
                mat.par("radl")=42.7;        
                _material = mat;        
          }     
          /// Component O	a=16	z=8	w=0.074     
          /// Component C	a=12	z=6	w=0.870     
          /// Component H	a=1	z=1	w=0.023     
          /// Component Cl	a=35.5	z=17	w=0.033     
          /// Mixture CFRPMix dens=0.03 radl=23.9     
          {  AgMaterial &mix = AgMaterial::Get("Cfrpmix");        
                mix.Component("O",16,8,0.074);        
                mix.Component("C",12,6,0.870);        
                mix.Component("H",1,1,0.023);        
                mix.Component("Cl",35.5,17,0.033);        
                mix.par("dens")=0.03;        
                mix.par("radl")=23.9;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=0.074     
          /// Component C	a=12	z=6	w=0.870     
          /// Component H	a=1	z=1	w=0.023     
          /// Component Cl	a=35.5	z=17	w=0.033     
          /// Mixture CFRPMix2 dens=1.60 radl=23.9     
          {  AgMaterial &mix = AgMaterial::Get("Cfrpmix2");        
                mix.Component("O",16,8,0.074);        
                mix.Component("C",12,6,0.870);        
                mix.Component("H",1,1,0.023);        
                mix.Component("Cl",35.5,17,0.033);        
                mix.par("dens")=1.60;        
                mix.par("radl")=23.9;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=0.117     
          /// Component C	a=12	z=6	w=0.854     
          /// Component H	a=1	z=1	w=0.029     
          /// Mixture PEEKCF30 dens=1.41 radl=25.0     
          {  AgMaterial &mix = AgMaterial::Get("Peekcf30");        
                mix.Component("O",16,8,0.117);        
                mix.Component("C",12,6,0.854);        
                mix.Component("H",1,1,0.029);        
                mix.par("dens")=1.41;        
                mix.par("radl")=25.0;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=0.210     
          /// Component C	a=12	z=6	w=0.691     
          /// Component H	a=1	z=1	w=0.026     
          /// Component N	a=14	z=7	w=0.073     
          /// Mixture KAPTON dens=1.42 radl=28.6     
          {  AgMaterial &mix = AgMaterial::Get("Kapton");        
                mix.Component("O",16,8,0.210);        
                mix.Component("C",12,6,0.691);        
                mix.Component("H",1,1,0.026);        
                mix.Component("N",14,7,0.073);        
                mix.par("dens")=1.42;        
                mix.par("radl")=28.6;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=0.061     
          /// Component H	a=1	z=1	w=0.019     
          /// Component C	a=12	z=6	w=0.272     
          /// Component F	a=19	z=9	w=0.648     
          /// Mixture NOVEC7200 dens=1.44     
          {  AgMaterial &mix = AgMaterial::Get("Novec7200");        
                mix.Component("O",16,8,0.061);        
                mix.Component("H",1,1,0.019);        
                mix.Component("C",12,6,0.272);        
                mix.Component("F",19,9,0.648);        
                mix.par("dens")=1.44;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=0.3*2*16/60.+0.7*3*16/288.     
          /// Component C	a=12	z=6	w=0.7*19*12/288.     
          /// Component Si	a=28.08	z=14	w=0.3*1*28/60.     
          /// Component H	a=1	z=1	w=0.7*12*1/288.     
          /// Mixture PEEKGF30 dens=1.49 radl=25.0     
          {  AgMaterial &mix = AgMaterial::Get("Peekgf30");        
                mix.Component("O",16,8,0.3*2*16/60.+0.7*3*16/288.);        
                mix.Component("C",12,6,0.7*19*12/288.);        
                mix.Component("Si",28.08,14,0.3*1*28/60.);        
                mix.Component("H",1,1,0.7*12*1/288.);        
                mix.par("dens")=1.49;        
                mix.par("radl")=25.0;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component Si	a=28.08	z=14	w=0.6*1*28./60.     
          /// Component O	a=16	z=8	w=0.6*2*16./60.+0.4*4*16./174.     
          /// Component C	a=12	z=6	w=0.4*8*12./174.     
          /// Component H	a=1	z=1	w=0.4*14*1./174.     
          /// Mixture G10 dens=1.7     
          {  AgMaterial &mix = AgMaterial::Get("G10");        
                mix.Component("Si",28.08,14,0.6*1*28./60.);        
                mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);        
                mix.Component("C",12,6,0.4*8*12./174.);        
                mix.Component("H",1,1,0.4*14*1./174.);        
                mix.par("dens")=1.7;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component O	a=16	z=8	w=2*16./100.     
          /// Component C	a=12	z=6	w=5*12./100.     
          /// Component H	a=1	z=1	w=8*1./100.     
          /// Mixture DELRIN dens=1.2     
          {  AgMaterial &mix = AgMaterial::Get("Delrin");        
                mix.Component("O",16,8,2*16./100.);        
                mix.Component("C",12,6,5*12./100.);        
                mix.Component("H",1,1,8*1./100.);        
                mix.par("dens")=1.2;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component Si	a=28.1	z=14	w=0.191     
          /// Component O	a=16	z=8	w=0.339     
          /// Component C	a=12	z=6	w=0.213     
          /// Component H	a=1	z=1	w=0.028     
          /// Component Cl	a=35.5	z=17	w=0.009     
          /// Component Cu	a=63.5	z=29	w=0.122     
          /// Component Pb	a=207	z=82	w=0.039     
          /// Component Sn	a=118.7	z=50	w=0.059     
          /// Mixture APVMix dens=2.535     
          {  AgMaterial &mix = AgMaterial::Get("Apvmix");        
                mix.Component("Si",28.1,14,0.191);        
                mix.Component("O",16,8,0.339);        
                mix.Component("C",12,6,0.213);        
                mix.Component("H",1,1,0.028);        
                mix.Component("Cl",35.5,17,0.009);        
                mix.Component("Cu",63.5,29,0.122);        
                mix.Component("Pb",207,82,0.039);        
                mix.Component("Sn",118.7,50,0.059);        
                mix.par("dens")=2.535;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component Cu	a=63.5	z=29	w=0.856     
          /// Component Al	a=27	z=13	w=0.063     
          /// Component O	a=16	z=8	w=0.081*0.061     
          /// Component H	a=1	z=1	w=0.081*0.019     
          /// Component C	a=12	z=6	w=0.081*0.272     
          /// Component F	a=19	z=9	w=0.081*0.648     
          /// Mixture CuAlNovecMix dens=0.673     
          {  AgMaterial &mix = AgMaterial::Get("Cualnovecmix");        
                mix.Component("Cu",63.5,29,0.856);        
                mix.Component("Al",27,13,0.063);        
                mix.Component("O",16,8,0.081*0.061);        
                mix.Component("H",1,1,0.081*0.019);        
                mix.Component("C",12,6,0.081*0.272);        
                mix.Component("F",19,9,0.081*0.648);        
                mix.par("dens")=0.673;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          /// Component Al	a=27	z=13	w=0.57     
          /// Component O	a=16	z=8	w=0.43*0.061     
          /// Component H	a=1	z=1	w=0.43*0.019     
          /// Component C	a=12	z=6	w=0.43*0.272     
          /// Component F	a=19	z=9	w=0.43*0.648     
          /// Mixture AlNovecMix dens=1.961     
          {  AgMaterial &mix = AgMaterial::Get("Alnovecmix");        
                mix.Component("Al",27,13,0.57);        
                mix.Component("O",16,8,0.43*0.061);        
                mix.Component("H",1,1,0.43*0.019);        
                mix.Component("C",12,6,0.43*0.272);        
                mix.Component("F",19,9,0.43*0.648);        
                mix.par("dens")=1.961;        
                mix.lock();        
                _material = mix;        
                _material.lock();        
          }     
          raddeg=3.14159265/180.0;     
          moduleradius=13.9254;     
          ladder_thk=halfladthk*2;     
          ladder_width=halfladwdt*2;     
          ladder_length=halfladlen*2;     
          debug=0;     
          _create = AgCreate("ICCT");     
          {        
                AgShape myshape; // undefined shape        
                ///Create ICCT        
                Create("ICCT");         
          }     
          {        
                AgPosition  place;        
                place.SetBlock("ICCT");        
                place.SetMother("IDSM");        
                /// Add daughter volume ICCT to mother IDSM        
                place.TranslateX(0.0);        
                /// Translate x = 0.0        
                place.TranslateY(0.0);        
                /// Translate y = 0.0        
                place.TranslateZ(-53.0448-0.5*8.7144);        
                /// Translate z = -53.0448-0.5*8.7144        
                _stacker -> Position( AgBlock::Find("ICCT"), place );        
          } // end placement of ICCT     
          /// Loop on ncableset from 1 to 24 step=1     
          for ( ncableset=1; (1>0)? (ncableset<=24):(ncableset>=24); ncableset+=1 )     
          {        
                anglepit_a=(360.0/24)*(ncableset-1)-7.396;        
                anglepit_b=(360.0/24)*(ncableset-1)-9.337;        
                anglepit_c=(360.0/24)*(ncableset-1)-11.279;        
                anglepit_t=(360.0/24)*(ncableset-1)-4.045;        
                _create = AgCreate("ICCA");        
                {           
                      AgShape myshape; // undefined shape           
                      ///Create ICCA           
                      Create("ICCA");            
                }        
                {           
                      AgPosition  place;           
                      place.SetBlock("ICCA");           
                      place.SetMother("IDSM");           
                      /// Add daughter volume ICCA to mother IDSM           
                      place.TranslateX(24.3728*sin(anglepit_a*raddeg));           
                      /// Translate x = 24.3728*sin(anglepit_a*raddeg)           
                      place.TranslateY(24.3728*cos(anglepit_a*raddeg));           
                      /// Translate y = 24.3728*cos(anglepit_a*raddeg)           
                      place.TranslateZ(-231.9392+0.5*170.18);           
                      /// Translate z = -231.9392+0.5*170.18           
                      place.par("only")=AgPosition::kOnly;           
                      /// Overlap: agposition::konly           
                      _stacker -> Position( AgBlock::Find("ICCA"), place );           
                } // end placement of ICCA        
                {           
                      AgPosition  place;           
                      place.SetBlock("ICCA");           
                      place.SetMother("IDSM");           
                      /// Add daughter volume ICCA to mother IDSM           
                      place.TranslateX(24.3728*sin(anglepit_b*raddeg));           
                      /// Translate x = 24.3728*sin(anglepit_b*raddeg)           
                      place.TranslateY(24.3728*cos(anglepit_b*raddeg));           
                      /// Translate y = 24.3728*cos(anglepit_b*raddeg)           
                      place.TranslateZ(-231.9392+0.5*170.18);           
                      /// Translate z = -231.9392+0.5*170.18           
                      place.par("only")=AgPosition::kOnly;           
                      /// Overlap: agposition::konly           
                      _stacker -> Position( AgBlock::Find("ICCA"), place );           
                } // end placement of ICCA        
                {           
                      AgPosition  place;           
                      place.SetBlock("ICCA");           
                      place.SetMother("IDSM");           
                      /// Add daughter volume ICCA to mother IDSM           
                      place.TranslateX(24.3728*sin(anglepit_c*raddeg));           
                      /// Translate x = 24.3728*sin(anglepit_c*raddeg)           
                      place.TranslateY(24.3728*cos(anglepit_c*raddeg));           
                      /// Translate y = 24.3728*cos(anglepit_c*raddeg)           
                      place.TranslateZ(-231.9392+0.5*170.18);           
                      /// Translate z = -231.9392+0.5*170.18           
                      place.par("only")=AgPosition::kOnly;           
                      /// Overlap: agposition::konly           
                      _stacker -> Position( AgBlock::Find("ICCA"), place );           
                } // end placement of ICCA        
                _create = AgCreate("ICCL");        
                {           
                      AgShape myshape; // undefined shape           
                      ///Create ICCL           
                      Create("ICCL");            
                }        
                {           
                      AgPosition  place;           
                      place.SetBlock("ICCL");           
                      place.SetMother("IDSM");           
                      /// Add daughter volume ICCL to mother IDSM           
                      place.TranslateX(24.3855*sin(anglepit_t*raddeg));           
                      /// Translate x = 24.3855*sin(anglepit_t*raddeg)           
                      place.TranslateY(24.3855*cos(anglepit_t*raddeg));           
                      /// Translate y = 24.3855*cos(anglepit_t*raddeg)           
                      place.TranslateZ(-231.9392+0.5*170.18);           
                      /// Translate z = -231.9392+0.5*170.18           
                      place.par("only")=AgPosition::kOnly;           
                      /// Overlap: agposition::konly           
                      _stacker -> Position( AgBlock::Find("ICCL"), place );           
                } // end placement of ICCL        
                _create = AgCreate("ICLP");        
                {           
                      AgShape myshape; // undefined shape           
                      ///Create ICLP           
                      Create("ICLP");            
                }        
                {           
                      AgPosition  place;           
                      place.SetBlock("ICLP");           
                      place.SetMother("IDSM");           
                      /// Add daughter volume ICLP to mother IDSM           
                      place.TranslateX(24.3855*sin(anglepit_t*raddeg));           
                      /// Translate x = 24.3855*sin(anglepit_t*raddeg)           
                      place.TranslateY(24.3855*cos(anglepit_t*raddeg));           
                      /// Translate y = 24.3855*cos(anglepit_t*raddeg)           
                      place.TranslateZ(-231.9392+0.5*170.18);           
                      /// Translate z = -231.9392+0.5*170.18           
                      place.par("only")=AgPosition::kOnly;           
                      /// Overlap: agposition::konly           
                      _stacker -> Position( AgBlock::Find("ICLP"), place );           
                } // end placement of ICLP        
          }     
          _create = AgCreate("IBMO");     
          {        
                AgShape myshape; // undefined shape        
                ///Create IBMO        
                Create("IBMO");         
          }     
          {        
                AgPosition  place;        
                place.SetBlock("IBMO");        
                place.SetMother("IDSM");        
                /// Add daughter volume IBMO to mother IDSM        
                place.par("only")=AgPosition::kOnly;        
                /// Overlap: agposition::konly        
                place.Misalign("Geometry/ist/istOnPst",0,"left");        
                _stacker -> Position( AgBlock::Find("IBMO"), place );        
          } // end placement of IBMO     
    }; // IstdGeo1a  
 }; // namespace IstdGeo1a  
 