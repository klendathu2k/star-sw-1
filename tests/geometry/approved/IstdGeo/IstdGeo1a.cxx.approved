       AgBlock *IECE::mInstance = 0;  
       AgBlock *IECE::Instance(){     
                if ( mInstance==0 ) mInstance = new IECE();     
                return mInstance;     
       }  
       void IECE::Block( AgCreate create )  
       {      
             ///@addtogroup IECE_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Aluminium         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IECE");           
                         attr.par("seen")=1;           
                         attr.par("colo")=4;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfendcapmomwdt;           
                         shape.par("dy")=halfendcapmomthk;           
                         shape.par("dz")=halfendcapmomlen;           
                         /// Shape Bbox dx=halfendcapmomwdt dy=halfendcapmomthk dz=halfendcapmomlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IECE;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICET");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICET           
                         Create("ICET");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICET");           
                         place.SetMother("IECE");           
                         /// Add daughter volume ICET to mother IECE           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(halfendcapmomthk-0.03435/2.0);           
                         /// Translate y = halfendcapmomthk-0.03435/2.0           
                         place.TranslateZ(halfendcapmomlen-connectendcapskinlen/2.0);           
                         /// Translate z = halfendcapmomlen-connectendcapskinlen/2.0           
                         _stacker -> Position( AgBlock::Find("ICET"), place );           
                   } // end placement of ICET        
                   _create = AgCreate("ICEB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICEB           
                         Create("ICEB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICEB");           
                         place.SetMother("IECE");           
                         /// Add daughter volume ICEB to mother IECE           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(-halfendcapmomthk+0.03435/2.0);           
                         /// Translate y = -halfendcapmomthk+0.03435/2.0           
                         place.TranslateZ(halfendcapmomlen-connectendcapskinlen/2.0);           
                         /// Translate z = halfendcapmomlen-connectendcapskinlen/2.0           
                         _stacker -> Position( AgBlock::Find("ICEB"), place );           
                   } // end placement of ICEB        
                   _create = AgCreate("IABE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IABE           
                         Create("IABE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IABE");           
                         place.SetMother("IECE");           
                         /// Add daughter volume IABE to mother IECE           
                         place.TranslateX(-halfendcapmomwdt+1.23485+0.5065/2.0);           
                         /// Translate x = -halfendcapmomwdt+1.23485+0.5065/2.0           
                         place.TranslateY(halfendcapmomthk-0.3031/2.0);           
                         /// Translate y = halfendcapmomthk-0.3031/2.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IABE"), place );           
                   } // end placement of IABE        
                   _create = AgCreate("IAAE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IAAE           
                         Create("IAAE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IAAE");           
                         place.SetMother("IECE");           
                         /// Add daughter volume IAAE to mother IECE           
                         place.TranslateX(-halfendcapmomwdt+1.23485+0.5065/2.0);           
                         /// Translate x = -halfendcapmomwdt+1.23485+0.5065/2.0           
                         place.TranslateY(halfendcapmomthk-0.3031);           
                         /// Translate y = halfendcapmomthk-0.3031           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IAAE"), place );           
                   } // end placement of IAAE        
                   _create = AgCreate("IESE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IESE           
                         Create("IESE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IESE");           
                         place.SetMother("IECE");           
                         /// Add daughter volume IESE to mother IECE           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halfendcapmomlen+0.75);           
                         /// Translate z = -halfendcapmomlen+0.75           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("IESE"), place );           
                   } // end placement of IESE        
                   _create = AgCreate("IESS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IESS           
                         Create("IESS");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IESS");           
                         place.SetMother("IECE");           
                         /// Add daughter volume IESS to mother IECE           
                         place.TranslateX(halfendcapmomwdt-1.8);           
                         /// Translate x = halfendcapmomwdt-1.8           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halfendcapmomlen+0.5);           
                         /// Translate z = -halfendcapmomlen+0.5           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("IESS"), place );           
                   } // end placement of IESS        
                   _create = AgCreate("ITNE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ITNE           
                         Create("ITNE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ITNE");           
                         place.SetMother("IECE");           
                         /// Add daughter volume ITNE to mother IECE           
                         place.TranslateX(-halfendcapmomwdt+0.55);           
                         /// Translate x = -halfendcapmomwdt+0.55           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halfendcapmomlen+0.5);           
                         /// Translate z = -halfendcapmomlen+0.5           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ITNE"), place );           
                   } // end placement of ITNE        
                   _create = AgCreate("ITSE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ITSE           
                         Create("ITSE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ITSE");           
                         place.SetMother("IECE");           
                         /// Add daughter volume ITSE to mother IECE           
                         place.TranslateX(halfendcapmomwdt-0.55);           
                         /// Translate x = halfendcapmomwdt-0.55           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halfendcapmomlen+0.5);           
                         /// Translate z = -halfendcapmomlen+0.5           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ITSE"), place );           
                   } // end placement of ITSE        
                   END_OF_IECE:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IECE  
