       void IBCF::Block( AgCreate create )  
       {      
             ///@addtogroup IBCF_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBCF");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halffoamwdt;           
                         shape.par("dy")=halffoamthk;           
                         shape.par("dz")=halffoamlen;           
                         /// Shape Bbox dx=halffoamwdt dy=halffoamthk dz=halffoamlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBCF;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICFC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICFC           
                         Create("ICFC");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICFC");           
                         place.SetMother("IBCF");           
                         /// Add daughter volume ICFC to mother IBCF           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halffoamlen+halffoamlenconnect);           
                         /// Translate z = -halffoamlen+halffoamlenconnect           
                         place.par("only")=AgPosition::kMany;           
                         /// Overlap: agposition::kmany           
                         _stacker -> Position( AgBlock::Find("ICFC"), place );           
                   } // end placement of ICFC        
                   _create = AgCreate("ICFD");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICFD           
                         Create("ICFD");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICFD");           
                         place.SetMother("IBCF");           
                         /// Add daughter volume ICFD to mother IBCF           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halffoamlenconnect);           
                         /// Translate z = halffoamlenconnect           
                         place.par("only")=AgPosition::kMany;           
                         /// Overlap: agposition::kmany           
                         _stacker -> Position( AgBlock::Find("ICFD"), place );           
                   } // end placement of ICFD        
                   _create = AgCreate("ICFB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICFB           
                         Create("ICFB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICFB");           
                         place.SetMother("IBCF");           
                         /// Add daughter volume ICFB to mother IBCF           
                         place.TranslateX(tubermax);           
                         /// Translate x = tubermax           
                         place.TranslateY(halffoamthk-0.2922/2.0);           
                         /// Translate y = halffoamthk-0.2922/2.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         _stacker -> Position( AgBlock::Find("ICFB"), place );           
                   } // end placement of ICFB        
                   _create = AgCreate("ICFA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICFA           
                         Create("ICFA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICFA");           
                         place.SetMother("IBCF");           
                         /// Add daughter volume ICFA to mother IBCF           
                         place.TranslateX(tubermax);           
                         /// Translate x = tubermax           
                         place.TranslateY(halffoamthk-0.2922);           
                         /// Translate y = halffoamthk-0.2922           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         _stacker -> Position( AgBlock::Find("ICFA"), place );           
                   } // end placement of ICFA        
                   END_OF_IBCF:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBCF  
