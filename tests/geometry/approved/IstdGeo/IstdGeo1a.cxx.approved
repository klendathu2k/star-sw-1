                         shape.par("rmx1")=24.8745;           
                         shape.par("rmn2")=14.7727;           
                         shape.par("rmx2")=17.4338;           
                         /// Shape Cone dz=0.5*8.7144 rmn1=24.068 rmx1=24.8745 rmn2=14.7727 rmx2=17.4338            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ICCT;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_ICCT:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ICCT  
