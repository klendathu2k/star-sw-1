                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=0.1625/2.0;           
                         shape.par("dy")=0.06/2.0;           
                         shape.par("dz")=0.1625/2.0;           
                         /// Shape Bbox dx=0.1625/2.0 dy=0.06/2.0 dz=0.1625/2.0            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBTS;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_IBTS:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBTS  
