       AgBlock *ILST::mInstance = 0;  
       AgBlock *ILST::Instance(){     
                if ( mInstance==0 ) mInstance = new ILST();     
                return mInstance;     
       }  
       void ILST::Block( AgCreate create )  
       {      
             ///@addtogroup ILST_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   { AgAttribute attr = AgAttribute("ILST");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfskinwdt;           
                         shape.par("dy")=halfthkskinmom;           
                         shape.par("dz")=halfskinlen;           
                         /// Shape Bbox dx=halfskinwdt dy=halfthkskinmom dz=halfskinlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ILST;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ISTC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISTC           
                         Create("ISTC");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISTC");           
                         place.SetMother("ILST");           
                         /// Add daughter volume ISTC to mother ILST           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(-halfthkskinmom+halfskinthk);           
                         /// Translate y = -halfthkskinmom+halfskinthk           
                         place.TranslateZ(halflenskinconnect-halfskinlen);           
                         /// Translate z = halflenskinconnect-halfskinlen           
                         _stacker -> Position( AgBlock::Find("ISTC"), place );           
                   } // end placement of ISTC        
                   _create = AgCreate("ISTH");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISTH           
                         Create("ISTH");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISTH");           
                         place.SetMother("ILST");           
                         /// Add daughter volume ISTH to mother ILST           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(-halfskinthk+halfthkskinmom);           
                         /// Translate y = -halfskinthk+halfthkskinmom           
                         place.TranslateZ(halflenskinconnect);           
                         /// Translate z = halflenskinconnect           
                         _stacker -> Position( AgBlock::Find("ISTH"), place );           
                   } // end placement of ISTH        
                   END_OF_ILST:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ILST  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *ISTC::mInstance = 0;  
       AgBlock *ISTC::Instance(){     
                if ( mInstance==0 ) mInstance = new ISTC();     
                return mInstance;     
       }  
