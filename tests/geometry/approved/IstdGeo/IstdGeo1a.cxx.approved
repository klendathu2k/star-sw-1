       void IECW::Block( AgCreate create )  
       {      
             ///@addtogroup IECW_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material PEEKCF30         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Peekcf30");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IECW");           
                         attr.par("seen")=1;           
                         attr.par("colo")=3;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfendcapmomwdt;           
                         shape.par("dy")=halfendcapmomthk;           
                         shape.par("dz")=halfendcapmomlen;           
                         /// Shape Bbox dx=halfendcapmomwdt dy=halfendcapmomthk dz=halfendcapmomlen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IECW;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICWT");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICWT           
                         Create("ICWT");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICWT");           
                         place.SetMother("IECW");           
                         /// Add daughter volume ICWT to mother IECW           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(halfendcapmomthk-0.0275/2.0);           
                         /// Translate y = halfendcapmomthk-0.0275/2.0           
                         place.TranslateZ(-halfendcapmomlen+connectendcapskinlen/2.0);           
                         /// Translate z = -halfendcapmomlen+connectendcapskinlen/2.0           
                         _stacker -> Position( AgBlock::Find("ICWT"), place );           
                   } // end placement of ICWT        
                   _create = AgCreate("ICWB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICWB           
                         Create("ICWB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICWB");           
                         place.SetMother("IECW");           
                         /// Add daughter volume ICWB to mother IECW           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(-halfendcapmomthk+0.0275/2.0);           
                         /// Translate y = -halfendcapmomthk+0.0275/2.0           
                         place.TranslateZ(-halfendcapmomlen+connectendcapskinlen/2.0);           
                         /// Translate z = -halfendcapmomlen+connectendcapskinlen/2.0           
                         _stacker -> Position( AgBlock::Find("ICWB"), place );           
                   } // end placement of ICWB        
                   _create = AgCreate("IABW");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IABW           
                         Create("IABW");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IABW");           
                         place.SetMother("IECW");           
                         /// Add daughter volume IABW to mother IECW           
                         place.TranslateX(-halfendcapmomwdt+1.23485+0.5065/2.0);           
                         /// Translate x = -halfendcapmomwdt+1.23485+0.5065/2.0           
                         place.TranslateY(halfendcapmomthk-0.31/2.0);           
                         /// Translate y = halfendcapmomthk-0.31/2.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IABW"), place );           
                   } // end placement of IABW        
                   _create = AgCreate("IAAW");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IAAW           
                         Create("IAAW");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IAAW");           
                         place.SetMother("IECW");           
                         /// Add daughter volume IAAW to mother IECW           
                         place.TranslateX(-halfendcapmomwdt+1.23485+0.5065/2.0);           
                         /// Translate x = -halfendcapmomwdt+1.23485+0.5065/2.0           
                         place.TranslateY(halfendcapmomthk-0.31);           
                         /// Translate y = halfendcapmomthk-0.31           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("IAAW"), place );           
                   } // end placement of IAAW        
                   _create = AgCreate("IESB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IESB           
                         Create("IESB");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IESB");           
                         place.SetMother("IECW");           
                         /// Add daughter volume IESB to mother IECW           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfendcapmomlen-0.6-0.3/2.0);           
                         /// Translate z = halfendcapmomlen-0.6-0.3/2.0           
                         _stacker -> Position( AgBlock::Find("IESB"), place );           
                   } // end placement of IESB        
                   _create = AgCreate("IESA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IESA           
                         Create("IESA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IESA");           
                         place.SetMother("IECW");           
                         /// Add daughter volume IESA to mother IECW           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfendcapmomlen-0.6-0.3);           
                         /// Translate z = halfendcapmomlen-0.6-0.3           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("IESA"), place );           
                   } // end placement of IESA        
                   _create = AgCreate("IESC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IESC           
                         Create("IESC");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IESC");           
                         place.SetMother("IECW");           
                         /// Add daughter volume IESC to mother IECW           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfendcapmomlen-0.6);           
                         /// Translate z = halfendcapmomlen-0.6           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("IESC"), place );           
                   } // end placement of IESC        
                   _create = AgCreate("ITNW");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ITNW           
                         Create("ITNW");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ITNW");           
                         place.SetMother("IECW");           
                         /// Add daughter volume ITNW to mother IECW           
                         place.TranslateX(-halfendcapmomwdt+0.55);           
                         /// Translate x = -halfendcapmomwdt+0.55           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfendcapmomlen-0.5);           
                         /// Translate z = halfendcapmomlen-0.5           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ITNW"), place );           
                   } // end placement of ITNW        
                   _create = AgCreate("ITSW");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ITSW           
                         Create("ITSW");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ITSW");           
                         place.SetMother("IECW");           
                         /// Add daughter volume ITSW to mother IECW           
                         place.TranslateX(halfendcapmomwdt-0.55);           
                         /// Translate x = halfendcapmomwdt-0.55           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halfendcapmomlen-0.5);           
                         /// Translate z = halfendcapmomlen-0.5           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ITSW"), place );           
                   } // end placement of ITSW        
                   END_OF_IECW:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IECW  
