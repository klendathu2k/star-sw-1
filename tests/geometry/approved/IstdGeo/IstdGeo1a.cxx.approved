                         _stacker -> Position( AgBlock::Find("IHBC"), place );           
                   } // end placement of IHBC        
                   _create = AgCreate("IHBH");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IHBH           
                         Create("IHBH");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("IHBH");           
                         place.SetMother("IBHB");           
                         /// Add daughter volume IHBH to mother IBHB           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(halfhbdthktb-halfhbdthktbconnect);           
                         /// Translate y = halfhbdthktb-halfhbdthktbconnect           
                         place.TranslateZ(halfhbdlentbconnect);           
                         /// Translate z = halfhbdlentbconnect           
                         _stacker -> Position( AgBlock::Find("IHBH"), place );           
                   } // end placement of IHBH        
                   END_OF_IBHB:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBHB  
