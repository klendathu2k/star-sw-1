                   { AgAttribute attr = AgAttribute("ICWT");           
                         attr.par("seen")=1;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=halfendcapmomwdt;           
                         shape.par("dy")=(halfendcapmomthk-halfoverlapendcapskinthk)/2.0;           
                         shape.par("dz")=connectendcapskinlen/2.0;           
                         /// Shape Bbox dx=halfendcapmomwdt dy=(halfendcapmomthk-halfoverlapendcapskinthk)/2.0 dz=connectendcapskinlen/2.0            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ICWT;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_ICWT:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ICWT  
