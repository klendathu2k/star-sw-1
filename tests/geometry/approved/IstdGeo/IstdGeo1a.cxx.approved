       AgBlock *IBAM::mInstance = 0;  
       AgBlock *IBAM::Instance(){     
                if ( mInstance==0 ) mInstance = new IBAM();     
                return mInstance;     
       }  
       void IBAM::Block( AgCreate create )  
       {      
             ///@addtogroup IBAM_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBAM");           
                         attr.par("seen")=1;           
                         attr.par("colo")=6;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Tubs");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=11.84;           
                         shape.par("rmax")=17.5;           
                         shape.par("phi1")=-18+90;           
                         shape.par("phi2")=18+90;           
                         shape.par("dz")=ladder_length/2.0;           
                         /// Shape Tubs rmin=11.84 rmax=17.5 phi1=-18+90 phi2=18+90 dz=ladder_length/2.0            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBAM;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ILCC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ILCC           
                         Create("ILCC");            
                   }        
                   x=halfladwdt-0.15-halfcombwdt;        
                   y=-halfladthk+2.4244+2*halfskinthk+halfcombthk;        
                   istdgeo1a_trans_to_ibam( x,y,tilt,xp,yp );// CALL istdgeo1a_trans_to_ibam        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ILCC");           
                         place.SetMother("IBAM");           
                         /// Add daughter volume ILCC to mother IBAM           
                         place.TranslateX(xp);           
                         /// Translate x = xp           
                         place.TranslateY(yp);           
                         /// Translate y = yp           
                         place.TranslateZ(halfladlen-halfcomblen-2*halfendcapmomlen-outsidetubewestlen);           
                         /// Translate z = halfladlen-halfcomblen-2*halfendcapmomlen-outsidetubewestlen           
                         place.AlphaZ(-1.0*tilt);           
                         /// Rotate: AlphaZ = -1.0*tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ILCC"), place );           
                   } // end placement of ILCC        
                   _create = AgCreate("IBCF");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create IBCF           
                         Create("IBCF");            
                   }        
