                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=0;           
                         shape.par("rmax")=tubeconeouterrmax;           
                         shape.par("dz")=halftubelen;           
                         /// Shape Tube rmin=0 rmax=tubeconeouterrmax dz=halftubelen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBAT;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ICTC");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTC           
                         Create("ICTC");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTC");           
                         place.SetMother("IBAT");           
                         /// Add daughter volume ICTC to mother IBAT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         _stacker -> Position( AgBlock::Find("ICTC"), place );           
                   } // end placement of ICTC        
                   _create = AgCreate("ICTE");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTE           
                         Create("ICTE");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTE");           
                         place.SetMother("IBAT");           
                         /// Add daughter volume ICTE to mother IBAT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-halftubelen+halftubeconelen);           
                         /// Translate z = -halftubelen+halftubeconelen           
                         _stacker -> Position( AgBlock::Find("ICTE"), place );           
                   } // end placement of ICTE        
                   _create = AgCreate("ICTW");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICTW           
                         Create("ICTW");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICTW");           
                         place.SetMother("IBAT");           
                         /// Add daughter volume ICTW to mother IBAT           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(halftubelen-halftubeconelen);           
                         /// Translate z = halftubelen-halftubeconelen           
                         _stacker -> Position( AgBlock::Find("ICTW"), place );           
                   } // end placement of ICTW        
                   END_OF_IBAT:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBAT  
