       AgBlock *IBMO::mInstance = 0;  
       AgBlock *IBMO::Instance(){     
                if ( mInstance==0 ) mInstance = new IBMO();     
                return mInstance;     
       }  
       void IBMO::Block( AgCreate create )  
       {      
             ///@addtogroup IBMO_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBMO");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Pcon");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("phi1")=0;           
                         shape.par("dphi")=360;           
                         shape.par("nz")=4;           
                         shape.Z(0)=-12.957-ladder_length/2.0;           
                         shape.Z(1)=-4.5-ladder_length/2.0;           
                         shape.Z(2)=-4.5-ladder_length/2.0;           
                         shape.Z(3)=ladder_length/2.0;           
                         shape.Rmin(0)=ibmoinnerradius+0.2;           
                         shape.Rmin(1)=ibmoinnerradius+0.2;           
                         shape.Rmin(2)=ibmoinnerradius;           
                         shape.Rmin(3)=ibmoinnerradius;           
                         shape.Rmax(0)=ibmoouterradius;           
                         shape.Rmax(1)=ibmoouterradius;           
                         shape.Rmax(2)=ibmoouterradius;           
                         shape.Rmax(3)=ibmoouterradius;           
                         /// Shape Pcon phi1=0 dphi=360 nz=4            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBMO;           
                         _stacker -> Build(this);           
                   }        
                   /// Loop on nl from 1 to nladder step=1        
                   for ( nl=1; (1>0)? (nl<=nladder):(nl>=nladder); nl+=1 )        
                   {           
                         aangle=(360.0/nladder)*(nl-1)+angleoffset;           
                         if ( debug==1 )           
                         {              
                               // - Info -               
                               Info( GetName(), Form("shiftinX=%6.4f",paro.dx*paro.mult)  );              
                               // - Info -               
                               Info( GetName(), Form("shiftinY=%6.4f",paro.dy*paro.mult)  );              
                               // - Info -               
                               Info( GetName(), Form("shiftinZ=%6.4f",paro.dz*paro.mult)  );              
                         }           
                         xpos=0.0+(paro.dx*paro.mult)*paro.lad[int(nl)-1];           
                         ypos=0.0+(paro.dy*paro.mult)*paro.lad[int(nl)-1];           
                         zpos=0.0+(paro.dz*paro.mult)*paro.lad[int(nl)-1];           
                         if ( debug==1 )           
                         {              
                               // - Info -               
                               Info( GetName(), Form("aangle=%8.5f",aangle)  );              
                               // - Info -               
                               Info( GetName(), Form("x=%8.5f",xpos)  );              
                               // - Info -               
                               Info( GetName(), Form("y=%8.5f",ypos)  );              
                               // - Info -               
                               Info( GetName(), Form("z=%8.5f",zpos)  );              
                         }           
                         _create = AgCreate("IBAM");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create IBAM              
                               Create("IBAM");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("IBAM");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume IBAM to mother IBMO              
                               place.TranslateX(xpos);              
                               /// Translate x = xpos              
                               place.TranslateY(ypos);              
                               /// Translate y = ypos              
                               place.TranslateZ(zpos-4.4929);              
                               /// Translate z = zpos-4.4929              
                               place.par("only")=AgPosition::kMany;              
                               /// Overlap: agposition::kmany              
                               if ( debug==1 )              
                               {                 
                                     // - Info -                  
                                     Info( GetName(), Form("rotalongX=%6.4f",para.da*para.mult)  );                 
                                     // - Info -                  
                                     Info( GetName(), Form("rotalongY=%6.4f",para.db*para.mult)  );                 
                                     // - Info -                  
                                     Info( GetName(), Form("rotalongZ=%6.4f",para.dg*para.mult)  );                 
                               }              
                               place.AlphaZ((-1*aangle)-1*(para.dg*para.mult*para.lad[int(nl)-1]));              
                               /// Rotate: AlphaZ = (-1*aangle)-1*(para.dg*para.mult*para.lad[int(nl)-1])              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               place.AlphaX(-1*(para.da*para.mult)*para.lad[int(nl)-1]);              
                               /// Rotate: AlphaX = -1*(para.da*para.mult)*para.lad[int(nl)-1]              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               place.AlphaY(-1*(para.db*para.mult)*para.lad[int(nl)-1]);              
                               /// Rotate: AlphaY = -1*(para.db*para.mult)*para.lad[int(nl)-1]              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               place.Misalign("Geometry/ist/istLadderOnIstMisalign",nl-1,"right");              
                               _stacker -> Position( AgBlock::Find("IBAM"), place );              
                         } // end placement of IBAM           
                         if ( istc.misalign==1||istc.misalign==2 )           
                         {              
                               _create = AgCreate("IBSS");              
                               {                 
                                     AgShape myshape; // undefined shape                 
                                     ///Create IBSS                 
                                     Create("IBSS");                  
                               }              
                               /// Loop on isensor from 1 to 6 step=1              
                               for ( isensor=1; (1>0)? (isensor<=6):(isensor>=6); isensor+=1 )              
                               {                 
                                     irownumber=(nl-1)*6+isensor;                 
                                     {                    
                                           AgPosition  place;                    
                                           place.SetBlock("IBSS");                    
                                           place.SetMother("IBMO");                    
                                           /// Add daughter volume IBSS to mother IBMO                    
                                           place.par("only")=AgPosition::kOnly;                    
                                           /// Overlap: agposition::konly                    
                                           place.Misalign("Geometry/ist/istSensorOnLadder",irownumber-1,"left");                    
                                           place.Misalign("Geometry/ist/istLadderOnIst",nl-1,"left");                    
                                           _stacker -> Position( AgBlock::Find("IBSS"), place );                    
                                     } // end placement of IBSS                 
                               }              
                         }           
                   }        
                   /// Loop on nctj from 1 to 12 step=1        
                   for ( nctj=1; (1>0)? (nctj<=12):(nctj>=12); nctj+=1 )        
                   {           
                         bangle=(360.0/12.0)*(nctj-1)+5.73;           
                         _create = AgCreate("IBCJ");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create IBCJ              
                               Create("IBCJ");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("IBCJ");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume IBCJ to mother IBMO              
                               place.TranslateX(xctjpos(nctj));              
                               /// Translate x = xctjpos(nctj)              
                               place.TranslateY(yctjpos(nctj));              
                               /// Translate y = yctjpos(nctj)              
                               place.TranslateZ(zpos+35.5965+0.5*11.4588);              
                               /// Translate z = zpos+35.5965+0.5*11.4588              
                               place.par("only")=AgPosition::kMany;              
                               /// Overlap: agposition::kmany              
                               place.AlphaZ(-1.0*bangle);              
                               /// Rotate: AlphaZ = -1.0*bangle              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("IBCJ"), place );              
                         } // end placement of IBCJ           
                   }        
                   radius_a=16.3832;        
                   radius_b=16.8956;        
                   radius_c=17.2478;        
                   radius_t=15.0929;        
                   tilt_a=0.8824;        
                   tilt_b=-3.5681;        
                   tilt_c=-6.0912;        
                   tilt_t=-1.7697;        
                   /// Loop on ncableset from 1 to 24 step=1        
                   for ( ncableset=1; (1>0)? (ncableset<=24):(ncableset>=24); ncableset+=1 )        
                   {           
                         angle_a=(360.0/24)*(ncableset-1)+tilt_a;           
                         angle_b=(360.0/24)*(ncableset-1)+tilt_b;           
                         angle_c=(360.0/24)*(ncableset-1)+tilt_c;           
                         angle_t=(360.0/24)*(ncableset-1)+tilt_t;           
                         _create = AgCreate("ISCA");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ISCA              
                               Create("ISCA");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ISCA");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume ISCA to mother IBMO              
                               place.TranslateX(radius_a*sin(angle_a*raddeg));              
                               /// Translate x = radius_a*sin(angle_a*raddeg)              
                               place.TranslateY(radius_a*cos(angle_a*raddeg));              
                               /// Translate y = radius_a*cos(angle_a*raddeg)              
                               place.TranslateZ(-34.7832-0.5*18.2616);              
                               /// Translate z = -34.7832-0.5*18.2616              
                               place.par("only")=AgPosition::kOnly;              
                               /// Overlap: agposition::konly              
                               place.AlphaZ(-1.0*angle_a);              
                               /// Rotate: AlphaZ = -1.0*angle_a              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ISCA"), place );              
                         } // end placement of ISCA           
                         _create = AgCreate("ISCB");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ISCB              
                               Create("ISCB");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ISCB");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume ISCB to mother IBMO              
                               place.TranslateX(radius_b*sin(angle_b*raddeg));              
                               /// Translate x = radius_b*sin(angle_b*raddeg)              
                               place.TranslateY(radius_b*cos(angle_b*raddeg));              
                               /// Translate y = radius_b*cos(angle_b*raddeg)              
                               place.TranslateZ(-32.1233-0.5*20.9215);              
                               /// Translate z = -32.1233-0.5*20.9215              
                               place.par("only")=AgPosition::kOnly;              
                               /// Overlap: agposition::konly              
                               place.AlphaZ(-1.0*angle_b);              
                               /// Rotate: AlphaZ = -1.0*angle_b              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ISCB"), place );              
                         } // end placement of ISCB           
                         _create = AgCreate("ISCC");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ISCC              
                               Create("ISCC");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ISCC");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume ISCC to mother IBMO              
                               place.TranslateX(radius_c*sin(angle_c*raddeg));              
                               /// Translate x = radius_c*sin(angle_c*raddeg)              
                               place.TranslateY(radius_c*cos(angle_c*raddeg));              
                               /// Translate y = radius_c*cos(angle_c*raddeg)              
                               place.TranslateZ(-29.203-0.5*23.8418);              
                               /// Translate z = -29.203-0.5*23.8418              
                               place.par("only")=AgPosition::kOnly;              
                               /// Overlap: agposition::konly              
                               place.AlphaZ(-1.0*angle_c);              
                               /// Rotate: AlphaZ = -1.0*angle_c              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ISCC"), place );              
                         } // end placement of ISCC           
                         _create = AgCreate("ISCT");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ISCT              
                               Create("ISCT");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ISCT");              
                               place.SetMother("IBMO");              
                               /// Add daughter volume ISCT to mother IBMO              
                               place.TranslateX(radius_t*sin(angle_t*raddeg));              
                               /// Translate x = radius_t*sin(angle_t*raddeg)              
                               place.TranslateY(radius_t*cos(angle_t*raddeg));              
                               /// Translate y = radius_t*cos(angle_t*raddeg)              
                               place.TranslateZ(-44.5806-0.5*8.4642);              
                               /// Translate z = -44.5806-0.5*8.4642              
                               place.par("only")=AgPosition::kOnly;              
                               /// Overlap: agposition::konly              
                               place.AlphaZ(-1.0*angle_t);              
                               /// Rotate: AlphaZ = -1.0*angle_t              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ISCT"), place );              
                         } // end placement of ISCT           
                   }        
                   END_OF_IBMO:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBMO  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *IBCJ::mInstance = 0;  
       AgBlock *IBCJ::Instance(){     
                if ( mInstance==0 ) mInstance = new IBCJ();     
                return mInstance;     
       }  
       void IBCJ::Block( AgCreate create )  
       {      
             ///@addtogroup IBCJ_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("IBCJ");           
                         attr.par("seen")=0;           
                         attr.par("colo")=6;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=2.88855;           
                         shape.par("dy")=0.91655;           
                         shape.par("dz")=5.7294;           
                         /// Shape Bbox dx=2.88855 dy=0.91655 dz=5.7294            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_IBCJ;           
                         _stacker -> Build(this);           
                   }        
                   /// Loop on nseg from 1 to 20 step=1        
                   for ( nseg=1; (1>0)? (nseg<=20):(nseg>=20); nseg+=1 )        
                   {           
                         tubeangle=raddeg*(2*nseg-1)*180/(2.0*20);           
                         xtubearc=-2.88855+0.5*1.8331+1.97-1.97*cos(tubeangle);           
                         ytubearc=0.0;           
                         ztubearc=-5.7294+2.722875+0.1778+6.35+1.97*sin(tubeangle);           
                         _create = AgCreate("ICJR");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create ICJR              
                               Create("ICJR");               
                         }           
                         {              
                               AgPosition  place;              
                               place.SetBlock("ICJR");              
                               place.SetMother("IBCJ");              
                               /// Add daughter volume ICJR to mother IBCJ              
                               place.TranslateX(xtubearc);              
                               /// Translate x = xtubearc              
                               place.TranslateY(ytubearc);              
                               /// Translate y = ytubearc              
                               place.TranslateZ(ztubearc);              
                               /// Translate z = ztubearc              
                               place.AlphaY((2*nseg-1)*180/(2.0*20));              
                               /// Rotate: AlphaY = (2*nseg-1)*180/(2.0*20)              
                               /// G3 Reference: thetax = 90              
                               /// G3 Reference: phix = 0              
                               /// G3 Reference: thetay = 90              
                               /// G3 Reference: phiy = 90              
                               /// G3 Reference: thetaz = 0              
                               /// G3 Reference: phiz = 0              
                               _stacker -> Position( AgBlock::Find("ICJR"), place );              
                         } // end placement of ICJR           
                   }        
                   _create = AgCreate("ICJS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICJS           
                         Create("ICJS");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJS");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJS to mother IBCJ           
                         place.TranslateX(2.88855-0.5*1.8331);           
                         /// Translate x = 2.88855-0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+2.722875+0.1778+0.5*6.35);           
                         /// Translate z = -5.7294+2.722875+0.1778+0.5*6.35           
                         _stacker -> Position( AgBlock::Find("ICJS"), place );           
                   } // end placement of ICJS        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJS");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJS to mother IBCJ           
                         place.TranslateX(-2.88855+0.5*1.8331);           
                         /// Translate x = -2.88855+0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+2.722875+0.1778+0.5*6.35);           
                         /// Translate z = -5.7294+2.722875+0.1778+0.5*6.35           
                         _stacker -> Position( AgBlock::Find("ICJS"), place );           
                   } // end placement of ICJS        
                   _create = AgCreate("ICJA");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICJA           
                         Create("ICJA");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJA");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJA to mother IBCJ           
                         place.TranslateX(-2.88855+0.5*1.8331);           
                         /// Translate x = -2.88855+0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+2.722875+0.5*0.1778);           
                         /// Translate z = -5.7294+2.722875+0.5*0.1778           
                         _stacker -> Position( AgBlock::Find("ICJA"), place );           
                   } // end placement of ICJA        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJA");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJA to mother IBCJ           
                         place.TranslateX(2.88855-0.5*1.8331);           
                         /// Translate x = 2.88855-0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+2.722875+0.5*0.1778);           
                         /// Translate z = -5.7294+2.722875+0.5*0.1778           
                         _stacker -> Position( AgBlock::Find("ICJA"), place );           
                   } // end placement of ICJA        
                   _create = AgCreate("ICJU");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICJU           
                         Create("ICJU");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJU");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJU to mother IBCJ           
                         place.TranslateX(-2.88855+0.5*1.8331);           
                         /// Translate x = -2.88855+0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+0.5*2.722875);           
                         /// Translate z = -5.7294+0.5*2.722875           
                         _stacker -> Position( AgBlock::Find("ICJU"), place );           
                   } // end placement of ICJU        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICJU");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICJU to mother IBCJ           
                         place.TranslateX(2.88855-0.5*1.8331);           
                         /// Translate x = 2.88855-0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+0.5*2.722875);           
                         /// Translate z = -5.7294+0.5*2.722875           
                         _stacker -> Position( AgBlock::Find("ICJU"), place );           
                   } // end placement of ICJU        
                   _create = AgCreate("ICLN");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ICLN           
                         Create("ICLN");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICLN");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICLN to mother IBCJ           
                         place.TranslateX(-2.88855+0.5*1.8331);           
                         /// Translate x = -2.88855+0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+0.5*2.722875+0.5*0.1778+0.5*6.35);           
                         /// Translate z = -5.7294+0.5*2.722875+0.5*0.1778+0.5*6.35           
                         _stacker -> Position( AgBlock::Find("ICLN"), place );           
                   } // end placement of ICLN        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ICLN");           
                         place.SetMother("IBCJ");           
                         /// Add daughter volume ICLN to mother IBCJ           
                         place.TranslateX(2.88855-0.5*1.8331);           
                         /// Translate x = 2.88855-0.5*1.8331           
                         place.TranslateY(0.0);           
                         /// Translate y = 0.0           
                         place.TranslateZ(-5.7294+0.5*2.722875+0.5*0.1778+0.5*6.35);           
                         /// Translate z = -5.7294+0.5*2.722875+0.5*0.1778+0.5*6.35           
                         _stacker -> Position( AgBlock::Find("ICLN"), place );           
                   } // end placement of ICLN        
                   END_OF_IBCJ:        
                   mCurrent = _save;        
             ///@}     
       } // End Block IBCJ  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *ICJR::mInstance = 0;  
       AgBlock *ICJR::Instance(){     
                if ( mInstance==0 ) mInstance = new ICJR();     
                return mInstance;     
       }  
       void ICJR::Block( AgCreate create )  
       {      
             ///@addtogroup ICJR_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   { AgAttribute attr = AgAttribute("ICJR");           
                         attr.par("seen")=1;           
                         attr.par("colo")=4;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   /// Material AlNovecMix         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Alnovecmix");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=0;           
                         shape.par("rmax")=0.238125;           
                         shape.par("dz")=0.5*3.1415926*1.97/20;           
                         /// Shape Tube rmin=0 rmax=0.238125 dz=0.5*3.1415926*1.97/20            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
