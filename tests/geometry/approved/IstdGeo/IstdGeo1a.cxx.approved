       void ICTC::Block( AgCreate create )  
       {      
             ///@addtogroup ICTC_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   { AgAttribute attr = AgAttribute("ICTC");           
                         attr.par("seen")=1;           
                         attr.par("colo")=4;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   /// Material Aluminium         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");           
                         _material = mat;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=tubermin;           
                         shape.par("rmax")=tubermax;           
                         shape.par("dz")=halftubelen-halftubeconelen;           
                         /// Shape Tube rmin=tubermin rmax=tubermax dz=halftubelen-halftubeconelen            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ICTC;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_ICTC:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ICTC  
