       AgBlock *ISCM::mInstance = 0;  
       AgBlock *ISCM::Instance(){     
                if ( mInstance==0 ) mInstance = new ISCM();     
                return mInstance;     
       }  
       void ISCM::Block( AgCreate create )  
       {      
             ///@addtogroup ISCM_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("ISCM");           
                         attr.par("seen")=0;           
                         attr.par("colo")=1;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Bbox");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("dx")=0.5*1.25;           
                         shape.par("dy")=0.5*1.651;           
                         shape.par("dz")=0.5*1.25;           
                         /// Shape Bbox dx=0.5*1.25 dy=0.5*1.651 dz=0.5*1.25            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_ISCM;           
                         _stacker -> Build(this);           
                   }        
                   _create = AgCreate("ISCH");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISCH           
                         Create("ISCH");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISCH");           
                         place.SetMother("ISCM");           
                         /// Add daughter volume ISCH to mother ISCM           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.5*1.651-0.5*0.381);           
                         /// Translate y = 0.5*1.651-0.5*0.381           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISCH"), place );           
                   } // end placement of ISCH        
                   _create = AgCreate("ISCS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISCS           
                         Create("ISCS");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISCS");           
                         place.SetMother("ISCM");           
                         /// Add daughter volume ISCS to mother ISCM           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.5*1.651-0.381-0.5*0.635);           
                         /// Translate y = 0.5*1.651-0.381-0.5*0.635           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISCS"), place );           
                   } // end placement of ISCS        
                   _create = AgCreate("ISCR");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISCR           
                         Create("ISCR");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISCR");           
                         place.SetMother("ISCM");           
                         /// Add daughter volume ISCR to mother ISCM           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(-0.5*1.651+0.5*0.635);           
                         /// Translate y = -0.5*1.651+0.5*0.635           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISCR"), place );           
                   } // end placement of ISCR        
                   _create = AgCreate("ISWS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create ISWS           
                         Create("ISWS");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("ISWS");           
                         place.SetMother("ISCM");           
                         /// Add daughter volume ISWS to mother ISCM           
                         place.TranslateX(0.0);           
                         /// Translate x = 0.0           
                         place.TranslateY(0.5*1.651-0.381-0.5*0.16);           
                         /// Translate y = 0.5*1.651-0.381-0.5*0.16           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.AlphaX(90.0);           
                         /// Rotate: AlphaX = 90.0           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("ISWS"), place );           
                   } // end placement of ISWS        
                   END_OF_ISCM:        
                   mCurrent = _save;        
             ///@}     
       } // End Block ISCM  
       // ---------------------------------------------------------------------------------------------------  
