      BLOCK IBLM   mother of the sensor assembly
      MATERIAL Air
      ATTRIBUTE IBLM seen=0 colo=1
      SHAPE box dx=HalfSenMomWdt dy=HalfSenMomThk,
            dz=HalfSenMomLen
      CREATE IBSS
      CALL AgsReset 
      CALL agml_position_begin('IBSS') 
      %title = 'IBSS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(HalfSenMomWdt-HalfSensorWdt-2*HalfSensorEdgeT) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
