      ! ---------------------------------------------------------------------------------- IBAM
      BLOCK IBAM   IST ladder
      MATERIAL Air
      ATTRIBUTE IBAM seen=1 colo=6
      SHAPE tubs rmin=11.84 rmax=17.5 phi1=-18+90,
            phi2=18+90 dz=Ladder_Length/2.0
      CREATE ILCC
      x= HalfLadWdt - 0.15 - HalfCombWdt
      y= - HalfLadThk + 2.4244 + 2*HalfSkinThk + HalfCombThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('ILCC') 
      %mother = 'IBAM' 
      %title = 'ILCC' 
