      %title = 'IBBE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(2*HalfAPVWdt+APVSensorGapSize+HalfSensorEdgeB-HalfSenMomWdt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBLE
      CALL AgsReset 
      CALL agml_position_begin('IBLE') 
      %title = 'IBLE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(HalfSenMomWdt-2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfSenMomLen-HalfSensorEdgeLR-0.5*SensorGapSize) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBRE
      CALL AgsReset 
      CALL agml_position_begin('IBRE') 
      %title = 'IBRE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(HalfSenMomWdt-2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfSensorEdgeLR+0.5*SensorGapSize-HalfSenMomLen) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      DO num = 1, nAPVUnit
      CREATE IBAP
      CALL AgsReset 
      CALL agml_position_begin('IBAP') 
      %mother = 'IBLM' 
      %title = 'IBAP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-HalfSenMomWdt+HalfAPVWdt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfSenMomLen+HalfAPVLen*(2*num-1)+APVGapSize*(num-1)+0.36875) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBTE
      BLOCK IBTE   is the Silicon Sensor top dead Area
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE IBTE seen=1 colo=2
      SHAPE box dx=HalfSensorEdgeT dy=HalfSensorThk,
            dz=HalfSensorLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBBE
      BLOCK IBBE   is the Silicon Sensor bottom dead Area
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE IBBE seen=1 colo=2
      SHAPE box dx=HalfSensorEdgeB dy=HalfSensorThk,
            dz=HalfSensorLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBLE
      BLOCK IBLE   is the Silicon Sensor left dead Area
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE IBLE seen=1 colo=2
      SHAPE box dx=2.0 dy=HalfSensorThk dz=HalfSensorEdgeLR
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBRE
      BLOCK IBRE   is the Silicon Sensor right dead Area
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE IBRE seen=1 colo=2
      SHAPE box dx=2.0 dy=HalfSensorThk dz=HalfSensorEdgeLR
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBAP
      BLOCK IBAP   is the APV chip
      MATERIAL APVMix
      ATTRIBUTE IBAP seen=1 colo=2
      SHAPE box dx=HalfAPVWdt dy=HalfAPVThk dz=HalfAPVLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSS
      BLOCK IBSS   is the Silicon Sensor Active Area
      MATERIAL Silicon
      MATERIAL ISTSSensitive isvol=1
      ATTRIBUTE IBSS seen=1 colo=2
      SHAPE box dx=HalfSensorWdt dy=HalfSensorThk,
            dz=HalfSensorLen
      HITS IBSS z:.001:S y:.001: x:.001: ptot:16:(0,100) cx:10: cy:10: cz:10: sleng:16:(0,500),
            tof:16: step:.01: eloss:16:
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ICCT
      BLOCK ICCT   average volume of average cables/cooling line in transition area
      MATERIAL CuAlNovecMix
      ATTRIBUTE ICCT seen=1 colo=629
      SHAPE cone dz=0.5*8.7144 rmn1=24.068 rmx1=24.8745,
            rmn2=14.7727 rmx2=17.4338
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ICCA
      BLOCK ICCA   IST purple cable A on PIT
      MATERIAL copper
      ATTRIBUTE ICCA seen=1 colo=629
      SHAPE tube rmin=0 rmax=0.5*cableDiameter,
            dz=0.5*170.18
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ICCL
      BLOCK ICCL   IST cooling line on PIT
      MATERIAL Aluminium
      ATTRIBUTE ICCL seen=1 colo=4
      SHAPE tube rmin=0.5*0.5334 rmax=0.5*0.635,
            dz=0.5*170.18
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ICLP
      BLOCK ICLP   cooling liquid in ICCL volume on PIT area
      ATTRIBUTE ICLP seen=1 colo=920
      MATERIAL NOVEC7200
      SHAPE tube rmin=0 rmax=0.5*0.5334 dz=0.5*170.18
      ENDBLOCK
      <W> '===>> 	[End AgML Module IstdGeo1b]	 <<==='; (A32,/,/);
      END! Module IstdGeo1b
      ! ---------------------------------------------------------------------------------- istdgeo1b_trans_to_ibam
      Subroutine istdgeo1b_trans_to_ibam(x, y,tilt, xpos, ypos)
      real x !intent=in
      real y !intent=in
      real tilt !intent=in
      real xpos !intent=inout
      real ypos !intent=inout
      real *8 sint, cost, degrad,    radius/13.9254/

      degrad=3.1415926/180.0
      sint=sin(degrad*tilt)
      cost=cos(degrad*tilt)
      xpos = 0.0       +  cost*x +sint*y
      ypos = radius    -  sint*x +cost*y
      return
      End !Subroutine istdgeo1b_trans_to_ibam
