      CALL AgsReset 
      CALL agml_position_begin('IBHB') 
      %mother = 'IBAM' 
      %title = 'IBHB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfLadLen-HalfHbdLenTB-OutsideTubeWestLen-1.75) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBHC
      x= - HalfLadWdt + DistFoamToLadder
      y= - HalfLadThk + HalfFoamThk + 2.4244 + 2*HalfSkinThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBHC') 
      %mother = 'IBAM' 
      %title = 'IBHC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfLadLen-HalfHbdArcLen-OutsideTubeWestLen-1.75) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBAT
      x= - HalfLadWdt + DistFoamToLadder + HalfFoamWdt + TubeRmax
      y=HalfLadThk - 2*HalfTBoardThk - 2*HalfTBslotThk - 2*HalfHbdThkTB - 2*HalfSkinThk _
            - DistTubeTopSkin
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBAT') 
      %title = 'IBAT' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfTubeLen-HalfLadLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBCW
      x= - HalfLadWdt + DistFoamToLadder + HalfFoamWdt + TubeRmax
      y=HalfLadThk - 2*HalfTBoardThk - 2*HalfTBslotThk - 2*HalfHbdThkTB - 2*HalfSkinThk _
            - DistTubeTopSkin
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBCW') 
      %title = 'IBCW' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(LiquidInTubeLen-HalfLadLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBRB
      x= - HalfLadWdt + HalfTBoardWdt
      y=HalfLadThk - HalfTBoardThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBRB') 
      %title = 'IBRB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+OutsideTubeEastLen-OutsideTBoardLen+HalfTBoardLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IRSA
      x= - HalfLadWdt + DistFoamToLadder + DistSlotCtoFoam + 5*HalfTBslotWdt + 2*TBSlotGapSize
      y=HalfLadThk - 2*HalfTBoardThk - HalfTBslotThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IRSA') 
      %title = 'IRSA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+OutsideTubeEastLen+1.75+0.03+HalfTBslotLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IRSB
      x= - HalfLadWdt + DistFoamToLadder + DistSlotCtoFoam + 3*HalfTBslotWdt + TBSlotGapSize
      y=HalfLadThk - 2*HalfTBoardThk - HalfTBslotThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IRSB') 
      %title = 'IRSB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z =  _
	real(-HalfLadLen+OutsideTubeEastLen+1.75+0.03+3*HalfTBslotLen-OverlapSlotsLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IRSC
      x= - HalfLadWdt + DistFoamToLadder + DistSlotCtoFoam + HalfTBslotWdt
      y=HalfLadThk - 2*HalfTBoardThk - HalfTBslotThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IRSC') 
      %title = 'IRSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z =  _
	real(-HalfLadLen+OutsideTubeEastLen+1.75+0.03+5*HalfTBslotLen-2*OverlapSlotsLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBTS
      x= - HalfLadWdt + DistFoamToLadder + 0.2581 + 0.5*0.1625
      y=2.4244 - 2*HalfHbdThkTB - HalfLadThk - 0.5*0.06
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBTS') 
      %mother = 'IBAM' 
      %title = 'IBTS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+OutsideTubeEastLen+21.0235+0.5*0.1625) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IECW
      x=HalfLadWdt - HalfEndcapMomWdt - 0.15
      y=HalfEndcapMomThk + 2.4244 - HalfLadThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IECW') 
      %mother = 'IBAM' 
      %title = 'IECW' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(HalfLadLen-OutsideTubeWestLen-HalfEndcapMomLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IECE
      x=HalfLadWdt - HalfEndcapMomWdt - 0.15
      y=HalfEndcapMomThk + 2.4244 - HalfLadThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IECE') 
      %mother = 'IBAM' 
      %title = 'IECE' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+OutsideTubeEastLen+HalfEndcapMomLen) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      DO nu = 1, nUnit
      CREATE IBLM
      x=HalfLadWdt-HalfSenMomWdt-DistSensorToLadder-0.15
      y=2.4244-2*HalfHbdThkTB-HalfSenMomThk-HalfLadThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      IF ( debug==1 ) THEN
      <W> x;  ('xl ', F7.4);
      <W> y;  ('yl ', F7.4);
      <W> xpos;  ('xp ', F7.4);
      <W> ypos;  ('yp ', F7.4);
      ENDIF
      CALL AgsReset 
      CALL agml_position_begin('IBLM') 
      %mother = 'IBAM' 
      %title = 'IBLM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'ONLY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1.0*HalfLadLen+DistLadderToIBLM+HalfSenMomLen*(2*nu-1)) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      DO nsc = 1, 2
      CREATE ISCM
      x=HalfLadWdt-HalfEndcapMomWdt-0.15
      y=-HalfLadThk+2.4244+2*HalfEndcapMomThk-0.2845
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('ISCM') 
      %mother = 'IBAM' 
      %title = 'ISCM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+OutsideTubeEastLen+0.75+(1.5+HalfCombLen)*(2*nsc-2)) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      DO ns = 1, 2
      CREATE IBSR
      x=HalfLadWdt-1.0*HalfSRMomWdt
      y=HalfSRMomThk-1.0*HalfLadThk
      Call istdgeo1b_trans_to_ibam( x,y,Tilt,xp,yp )
      CALL AgsReset 
      CALL agml_position_begin('IBSR') 
      %mother = 'IBAM' 
      %title = 'IBSR' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xp) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-HalfLadLen+9.9143+HalfSRMomLen+58.88*(ns-1)) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-1.0*Tilt) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ILCC
      BLOCK ILCC   Choneycomb mother volume
      ATTRIBUTE ILCC seen=0 colo=1
      MATERIAL Air
      SHAPE box dx=HalfCombWdt dy=HalfCombThk,
            dz=HalfCombLen
      CREATE ICCU
      CALL AgsReset 
