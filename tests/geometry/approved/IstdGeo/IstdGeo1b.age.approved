      ! ---------------------------------------------------------------------------------- IBCJ
      BLOCK IBCJ   IST cooling loops and joints
      MATERIAL Air
      ATTRIBUTE IBCJ seen=0 colo=6
      SHAPE box dx=2.88855 dy=0.91655 dz=5.7294
      DO nSeg = 1, 20
      tubeAngle=raddeg*(2*nSeg-1)*180/(2.0*20)
      xtubeArc=-2.88855+0.5*1.8331+1.97-1.97*cos(tubeAngle)
      ytubeArc=0.0
      ztubeArc=-5.7294+2.722875+0.1778+6.35+1.97*sin(tubeAngle)
      CREATE ICJR
      CALL AgsReset 
      CALL agml_position_begin('ICJR') 
      %mother = 'IBCJ' 
      %title = 'ICJR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xtubeArc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ytubeArc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(ztubeArc) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real((2*nSeg-1)*180/(2.0*20)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
