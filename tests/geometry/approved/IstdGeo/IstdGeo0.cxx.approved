          AgBlock *IBMO::mInstance = 0;     
          AgBlock *IBMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBMO();        
                   return mInstance;        
          }     
          void IBMO::Block( AgCreate create )     
          {         
                ///@addtogroup IBMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBMO");              
                            attr.par("seen")=0;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=ismg.rin;              
                            shape.par("rmax")=ismg.rout;              
                            shape.par("dz")=ladder_length/2.0;              
                            /// Shape Tube rmin=ismg.rin rmax=ismg.rout dz=ladder_length/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBMO;              
                            _stacker -> Build(this);              
                      }           
                      moduleradius=isbg.radius+module_thk/2.0-isss.activethk/2.0;           
                      /// Loop on nl from 1 to isbg.nladder step=1           
                      for ( nl=1; (1>0)? (nl<=isbg.nladder):(nl>=isbg.nladder); nl+=1 )           
                      {              
                            aangle=(360.0/isbg.nladder)*nl-isbg.tilt;              
                            bangle=(aangle+isbg.tilt)*raddeg;              
                            inix=0.0;              
                            iniy=0.0;              
                            if ( debug==1 )              
                            {                 
                                  // - Info -                  
                                  Info( GetName(), Form("shiftinX=%6.4f",paro.dx*paro.mult)  );                 
                                  // - Info -                  
                                  Info( GetName(), Form("shiftinY=%6.4f",paro.dy*paro.mult)  );                 
                                  // - Info -                  
                                  Info( GetName(), Form("shiftinZ=%6.4f",paro.dz*paro.mult)  );                 
                            }              
                            xpos=moduleradius*sin((aangle+half)*raddeg)+(paro.dx*paro.mult)*paro.lad[int(nl)-1];              
                            ypos=moduleradius*cos((aangle+half)*raddeg)+(paro.dy*paro.mult)*paro.lad[int(nl)-1];              
                            zpos=0.0+(paro.dz*paro.mult)*paro.lad[int(nl)-1];              
                            if ( debug==1 )              
                            {                 
                                  // - Info -                  
                                  Info( GetName(), Form("aabgle=%6.3f",aangle)  );                 
                                  // - Info -                  
                                  Info( GetName(), Form("bangle=%6.3f",bangle)  );                 
                                  // - Info -                  
                                  Info( GetName(), Form("x=%6.3f",xpos)  );                 
                                  // - Info -                  
                                  Info( GetName(), Form("y=%6.3f",ypos)  );                 
                            }              
                            _create = AgCreate("IBAM");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create IBAM                 
                                  Create("IBAM");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("IBAM");                 
                                  place.SetMother("IBMO");                 
                                  /// Add daughter volume IBAM to mother IBMO                 
                                  place.TranslateX(xpos);                 
                                  /// Translate x = xpos                 
                                  place.TranslateY(ypos);                 
                                  /// Translate y = ypos                 
                                  place.TranslateZ(zpos);                 
                                  /// Translate z = zpos                 
                                  place.par("only")=AgPosition::kMany;                 
                                  /// Overlap: agposition::kmany                 
                                  if ( debug==1 )                 
                                  {                    
                                        // - Info -                     
                                        Info( GetName(), Form("rotalongX=%6.4f",para.da*para.mult)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("rotalongY=%6.4f",para.db*para.mult)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("rotalongZ=%6.4f",para.dg*para.mult)  );                    
                                  }                 
                                  place.AlphaZ(-1*aangle-(isbg.tilt+para.dg*para.mult*para.lad[int(nl)-1]));                 
                                  /// Rotate: AlphaZ = -1*aangle-(isbg.tilt+para.dg*para.mult*para.lad[int(nl)-1])                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaX(-1*(para.da*para.mult)*para.lad[int(nl)-1]);                 
                                  /// Rotate: AlphaX = -1*(para.da*para.mult)*para.lad[int(nl)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaY(-1*(para.db*para.mult)*para.lad[int(nl)-1]);                 
                                  /// Rotate: AlphaY = -1*(para.db*para.mult)*para.lad[int(nl)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("IBAM"), place );                 
                            } // end placement of IBAM              
                      }           
                      END_OF_IBMO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBMO     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *IBAM::mInstance = 0;     
          AgBlock *IBAM::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBAM();        
                   return mInstance;        
          }     
          void IBAM::Block( AgCreate create )     
          {         
                ///@addtogroup IBAM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBAM");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=ladder_width/2.0;              
                            shape.par("dy")=ladder_thk/2.0;              
                            shape.par("dz")=ladder_length/2.0;              
                            /// Shape Bbox dx=ladder_width/2.0 dy=ladder_thk/2.0 dz=ladder_length/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBAM;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on nu from 1 to isbg.nunit step=1           
                      for ( nu=1; (1>0)? (nu<=isbg.nunit):(nu>=isbg.nunit); nu+=1 )           
                      {              
                            _create = AgCreate("IBLM");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create IBLM                 
                                  Create("IBLM");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("IBLM");                 
                                  place.SetMother("IBAM");                 
                                  /// Add daughter volume IBLM to mother IBAM                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(-1.0*ladder_length/2.+isss.activeh*(nu-0.5));                 
                                  /// Translate z = -1.0*ladder_length/2.+isss.activeh*(nu-0.5)                 
                                  if ( debug==1 )                 
                                  {                    
                                        // - Info -                     
                                        Info( GetName(), Form("zpos=%6.3f",-1.0*ladder_length/2.+isss.activeh*(nu-0.5))  );                    
                                  }                 
                                  _stacker -> Position( AgBlock::Find("IBLM"), place );                 
                            } // end placement of IBLM              
                      }           
                      END_OF_IBAM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBAM     
