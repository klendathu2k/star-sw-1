    // ----------------------------------------------------------------------- geoctr
       void IstdGeo0::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup IstdGeo0_revision        
             ///@{           
                   /// Created:   12/06/14            
             ///@}        
             ///@addtogroup IstdGeo0_revision        
             ///@{           
                   /// Author: Jonathan Bouchet           
             ///@}        
             AddBlock("IBMO", IBMO::Instance());        
             AddBlock("IBAM", IBAM::Instance());        
             AddBlock("IBLM", IBLM::Instance());        
             AddBlock("IBSS", IBSS::Instance());        
             AddBlock("IBSP", IBSP::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ismg
++ismg._index;
ismg.version = 1.0;
// ismg_docum.version = " Version, this goes to g2t_volume_id.g ;//;// ";
ismg.subversion = 0;
// ismg_docum.subversion = " For future use with g2t_volume_id.g ";
ismg.rin = 13.50;
// ismg_docum.rin = "Inner Radius";
ismg.rout = 15.0;
