             module_thk=isss.activethk+isss.passivethk;        
             ladder_thk=module_thk;        
             ladder_width=isss.activew;        
             debug=0;        
             ladder_length=isbg.nunit*isss.activeh;        
             _create = AgCreate("IBMO");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create IBMO           
                   Create("IBMO");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("IBMO");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume IBMO to mother IDSM           
                   _stacker -> Position( AgBlock::Find("IBMO"), place );           
             } // end placement of IBMO        
