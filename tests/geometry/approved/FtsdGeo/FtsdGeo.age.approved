      diskid = ndisk ! disk number
      x = 0.0 ! x center of disk [cm]
      y = 0.0 ! y center of disk [cm]
      z = zdisk ! z center of disk [cm]
      ENDFILL
      zdisk = zdisk + dzdisk
      ndisk = ndisk + 1
      FILL FDSK		! Third disk
      version = 1.2 ! disk version
      diskid = ndisk ! disk number
      x = 0.0 ! x center of disk [cm]
      y = 0.0 ! y center of disk [cm]
      z = zdisk ! z center of disk [cm]
