      use FDSK
      use FDSK diskid=1
      zmin = FDSK_z    - FDSK_thksupp
      rmin = FDSK_rmin
      use FDSK diskid=ndisk
      zmax = FDSK_z    + FDSK_thksupp
      rmax = FDSK_rmax
      xcenter = 0
      ycenter = 0
      zcenter = zmin + (zmax-zmin) / 2.0
      CREATE FTSM
      IF MAIN_useids.eq.1.0 { 
      CALL AgsReset 
      CALL agml_position_begin('FTSM') 
      %mother = 'IDSM' 
      %title = 'FTSM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'ONLY' 
      ag_x = real(xcenter) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ycenter) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zcenter) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF MAIN_useids.eq.1.0 
      CALL AgsReset 
      CALL agml_position_begin('FTSM') 
      %mother = 'CAVE' 
      %title = 'FTSM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'ONLY' 
      ag_x = real(xcenter) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ycenter) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zcenter) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- FTSM
      BLOCK FTSM   Mother volume for the FTS
      MATERIAL air
      MATERIAL air isvol=0
      MEDIUM standard
      ATTRIBUTE FSTM seen=0 colo=1
      SHAPE tube rmin=rmin rmax=rmax dz=(zmax-zmin)/2.0
      DO idisk = 1, ndisk
      use FDSK diskid=idisk
      IF ( MAIN_active(idisk).eq.1 ) THEN
      CREATE FTSD
      CALL AgsReset 
      CALL agml_position_begin('FTSD') 
      %mother = 'FTSM' 
      %title = 'FTSD' 
      %exname = 'POSITION' ! agml placement 
      %ncopy = real(idisk) 
      ag_x = real(FDSK_x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(FDSK_y) 
      CALL agml_translate_y( %y ) 
      ag_z = real(FDSK_z-zcenter) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_NCOPY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      <W> idisk;  ('Positioning FTSD ', I2);
      ENDIF
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTSD
      BLOCK FTSD   FTS disk
      ATTRIBUTE FTSD seen=0 colo=3
      SHAPE tube rmin=FDSK_rmin rmax=FDSK_rmax,
            dz=FDSK_thksupp
      CREATE FTSA
      CALL AgsReset 
      CALL agml_position_begin('FTSA') 
      %title = 'FTSA' 
      %exname = 'POSITION' ! agml placement 
      %rmin = real(FDSK_rminsens) 
      %rmax = real(FDSK_rmaxsens) 
      %dz = real(FDSK_thksens) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE FTSS
      CALL AgsReset 
      CALL agml_position_begin('FTSS') 
      %title = 'FTSS' 
      %exname = 'POSITION' ! agml placement 
      %rmin = real(FDSK_rmin) 
      %rmax = real(FDSK_rminsens) 
      %dz = real(FDSK_thksupp) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FTSS') 
      %title = 'FTSS' 
      %exname = 'POSITION' ! agml placement 
      %rmin = real(FDSK_rmaxsens) 
      %rmax = real(FDSK_rmax) 
      %dz = real(FDSK_thksupp) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTSA
      BLOCK FTSA   Active volume of the FTS
      ATTRIBUTE FTSA seen=1 colo=4
      MATERIAL silicon
      MATERIAL silicon isvol=1
      SHAPE tube rmin=0 rmax=0 dz=0
      HITS FTSA z:.00001:S y:.00001:S x:.00001:S ptot:16:(0,100) cx:10: cy:10: cz:10:,
            sleng:16:(0,500) tof:16: step:.0001: eloss:16:
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTSS
      BLOCK FTSS   Support structure for each disk
      ATTRIBUTE FTSS seen=1 colo=3
      MATERIAL aluminium
      MATERIAL aluminium isvol=0
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      <W> '===>> 	[End AgML Module FtsdGeo]	 <<==='; (A32,/,/);
      END! Module FtsdGeo
