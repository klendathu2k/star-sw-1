      rminsens = zdisk*eta2tan(4.0) ! minimum radius of sensitive layer [cm]
      rmaxsens = zdisk*eta2tan(2.5) ! maximum radius of sensitive layer [cm]
      thksens = 0.03744 ! thickness of sensitive layer [cm]
      thksupp = 0.8 ! thickness of support material [cm]
      ENDFILL
