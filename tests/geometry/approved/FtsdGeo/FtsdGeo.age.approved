      rmax = 116.66*eta2tan(2.5)+1.0 ! maximum radius of disk [cm]
      rminsens = 116.66*eta2tan(4.0) ! minimum radius of sensitive layer [cm]
      rmaxsens = 116.66*eta2tan(2.5) ! maximum radius of sensitive layer [cm]
      thksens = 0.2 ! thickness of sensitive layer [cm]
      thksupp = 0.8 ! thickness of support material [cm]
