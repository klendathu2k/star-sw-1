      x = 0.0 ! x center of disk [cm]
      y = 0.0 ! y center of disk [cm]
      z = zdisk ! z center of disk [cm]
      rmin = zdisk*eta2tan(4.0)-1.0 ! minimum radius of disk [cm]
      rmax = zdisk*eta2tan(2.5)+1.0 ! maximum radius of disk [cm]
      rminsens = zdisk*eta2tan(4.0) ! minimum radius of sensitive layer [cm]
      rmaxsens = zdisk*eta2tan(2.5) ! maximum radius of sensitive layer [cm]
