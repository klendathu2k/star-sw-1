          AgBlock *FTSM::mInstance = 0;     
          AgBlock *FTSM::Instance(){        
                   if ( mInstance==0 ) mInstance = new FTSM();        
                   return mInstance;        
          }     
          void FTSM::Block( AgCreate create )     
          {         
                ///@addtogroup FTSM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Material air isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Air");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FSTM");              
                            attr.par("seen")=0;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=rmin;              
                            shape.par("rmax")=rmax;              
                            shape.par("dz")=(zmax-zmin)/2.0;              
                            /// Shape Tube rmin=rmin rmax=rmax dz=(zmax-zmin)/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTSM;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on idisk from 1 to ndisk step=1           
                      for ( idisk=1; (1>0)? (idisk<=ndisk):(idisk>=ndisk); idisk+=1 )           
                      {              
                            /// USE fdsk diskid=idisk;              
                            FDSK.use( __fdsk_diskid__ = idisk );
              
                            if ( main.active[int(idisk)-1]==1 )              
                            {                 
                                  _create = AgCreate("FTSD");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create FTSD                    
                                        Create("FTSD");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTSD");                    
                                        place.SetMother("FTSM");                    
                                        /// Add daughter volume FTSD to mother FTSM                    
                                        place.TranslateX(fdsk.x);                    
                                        /// Translate x = fdsk.x                    
                                        place.TranslateY(fdsk.y);                    
                                        /// Translate y = fdsk.y                    
                                        place.TranslateZ(fdsk.z-zcenter);                    
                                        /// Translate z = fdsk.z-zcenter                    
                                        place.par("ncopy")=idisk;                    
                                        /// Ncopy: idisk                    
                                        _stacker -> Position( AgBlock::Find("FTSD"), place );                    
                                  } // end placement of FTSD                 
                                  // - Info -                  
                                  Info( GetName(), Form("PositioningFTSD%2i",idisk)  );                 
                            }              
                      }           
                      END_OF_FTSM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTSM     
