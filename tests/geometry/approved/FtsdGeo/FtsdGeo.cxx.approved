          void FTSD::Block( AgCreate create )     
          {         
                ///@addtogroup FTSD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FTSD");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=fdsk.rmin;              
                            shape.par("rmax")=fdsk.rmax;              
                            shape.par("dz")=fdsk.thksupp;              
                            /// Shape Tube rmin=fdsk.rmin rmax=fdsk.rmax dz=fdsk.thksupp               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTSD;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FTSA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTSA              
                            Create("FTSA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTSA");              
                            place.SetMother("FTSD");              
                            /// Add daughter volume FTSA to mother FTSD              
                            place.par("dz")=fdsk.thksens;              
                            place.par("rmin")=fdsk.rminsens;              
                            place.par("rmax")=fdsk.rmaxsens;              
                            _stacker -> Position( AgBlock::Find("FTSA"), place );              
                      } // end placement of FTSA           
                      _create = AgCreate("FTSS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTSS              
                            Create("FTSS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTSS");              
                            place.SetMother("FTSD");              
                            /// Add daughter volume FTSS to mother FTSD              
                            place.par("dz")=fdsk.thksupp;              
                            place.par("rmin")=fdsk.rmin;              
                            place.par("rmax")=fdsk.rminsens;              
                            _stacker -> Position( AgBlock::Find("FTSS"), place );              
                      } // end placement of FTSS           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTSS");              
                            place.SetMother("FTSD");              
                            /// Add daughter volume FTSS to mother FTSD              
                            place.par("dz")=fdsk.thksupp;              
                            place.par("rmin")=fdsk.rmaxsens;              
                            place.par("rmax")=fdsk.rmax;              
                            _stacker -> Position( AgBlock::Find("FTSS"), place );              
                      } // end placement of FTSS           
                      END_OF_FTSD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTSD     
