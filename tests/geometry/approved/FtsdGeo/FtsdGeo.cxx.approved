             }        
             /// USE fdsk _index=1;        
             FDSK.use( __fdsk__index__ = 1 );
        
             /// USE fdsk diskid=1;        
             FDSK.use( __fdsk_diskid__ = 1 );
        
             zmin=fdsk.z-fdsk.thksupp;        
             rmin=fdsk.rmin;        
             /// USE fdsk diskid=ndisk;        
             FDSK.use( __fdsk_diskid__ = ndisk );
        
             zmax=fdsk.z+fdsk.thksupp;        
             rmax=fdsk.rmax;        
             xcenter=0;        
             ycenter=0;        
             zcenter=zmin+(zmax-zmin)/2.0;        
             _create = AgCreate("FTSM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create FTSM           
                   Create("FTSM");            
             }        
             if ( main.useids==1.0 )        
             {           
                   AgPosition  place;           
                   place.SetBlock("FTSM");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume FTSM to mother IDSM           
                   place.TranslateX(xcenter);           
                   /// Translate x = xcenter           
                   place.TranslateY(ycenter);           
                   /// Translate y = ycenter           
                   place.TranslateZ(zcenter);           
                   /// Translate z = zcenter           
                   place.par("only")=AgPosition::kOnly;           
                   /// Overlap: agposition::konly           
                   _stacker -> Position( AgBlock::Find("FTSM"), place );           
             } // end placement of FTSM        
             {           
                   AgPosition  place;           
                   place.SetBlock("FTSM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume FTSM to mother CAVE           
                   place.TranslateX(xcenter);           
                   /// Translate x = xcenter           
                   place.TranslateY(ycenter);           
                   /// Translate y = ycenter           
                   place.TranslateZ(zcenter);           
                   /// Translate z = zcenter           
                   place.par("only")=AgPosition::kOnly;           
                   /// Overlap: agposition::konly           
                   _stacker -> Position( AgBlock::Find("FTSM"), place );           
             } // end placement of FTSM        
       }; // FtsdGeo     
 }; // namespace FtsdGeo  
 