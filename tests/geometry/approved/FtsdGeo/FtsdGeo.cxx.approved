// fdsk_docum.x = "x center of disk [cm]";
fdsk.y = 0.0;
// fdsk_docum.y = "y center of disk [cm]";
fdsk.z = zdisk;
// fdsk_docum.z = "z center of disk [cm]";
fdsk.rmin = zdisk*eta2tan(4.0)-3.0;
// fdsk_docum.rmin = "minimum radius of disk [cm]";
fdsk.rmax = zdisk*eta2tan(2.5)+3.0;
// fdsk_docum.rmax = "maximum radius of disk [cm]";
fdsk.rminsens = zdisk*eta2tan(4.0);
// fdsk_docum.rminsens = "minimum radius of sensitive layer [cm]";
fdsk.rmaxsens = zdisk*eta2tan(2.5);
// fdsk_docum.rmaxsens = "maximum radius of sensitive layer [cm]";
fdsk.thksens = 0.03744;
// fdsk_docum.thksens = "thickness of sensitive layer [cm]";
fdsk.thksupp = 0.8;
// fdsk_docum.thksupp = "thickness of support material [cm]";
FDSK.fill();
           
