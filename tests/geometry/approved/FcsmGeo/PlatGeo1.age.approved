      MODULE PlatGeo1    is the Forward Calorimeter System Platform GEOmetry
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Created    10 Aug 2018
      Author Akio Ogawa
      +CDE,agecom.
      +CDE,gconst.
      +CDE,gcunit.
      CONTENT WPPL,WPIS,WPUF,WPUN,WPUS,WPAR
      STRUCTURE WPFM { version,PoleD(4),PoleP(3),IstrD(4),Ist1P(3),Ist2P(3),UstFD(4),
            UstFP(3),UstND(4),UstNP(3),UstSD(4),UstSP(3)}
      FILL WPFM		! West Platform geometry
      version = 1 ! None
      PoleD  = {     12.0*2.54,  155.5 * 2.54,     12.0*2.54, 
                           1.0} !  None
      PoleP  = {                 72.0*2.54, 
                  (-44.36-10-155.5/2)*2.54, 
                            807.72-27*2.54} !  None
      IstrD  = {  231.0*2.54,    8.0*2.54,    8.0*2.54, 
                         1.0} !  None
      Ist1P  = {          -8.0*2.54,  (-44.36-5.0)*2.54, 
                     807.72-37*2.54} !  None
      Ist2P  = {          -8.0*2.54,  (-44.36-5.0)*2.54, 
                     807.72-17*2.54} !  None
      UstFD  = {  236.0*2.54,     12*2.54,      4*2.54, 
                         1.0} !  None
      UstFP  = {           -8.0*2.54,         -44.36*2.54, 
                  807.72-(46-2)*2.54} !  None
      UstND  = {       4*2.54,    12.0*2.54,  (46-4)*2.54, 
                          1.0} !  None
      UstNP  = {       -(118-2+8)*2.54,           -44.36*2.54, 
                  807.72-(46-4)*2.54/2} !  None
      UstSD  = {       4*2.54,    12.0*2.54,  (46-4)*2.54, 
                          1.0} !  None
      UstSP  = {       +(118-2-8)*2.54,           -44.36*2.54, 
                  807.72-(46-4)*2.54/2} !  None
      ENDFILL
      CREATE WPPL
      CALL AgsReset 
      CALL agml_position_begin('WPPL') 
      %mother = 'CAVE' 
      %title = 'WPPL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_PoleP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_PoleP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_PoleP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPPL') 
      %mother = 'CAVE' 
      %title = 'WPPL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-WPFM_PoleP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_PoleP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_PoleP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPIS
      CALL AgsReset 
      CALL agml_position_begin('WPIS') 
      %mother = 'CAVE' 
      %title = 'WPIS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(WPFM_Ist1P(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_Ist1P(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_Ist1P(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPIS') 
      %mother = 'CAVE' 
      %title = 'WPIS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(WPFM_Ist2P(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_Ist2P(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_Ist2P(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUF
      CALL AgsReset 
      CALL agml_position_begin('WPUF') 
      %mother = 'CAVE' 
      %title = 'WPUF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstFP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstFP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstFP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUN
      CALL AgsReset 
      CALL agml_position_begin('WPUN') 
      %mother = 'CAVE' 
      %title = 'WPUN' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstNP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstNP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstNP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUS
      CALL AgsReset 
      CALL agml_position_begin('WPUS') 
      %mother = 'CAVE' 
      %title = 'WPUS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstSP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstSP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstSP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- WPPL
      BLOCK WPPL   is a pole for west platform
      MATERIAL Iron
      ATTRIBUTE WPPL seen=1 colo=4
      SHAPE box dx=WPFM_PoleD(1)/2.0 dy=WPFM_PoleD(2)/2.0,
            dz=WPFM_PoleD(3)/2.0
      CREATE WPAR
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_PoleD(1)/2.0-WPFM_PoleD(4)) 
      %dy = real(WPFM_PoleD(2)/2.0) 
      %dz = real(WPFM_PoleD(3)/2.0-WPFM_PoleD(4)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPIS
      BLOCK WPIS   is a I-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPIS seen=1 colo=4
      SHAPE box dx=WPFM_IstrD(1)/2.0 dy=WPFM_IstrD(2)/2.0,
            dz=WPFM_IstrD(3)/2.0
      CREATE WPAR
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(+(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUF
      BLOCK WPUF   is a front U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUF seen=1 colo=4
      SHAPE box dx=WPFM_UstFD(1)/2.0 dy=WPFM_UstFD(2)/2.0,
            dz=WPFM_UstFD(3)/2.0
      CREATE WPAR
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstFD(4)/2.0) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstFD(1)/2.0) 
      %dy = real(WPFM_UstFD(2)/2.0-WPFM_UstFD(4)) 
      %dz = real(WPFM_UstFD(3)/2.0-WPFM_UstFD(4)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUN
      BLOCK WPUN   is a north U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUN seen=1 colo=4
      SHAPE box dx=WPFM_UstND(1)/2.0 dy=WPFM_UstND(2)/2.0,
            dz=WPFM_UstND(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstND(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstND(1)/2.0-WPFM_UstND(4)/2.0) 
      %dy = real(WPFM_UstND(2)/2.0-WPFM_UstND(4)) 
      %dz = real(WPFM_UstND(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUS
      BLOCK WPUS   is a south U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUS seen=1 colo=4
      SHAPE box dx=WPFM_UstSD(1)/2.0 dy=WPFM_UstSD(2)/2.0,
            dz=WPFM_UstSD(3)/2.0
      CREATE WPAR
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-WPFM_UstSD(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstSD(1)/2.0-WPFM_UstSD(4)/2.0) 
      %dy = real(WPFM_UstSD(2)/2.0-WPFM_UstSD(4)) 
      %dz = real(WPFM_UstSD(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPAR
      BLOCK WPAR   is a platform structs air
      MATERIAL Air
      ATTRIBUTE WPAR seen=1 colo=0
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      <W> '===>> 	[End AgML Module PlatGeo1]	 <<==='; (A32,/,/);
      END! Module PlatGeo1
