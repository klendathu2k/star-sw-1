          AgBlock *PLAY::mInstance = 0;     
          AgBlock *PLAY::Instance(){        
                   if ( mInstance==0 ) mInstance = new PLAY();        
                   return mInstance;        
          }     
          void PLAY::Block( AgCreate create )     
          {         
                ///@addtogroup PLAY_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("PLAY");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.par("serial")=sern;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=dx;              
                            shape.par("dy")=dy;              
                            shape.par("dz")=dz;              
                            /// Shape Bbox dx=dx dy=dy dz=dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PLAY;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PSCI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PSCI              
                            Create("PSCI");               
                      }           
                      /// Loop on i from 1 to pgeo.nslat[int(sn)-1][int(layr)-1] step=1           
                      for ( i=1; (1>0)? (i<=pgeo.nslat[int(sn)-1][int(layr)-1]):(i>=pgeo.nslat[int(sn)-1][int(layr)-1]); i+=1 )           
                      {              
                            if ( pgeo.nslat[int(sn)-1][int(layr)-1]>0 )              
                            {                 
                                  if ( layr==1 )                 
                                  {                    
                                        xxx=wid*(i-5);                    
                                        yyy=0.0;                    
                                        dyy=pgeo.sclth[int(2)-1]/2.0;                    
                                  }                 
                                  else if ( layr<=3 )                 
                                  {                    
                                        if ( i<=7 )                    
                                        {                       
                                              xxx=-1.5*wid*sqrt2+wid*i/sqrt2-39.085;                       
                                              yyy=wid*8/sqrt2-wid*i/sqrt2;                       
                                              dyy=pgeo.sclth[int(11-i)-1]/2.0;                       
                                        }                    
                                        else if ( i>7 )                    
                                        {                       
                                              xxx=2.5*wid*sqrt2+wid*(i-8)*sqrt2-39.085;                       
                                              yyy=0.0;                       
                                              dyy=pgeo.sclth[int(3)-1]/2.0;                       
                                        }                    
                                  }                 
                                  else if ( layr==4 )                 
                                  {                    
                                        if ( i<=19 )                    
                                        {                       
                                              xxx=0.0;                       
                                              yyy=-108.0375+(60+pgeo.scwrap)/sqrt2+wid/2.0+wid*sqrt2*19-pgeo.yoff[int(sn)-1][int(layr)-1]-wid*i*sqrt2;                       
                                              dyy=pgeo.sclth[int(3)-1]/2.0;                       
                                        }                    
                                        else                    
                                        {                       
                                              xxx=wid*(i-19)/sqrt2;                       
                                              yyy=-108.0375+(60+pgeo.scwrap)/sqrt2+wid/2.0-pgeo.yoff[int(sn)-1][int(layr)-1]-wid*(i-19)/sqrt2;                       
                                              dyy=pgeo.sclth[int(i-16)-1]/2.0;                       
                                        }                    
                                  }                 
                                  else if ( layr==5 )                 
                                  {                    
                                        yyy=wid*(22-i);                    
                                        xxx=0.0;                    
                                        dyy=pgeo.sclth[int(2)-1]/2.0;                    
                                  }                 
                                  else if ( layr==6 )                 
                                  {                    
                                        dyy=pgeo.sclth[int(1)-1]/2.0;                    
                                        yyy=54.0;                    
                                        xxx=wid*(i-9);                    
                                        if ( i>17 )                    
                                        {                       
                                              xxx=wid*(i-26);                       
                                              yyy=-yyy;                       
                                        }                    
                                  }                 
                                  if ( sn==2 )                 
                                  {                    
                                        xxx=-xxx;                    
                                  }                 
                                  ang=pgeo.angslat[int(sn)-1][int(layr)-1];                 
                                  dzz=pgeo.scthick/2.0;                 
                                  dxx=pgeo.scwidth/2.0;                 
                                  zzz=-dz+pgeo.scthick/2.0;                 
                                  if ( layr==3 )                 
                                  {                    
                                        zzz=-zzz;                    
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("PSCI");                    
                                        place.SetMother("PLAY");                    
                                        /// Add daughter volume PSCI to mother PLAY                    
                                        place.TranslateX(xxx);                    
                                        /// Translate x = xxx                    
                                        place.TranslateY(yyy);                    
                                        /// Translate y = yyy                    
                                        place.TranslateZ(zzz);                    
                                        /// Translate z = zzz                    
                                        place.par("dx")=dxx;                    
                                        place.par("dy")=dyy;                    
                                        place.par("dz")=dzz;                    
                                        place.AlphaZ(ang);                    
                                        /// Rotate: AlphaZ = ang                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("PSCI"), place );                    
                                  } // end placement of PSCI                 
                                  gx=xxx+pgeo.xoff[int(sn)-1][int(layr)-1];                 
                                  gy=yyy+pgeo.yoff[int(sn)-1][int(layr)-1];                 
                                  gz=zzz+pgeo.zoff[int(sn)-1][int(layr)-1]-pgeo.bpdz/2.0;                 
                                  if ( debug>=1 )                 
                                  {                    
                                  }                 
                                  id=id+1;                 
                            }              
                      }           
                      if ( pgeo.nslat[int(sn)-1][int(layr)-1]>0 )           
                      {              
                            if ( layr==1 )              
                            {                 
                                  dxx=wid*9+1.0;                 
                                  dyy=pgeo.sclth[int(2)-1]/2.0+1.0;                 
                            }              
                            else if ( layr<=3 )              
                            {                 
                                  dxx=64.0;                 
                                  dyy=pgeo.sclth[int(2)-1]/2.0;                 
                            }              
                            else              
                            {                 
                                  dxx=pgeo.sclth[int(2)-1]/2.0+1.0;                 
                                  dyy=pgeo.sclth[int(1)-1]+1.0;                 
                            }              
                            xxx=0.0;              
                            yyy=0.0;              
                            dzz=pgeo.bpdz/2.0;              
                            zzz=dz-pgeo.bpdz/2.0;              
                            if ( layr==3 )              
                            {                 
                                  zzz=-zzz;                 
                            }              
                            _create = AgCreate("PBKB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create PBKB                 
                                  Create("PBKB");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("PBKB");                 
                                  place.SetMother("PLAY");                 
                                  /// Add daughter volume PBKB to mother PLAY                 
                                  place.TranslateX(xxx);                 
                                  /// Translate x = xxx                 
                                  place.TranslateY(yyy);                 
                                  /// Translate y = yyy                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("dx")=dxx;                 
                                  place.par("dy")=dyy;                 
                                  place.par("dz")=dzz;                 
                                  _stacker -> Position( AgBlock::Find("PBKB"), place );                 
                            } // end placement of PBKB              
                      }           
                      END_OF_PLAY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PLAY     
