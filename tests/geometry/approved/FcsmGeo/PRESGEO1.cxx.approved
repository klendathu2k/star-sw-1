          AgBlock *PMOD::mInstance = 0;     
          AgBlock *PMOD::Instance(){        
                   if ( mInstance==0 ) mInstance = new PMOD();        
                   return mInstance;        
          }     
          void PMOD::Block( AgCreate create )     
          {         
                ///@addtogroup PMOD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("PMOD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pgon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=45;              
                            shape.par("dphi")=360;              
                            shape.par("npdiv")=4;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-pgeo.dbox[int(3)-1]/2.0;              
                            shape.Z(1)=pgeo.dbox[int(3)-1]/2.0;              
                            shape.Rmin(0)=pgeo.dhole/2.0;              
                            shape.Rmin(1)=pgeo.dhole/2.0;              
                            shape.Rmax(0)=pgeo.dbox[int(1)-1]/2.0;              
                            shape.Rmax(1)=pgeo.dbox[int(1)-1]/2.0;              
                            /// Shape Pgon phi1=45 dphi=360 npdiv=4 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PMOD;              
                            _stacker -> Build(this);              
                      }           
                      debug=1;           
                      if ( debug>=1 )           
                      {              
                      }           
                      wid=pgeo.scwidth+pgeo.scwrap;           
                      id=0;           
                      sern=0;           
                      /// Loop on sn from 1 to 2 step=1           
                      for ( sn=1; (1>0)? (sn<=2):(sn>=2); sn+=1 )           
                      {              
                            /// Loop on layr from 2 to 6 step=1              
                            for ( layr=2; (1>0)? (layr<=6):(layr>=6); layr+=1 )              
                            {                 
                                  if ( pgeo.nslat[int(sn)-1][int(layr)-1]>0 )                 
                                  {                    
                                        if ( layr==1 )                    
                                        {                       
                                              dx=wid*9+1.0;                       
                                              dy=pgeo.sclth[int(2)-1]/2.0+1.0;                       
                                        }                    
                                        else if ( layr<=3 )                    
                                        {                       
                                              dx=64.0;                       
                                              dy=pgeo.sclth[int(2)-1]/2.0;                       
                                        }                    
                                        else                    
                                        {                       
                                              dx=pgeo.sclth[int(2)-1]/2.0+1.0;                       
                                              dy=pgeo.sclth[int(1)-1]+1.0;                       
                                        }                    
                                        xx=pgeo.xoff[int(sn)-1][int(layr)-1];                    
                                        yy=pgeo.yoff[int(sn)-1][int(layr)-1];                    
                                        dz=(pgeo.scthick+pgeo.bpdz)/2.0;                    
                                        zz=pgeo.zoff[int(sn)-1][int(layr)-1]-(pgeo.zoff[int(1)-1][int(2)-1]+pgeo.dbox[int(3)-1]/2.0-2.0)+pgeo.bpdz/2.0;                    
                                        if ( layr==3 )                    
                                        {                       
                                              zz=pgeo.zoff[int(sn)-1][int(layr)-1]-(pgeo.zoff[int(1)-1][int(2)-1]+pgeo.dbox[int(3)-1]/2.0-2.0)-pgeo.bpdz/2.0;                       
                                        }                    
                                        sern=sern+1;                    
                                        _create = AgCreate("PLAY");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create PLAY                       
                                              Create("PLAY");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("PLAY");                       
                                              place.SetMother("PMOD");                       
                                              /// Add daughter volume PLAY to mother PMOD                       
                                              place.TranslateX(xx);                       
                                              /// Translate x = xx                       
                                              place.TranslateY(yy);                       
                                              /// Translate y = yy                       
                                              place.TranslateZ(zz);                       
                                              /// Translate z = zz                       
                                              place.par("only")=AgPosition::kOnly;                       
                                              /// Overlap: agposition::konly                       
                                              _stacker -> Position( AgBlock::Find("PLAY"), place );                       
                                        } // end placement of PLAY                    
                                  }                 
                            }              
                      }           
                      if ( debug>=1 )           
                      {              
                      }           
                      END_OF_PMOD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PMOD     
