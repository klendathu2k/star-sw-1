          AgBlock *PBKB::mInstance = 0;     
          AgBlock *PBKB::Instance(){        
                   if ( mInstance==0 ) mInstance = new PBKB();        
                   return mInstance;        
          }     
          void PBKB::Block( AgCreate create )     
          {         
                ///@addtogroup PBKB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Component O	a=16	z=8	w=0.4*4*16./174.           
                      /// Mixture g10 dens=1.7           
                      {  AgMaterial &mix = AgMaterial::Get("G10");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.Component("O",16,8,0.4*4*16./174.);              
                            mix.par("dens")=1.7;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("PBKB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.0;              
                            shape.par("dy")=0.0;              
                            shape.par("dz")=0.0;              
                            /// Shape Bbox dx=0.0 dy=0.0 dz=0.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PBKB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PBKB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PBKB     
    // ----------------------------------------------------------------------- geoctr
       void PRESGEO1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PRESGEO1_revision        
             ///@{           
                   /// Created:    10 May 2019            
             ///@}        
             ///@addtogroup PRESGEO1_revision        
             ///@{           
                   /// Author: Akio Ogawa           
             ///@}        
             AddBlock("PMOD", PMOD::Instance());        
             AddBlock("PLAY", PLAY::Instance());        
             AddBlock("PSCI", PSCI::Instance());        
             AddBlock("PBKB", PBKB::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pver
++pver._index;
pver.version = 1.0;
// pver_docum.version = " Geometry version  ";
pver.active = 1;
// pver_docum.active = " 1=active, 0=gone";
PVER.fill();
        
             /// USE pver version=1.0;        
             PVER.use( __pver_version__ = 1.0 );
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pgeo
++pgeo._index;
{
pgeo_info::dbox::Type temp = {
pgeo_info::dbox::BaseType(245.0),
pgeo_info::dbox::BaseType(250.0),
pgeo_info::dbox::BaseType(35.0)
}
;
memcpy(&pgeo.dbox, &temp, sizeof(temp));;
}
// pgeo_docum.dbox = "Mother volume box";
pgeo.dhole = 42.00;
// pgeo_docum.dhole = "None";
pgeo.scthick = 1.0;
// pgeo_docum.scthick = "Scintillator thickness, cm";
pgeo.scwidth = 5.0;
// pgeo_docum.scwidth = "Scintillator width";
pgeo.scwrap = 0.025;
// pgeo_docum.scwrap = "Scintillator wrapping thickness";
{
pgeo_info::sclth::Type temp = {
pgeo_info::sclth::BaseType(108.0),
pgeo_info::sclth::BaseType(85.0),
pgeo_info::sclth::BaseType(113.137),
pgeo_info::sclth::BaseType(103.087),
pgeo_info::sclth::BaseType(93.037),
pgeo_info::sclth::BaseType(82.987),
pgeo_info::sclth::BaseType(72.937),
pgeo_info::sclth::BaseType(62.887),
pgeo_info::sclth::BaseType(52.837),
pgeo_info::sclth::BaseType(42.787)
}
;
memcpy(&pgeo.sclth, &temp, sizeof(temp));;
}
// pgeo_docum.sclth = "length of type s1,s2,s3,s3-1,s3-2,s3-3,s3-4,s3-5,s3-6,s3-7";
{
pgeo_info::xoff::Type temp = {{15.0,49.085,0.0,77.925,77.925,78.125},{0.0,0.0,-49.085,-77.925,-77.925,-78.125}};
memcpy(&pgeo.xoff, &temp, sizeof(temp));;
}
// pgeo_docum.xoff = "None";
{
pgeo_info::yoff::Type temp = {{65.5,65.5,0.0,0.877,0.0,0.0},{0.0,0.0,65.5,0.877,0.0,0.0}};
memcpy(&pgeo.yoff, &temp, sizeof(temp));;
}
// pgeo_docum.yoff = "None";
{
pgeo_info::zoff::Type temp = {{615.899,638.259,0.000,648.419,657.944,667.469},{0.000,0.000,640.529,647.784,657.309,666.834}};
memcpy(&pgeo.zoff, &temp, sizeof(temp));;
}
// pgeo_docum.zoff = "None";
{
pgeo_info::nslat::Type temp = {{9,14,0,25,43,34},{0,0,14,25,43,34}};
memcpy(&pgeo.nslat, &temp, sizeof(temp));;
}
// pgeo_docum.nslat = "None";
{
pgeo_info::angslat::Type temp = {{0.0,-45.0,999.0,-45.0,-90.0,0.0},{999.0,999.0,225.0,225.0,90.0,0.0}};
memcpy(&pgeo.angslat, &temp, sizeof(temp));;
}
// pgeo_docum.angslat = "None";
pgeo.bpdz = 2.54/4.0;
// pgeo_docum.bpdz = "None";
PGEO.fill();
        
             /// USE pgeo _index=1;        
             PGEO.use( __pgeo__index__ = 1 );
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pcut
++pcut._index;
pcut.cutgam = 10*1.0e-6;
// pcut_docum.cutgam = " gamma transport cut ";
pcut.cutele = 10*1.0e-6;
// pcut_docum.cutele = " electron transport cut ";
pcut.cuthad = 1*0.001;
// pcut_docum.cuthad = " hadron transport cut ";
pcut.cutneu = 1*0.001;
// pcut_docum.cutneu = " neutron transport cut ";
pcut.cutmuo = 1*0.001;
// pcut_docum.cutmuo = " muon transport cut ";
pcut.dcute = 10*1.0e-6;
// pcut_docum.dcute = " electron delta ray cut ";
pcut.dcutm = 10*1.0e-6;
// pcut_docum.dcutm = " muon delta ray cut ";
pcut.bcute = 10*1.0e-6;
// pcut_docum.bcute = " electron brem cut ";
pcut.bcutm = 10*1.0e-6;
// pcut_docum.bcutm = " muon brem cut ";
PCUT.fill();
        
             /// USE pcut _index=1;        
             PCUT.use( __pcut__index__ = 1 );
        
             dtr=pi/180.0;        
             xtot=pgeo.dbox[int(1)-1];        
             ztot=pgeo.dbox[int(3)-1];        
             if ( pver.active==1 )        
             {           
                   _create = AgCreate("PMOD");           
                   {              
                         AgShape myshape; // undefined shape              
                         ///Create PMOD              
                         Create("PMOD");               
                   }           
                   {              
                         AgPosition  place;              
                         place.SetBlock("PMOD");              
                         place.SetMother("CAVE");              
                         place.SetGroup("WestRefSys");              
                         /// Add daughter volume PMOD to mother CAVE              
                         place.TranslateX(0.0);              
                         /// Translate x = 0.0              
                         place.TranslateY(0.0);              
                         /// Translate y = 0.0              
                         place.TranslateZ(pgeo.zoff[int(1)-1][int(2)-1]-2.0+pgeo.dbox[int(3)-1]/2.0);              
                         /// Translate z = pgeo.zoff[int(1)-1][int(2)-1]-2.0+pgeo.dbox[int(3)-1]/2.0              
                         place.par("only")=AgPosition::kOnly;              
                         /// Overlap: agposition::konly              
                         _stacker -> Position( AgBlock::Find("PMOD"), place );              
                   } // end placement of PMOD           
             }        
             else        
             {           
                   // - Info -            
                   Info( GetName(), Form("PresGeoswitchedoffonPVER.active=%1i",pver.active)  );           
             }        
       }; // PRESGEO1     
 }; // namespace PRESGEO1  
 