          void HTOW::Block( AgCreate create )     
          {         
                ///@addtogroup HTOW_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HTOW");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.par("fill")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=xtow/2.0;              
                            shape.par("dy")=ytow/2.0;              
                            shape.par("dz")=hgeo.depth/2.0;              
                            /// Shape Bbox dx=xtow/2.0 dy=ytow/2.0 dz=hgeo.depth/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HTOW;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HSPC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HSPC              
                            Create("HSPC");               
                      }           
                      _create = AgCreate("HWSP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HWSP              
                            Create("HWSP");               
                      }           
                      _create = AgCreate("HRSP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HRSP              
                            Create("HRSP");               
                      }           
                      _create = AgCreate("HSCI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HSCI              
                            Create("HSCI");               
                      }           
                      zgap=(hgeo.dzlay-hgeo.dzabs-hgeo.dzsci)/2.0;           
                      zz=-hgeo.depth/2.0;           
                      xsc=-hgeo.dxwls/2.0;           
                      ysc=-(hgeo.dy-hgeo.dysci)/2.0;           
                      // - Info -            
                      Info( GetName(), Form("FCSHCalScintixpos=%10.5f",xsc)  );           
                      // - Info -            
                      Info( GetName(), Form("FCSHCalScintiypos=%10.5f",ysc)  );           
                      zz=zz+zsci/2.0;           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HSCI");              
                            place.SetMother("HTOW");              
                            /// Add daughter volume HSCI to mother HTOW              
                            place.TranslateX(xsc);              
                            /// Translate x = xsc              
                            place.TranslateY(ysc);              
                            /// Translate y = ysc              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("HSCI"), place );              
                      } // end placement of HSCI           
                      zz=zz+zsci/2.0+hgeo.dzrsp/2.0;           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HRSP");              
                            place.SetMother("HTOW");              
                            /// Add daughter volume HRSP to mother HTOW              
                            place.TranslateX(xsc);              
                            /// Translate x = xsc              
                            place.TranslateY(ysc);              
                            /// Translate y = ysc              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("HRSP"), place );              
                      } // end placement of HRSP           
                      zz=-hgeo.depth/2.0+ztot/2.0;           
                      xwls=+hgeo.dx/2.0-hgeo.dxwls/2.0;           
                      ywls=-(hgeo.dy-hgeo.dywls)/2.0;           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HWSP");              
                            place.SetMother("HTOW");              
                            /// Add daughter volume HWSP to mother HTOW              
                            place.TranslateX(xwls);              
                            /// Translate x = xwls              
                            place.TranslateY(ywls);              
                            /// Translate y = ywls              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("HWSP"), place );              
                      } // end placement of HWSP           
                      zz=-hgeo.depth/2.0+ztot/2.0;           
                      xspc=0.0;           
                      yspc=hgeo.dy/2.0-hgeo.dyspc/2.0;           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HSPC");              
                            place.SetMother("HTOW");              
                            /// Add daughter volume HSPC to mother HTOW              
                            place.TranslateX(xspc);              
                            /// Translate x = xspc              
                            place.TranslateY(yspc);              
                            /// Translate y = yspc              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("HSPC"), place );              
                      } // end placement of HSPC           
                      END_OF_HTOW:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HTOW     
