          void HSCI::Block( AgCreate create )     
          {         
                ///@addtogroup HSCI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Polystyren            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Medium hcal_scinti           
                      ///  isvol = 1           
                      {  AgMedium &med = AgMedium::Get("Hcal_scinti");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HSCI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=601;              
                            attr.par("lwid")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=hgeo.dxsci/2.0;              
                            shape.par("dy")=hgeo.dysci/2.0;              
                            shape.par("dz")=zsci/2.0;              
                            /// Shape Bbox dx=hgeo.dxsci/2.0 dy=hgeo.dysci/2.0 dz=zsci/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HSCI;              
                            _stacker -> Build(this);              
                      }           
                      // parameter birk1 = 1. (deferred)           
                      // parameter birk2 = 0.013 (deferred)           
                      // parameter birk3 = 9.6e-6 (deferred)           
                      // deferred module()->AddHit( "HSCI", "birk", 0, 0, 6.0, "");           
                      // deferred module()->AddHit( "HSCI", "HSCA", 0, 0, 0.6, "");           
                      // deferred module()->AddHit( "HSCI", "HSCB", 0, 0, 3.0, "");           
                      // deferred module()->AddHit( "HSCI", "HSCC", 0, 0, 3.0, "");           
                      // deferred module()->AddHit( "HSCI", "HSCD", 0, 0, 0.6, "");           
                      _create = AgCreate("HABS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HABS              
                            Create("HABS");               
                      }           
                      _create = AgCreate("HGAP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HGAP              
                            Create("HGAP");               
                      }           
                      zzz=-zsci/2.0;           
                      /// Loop on i from 1 to hgeo.nlayer step=1           
                      for ( i=1; (1>0)? (i<=hgeo.nlayer):(i>=hgeo.nlayer); i+=1 )           
                      {              
                            zzz=zzz+hgeo.dzabs/2.0;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("HABS");                 
                                  place.SetMother("HSCI");                 
                                  /// Add daughter volume HABS to mother HSCI                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("only")=AgPosition::kOnly;                 
                                  /// Overlap: agposition::konly                 
                                  _stacker -> Position( AgBlock::Find("HABS"), place );                 
                            } // end placement of HABS              
                            zzz=zzz+hgeo.dzabs/2.0+zgap/2.0;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("HGAP");                 
                                  place.SetMother("HSCI");                 
                                  /// Add daughter volume HGAP to mother HSCI                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("only")=AgPosition::kOnly;                 
                                  /// Overlap: agposition::konly                 
                                  _stacker -> Position( AgBlock::Find("HGAP"), place );                 
                            } // end placement of HGAP              
                            zzz=zzz+zgap/2.0+hgeo.dzsci+zgap/2.0;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("HGAP");                 
                                  place.SetMother("HSCI");                 
                                  /// Add daughter volume HGAP to mother HSCI                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("only")=AgPosition::kOnly;                 
                                  /// Overlap: agposition::konly                 
                                  _stacker -> Position( AgBlock::Find("HGAP"), place );                 
                            } // end placement of HGAP              
                            zzz=zzz+zgap/2.0;              
                      }           
                      END_OF_HSCI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HSCI     
