          void HMOD::Block( AgCreate create )     
          {         
                ///@addtogroup HMOD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HMOD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.par("fill")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=xtot/2.0;              
                            shape.par("dy")=ytot/2.0;              
                            shape.par("dz")=hgeo.depth/2.0;              
                            /// Shape Bbox dx=xtot/2.0 dy=ytot/2.0 dz=hgeo.depth/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HMOD;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HTOW");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HTOW              
                            Create("HTOW");               
                      }           
                      /// Loop on iy from 1 to hgeo.ny step=1           
                      for ( iy=1; (1>0)? (iy<=hgeo.ny):(iy>=hgeo.ny); iy+=1 )           
                      {              
                            yy=(hgeo.ny/2.0-iy+0.5)*ytow;              
                            /// Loop on ix from 1 to hgeo.nx step=1              
                            for ( ix=1; (1>0)? (ix<=hgeo.nx):(ix>=hgeo.nx); ix+=1 )              
                            {                 
                                  xx=-(hgeo.nx/2.0-ix+0.5)*xtow;                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("HTOW");                    
                                        place.SetMother("HMOD");                    
                                        /// Add daughter volume HTOW to mother HMOD                    
                                        place.TranslateX(xx);                    
                                        /// Translate x = xx                    
                                        place.TranslateY(yy);                    
                                        /// Translate y = yy                    
                                        place.TranslateZ(0.0);                    
                                        /// Translate z = 0.0                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        _stacker -> Position( AgBlock::Find("HTOW"), place );                    
                                  } // end placement of HTOW                 
                            }              
                      }           
                      END_OF_HMOD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HMOD     
