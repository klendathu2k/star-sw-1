                            create     .SetParameters(shape);              
                            shape.par("dx")=wgeo.dx/2.0;              
                            shape.par("dy")=wgeo.dy/2.0;              
                            shape.par("dz")=wgeo.dzfrontsteel/2.0;              
                            /// Shape Bbox dx=wgeo.dx/2.0 dy=wgeo.dy/2.0 dz=wgeo.dzfrontsteel/2.0               
