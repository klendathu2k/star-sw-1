          void WMOD::Block( AgCreate create )     
          {         
                ///@addtogroup WMOD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("WMOD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.par("fill")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=xtot/2.0;              
                            shape.par("dy")=ytot/2.0;              
                            shape.par("dz")=wgeo.depth/2.0;              
                            /// Shape Bbox dx=xtot/2.0 dy=ytot/2.0 dz=wgeo.depth/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WMOD;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("WTOW");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create WTOW              
                            Create("WTOW");               
                      }           
                      /// Loop on iy from 1 to wgeo.ny step=1           
                      for ( iy=1; (1>0)? (iy<=wgeo.ny):(iy>=wgeo.ny); iy+=1 )           
                      {              
                            yy=(wgeo.ny/2.0-iy+0.5)*ytow;              
                            /// Loop on ix from 1 to wgeo.nx step=1              
                            for ( ix=1; (1>0)? (ix<=wgeo.nx):(ix>=wgeo.nx); ix+=1 )              
                            {                 
                                  xx=-(wgeo.nx/2.0-ix+0.5)*xtow;                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("WTOW");                    
                                        place.SetMother("WMOD");                    
                                        /// Add daughter volume WTOW to mother WMOD                    
                                        place.TranslateX(xx);                    
                                        /// Translate x = xx                    
                                        place.TranslateY(yy);                    
                                        /// Translate y = yy                    
                                        place.TranslateZ(0.0);                    
                                        /// Translate z = 0.0                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        _stacker -> Position( AgBlock::Find("WTOW"), place );                    
                                  } // end placement of WTOW                 
                            }              
                      }           
                      END_OF_WMOD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WMOD     
