          AgBlock *WSCI::mInstance = 0;     
          AgBlock *WSCI::Instance(){        
                   if ( mInstance==0 ) mInstance = new WSCI();        
                   return mInstance;        
          }     
          void WSCI::Block( AgCreate create )     
          {         
                ///@addtogroup WSCI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material WCal_Scinti a=6.670 z=3.60 dens=1.18 absl=70.8 radl=34.4            
                      { AgMaterial &mat = AgMaterial::Get("Wcal_scinti");              
                            mat.par("a")=6.670;              
                            mat.par("z")=3.60;              
                            mat.par("dens")=1.18;              
                            mat.par("absl")=70.8;              
                            mat.par("radl")=34.4;              
                            _material = mat;              
                      }           
                      /// Medium wcal_scinti           
                      ///  isvol = 1           
                      {  AgMedium &med = AgMedium::Get("Wcal_scinti");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("WSCI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.par("fill")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wgeo.dx/2.0;              
                            shape.par("dy")=wgeo.dy/2.0;              
                            shape.par("dz")=zsci/2.0;              
                            /// Shape Bbox dx=wgeo.dx/2.0 dy=wgeo.dy/2.0 dz=zsci/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WSCI;              
                            _stacker -> Build(this);              
                      }           
                      // parameter birk1 = 1. (deferred)           
                      // parameter birk2 = 0.013 (deferred)           
                      // parameter birk3 = 9.6e-6 (deferred)           
                      // deferred module()->AddHit( "WSCI", "birk", 0, 0, 100, "");           
                      _create = AgCreate("WPAP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create WPAP              
                            Create("WPAP");               
                      }           
                      _create = AgCreate("WPBP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create WPBP              
                            Create("WPBP");               
                      }           
                      zzz=-zsci/2.0;           
                      /// Loop on i from 1 to wgeo.nlayer step=1           
                      for ( i=1; (1>0)? (i<=wgeo.nlayer):(i>=wgeo.nlayer); i+=1 )           
                      {              
                            zzz=zzz+wgeo.dzpaper/2.0;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("WPAP");                 
                                  place.SetMother("WSCI");                 
                                  /// Add daughter volume WPAP to mother WSCI                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("only")=AgPosition::kOnly;                 
                                  /// Overlap: agposition::konly                 
                                  _stacker -> Position( AgBlock::Find("WPAP"), place );                 
                            } // end placement of WPAP              
                            zzz=zzz+wgeo.dzpaper+wgeo.dzscinti;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("WPAP");                 
                                  place.SetMother("WSCI");                 
                                  /// Add daughter volume WPAP to mother WSCI                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(zzz);                 
                                  /// Translate z = zzz                 
                                  place.par("only")=AgPosition::kOnly;                 
                                  /// Overlap: agposition::konly                 
                                  _stacker -> Position( AgBlock::Find("WPAP"), place );                 
                            } // end placement of WPAP              
                            zzz=zzz+wgeo.dzpaper/2.0;              
                            if ( i<wgeo.nlayer )              
                            {                 
                                  zzz=zzz+wgeo.dzlead/2.0;                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("WPBP");                    
                                        place.SetMother("WSCI");                    
                                        /// Add daughter volume WPBP to mother WSCI                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(zzz);                    
                                        /// Translate z = zzz                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        _stacker -> Position( AgBlock::Find("WPBP"), place );                    
                                  } // end placement of WPBP                 
                                  zzz=zzz+wgeo.dzlead/2.0;                 
                            }              
                      }           
                      END_OF_WSCI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WSCI     
