      ! ---------------------------------------------------------------------------------- LADR
      BLOCK LADR   first ladder prototype
      MATERIAL Air
      MEDIUM MedAir epsil=0.001
      ATTRIBUTE LADR seen=1 colo=920
      SHAPE box dx=1.245 dy=ladderhalfthickness,
            dz=15.325
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness _
            - LADR_cablethickness - gluathickness - 0.0025)
      DO sens = 1, SENP_sensor
      zsensor = SENP_zpos(sens)
      CREATE PXSI
      CALL AgsReset 
      CALL agml_position_begin('PXSI') 
      %mother = 'LADR' 
      %title = 'PXSI' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0848 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsensor) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      yp = yp - 0.005
      CREATE GLUA
      CALL AgsReset 
      CALL agml_position_begin('GLUA') 
      %mother = 'LADR' 
      %title = 'GLUA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0485 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 4.8855 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness _
            - LADR_cablethickness/2.0)
      CREATE ALCA
      CALL AgsReset 
      CALL agml_position_begin('ALCA') 
      %title = 'ALCA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.01475 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(cableZOffset) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness/2)
      CREATE GLUB
      CALL AgsReset 
      CALL agml_position_begin('GLUB') 
      %title = 'GLUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.065 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness/2.0)
      CREATE CFBK
      CALL AgsReset 
      CALL agml_position_begin('CFBK') 
      %title = 'CFBK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(backingZOffset) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness/2.0)
      CREATE GLUC
      CALL AgsReset 
      CALL agml_position_begin('GLUC') 
      %title = 'GLUC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.4995 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.065 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE DRIV
      CALL AgsReset 
      CALL agml_position_begin('DRIV') 
      %title = 'DRIV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.01475 
      CALL agml_translate_x( %x ) 
      ag_y = 0.02725 
      CALL agml_translate_y( %y ) 
      ag_z = -10.589 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUA
      BLOCK GLUA   Glue for CMOS sensors
      ATTRIBUTE GLUA seen=1 colo=800
      MATERIAL matAdhesive
      SHAPE box dx=1.1715 dy=gluathickness/2.0,
            dz=10.1295
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ALCA
      BLOCK ALCA
      ATTRIBUTE ALCA seen=1 colo=616
      IF ( LADR_type==0 ) THEN
      MATERIAL matAlCable
      ELSE
      MATERIAL matCuCable
      ENDIF
      SHAPE box dx=1.23025 dy=LADR_cablethickness/2.0,
            dz=cableLength
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUB
      BLOCK GLUB   Glue for Al/Cu Cable
      ATTRIBUTE GLUB seen=1 colo=629
      MATERIAL matAdhesive
      SHAPE box dx=1.245 dy=glubthickness/2.0,
            dz=14.95
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CFBK
      BLOCK CFBK   Carbon Fiber backing on ladder
      ATTRIBUTE CFBK seen=1 colo=1
      MATERIAL CBMix
      SHAPE box dx=1.245 dy=backingThickness/2.0,
            dz=backingLength
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUC
      BLOCK GLUC
      ATTRIBUTE GLUC seen=1 colo=629
      MATERIAL matAdhesive
      SHAPE box dx=0.7205 dy=glucthickness/2.0,
            dz=14.95
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- DRIV
      BLOCK DRIV
      ATTRIBUTE DRIV seen=1 colo=629
      MATERIAL medFR4
      SHAPE box dx=1.23025 dy=0.025 dz=4.55
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXSI
      BLOCK PXSI   mother of the sensor assembly
      MATERIAL Silicon
      ATTRIBUTE PXSI seen=1 colo=594
      SHAPE box dx=1.137 dy=0.0025 dz=1.0125
      CREATE PLAC
      CALL AgsReset 
      CALL agml_position_begin('PLAC') 
      %mother = 'PXSI' 
      %title = 'PLAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.1533 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0013 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PLAC
      BLOCK PLAC   active silicon top sector
      ATTRIBUTE PLAC seen=1 colo=4
      MATERIAL Silicon
      MATERIAL SSensitive isvol=1
      MEDIUM MedSiSensitive epsil=0.001
      SHAPE box dx=0.9605 dy=0.0008 dz=0.9936
      HITS PLAC z:.00001:S y:.00001:S x:.00001:S ptot:16:(0,100) cx:10: cy:10: cz:10:,
            sleng:16:(0,500) tof:16: step:.0001: eloss:16:
      ENDBLOCK
      <W> '===>> 	[End AgML Module PixlGeo5]	 <<==='; (A32,/,/);
      END! Module PixlGeo5
