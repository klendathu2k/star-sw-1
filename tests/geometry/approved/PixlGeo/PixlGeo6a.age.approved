      ! ---------------------------------------------------------------------------------- PCAD
      BLOCK PCAD   Long CAble section D
      ATTRIBUTE None seen=1 colo=629
      MATERIAL copper
      SHAPE tubs rmin=0 rmax=RadCable phi1=0 phi2=360,
            dz=LengthCaL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- LADR
      BLOCK LADR   first ladder prototype
      MATERIAL Air
      MEDIUM MedAir epsil=0.001
      ATTRIBUTE LADR seen=1 colo=920
      SHAPE box dx=1.245 dy=ladderhalfthickness,
            dz=15.325
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness _
            - LADR_cablethickness - gluathickness - 0.0025)
      DO sens = 1, SENP_sensor
      zsensor = SENP_zpos(sens)
      CREATE PXSI
      CALL AgsReset 
      CALL agml_position_begin('PXSI') 
      %mother = 'LADR' 
      %title = 'PXSI' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0848 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsensor) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      yp = yp - 0.005
      CREATE GLUA
      CALL AgsReset 
      CALL agml_position_begin('GLUA') 
      %mother = 'LADR' 
      %title = 'GLUA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0485 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 4.8855 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness _
            - LADR_cablethickness/2.0)
      CREATE ALCA
      CALL AgsReset 
      CALL agml_position_begin('ALCA') 
      %title = 'ALCA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.01475 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(cableZOffset) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness - glubthickness/2)
      CREATE GLUB
      CALL AgsReset 
      CALL agml_position_begin('GLUB') 
      %title = 'GLUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.065 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness - backingThickness/2.0)
      CREATE CFBK
      CALL AgsReset 
      CALL agml_position_begin('CFBK') 
      %title = 'CFBK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = real(backingZOffset) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yp = - (ladderhalfthickness - glucthickness/2.0)
      CREATE GLUC
      CALL AgsReset 
      CALL agml_position_begin('GLUC') 
      %title = 'GLUC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.4995 
      CALL agml_translate_x( %x ) 
      ag_y = real(yp) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.065 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE DRIV
      CALL AgsReset 
      CALL agml_position_begin('DRIV') 
      %title = 'DRIV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.01475 
      CALL agml_translate_x( %x ) 
      ag_y = 0.02725 
      CALL agml_translate_y( %y ) 
      ag_z = -10.589 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
