      ! ---------------------------------------------------------------------------------- PXRB
      BLOCK PXRB   sector right side
      ATTRIBUTE PXRB seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadThk dy=HalfLadRight,
            dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXLB
      BLOCK PXLB   sector left side
      ATTRIBUTE PXLB seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadThk dy=HalfLadLeft dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXIB
      BLOCK PXIB   sector bottom side
      ATTRIBUTE PXIB seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadBottom dy=HalfLadThk,
            dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXTR
      BLOCK PXTR   part of sector right
      ATTRIBUTE PXTR seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadTopR dy=HalfLadThk dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXTM
      BLOCK PXTM   part of sector middle
      ATTRIBUTE PXTM seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadTopM dy=HalfLadThk dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXTL
      BLOCK PXTL   part of sector right
      ATTRIBUTE PXTL seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadTopL dy=HalfLadThk dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXTJ
      BLOCK PXTJ   part joining 2 parts of top sector
      ATTRIBUTE PXTJ seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE box dx=HalfLadMid dy=HalfLadThk dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCA
      BLOCK PXCA   arc bottom right
      ATTRIBUTE PXCA seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTMin rmax=ArcTMax phi1=267.396,
            phi2=360 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCC
      BLOCK PXCC   arc top right
      ATTRIBUTE PXCC seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTMin rmax=ArcTMax phi1=0,
            phi2=79.963 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCD
      BLOCK PXCD   arc top 23
      ATTRIBUTE PXCD seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTMin rmax=ArcTMax phi1=79.963,
            phi2=191.54 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCE
      BLOCK PXCE   arc bottom 23
      ATTRIBUTE PXCE seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTBMin rmax=ArcTBMax phi1=271.963,
            phi2=371.54 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCF
      BLOCK PXCF   arc top 12
      ATTRIBUTE PXCF seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTMin rmax=ArcTMax phi1=91.963,
            phi2=203.54 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCG
      BLOCK PXCG   arc bottom 12
      ATTRIBUTE PXCG seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTBMin rmax=ArcTBMax phi1=283.963,
            phi2=383.54 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCH
      BLOCK PXCH   arc top left
      ATTRIBUTE PXCH seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcTMin rmax=ArcTMax phi1=103.963,
            phi2=216 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PXCB
      BLOCK PXCB   arc bottom left
      ATTRIBUTE PXCB seen=1 colo=4
      MATERIAL CFRPMix
      SHAPE tubs rmin=ArcBMin rmax=ArcBMax phi1=216,
            phi2=267.396 dz=HalfLadZLen
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- LADR
      BLOCK LADR   first ladder prototype
      MATERIAL Air
      ATTRIBUTE LADR seen=0 colo=4
      ladBoxX = HalfPixAC + .1
      ladBoxY = HalfPixThk + HalfPixThkGA + HalfPixThkAC + HalfPixThkGB + HalfPixThkCB _
            + HalfPixThkGC + .01
      ladBoxZ = HalfPixZAC + .1
      SHAPE box dx=ladBoxX dy=ladBoxY dz=ladBoxZ
      CREATE PLAC
      CALL AgsReset 
      CALL agml_position_begin('PLAC') 
      %title = 'PLAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -0.2315 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0415 
      CALL agml_translate_y( %y ) 
      ag_z = 5.015 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE SIFL
      CALL AgsReset 
      CALL agml_position_begin('SIFL') 
      %title = 'SIFL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -1.2065 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0415 
      CALL agml_translate_y( %y ) 
      ag_z = 5.015 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE SIFR
      CALL AgsReset 
      CALL agml_position_begin('SIFR') 
      %title = 'SIFR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.8975 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0415 
      CALL agml_translate_y( %y ) 
      ag_z = 5.015 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GLUA
      CALL AgsReset 
      CALL agml_position_begin('GLUA') 
      %title = 'GLUA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -0.0775 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0365 
      CALL agml_translate_y( %y ) 
      ag_z = 5.015 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE ALCA
      CALL AgsReset 
      CALL agml_position_begin('ALCA') 
      %title = 'ALCA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0255 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GLUB
      CALL AgsReset 
      CALL agml_position_begin('GLUB') 
      %title = 'GLUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -0.244 
      CALL agml_translate_x( %x ) 
      ag_y = -0.0145 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE CFBK
      CALL AgsReset 
      CALL agml_position_begin('CFBK') 
      %title = 'CFBK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -0.244 
      CALL agml_translate_x( %x ) 
      ag_y = 0.008 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GLUC
      CALL AgsReset 
      CALL agml_position_begin('GLUC') 
      %title = 'GLUC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -0.5015 
      CALL agml_translate_x( %x ) 
      ag_y = 0.033 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SIFL
      BLOCK SIFL   passive silicon layer
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE SIFL seen=1 colo=2
      SHAPE box dx=HalfPixPRL dy=HalfPixThkPL,
            dz=HalfPixPZL
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SIFR
      BLOCK SIFR   passive silicon layer
      MATERIAL Silicon
      MATERIAL PassiveSilicon isvol=0
      ATTRIBUTE SIFR seen=1 colo=2
      SHAPE box dx=HalfPixPRR dy=HalfPixThkPR,
            dz=HalfPixPZR
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ALCA
      BLOCK ALCA   aluminium cable
      MATERIAL AlCaMix
      ATTRIBUTE ALCA seen=1 colo=3
      SHAPE box dx=HalfPixAC dy=HalfPixThkAC dz=HalfPixZAC
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUA
      BLOCK GLUA   glue Layer A
      MATERIAL GluMix
      ATTRIBUTE GLUA seen=1 colo=5
      SHAPE box dx=HalfPixGA dy=HalfPixThkGA dz=HalfPixZGA
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUB
      BLOCK GLUB   glue Layer B
      MATERIAL GluMix
      ATTRIBUTE GLUB seen=1 colo=5
      SHAPE box dx=HalfPixGB dy=HalfPixThkGB dz=HalfPixZGB
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CFBK
      BLOCK CFBK   Carbon Fiber Backing
      MATERIAL CBMix
      ATTRIBUTE CFBK seen=1 colo=3
      SHAPE box dx=HalfPixCB dy=HalfPixThkCB dz=HalfPixZCB
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GLUC
      BLOCK GLUC   glue Layer C
      MATERIAL GluMix
      ATTRIBUTE GLUC seen=1 colo=5
      SHAPE box dx=HalfPixGC dy=HalfPixThkGC dz=HalfPixZGC
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PLAC
      BLOCK PLAC   active silicon top sector
      ATTRIBUTE PLAC seen=1 colo=6
      MATERIAL Silicon
      MATERIAL SSensitive isvol=1
      SHAPE box dx=HalfPixR dy=HalfPixThk dz=HalfPixZ
      HITS PLAC z:.00001:S y:.00001: x:.00001: ptot:16:(0,100) cx:10: cy:10: cz:10:,
            sleng:16:(0,500) tof:16: step:.01: eloss:16:
      ENDBLOCK
