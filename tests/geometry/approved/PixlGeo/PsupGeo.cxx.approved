          AgBlock *PSAK::mInstance = 0;     
          AgBlock *PSAK::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSAK();        
                   return mInstance;        
          }     
          void PSAK::Block( AgCreate create )     
          {         
                ///@addtogroup PSAK_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component O	a=16	z=8	w=2*16./100.           
                      /// Component C	a=12	z=6	w=5*12./100.           
                      /// Component H	a=1	z=1	w=8*1.0/100.           
                      /// Mixture DELRIN dens=1.2           
                      {  AgMaterial &mix = AgMaterial::Get("Delrin");              
                            mix.Component("O",16,8,2*16./100.);              
                            mix.Component("C",12,6,5*12./100.);              
                            mix.Component("H",1,1,8*1.0/100.);              
                            mix.par("dens")=1.2;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("PSAK");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=3.6;              
                            shape.par("rmax")=3.8;              
                            shape.par("dz")=11.0/2;              
                            /// Shape Tube rmin=3.6 rmax=3.8 dz=11.0/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSAK;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PSAK:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSAK     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PSCC::mInstance = 0;     
          AgBlock *PSCC::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSCC();        
                   return mInstance;        
          }     
          void PSCC::Block( AgCreate create )     
          {         
                ///@addtogroup PSCC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSCC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=5;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=18.7;              
                            shape.par("rmax")=21.2;              
                            shape.par("phi1")=180-19;              
                            shape.par("phi2")=180+19;              
                            shape.par("dz")=4.0/2.0;              
                            /// Shape Tubs rmin=18.7 rmax=21.2 phi1=180-19 phi2=180+19 dz=4.0/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSCC;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PSCI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PSCI              
                            Create("PSCI");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PSCI");              
                            place.SetMother("PSCC");              
                            /// Add daughter volume PSCI to mother PSCC              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-0.1);              
                            /// Translate z = -0.1              
                            _stacker -> Position( AgBlock::Find("PSCI"), place );              
                      } // end placement of PSCI           
                      END_OF_PSCC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSCC     
          // ---------------------------------------------------------------------------------------------------     
