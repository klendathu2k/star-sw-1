          AgBlock *PSBA::mInstance = 0;     
          AgBlock *PSBA::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSBA();        
                   return mInstance;        
          }     
          void PSBA::Block( AgCreate create )     
          {         
                ///@addtogroup PSBA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSBA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Al20 a=26.8 z=13 dens=2.7*0.2 absl=37.2/0.2 radl=8.9/0.2            
                      { AgMaterial &mat = AgMaterial::Get("Al20");              
                            mat.par("a")=26.8;              
                            mat.par("z")=13;              
                            mat.par("dens")=2.7*0.2;              
                            mat.par("absl")=37.2/0.2;              
                            mat.par("radl")=8.9/0.2;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=18.5;              
                            shape.par("rmax")=21.2;              
                            shape.par("phi1")=158;              
                            shape.par("phi2")=202;              
                            shape.par("dz")=21.00;              
                            /// Shape Tubs rmin=18.5 rmax=21.2 phi1=158 phi2=202 dz=21.00               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSBA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PSBA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSBA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PHBB::mInstance = 0;     
          AgBlock *PHBB::Instance(){        
                   if ( mInstance==0 ) mInstance = new PHBB();        
                   return mInstance;        
          }     
          void PHBB::Block( AgCreate create )     
          {         
                ///@addtogroup PHBB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PHBB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=1.65;              
                            shape.par("rmax")=1.95;              
                            shape.par("dz")=2.75;              
                            /// Shape Tube rmin=1.65 rmax=1.95 dz=2.75               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PHBB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PHBB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PHBB     
