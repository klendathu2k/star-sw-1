                      }           
                      {  AgShape shape = AgShape("Trap");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=2;              
                            shape.par("thet")=0;              
                            shape.par("phi")=0;              
                            shape.par("h1")=4.085;              
                            shape.par("bl1")=1.0975;              
                            shape.par("tl1")=1.5;              
                            shape.par("alp1")=-17.0941;              
                            shape.par("h2")=4.085;              
                            shape.par("bl2")=1.0975;              
                            shape.par("tl2")=1.5;              
                            shape.par("alp2")=-17.0941;              
                            /// Shape Trap dz=2 thet=0 phi=0 h1=4.085 bl1=1.0975 tl1=1.5 alp1=-17.0941 h2=4.085 bl2=1.0975 tl2=1.5 alp2=-17.0941               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSMD;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PSMI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PSMI              
                            Create("PSMI");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PSMI");              
                            place.SetMother("PSMD");              
                            /// Add daughter volume PSMI to mother PSMD              
                            place.TranslateX(-0.07333);              
                            /// Translate x = -0.07333              
                            place.TranslateY(-0.1);              
                            /// Translate y = -0.1              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PSMI"), place );              
                      } // end placement of PSMI           
                      END_OF_PSMD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSMD     
          // ---------------------------------------------------------------------------------------------------     
