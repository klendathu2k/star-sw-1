          AgBlock *PSHL::mInstance = 0;     
          AgBlock *PSHL::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSHL();        
                   return mInstance;        
          }     
          void PSHL::Block( AgCreate create )     
          {         
                ///@addtogroup PSHL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSHL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=9.0/2.0;              
                            shape.par("dy")=19.75/2.0;              
                            shape.par("dz")=1.3/2.0;              
                            /// Shape Bbox dx=9.0/2.0 dy=19.75/2.0 dz=1.3/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSHL;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PHHA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PHHA              
                            Create("PHHA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PHHA");              
                            place.SetMother("PSHL");              
                            /// Add daughter volume PHHA to mother PSHL              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY((19.75-4.86)/2.0);              
                            /// Translate y = (19.75-4.86)/2.0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PHHA"), place );              
                      } // end placement of PHHA           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PHHA");              
                            place.SetMother("PSHL");              
                            /// Add daughter volume PHHA to mother PSHL              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-(19.75-4.86)/2.0);              
                            /// Translate y = -(19.75-4.86)/2.0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PHHA"), place );              
                      } // end placement of PHHA           
                      _create = AgCreate("PHHB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PHHB              
                            Create("PHHB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PHHB");              
                            place.SetMother("PSHL");              
                            /// Add daughter volume PHHB to mother PSHL              
                            place.TranslateX(-(1.8-4.5)/2);              
                            /// Translate x = -(1.8-4.5)/2              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PHHB"), place );              
                      } // end placement of PHHB           
                      _create = AgCreate("PHHC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PHHC              
                            Create("PHHC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PHHC");              
                            place.SetMother("PSHL");              
                            /// Add daughter volume PHHC to mother PSHL              
                            place.TranslateX(-7.8);              
                            /// Translate x = -7.8              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("PHHC"), place );              
                      } // end placement of PHHC           
                      END_OF_PSHL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSHL     
          // ---------------------------------------------------------------------------------------------------     
