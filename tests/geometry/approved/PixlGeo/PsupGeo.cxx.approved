          AgBlock *PSHA::mInstance = 0;     
          AgBlock *PSHA::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSHA();        
                   return mInstance;        
          }     
          void PSHA::Block( AgCreate create )     
          {         
                ///@addtogroup PSHA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSHA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Al40 a=26.8 z=13 dens=2.7*0.4 absl=37.2/0.4 radl=8.9/0.4            
                      { AgMaterial &mat = AgMaterial::Get("Al40");              
                            mat.par("a")=26.8;              
                            mat.par("z")=13;              
                            mat.par("dens")=2.7*0.4;              
                            mat.par("absl")=37.2/0.4;              
                            mat.par("radl")=8.9/0.4;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Trap");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=0.725;              
                            shape.par("thet")=0;              
                            shape.par("phi")=0;              
                            shape.par("h1")=4.05;              
                            shape.par("bl1")=1.25;              
                            shape.par("tl1")=1.25;              
                            shape.par("alp1")=-13.8697;              
                            shape.par("h2")=4.05;              
                            shape.par("bl2")=1.25;              
                            shape.par("tl2")=1.25;              
                            shape.par("alp2")=-13.8697;              
                            /// Shape Trap dz=0.725 thet=0 phi=0 h1=4.05 bl1=1.25 tl1=1.25 alp1=-13.8697 h2=4.05 bl2=1.25 tl2=1.25 alp2=-13.8697               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSHA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PSHA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSHA     
