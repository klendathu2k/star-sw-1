          AgBlock *PSHS::mInstance = 0;     
          AgBlock *PSHS::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSHS();        
                   return mInstance;        
          }     
          void PSHS::Block( AgCreate create )     
          {         
                ///@addtogroup PSHS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSHS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=3.3/2;              
                            shape.par("dz")=3.786/2;              
                            /// Shape Tube rmin=0 rmax=3.3/2 dz=3.786/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSHS;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PSHT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PSHT              
                            Create("PSHT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PSHT");              
                            place.SetMother("PSHS");              
                            /// Add daughter volume PSHT to mother PSHS              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-0.1);              
                            /// Translate z = -0.1              
                            _stacker -> Position( AgBlock::Find("PSHT"), place );              
                      } // end placement of PSHT           
                      END_OF_PSHS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSHS     
          // ---------------------------------------------------------------------------------------------------     
