          void PSIC::Block( AgCreate create )     
          {         
                ///@addtogroup PSIC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PSIC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=dextinrad;              
                            shape.par("rmax")=dextinrad+dextthk;              
                            shape.par("phi1")=180-65.5;              
                            shape.par("phi2")=180+65.5;              
                            shape.par("dz")=dextlen/2;              
                            /// Shape Tubs rmin=dextinrad rmax=dextinrad+dextthk phi1=180-65.5 phi2=180+65.5 dz=dextlen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSIC;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PSIC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSIC     
