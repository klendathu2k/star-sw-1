          AgBlock *PSAR::mInstance = 0;     
          AgBlock *PSAR::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSAR();        
                   return mInstance;        
          }     
          void PSAR::Block( AgCreate create )     
          {         
                ///@addtogroup PSAR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PSAR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.7/2;              
                            shape.par("dy")=13.6/2.;              
                            shape.par("dz")=16.5/2;              
                            /// Shape Bbox dx=0.7/2 dy=13.6/2. dz=16.5/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSAR;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PSAH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PSAH              
                            Create("PSAH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PSAH");              
                            place.SetMother("PSAR");              
                            /// Add daughter volume PSAH to mother PSAR              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(8.25/2.);              
                            /// Translate z = 8.25/2.              
                            _stacker -> Position( AgBlock::Find("PSAH"), place );              
                      } // end placement of PSAH           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PSAH");              
                            place.SetMother("PSAR");              
                            /// Add daughter volume PSAH to mother PSAR              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-8.25/2.);              
                            /// Translate z = -8.25/2.              
                            _stacker -> Position( AgBlock::Find("PSAH"), place );              
                      } // end placement of PSAH           
                      END_OF_PSAR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSAR     
          // ---------------------------------------------------------------------------------------------------     
