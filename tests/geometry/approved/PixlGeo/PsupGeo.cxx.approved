             _create = AgCreate("PSUP");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PSUP           
                   Create("PSUP");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PSUP");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PSUP to mother IDSM           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(0);           
                   /// Translate z = 0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PSUP"), place );           
             } // end placement of PSUP        
             {           
                   AgPosition  place;           
                   place.SetBlock("PSUP");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PSUP to mother IDSM           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(0);           
                   /// Translate z = 0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   place.AlphaZ(180);           
                   /// Rotate: AlphaZ = 180           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("PSUP"), place );           
             } // end placement of PSUP        
