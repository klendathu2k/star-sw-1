                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SIFR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SIFR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SIFR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *ALCA::mInstance = 0;     
          AgBlock *ALCA::Instance(){        
                   if ( mInstance==0 ) mInstance = new ALCA();        
                   return mInstance;        
          }     
          void ALCA::Block( AgCreate create )     
          {         
                ///@addtogroup ALCA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material AlCaMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Alcamix");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("ALCA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=halfpixac;              
                            shape.par("dy")=halfpixthkac;              
                            shape.par("dz")=halfpixzac;              
                            /// Shape Bbox dx=halfpixac dy=halfpixthkac dz=halfpixzac               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_ALCA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_ALCA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block ALCA     
