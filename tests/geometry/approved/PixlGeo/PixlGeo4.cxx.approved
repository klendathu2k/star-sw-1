          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PXMO::mInstance = 0;     
          AgBlock *PXMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new PXMO();        
                   return mInstance;        
          }     
          void PXMO::Block( AgCreate create )     
          {         
                ///@addtogroup PXMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PXMO");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=minrvol;              
                            shape.par("rmax")=maxrvol;              
                            shape.par("dz")=maxzvol;              
                            /// Shape Tube rmin=minrvol rmax=maxrvol dz=maxzvol               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PXMO;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on sector from 1 to pixl.sector step=1           
                      for ( sector=1; (1>0)? (sector<=pixl.sector):(sector>=pixl.sector); sector+=1 )           
                      {              
                            angle=pixl.phinum[int(sector)-1];              
                            anglepos=angle*(pi/180.0);              
                            xpos=.00001*sin(anglepos)+(paro.dx*paro.mult)*paro.sec[int(sector)-1];              
                            ypos=.00001*cos(anglepos)+(paro.dy*paro.mult)*paro.sec[int(sector)-1];              
                            zpos=globoffz+(paro.dz*paro.mult)*paro.sec[int(sector)-1];              
                            _create = AgCreate("PXLA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create PXLA                 
                                  Create("PXLA");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("PXLA");                 
                                  place.SetMother("PXMO");                 
                                  /// Add daughter volume PXLA to mother PXMO                 
                                  place.TranslateX(xpos);                 
                                  /// Translate x = xpos                 
                                  place.TranslateY(ypos);                 
                                  /// Translate y = ypos                 
                                  place.TranslateZ(zpos);                 
                                  /// Translate z = zpos                 
                                  place.par("only")=AgPosition::kMany;                 
                                  /// Overlap: agposition::kmany                 
                                  place.AlphaZ(-1*angle-(para.dg*para.mult*para.sec[int(sector)-1]));                 
                                  /// Rotate: AlphaZ = -1*angle-(para.dg*para.mult*para.sec[int(sector)-1])                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaX(-1*(para.da*para.mult)*para.sec[int(sector)-1]);                 
                                  /// Rotate: AlphaX = -1*(para.da*para.mult)*para.sec[int(sector)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaY(-1*(para.db*para.mult)*para.sec[int(sector)-1]);                 
                                  /// Rotate: AlphaY = -1*(para.db*para.mult)*para.sec[int(sector)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  if ( debug==1 )                 
                                  {                    
                                        // - Info -                     
                                        Info( GetName(), Form("angle(deg)=%6.3f",angle)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("sector=%6.2f",sector)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("xpos=%6.2f",xpos*1000000)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("ypos=%6.2f",ypos*1000000)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("zpos=%6.2f",zpos)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaZ=%6.2f",-1*(para.dg*para.mult)*para.sec[int(sector)-1])  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaX=%6.2f",-1*(para.da*para.mult)*para.sec[int(sector)-1])  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaY=%6.2f",-1*(para.db*para.mult)*para.sec[int(sector)-1])  );                    
                                  }                 
                                  _stacker -> Position( AgBlock::Find("PXLA"), place );                 
                            } // end placement of PXLA              
                      }           
                      END_OF_PXMO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PXMO     
