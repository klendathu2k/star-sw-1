          AgBlock *LADR::mInstance = 0;     
          AgBlock *LADR::Instance(){        
                   if ( mInstance==0 ) mInstance = new LADR();        
                   return mInstance;        
          }     
          void LADR::Block( AgCreate create )     
          {         
                ///@addtogroup LADR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("LADR");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      ladboxx=halfpixac+.1;           
                      ladboxy=halfpixthk+halfpixthkga+halfpixthkac+halfpixthkgb+halfpixthkcb+halfpixthkgc+.01;           
                      ladboxz=halfpixzac+.1;           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=ladboxx;              
                            shape.par("dy")=ladboxy;              
                            shape.par("dz")=ladboxz;              
                            /// Shape Bbox dx=ladboxx dy=ladboxy dz=ladboxz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_LADR;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PLAC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PLAC              
                            Create("PLAC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PLAC");              
                            place.SetMother("LADR");              
                            /// Add daughter volume PLAC to mother LADR              
                            place.TranslateX(-0.2315);              
                            /// Translate x = -0.2315              
                            place.TranslateY(-0.0415);              
                            /// Translate y = -0.0415              
                            place.TranslateZ(5.015);              
                            /// Translate z = 5.015              
                            _stacker -> Position( AgBlock::Find("PLAC"), place );              
                      } // end placement of PLAC           
                      _create = AgCreate("SIFL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SIFL              
                            Create("SIFL");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SIFL");              
                            place.SetMother("LADR");              
                            /// Add daughter volume SIFL to mother LADR              
                            place.TranslateX(-1.2065);              
                            /// Translate x = -1.2065              
                            place.TranslateY(-0.0415);              
                            /// Translate y = -0.0415              
                            place.TranslateZ(5.015);              
                            /// Translate z = 5.015              
                            _stacker -> Position( AgBlock::Find("SIFL"), place );              
                      } // end placement of SIFL           
                      _create = AgCreate("SIFR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SIFR              
                            Create("SIFR");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SIFR");              
                            place.SetMother("LADR");              
                            /// Add daughter volume SIFR to mother LADR              
                            place.TranslateX(0.8975);              
                            /// Translate x = 0.8975              
                            place.TranslateY(-0.0415);              
                            /// Translate y = -0.0415              
                            place.TranslateZ(5.015);              
                            /// Translate z = 5.015              
                            _stacker -> Position( AgBlock::Find("SIFR"), place );              
                      } // end placement of SIFR           
                      _create = AgCreate("GLUA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUA              
                            Create("GLUA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUA");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUA to mother LADR              
                            place.TranslateX(-0.0775);              
                            /// Translate x = -0.0775              
                            place.TranslateY(-0.0365);              
                            /// Translate y = -0.0365              
                            place.TranslateZ(5.015);              
                            /// Translate z = 5.015              
                            _stacker -> Position( AgBlock::Find("GLUA"), place );              
                      } // end placement of GLUA           
                      _create = AgCreate("ALCA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create ALCA              
                            Create("ALCA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("ALCA");              
                            place.SetMother("LADR");              
                            /// Add daughter volume ALCA to mother LADR              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-0.0255);              
                            /// Translate y = -0.0255              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("ALCA"), place );              
                      } // end placement of ALCA           
                      _create = AgCreate("GLUB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUB              
                            Create("GLUB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUB");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUB to mother LADR              
                            place.TranslateX(-0.244);              
                            /// Translate x = -0.244              
                            place.TranslateY(-0.0145);              
                            /// Translate y = -0.0145              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("GLUB"), place );              
                      } // end placement of GLUB           
                      _create = AgCreate("CFBK");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create CFBK              
                            Create("CFBK");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("CFBK");              
                            place.SetMother("LADR");              
                            /// Add daughter volume CFBK to mother LADR              
                            place.TranslateX(-0.244);              
                            /// Translate x = -0.244              
                            place.TranslateY(0.008);              
                            /// Translate y = 0.008              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("CFBK"), place );              
                      } // end placement of CFBK           
                      _create = AgCreate("GLUC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUC              
                            Create("GLUC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUC");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUC to mother LADR              
                            place.TranslateX(-0.5015);              
                            /// Translate x = -0.5015              
                            place.TranslateY(0.033);              
                            /// Translate y = 0.033              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("GLUC"), place );              
                      } // end placement of GLUC           
                      END_OF_LADR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block LADR     
          // ---------------------------------------------------------------------------------------------------     
