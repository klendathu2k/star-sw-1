          AgBlock *PLAC::mInstance = 0;     
          AgBlock *PLAC::Instance(){        
                   if ( mInstance==0 ) mInstance = new PLAC();        
                   return mInstance;        
          }     
          void PLAC::Block( AgCreate create )     
          {         
                ///@addtogroup PLAC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PLAC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Silicon            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Silicon");              
                            _material = mat;              
                      }           
                      /// Material SSensitive isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Ssensitive");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=halfpixr;              
                            shape.par("dy")=halfpixthk;              
                            shape.par("dz")=halfpixz;              
                            /// Shape Bbox dx=halfpixr dy=halfpixthk dz=halfpixz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PLAC;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "PLAC", "z", .00001, 0, 0, "S");           
                      // deferred module()->AddHit( "PLAC", "y", .00001, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "x", .00001, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "ptot", 16, 0, 100, "");           
                      // deferred module()->AddHit( "PLAC", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "sleng", 16, 0, 500, "");           
                      // deferred module()->AddHit( "PLAC", "tof", 16, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "step", .01, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "eloss", 16, 0, 0, "");           
                      END_OF_PLAC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PLAC     
    // ----------------------------------------------------------------------- geoctr
       void PixlGeo4::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PixlGeo4_revision        
             ///@{           
                   /// Author: JB           
             ///@}        
             ///@addtogroup PixlGeo4_revision        
             ///@{           
                   /// Created: Dec.20 2011           
             ///@}        
             AddBlock("PXMO", PXMO::Instance());        
             AddBlock("PXLA", PXLA::Instance());        
             AddBlock("PXRB", PXRB::Instance());        
             AddBlock("PXLB", PXLB::Instance());        
             AddBlock("PXIB", PXIB::Instance());        
             AddBlock("PXTR", PXTR::Instance());        
             AddBlock("PXTM", PXTM::Instance());        
             AddBlock("PXTL", PXTL::Instance());        
             AddBlock("PXTJ", PXTJ::Instance());        
             AddBlock("PXCA", PXCA::Instance());        
             AddBlock("PXCB", PXCB::Instance());        
             AddBlock("PXCC", PXCC::Instance());        
             AddBlock("PXCD", PXCD::Instance());        
             AddBlock("PXCE", PXCE::Instance());        
             AddBlock("PXCF", PXCF::Instance());        
             AddBlock("PXCG", PXCG::Instance());        
             AddBlock("PXCH", PXCH::Instance());        
             AddBlock("PLAC", PLAC::Instance());        
             AddBlock("SIFR", SIFR::Instance());        
             AddBlock("SIFL", SIFL::Instance());        
             AddBlock("GLUA", GLUA::Instance());        
             AddBlock("ALCA", ALCA::Instance());        
             AddBlock("GLUB", GLUB::Instance());        
             AddBlock("CFBK", CFBK::Instance());        
             AddBlock("GLUC", GLUC::Instance());        
             AddBlock("LADR", LADR::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixl
++pixl._index;
pixl.version = 1.0;
// pixl_docum.version = "None";
pixl.sector = 10;
// pixl_docum.sector = " number of sectors";
{
pixl_info::phinum::Type temp = {
pixl_info::phinum::BaseType(0),
pixl_info::phinum::BaseType(324),
pixl_info::phinum::BaseType(288),
pixl_info::phinum::BaseType(252),
pixl_info::phinum::BaseType(216),
pixl_info::phinum::BaseType(180),
pixl_info::phinum::BaseType(144),
pixl_info::phinum::BaseType(108),
pixl_info::phinum::BaseType(72),
pixl_info::phinum::BaseType(36)
}
;
memcpy(&pixl.phinum, &temp, sizeof(temp));;
}
// pixl_docum.phinum = "phi values for each sector, starting from 1, 2 .. 10";
PIXL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixl
++pixl._index;
pixl.version = 2.0;
// pixl_docum.version = "None";
pixl.sector = 3;
// pixl_docum.sector = " number of sectors";
{
pixl_info::phinum::Type temp = {
pixl_info::phinum::BaseType(0),
pixl_info::phinum::BaseType(324),
pixl_info::phinum::BaseType(36)
}
;
memcpy(&pixl.phinum, &temp, sizeof(temp));;
}
// pixl_docum.phinum = "phi values for each sector, starting from 1, 2 .. 10";
PIXL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixl
++pixl._index;
pixl.version = 3.0;
// pixl_docum.version = "None";
pixl.sector = 3;
// pixl_docum.sector = " number of sectors";
{
pixl_info::phinum::Type temp = {
pixl_info::phinum::BaseType(0),
pixl_info::phinum::BaseType(216),
pixl_info::phinum::BaseType(144)
}
;
memcpy(&pixl.phinum, &temp, sizeof(temp));;
}
// pixl_docum.phinum = "phi values for each sector, starting from 1, 2 .. 10";
PIXL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixl
++pixl._index;
pixl.version = 4.0;
// pixl_docum.version = "None";
pixl.sector = 3;
// pixl_docum.sector = " number of sectors";
{
pixl_info::phinum::Type temp = {
pixl_info::phinum::BaseType(0),
pixl_info::phinum::BaseType(252),
pixl_info::phinum::BaseType(108)
}
;
memcpy(&pixl.phinum, &temp, sizeof(temp));;
}
// pixl_docum.phinum = "phi values for each sector, starting from 1, 2 .. 10";
PIXL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixl
++pixl._index;
pixl.version = 5.0;
// pixl_docum.version = "None";
pixl.sector = 3;
// pixl_docum.sector = " number of sectors";
{
pixl_info::phinum::Type temp = {
pixl_info::phinum::BaseType(0),
pixl_info::phinum::BaseType(252),
pixl_info::phinum::BaseType(144)
}
;
memcpy(&pixl.phinum, &temp, sizeof(temp));;
}
// pixl_docum.phinum = "phi values for each sector, starting from 1, 2 .. 10";
PIXL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill paro
++paro._index;
paro.version = 0;
// paro_docum.version = "None";
paro.dx = 0;
// paro_docum.dx = " no shift ";
paro.dy = 0;
// paro_docum.dy = " no shift ";
paro.dz = 0;
// paro_docum.dz = " no shift ";
paro.mult = 0;
// paro_docum.mult = " no shift ";
{
paro_info::sec::Type temp = {
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0)
}
;
memcpy(&paro.sec, &temp, sizeof(temp));;
}
// paro_docum.sec = "1..10";
PARO.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill paro
++paro._index;
paro.version = 1;
// paro_docum.version = "None";
paro.dx = 0;
// paro_docum.dx = " shift ";
paro.dy = 0;
// paro_docum.dy = " no shift ";
paro.dz = 1;
// paro_docum.dz = " no shift ";
paro.mult = 5;
// paro_docum.mult = " max is 5 cm";
{
paro_info::sec::Type temp = {
paro_info::sec::BaseType(1),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0),
paro_info::sec::BaseType(0)
}
;
memcpy(&paro.sec, &temp, sizeof(temp));;
}
// paro_docum.sec = "1..10";
PARO.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill para
++para._index;
para.version = 0;
// para_docum.version = "None";
para.da = 0;
// para_docum.da = " no rotation ";
para.db = 0;
// para_docum.db = " no rotation ";
para.dg = 0;
// para_docum.dg = " no rotation ";
para.mult = 0;
// para_docum.mult = "  no rotation ";
{
para_info::sec::Type temp = {
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0)
}
;
memcpy(&para.sec, &temp, sizeof(temp));;
}
// para_docum.sec = "1..10";
PARA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill para
++para._index;
para.version = 1;
// para_docum.version = "None";
para.da = 0;
// para_docum.da = " no rot. ";
para.db = 0;
// para_docum.db = " no rot. ";
para.dg = 5;
// para_docum.dg = " rot. ";
para.mult = 1;
// para_docum.mult = " max is 5 deg ";
{
para_info::sec::Type temp = {
para_info::sec::BaseType(1),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0),
para_info::sec::BaseType(0)
}
;
memcpy(&para.sec, &temp, sizeof(temp));;
}
// para_docum.sec = "1..10";
PARA.fill();
        
             /// Component O	a=16	z=8	w=0.164        
             /// Component C	a=12	z=6	w=0.763        
             /// Component H	a=1	z=1	w=0.073        
             /// Mixture GluMix dens=1.2        
             {  AgMaterial &mix = AgMaterial::Get("Glumix");           
                   mix.Component("O",16,8,0.164);           
                   mix.Component("C",12,6,0.763);           
                   mix.Component("H",1,1,0.073);           
                   mix.par("dens")=1.2;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Material CFRPMix a=12 z=6 dens=1.3 radl=23.9         
             { AgMaterial &mat = AgMaterial::Get("Cfrpmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=23.9;           
                   _material = mat;           
             }        
             /// Material CBMix a=12 z=6 dens=1.3 radl=68         
             { AgMaterial &mat = AgMaterial::Get("Cbmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=68;           
                   _material = mat;           
             }        
             /// Material AlCaMix a=26.98 z=13 dens=2.7 radl=23.7         
             { AgMaterial &mat = AgMaterial::Get("Alcamix");           
                   mat.par("a")=26.98;           
                   mat.par("z")=13;           
                   mat.par("dens")=2.7;           
                   mat.par("radl")=23.7;           
                   _material = mat;           
             }        
             /// USE pixl version=1.0;        
             PIXL.use( __pixl_version__ = 1.0 );
        
             /// USE paro version=0;        
             PARO.use( __paro_version__ = 0 );
        
             /// USE para version=0;        
             PARA.use( __para_version__ = 0 );
        
             debug=0;        
             _create = AgCreate("PXMO");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PXMO           
                   Create("PXMO");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PXMO");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PXMO to mother IDSM           
                   _stacker -> Position( AgBlock::Find("PXMO"), place );           
             } // end placement of PXMO        
       }; // PixlGeo4     
 }; // namespace PixlGeo4  
 