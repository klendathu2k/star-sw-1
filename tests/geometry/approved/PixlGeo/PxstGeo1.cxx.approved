          AgBlock *PSTM::mInstance = 0;     
          AgBlock *PSTM::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSTM();        
                   return mInstance;        
          }     
          void PSTM::Block( AgCreate create )     
          {         
                ///@addtogroup PSTM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-359;              
                            shape.Z(1)=60;              
                            shape.Rmin(0)=minradpstm;              
                            shape.Rmin(1)=minradpstm;              
                            shape.Rmax(0)=maxradpstm/2;              
                            shape.Rmax(1)=maxradpstm/2;              
                            /// Shape Pcon phi1=0 dphi=360 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSTM;              
                            _stacker -> Build(this);              
                      }           
                      /// USE psts version=1.0;           
                      PSTS.use( __psts_version__ = 1.0 );
           
                      _create = AgCreate("APTS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create APTS              
                            Create("APTS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("APTS");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume APTS to mother PSTM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("APTS"), place );              
                      } // end placement of APTS           
                      /// USE sfba version=1.0;           
                      SFBA.use( __sfba_version__ = 1.0 );
           
                      _create = AgCreate("LFBA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LFBA              
                            Create("LFBA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LFBA");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume LFBA to mother PSTM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-psts.dz/2.+sfbb.dz+sfba.dz/2.);              
                            /// Translate z = -psts.dz/2.+sfbb.dz+sfba.dz/2.              
                            _stacker -> Position( AgBlock::Find("LFBA"), place );              
                      } // end placement of LFBA           
                      /// USE sfbb version=1.0;           
                      SFBB.use( __sfbb_version__ = 1.0 );
           
                      _create = AgCreate("LFBB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LFBB              
                            Create("LFBB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LFBB");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume LFBB to mother PSTM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-psts.dz/2.+sfbb.dz/2.);              
                            /// Translate z = -psts.dz/2.+sfbb.dz/2.              
                            _stacker -> Position( AgBlock::Find("LFBB"), place );              
                      } // end placement of LFBB           
                      /// USE sfbk version=1.0;           
                      SFBK.use( __sfbk_version__ = 1.0 );
           
                      _create = AgCreate("LFBK");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LFBK              
                            Create("LFBK");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LFBK");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume LFBK to mother PSTM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-psts.dz/2.+sfbb.dz+sfbk.dz/2.);              
                            /// Translate z = -psts.dz/2.+sfbb.dz+sfbk.dz/2.              
                            _stacker -> Position( AgBlock::Find("LFBK"), place );              
                      } // end placement of LFBK           
                      /// USE sfba version=1.0;           
                      SFBA.use( __sfba_version__ = 1.0 );
           
                      _create = AgCreate("RFBA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create RFBA              
                            Create("RFBA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("RFBA");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume RFBA to mother PSTM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(psts.dz/2.-sfbb.dz-sfba.dz/2.);              
                            /// Translate z = psts.dz/2.-sfbb.dz-sfba.dz/2.              
                            _stacker -> Position( AgBlock::Find("RFBA"), place );              
                      } // end placement of RFBA           
                      /// USE sfbb version=1.0;           
                      SFBB.use( __sfbb_version__ = 1.0 );
           
                      _create = AgCreate("RFBB");           
                      {              
