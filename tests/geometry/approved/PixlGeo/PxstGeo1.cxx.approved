                            shape.par("dx")=.2;              
                            shape.par("dy")=(radoutermintp/2.-ringdiametermax/2.)/2.;              
                            shape.par("dz")=widthringtp/2.;              
                            /// Shape Bbox dx=.2 dy=(radoutermintp/2.-ringdiametermax/2.)/2. dz=widthringtp/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPF;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPF:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPF     
