                   if ( mInstance==0 ) mInstance = new MTPA();        
                   return mInstance;        
          }     
          void MTPA::Block( AgCreate create )     
          {         
                ///@addtogroup MTPA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("MTPA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp);              
                            shape.Z(1)=-1*(psts.dz/2.+widthinnerringtp+widthlowerringtp);              
                            shape.Rmin(0)=radinteratp/2.;              
                            shape.Rmin(1)=radinteratp/2.;              
                            shape.Rmax(0)=radoutermaxtp/2.;              
                            shape.Rmax(1)=radoutermaxtp/2.;              
                            /// Shape Pcon phi1=0 dphi=360 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPA     
