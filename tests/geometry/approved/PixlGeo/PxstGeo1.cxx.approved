                   if ( mInstance==0 ) mInstance = new MTPC();        
                   return mInstance;        
          }     
          void MTPC::Block( AgCreate create )     
          {         
                ///@addtogroup MTPC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("MTPC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Cone");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=widthringtp/2.;              
                            shape.par("rmn1")=radinnermintp/2.;              
                            shape.par("rmx1")=radinnermintp/2.+lengthinsidering;              
                            shape.par("rmn2")=radinnermintp/2.;              
                            shape.par("rmx2")=radinnermaxtp/2.-tp;              
                            /// Shape Cone dz=widthringtp/2. rmn1=radinnermintp/2. rmx1=radinnermintp/2.+lengthinsidering rmn2=radinnermintp/2. rmx2=radinnermaxtp/2.-tp               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPC;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPC     
