                            shape.par("rmax")=pitr.dmax/2.;              
                            shape.par("dz")=pitr.dz/2.;              
                            /// Shape Tube rmin=pitr.dmin/2. rmax=pitr.dmax/2. dz=pitr.dz/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PITR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PITR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PITR     
    // ----------------------------------------------------------------------- geoctr
       void PxstGeo1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PxstGeo1_revision        
             ///@{           
                   /// Author: JB           
             ///@}        
             ///@addtogroup PxstGeo1_revision        
             ///@{           
                   /// Created: Fev, 28th, 2012           
             ///@}        
             AddBlock("PSTM", PSTM::Instance());        
             AddBlock("APTS", APTS::Instance());        
             AddBlock("LFBA", LFBA::Instance());        
             AddBlock("LFBB", LFBB::Instance());        
             AddBlock("LFBK", LFBK::Instance());        
             AddBlock("RFBA", RFBA::Instance());        
             AddBlock("RFBB", RFBB::Instance());        
             AddBlock("RFKK", RFKK::Instance());        
             AddBlock("BPPC", BPPC::Instance());        
             AddBlock("MTPA", MTPA::Instance());        
             AddBlock("MTPB", MTPB::Instance());        
             AddBlock("MTPC", MTPC::Instance());        
             AddBlock("MTPD", MTPD::Instance());        
             AddBlock("MTPE", MTPE::Instance());        
             AddBlock("MTPF", MTPF::Instance());        
             AddBlock("MTPG", MTPG::Instance());        
             AddBlock("MTPH", MTPH::Instance());        
             AddBlock("BPRS", BPRS::Instance());        
             AddBlock("MOSC", MOSC::Instance());        
             AddBlock("PITN", PITN::Instance());        
             AddBlock("APFA", APFA::Instance());        
             AddBlock("APFB", APFB::Instance());        
             AddBlock("APFC", APFC::Instance());        
             AddBlock("APFD", APFD::Instance());        
             AddBlock("APFE", APFE::Instance());        
             AddBlock("APFF", APFF::Instance());        
             AddBlock("APFG", APFG::Instance());        
             AddBlock("APFH", APFH::Instance());        
             AddBlock("APFI", APFI::Instance());        
             AddBlock("PITR", PITR::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill psts
++psts._index;
psts.version = 1.0;
// psts_docum.version = "None";
psts.rmin = radinnershell;
// psts_docum.rmin = "None";
psts.rmax = radoutershell;
// psts_docum.rmax = "None";
psts.dz = lengthshell;
// psts_docum.dz = "None";
PSTS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfba
++sfba._index;
sfba.version = 1.0;
// sfba_docum.version = "None";
sfba.rmin = radoutershell;
// sfba_docum.rmin = "None";
sfba.rmax = radouterfbase;
// sfba_docum.rmax = "None";
sfba.dz = lengthfbase;
// sfba_docum.dz = "None";
SFBA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfbb
++sfbb._index;
sfbb.version = 1.0;
// sfbb_docum.version = "None";
sfbb.rmin = radoutershell;
// sfbb_docum.rmin = "None";
sfbb.rmax = radouterfbacker;
// sfbb_docum.rmax = "None";
sfbb.dz = smalllengthfbase;
// sfbb_docum.dz = "None";
SFBB.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfbk
++sfbk._index;
sfbk.version = 1.0;
// sfbk_docum.version = "None";
sfbk.rmin = radouterfbase;
// sfbk_docum.rmin = "None";
sfbk.rmax = radouterfbacker;
// sfbk_docum.rmax = "None";
sfbk.dz = lengthfbacker;
// sfbk_docum.dz = "None";
SFBK.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill bppc
++bppc._index;
bppc.version = 1.0;
// bppc_docum.version = "None";
bppc.rmin = 2.8;
// bppc_docum.rmin = "None";
bppc.rmax = 13.2;
// bppc_docum.rmax = "None";
bppc.dz = 0.1;
// bppc_docum.dz = "None";
BPPC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mosc
++mosc._index;
mosc.version = 1.0;
// mosc_docum.version = "None";
mosc.rmin = 25.9;
// mosc_docum.rmin = "None";
mosc.rmax = 42.0;
// mosc_docum.rmax = "None";
mosc.dz = 0.1;
// mosc_docum.dz = "None";
MOSC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pita
++pita._index;
pita.version = 1.0;
// pita_docum.version = "None";
pita.rmin = pitrouter;
// pita_docum.rmin = "None";
pita.rmax = pitfr3;
// pita_docum.rmax = "None";
pita.dz = pitlengtha;
// pita_docum.dz = "None";
PITA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pitb
++pitb._index;
pitb.version = 1.0;
// pitb_docum.version = "None";
pitb.rmin = pitrouter;
// pitb_docum.rmin = "None";
pitb.rmax = pitfr4;
// pitb_docum.rmax = "None";
pitb.dz = pitlengthb;
// pitb_docum.dz = "None";
PITB.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pitc
++pitc._index;
pitc.version = 1.0;
// pitc_docum.version = "None";
pitc.rmin = pitfr3;
// pitc_docum.rmin = "None";
pitc.rmax = pitfr4;
// pitc_docum.rmax = "None";
pitc.dz = pitlengthc;
// pitc_docum.dz = "None";
PITC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pitr
++pitr._index;
pitr.version = 1.0;
// pitr_docum.version = "None";
pitr.dmin = 1.8;
// pitr_docum.dmin = "Tube parameters for rail diameter";
pitr.dmax = 2.0;
// pitr_docum.dmax = "None";
pitr.dz = 211.4;
// pitr_docum.dz = "None";
PITR.fill();
        
             /// Material CFRPMix a=12 z=6 dens=1.3 radl=23.9         
             { AgMaterial &mat = AgMaterial::Get("Cfrpmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=23.9;           
                   _material = mat;           
             }        
             /// Component O	a=16	z=8	w=0.209235        
             /// Component N	a=15	z=7	w=0.073270        
             /// Component C	a=12	z=6	w=0.691133        
             /// Component H	a=1	z=1	w=0.026362        
             /// Mixture Polyimide dens=1.41        
             {  AgMaterial &mix = AgMaterial::Get("Polyimide");           
                   mix.Component("O",16,8,0.209235);           
                   mix.Component("N",15,7,0.073270);           
                   mix.Component("C",12,6,0.691133);           
                   mix.Component("H",1,1,0.026362);           
                   mix.par("dens")=1.41;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("PSTM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PSTM           
                   Create("PSTM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PSTM");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PSTM to mother IDSM           
                   place.TranslateZ(0);           
                   /// Translate z = 0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PSTM"), place );           
             } // end placement of PSTM        
       }; // PxstGeo1     
 }; // namespace PxstGeo1  
 