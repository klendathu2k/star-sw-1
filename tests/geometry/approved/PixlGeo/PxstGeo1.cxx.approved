          void MTPD::Block( AgCreate create )     
          {         
                ///@addtogroup MTPD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("MTPD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=3;              
                            shape.Z(0)=-psts.dz/2.-widthlowerringtp-widthringtp;              
                            shape.Z(1)=-psts.dz/2.-widthlowerringtp;              
                            shape.Z(2)=-psts.dz/2.;              
                            shape.Rmin(0)=radinnermintp/2.;              
                            shape.Rmin(1)=radinnermintp/2.-tp;              
                            shape.Rmin(2)=radouterfbacker/2-tp;              
                            shape.Rmax(0)=radinnermintp/2.;              
                            shape.Rmax(1)=radinnermintp/2.;              
                            shape.Rmax(2)=radouterfbacker/2.;              
                            /// Shape Pcon phi1=0 dphi=360 nz=3               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPD;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPD     
