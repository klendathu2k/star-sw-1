                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("MTPB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
