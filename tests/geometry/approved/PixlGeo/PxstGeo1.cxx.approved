                            /// Add daughter volume PITR to mother PSTM              
                            place.TranslateX(tempox);              
                            /// Translate x = tempox              
                            place.TranslateY(tempoy);              
                            /// Translate y = tempoy              
                            place.TranslateZ(-1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.));              
                            /// Translate z = -1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.)              
                            _stacker -> Position( AgBlock::Find("PITR"), place );              
                      } // end placement of PITR           
                      _create = AgCreate("PITR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PITR              
                            Create("PITR");               
                      }           
                      tempox=(-1*radrail)*cos(-angle);           
                      tempoy=(-1*radrail)*sin(-angle);           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PITR");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume PITR to mother PSTM              
                            place.TranslateX(tempox);              
                            /// Translate x = tempox              
                            place.TranslateY(tempoy);              
                            /// Translate y = tempoy              
                            place.TranslateZ(-1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.));              
                            /// Translate z = -1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.)              
                            _stacker -> Position( AgBlock::Find("PITR"), place );              
                      } // end placement of PITR           
                      _create = AgCreate("PITR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PITR              
                            Create("PITR");               
                      }           
                      tempox=(-1*radrail)*cos(angle);           
                      tempoy=(-1*radrail)*sin(angle);           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PITR");              
                            place.SetMother("PSTM");              
                            /// Add daughter volume PITR to mother PSTM              
                            place.TranslateX(tempox);              
                            /// Translate x = tempox              
                            place.TranslateY(tempoy);              
                            /// Translate y = tempoy              
                            place.TranslateZ(-1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.));              
                            /// Translate z = -1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp+pitlength/2.)              
                            _stacker -> Position( AgBlock::Find("PITR"), place );              
                      } // end placement of PITR           
                      END_OF_PSTM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSTM     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *APTS::mInstance = 0;     
          AgBlock *APTS::Instance(){        
                   if ( mInstance==0 ) mInstance = new APTS();        
                   return mInstance;        
          }     
          void APTS::Block( AgCreate create )     
          {         
                ///@addtogroup APTS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material CFRPMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Cfrpmix");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=psts.rmin/2.;              
                            shape.par("rmax")=psts.rmax/2.;              
                            shape.par("dz")=psts.dz/2.;              
                            /// Shape Tube rmin=psts.rmin/2. rmax=psts.rmax/2. dz=psts.dz/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_APTS;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_APTS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block APTS     
