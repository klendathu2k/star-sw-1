          AgBlock *MTPE::mInstance = 0;     
          AgBlock *MTPE::Instance(){        
                   if ( mInstance==0 ) mInstance = new MTPE();        
                   return mInstance;        
          }     
          void MTPE::Block( AgCreate create )     
          {         
                ///@addtogroup MTPE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("MTPE");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Cone");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=widthringtp/2.;              
                            shape.par("rmn1")=radinnershell/2.;              
                            shape.par("rmx1")=radouterfbacker/2.;              
                            shape.par("rmn2")=radinnershell/2.;              
                            shape.par("rmx2")=radouterfbacker/2.-tp;              
                            /// Shape Cone dz=widthringtp/2. rmn1=radinnershell/2. rmx1=radouterfbacker/2. rmn2=radinnershell/2. rmx2=radouterfbacker/2.-tp               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPE;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPE     
          // ---------------------------------------------------------------------------------------------------     
