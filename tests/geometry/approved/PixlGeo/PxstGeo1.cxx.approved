                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=3;              
                            shape.Z(0)=-1*(psts.dz/2.+widthringtp+widthinnerringtp+widthlowerringtp);              
                            shape.Z(1)=-1*(psts.dz/2.+widthinnerringtp+widthlowerringtp);              
                            shape.Z(2)=-1*(psts.dz/2.+widthlowerringtp);              
                            shape.Rmin(0)=radoutermintp/2.;              
                            shape.Rmin(1)=radoutermintp/2.;              
                            shape.Rmin(2)=radinnermaxtp/2.-tp;              
                            shape.Rmax(0)=radinteratp/2.;              
                            shape.Rmax(1)=radinteratp/2.;              
                            shape.Rmax(2)=radinnermaxtp/2.;              
                            /// Shape Pcon phi1=0 dphi=360 nz=3               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTPB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MTPB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTPB     
