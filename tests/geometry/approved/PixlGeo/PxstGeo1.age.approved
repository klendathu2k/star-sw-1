      STRUCTURE PITA { version,rmin,rmax,dz}
      STRUCTURE PITB { version,rmin,rmax,dz}
      STRUCTURE PITC { version,rmin,rmax,dz}
      STRUCTURE PITR { version,dmin,dmax,dz}
      FILL PSTS		! None
      version = 1.0 ! None
      rmin = RadInnerShell ! None
      rmax = RadOuterShell ! None
      dz = LengthShell ! None
      ENDFILL
      FILL SFBA		! None
      version = 1.0 ! None
      rmin = RadOuterShell ! None
      rmax = RadOuterFBase ! None
      dz = LengthFBase ! None
      ENDFILL
      FILL SFBB		! None
      version = 1.0 ! None
      rmin = RadOuterShell ! None
      rmax = RadOuterFBacker ! None
      dz = SmallLengthFBase ! None
      ENDFILL
      FILL SFBK		! None
      version = 1.0 ! None
      rmin = RadOuterFBase ! None
      rmax = RadOuterFBacker ! None
      dz = LengthFBacker ! None
      ENDFILL
      FILL BPPC		!  Beam Pipe support ring
      version = 1.0 ! None
      rmin = 2.8 ! None
      rmax = 13.2 ! None
      dz = 0.1 ! None
      ENDFILL
      FILL MOSC		!  OSC MSC seal
      version = 1.0 ! None
      rmin = 25.9 ! None
      rmax = 42.0 ! None
      dz = 0.1 ! None
      ENDFILL
      FILL PITA		! None
      version = 1.0 ! None
      rmin = PitROuter ! None
      rmax = PitFR3 ! None
      dz = PitLengthA ! None
      ENDFILL
      FILL PITB		! None
      version = 1.0 ! None
      rmin = PitROuter ! None
      rmax = PitFR4 ! None
      dz = PitLengthB ! None
      ENDFILL
      FILL PITC		! None
      version = 1.0 ! None
      rmin = PitFR3 ! None
      rmax = PitFR4 ! None
      dz = PitLengthC ! None
      ENDFILL
      FILL PITR		! None
      version = 1.0 ! None
      dmin = 1.8 ! Tube parameters for rail diameter
      dmax = 2.0 ! None
      dz = 211.4 ! None
      ENDFILL
      MATERIAL CFRPMix a=12 z=6 dens=1.3 radl=23.9
      COMPONENT O A=16 Z=8 W=0.209235
      COMPONENT N A=15 Z=7 W=0.073270
      COMPONENT C A=12 Z=6 W=0.691133
      COMPONENT H A=1 Z=1 W=0.026362
      MIXTURE Polyimide dens=1.41
      CREATE PSTM
      CALL AgsReset 
      CALL agml_position_begin('PSTM') 
      %mother = 'IDSM' 
      %title = 'PSTM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- PSTM
      BLOCK PSTM   Main volume in the AGML tutorial geometry
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE None seen=0
      SHAPE pcon phi1=0 dphi=360 nz=2 zi={-359,
            60} rmn={minRadPSTM,minRadPSTM} rmx={maxRadPSTM/2,
            maxRadPSTM/2}
