      CALL AgsReset 
      CALL agml_position_begin('APFB') 
      %title = 'APFB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP)  _
	- PITB_dz/2. ) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITC version=1.0
      CREATE APFC
      CALL AgsReset 
      CALL agml_position_begin('APFC') 
      %title = 'APFC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP)  _
	- PITB_dz - PITC_dz/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITA version=1.0
      CREATE APFD
      CALL AgsReset 
      CALL agml_position_begin('APFD') 
      %title = 'APFD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength) + PITB_dz + PITA_dz/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITB version=1.0
      CREATE APFE
      CALL AgsReset 
      CALL agml_position_begin('APFE') 
      %title = 'APFE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength ) + PITB_dz/2. ) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE APFF
      CALL AgsReset 
      CALL agml_position_begin('APFF') 
      %title = 'APFF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength) + PITB_dz + PITC_dz/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITA version=1.0
      CREATE APFG
      CALL AgsReset 
      CALL agml_position_begin('APFG') 
      %title = 'APFG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength*PitFactor) + PITB_dz + PITA_dz/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITB version=1.0
      CREATE APFH
      CALL AgsReset 
      CALL agml_position_begin('APFH') 
      %title = 'APFH' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength*PitFactor ) + PITB_dz/2. ) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITC version=1.0
      CREATE APFI
      CALL AgsReset 
      CALL agml_position_begin('APFI') 
      %title = 'APFI' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength*PitFactor) + PITB_dz + PITC_dz/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use PITR version=1.0
      angle  = 29.25*(PI/180.0)
      tempox =(RadRail)*cos(angle)
      tempoy =(RadRail)*sin(angle)
      CREATE PITR
      CALL AgsReset 
      CALL agml_position_begin('PITR') 
      %title = 'PITR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(tempox) 
      CALL agml_translate_x( %x ) 
      ag_y = real(tempoy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength/2.)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE PITR
      tempox =(RadRail)*cos( - angle)
      tempoy =(RadRail)*sin( - angle)
      CALL AgsReset 
      CALL agml_position_begin('PITR') 
      %title = 'PITR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(tempox) 
      CALL agml_translate_x( %x ) 
      ag_y = real(tempoy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength/2.)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE PITR
      tempox =( - 1*RadRail)*cos( - angle)
      tempoy =( - 1*RadRail)*sin( - angle)
      CALL AgsReset 
      CALL agml_position_begin('PITR') 
      %title = 'PITR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(tempox) 
      CALL agml_translate_x( %x ) 
      ag_y = real(tempoy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength/2.)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE PITR
      tempox =( - 1*RadRail)*cos(angle)
      tempoy =( - 1*RadRail)*sin(angle)
      CALL AgsReset 
      CALL agml_position_begin('PITR') 
      %title = 'PITR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(tempox) 
      CALL agml_translate_x( %x ) 
      ag_y = real(tempoy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-1*(PSTS_dz/2. + WidthRingTP + WidthInnerRingTP + WidthLowerRingTP  _
	+ PitLength/2.)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APTS
      BLOCK APTS   A Pixel Tube Shell
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=2
      SHAPE tube rmin=PSTS_rmin/2. rmax=PSTS_rmax/2.,
            dz=PSTS_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- LFBA
      BLOCK LFBA   A Flange BAse
      MATERIAL Aluminium
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=SFBA_rmin/2. rmax=SFBA_rmax/2.,
            dz=SFBA_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- LFBB
      BLOCK LFBB   A Flange Base B
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=SFBB_rmin/2. rmax=SFBB_rmax/2.,
            dz=SFBB_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- LFBK
      BLOCK LFBK   A Flange BacKer
      MATERIAL Aluminium
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=SFBK_rmin/2. rmax=SFBK_rmax/2.,
            dz=SFBK_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- RFBA
      BLOCK RFBA   A Flange BAse
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=SFBA_rmin/2. rmax=SFBA_rmax/2.,
            dz=SFBA_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- RFBB
      BLOCK RFBB   A Flange Base B
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=SFBB_rmin/2. rmax=SFBB_rmax/2.,
            dz=SFBB_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- RFKK
      BLOCK RFKK   A Flange BacKer
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=SFBK_rmin/2. rmax=SFBK_rmax/2.,
            dz=SFBK_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MOSC
      BLOCK MOSC   A Beam Pipe Ring
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=2
      SHAPE tube rmin=MOSC_rmin/2. rmax=MOSC_rmax/2.,
            dz=MOSC_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BPPC
      BLOCK BPPC   Beam Pipe Support
      MATERIAL CFRPMix
      ATTRIBUTE BPPC seen=1 colo=4
      SHAPE tube rmin=BPPC_rmin rmax=BPPC_rmax,
            dz=BPPC_dz/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPA
      BLOCK MTPA   Msc Transition Plate part A
      MATERIAL Aluminium
      ATTRIBUTE MTPA seen=1 colo=4
      SHAPE pcon phi1=0 dphi=360 nz=2 zi={-1*(PSTS_dz/2.+WidthRingTP+WidthInnerRingTP+WidthLowerRingTP),
            -1*(PSTS_dz/2.+WidthInnerRingTP+WidthLowerRingTP)},
            rmn={RadInterATP/2.,RadInterATP/2.},
            rmx={RadOuterMaxTP/2.,RadOuterMaxTP/2.}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPB
      BLOCK MTPB   Msc Transition Plate part B
      MATERIAL Aluminium
      ATTRIBUTE MTPB seen=1 colo=2
      SHAPE pcon phi1=0 dphi=360 nz=3 zi={-1*(PSTS_dz/2.+WidthRingTP+WidthInnerRingTP+WidthLowerRingTP),
            -1*(PSTS_dz/2.+WidthInnerRingTP+WidthLowerRingTP),
            -1*(PSTS_dz/2.+WidthLowerRingTP)},
            rmn={RadOuterMinTP/2.,RadOuterMinTP/2.,
            RadInnerMaxTP/2.-TP} rmx={RadInterATP/2.,RadInterATP/2.,
            RadInnerMaxTP/2.}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPC
      BLOCK MTPC    Msc Transition Plate part C
      MATERIAL Aluminium
      ATTRIBUTE MTPC seen=1 colo=7
      SHAPE cone dz=WidthRingTP/2. rmn1=RadInnerMinTP/2.,
            rmx1=RadInnerMinTP/2.+LengthInsideRing,
            rmn2=RadInnerMinTP/2. rmx2=RadInnerMaxTP/2.-TP
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPD
      BLOCK MTPD   Msc Transition Plate part D
      MATERIAL Aluminium
      ATTRIBUTE MTPD seen=1 colo=2
      SHAPE pcon phi1=0 dphi=360 nz=3 zi={-PSTS_dz/2.-WidthLowerRingTP-WidthRingTP,
            -PSTS_dz/2.-WidthLowerRingTP,
            -PSTS_dz/2.} rmn={RadInnerMinTP/2.,
            RadInnerMinTP/2.-TP,RadOuterFBacker/2-TP},
            rmx={RadInnerMinTP/2.,RadInnerMinTP/2.,
            RadOuterFBacker/2.}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPE
      BLOCK MTPE    Msc Transition Plate part E
      MATERIAL Aluminium
      ATTRIBUTE MTPE seen=1 colo=3
      SHAPE cone dz=WidthRingTP/2. rmn1=RadInnerShell/2.,
            rmx1=RadOuterFBacker/2. rmn2=RadInnerShell/2.,
            rmx2=RadOuterFBacker/2.-TP
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BPRS
      BLOCK BPRS   the ring
      MATERIAL Polyimide
      ATTRIBUTE None seen=1 colo=6
      SHAPE tube rmin=RingDiameterMin/2. rmax=RingDiameterMax/2.,
            dz=RingThk/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPF
      BLOCK MTPF    vertical support of the inner rings
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=.2 dy=(RadOuterMinTP/2.-RingDiameterMax/2.)/2.,
            dz=WidthRingTP/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPG
      BLOCK MTPG    vertical support of the inner rings
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=.2 dy=(RadInnerShell/2.-RingDiameterMax/2.)/2.,
            dz=(WidthInnerRingTP+WidthLowerRingTP)/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTPH
      BLOCK MTPH    OSC - MSC support ring
      MATERIAL Aluminium
      ATTRIBUTE None seen=1 colo=4
      SHAPE tube rmin=20.3 rmax=22.70 dz=0.85/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PITN
      BLOCK PITN   Pixel Insertion Tube
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=6
      SHAPE tube rmin=PitRInner/2. rmax=PitROuter/2.,
            dz=PitLength/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFA
      BLOCK APFA   A Pit Flange BAse A
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=PITA_rmin/2. rmax=PITA_rmax/2.,
            dz=PITA_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFB
      BLOCK APFB   A Pit Flange Base B
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=4
      SHAPE tube rmin=PITB_rmin/2. rmax=PITB_rmax/2.,
            dz=PITB_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFC
      BLOCK APFC   A Pit Flange BacKer C
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=PITC_rmin/2. rmax=PITC_rmax/2.,
            dz=PITC_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFD
      BLOCK APFD   A Pit Flange BAse D
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=PITA_rmin/2. rmax=PITA_rmax/2.,
            dz=PITA_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFE
      BLOCK APFE   A Pit Flange Base E
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=4
      SHAPE tube rmin=PITB_rmin/2. rmax=PITB_rmax/2.,
            dz=PITB_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFF
      BLOCK APFF   A Pit Flange BacKer F
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=PITC_rmin/2. rmax=PITC_rmax/2.,
            dz=PITC_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFG
      BLOCK APFG   A Pit Flange BAse G
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=3
      SHAPE tube rmin=PITA_rmin/2. rmax=PITA_rmax/2.,
            dz=PITA_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFH
      BLOCK APFH   A Pit Flange Base H
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=4
      SHAPE tube rmin=PITB_rmin/2. rmax=PITB_rmax/2.,
            dz=PITB_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APFI
      BLOCK APFI   A Pit Flange BacKer I
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=PITC_rmin/2. rmax=PITC_rmax/2.,
            dz=PITC_dz/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PITR
      BLOCK PITR   A PIt Rail
      MATERIAL CFRPMix
      ATTRIBUTE None seen=1 colo=2
      SHAPE tube rmin=PITR_dmin/2. rmax=PITR_dmax/2.,
            dz=PITR_dz/2.
      ENDBLOCK
      <W> '===>> 	[End AgML Module PxstGeo1]	 <<==='; (A32,/,/);
      END! Module PxstGeo1
