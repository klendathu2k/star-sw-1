      STRUCTURE PSTS { version,rmin,rmax,dz}
      STRUCTURE SFBA { version,rmin,rmax,dz}
      STRUCTURE SFBB { version,rmin,rmax,dz}
      STRUCTURE SFBK { version,rmin,rmax,dz}
      STRUCTURE BPPC { version,rmin,rmax,dz}
