                                              Create("LADR");                        
                                        }                    
                                        xxpos=2.83991076*cos(alphaz*pi/180.0+1.83238222);                    
                                        yypos=2.83991076*sin(alphaz*pi/180.0+1.83238222);                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("LADR");                       
                                              place.SetMother("PXMO");                       
                                              /// Add daughter volume LADR to mother PXMO                       
                                              place.TranslateX(xxpos+xpos);                       
                                              /// Translate x = xxpos+xpos                       
                                              place.TranslateY(yypos+ypos);                       
                                              /// Translate y = yypos+ypos                       
                                              place.TranslateZ(-4.875+zpos);                       
                                              /// Translate z = -4.875+zpos                       
                                              place.par("only")=AgPosition::kMany;                       
