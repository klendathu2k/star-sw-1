             /// Component O	a=16	z=8	w=0.164        
             /// Component C	a=12	z=6	w=0.763        
             /// Component H	a=1	z=1	w=0.073        
             /// Mixture matAdhesive dens=1.2        
             {  AgMaterial &mix = AgMaterial::Get("Matadhesive");           
                   mix.Component("O",16,8,0.164);           
                   mix.Component("C",12,6,0.763);           
                   mix.Component("H",1,1,0.073);           
                   mix.par("dens")=1.2;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Si	a=28.08	z=14	w=0.281        
             /// Component O	a=16	z=8	w=0.467        
             /// Component C	a=12	z=6	w=0.220        
             /// Component H	a=1	z=1	w=0.032        
             /// Mixture medFR4 dens=1.80        
             {  AgMaterial &mix = AgMaterial::Get("Medfr4");           
                   mix.Component("Si",28.08,14,0.281);           
                   mix.Component("O",16,8,0.467);           
                   mix.Component("C",12,6,0.220);           
                   mix.Component("H",1,1,0.032);           
                   mix.par("dens")=1.80;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Material CFRPMix a=12 z=6 dens=1.3 radl=23.9         
             { AgMaterial &mat = AgMaterial::Get("Cfrpmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=23.9;           
                   _material = mat;           
             }        
             /// Material CBMix a=12 z=6 dens=1.3 radl=68         
             { AgMaterial &mat = AgMaterial::Get("Cbmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=68;           
                   _material = mat;           
             }        
             /// Component O	a=16	z=8	w=0.209235        
             /// Component N	a=15	z=7	w=0.073270        
             /// Component C	a=12	z=6	w=0.691133        
             /// Component H	a=1	z=1	w=0.026362        
             /// Mixture kapton dens=1.41        
             {  AgMaterial &mix = AgMaterial::Get("Kapton");           
                   mix.Component("O",16,8,0.209235);           
                   mix.Component("N",15,7,0.073270);           
                   mix.Component("C",12,6,0.691133);           
                   mix.Component("H",1,1,0.026362);           
                   mix.par("dens")=1.41;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Cu	a=63.54	z=29	w=0.802        
             /// Component kapton	a=12.767	z=6.36	w=0.198        
             /// Mixture matCuCable dens=4.37        
             {  AgMaterial &mix = AgMaterial::Get("Matcucable");           
                   mix.Component("Cu",63.54,29,0.802);           
                   mix.Component("kapton",12.767,6.36,0.198);           
                   mix.par("dens")=4.37;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Aluminium	a=27	z=13	w=0.626        
             /// Component kapton	a=12.767	z=6.36	w=0.374        
             /// Mixture matAlCable dens=1.936        
             {  AgMaterial &mix = AgMaterial::Get("Matalcable");           
                   mix.Component("Aluminium",27,13,0.626);           
                   mix.Component("kapton",12.767,6.36,0.374);           
                   mix.par("dens")=1.936;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
