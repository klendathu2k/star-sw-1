          AgBlock *PXSI::mInstance = 0;     
          AgBlock *PXSI::Instance(){        
                   if ( mInstance==0 ) mInstance = new PXSI();        
                   return mInstance;        
          }     
          void PXSI::Block( AgCreate create )     
          {         
                ///@addtogroup PXSI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Silicon            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Silicon");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PXSI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=594;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=1.1365;              
                            shape.par("dy")=0.0025;              
                            shape.par("dz")=1.0120;              
                            /// Shape Bbox dx=1.1365 dy=0.0025 dz=1.0120               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PXSI;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PLAC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PLAC              
                            Create("PLAC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PLAC");              
                            place.SetMother("PXSI");              
                            /// Add daughter volume PLAC to mother PXSI              
                            place.TranslateX(0.1533);              
                            /// Translate x = 0.1533              
                            place.TranslateY(0.0013);              
                            /// Translate y = 0.0013              
                            place.TranslateZ(0.01604);              
                            /// Translate z = 0.01604              
                            _stacker -> Position( AgBlock::Find("PLAC"), place );              
                      } // end placement of PLAC           
                      END_OF_PXSI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PXSI     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PLAC::mInstance = 0;     
          AgBlock *PLAC::Instance(){        
                   if ( mInstance==0 ) mInstance = new PLAC();        
                   return mInstance;        
          }     
          void PLAC::Block( AgCreate create )     
          {         
                ///@addtogroup PLAC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("PLAC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Silicon            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Silicon");              
                            _material = mat;              
                      }           
                      /// Material SSensitive isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Ssensitive");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      /// Medium MedSiSensitive           
                      ///  epsil = 0.001           
                      {  AgMedium &med = AgMedium::Get("Medsisensitive");              
                               med.Inherit(this);              
                            med.par("epsil")=0.001;              
                            _medium = med;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.9605;              
                            shape.par("dy")=0.0008;              
                            shape.par("dz")=0.9936;              
                            /// Shape Bbox dx=0.9605 dy=0.0008 dz=0.9936               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PLAC;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "PLAC", "z", .00001, 0, 0, "S");           
                      // deferred module()->AddHit( "PLAC", "y", .00001, 0, 0, "S");           
                      // deferred module()->AddHit( "PLAC", "x", .00001, 0, 0, "S");           
                      // deferred module()->AddHit( "PLAC", "ptot", 16, 0, 100, "");           
                      // deferred module()->AddHit( "PLAC", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "sleng", 16, 0, 500, "");           
                      // deferred module()->AddHit( "PLAC", "tof", 16, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "step", .0001, 0, 0, "");           
                      // deferred module()->AddHit( "PLAC", "eloss", 16, 0, 0, "");           
                      END_OF_PLAC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PLAC     
