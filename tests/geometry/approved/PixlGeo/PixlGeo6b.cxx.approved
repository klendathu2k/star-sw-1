             /// USE pxlw _index=1;        
             PXLW.use( __pxlw__index__ = 1 );
        
             /// USE senp version=1.0;        
             SENP.use( __senp_version__ = 1.0 );
        
             /// USE ladr version=pxlw.ladrconfig;        
             LADR.use( __ladr_version__ = pxlw.ladrconfig );
        
             /// USE pixl version=pxlw.secversion;        
             PIXL.use( __pixl_version__ = pxlw.secversion );
        
             /// USE paro version=0;        
             PARO.use( __paro_version__ = 0 );
        
             /// USE para version=0;        
             PARA.use( __para_version__ = 0 );
        
             /// USE lcsd version=1;        
             LCSD.use( __lcsd_version__ = 1 );
        
             debug=0;        
             // - Info -         
             Info( GetName(), Form("PXLPXLW.version=%5.2f",pxlw.secversion)  );        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             _create = AgCreate("PXMO");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PXMO           
                   Create("PXMO");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PXMO");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PXMO to mother IDSM           
                   place.TranslateX(0.0);           
                   /// Translate x = 0.0           
                   place.TranslateY(0.0);           
                   /// Translate y = 0.0           
                   place.TranslateZ(0.0);           
                   /// Translate z = 0.0           
                   place.par("only")=AgPosition::kOnly;           
                   /// Overlap: agposition::konly           
                   place.Misalign("Geometry/pxl/pxlOnPst",0,"right");           
                   _stacker -> Position( AgBlock::Find("PXMO"), place );           
             } // end placement of PXMO        
       }; // PixlGeo6b     
