          void ALCA::Block( AgCreate create )     
          {         
                ///@addtogroup ALCA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("ALCA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=616;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      if ( ladr.type==0 )           
                      {              
                            /// Material matAlCable               
                            {  AgMaterial mat = AgMaterial::CopyMaterial("Matalcable");                 
                                  _material = mat;                 
                            }              
                      }           
                      else           
                      {              
                            /// Material matCuCable               
                            {  AgMaterial mat = AgMaterial::CopyMaterial("Matcucable");                 
                                  _material = mat;                 
                            }              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=1.23025;              
                            shape.par("dy")=ladr.cablethickness/2.0;              
                            shape.par("dz")=cablelength;              
                            /// Shape Bbox dx=1.23025 dy=ladr.cablethickness/2.0 dz=cablelength               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_ALCA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_ALCA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block ALCA     
