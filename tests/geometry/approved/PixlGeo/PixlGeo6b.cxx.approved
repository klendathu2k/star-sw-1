          // ---------------------------------------------------------------------------------------------------     
          AgBlock *LADR::mInstance = 0;     
          AgBlock *LADR::Instance(){        
                   if ( mInstance==0 ) mInstance = new LADR();        
                   return mInstance;        
          }     
          void LADR::Block( AgCreate create )     
          {         
                ///@addtogroup LADR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium MedAir           
                      ///  epsil = 0.001           
                      {  AgMedium &med = AgMedium::Get("Medair");              
                               med.Inherit(this);              
                            med.par("epsil")=0.001;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("LADR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=920;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=1.245;              
                            shape.par("dy")=ladderhalfthickness;              
                            shape.par("dz")=15.325;              
                            /// Shape Bbox dx=1.245 dy=ladderhalfthickness dz=15.325               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_LADR;              
                            _stacker -> Build(this);              
                      }           
                      yp=-(ladderhalfthickness-glucthickness-backingthickness-glubthickness-ladr.cablethickness-gluathickness-0.0025);           
                      if ( pixl.misalign==0 )           
                      {              
                            /// Loop on sens from 1 to senp.sensor step=1              
                            for ( sens=1; (1>0)? (sens<=senp.sensor):(sens>=senp.sensor); sens+=1 )              
                            {                 
                                  zsensor=senp.zpos[int(sens)-1];                 
                                  _create = AgCreate("PXSI");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create PXSI                    
                                        Create("PXSI");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("PXSI");                    
                                        place.SetMother("LADR");                    
                                        /// Add daughter volume PXSI to mother LADR                    
                                        place.TranslateX(0.0848);                    
                                        /// Translate x = 0.0848                    
                                        place.TranslateY(yp);                    
                                        /// Translate y = yp                    
                                        place.TranslateZ(zsensor);                    
                                        /// Translate z = zsensor                    
                                        _stacker -> Position( AgBlock::Find("PXSI"), place );                    
                                  } // end placement of PXSI                 
                            }              
                      }           
                      yp=yp-0.005;           
                      _create = AgCreate("GLUA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUA              
                            Create("GLUA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUA");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUA to mother LADR              
                            place.TranslateX(0.0485);              
                            /// Translate x = 0.0485              
                            place.TranslateY(yp);              
                            /// Translate y = yp              
                            place.TranslateZ(4.8855);              
                            /// Translate z = 4.8855              
                            _stacker -> Position( AgBlock::Find("GLUA"), place );              
                      } // end placement of GLUA           
                      yp=-(ladderhalfthickness-glucthickness-backingthickness-glubthickness-ladr.cablethickness/2.0);           
                      _create = AgCreate("ALCA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create ALCA              
                            Create("ALCA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("ALCA");              
                            place.SetMother("LADR");              
                            /// Add daughter volume ALCA to mother LADR              
                            place.TranslateX(0.01475);              
                            /// Translate x = 0.01475              
                            place.TranslateY(yp);              
                            /// Translate y = yp              
                            place.TranslateZ(cablezoffset);              
                            /// Translate z = cablezoffset              
                            _stacker -> Position( AgBlock::Find("ALCA"), place );              
                      } // end placement of ALCA           
                      yp=-(ladderhalfthickness-glucthickness-backingthickness-glubthickness/2);           
                      _create = AgCreate("GLUB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUB              
                            Create("GLUB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUB");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUB to mother LADR              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(yp);              
                            /// Translate y = yp              
                            place.TranslateZ(0.065);              
                            /// Translate z = 0.065              
                            _stacker -> Position( AgBlock::Find("GLUB"), place );              
                      } // end placement of GLUB           
                      yp=-(ladderhalfthickness-glucthickness-backingthickness/2.0);           
                      _create = AgCreate("CFBK");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create CFBK              
                            Create("CFBK");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("CFBK");              
                            place.SetMother("LADR");              
                            /// Add daughter volume CFBK to mother LADR              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(yp);              
                            /// Translate y = yp              
                            place.TranslateZ(backingzoffset);              
                            /// Translate z = backingzoffset              
                            _stacker -> Position( AgBlock::Find("CFBK"), place );              
                      } // end placement of CFBK           
                      yp=-(ladderhalfthickness-glucthickness/2.0);           
                      _create = AgCreate("GLUC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create GLUC              
                            Create("GLUC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("GLUC");              
                            place.SetMother("LADR");              
                            /// Add daughter volume GLUC to mother LADR              
                            place.TranslateX(0.4995);              
                            /// Translate x = 0.4995              
                            place.TranslateY(yp);              
                            /// Translate y = yp              
                            place.TranslateZ(0.065);              
                            /// Translate z = 0.065              
                            _stacker -> Position( AgBlock::Find("GLUC"), place );              
                      } // end placement of GLUC           
                      _create = AgCreate("DRIV");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create DRIV              
                            Create("DRIV");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("DRIV");              
                            place.SetMother("LADR");              
                            /// Add daughter volume DRIV to mother LADR              
                            place.TranslateX(0.01475);              
                            /// Translate x = 0.01475              
                            place.TranslateY(0.02725);              
                            /// Translate y = 0.02725              
                            place.TranslateZ(-10.589);              
                            /// Translate z = -10.589              
                            _stacker -> Position( AgBlock::Find("DRIV"), place );              
                      } // end placement of DRIV           
                      END_OF_LADR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block LADR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *GLUA::mInstance = 0;     
          AgBlock *GLUA::Instance(){        
                   if ( mInstance==0 ) mInstance = new GLUA();        
                   return mInstance;        
          }     
          void GLUA::Block( AgCreate create )     
          {         
                ///@addtogroup GLUA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("GLUA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=800;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material matAdhesive            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Matadhesive");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=1.1715;              
                            shape.par("dy")=gluathickness/2.0;              
                            shape.par("dz")=10.1295;              
                            /// Shape Bbox dx=1.1715 dy=gluathickness/2.0 dz=10.1295               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_GLUA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_GLUA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block GLUA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *ALCA::mInstance = 0;     
