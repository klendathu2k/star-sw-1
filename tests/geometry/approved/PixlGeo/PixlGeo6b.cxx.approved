       PixlGeo6b::PixlGeo6b()     
         : AgModule("PixlGeo6b","Pixel Detector Geometry  ")     
       {        
       }     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PXMO::mInstance = 0;     
          AgBlock *PXMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new PXMO();        
                   return mInstance;        
          }     
          void PXMO::Block( AgCreate create )     
          {         
                ///@addtogroup PXMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PXMO");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=minrvol;              
                            shape.par("rmax")=maxrvol;              
                            shape.par("dz")=maxzvol;              
                            /// Shape Tube rmin=minrvol rmax=maxrvol dz=maxzvol               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PXMO;              
                            _stacker -> Build(this);              
                      }           
                      if ( pixl.misalign==1 )           
                      {              
                            _create = AgCreate("PXSI");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create PXSI                 
                                  Create("PXSI");                  
                            }              
                            /// Loop on isector from 1 to pixl.sector step=1              
                            for ( isector=1; (1>0)? (isector<=pixl.sector):(isector>=pixl.sector); isector+=1 )              
                            {                 
                                  /// Loop on iladder from 1 to pixl.ladder step=1                 
                                  for ( iladder=1; (1>0)? (iladder<=pixl.ladder):(iladder>=pixl.ladder); iladder+=1 )                 
                                  {                    
                                        /// Loop on isensor from 1 to pixl.sensor step=1                    
                                        for ( isensor=1; (1>0)? (isensor<=pixl.sensor):(isensor>=pixl.sensor); isensor+=1 )                    
                                        {                       
                                              sensorrow=(isector-1)*pixl.ladder*pixl.sensor;                       
                                              sensorrow+=(iladder-1)*pixl.sensor;                       
                                              sensorrow+=(isensor-1);                       
                                              ladderrow=sensorrow/10;                       
                                              sectorrow=sensorrow/40;                       
                                              halfrow=sensorrow/200;                       
                                              if ( pixl.ison[int(isector)-1]==1 )                       
                                              {                          
                                                    {                             
                                                          AgPosition  place;                             
                                                          place.SetBlock("PXSI");                             
                                                          place.SetMother("PXMO");                             
                                                          /// Add daughter volume PXSI to mother PXMO                             
                                                          place.TranslateX(-0.1533);                             
                                                          /// Translate x = -0.1533                             
                                                          place.TranslateY(-0.0013);                             
                                                          /// Translate y = -0.0013                             
                                                          place.TranslateZ(-0.01604);                             
                                                          /// Translate z = -0.01604                             
                                                          place.par("only")=AgPosition::kOnly;                             
                                                          /// Overlap: agposition::konly                             
                                                          place.par("ncopy")=sensorrow+1;                             
                                                          /// Ncopy: sensorrow+1                             
                                                          place.Misalign("Geometry/pxl/pxlSensorOnLadder",sensorrow,"left");                             
                                                          place.Misalign("Geometry/pxl/pxlLadderOnSector",ladderrow,"left");                             
                                                          place.Misalign("Geometry/pxl/pxlSectorOnHalf",sectorrow,"left");                             
                                                          place.Misalign("Geometry/pxl/pxlHalfOnPxl",halfrow,"left");                             
                                                          _stacker -> Position( AgBlock::Find("PXSI"), place );                             
                                                    } // end placement of PXSI                          
                                              }                       
                                        }                    
                                  }                 
                            }              
                      }           
                      /// Loop on ii from 1 to pixl.sector step=1           
                      for ( ii=1; (1>0)? (ii<=pixl.sector):(ii>=pixl.sector); ii+=1 )           
                      {              
                            angle=pixl.phinum[int(ii)-1];              
                            anglepos=angle*(pi/180.0);              
                            xpos=.00001*sin(anglepos)+(paro.dx*paro.mult)*paro.sec[int(ii)-1];              
                            ypos=.00001*cos(anglepos)+(paro.dy*paro.mult)*paro.sec[int(ii)-1];              
                            zpos=(paro.dz*paro.mult)*paro.sec[int(ii)-1];              
                            alphaz=-1*angle-1*(para.dg*para.mult)*para.sec[int(ii)-1];              
                            alphax=-1*(para.da*para.mult)*para.sec[int(ii)-1];              
                            alphay=-1*(para.db*para.mult)*para.sec[int(ii)-1];              
                            if ( pixl.ison[int(ii)-1]==1 )              
                            {                 
                                  if ( debug==1 )                 
                                  {                    
                                        // - Info -                     
                                        Info( GetName(), Form("Instrumentedsector=%2i",ii)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("angle(deg)=%7.3f",angle)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("xpos=%10.5f",xpos)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("ypos=%10.5f",ypos)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("zpos=%10.5f",zpos)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaZ=%7.2f",alphaz)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaX=%6.2f",alphax)  );                    
                                        // - Info -                     
                                        Info( GetName(), Form("alphaY=%6.2f",alphay)  );                    
                                  }                 
                                  _create = AgCreate("PXLA");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create PXLA                    
                                        Create("PXLA");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("PXLA");                    
                                        place.SetMother("PXMO");                    
                                        /// Add daughter volume PXLA to mother PXMO                    
                                        place.TranslateX(xpos);                    
                                        /// Translate x = xpos                    
                                        place.TranslateY(ypos);                    
                                        /// Translate y = ypos                    
                                        place.TranslateZ(zpos);                    
                                        /// Translate z = zpos                    
                                        place.par("only")=AgPosition::kMany;                    
                                        /// Overlap: agposition::kmany                    
                                        place.par("ncopy")=ii;                    
                                        /// Ncopy: ii                    
                                        place.AlphaZ(alphaz);                    
                                        /// Rotate: AlphaZ = alphaz                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaX(alphax);                    
                                        /// Rotate: AlphaX = alphax                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaY(alphay);                    
                                        /// Rotate: AlphaY = alphay                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Misalign("Geometry/pxl/pxlHalfOnPxl",(ii-1)/5,"left");                    
                                        place.Misalign("Geometry/pxl/pxlSectorOnHalf",ii-1,"left");                    
