    // ----------------------------------------------------------------------- geoctr
       void PIXLGEO3::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PIXLGEO3_revision        
             ///@{           
                   /// Created:   10/02/06            
             ///@}        
             ///@addtogroup PIXLGEO3_revision        
             ///@{           
                   /// Author: Andrew Rose           
             ///@}        
             AddBlock("PXMO", PXMO::Instance());        
             AddBlock("PSEC", PSEC::Instance());        
             AddBlock("PLMO", PLMO::Instance());        
             AddBlock("PLAC", PLAC::Instance());        
             AddBlock("PLPS", PLPS::Instance());        
             AddBlock("PXBX", PXBX::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pxlv
++pxlv._index;
pxlv.version = 1.0;
// pxlv_docum.version = " config version ";
pxlv.ladver = 1.0;
// pxlv_docum.ladver = " Ladder Version ";
pxlv.location = 1.0;
// pxlv_docum.location = "Location: 1=CAVE, 2=IDSM";
PXLV.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pxld
++pxld._index;
pxld.version = 1.0;
// pxld_docum.version = " version ";
pxld.totallength = 20.0;
// pxld_docum.totallength = " Overal length of the detector ";
pxld.ladderwidth = 2.00;
// pxld_docum.ladderwidth = " Ladder Width ";
pxld.ladderthk = 0.0240;
// pxld_docum.ladderthk = " Total ladder Thickness ";
pxld.passivethk = 0.0220;
// pxld_docum.passivethk = " Passive silicon Thickness ";
pxld.activethk = 0.0020;
// pxld_docum.activethk = " Active  silicon Thickness ";
pxld.rin = 2.4;
// pxld_docum.rin = " Inner radius ";
pxld.rout = 8.3;
// pxld_docum.rout = " Outer radius ";
PXLD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pxld
++pxld._index;
pxld.version = 2.0;
// pxld_docum.version = " version ";
pxld.ladderwidth = 2.00;
// pxld_docum.ladderwidth = " Ladder Width ";
pxld.ladderthk = 0.0240;
// pxld_docum.ladderthk = " Total ladder Thickness ";
pxld.passivethk = 0.0120;
// pxld_docum.passivethk = " Passive silicon Thickness ";
pxld.activethk = 0.0120;
// pxld_docum.activethk = " Active  silicon Thickness ";
pxld.rin = 2.4;
// pxld_docum.rin = " Inner radius ";
pxld.rout = 8.3;
// pxld_docum.rout = " Outer radius ";
PXLD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixg
++pixg._index;
pixg.ladder = 1;
// pixg_docum.ladder = " ladder index ";
pixg.r = 2.5;
// pixg_docum.r = " 1st ladder nominal radius ";
pixg.a = 100.;
// pixg_docum.a = " 1st ladder nominal position angle ";
pixg.aoffset = 103.;
// pixg_docum.aoffset = " Angular offset ";
pixg.poffset = 0.0;
// pixg_docum.poffset = " Position offset (shift) ";
PIXG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixg
++pixg._index;
pixg.ladder = 2;
// pixg_docum.ladder = " ladder index ";
pixg.r = 2.5;
// pixg_docum.r = " 2nd ladder nominal radius ";
pixg.a = 60.;
// pixg_docum.a = " 2nd ladder nominal position angle ";
pixg.aoffset = 103.;
// pixg_docum.aoffset = " Angular offset ";
PIXG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixg
++pixg._index;
pixg.ladder = 3;
// pixg_docum.ladder = " ladder index ";
pixg.r = 2.5;
// pixg_docum.r = " 2nd ladder nominal radius ";
pixg.a = 20.;
// pixg_docum.a = " 2nd ladder nominal position angle ";
pixg.aoffset = 103.;
// pixg_docum.aoffset = " Angular offset ";
PIXG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pixg
++pixg._index;
pixg.ladder = 4;
// pixg_docum.ladder = " ladder index ";
