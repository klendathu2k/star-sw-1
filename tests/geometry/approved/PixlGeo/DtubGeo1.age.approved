      real *4 maxZvol/23.26/

      real *4 DSEA/27.5145/

      real *4 DSEB/2.6467/

      real *4 DSEC/1.5153/

      real *4 DSED/2.2735/

      real *4 DHSA/3.7738/

      real *4 DHSB/4.2264/

      real *4 rminTubeSectionAIn/6.2/

      real *4 rmaxTubeSectionAIn/6.4/

      real *4 rminTubeSectionAOut/15.0/

      real *4 rmaxTubeSectionAOut/15.2/

      real *4 AngleTopLeft/99.784/

      real *4 AngleBottomLeft/69.721/

      real *4 Thk/0.1/

      real *4 ArcLengthOut/0.32/

      real *4 DTubeW/7.5/

      real *4 DTubeH/14.2/

      real *4 ThkR/0.2441/

      real *4 xpos,ypos,zpos,angle,OuterTubeLength

      Integer *4 sector

      real *4 zoffd/-40.25/

      real *4 zoffdm/-1.63/

      real *4 zoffp/-21.65/

      Integer *4 ii,jj,kk,ll

      real *4 xcable,ycable

      real *4 RadCable/0.165/

      real *4 LengthCaL/4.7996/

      real *4 LengthCaS/1.8518/

      real *4 zoffCableL/-25.6745/

      real *4 zoffCableS/-27.0759/

      real *4 SectionLength,angleori,ArcLength,piratio,twopiratio

      STRUCTURE SCSD { int version,int numberOfCables,xpos(5),ypos(5)}
      STRUCTURE LCSD { int version,int numberOfCables,xpos(15),ypos(15)}
      STRUCTURE RADD { int version,int numberOfSections,int numberOfCables,anglemin(20),
            anglemax(20),zpos(20),radius}
      FILL SCSD		! Short Cable Section D
      version = 1 ! None
      numberOfCables = 5 ! None
      xpos  = {  -3.5642,  -7.2561,  -8.1764,  -5.9736, 
                 -1.4891} !  None
      ypos  = {   7.4391,   3.9234,  -1.0909,  -5.6885, 
                 -8.1133} !  None
      ENDFILL
      FILL LCSD		! Long Cable Section D
      version = 1 ! None
      numberOfCables = 15 ! None
      xpos  = {  -1.2374,  -2.9952,    -4.62,  -6.0408, 
                 -7.2015,  -8.0455,  -8.5368,   -8.657, 
                 -8.3979,   -7.772,  -6.8059,  -5.5426, 
                 -4.0386,  -2.3551,  -0.5702} !  None
      ypos  = {    8.574,   8.1293,   7.3289,   6.2092, 
                  4.8162,   3.2137,   1.4727,  -0.3365, 
                 -2.1291,  -3.8264,  -5.3607,  -6.6586, 
                 -7.6639,  -8.3373,  -8.6448} !  None
      ENDFILL
      FILL RADD		! Short Cable Section D
      version = 1 ! None
      numberOfSections = 10 ! None
      numberOfCables = 20 ! None
      anglemin  = {  -46.62,  -40.97,  -35.32,  -29.67,  -24.01, 
                     -18.36,  -12.71,   -7.06,   -1.41,    4.24, 
                       9.89,   15.54,   21.19,   26.84,   32.50, 
                      38.15,   43.80,   49.45,   55.10,   60.75} !  None
      anglemax  = {  38.27,  38.27,  38.27,  38.27,  45.75, 
                     45.75,  45.75,  45.75,  45.75,  52.62, 
                     52.62,  52.62,  58.91,  58.91,  58.91, 
                     58.91,  64.97,  64.97,  64.97,  64.97} !  None
      zpos  = {     -53.2,     -52.5,     -51.8,     -51.1, 
                    -50.4,     -49.7,       -49,     -48.3, 
                    -47.6,     -46.9,     -46.2,     -45.5, 
                    -44.8,  -44.0999,   -43.401,     -42.7, 
                    -42.0,     -41.3,     -40.6,     -39.9} !  None
      radius = 8.1 ! None
      ENDFILL
      use SCSD version=1
      use LCSD version=1
      use RADD version=1
      MATERIAL CFRPMix a=12 z=6 dens=1.3 radl=23.9
      OuterTubeLength = 360-2*AngleTopLeft
      zoffdm = -(33.95 - DSEA)/2.0
      piratio=PI/180.0
      twopiratio=(2*PI)/360
      CREATE DTUH
      CALL AgsReset 
      CALL agml_position_begin('DTUH') 
      %mother = 'IDSM' 
      %title = 'DTUH' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffd) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('DTUH') 
      %mother = 'IDSM' 
      %title = 'DTUH' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffd) 
      CALL agml_translate_z( %z ) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_ortho('XY-Z'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- DTUH
      BLOCK DTUH   half DTube
      MATERIAL Air
      ATTRIBUTE DTUH seen=0 colo=1
      SHAPE tubs rmin=2.7 rmax=8.9 phi1=-270 phi2=-90,
            dz=33.95/2.
      DO kk = 1, RADD_numberOfCables
      ArcLength=(RADD_anglemax(kk)-RADD_anglemin(kk))*(twopiratio*RADD_radius)
      angleori=(RADD_anglemax(kk)-RADD_anglemin(kk))/(1.0*RADD_numberOfSections)
      DO ii = 1, RADD_numberOfSections
      angle=piratio*(angleori*(ii-1)+RADD_anglemin(kk)+0.5*angleori)
      xcable=RADD_radius*cos(angle)
      ycable=RADD_radius*sin(angle)
      CREATE TUBA
      CALL AgsReset 
      CALL agml_position_begin('TUBA') 
      %mother = 'DTUH' 
      %title = 'TUBA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-1*xcable) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ycable) 
      CALL agml_translate_y( %y ) 
      ag_z = real(RADD_zpos(kk)-zoffd) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = real(-1*(angleori*(ii-1)+0.5*angleori+RADD_anglemin(kk))) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      END DO
      CREATE APTO
      CALL AgsReset 
      CALL agml_position_begin('APTO') 
      %title = 'APTO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-0.8-Thk/2.) 
      CALL agml_translate_x( %x ) 
      ag_y = 5.1887 
      CALL agml_translate_y( %y ) 
      ag_z = real(0+zoffdm) 
