      BLOCK TUBA   A TUBE with innner and outer radius
      ATTRIBUTE TUBA seen=1 colo=629
      SHAPE tube rmin=0 rmax=RadCable dz=ArcLength/(2*RADD_numberOfSections)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APTO
      BLOCK APTO   A Plane TOp
      MATERIAL CFRPMix
      ATTRIBUTE APTO seen=1 colo=920
      SHAPE box dx=Thk/2. dy=DHSA/2. dz=DSEA/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- UCTO
