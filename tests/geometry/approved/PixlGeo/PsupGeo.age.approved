      real *4 MTBdx/2.1/

      real *4 MTBdz/6.8/

      real *4 i,xpos, ypos, zpos

      FILL MTBP		! Mass TerminationBoard Paramaters
      dy  = {    0.0,    0.8,    1.3,  1.585,  1.585} !  Offsets per MTB in y
      ENDFILL
      CREATE PSUP
      CALL AgsReset 
      CALL agml_position_begin('PSUP') 
      %mother = 'IDSM' 
      %title = 'PSUP' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('PSUP') 
      %mother = 'IDSM' 
      %title = 'PSUP' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
