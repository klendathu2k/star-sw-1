          void CSTI::Block( AgCreate create )     
          {         
                ///@addtogroup CSTI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("CSTI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=920;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Cons");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=dseb/2.+.1;              
                            shape.par("rmn1")=.32;              
                            shape.par("rmx1")=.32+thk;              
                            shape.par("rmn2")=.22;              
                            shape.par("rmx2")=.22+thk;              
                            shape.par("phi1")=0;              
                            shape.par("phi2")=62;              
                            /// Shape Cons dz=dseb/2.+.1 rmn1=.32 rmx1=.32+thk rmn2=.22 rmx2=.22+thk phi1=0 phi2=62               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CSTI;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_CSTI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CSTI     
