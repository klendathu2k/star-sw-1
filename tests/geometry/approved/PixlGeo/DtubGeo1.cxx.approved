          AgBlock *CYTR::mInstance = 0;     
          AgBlock *CYTR::Instance(){        
                   if ( mInstance==0 ) mInstance = new CYTR();        
                   return mInstance;        
          }     
          void CYTR::Block( AgCreate create )     
          {         
                ///@addtogroup CYTR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material CFRPMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Cfrpmix");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("CYTR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=920;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=180-anglebottomleft;              
                            shape.par("dphi")=2*anglebottomleft;              
                            shape.par("nz")=3;              
                            shape.Z(0)=dsea/2.;              
                            shape.Z(1)=dsea/2.+dseb;              
                            shape.Z(2)=dsea/2.+dseb+dsec+dsed;              
                            shape.Rmin(0)=3.1;              
                            shape.Rmin(1)=2.76015;              
                            shape.Rmin(2)=2.76015;              
                            shape.Rmax(0)=3.2;              
                            shape.Rmax(1)=2.86015;              
                            shape.Rmax(2)=2.86015;              
                            /// Shape Pcon phi1=180-anglebottomleft dphi=2*anglebottomleft nz=3               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CYTR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_CYTR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CYTR     
