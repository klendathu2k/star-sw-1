          void DTUH::Block( AgCreate create )     
          {         
                ///@addtogroup DTUH_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("DTUH");              
                            attr.par("seen")=0;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=2.7;              
                            shape.par("rmax")=8.9;              
                            shape.par("phi1")=-270;              
                            shape.par("phi2")=-90;              
                            shape.par("dz")=33.95/2.;              
                            /// Shape Tubs rmin=2.7 rmax=8.9 phi1=-270 phi2=-90 dz=33.95/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_DTUH;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on kk from 1 to radd.numberofcables step=1           
                      for ( kk=1; (1>0)? (kk<=radd.numberofcables):(kk>=radd.numberofcables); kk+=1 )           
                      {              
                            arclength=(radd.anglemax[int(kk)-1]-radd.anglemin[int(kk)-1])*(twopiratio*radd.radius);              
                            angleori=(radd.anglemax[int(kk)-1]-radd.anglemin[int(kk)-1])/(1.0*radd.numberofsections);              
                            /// Loop on ii from 1 to radd.numberofsections step=1              
                            for ( ii=1; (1>0)? (ii<=radd.numberofsections):(ii>=radd.numberofsections); ii+=1 )              
                            {                 
                                  angle=piratio*(angleori*(ii-1)+radd.anglemin[int(kk)-1]+0.5*angleori);                 
                                  xcable=radd.radius*cos(angle);                 
                                  ycable=radd.radius*sin(angle);                 
                                  _create = AgCreate("TUBA");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create TUBA                    
                                        Create("TUBA");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("TUBA");                    
                                        place.SetMother("DTUH");                    
                                        /// Add daughter volume TUBA to mother DTUH                    
                                        place.TranslateX(-1*xcable);                    
                                        /// Translate x = -1*xcable                    
                                        place.TranslateY(ycable);                    
                                        /// Translate y = ycable                    
                                        place.TranslateZ(radd.zpos[int(kk)-1]-zoffd);                    
                                        /// Translate z = radd.zpos[int(kk)-1]-zoffd                    
                                        place.AlphaX(90);                    
                                        /// Rotate: AlphaX = 90                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaZ(-1*(angleori*(ii-1)+0.5*angleori+radd.anglemin[int(kk)-1]));                    
                                        /// Rotate: AlphaZ = -1*(angleori*(ii-1)+0.5*angleori+radd.anglemin[int(kk)-1])                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("TUBA"), place );                    
