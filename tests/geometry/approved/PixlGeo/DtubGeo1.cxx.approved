                            if (_same_shape) goto END_OF_LSAR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_LSAR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block LSAR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *LSAS::mInstance = 0;     
          AgBlock *LSAS::Instance(){        
                   if ( mInstance==0 ) mInstance = new LSAS();        
                   return mInstance;        
          }     
          void LSAS::Block( AgCreate create )     
          {         
                ///@addtogroup LSAS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=1;              
                            attr.par("colo")=629;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material copper            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Copper");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=radcable;              
                            shape.par("phi1")=0;              
                            shape.par("phi2")=360;              
                            shape.par("dz")=18.7119/2;              
                            /// Shape Tubs rmin=0 rmax=radcable phi1=0 phi2=360 dz=18.7119/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_LSAS;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_LSAS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block LSAS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *LSAT::mInstance = 0;     
          AgBlock *LSAT::Instance(){        
                   if ( mInstance==0 ) mInstance = new LSAT();        
                   return mInstance;        
          }     
          void LSAT::Block( AgCreate create )     
          {         
                ///@addtogroup LSAT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=1;              
                            attr.par("colo")=629;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material copper            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Copper");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=radcable;              
                            shape.par("phi1")=0;              
                            shape.par("phi2")=360;              
                            shape.par("dz")=19.3957/2;              
                            /// Shape Tubs rmin=0 rmax=radcable phi1=0 phi2=360 dz=19.3957/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_LSAT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_LSAT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block LSAT     
