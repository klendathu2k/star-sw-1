                            _stacker -> Position( AgBlock::Find("LSAJ"), place );              
                      } // end placement of LSAJ           
                      _create = AgCreate("LSAK");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAK              
                            Create("LSAK");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAK");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAK to mother DTUH              
                            place.TranslateX(-8.1001);              
                            /// Translate x = -8.1001              
                            place.TranslateY(-0.4002);              
                            /// Translate y = -0.4002              
                            place.TranslateZ(-39.287-zoffd);              
                            /// Translate z = -39.287-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAK"), place );              
                      } // end placement of LSAK           
                      _create = AgCreate("LSAL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAL              
                            Create("LSAL");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAL");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAL to mother DTUH              
                            place.TranslateX(-8.0213);              
                            /// Translate x = -8.0213              
                            place.TranslateY(-1.196);              
                            /// Translate y = -1.196              
                            place.TranslateZ(-39.6531-zoffd);              
                            /// Translate z = -39.6531-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAL"), place );              
                      } // end placement of LSAL           
                      _create = AgCreate("LSAM");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAM              
                            Create("LSAM");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAM");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAM to mother DTUH              
                            place.TranslateX(-7.8645);              
                            /// Translate x = -7.8645              
                            place.TranslateY(-1.9802);              
                            /// Translate y = -1.9802              
                            place.TranslateZ(-40.0446-zoffd);              
                            /// Translate z = -40.0446-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAM"), place );              
                      } // end placement of LSAM           
                      _create = AgCreate("LSAN");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAN              
                            Create("LSAN");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAN");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAN to mother DTUH              
                            place.TranslateX(-7.6313);              
                            /// Translate x = -7.6313              
                            place.TranslateY(-2.7451);              
                            /// Translate y = -2.7451              
                            place.TranslateZ(-40.4339-zoffd);              
                            /// Translate z = -40.4339-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAN"), place );              
                      } // end placement of LSAN           
                      _create = AgCreate("LSAO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAO              
                            Create("LSAO");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAO");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAO to mother DTUH              
                            place.TranslateX(-7.3239);              
                            /// Translate x = -7.3239              
                            place.TranslateY(-3.4833);              
                            /// Translate y = -3.4833              
                            place.TranslateZ(-40.7774-zoffd);              
                            /// Translate z = -40.7774-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAO"), place );              
                      } // end placement of LSAO           
                      _create = AgCreate("LSAP");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAP              
                            Create("LSAP");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAP");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAP to mother DTUH              
                            place.TranslateX(-6.9452);              
                            /// Translate x = -6.9452              
                            place.TranslateY(-4.1876);              
                            /// Translate y = -4.1876              
                            place.TranslateZ(-41.1379-zoffd);              
                            /// Translate z = -41.1379-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAP"), place );              
                      } // end placement of LSAP           
                      _create = AgCreate("LSAQ");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAQ              
                            Create("LSAQ");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAQ");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAQ to mother DTUH              
                            place.TranslateX(-6.499);              
                            /// Translate x = -6.499              
                            place.TranslateY(-4.8513);              
                            /// Translate y = -4.8513              
                            place.TranslateZ(-41.5212-zoffd);              
                            /// Translate z = -41.5212-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAQ"), place );              
                      } // end placement of LSAQ           
                      _create = AgCreate("LSAR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAR              
                            Create("LSAR");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAR");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAR to mother DTUH              
                            place.TranslateX(-5.9897);              
                            /// Translate x = -5.9897              
                            place.TranslateY(-5.4677);              
                            /// Translate y = -5.4677              
                            place.TranslateZ(-41.8994-zoffd);              
                            /// Translate z = -41.8994-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAR"), place );              
                      } // end placement of LSAR           
                      _create = AgCreate("LSAS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAS              
                            Create("LSAS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAS");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAS to mother DTUH              
                            place.TranslateX(-5.4221);              
                            /// Translate x = -5.4221              
                            place.TranslateY(-6.031);              
                            /// Translate y = -6.031              
                            place.TranslateZ(-42.24405-zoffd);              
                            /// Translate z = -42.24405-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAS"), place );              
                      } // end placement of LSAS           
                      _create = AgCreate("LSAT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LSAT              
                            Create("LSAT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LSAT");              
                            place.SetMother("DTUH");              
                            /// Add daughter volume LSAT to mother DTUH              
                            place.TranslateX(-4.8017);              
                            /// Translate x = -4.8017              
                            place.TranslateY(-6.5357);              
                            /// Translate y = -6.5357              
                            place.TranslateZ(-42.6021-zoffd);              
                            /// Translate z = -42.6021-zoffd              
                            _stacker -> Position( AgBlock::Find("LSAT"), place );              
                      } // end placement of LSAT           
                      /// Loop on jj from 1 to scsd.numberofcables step=1           
                      for ( jj=1; (1>0)? (jj<=scsd.numberofcables):(jj>=scsd.numberofcables); jj+=1 )           
                      {              
                            _create = AgCreate("SCAD");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create SCAD                 
                                  Create("SCAD");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("SCAD");                 
                                  place.SetMother("DTUH");                 
                                  /// Add daughter volume SCAD to mother DTUH                 
                                  place.TranslateX(scsd.xpos[int(jj)-1]);                 
                                  /// Translate x = scsd.xpos[int(jj)-1]                 
                                  place.TranslateY(scsd.ypos[int(jj)-1]);                 
                                  /// Translate y = scsd.ypos[int(jj)-1]                 
                                  place.TranslateZ(zoffcables-zoffd);                 
                                  /// Translate z = zoffcables-zoffd                 
                                  _stacker -> Position( AgBlock::Find("SCAD"), place );                 
                            } // end placement of SCAD              
                      }           
                      /// Loop on ll from 1 to lcsd.numberofcables step=1           
                      for ( ll=1; (1>0)? (ll<=lcsd.numberofcables):(ll>=lcsd.numberofcables); ll+=1 )           
                      {              
                            _create = AgCreate("LCAD");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create LCAD                 
                                  Create("LCAD");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("LCAD");                 
                                  place.SetMother("DTUH");                 
                                  /// Add daughter volume LCAD to mother DTUH                 
                                  place.TranslateX(lcsd.xpos[int(ll)-1]);                 
                                  /// Translate x = lcsd.xpos[int(ll)-1]                 
                                  place.TranslateY(lcsd.ypos[int(ll)-1]);                 
                                  /// Translate y = lcsd.ypos[int(ll)-1]                 
                                  place.TranslateZ(zoffcablel-zoffd);                 
                                  /// Translate z = zoffcablel-zoffd                 
                                  _stacker -> Position( AgBlock::Find("LCAD"), place );                 
                            } // end placement of LCAD              
                      }           
                      END_OF_DTUH:           
                      mCurrent = _save;           
                ///@}        
          } // End Block DTUH     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TUBA::mInstance = 0;     
          AgBlock *TUBA::Instance(){        
                   if ( mInstance==0 ) mInstance = new TUBA();        
                   return mInstance;        
          }     
          void TUBA::Block( AgCreate create )     
          {         
                ///@addtogroup TUBA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("TUBA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=629;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=radcable;              
                            shape.par("dz")=arclength/(2*radd.numberofsections);              
                            /// Shape Tube rmin=0 rmax=radcable dz=arclength/(2*radd.numberofsections)               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TUBA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_TUBA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TUBA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *APTO::mInstance = 0;     
          AgBlock *APTO::Instance(){        
                   if ( mInstance==0 ) mInstance = new APTO();        
                   return mInstance;        
          }     
          void APTO::Block( AgCreate create )     
          {         
                ///@addtogroup APTO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material CFRPMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Cfrpmix");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("APTO");              
                            attr.par("seen")=1;              
                            attr.par("colo")=920;              
                            attr.par("trans")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=thk/2.;              
                            shape.par("dy")=dhsa/2.;              
                            shape.par("dz")=dsea/2.;              
                            /// Shape Bbox dx=thk/2. dy=dhsa/2. dz=dsea/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_APTO;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_APTO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block APTO     
