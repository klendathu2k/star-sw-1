             /// USE scsd version=1;        
             SCSD.use( __scsd_version__ = 1 );
        
             /// USE lcsd version=1;        
             LCSD.use( __lcsd_version__ = 1 );
        
             /// USE radd version=1;        
             RADD.use( __radd_version__ = 1 );
        
             /// Material CFRPMix a=12 z=6 dens=1.3 radl=23.9         
             { AgMaterial &mat = AgMaterial::Get("Cfrpmix");           
                   mat.par("a")=12;           
                   mat.par("z")=6;           
                   mat.par("dens")=1.3;           
                   mat.par("radl")=23.9;           
                   _material = mat;           
             }        
             outertubelength=360-2*angletopleft;        
             zoffdm=-(33.95-dsea)/2.0;        
             piratio=pi/180.0;        
             twopiratio=(2*pi)/360;        
             _create = AgCreate("DTUH");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create DTUH           
                   Create("DTUH");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("DTUH");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume DTUH to mother IDSM           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(zoffd);           
                   /// Translate z = zoffd           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("DTUH"), place );           
             } // end placement of DTUH        
             {           
                   AgPosition  place;           
                   place.SetBlock("DTUH");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume DTUH to mother IDSM           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(zoffd);           
                   /// Translate z = zoffd           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   place.AlphaY(180);           
                   /// Rotate: AlphaY = 180           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   place.Ortho( "XY-Z" ); // ORT=XY-Z           
                   /// Axis substitution: XYZ --> XY-Z           
                   _stacker -> Position( AgBlock::Find("DTUH"), place );           
             } // end placement of DTUH        
       }; // DtubGeo1     
