                            place.SetMother("SUPO");              
                            /// Add daughter volume SUPL to mother SUPO              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = -smai.phimid              
                            /// G3 Reference: thetay = 90              
