          void VPCV::Block( AgCreate create )     
          {         
                ///@addtogroup VPCV_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("VPCV");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
