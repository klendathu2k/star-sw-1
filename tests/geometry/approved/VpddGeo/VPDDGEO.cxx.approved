                            _shape = shape;              
                            if (_same_shape) goto END_OF_VRAD;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "VRAD", "x", 0.1, 0, 0, "S");           
                      // deferred module()->AddHit( "VRAD", "y", 0.1, 0, 0, "");           
                      // deferred module()->AddHit( "VRAD", "z", 0.1, 0, 0, "");           
                      // deferred module()->AddHit( "VRAD", "cx", 10, 0, 0, "");           
