                      // deferred module()->AddHit( "VRAD", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "VRAD", "step", 0.1, 0, 0, "");           
                      // deferred module()->AddHit( "VRAD", "slen", 0.1, 0, 600, "");           
                      // deferred module()->AddHit( "VRAD", "ptot", 16, 0, 100, "");           
                      // deferred module()->AddHit( "VRAD", "tof", 18, 0, 1.0e-6, "");           
                      // deferred module()->AddHit( "VRAD", "eloss", 16, 0, 0.01, "");           
                      END_OF_VRAD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block VRAD     
