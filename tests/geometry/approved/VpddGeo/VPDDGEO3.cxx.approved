                //        
                /// Float_t xloc,yloc,zloc,zpos,tempos        
          ///@}     
          ///@addtogroup VPDDGEO3_vars     
          ///@{        
                Float_t zpose,zposw,ewshift,udshift,boltshift,locang,phiang,detzint;        
                //        
                /// Float_t zpose,zposw,ewshift,udshift,boltshift,locang,phiang,detzint        
          ///@}     
          ///@addtogroup VPDDGEO3_vars     
          ///@{        
                Int_t isec;        
                //        
                /// Int_t isec        
          ///@}     
          ///@addtogroup VPDDGEO3_vars     
          ///@{        
