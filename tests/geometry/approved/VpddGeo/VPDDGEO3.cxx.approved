          AgBlock *IBWH::mInstance = 0;     
          AgBlock *IBWH::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWH();        
                   return mInstance;        
          }     
          void IBWH::Block( AgCreate create )     
          {         
                ///@addtogroup IBWH_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWH");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trap");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=wbsp.trid[int(3)-1]/2.0;              
                            shape.par("thet")=45.0/2.0;              
                            shape.par("phi")=0;              
                            shape.par("h1")=0.0;              
                            shape.par("bl1")=wbsp.trid[int(1)-1]/2.0;              
                            shape.par("tl1")=wbsp.trid[int(1)-1]/2.0;              
                            shape.par("alp1")=0;              
                            shape.par("h2")=wbsp.trid[int(2)-1]/2.0;              
                            shape.par("bl2")=wbsp.trid[int(1)-1]/2.0;              
                            shape.par("tl2")=wbsp.trid[int(1)-1]/2.0;              
                            shape.par("alp2")=0;              
                            /// Shape Trap dz=wbsp.trid[int(3)-1]/2.0 thet=45.0/2.0 phi=0 h1=0.0 bl1=wbsp.trid[int(1)-1]/2.0 tl1=wbsp.trid[int(1)-1]/2.0 alp1=0 h2=wbsp.trid[int(2)-1]/2.0 bl2=wbsp.trid[int(1)-1]/2.0 tl2=wbsp.trid[int(1)-1]/2.0 alp2=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWH;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_IBWH:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWH     
