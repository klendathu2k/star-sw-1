                      _create = AgCreate("VRNG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create VRNG              
                            Create("VRNG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VRNG");              
                            place.SetMother("VPDD");              
                            /// Add daughter volume VRNG to mother VPDD              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("VRNG"), place );              
                      } // end placement of VRNG           
                      END_OF_VPDD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block VPDD     
          // ---------------------------------------------------------------------------------------------------     
