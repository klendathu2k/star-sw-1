          void IBWC::Block( AgCreate create )     
          {         
                ///@addtogroup IBWC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wbsp.ibeamd[int(1)-1]/2.0;              
                            shape.par("dy")=wbsp.ibeamd[int(4)-1]/2.0;              
                            shape.par("dz")=wbsp.ibeamd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wbsp.ibeamd[int(1)-1]/2.0 dy=wbsp.ibeamd[int(4)-1]/2.0 dz=wbsp.ibeamd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWC;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_IBWC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWC     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *IBWD::mInstance = 0;     
          AgBlock *IBWD::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWD();        
                   return mInstance;        
          }     
          void IBWD::Block( AgCreate create )     
          {         
                ///@addtogroup IBWD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wbsp.postd[int(1)-1]/2.0;              
                            shape.par("dy")=wbsp.postd[int(2)-1]/2.0;              
                            shape.par("dz")=wbsp.postd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wbsp.postd[int(1)-1]/2.0 dy=wbsp.postd[int(2)-1]/2.0 dz=wbsp.postd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWD;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("IBWE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create IBWE              
                            Create("IBWE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("IBWE");              
                            place.SetMother("IBWD");              
                            /// Add daughter volume IBWE to mother IBWD              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("IBWE"), place );              
                      } // end placement of IBWE           
                      END_OF_IBWD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *IBWE::mInstance = 0;     
          AgBlock *IBWE::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWE();        
                   return mInstance;        
          }     
          void IBWE::Block( AgCreate create )     
          {         
                ///@addtogroup IBWE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWE");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wbsp.postd[int(1)-1]/2.0-wbsp.postd[int(4)-1];              
                            shape.par("dy")=wbsp.postd[int(2)-1]/2.0;              
                            shape.par("dz")=wbsp.postd[int(3)-1]/2.0-wbsp.postd[int(4)-1];              
                            /// Shape Bbox dx=wbsp.postd[int(1)-1]/2.0-wbsp.postd[int(4)-1] dy=wbsp.postd[int(2)-1]/2.0 dz=wbsp.postd[int(3)-1]/2.0-wbsp.postd[int(4)-1]               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWE;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_IBWE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWE     
