          void IBWF::Block( AgCreate create )     
          {         
                ///@addtogroup IBWF_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWF");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd1");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=wbsp.angld[int(1)-1]/2.0;              
                            shape.par("dx2")=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(3)-1];              
                            shape.par("dy")=wbsp.angld[int(2)-1]/2.0;              
                            shape.par("dz")=wbsp.angld[int(3)-1]/2.0;              
                            /// Shape Trd1 dx1=wbsp.angld[int(1)-1]/2.0 dx2=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(3)-1] dy=wbsp.angld[int(2)-1]/2.0 dz=wbsp.angld[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWF;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("IBWG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create IBWG              
                            Create("IBWG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("IBWG");              
                            place.SetMother("IBWF");              
                            /// Add daughter volume IBWG to mother IBWF              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("IBWG"), place );              
                      } // end placement of IBWG           
                      END_OF_IBWF:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWF     
