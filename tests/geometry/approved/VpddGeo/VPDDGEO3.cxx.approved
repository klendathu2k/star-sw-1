          }     
          void VFEE::Block( AgCreate create )     
          {         
                ///@addtogroup VFEE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("VFEE");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60. + 0.4*4*16./174.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Mixture G10 dens=1.7           
                      {  AgMaterial &mix = AgMaterial::Get("G10");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.par("dens")=1.7;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=vpds.elecwid/2;              
                            shape.par("dy")=vpds.electhck/2;              
                            shape.par("dz")=vpds.eleclen/2;              
                            /// Shape Bbox dx=vpds.elecwid/2 dy=vpds.electhck/2 dz=vpds.eleclen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_VFEE;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("VLEM");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create VLEM              
                            Create("VLEM");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(1)-1]);              
                            /// Translate x = vpds.vlemposx[int(1)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(1)-1]);              
                            /// Translate z = vpds.vlemposz[int(1)-1]              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(2)-1]);              
                            /// Translate x = vpds.vlemposx[int(2)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(2)-1]);              
                            /// Translate z = vpds.vlemposz[int(2)-1]              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(3)-1]);              
                            /// Translate x = vpds.vlemposx[int(3)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(3)-1]);              
                            /// Translate z = vpds.vlemposz[int(3)-1]              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(4)-1]);              
                            /// Translate x = vpds.vlemposx[int(4)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(4)-1]);              
                            /// Translate z = vpds.vlemposz[int(4)-1]              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(6)-1]);              
                            /// Translate x = vpds.vlemposx[int(6)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(6)-1]);              
                            /// Translate z = vpds.vlemposz[int(6)-1]              
                            place.AlphaX(180);              
                            /// Rotate: AlphaX = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(7)-1]);              
                            /// Translate x = vpds.vlemposx[int(7)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(7)-1]);              
                            /// Translate z = vpds.vlemposz[int(7)-1]              
                            place.AlphaX(180);              
                            /// Rotate: AlphaX = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(8)-1]);              
