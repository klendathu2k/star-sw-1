// vpdg_docum.bxwidth = " FEE box width                   (10inch) ";
vpdg.bxthick = 0.635;
// vpdg_docum.bxthick = " FEE box plate thickness         (0.25inch)  ";
vpdg.bxzposc = 0.635;
// vpdg_docum.bxzposc = " FEE central z pos       (0.25inch) ";
vpdg.fpwidth = 7.62;
// vpdg_docum.fpwidth = " frontplate width                (3inch) ";
