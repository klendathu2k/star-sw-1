          AgBlock *IBWA::mInstance = 0;     
          AgBlock *IBWA::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWA();        
                   return mInstance;        
          }     
          void IBWA::Block( AgCreate create )     
          {         
                ///@addtogroup IBWA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wbsp.ibeamd[int(1)-1]/2.0;              
                            shape.par("dy")=wbsp.ibeamd[int(2)-1]/2.0;              
                            shape.par("dz")=wbsp.ibeamd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wbsp.ibeamd[int(1)-1]/2.0 dy=wbsp.ibeamd[int(2)-1]/2.0 dz=wbsp.ibeamd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWA;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("IBWB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create IBWB              
                            Create("IBWB");               
                      }           
                      _create = AgCreate("IBWC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create IBWC              
                            Create("IBWC");               
                      }           
                      _create = AgCreate("IBWD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create IBWD              
                            Create("IBWD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("IBWB");              
                            place.SetMother("IBWA");              
                            /// Add daughter volume IBWB to mother IBWA              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("IBWB"), place );              
                      } // end placement of IBWB           
                      {              
                            AgPosition  place;              
                            place.SetBlock("IBWC");              
                            place.SetMother("IBWA");              
                            /// Add daughter volume IBWC to mother IBWA              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-wbsp.ibeamd[int(1)-1]/2.0+wbsp.ibeamd[int(4)-1]/2.0);              
                            /// Translate y = -wbsp.ibeamd[int(1)-1]/2.0+wbsp.ibeamd[int(4)-1]/2.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            _stacker -> Position( AgBlock::Find("IBWC"), place );              
                      } // end placement of IBWC           
                      {              
                            AgPosition  place;              
                            place.SetBlock("IBWC");              
                            place.SetMother("IBWA");              
                            /// Add daughter volume IBWC to mother IBWA              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(+wbsp.ibeamd[int(1)-1]/2.0-wbsp.ibeamd[int(4)-1]/2.0);              
                            /// Translate y = +wbsp.ibeamd[int(1)-1]/2.0-wbsp.ibeamd[int(4)-1]/2.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            _stacker -> Position( AgBlock::Find("IBWC"), place );              
                      } // end placement of IBWC           
                      END_OF_IBWA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *IBWB::mInstance = 0;     
          AgBlock *IBWB::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWB();        
                   return mInstance;        
          }     
          void IBWB::Block( AgCreate create )     
          {         
                ///@addtogroup IBWB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wbsp.ibeamd[int(4)-1]/2.0;              
                            shape.par("dy")=wbsp.ibeamd[int(2)-1]/2.0-wbsp.ibeamd[int(4)-1];              
                            shape.par("dz")=wbsp.ibeamd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wbsp.ibeamd[int(4)-1]/2.0 dy=wbsp.ibeamd[int(2)-1]/2.0-wbsp.ibeamd[int(4)-1] dz=wbsp.ibeamd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_IBWB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWB     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *IBWC::mInstance = 0;     
          AgBlock *IBWC::Instance(){        
                   if ( mInstance==0 ) mInstance = new IBWC();        
                   return mInstance;        
