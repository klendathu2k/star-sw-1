                            // deferred module()->AddHit( "VRAD", "eloss", 16, 0, 0.01, "");              
                      }           
                      else if ( kdetstyle==2 )           
                      {              
                            {  AgShape shape = AgShape("Tube");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dz")=vpdh.scintthick/2.;                 
