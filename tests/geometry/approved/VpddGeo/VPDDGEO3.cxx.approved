                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(8)-1]);              
                            /// Translate z = vpds.vlemposz[int(8)-1]              
                            place.AlphaX(180);              
                            /// Rotate: AlphaX = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(9)-1]);              
                            /// Translate x = vpds.vlemposx[int(9)-1]              
                            place.TranslateY(vpds.vlemposy);              
                            /// Translate y = vpds.vlemposy              
                            place.TranslateZ(vpds.vlemposz[int(9)-1]);              
                            /// Translate z = vpds.vlemposz[int(9)-1]              
                            place.AlphaX(180);              
                            /// Rotate: AlphaX = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("VLEM"), place );              
                      } // end placement of VLEM           
                      {              
                            AgPosition  place;              
                            place.SetBlock("VLEM");              
                            place.SetMother("VFEE");              
                            /// Add daughter volume VLEM to mother VFEE              
                            place.TranslateX(vpds.vlemposx[int(11)-1]);              
                            /// Translate x = vpds.vlemposx[int(11)-1]              
