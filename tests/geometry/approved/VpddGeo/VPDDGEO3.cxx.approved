          void IBWG::Block( AgCreate create )     
          {         
                ///@addtogroup IBWG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("IBWG");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd1");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(4)-1];              
                            shape.par("dx2")=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(3)-1]+wbsp.angld[int(4)-1];              
                            shape.par("dy")=wbsp.angld[int(2)-1]/2.0-wbsp.angld[int(4)-1];              
                            shape.par("dz")=wbsp.angld[int(3)-1]/2.0-wbsp.angld[int(4)-1];              
                            /// Shape Trd1 dx1=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(4)-1] dx2=wbsp.angld[int(1)-1]/2.0-wbsp.angld[int(3)-1]+wbsp.angld[int(4)-1] dy=wbsp.angld[int(2)-1]/2.0-wbsp.angld[int(4)-1] dz=wbsp.angld[int(3)-1]/2.0-wbsp.angld[int(4)-1]               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_IBWG;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_IBWG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block IBWG     
