                               _stacker -> Position( AgBlock::Find("IBWF"), place );                 
                         } // end placement of IBWF              
                         {                 
                               AgPosition  place;                 
                               place.SetBlock("IBWH");                 
                               place.SetMother("CAVE");                 
                               /// Add daughter volume IBWH to mother CAVE                 
                               place.TranslateX(wbsp.trip[int(1)-1]);                 
                               /// Translate x = wbsp.trip[int(1)-1]                 
                               place.TranslateY(wbsp.trip[int(2)-1]);                 
                               /// Translate y = wbsp.trip[int(2)-1]                 
                               place.TranslateZ(wbsp.trip[int(3)-1]);                 
                               /// Translate z = wbsp.trip[int(3)-1]                 
                               _stacker -> Position( AgBlock::Find("IBWH"), place );                 
                         } // end placement of IBWH              
                   }           
             }        
       }; // VPDDGEO3     
 }; // namespace VPDDGEO3  
 