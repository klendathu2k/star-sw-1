          ///@addtogroup VPDDGEO3_vars     
          ///@{        
                Float_t ybase,ytop,convlength,detangle,strutheight,ydispl;        
                //        
                /// Float_t ybase,ytop,convlength,detangle,strutheight,ydispl        
          ///@}     
