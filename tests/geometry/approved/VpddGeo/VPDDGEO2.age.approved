      ! ---------------------------------------------------------------------------------- VPDD
      BLOCK VPDD   is the whole VPPD assembly
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE VPDD seen=1 colo=7 serial=zpos
      IF ( kDetStyle<2 ) THEN
      SHAPE tube rmin=vpdg_rmin rmax=vpdg_rmax,
            dz=vpdg_BPlength/2
      ELSE
      SHAPE tube rmin=vpdh_rmin rmax=vpdh_rmax,
            dz=vpdh_length/2
      ENDIF
      IF ( kDetStyle<2 ) THEN
      ybase= vpdg_IBposYc - (vpdg_IBheight + vpdg_BPthick)/2
      ytop = ybase + vpdg_BPthick/2+ vpdg_FPheight + vpdg_FPChght
      CREATE VPBP
      CALL AgsReset 
      CALL agml_position_begin('VPBP') 
      %title = 'VPBP' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(ybase) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPBO
      xloc=(vpdg_BPwidth-vpdg_FPwidth)/2
      yloc=ybase+(vpdg_BPthick+vpdg_FPHhght)/2
      zloc=(vpdg_BPlength-2*vpdg_FPthick-vpdg_FPHhght)/2
      CALL AgsReset 
      CALL agml_position_begin('VPBO') 
      %title = 'VPBO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      %thetax = 90.0 
      %thetay = 90.0 
      %thetaz = 180.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPBO') 
      %title = 'VPBO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPBO') 
      %title = 'VPBO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      %thetax = 90.0 
      %thetay = 90.0 
      %thetaz = 180.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPBO') 
      %title = 'VPBO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPFA
      yloc=ytop-vpdg_FPAhght/2
      zloc=(vpdg_BPlength - vpdg_FPthick)/2
      CALL AgsReset 
      CALL agml_position_begin('VPFA') 
      %title = 'VPFA' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFA') 
      %title = 'VPFA' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPFB
      xloc=(vpdg_FPAwidth+(vpdg_BPwidth-vpdg_FPAwidth-2*vpdg_FPwidth)/2)/2
      yloc=(ytop - (vpdg_FPChght+vpdg_FPAhght)/4)
      zloc=(vpdg_BPlength - vpdg_FPthick)/2
      CALL AgsReset 
      CALL agml_position_begin('VPFB') 
      %title = 'VPFB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('Y-XZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFB') 
      %title = 'VPFB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('Y-XZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFB') 
      %title = 'VPFB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('YXZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFB') 
      %title = 'VPFB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('YXZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPFC
      xloc=(vpdg_BPwidth-vpdg_FPwidth)/2
      yloc=(ytop-(vpdg_FPChght+vpdg_FPwidth/2)/2)
      zloc=(vpdg_BPlength - vpdg_FPthick)/2
      CALL AgsReset 
      CALL agml_position_begin('VPFC') 
      %title = 'VPFC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('Y-XZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFC') 
      %title = 'VPFC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('Y-XZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFC') 
      %title = 'VPFC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('YXZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFC') 
      %title = 'VPFC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('YXZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPFP
      xloc=(vpdg_BPwidth-vpdg_FPwidth)/2
      yloc=(ybase+vpdg_BPthick/2+ vpdg_FPheight/2)
      zloc=(vpdg_BPlength-vpdg_FPthick)/2
      CALL AgsReset 
      CALL agml_position_begin('VPFP') 
      %title = 'VPFP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFP') 
      %title = 'VPFP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFP') 
      %title = 'VPFP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPFP') 
      %title = 'VPFP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      strutheight = vpdg_STdiagsz/cos(vpdg_STangle*degrad)                    + vpdg_BPlength*tan(vpdg_STangle*degrad)
      CREATE VPST
      xloc=(vpdg_BPwidth+vpdg_STthick)/2
      yloc=ytop-vpdg_FPwidth-strutheight/2
      CALL AgsReset 
      CALL agml_position_begin('VPST') 
      %title = 'VPST' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPST') 
      %title = 'VPST' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPSC
      xloc=(vpdg_BPwidth-vpdg_SCwidth)/2
      yloc=ytop-vpdg_FPwidth-strutheight+vpdg_SCheight/2
      zloc=(vpdg_BPlength+vpdg_SClength)/2
      CALL AgsReset 
      CALL agml_position_begin('VPSC') 
      %title = 'VPSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPSC') 
      %title = 'VPSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zloc) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      yloc=ytop-vpdg_FPwidth-vpdg_SCheight/2
      CALL AgsReset 
      CALL agml_position_begin('VPSC') 
      %title = 'VPSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPSC') 
      %title = 'VPSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-zloc) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF ( VPDV_vpdConfig<4 ) THEN
      CREATE VPBX
      CALL AgsReset 
      CALL agml_position_begin('VPBX') 
      %title = 'VPBX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpdg_BPwidth-vpdg_BXwidth)/2) 
      CALL agml_translate_x( %x ) 
      ag_y = real((ybase-vpdg_BPthick/2-vpdg_BXheight/2)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE VPBX
      CALL AgsReset 
      CALL agml_position_begin('VPBX') 
      %title = 'VPBX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpdg_BPwidth+2.*vpdg_STthick+vpdg_BXheight)/2.) 
      CALL agml_translate_x( %x ) 
      ag_y = -4.0 
      CALL agml_translate_y( %y ) 
      %thetax = 150.0 
      %thetay = 90.0 
      %thetaz = 0.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      ag_alphaz = 90.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDIF
      CREATE VRNG
      CALL AgsReset 
      CALL agml_position_begin('VRNG') 
      %title = 'VRNG' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBP
      BLOCK VPBP   is the Base Plate
      MATERIAL Aluminium
      ATTRIBUTE VPBP seen=1 colo=5 fill=6
      SHAPE box dx=vpdg_BPwidth/2 dy=vpdg_BPthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBO
      BLOCK VPBO   is container for the hook
      ATTRIBUTE VPBO seen=0
      SHAPE box dx=vpdg_FPHwidth/2 dy=vpdg_FPHhght/2,
            dz=vpdg_FPHhght/2
      CREATE VPBA
      CALL AgsReset 
      CALL agml_position_begin('VPBA') 
      %title = 'VPBA' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-(vpdg_FPHhght-vpdg_FPHthick)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPBB
      CALL AgsReset 
      CALL agml_position_begin('VPBB') 
      %title = 'VPBB' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-(vpdg_FPHhght-vpdg_FPHthick)/2) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpdg_FPHthick/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBA
      BLOCK VPBA   is the part of the hook that mounts to the front/back plate
      MATERIAL Aluminium
      ATTRIBUTE VPBA seen=1 colo=5 fill=6
      SHAPE box dx=vpdg_FPHwidth/2 dy=vpdg_FPHhght/2,
            dz=vpdg_FPHthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBB
      BLOCK VPBB   is the part of the hook that mounts to the base plate
      MATERIAL Aluminium
      ATTRIBUTE VPBB seen=1 colo=5 fill=6
      SHAPE box dx=vpdg_FPHwidth/2 dy=vpdg_FPHthick/2,
            dz=(vpdg_FPHhght-vpdg_FPHthick)/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPFP
      BLOCK VPFP   is a single rectangular piece of the frontpanel
      MATERIAL polystyren
      ATTRIBUTE VPFP seen=1 colo=3 fill=6
      SHAPE box dx=vpdg_FPwidth/2 dy=vpdg_FPheight/2,
            dz=vpdg_FPthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPFA
      BLOCK VPFA   is the central upper part of the frontplate
      MATERIAL polystyren
      ATTRIBUTE VPFA seen=1 colo=3 fill=6
      SHAPE box dx=vpdg_FPAwidth/2 dy=vpdg_FPAhght/2,
            dz=vpdg_FPthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPFB
      BLOCK VPFB   is the middle upper part of the frontplate
      MATERIAL polystyren
      ATTRIBUTE VPFB seen=1 colo=3 fill=6
      SHAPE trap dz=vpdg_FPthick/2 thet=0. phi=0.,
            h1=(vpdg_BPwidth-vpdg_FPAwidth-2*vpdg_FPwidth)/4,
            bl1=vpdg_FPChght/2 tl1=vpdg_FPAhght/2,
            alp1=atan(vpdg_FPAhght/(vpdg_BPwidth-vpdg_FPAwidth-2*vpdg_FPwidth)/2)*raddeg,
            h2=(vpdg_BPwidth-vpdg_FPAwidth-2*vpdg_FPwidth)/4,
            bl2=vpdg_FPChght/2,
            tl2=vpdg_FPAhght/2 alp2=atan(vpdg_FPAhght/(vpdg_BPwidth-vpdg_FPAwidth-2*vpdg_FPwidth)/2)*raddeg
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPFC
      BLOCK VPFC   is the outer upper part of the frontplate
      MATERIAL polystyren
      ATTRIBUTE VPFC seen=1 colo=3 fill=6
      SHAPE trap dz=vpdg_FPthick/2 thet=0. phi=0.,
            h1=vpdg_FPwidth/2 bl1=(vpdg_FPChght-vpdg_FPwidth)/2,
            tl1=vpdg_FPChght/2 alp1=atan(.5)*raddeg,
            h2=vpdg_FPwidth/2 bl2=(vpdg_FPChght-vpdg_FPwidth)/2,
            tl2=vpdg_FPChght/2 alp2=atan(.5)*raddeg
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPST
      BLOCK VPST   is the strut volume
      ATTRIBUTE VPST seen=0
      SHAPE box dx=vpdg_STthick/2 dy=strutheight/2,
            dz=(vpdg_BPlength+2*vpdg_SClength)/2
      CREATE VPSV
      CALL AgsReset 
      CALL agml_position_begin('VPSV') 
      %title = 'VPSV' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPSW
      ydispl=(vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad)) + vpdg_SCheight/2)/2
      CALL AgsReset 
      CALL agml_position_begin('VPSW') 
      %title = 'VPSW' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(strutheight/2-ydispl) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(vpdg_BPlength+vpdg_SClength)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('yzx'//char(0)) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPSW') 
      %title = 'VPSW' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-(strutheight/2-ydispl)) 
      CALL agml_translate_y( %y ) 
      ag_z = real((vpdg_BPlength+vpdg_SClength)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('yzx'//char(0)) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPSV
      BLOCK VPSV   is the actual strut between front and backplates
      MATERIAL Aluminium
      ATTRIBUTE VPSV seen=1 colo=3 fill=6
      SHAPE trap dz=vpdg_BPlength/2 thet=vpdg_STangle,
            phi=270. h1=vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad)),
            bl1=vpdg_STthick/2 tl1=vpdg_STthick/2,
            alp1=0. h2=vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad)),
            bl2=vpdg_STthick/2 tl2=vpdg_STthick/2,
            alp2=0.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPSW
      BLOCK VPSW   is a tiny piece of aluminium that belongs to the strut
      MATERIAL Aluminium
      ATTRIBUTE VPSW seen=1 colo=3 fill=6
      SHAPE trap dz=vpdg_STthick/2 thet=0. phi=0.,
            h1=vpdg_SClength/2 bl1=vpdg_SCheight/2 tl1=vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad)),
            alp1=atan((vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad))-vpdg_SCheight/2)/vpdg_SClength)*raddeg,
            h2=vpdg_SClength/2 bl2=vpdg_SCheight/2 tl2=vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad)),
            alp2=atan((vpdg_STdiagsz/(2*cos(vpdg_STangle*degrad))-vpdg_SCheight/2)/vpdg_SClength)*raddeg
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPSC
      BLOCK VPSC   is a clamp that holds the strut
      SHAPE box dx=vpdg_SCwidth/2 dy=vpdg_SCheight/2,
            dz=vpdg_SClength/2
      CREATE VPSA
      CALL AgsReset 
      CALL agml_position_begin('VPSA') 
      %title = 'VPSA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-vpdg_SCthick/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real((vpdg_SClength-vpdg_SCthick)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPSB
      CALL AgsReset 
      CALL agml_position_begin('VPSB') 
      %title = 'VPSB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((vpdg_SCwidth-vpdg_SCthick)/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPSA
      BLOCK VPSA   is part of a strut clamp that holds to the frontplate
      MATERIAL Aluminium
      ATTRIBUTE VPSA seen=1 colo=3 fill=6
      SHAPE box dx=(vpdg_SCwidth-vpdg_SCthick)/2,
            dy=vpdg_SCheight/2 dz=vpdg_SCthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPSB
      BLOCK VPSB   is part of a strut clamp that holds to the strut
      MATERIAL Aluminium
      ATTRIBUTE VPSB seen=1 colo=3 fill=6
      SHAPE box dx=vpdg_SCthick/2 dy=vpdg_SCheight/2,
            dz=vpdg_SClength/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBX
      BLOCK VPBX   is the FEE box
      MATERIAL Aluminium
      ATTRIBUTE VPBX seen=1 colo=2
      SHAPE box dx=vpdg_BXwidth/2 dy=vpdg_BXheight/2,
            dz=vpdg_BXlength/2
      CREATE VPBI
      CALL AgsReset 
      CALL agml_position_begin('VPBI') 
      %title = 'VPBI' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPBI
      BLOCK VPBI   is the empty space inside of the FEE box
      MATERIAL Air
      ATTRIBUTE VPBI seen=0
      SHAPE box dx=(vpdg_BXwidth-vpdg_BXthick)/2,
            dy=(vpdg_BXheight-vpdg_BXthick)/2 dz=(vpdg_BXlength-vpdg_BXthick)/2
      CREATE VFEE
      CALL AgsReset 
      CALL agml_position_begin('VFEE') 
      %title = 'VFEE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VFEEPosX) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VFEEPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VFEEPosZ) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VFEE
      BLOCK VFEE   is the FEE inside the box
      ATTRIBUTE VFEE seen=1 colo=3
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60. + 0.4*4*16./174.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      MIXTURE G10 dens=1.7
      SHAPE box dx=vpds_ElecWid/2 dy=vpds_ElecThck/2,
            dz=vpds_ElecLen/2
      CREATE VLEM
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(1)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(2)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(2)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(3)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(4)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(4)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(6)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(6)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(7)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(7)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(8)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(8)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(9)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(9)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(11)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(11)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(12)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(12)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(13)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(13)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VLEM') 
      %title = 'VLEM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VLEMPosX(14)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(vpds_VLEMPosY) 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VLEMPosZ(14)) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VLEM
      BLOCK VLEM   is a Lemo connector on the FEE boards
      ATTRIBUTE VLEM seen=1 colo=3
      SHAPE box dx=vpds_VLEMLenX/2. dy=vpds_VLEMLenY/2.,
            dz=vpds_VLEMLenZ/2.
      CREATE VPIP
      CALL AgsReset 
      CALL agml_position_begin('VPIP') 
      %title = 'VPIP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpds_VPIPPosX) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpds_VPIPPosZ) 
      CALL agml_translate_z( %z ) 
      %rmin = real(vpds_VPIPRmin) 
      %rmax = real(vpds_VPIPRmax) 
      %dz = real(vpds_VPIPLenZ/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPIP
      BLOCK VPIP   is the Long Pipe
      ATTRIBUTE VPIP seen=1 colo=7
      MATERIAL Aluminium
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VRNG
      BLOCK VRNG   is a single pVPD Ring or the entire upVPD
      IF ( kDetStyle<2 ) THEN
      SHAPE tube rmin=vpdg_Rmin rmax=vpdg_Rmin+2*vpdg_DETrad+vpdg_CLheight,
            dz=vpdg_CLlength/2
      DO isec = 1, vpdg_NumPMT
      detangle=-30+isec*(360/vpdg_NumPMT)
      CREATE VSEC
      CALL AgsReset 
      CALL agml_position_begin('VSEC') 
      %title = 'VSEC' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_alphaz = real(detangle) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ELSEIF ( kDetStyle==2 ) THEN
      SHAPE tube rmin=vpdh_rmin rmax=vpdh_rmax,
            dz=vpdh_length/2
      CREATE VDET
      detzint = -(VPDH_detlen/2.0)+VPDH_detfront+(VPDH_leadthick+vpdh_scintthick)
      locang=0.
      IF ( VPDH_ring1_kproj>0 ) THEN
      locang=degrad*0.
      locang=ATAN((VPDH_ring1_rad)/(0.5*VPDH_zposWest+0.5*VPDH_zposEast+detzint))
      ENDIF
      DO isec = 0, VPDH_ring1_ndet-1
      phiang = degrad*(VPDH_ring1_phi0 + isec*VPDH_ring1_dphi)
      xloc   = (VPDH_ring1_rad+0.5*VPDH_detlen*SIN(locang))*COS(phiang)
      yloc   = (VPDH_ring1_rad+0.5*VPDH_detlen*SIN(locang))*SIN(phiang)
      CALL AgsReset 
      CALL agml_position_begin('VDET') 
      %title = 'VDET' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      %thetax = real(90.+(COS(phiang)*locang)) 
      %thetay = real(90.+(SIN(phiang)*locang)) 
      %thetaz = 0.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      locang=0.
      IF ( VPDH_ring2_kproj>0 ) THEN
      locang=degrad*4.
      locang=ATAN((VPDH_ring2_rad)/(0.5*VPDH_zposWest+0.5*VPDH_zposEast+detzint))
      ENDIF
      DO isec = 0, VPDH_ring2_ndet-1
      phiang = degrad*(VPDH_ring2_phi0 + isec*VPDH_ring2_dphi)
      xloc   = (VPDH_ring2_rad+0.5*VPDH_detlen*SIN(locang))*COS(phiang)
      yloc   = (VPDH_ring2_rad+0.5*VPDH_detlen*SIN(locang))*SIN(phiang)
      CALL AgsReset 
      CALL agml_position_begin('VDET') 
      %title = 'VDET' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      %thetax = real(90.+(COS(phiang)*locang)) 
      %thetay = real(90.+(SIN(phiang)*locang)) 
      %thetaz = 0.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      locang=0.
      IF ( VPDH_ring3_kproj>0 ) THEN
      locang=degrad*8.
      locang=ATAN((VPDH_ring3_rad)/(0.5*VPDH_zposWest+0.5*VPDH_zposEast+detzint))
      ENDIF
      DO isec = 0, VPDH_ring3_ndet-1
      phiang = degrad*(VPDH_ring3_phi0 + isec*VPDH_ring3_dphi)
      xloc   = (VPDH_ring3_rad+0.5*VPDH_detlen*SIN(locang))*COS(phiang)
      yloc   = (VPDH_ring3_rad+0.5*VPDH_detlen*SIN(locang))*SIN(phiang)
      CALL AgsReset 
      CALL agml_position_begin('VDET') 
      %title = 'VDET' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xloc) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yloc) 
      CALL agml_translate_y( %y ) 
      %thetax = real(90.+(COS(phiang)*locang)) 
      %thetay = real(90.+(SIN(phiang)*locang)) 
      %thetaz = 0.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VSEC
      BLOCK VSEC   is one pVPD sector with all stuff inside
      ATTRIBUTE VSEC seen=1 colo=5 serial=isec
      SHAPE tubs phi1=-360/(2*vpdg_NumPMT) phi2=+360/(2*vpdg_NumPMT)
      ydispl=vpdg_DETrad - sqrt(vpdg_DETrad*vpdg_DETrad - (vpdg_CLwidth/2 - vpdg_CLthick)*(vpdg_CLwidth/2 _
            - vpdg_CLthick))
      CREATE VDET
      CALL AgsReset 
      CALL agml_position_begin('VDET') 
      %title = 'VDET' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpdg_Rmin+vpdg_DETrad) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF ( isec==3 ) THEN
      CREATE VPCL
      CALL AgsReset 
      CALL agml_position_begin('VPCL') 
      %title = 'VPCL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpdg_Rmin+vpdg_DETrad) 
      CALL agml_translate_x( %x ) 
      ag_y = real((vpdg_DETrad+vpdg_CLheight/2-ydispl)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE VPCL
      CALL AgsReset 
      CALL agml_position_begin('VPCL') 
      %title = 'VPCL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpdg_Rmin+vpdg_DETrad) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(vpdg_DETrad+vpdg_CLheight/2-ydispl)) 
      CALL agml_translate_y( %y ) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      CREATE VXST
      CALL AgsReset 
      CALL agml_position_begin('VXST') 
      %title = 'VXST' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpdg_Rmin+vpdg_DETrad+0.4) 
      CALL agml_translate_x( %x ) 
      ag_y = 1.5 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpdg_DETlen/2+1.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VXST') 
      %title = 'VXST' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(vpdg_Rmin+vpdg_DETrad-0.4) 
      CALL agml_translate_x( %x ) 
      ag_y = -1.5 
      CALL agml_translate_y( %y ) 
      ag_z = real(vpdg_DETlen/2+1.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VDET
      BLOCK VDET   is a single detector (Radiator+converter and PMT+electroncs)
      IF ( kDetStyle<2 ) THEN
      MATERIAL IRON
      ATTRIBUTE VDET seen=1 colo=1 serial=0
      SHAPE tube rmin=0 rmax=vpdg_DETrad dz=vpdg_DETlen/2
      CREATE VDTI
      CALL AgsReset 
      CALL agml_position_begin('VDTI') 
      %title = 'VDTI' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(+vpdg_DETfront) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( kDetStyle==2 ) THEN
      MATERIAL Aluminium
      ATTRIBUTE VDET seen=1 colo=1 serial=0
      SHAPE tube rmin=0 rmax=vpdh_detrad dz=vpdh_detlen/2
      CREATE VDTI
      CALL AgsReset 
      CALL agml_position_begin('VDTI') 
      %title = 'VDTI' 
      %exname = 'POSITION' ! agml placement 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VDTI
      BLOCK VDTI   is inner part of the single detector
      MATERIAL Air
      ATTRIBUTE VDTI seen=1 colo=1
      IF ( kDetStyle<2 ) THEN
      SHAPE tube rmin=0 rmax=vpdg_PMTrad dz=vpdg_DETlen/2-vpdg_DETfront
      convlength=vpdg_ConvThk+vpdg_RadiThk
      CREATE VCNV
      CALL AgsReset 
      CALL agml_position_begin('VCNV') 
      %title = 'VCNV' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-(vpdg_DETlen-convlength)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPMT
      CALL AgsReset 
      CALL agml_position_begin('VPMT') 
      %title = 'VPMT' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-(vpdg_DETlen/2-convlength-vpdg_PMTlen/2)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( kDetStyle==2 ) THEN
      SHAPE tube rmin=0 rmax=vpdh_detrad-vpdh_detwall,
            dz=(vpdh_detlen/2.)-(2.0*vpdh_detfront)
      CREATE VCNV
      CALL AgsReset 
      CALL agml_position_begin('VCNV') 
      %title = 'VCNV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real(-(vpdh_detlen/2.0)+vpdh_detfront+(vpdh_leadthick+vpdh_scintthick)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VCNV
      BLOCK VCNV   is converter layer (radiator included)
      MATERIAL Lead
      ATTRIBUTE VCNV seen=1 colo=2
      IF ( kDetStyle<2 ) THEN
      SHAPE tube dz=vpdg_ConvThk/2+vpdg_RadiThk/2
      CREATE VRAD
      CALL AgsReset 
      CALL agml_position_begin('VRAD') 
      %title = 'VRAD' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(vpdg_ConvThk/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( kDetStyle==2 ) THEN
      SHAPE tube rmin=0 rmax=vpdh_pmtrad dz=(vpdh_leadthick+vpdh_scintthick)/2.
      CREATE VRAD
      CALL AgsReset 
      CALL agml_position_begin('VRAD') 
      %title = 'VRAD' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(vpdh_leadthick/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VRAD
      BLOCK VRAD   is light-producing layer (scintillator or quartz)
      MATERIAL Polystyren
      MEDIUM sensitive isvol=1
      ATTRIBUTE VRAD seen=1 colo=3
      IF ( kDetStyle<2 ) THEN
      SHAPE tube dz=vpdg_RadiThk/2
      HITS VRAD x:0.1:S y:0.1: z:0.1: cx:10: cy:10: cz:10: step:0.1: slen:0.1:(0,600),
            ptot:16:(0,100) tof:18:(0,1.0E-6) eloss:16:(0,0.01)
      ELSEIF ( kDetStyle==2 ) THEN
      SHAPE tube dz=vpdh_scintthick/2.
      HITS VRAD x:0.1:S y:0.1: z:0.1: cx:10: cy:10: cz:10: step:0.1: slen:0.1:(0,600),
            ptot:16:(0,100) tof:18:(0,1.0E-6) eloss:16:(0,0.01)
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPMT
      BLOCK VPMT   is the PMT inner volume
      MATERIAL Vacuum
      ATTRIBUTE VPMT seen=1 colo=7
      SHAPE tube rmax=vpdg_PMTrad-vpdg_PMTwall,
            dz=vpdg_PMTlen/2-vpdg_PMTwall
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VXST
      BLOCK VXST   are PMT output cables (just to look nicer)
      ATTRIBUTE VXST seen=1 colo=7 serial=0
      SHAPE tube rmin=0 rmax=0.3 dz=1.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPCL
      BLOCK VPCL   is the boat clamp
      ATTRIBUTE VPCL seen=1 colo=6 serial=0
      SHAPE box dx=vpdg_CLwidth/2 dy=vpdg_CLheight/2,
            dz=vpdg_CLlength/2
      CREATE VPCF
      CALL AgsReset 
      CALL agml_position_begin('VPCF') 
      %title = 'VPCF' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(+(vpdg_CLlength-vpdg_CLthick)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPCF') 
      %title = 'VPCF' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-(vpdg_CLlength-vpdg_CLthick)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPCH
      CALL AgsReset 
      CALL agml_position_begin('VPCH') 
      %title = 'VPCH' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE VPCV
      CALL AgsReset 
      CALL agml_position_begin('VPCV') 
      %title = 'VPCV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((vpdg_CLwidth-vpdg_CLthick)/2) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-vpdg_CLthick/2-(vpdg_CLheight/2-vpdg_CLthick/2)/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('VPCV') 
      %title = 'VPCV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpdg_CLwidth-vpdg_CLthick)/2) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-vpdg_CLthick/2-(vpdg_CLheight/2-vpdg_CLthick/2)/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPCF
      BLOCK VPCF   is the front plate of the boat clamp
      MATERIAL Aluminium
      ATTRIBUTE VPCF seen=1 colo=6 fill=6
      SHAPE box dx=vpdg_CLwidth/2 dy=vpdg_CLheight/2,
            dz=vpdg_CLthick/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPCH
      BLOCK VPCH   is the horizontal plate of the boat clamp
      MATERIAL Aluminium
      ATTRIBUTE VPCH seen=1 colo=6 fill=6
      SHAPE box dx=vpdg_CLwidth/2 dy=vpdg_CLthick/2,
            dz=(vpdg_CLlength-2*vpdg_CLthick)/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- VPCV
      BLOCK VPCV   is the vertical plate of the boat clamp
      MATERIAL Aluminium
      ATTRIBUTE VPCV seen=1 colo=6 fill=6
      SHAPE box dx=vpdg_CLthick/2 dy=(vpdg_CLheight/2-vpdg_CLthick/2)/2,
            dz=(vpdg_CLlength-2*vpdg_CLthick)/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBEM
      BLOCK IBEM   is the IBeam structure beneath the Bell reducer cone
      MATERIAL Air
      ATTRIBUTE IBEM seen=0 colo=2
      SHAPE box dx=vpdg_IBwidth/2 dy=vpdg_IBheight/2,
            dz=vpdg_IBleng/2
      CREATE IBEH dy=vpdg_IBthickH/2
      CALL AgsReset 
      CALL agml_position_begin('IBEH') 
      %title = 'IBEH' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(+(vpdg_IBheight-vpdg_IBthickH)/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBEH dz=(vpdg_IBleng-vpdg_IBwlen)/2 dy=vpdg_IBthickH/2
      CALL AgsReset 
      CALL agml_position_begin('IBEH') 
      %title = 'IBEH' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-(vpdg_IBheight-vpdg_IBthickH)/2) 
      CALL agml_translate_y( %y ) 
      ag_z = real(+vpdg_IBwlen/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBEV
      CALL AgsReset 
      CALL agml_position_begin('IBEV') 
      %title = 'IBEV' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(+vpdg_IBwlen/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBEW
      CALL AgsReset 
      CALL agml_position_begin('IBEW') 
      %title = 'IBEW' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real((vpdg_IBheight/2-vpdg_IBthickH-(vpdg_IBwhghtF+vpdg_IBwhghtB)/4)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(vpdg_IBleng-vpdg_IBwlen)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('yzx'//char(0)) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBEH
      BLOCK IBEH   is a horizontal IBeam plate
      MATERIAL Aluminium
      ATTRIBUTE IBEH seen=1 colo=2 fill=7
      SHAPE box
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBEV
      BLOCK IBEV   is a vertical IBeam plate
      MATERIAL Aluminium
      ATTRIBUTE IBEV seen=1 colo=2 fill=7
      SHAPE box dx=vpdg_IBthickV/2 dy=(vpdg_IBheight-2*vpdg_IBthickH)/2,
            dz=(vpdg_IBleng-vpdg_IBwlen)/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBEW
      BLOCK IBEW   is the first part of the IBeam plate
      MATERIAL Aluminium
      ATTRIBUTE IBEW seen=1 colo=2 fill=7
      SHAPE trap dz=vpdg_IBthickV/2 thet=0. phi=0.,
            h1=vpdg_IBwlen/2 bl1=vpdg_IBwhghtF/2 tl1=vpdg_IBwhghtB/2,
            alp1=atan((vpdg_IBwhghtB-vpdg_IBwhghtF)/vpdg_IBwlen/2)*raddeg,
            h2=vpdg_IBwlen/2,
            bl2=vpdg_IBwhghtF/2 tl2=vpdg_IBwhghtB/2,
            alp2=atan((vpdg_IBwhghtB-vpdg_IBwhghtF)/vpdg_IBwlen/2)*raddeg
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSA
      BLOCK IBSA   is the vertical post on the balcony (Envelope)
      MATERIAL Air
      ATTRIBUTE IBSA seen=0 colo=5
      SHAPE box dx=vpds_BSALenX/2. dy=vpds_BSALenY/2.,
            dz=vpds_BSALenZ/2.
      CREATE IBAA
      CALL AgsReset 
      CALL agml_position_begin('IBAA') 
      %title = 'IBAA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real(-(vpds_BSALenX-vpds_BAALenZ)/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('IBAA') 
      %title = 'IBAA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpds_BSALenX-vpds_BAALenZ)/2.) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphay = 90.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBAA
      BLOCK IBAA   is the vertical post on the balcony (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBAA seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BSALenX/2. dy=vpds_BSALenY/2.,
            dz=vpds_BAALenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSB
      BLOCK IBSB   is the diagonal post from the balcony (Envelope)
      MATERIAL Air
      ATTRIBUTE IBSB seen=0 colo=5
      SHAPE box dx=vpds_BSALenX/2. dy=vpds_BSBLenY/2.,
            dz=vpds_BSALenZ/2.
      CREATE IBAB
      CALL AgsReset 
      CALL agml_position_begin('IBAB') 
      %title = 'IBAB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real((vpds_BSALenX-vpds_BAALenZ)/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('IBAB') 
      %title = 'IBAB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpds_BSALenX-vpds_BAALenZ)/2.) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphay = 90.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBAB
      BLOCK IBAB   is the diagonal post from the balcony (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBAB seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BSALenX/2. dy=vpds_BSBLenY/2.,
            dz=vpds_BAALenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSC
      BLOCK IBSC   is the cross post below the I-Beam (Envelope)
      MATERIAL Air
      ATTRIBUTE IBSC seen=0 colo=7
      SHAPE box dx=vpds_BSCLenX/2. dy=vpds_BSCLenY/2.,
            dz=vpds_BSCLenZ/2.
      CREATE IBAC
      CALL AgsReset 
      CALL agml_position_begin('IBAC') 
      %title = 'IBAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(+(vpds_BSCLenZ-vpds_BACLenZ)/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('IBAC') 
      %title = 'IBAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(vpds_BSCLenZ-vpds_BACLenZ)/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBBC
      CALL AgsReset 
      CALL agml_position_begin('IBBC') 
      %title = 'IBBC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real((vpds_BSCLenY-vpds_BACLenZ)/2.) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBCC
      CALL AgsReset 
      CALL agml_position_begin('IBCC') 
      %title = 'IBCC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+(vpds_BSCLenX-vpds_BACLenZ)/2.) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE IBCC
      CALL AgsReset 
      CALL agml_position_begin('IBCC') 
      %title = 'IBCC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(vpds_BSCLenX-vpds_BACLenZ)/2.) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBAC
      BLOCK IBAC   is vertical parts of the cross post below the I-Beam (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBAC seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BSCLenX/2.-vpds_BACLenZ,
            dy=vpds_BSCLenY/2 dz=vpds_BACLenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBBC
      BLOCK IBBC   is the horizontal part of the cross post below the I-Beam (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBBC seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BSCLenX/2.-vpds_BACLenZ,
            dy=vpds_BACLenZ/2. dz=vpds_BSCLenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBCC
      BLOCK IBCC   is the end caps on the cross post below the I-Beam (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBCC seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BACLenZ/2. dy=vpds_BSCLenY/2.,
            dz=vpds_BSCLenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSD
      BLOCK IBSD   are the horizontal plates that hold the pipe-support brackets,
            (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBSD seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BSDLenX/2. dy=vpds_BACLenZ/2,
            dz=vpds_BSALenX/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSE
      BLOCK IBSE   are the vertical parts of the pipe-support brackets (Aluminum)
      MATERIAL Aluminium
      ATTRIBUTE IBSE seen=1 colo=1 fill=0
      SHAPE box dx=vpds_BAALenZ/2. dy=vpds_BSELenY/2,
            dz=vpds_BSELenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSF
      BLOCK IBSF   are the long threaded rods for X-support of the I-beam
      MATERIAL Iron
      ATTRIBUTE IBSF seen=1 colo=4
      SHAPE tube rmin=0 rmax=vpds_BSFRmax dz=vpds_BSFLenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBST
      BLOCK IBST   are the long threaded rods for X-support of the I-beam, short,
            stubs inside IBEM!
      MATERIAL Iron
      ATTRIBUTE IBST seen=0 colo=4
      SHAPE tube rmin=0 rmax=vpds_BSFRmax dz=vpds_BSSLenZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSG
      BLOCK IBSG   are the vertical bolts to the pipe-support brackets
      MATERIAL Iron
      ATTRIBUTE IBSG seen=1 colo=4
      IF ( vpdv_vpdConfig<8 ) THEN
      SHAPE tube rmin=0 rmax=vpds_BSGRmax dz=vpds_BSGLenZ1/2.
      ELSEIF ( vpdv_vpdConfig==8 ) THEN
      SHAPE tube rmin=0 rmax=vpds_BSGRmax dz=vpds_BSGLenZ2/2.
      ELSE
      SHAPE tube rmin=0 rmax=vpds_BSGRmax dz=vpds_BSGLenZ3/2.
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- IBSH
      BLOCK IBSH   are the cross-bolts from the pipe-support brackets to the pipe
      MATERIAL Iron
      ATTRIBUTE IBSH seen=1 colo=4
      SHAPE tube rmin=0 rmax=vpds_BSGRmax dz=vpds_BSHLenZ/2.
      ENDBLOCK
      <W> '===>> 	[End AgML Module VPDDGEO2]	 <<==='; (A32,/,/);
      END! Module VPDDGEO2
