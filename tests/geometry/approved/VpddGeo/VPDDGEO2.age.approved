      detlen = 20.32 !  det assy cylinder radius (8in)
      pmtrad = 1.905 !  pmt cylinder radius (1.5in diameter)
      pmtlen = 1.905 !  pmt cylinder length (1.5in)
      detwall = 0.127 !  det assy cylinder wall thickness (50mils)
