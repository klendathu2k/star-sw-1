      IBwhghtB = 8.3097 !  IBeam vert. front piece height
      EWShift = 1.905 !  east west z shift (0.75*2.54)
      UDShift = 0.0 !  up down y shift
      BoltShift = 0.0 !  Bolt additional y shift
      ENDFILL
      FILL VPDH		! upVPD basic dimensions
