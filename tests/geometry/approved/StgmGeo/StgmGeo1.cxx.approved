// brac_docum.cs = "length of short side of corner bracket";
brac.co = pent.hcdz*1.4;
// brac_docum.co = "offset of sides of corner bracket";
brac.cdz = pent.hcdz*2.0;
// brac_docum.cdz = "z depth of corner bracket";
brac.ml = pent.hcdz*18.0;
// brac_docum.ml = "length of longest side of middle bracket";
brac.ms = pent.hcdz*14.314;
// brac_docum.ms = "length of short side of middle bracket";
brac.mo = pent.hcdz*9.234;
// brac_docum.mo = "offset of sides of middle bracket";
brac.mdz = pent.hcdz;
// brac_docum.mdz = "z depth of middle bracket main part";
brac.mpdz = pent.hcdz*1.122;
// brac_docum.mpdz = "z depth of middle bracket shorter part on top, slightly thicker";
brac.el = pent.hcdz*15.36;
// brac_docum.el = "length of longest side of edge bracket";
brac.es = pent.hcdz*5.6;
// brac_docum.es = "length of short side of edge bracket";
brac.eo = pent.hcdz*5.4;
// brac_docum.eo = "offset of sides of edge bracket";
brac.edz = pent.hcdz;
// brac_docum.edz = "z depth of edge bracket main part";
brac.epdz = pent.hcdz*1.07;
// brac_docum.epdz = "z depth of edge bracket shorter part on top, slightly thicker";
brac.xl = pent.hcdz*11;
// brac_docum.xl = "length of longest side of coax cable connector attached to edge bracket";
brac.xs = pent.hcdz*3.6;
// brac_docum.xs = "length of short side of coax cable connector";
brac.xdz = pent.hcdz*4.0;
// brac_docum.xdz = "z depth of coax cable connector attached to edge bracket";
