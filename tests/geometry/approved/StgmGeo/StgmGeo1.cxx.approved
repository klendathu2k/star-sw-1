// brac_docum.xcl = "length of the connector part of the coax cable connector attached to edge bracket";
brac.xd = pent.hcdz*1.72;
// brac_docum.xd = "diameter of the connector part of the coax cable connector attached to edge bracket";
brac.xo = pent.hcdz*3.0;
