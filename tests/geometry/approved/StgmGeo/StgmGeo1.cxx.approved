TFEE.fill();
        
             /// USE tfee _index=1;        
             TFEE.use( __tfee__index__ = 1 );
        
             /// Component Si	a=28.08	z=14	w=0.6*1*28./60.        
             /// Component O	a=16	z=8	w=0.6*2*16./60. + 0.4*4*16./174.        
             /// Component C	a=12	z=6	w=0.4*8*12./174.        
             /// Component H	a=1	z=1	w=0.4*14*1./174.        
             /// Mixture G10 dens=1.7        
             {  AgMaterial &mix = AgMaterial::Get("G10");           
                   mix.Component("Si",28.08,14,0.6*1*28./60.);           
                   mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);           
                   mix.Component("C",12,6,0.4*8*12./174.);           
                   mix.Component("H",1,1,0.4*14*1./174.);           
                   mix.par("dens")=1.7;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Al	a=27	z=13	w=0.0105        
             /// Component N	a=14	z=7	w=0.7395        
             /// Component Adhesive	a=9	z=4.5	w=0.2500        
             /// Mixture HoneyComb dens=0.282        
             {  AgMaterial &mix = AgMaterial::Get("Honeycomb");           
                   mix.Component("Al",27,13,0.0105);           
                   mix.Component("N",14,7,0.7395);           
                   mix.Component("Adhesive",9,4.5,0.2500);           
                   mix.par("dens")=0.282;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component C	a=12	z=6	w=28        
             /// Component H	a=1	z=1	w=54        
             /// Component O	a=16	z=8	w=11        
             /// Mixture NPCO2 dens=0.2529e-02        
             {  AgMaterial &mix = AgMaterial::Get("Npco2");           
                   mix.Component("C",12,6,28);           
                   mix.Component("H",1,1,54);           
                   mix.Component("O",16,8,11);           
                   mix.par("dens")=0.2529e-02;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("STGM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create STGM           
                   Create("STGM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("STGM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume STGM to mother CAVE           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(5.9);           
                   /// Translate y = 5.9           
                   place.TranslateZ(338.8385);           
                   /// Translate z = 338.8385           
                   place.par("only")=AgPosition::kOnly;           
                   /// Overlap: agposition::konly           
                   place.Misalign("Geometry/stgc/stgcOnTpc",0,"+xyzr");           
                   _stacker -> Position( AgBlock::Find("STGM"), place );           
             } // end placement of STGM        
       }; // StgmGeo1     
