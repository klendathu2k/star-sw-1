       void StgmGeo1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup StgmGeo1_revision        
             ///@{           
                   /// Created: 08/19/2021           
             ///@}        
             ///@addtogroup StgmGeo1_revision        
             ///@{           
                   /// Author: Daniel Brandenburg           
             ///@}        
             AddBlock("STGM", STGM::Instance());        
             AddBlock("STFM", STFM::Instance());        
             AddBlock("STMP", STMP::Instance());        
             AddBlock("STMG", STMG::Instance());        
             AddBlock("STMH", STMH::Instance());        
             AddBlock("STGP", STGP::Instance());        
             AddBlock("STGL", STGL::Instance());        
             AddBlock("STGS", STGS::Instance());        
             AddBlock("STPP", STPP::Instance());        
             AddBlock("STPL", STPL::Instance());        
             AddBlock("STPS", STPS::Instance());        
             AddBlock("STHP", STHP::Instance());        
             AddBlock("STHL", STHL::Instance());        
             AddBlock("STHS", STHS::Instance());        
             inch=2.54;        
             cm=1.;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill main
++main._index;
main.version = 3.0;
// main_docum.version = "selector";
main.useids = 1.0;
// main_docum.useids = "defines placement 0=in cave, 1=in idsm";
{
main_info::active::Type temp = {
main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1),
