// tfee_docum.carddz = "FEES, replace with precise value from CAD model";
tfee.platedx = 0.110*inch/2;
// tfee_docum.platedx = "//... ";
tfee.platedy = 4.650*inch/2;
// tfee_docum.platedy = "//... ";
tfee.platedz = 1.480*inch;
// tfee_docum.platedz = "//... ";
tfee.assemblythickness = tfee.carddx+tfee.platedx;
