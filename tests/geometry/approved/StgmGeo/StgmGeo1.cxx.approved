             // Fill pent
++pent._index;
pent.ls = 60.2361;
// pent_docum.ls = "length of long side";
pent.ss = 0.308571429*pent.ls;
// pent_docum.ss = "length of short side";
pent.ms = pent.ls-pent.ss;
// pent_docum.ms = "length of the other side of the short box";
pent.dz = 0.1593;
// pent_docum.dz = "z depth of PCB, 1.5mm";
pent.gdz = pent.dz*2.0;
// pent_docum.gdz = "z depth of gas active region";
pent.hcdz = pent.dz/0.3;
// pent_docum.hcdz = "z depth of honeycomb";
pent.bdz = pent.hcdz*2.0;
// pent_docum.bdz = "z depth of blue plastic support structure";
pent.bs = pent.hcdz*3.0;
// pent_docum.bs = "width of blue plastic support structure";
PENT.fill();
        
             /// USE pent _index=1;        
             PENT.use( __pent__index__ = 1 );
        
