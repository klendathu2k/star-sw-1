main_info::active::BaseType(1),
main_info::active::BaseType(1),
main_info::active::BaseType(1)
}
;
memcpy(&main.active, &temp, sizeof(temp));;
}
// main_docum.active = "switch on/off up to 20 disks";
main.rmndsk = 2.25;
// main_docum.rmndsk = "default disk inner radius";
main.rmxdsk = 32.5;
// main_docum.rmxdsk = "default disk outer radius";
main.cutele = 1*0.001;
// main_docum.cutele = "electron propagation threshold";
main.type = 1;
// main_docum.type = "This is combined Si+sTGC";
main.rotatez = 0;
// main_docum.rotatez = "rotation angles for disk 2 and 3";
main.rotateztgc = 0;
// main_docum.rotateztgc = "tgc rotation angles for disk 2, 3 and 4";
{
main_info::zsi::Type temp = {
main_info::zsi::BaseType(93.3),
main_info::zsi::BaseType(140.0),
main_info::zsi::BaseType(186.6),
main_info::zsi::BaseType(280.9),
