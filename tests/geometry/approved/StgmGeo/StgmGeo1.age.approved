      zplane = + 8.7985;
      CALL AgsReset 
      CALL agml_position_begin('STFM') 
      %mother = 'STGM' 
      %title = 'STFM' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
