      ENDBLOCK
      ! ---------------------------------------------------------------------------------- STFM
      BLOCK STFM   STGC Full Module (single pentagon)
      MATERIAL Air
      ATTRIBUTE STFM seen=1 colo=3
      SHAPE tubs rmin=0 rmax=85.0 phi1=0 phi2=90,
            dz=10.0
      CREATE STMP
      CREATE STMG
      CREATE STMH
