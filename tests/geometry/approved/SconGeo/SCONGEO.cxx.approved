          void SBRX::Block( AgCreate create )     
          {         
                ///@addtogroup SBRX_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SBRX");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0.0;              
                            shape.par("rmax")=ssub.srollid/2;              
                            shape.par("dz")=ssub.swirelen/2;              
                            /// Shape Tube rmin=0.0 rmax=ssub.srollid/2 dz=ssub.swirelen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SBRX;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SBRX:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SBRX     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SBSR::mInstance = 0;     
          AgBlock *SBSR::Instance(){        
                   if ( mInstance==0 ) mInstance = new SBSR();        
                   return mInstance;        
          }     
          void SBSR::Block( AgCreate create )     
          {         
                ///@addtogroup SBSR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material G10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("G10");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SBSR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=ssub.sringid/2;              
                            shape.par("rmax")=ssub.sringod/2;              
                            shape.par("dz")=ssub.sringthk/2;              
                            /// Shape Tube rmin=ssub.sringid/2 rmax=ssub.sringod/2 dz=ssub.sringthk/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SBSR;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("SBCR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SBCR              
                            Create("SBCR");               
                      }           
                      xbuf=ssub.srcutin+(ssub.srcutout-ssub.srcutin)/2;           
                      /// Loop on i from -1 to 1 step=2           
                      for ( i=-1; (2>0)? (i<=1):(i>=1); i+=2 )           
                      {              
                            /// Loop on j from 0 to 1 step=1              
                            for ( j=0; (1>0)? (j<=1):(j>=1); j+=1 )              
                            {                 
                                  phi=i*ssub.srcutphi+180*j;                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("SBCR");                    
                                        place.SetMother("SBSR");                    
                                        /// Add daughter volume SBCR to mother SBSR                    
                                        place.TranslateX(xbuf*sin(degrad*phi));                    
                                        /// Translate x = xbuf*sin(degrad*phi)                    
                                        place.TranslateY(-xbuf*cos(degrad*phi));                    
                                        /// Translate y = -xbuf*cos(degrad*phi)                    
                                        place.par("only")=AgPosition::kMany;                    
                                        /// Overlap: agposition::kmany                    
                                        place.AlphaZ(phi);                    
                                        /// Rotate: AlphaZ = phi                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("SBCR"), place );                    
                                  } // end placement of SBCR                 
                            }              
                      }           
                      END_OF_SBSR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SBSR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SBCR::mInstance = 0;     
          AgBlock *SBCR::Instance(){        
                   if ( mInstance==0 ) mInstance = new SBCR();        
                   return mInstance;        
          }     
          void SBCR::Block( AgCreate create )     
          {         
                ///@addtogroup SBCR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SBCR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=ssub.srcutwid/2;              
                            shape.par("dy")=(ssub.srcutout-ssub.srcutin)/2;              
                            shape.par("dz")=ssub.sringthk/2;              
                            /// Shape Bbox dx=ssub.srcutwid/2 dy=(ssub.srcutout-ssub.srcutin)/2 dz=ssub.sringthk/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SBCR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SBCR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SBCR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SCMY::mInstance = 0;     
          AgBlock *SCMY::Instance(){        
                   if ( mInstance==0 ) mInstance = new SCMY();        
                   return mInstance;        
          }     
          void SCMY::Block( AgCreate create )     
          {         
                ///@addtogroup SCMY_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      roffset=ssup.grphthk+ssup.cabthk+2.0*ssup.hosrmx;           
                      /// Component C5	a=12	z=6	w=5           
                      /// Component H4	a=1	z=1	w=4           
                      /// Component O2	a=16	z=8	w=2           
                      /// Mixture Mylar dens=1.39           
                      {  AgMaterial &mix = AgMaterial::Get("Mylar");              
                            mix.Component("C5",12,6,5);              
                            mix.Component("H4",1,1,4);              
                            mix.Component("O2",16,8,2);              
                            mix.par("dens")=1.39;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("SCMY");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=3;              
                            shape.Z(0)=ssup.rodlen/2+ssup.grphthk;              
                            shape.Z(1)=ssup.cone3zmx;              
                            shape.Z(2)=ssup.cone4zmx;              
                            shape.Rmin(0)=ssup.con3idmn+roffset;              
                            shape.Rmin(1)=ssup.con4idmn+roffset;              
                            shape.Rmin(2)=ssup.con4idmx+roffset;              
                            shape.Rmax(0)=ssup.con3idmn+roffset+ssup.wrpmythk;              
                            shape.Rmax(1)=ssup.con4idmn+roffset+ssup.wrpmythk;              
                            shape.Rmax(2)=ssup.con4idmx+roffset+ssup.wrpmythk;              
                            /// Shape Pcon phi1=0 dphi=360 nz=3               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SCMY;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SCMY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SCMY     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SROD::mInstance = 0;     
          AgBlock *SROD::Instance(){        
                   if ( mInstance==0 ) mInstance = new SROD();        
                   return mInstance;        
          }     
          void SROD::Block( AgCreate create )     
          {         
                ///@addtogroup SROD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Carbon            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Carbon");              
                            _material = mat;              
                      }           
                      if ( ssup.version>=4.00 )           
                      {              
                            /// Material CarbonFiber dens=ssup_carbondens               
                            { AgMaterial &mat = AgMaterial::Get("Carbonfiber");                 
                                  mat.par("dens")=ssup.carbondens;                 
                                  _material = mat;                 
                            }              
                      }           
                      { AgAttribute attr = AgAttribute("SROD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Eltu");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("p1")=ssup.rododx/2;              
                            shape.par("p2")=ssup.rodod/2;              
                            shape.par("dz")=ssup.rodlen/2;              
                            /// Shape Eltu p1=ssup.rododx/2 p2=ssup.rodod/2 dz=ssup.rodlen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SROD;              
                            _stacker -> Build(this);              
                      }           
                      if ( ssup.version>=4.00 )           
                      {              
                            _create = AgCreate("SRON");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create SRON                 
                                  Create("SRON");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("SRON");                 
                                  place.SetMother("SROD");                 
                                  /// Add daughter volume SRON to mother SROD                 
                                  _stacker -> Position( AgBlock::Find("SRON"), place );                 
                            } // end placement of SRON              
                      }           
                      else           
                      {              
                            _create = AgCreate("SROH");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create SROH                 
                                  Create("SROH");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("SROH");                 
                                  place.SetMother("SROD");                 
                                  /// Add daughter volume SROH to mother SROD                 
                                  _stacker -> Position( AgBlock::Find("SROH"), place );                 
                            } // end placement of SROH              
                      }           
                      END_OF_SROD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SROD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SRON::mInstance = 0;     
          AgBlock *SRON::Instance(){        
                   if ( mInstance==0 ) mInstance = new SRON();        
                   return mInstance;        
          }     
          void SRON::Block( AgCreate create )     
          {         
                ///@addtogroup SRON_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component C	a=12	z=6	w=5           
                      /// Component H	a=1	z=1	w=8           
                      /// Component O	a=16	z=8	w=2           
                      /// Mixture Nomex dens=ssup_nomexdens           
                      {  AgMaterial &mix = AgMaterial::Get("Nomex");              
                            mix.Component("C",12,6,5);              
                            mix.Component("H",1,1,8);              
                            mix.Component("O",16,8,2);              
                            mix.par("dens")=ssup.nomexdens;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("SRON");              
                            attr.par("seen")=1;              
                            attr.par("colo")=5;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Eltu");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("p1")=ssup.rododx/2-ssup.carbonshell;              
                            shape.par("p2")=ssup.rodod/2-ssup.carbonshell;              
                            /// Shape Eltu p1=ssup.rododx/2-ssup.carbonshell p2=ssup.rodod/2-ssup.carbonshell               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SRON;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("SROI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SROI              
                            Create("SROI");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SROI");              
                            place.SetMother("SRON");              
                            /// Add daughter volume SROI to mother SRON              
                            _stacker -> Position( AgBlock::Find("SROI"), place );              
                      } // end placement of SROI           
                      END_OF_SRON:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SRON     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SROI::mInstance = 0;     
          AgBlock *SROI::Instance(){        
                   if ( mInstance==0 ) mInstance = new SROI();        
                   return mInstance;        
          }     
          void SROI::Block( AgCreate create )     
          {         
                ///@addtogroup SROI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material CarbonFiber            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Carbonfiber");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SROI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Eltu");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("p1")=ssup.rodidx/2+ssup.carbonshell;              
                            shape.par("p2")=ssup.rodid/2+ssup.carbonshell;              
                            /// Shape Eltu p1=ssup.rodidx/2+ssup.carbonshell p2=ssup.rodid/2+ssup.carbonshell               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SROI;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("SROH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SROH              
                            Create("SROH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SROH");              
                            place.SetMother("SROI");              
                            /// Add daughter volume SROH to mother SROI              
                            _stacker -> Position( AgBlock::Find("SROH"), place );              
                      } // end placement of SROH           
                      END_OF_SROI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SROI     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *SROH::mInstance = 0;     
          AgBlock *SROH::Instance(){        
                   if ( mInstance==0 ) mInstance = new SROH();        
                   return mInstance;        
          }     
          void SROH::Block( AgCreate create )     
          {         
                ///@addtogroup SROH_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SROH");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Eltu");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("p1")=ssup.rodidx/2;              
                            shape.par("p2")=ssup.rodid/2;              
                            shape.par("dz")=ssup.rodlen/2;              
                            /// Shape Eltu p1=ssup.rodidx/2 p2=ssup.rodid/2 dz=ssup.rodlen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SROH;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SROH:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SROH     
    // ----------------------------------------------------------------------- geoctr
       void SCONGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup SCONGEO_revision        
             ///@{           
                   /// Author: Victor Perev           
             ///@}        
             ///@addtogroup SCONGEO_revision        
             ///@{           
                   /// Created:  31 Oct 2007            
             ///@}        
             AddBlock("SCON", SCON::Instance());        
             AddBlock("SCMY", SCMY::Instance());        
             AddBlock("SGRA", SGRA::Instance());        
             AddBlock("SBSP", SBSP::Instance());        
             AddBlock("SAKM", SAKM::Instance());        
             AddBlock("SCKM", SCKM::Instance());        
             AddBlock("SBMM", SBMM::Instance());        
             AddBlock("SBMI", SBMI::Instance());        
             AddBlock("SBMO", SBMO::Instance());        
             AddBlock("SMRD", SMRD::Instance());        
             AddBlock("SBRL", SBRL::Instance());        
             AddBlock("SBRX", SBRX::Instance());        
             AddBlock("SBSR", SBSR::Instance());        
             AddBlock("SBCR", SBCR::Instance());        
             AddBlock("SROD", SROD::Instance());        
             AddBlock("SROH", SROH::Instance());        
             AddBlock("SRON", SRON::Instance());        
             AddBlock("SROI", SROI::Instance());        
             shield_phi(1)=9.0;        
             shield_phi(2)=27.0;        
             shield_phi(3)=45.0;        
             shield_phi(4)=63.0;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill svtg
++svtg._index;
svtg.version = 2;
// svtg_docum.version = " geometry version ";
svtg.nlayer = 7;
// svtg_docum.nlayer = " number of svt layers (was 7) ";
svtg.rsizemin = 4.100;
// svtg_docum.rsizemin = " STV innermost radius ";
svtg.rsizemax = 46.107;
// svtg_docum.rsizemax = " STV outermost radius ";
svtg.zsizemax = 270;
// svtg_docum.zsizemax = " SVT+FTPC length ";
svtg.angoff = 0;
// svtg_docum.angoff = " angular offset x1 for slayer 2 x2 for slayer 3 ";
svtg.supportver = 1;
// svtg_docum.supportver = " versioning of the shield ";
svtg.conever = 1;
// svtg_docum.conever = " versioning of the support cone ";
svtg.ifmany = 0;
// svtg_docum.ifmany = " whether we use the geant MANY option ";
svtg.nmin = 1;
// svtg_docum.nmin = " the index of the innermost layer ";
SVTG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssup
++ssup._index;
ssup.version = 1;
// ssup_docum.version = " geometry version ";
ssup.cabthk = 0.05;
// ssup_docum.cabthk = " thickness of layer of cables on support cone ";
ssup.hosrmn = 0.75;
// ssup_docum.hosrmn = " inner radius of water hoses on support cone ";
ssup.hosrmx = 0.95;
// ssup_docum.hosrmx = " outer radius of water hoses on support cone ";
ssup.nhoses = 10;
// ssup_docum.nhoses = " number of water hoses ";
ssup.wrpmythk = 0.10;
// ssup_docum.wrpmythk = " thickness of mylar wrap around cone (guess) ";
ssup.wrpalthk = 0.01;
// ssup_docum.wrpalthk = " thickness of Al on mylar wrap (guess) ";
ssup.grphthk = 0.16;
// ssup_docum.grphthk = " support cone thickness ";
ssup.cone1zmn = 52.23;
// ssup_docum.cone1zmn = " Cone z min (parts 1,2,3,4 in increasing z) ";
ssup.rodlen = 110.8;
// ssup_docum.rodlen = " Length of support rods ";
ssup.roddist = 17.5;
// ssup_docum.roddist = " Distance of support rod od from beam axis ";
ssup.rodid = 2.5;
// ssup_docum.rodid = " ID of Carbon support rods (approx) ";
ssup.rodod = 3.05;
// ssup_docum.rodod = " OD of Carbon support rods (approx) ";
ssup.con1idmn = 15.67;
// ssup_docum.con1idmn = " Minimum id of cone 1 ";
ssup.con3idmn = 21.67;
// ssup_docum.con3idmn = " Minimum id of cone 3 (TBD) ";
ssup.con4idmn = 37.4;
// ssup_docum.con4idmn = " Minimum id of cone 4 (TBD) ";
ssup.con4idmx = 37.4;
// ssup_docum.con4idmx = " Maximum id of cone 4 (TBD) ";
ssup.cone3zmx = 150.0;
// ssup_docum.cone3zmx = " Maximum z of cone 3 (TBD) ";
ssup.cone4zmx = 229.36;
// ssup_docum.cone4zmx = " Maximum z of cone 4 (TBD) ";
ssup.brathk = .2;
// ssup_docum.brathk = " thickness of Al brackets ";
ssup.erjthk = .1;
// ssup_docum.erjthk = " (z) thickness of end ring joining brackets ";
ssup.erjwid = 2.07;
// ssup_docum.erjwid = " (azimuthal) width of end ring joining brackets ";
ssup.erjlen = 5.19;
// ssup_docum.erjlen = " (radial) length of end ring joining brackets ";
ssup.erjzdis = 2.0;
// ssup_docum.erjzdis = " dist from ladder ends to ERJ (guess) ";
ssup.erj1x = 0.31;
// ssup_docum.erj1x = " ERJ screw 1 x position (radial) ";
ssup.erj2x = 1.15;
// ssup_docum.erj2x = " ERJ screw 2 x position ";
ssup.erj2y = 0.72;
// ssup_docum.erj2y = " ERJ screw 2 y position ";
ssup.erjrad = 10.80;
// ssup_docum.erjrad = " distance of ERJ center from beam axis ";
ssup.erjdia = 0.17;
// ssup_docum.erjdia = " ERJ screw diameter ";
SSUP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssup
++ssup._index;
ssup.version = 2;
// ssup_docum.version = " geometry version ";
ssup.cabthk = 0.21;
// ssup_docum.cabthk = " thickness of layer of cables on support cone ";
ssup.hosrmn = 0.75;
// ssup_docum.hosrmn = " inner radius of water hoses on support cone ";
ssup.hosrmx = 0.95;
// ssup_docum.hosrmx = " outer radius of water hoses on support cone ";
ssup.nhoses = 10;
// ssup_docum.nhoses = " number of water hoses ";
ssup.wrpmythk = 0.10;
// ssup_docum.wrpmythk = " thickness of mylar wrap around cone (guess) ";
ssup.wrpalthk = 0.01;
// ssup_docum.wrpalthk = " thickness of Al on mylar wrap (guess) ";
ssup.grphthk = 0.16;
// ssup_docum.grphthk = " support cone thickness ";
ssup.cone1zmn = 52.23;
// ssup_docum.cone1zmn = " Cone z min (parts 1,2,3,4 in increasing z) ";
ssup.rodlen = 110.8;
// ssup_docum.rodlen = " Length of support rods ";
ssup.roddist = 17.5;
// ssup_docum.roddist = " Distance of support rod od from beam axis ";
ssup.rodid = 2.5;
// ssup_docum.rodid = " ID of Carbon support rods (approx) ";
ssup.rodod = 3.05;
// ssup_docum.rodod = " OD of Carbon support rods (approx) ";
ssup.con1idmn = 15.67;
// ssup_docum.con1idmn = " Minimum id of cone 1 ";
ssup.con3idmn = 21.67;
// ssup_docum.con3idmn = " Minimum id of cone 3 (TBD) ";
ssup.con4idmn = 37.4;
// ssup_docum.con4idmn = " Minimum id of cone 4 (TBD) ";
ssup.con4idmx = 37.4;
// ssup_docum.con4idmx = " Maximum id of cone 4 (TBD) ";
ssup.cone3zmx = 150.0;
// ssup_docum.cone3zmx = " Maximum z of cone 3 (TBD) ";
ssup.cone4zmx = 229.36;
// ssup_docum.cone4zmx = " Maximum z of cone 4 (TBD) ";
ssup.brathk = .2;
// ssup_docum.brathk = " thickness of Al brackets ";
ssup.erjthk = .1;
// ssup_docum.erjthk = " (z) thickness of end ring joining brackets ";
ssup.erjwid = 2.07;
// ssup_docum.erjwid = " (azimuthal) width of end ring joining brackets ";
ssup.erjlen = 5.19;
// ssup_docum.erjlen = " (radial) length of end ring joining brackets ";
ssup.erjzdis = 2.0;
// ssup_docum.erjzdis = " dist from ladder ends to ERJ (guess) ";
ssup.erj1x = 0.31;
// ssup_docum.erj1x = " ERJ screw 1 x position (radial) ";
ssup.erj2x = 1.15;
// ssup_docum.erj2x = " ERJ screw 2 x position ";
ssup.erj2y = 0.72;
// ssup_docum.erj2y = " ERJ screw 2 y position ";
ssup.erjrad = 10.80;
// ssup_docum.erjrad = " distance of ERJ center from beam axis ";
ssup.erjdia = 0.17;
// ssup_docum.erjdia = " ERJ screw diameter ";
SSUP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssup
++ssup._index;
ssup.version = 3;
// ssup_docum.version = " geometry version ";
ssup.rodlen = 110.8;
// ssup_docum.rodlen = " Length of support rods ";
ssup.roddist = 17.5;
// ssup_docum.roddist = " Distance of support rod od from beam axis ";
ssup.rodid = 3.64;
// ssup_docum.rodid = " ID of Carbon support rods  ";
ssup.rodod = 4.50;
// ssup_docum.rodod = " OD of Carbon support rods  ";
ssup.rodidx = 8.72;
// ssup_docum.rodidx = " ID of Carbon support rods  ";
ssup.rododx = 9.58;
// ssup_docum.rododx = " OD of Carbon support rods  ";
SSUP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssup
++ssup._index;
ssup.version = 4;
// ssup_docum.version = " geometry version ";
ssup.carbonshell = 0.04;
// ssup_docum.carbonshell = " 0.4mm carbon fiber shell ";
ssup.carbondens = 1.78;
// ssup_docum.carbondens = " 1.78 g/cm^3 is a typical carbon composite density ";
ssup.nomexdens = 0.048;
// ssup_docum.nomexdens = " Ballpark figure ";
SSUP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssub
++ssub._index;
ssub.version = 1;
// ssub_docum.version = " geometry version ";
ssub.kmountid = 31.34;
// ssub_docum.kmountid = " id of beampipe support kinematic mount ";
ssub.kmountod = 38.96;
// ssub_docum.kmountod = " od of beampipe support kinematic mount ";
ssub.kmntthk = 0.64;
// ssub_docum.kmntthk = " thickness of support kinematic mount ";
ssub.kmcutod = 18.31;
// ssub_docum.kmcutod = " od of cutout in kinematic mount ";
ssub.kmcutid = 14;
// ssub_docum.kmcutid = " id of cutout in kinematic mount ";
ssub.kmcutoa = 38;
// ssub_docum.kmcutoa = " opening angle of cutout ";
ssub.kmcutoff = 26.58;
// ssub_docum.kmcutoff = " offset of cutout center from axis ";
ssub.sringid = 8.47;
// ssub_docum.sringid = " id of beampipe support ring ";
ssub.sringod = 12.78;
// ssub_docum.sringod = " od of beampipe support ring ";
ssub.sringthk = 0.64;
// ssub_docum.sringthk = " thichkness of beampipe support ring ";
ssub.srcutphi = 38;
// ssub_docum.srcutphi = " support ring cutout angle to z-axis ";
ssub.srcutwid = 3.63;
// ssub_docum.srcutwid = " support ring cutout width ";
ssub.srcutout = 5.08;
// ssub_docum.srcutout = " support ring cutout depth ";
ssub.srcutin = 3.5;
// ssub_docum.srcutin = " support ring cutout start ";
ssub.srollid = 0.2;
// ssub_docum.srollid = " support roller Id ";
ssub.srollod = 0.62;
// ssub_docum.srollod = " support roller Od ";
ssub.srolllen = 2.54;
// ssub_docum.srolllen = " support roller length ";
ssub.swirelen = 5.08;
// ssub_docum.swirelen = " support roller axis length ";
ssub.mblkhgh = 0.97;
// ssub_docum.mblkhgh = " mounting block height ";
ssub.mblkowid = 2.54;
// ssub_docum.mblkowid = " outer mounting block width ";
ssub.mblkolen = 1.27;
// ssub_docum.mblkolen = " outer mounting block length ";
ssub.mblkiwid = 3.175;
// ssub_docum.mblkiwid = " inner mounting block width ";
ssub.mblkilen = 1.27;
// ssub_docum.mblkilen = " inner mounting block length ";
ssub.mblkorad = 17.4;
// ssub_docum.mblkorad = " outer mounting block at radius ";
ssub.mblkirad = 5.42;
// ssub_docum.mblkirad = " inner mounting block at radius ";
ssub.mroddia = 0.32;
// ssub_docum.mroddia = " mounting support rod diameter ";
SSUB.fill();
        
             /// Loop on i from 1 to 4 step=1        
             for ( i=1; (1>0)? (i<=4):(i>=4); i+=1 )        
             {           
                   rad_cones_in(i)=8.5+2.60*(i-1);           
                   rad_cones_out(i)=15.0+0.85*(i-1);           
             }        
             /// USE svtg _index=1;        
             SVTG.use( __svtg__index__ = 1 );
        
             /// USE ssup version=svtg.conever;        
             SSUP.use( __ssup_version__ = svtg.conever );
        
             /// USE ssub _index=1;        
             SSUB.use( __ssub__index__ = 1 );
        
             /// Component Si	a=28.08	z=14	w=0.6*1*28./60.        
             /// Component O	a=16	z=8	w=0.6*2*16./60. + 0.4*4*16./174.        
             /// Component C	a=12	z=6	w=0.4*8*12./174.        
             /// Component H	a=1	z=1	w=0.4*14*1./174.        
             /// Mixture G10 dens=1.7        
             {  AgMaterial &mix = AgMaterial::Get("G10");           
                   mix.Component("Si",28.08,14,0.6*1*28./60.);           
                   mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);           
                   mix.Component("C",12,6,0.4*8*12./174.);           
                   mix.Component("H",1,1,0.4*14*1./174.);           
                   mix.par("dens")=1.7;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("SCON");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SCON           
                   Create("SCON");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SCON");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SCON to mother CAVE           
                   _stacker -> Position( AgBlock::Find("SCON"), place );           
             } // end placement of SCON        
             _create = AgCreate("SCON");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SCON           
                   Create("SCON");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SCON");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SCON to mother CAVE           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("SCON"), place );           
             } // end placement of SCON        
             _create = AgCreate("SROD");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SROD           
                   Create("SROD");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SROD");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SROD to mother CAVE           
                   place.TranslateY(ssup.roddist+ssup.rodod/2);           
                   /// Translate y = ssup.roddist+ssup.rodod/2           
                   _stacker -> Position( AgBlock::Find("SROD"), place );           
             } // end placement of SROD        
             {           
                   AgPosition  place;           
                   place.SetBlock("SROD");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SROD to mother CAVE           
                   place.TranslateY(-ssup.roddist-ssup.rodod/2);           
                   /// Translate y = -ssup.roddist-ssup.rodod/2           
                   _stacker -> Position( AgBlock::Find("SROD"), place );           
             } // end placement of SROD        
             _create = AgCreate("SBSP");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SBSP           
                   Create("SBSP");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SBSP");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SBSP to mother CAVE           
                   place.TranslateZ((ssup.rodlen/2-ssub.kmntthk/2));           
                   /// Translate z = (ssup.rodlen/2-ssub.kmntthk/2)           
                   _stacker -> Position( AgBlock::Find("SBSP"), place );           
             } // end placement of SBSP        
             _create = AgCreate("SBSP");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SBSP           
                   Create("SBSP");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SBSP");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SBSP to mother CAVE           
                   place.TranslateZ(-(ssup.rodlen/2-ssub.kmntthk/2));           
                   /// Translate z = -(ssup.rodlen/2-ssub.kmntthk/2)           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("SBSP"), place );           
             } // end placement of SBSP        
       }; // SCONGEO     
 }; // namespace SCONGEO  
 