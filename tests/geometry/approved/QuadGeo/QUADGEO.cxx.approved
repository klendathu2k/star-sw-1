    // ----------------------------------------------------------------------- geoctr
       void QUADGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup QUADGEO_revision        
             ///@{           
                   /// Created:   02-Sep-2005             
             ///@}        
             ///@addtogroup QUADGEO_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             AddBlock("MGMT", MGMT::Instance());        
             AddBlock("DZER", DZER::Instance());        
             AddBlock("QONE", QONE::Instance());        
             AddBlock("QTWO", QTWO::Instance());        
             AddBlock("QTHR", QTHR::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill shlq
++shlq._index;
shlq.version = 1;
// shlq_docum.version = " geometry version   ";
shlq.q0 = 2485.26;
// shlq_docum.q0 = " offset point that corresponds to 1505.92 in CAD notation, end of D0 ";
shlq.motherr = 19;
// shlq_docum.motherr = " radius of the mother containing D0,Q1,Q2,Q3 ";
shlq.motherl = 1610;
// shlq_docum.motherl = " length of the mother containing D0,Q1,Q2,Q3 ";
shlq.xoffset = 26;
// shlq_docum.xoffset = " Offset ot the mother ";
shlq.angle = 0.3;
// shlq_docum.angle = " Angle to the symmetry axis ";
shlq.dzerol = 385.26;
// shlq_docum.dzerol = " D0 length ";
shlq.dzerori = 4.775;
// shlq_docum.dzerori = " D0 inner radius ";
shlq.dzeroro = 15.995;
// shlq_docum.dzeroro = " D0 outer radius ";
shlq.q1 = 88.59;
// shlq_docum.q1 = " offset 1 ";
shlq.ri1 = 6.355;
// shlq_docum.ri1 = " inner 1 ";
shlq.ro1 = 18.28;
// shlq_docum.ro1 = " outer 1 ";
shlq.dz1 = 170.92;
// shlq_docum.dz1 = " full length 1 ";
shlq.q2 = 324.90;
// shlq_docum.q2 = " offset 2 ";
shlq.ri2 = 6.355;
// shlq_docum.ri2 = " inner 2 ";
shlq.ro2 = 18.28;
// shlq_docum.ro2 = " outer 2 ";
shlq.dz2 = 444.02;
// shlq_docum.dz2 = " full length 2 ";
shlq.q3 = 823.94;
// shlq_docum.q3 = " offset 3 ";
shlq.ri3 = 6.355;
// shlq_docum.ri3 = " inner 3 ";
shlq.ro3 = 18.28;
// shlq_docum.ro3 = " outer 3 ";
shlq.dz3 = 399.55;
// shlq_docum.dz3 = " full length 3 ";
SHLQ.fill();
        
             /// USE shlq _index=1;        
             SHLQ.use( __shlq__index__ = 1 );
        
             zquad=shlq.q0-shlq.dzerol+shlq.motherl/2.0;        
             _create = AgCreate("MGMT");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create MGMT           
                   Create("MGMT");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("MGMT");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MGMT to mother CAVE           
                   place.TranslateX(shlq.xoffset);           
                   /// Translate x = shlq.xoffset           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(zquad);           
                   /// Translate z = zquad           
                   place.AlphaY(shlq.angle);           
                   /// Rotate: AlphaY = shlq.angle           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("MGMT"), place );           
             } // end placement of MGMT        
             {           
                   AgPosition  place;           
                   place.SetBlock("MGMT");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MGMT to mother CAVE           
                   place.TranslateX(-shlq.xoffset);           
                   /// Translate x = -shlq.xoffset           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(zquad);           
                   /// Translate z = zquad           
                   place.AlphaY(-shlq.angle);           
                   /// Rotate: AlphaY = -shlq.angle           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("MGMT"), place );           
             } // end placement of MGMT        
             {           
                   AgPosition  place;           
                   place.SetBlock("MGMT");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MGMT to mother CAVE           
                   place.TranslateX(shlq.xoffset);           
                   /// Translate x = shlq.xoffset           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(-zquad);           
                   /// Translate z = -zquad           
                   place.AlphaY(180-shlq.angle);           
                   /// Rotate: AlphaY = 180-shlq.angle           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("MGMT"), place );           
             } // end placement of MGMT        
             {           
                   AgPosition  place;           
                   place.SetBlock("MGMT");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MGMT to mother CAVE           
                   place.TranslateX(-shlq.xoffset);           
                   /// Translate x = -shlq.xoffset           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(-zquad);           
                   /// Translate z = -zquad           
                   place.AlphaY(180+shlq.angle);           
                   /// Rotate: AlphaY = 180+shlq.angle           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("MGMT"), place );           
             } // end placement of MGMT        
       }; // QUADGEO     
 }; // namespace QUADGEO  
 