      MODULE TutrGeo4   Tutorial Geometry 1
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author A.N. Author
      Created Today
      +CDE,agecom,gcunit,gconst..
      CONTENT TUTR, ABOX, ATUB, ATBS, ACON, ACNS, APCN, APGN, APAR, AELT
      CREATE TUTR
      CALL AgsReset 
      CALL agml_position_begin('TUTR') 
      %mother = 'CAVE' 
      %title = 'TUTR' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- TUTR
      BLOCK TUTR   Main volume in the AGML tutorial geometry
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE None seen=0
      SHAPE box dx=500.0 dy=500.0 dz=500.0
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE ATUB
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 25.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE ATBS
      CALL AgsReset 
      CALL agml_position_begin('ATBS') 
      %title = 'ATBS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 50.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE ACON
      CALL AgsReset 
      CALL agml_position_begin('ACON') 
      %title = 'ACON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -25.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE ACNS
      CALL AgsReset 
      CALL agml_position_begin('ACNS') 
      %title = 'ACNS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -50.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE APCN
      CALL AgsReset 
      CALL agml_position_begin('APCN') 
      %title = 'APCN' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -12.5 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE APGN
      CALL AgsReset 
      CALL agml_position_begin('APGN') 
      %title = 'APGN' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 12.5 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE APAR
      CALL AgsReset 
      CALL agml_position_begin('APAR') 
      %title = 'APAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -37.5 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE AELT
      CALL AgsReset 
      CALL agml_position_begin('AELT') 
      %title = 'AELT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 37.5 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ABOX
      BLOCK ABOX   A volume which is a box in the tutorial
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=10 dy=10 dz=10
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ATUB
      BLOCK ATUB   A TUBE with innner and outer radius
      ATTRIBUTE ATUB seen=1 colo=3
      SHAPE tube rmin=5.0 rmax=10.0 dz=12.5
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ATBS
      BLOCK ATBS   A TUBE segment with innner and outer radius... and limits in phi
      ATTRIBUTE ATBS seen=1 colo=3
      SHAPE tubs rmin=5.0 rmax=10.0 phi1=-120.0,
            phi2=+120.0 dz=12.5
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ACON
      BLOCK ACON   A CONE with innner and outer radius
      ATTRIBUTE ACON seen=1 colo=5
      SHAPE cone dz=12.5 rmn1=0.0 rmx1=10.0 rmn2=0.0,
            rmx2=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ACNS
      BLOCK ACNS   A CONE segment with innner and outer radius... and limits in phi
      ATTRIBUTE ACNS seen=1 colo=5
      SHAPE cons dz=12.5 rmn1=0.0 rmx1=10.0 rmn2=0.0,
            rmx2=0.0 phi1=-120.0 phi2=+120.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APCN
      BLOCK APCN   A polycone
      ATTRIBUTE APCN seen=1 colo=7
      SHAPE pcon phi1=0 dphi=360 nz=5 zi={0.,3.0,
            5.0,15.0,20.0} rmn={0,0,0,0,0} rmx={2.5,5.0,
            2.5,7.5,5.0}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APGN
      BLOCK APGN   A polygon
      ATTRIBUTE APGN seen=1 colo=7
      SHAPE pgon phi1=0 dphi=360 npdiv=6 nz=5,
            zi={0.,3.0,5.0,15.0,20.0} rmn={1.5,4.0,1.5,6.5,
            4.0} rmx={2.5,5.0,2.5,7.5,5.0}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- APAR
      BLOCK APAR   A parallelpiped
      ATTRIBUTE APAR seen=1 colo=9
      SHAPE para dx=10.0 dy=8.0 dz=20.0 alph=15.0,
            thet=10.0 phi=5.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- AELT
      BLOCK AELT   An elliptical tube
      ATTRIBUTE AELT seen=1 colo=3
      SHAPE eltu p1=10 p2=15 dz=20
      ENDBLOCK
      <W> '===>> 	[End AgML Module TutrGeo4]	 <<==='; (A32,/,/);
      END! Module TutrGeo4
