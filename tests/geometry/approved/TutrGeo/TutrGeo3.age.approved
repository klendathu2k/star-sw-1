      MODULE TutrGeo3   Tutorial Geometry 1
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author A.N. Author
      Created Today
      +CDE,agecom,gcunit,gconst..
      CONTENT TUTR, ABOX, ATUB
      real *4 boxDX/10.0/, boxDY/10.0/, boxDZ/10.0/

      STRUCTURE TUBG { int version,rmin,rmax,dz}
      FILL TUBG		! Dimensions of the first tube
      version = 1 ! 1st tube
      rmin = 0 ! no hole
      rmax = 5 ! 5cm
      dz = 10 ! 10cm
      ENDFILL
      FILL TUBG		! Dimensions of the stubd tube
      version = 2 ! 2nd tube
      rmin = 2.5 ! a hole
      rmax = 7.5 ! 7.5cm
      dz = 10 ! 10cm
      ENDFILL
      FILL TUBG		! Dimensions of the third tube
      version = 2 ! 3rd tube
      rmin = 5.0 ! a hole
      rmax = 10.0 ! 10cm
      dz = 15 ! 15cm
      ENDFILL
      CREATE TUTR
      CALL AgsReset 
      CALL agml_position_begin('TUTR') 
      %mother = 'CAVE' 
      %title = 'TUTR' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- TUTR
      BLOCK TUTR   Main volume in the AGML tutorial geometry
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE None seen=0
      SHAPE box dx=500.0 dy=500.0 dz=500.0
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      boxDY=15.0;
      boxDZ= 5.0;
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 25.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      boxDY=5.0;
      boxDZ=5.0;
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 50.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      boxDY=15.0;
      boxDZ= 5.0;
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -25.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      boxDY=5.0;
      boxDZ=5.0;
      CREATE ABOX
      CALL AgsReset 
      CALL agml_position_begin('ABOX') 
      %title = 'ABOX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -50.0 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use TUBG version=1
      CREATE ATUB
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use TUBG version=2
      CREATE ATUB
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 25.0 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -25.0 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      use TUBG version=3
      CREATE ATUB
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 50.0 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('ATUB') 
      %title = 'ATUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = -50.0 
      CALL agml_translate_x( %x ) 
      ag_y = -25.0 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ABOX
      BLOCK ABOX   A volume which is a box in the tutorial
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=boxDX dy=boxDY dz=boxDZ
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ATUB
      BLOCK ATUB   A volume which is a tube in the tutorial
      ATTRIBUTE None seen=1 colo=5
      SHAPE tube rmin=TUBG_rmin rmax=TUBG_rmax,
            dz=TUBG_dz
      ENDBLOCK
      <W> '===>> 	[End AgML Module TutrGeo3]	 <<==='; (A32,/,/);
      END! Module TutrGeo3
