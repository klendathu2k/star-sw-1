      MODULE ShapGeo   Shapes Geometry : places AgML shapes into the cave
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author Jason C. Webb
      Created 11/01/2011
      +CDE,agecom,gcunit,gconst.
      CONTENT BBOX,PARA,TRDA,TRDB,TRAP,SPHE,TUBE,TUBS,CONE,CONS,ELTU,PCON,PGON,CTUB,
            GTRA
      real *4 x/-150.0/, dx/75.0/, y/-30.0/

      Integer *4 icolor/27/

      x=-150.0
      y=-30;
      CREATE BBOX
      CALL AgsReset 
      CALL agml_position_begin('BBOX') 
      %title = 'BBOX' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE PARA
      CALL AgsReset 
      CALL agml_position_begin('PARA') 
      %title = 'PARA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE TRDA
      CALL AgsReset 
      CALL agml_position_begin('TRDA') 
      %title = 'TRDA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE TRDB
      CALL AgsReset 
      CALL agml_position_begin('TRDB') 
      %title = 'TRDB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE TRAP
      CALL AgsReset 
      CALL agml_position_begin('TRAP') 
      %title = 'TRAP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE SPHE
      CALL AgsReset 
      CALL agml_position_begin('SPHE') 
      %title = 'SPHE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE TUBE
      CALL AgsReset 
      CALL agml_position_begin('TUBE') 
      %title = 'TUBE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE TUBS
      CALL AgsReset 
      CALL agml_position_begin('TUBS') 
      %title = 'TUBS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      x=-150.0
      y=+30.0
      CREATE CTUB
      CALL AgsReset 
      CALL agml_position_begin('CTUB') 
      %title = 'CTUB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE ELTU
      CALL AgsReset 
      CALL agml_position_begin('ELTU') 
      %title = 'ELTU' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE CONE
      CALL AgsReset 
      CALL agml_position_begin('CONE') 
      %title = 'CONE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE CONS
      CALL AgsReset 
      CALL agml_position_begin('CONS') 
      %title = 'CONS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE PCON
      CALL AgsReset 
      CALL agml_position_begin('PCON') 
      %title = 'PCON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE PGON
      CALL AgsReset 
      CALL agml_position_begin('PGON') 
      %title = 'PGON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      CREATE GTRA
      CALL AgsReset 
      CALL agml_position_begin('GTRA') 
      %title = 'GTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x+=dx;
      ! ---------------------------------------------------------------------------------- BBOX
      BLOCK BBOX   A box / TGeoBBox
      ATTRIBUTE BBOX colo=icolor
      icolor + =1
      SHAPE box dx=20 dy=20 dz=40
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PARA
      BLOCK PARA   A parallelpiped TGeoPara
      ATTRIBUTE PARA colo=icolor
      icolor + =1
      SHAPE para dx=20 dy=20 dz=40 alph=20 thet=20,
            phi=45
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- TRDA
      BLOCK TRDA   A trapezoid TGeoTrd1
      ATTRIBUTE TRDA colo=icolor
      icolor + =1
      SHAPE trd1 dx1=10 dx2=20 dy=30 dz=40
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- TRDB
      BLOCK TRDB   A trapezoid TGeoTrd2
      ATTRIBUTE TRDB colo=icolor
      icolor + =1
      SHAPE trd2 dx1=10 dx2=20 dy1=30 dy2=10 dz=40
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- TRAP
      BLOCK TRAP   A trapezoid TGeoTrap
      ATTRIBUTE TRAP colo=icolor
      icolor + =1
      SHAPE trap dz=40 thet=15 phi=30 h1=20 bl1=10,
            tl1=15 alp1=0.0 h2=20 bl2=10 tl2=15 alp2=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GTRA
      BLOCK GTRA   A trapezoid TGeoGtra
      ATTRIBUTE GTRA colo=icolor
      icolor + =1
      SHAPE gtra dz=40 thet=15 phi=30 twis=30,
            h1=20 bl1=10 tl1=15 alp1=0.0 h2=20 bl2=10 tl2=15,
            alp2=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SPHE
      BLOCK SPHE   A sphere
      ATTRIBUTE SPHE colo=icolor
      icolor + =1
      SHAPE sphe rmin=18.0 rmax=20.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- TUBE
      BLOCK TUBE   A box
      ATTRIBUTE TUBE colo=icolor
      icolor + =1
      SHAPE tube rmin=5.0 rmax=10.0 dz=15
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- TUBS
      BLOCK TUBS   A box
      ATTRIBUTE TUBS colo=icolor
      icolor + =1
      SHAPE tubs rmin=5.0 rmax=10.0 phi1=-120.0,
            phi2=+120.0 dz=15
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CTUB
      BLOCK CTUB   A box
      ATTRIBUTE CTUB colo=icolor
      icolor + =1
      SHAPE ctub rmin=5.0 rmax=10.0 phi1=-120.0,
            phi2=+120.0 dz=15 hx=1.0 hy=1.0 hz=1.0 lx=0.0,
            ly=0.0 lz=1.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- ELTU
      BLOCK ELTU   An elliptical tube TGeoEltu
      ATTRIBUTE ELTU colo=icolor
      icolor + =1
      SHAPE eltu p1=15.0 p2=10.0 dz=30.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CONE
      BLOCK CONE   A box
      ATTRIBUTE CONE colo=icolor
      icolor + =1
      SHAPE cone dz=40 rmn1=5.0 rmx1=20.0 rmn2=5.0,
            rmx2=7.5
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CONS
      BLOCK CONS   A box
      ATTRIBUTE CONS colo=icolor
      icolor + =1
      SHAPE cons dz=40.0 rmn1=5.0 rmx1=20.0 rmn2=5.0,
            rmx2=7.5 phi1=-120 phi2=+120
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PCON
      BLOCK PCON   A polycone
      ATTRIBUTE PCON colo=icolor
      icolor + =1
      SHAPE pcon phi1=0 dphi=360 nz=5 zi={-20.,
            -5.0,10.0,15.0,20.0} rmn={0,0,0,0,0} rmx={15.0,
            15.0,8.0,12.0,15.0}
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PGON
      BLOCK PGON   A polygon
      ATTRIBUTE PGON colo=icolor
      icolor + =1
      SHAPE pgon phi1=0 dphi=360 npdiv=6 nz=5,
            zi={-20.,-5.0,10.0,15.0,20.0} rmn={12.0,12.0,
            5.0,9.0,12.0} rmx={15.0,15.0,8.0,12.0,15.0}
      ENDBLOCK
      <W> '===>> 	[End AgML Module ShapGeo]	 <<==='; (A32,/,/);
      END! Module ShapGeo
