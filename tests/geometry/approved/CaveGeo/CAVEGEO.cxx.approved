       CAVEGEO::CAVEGEO()     
         : AgModule("CAVEGEO","  builds CAVE for GSTAR ")     
       {        
       }     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HALL::mInstance = 0;     
          AgBlock *HALL::Instance(){        
                   if ( mInstance==0 ) mInstance = new HALL();        
                   return mInstance;        
          }     
          void HALL::Block( AgCreate create )     
          {         
                ///@addtogroup HALL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=1           
                      /// Component O2	a=16	z=8	w=2           
                      /// Mixture Concrete dens=2.5           
                      {  AgMaterial &mix = AgMaterial::Get("Concrete");              
                            mix.Component("Si",28.08,14,1);              
                            mix.Component("O2",16,8,2);              
                            mix.par("dens")=2.5;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HALL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      d1=cave.rmax[int(1)-1]+cave.dconc;           
                      d2=cave.rmax[int(2)-1]+cave.dconc;           
                      z1=cave.dz[int(1)-1]+cave.dconc;           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=6;              
                            shape.Z(0)=-cave.dz[int(2)-1];              
                            shape.Z(1)=-z1;              
                            shape.Z(2)=-z1;              
                            shape.Z(3)=z1;              
                            shape.Z(4)=z1;              
                            shape.Z(5)=cave.dz[int(2)-1];              
                            shape.Rmin(0)=cave.rmin;              
                            shape.Rmin(1)=cave.rmin;              
                            shape.Rmin(2)=cave.rmin;              
                            shape.Rmin(3)=cave.rmin;              
                            shape.Rmin(4)=cave.rmin;              
                            shape.Rmin(5)=cave.rmin;              
                            shape.Rmax(0)=d2;              
                            shape.Rmax(1)=d2;              
                            shape.Rmax(2)=d1;              
                            shape.Rmax(3)=d1;              
                            shape.Rmax(4)=d2;              
                            shape.Rmax(5)=d2;              
                            /// Shape Pcon phi1=0 dphi=360 nz=6               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HALL;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("CAVE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create CAVE              
                            Create("CAVE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("CAVE");              
                            place.SetMother("HALL");              
                            /// Add daughter volume CAVE to mother HALL              
                            _stacker -> Position( AgBlock::Find("CAVE"), place );              
                      } // end placement of CAVE           
                      END_OF_HALL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HALL     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *CAVE::mInstance = 0;     
          AgBlock *CAVE::Instance(){        
                   if ( mInstance==0 ) mInstance = new CAVE();        
                   return mInstance;        
          }     
          void CAVE::Block( AgCreate create )     
          {         
                ///@addtogroup CAVE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      /// Medium something           
                      ///  stemax = 100            
                      {  AgMedium &med = AgMedium::Get("Something");              
                               med.Inherit(this);              
                            med.par("stemax")=100;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("CAVE");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.Z(0)=-cave.dz[int(2)-1];              
                            shape.Z(1)=-cave.dz[int(1)-1];              
                            shape.Z(2)=-cave.dz[int(1)-1];              
                            shape.Z(3)=+cave.dz[int(1)-1];              
                            shape.Z(4)=+cave.dz[int(1)-1];              
                            shape.Z(5)=+cave.dz[int(2)-1];              
                            shape.Rmax(0)=+cave.rmax[int(2)-1];              
                            shape.Rmax(1)=+cave.rmax[int(2)-1];              
                            shape.Rmax(2)=+cave.rmax[int(1)-1];              
                            shape.Rmax(3)=+cave.rmax[int(1)-1];              
                            shape.Rmax(4)=+cave.rmax[int(2)-1];              
                            shape.Rmax(5)=+cave.rmax[int(2)-1];              
                            /// Shape Pcon phi1=0 dphi=360               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CAVE;              
                            _stacker -> Build(this);              
                      }           
                      if ( cvcf.tpcrefsys!=0 )           
                      {              
                            { AddGroup("TpcRefSys"); }              
                      }           
                      END_OF_CAVE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CAVE     
