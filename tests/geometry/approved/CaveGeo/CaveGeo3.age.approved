      MODULE CaveGeo3   STAR Wide Angle Hall Geometry.
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author Jason Webb, Yuri Fisyak
      Created May 2013
      +CDE,agecom, gcunit.
      CONTENT HALL, CAVE, WALL, HOLE, SHLD, CRAT, MGWP, MGWT
      STRUCTURE CVCF { version,int config,int tpcrefsys}
      STRUCTURE CAVE { version,Rmin,Rmax(2),Dz(2),Dconc}
      STRUCTURE CDIM { Version,Dceiling,Dfloor,Dnorth,Dsouth,ThickCeil,Rmax,Dz}
      STRUCTURE TDIM { Version,Dceiling,Dfloor,Dnorth,Dsouth,Rmax,Dz}
      STRUCTURE SHLD { Version,xwidth(4),ywidth(4),zwidth(4)}
      real *4 D1,D2,D3,Z1, wall_xx, wall_yy, wall_zz, wall_dx, wall_dy, wall_dz

      Integer *4 i, j, k

      FILL CVCF		! CAVE CONFIGURATION
      version = 5 !   version
      config = 1 !   default config
      ENDFILL
      FILL CAVE		! Star CAVE Geometry
      version = 5 !  version
      Rmin = 0 !  Inner radius of cave had better be zero
      Rmax  = {  1575.02,   329.95} !   furthest distance to a concrete wall 
      Dz  = {  807.72,  2020.0} !   Dz(1) is distance to east/west wall from center of STAR, Dz(2) depth into tunnels 
      Dconc = 91.44 !  concrete thickness 36inches
      ENDFILL
      FILL CAVE		! Star CAVE Geometry
      version = 6 !  version
      Rmin = 0 !  Inner radius of cave had better be zero
      Rmax  = {  1575.02,   329.95} !   furthest distance to a concrete wall 
      Dz  = {  807.72,  2020.0} !   Dz(1) is distance to east/west wall from center of STAR, Dz(2) depth into tunnels 
      Dconc = 91.44 !  concrete thickness 36inches
      ENDFILL
      FILL CDIM		! Cave Dimensions
      version = 1.000 !  version
      Dceiling = 2*170.0 *2.54 !  dist from beam to ceiling ... FAKE
      Dfloor = 169.75 *2.54 !  dist from beam to floor
      Dnorth = 481.9 *2.54 !  dist from beam to the north (shield) wall
      Dsouth = 620.1 *2.54 !  dist from beam to south wall
      ThickCeil = 20 !  thickness of ceiling
      ENDFILL
      FILL TDIM		! Tunnel Dimensions
      version = 1.000 !  version
      Dceiling = 14.0 *12.0*2.54-50.0 *2.54 !  dist from beam to ceiling
      Dfloor = 50.0 *2.54 !  dist from beam to floor
      Dnorth = 329.95 !  dist from beam to the north wall
      Dsouth = 279.65 !  dist from beam to south wall
      ENDFILL
      FILL SHLD		! shield dimensions
      version = 1.000 !  version
      xwidth  = {  48.0 *2.54,  54.5 *2.54,  45.5 *2.54, 
                   45.1 *2.54} !   x widths 
      ywidth  = {  111. *2.54,  111. *2.54,  111. *2.54, 
                   108. *2.54} !   y widths 
      zwidth  = {  48.0 *2.54,  48.0 *2.54,  48.0 *2.54, 
                   48.0 *2.54} !   z widths 
      ENDFILL
      use CVCF
      use CAVE version=CVCF_config
      use CDIM
      use TDIM
      <W> CVCF_config;  ('CaveGeo Module is called CONFIG=', I3);
      CREATE HALL
      ! ---------------------------------------------------------------------------------- HALL
      BLOCK HALL   The STAR Wide Angle Hall
      COMPONENT Silicon A=28.09 Z=14 W=0.2
      COMPONENT Oxygen A=15.999 Z=8 W=0.5
      COMPONENT Hydrogen A=1.00794 Z=1 W=0.006
      COMPONENT Carbon A=12.011 Z=6 W=0.03
      COMPONENT Sodium A=22.99 Z=11 W=0.01
      COMPONENT Aluminium A=26.98 Z=13 W=0.03
      COMPONENT Potassium A=39.098 Z=19 W=0.01
      COMPONENT Calcium A=40.078 Z=20 W=0.2
      COMPONENT Iron A=55.85 Z=26 W=0.014
      MIXTURE Concrete dens=2.35
      MEDIUM Concrete
      ATTRIBUTE HALL seen=1 colo=3
      D1=cave_Rmax(1) + cave_dconc
      D2=cave_Rmax(2) + cave_dconc
      Z1=cave_dz(1) + cave_dconc
      SHAPE pgon phi1=45 dphi=360 npdiv=4 nz=6,
            zi={-cave_dz(2),-Z1,-Z1,Z1,Z1,cave_dz(2)} rmn={cave_rmin,
            cave_rmin,cave_rmin,cave_rmin,cave_rmin,
            cave_rmin} rmx={D2,D2,D1,D1,D2,D2}
      wall_dx = D1
      wall_dy = cave_dconc/2
      wall_dz = Z1
      wall_yy = D1 - wall_dy
      CREATE HOLE
      CALL AgsReset 
      CALL agml_position_begin('HOLE') 
      %mother = 'HALL' 
      %title = 'HOLE' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE CAVE
      CALL AgsReset 
      CALL agml_position_begin('CAVE') 
      %mother = 'HALL' 
      %title = 'CAVE' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CAVE
      BLOCK CAVE   is GSTAR cave with subsystem envelopes
      MATERIAL Air
      MATERIAL Air isvol=0
      MEDIUM Air
      ATTRIBUTE CAVE seen=1 colo=2
      SHAPE pgon phi1=45 dphi=360 npdiv=4 nz=6,
            zi={-cave_dz(2),-cave_dz(1),-cave_dz(1),+cave_dz(1),
            +cave_dz(1),+cave_dz(2)} rmn={cave_rmin,
            cave_rmin,cave_rmin,cave_rmin,cave_rmin,cave_rmin},
            rmx={+cave_Rmax(2),+cave_Rmax(2),+cave_Rmax(1),
            +cave_Rmax(1),+cave_Rmax(2),+cave_Rmax(2)}
      ! Reference system TpcRefSys ignored
      ! Reference system MagRefSys ignored
      ! Reference system CaveRefSys ignored
      CDIM_Rmax = cave_Rmax(1)
      TDIM_Rmax = cave_Rmax(2)
      CDIM_dz   = cave_dz(1)
      TDIM_dz   = cave_dz(2) - cave_dz(1)
      D1=cave_Rmax(1)
      D2=cave_Rmax(2)
      Z1=cave_dz(1)
      wall_dx = D1
      wall_dy = CDIM_ThickCeil/2
      wall_dz = cave_dz(1)
      D3      = CDIM_Dceiling - wall_dy
      wall_yy = D3
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dy =(D1 - CDIM_Dfloor)/2
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-cave_Rmax(1)+wall_dy) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      D3 = CDIM_Dceiling - CDIM_ThickCeil
      wall_dx = 68*2.54/2
      wall_dy =(D3 + CDIM_Dfloor)/2
      wall_xx = - CDIM_Dnorth + wall_dx
      wall_yy =(D3 - CDIM_Dfloor)/2
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_zz =(cave_dz(2) + cave_dz(1))/2
      wall_dz =(cave_dz(2) - cave_dz(1))/2
      D1 = cave_Rmax(2)
      wall_dx = D1
      wall_dy =(D1 - TDIM_Dceiling)/2
      wall_yy =(D1 + TDIM_Dceiling)/2
      D2 = wall_yy - wall_dy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dy =(D1 - TDIM_Dfloor)/2
      wall_yy =(D1 + TDIM_Dfloor)/2
      D3 = - (wall_yy - wall_dy)
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dy =(D2 - D3)/2
      wall_yy =(D2 + D3)/2
      wall_dx =(TDIM_Dnorth - TDIM_Dsouth)/2
      wall_xx =(TDIM_Dnorth + TDIM_Dsouth)/2
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*shld_xwidth(1)
      wall_dy = 0.5*shld_ywidth(1)
      wall_dz = 0.5*shld_zwidth(1)
      wall_zz = - 221.0*2.54 - wall_dz - cdim_dz
      wall_yy = - tdim_dfloor + wall_dy
      wall_xx = + tdim_dsouth - wall_dx
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*shld_xwidth(2)
      wall_dy = 0.5*shld_ywidth(2)
      wall_dz = 0.5*shld_zwidth(2)
      wall_zz = - 220.0*2.54 - wall_dz - cdim_dz
      wall_yy = - tdim_dfloor + wall_dy
      wall_xx = - tdim_dnorth + wall_dx
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*shld_xwidth(3)
      wall_dy = 0.5*shld_ywidth(3)
      wall_dz = 0.5*shld_zwidth(3)
      wall_zz = + 512.3*2.54 + wall_dz
      wall_yy = - tdim_dfloor + wall_dy
      wall_xx = + tdim_dsouth - wall_dx
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*shld_xwidth(4)
      wall_dy = 0.5*shld_ywidth(4)
      wall_dz = 0.5*shld_zwidth(4)
      wall_zz = + 512.3*2.54 + 144.25*2.54 - 236.0*2.54 + wall_dz
      wall_yy = - tdim_dfloor + wall_dy
      wall_xx = - tdim_dnorth + wall_dx
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*(62.0 + 77.0)*2.54
      wall_dy = 0.5*25.0*2.54
      wall_dz = 0.5*82.0*2.54
      wall_zz = - (538.0 + 120.0)*2.54 - wall_dz
      wall_xx = + 0.5*(77.0 - 62.0)
      wall_yy = - tdim_dfloor + wall_dy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54
      wall_dx = wall_dx                                           ! same dx
      wall_dy = 0.5*(146.0 - 65.0)*2.54
      wall_zz = - (538.0 + 120.0)*2.54 - wall_dz
      wall_xx = wall_xx                                           ! same xx
      wall_yy = - tdim_dfloor + 65.0*2.54 + wall_dy
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx = 0.5*(60.5 + 77.5)*2.54
      wall_dy = 0.5*25.0*2.54
      wall_dz = 0.5*81.0*2.54
      wall_zz =(512.3 + 144.5)*2.54 + wall_dz
      wall_xx = + 0.5*(77.5 - 60.5)
      wall_yy = - tdim_dfloor + wall_dy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54
      wall_dx = wall_dx                                           ! same dx
      wall_dy = 0.5*(145.5 - 65.0)*2.54
      wall_zz =(512.3 + 144.5)*2.54 + wall_dz
      wall_xx = wall_xx                                           ! same xx
      wall_yy = - tdim_dfloor + 65.0*2.54 + wall_dy
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54                             ! exact
      wall_dy = 0.5*(65.0 - 25.0)*2.54                   ! very good approx
      wall_dx = 0.5*(10.0/28.5)*(62. + 77.)*2.54        ! WAG(wild ass guess)
      wall_zz = - (538.0 + 120.0 + 82.0)*2.54 + wall_dz                          _
                           ! exact
      wall_xx = + 4.0*4.877*2.54 + wall_dx                 ! WAG
      wall_yy = - tdim_dfloor + 25.0*2.54 + wall_dy          ! very good approx
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*(82.0 - 45.0)*2.54
      wall_dx = wall_dx
      wall_dy = wall_dy
      wall_zz = - (538.0 + 120.0)*2.54 - wall_dz                                 _
                      ! exact
      wall_xx = wall_xx
      wall_yy = wall_yy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54                             ! exact
      wall_dy = 0.5*(65.0 - 25.0)*2.54                   ! very good approx
      wall_dx = 0.5*(7.0/28.5)*(62. + 77.)*2.54         ! WAG(wild ass guess)
      wall_zz = - (538.0 + 120.0 + 82.0)*2.54 + wall_dz      ! exact
      wall_xx = - 4.0*4.877*2.54 - wall_dx                 ! WAG
      wall_yy = - tdim_dfloor + 25.0*2.54 + wall_dy          ! very good approx
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*(82.0 - 45.0)*2.54
      wall_dx = wall_dx
      wall_dy = wall_dy
      wall_zz = - (538.0 + 120.0)*2.54 - wall_dz               ! exact
      wall_xx = wall_xx
      wall_yy = wall_yy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
