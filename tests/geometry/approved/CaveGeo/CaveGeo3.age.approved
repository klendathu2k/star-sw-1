      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WALL
      BLOCK WALL   is the floor (or bottom) of the cave
      COMPONENT Si A=28.08 Z=14 W=1
      COMPONENT O2 A=16 Z=8 W=2
      MIXTURE Concrete dens=2.5
      MEDIUM Concrete
      ATTRIBUTE WALL seen=0 colo=3
      SHAPE box dx=wall_dx dy=wall_dy dz=wall_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SHLD
      BLOCK SHLD   is the shielding
      MATERIAL Iron
      MATERIAL Iron isvol=0
      MEDIUM Iron
      ATTRIBUTE SHLD seen=0 colo=2
      SHAPE box dx=wall_dx dy=wall_dy dz=wall_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HOLE
      BLOCK HOLE   is the floor (or bottom) of the cave
      MATERIAL Air
      MATERIAL Air isvol=0
      MEDIUM Air
      ATTRIBUTE HOLE seen=0 colo=5
      SHAPE box dx=wall_dx dy=wall_dy dz=wall_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- CRAT
      BLOCK CRAT   is the electronics crate
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      COMPONENT O A=16 Z=8 W=0.4*4*16./174.
      MIXTURE Electroncs dens=0.13
      MEDIUM Electronics
      ATTRIBUTE CRAT seen=0 colo=6
      SHAPE box dx=wall_dx dy=wall_dy dz=wall_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MGWP
      BLOCK MGWP   is the magnet water pipe
      MATERIAL Iron
      MEDIUM Iron
      ATTRIBUTE WGWP seen=0 colo=6
      SHAPE tube rmin=0 rmax=12 dz=312
      CREATE MGWT
      CALL AgsReset 
      CALL agml_position_begin('MGWT') 
      %title = 'MGWT' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MGWT
      BLOCK MGWT   is the water in magnet water pipe
      COMPONENT H2 A=1 Z=1 W=2
      COMPONENT O A=16 Z=8 W=1
      MIXTURE Water dens=1.0
      MEDIUM Water
      ATTRIBUTE MGWT seen=0 colo=6
      SHAPE tube rmin=0 rmax=10 dz=310
      ENDBLOCK
