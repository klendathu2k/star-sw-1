      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54                             ! exact
      wall_dy = 0.5*(65.0 - 25.0)*2.54                   ! very good approx
      wall_dx = 0.5*(10.0/28.5)*(62. + 77.)*2.54        ! WAG(wild ass guess)
      wall_zz = + (512.3 + 144.25 + 81.0)*2.54 - wall_dz     ! exact
      wall_xx = + 4.0*4.877*2.54 + wall_dx                 ! WAG
      wall_yy = - tdim_dfloor + 25.0*2.54 + wall_dy          ! very good approx
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*(81.0 - 45.0)*2.54
      wall_dx = wall_dx
      wall_dy = wall_dy
      wall_zz = + (512.3 + 144.25 + (81.0 - 45.0))*2.54 - wall_dz                _
                                       ! exact
      wall_xx = wall_xx
      wall_yy = wall_yy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*45.0*2.54                             ! exact
      wall_dy = 0.5*(65.0 - 25.0)*2.54                   ! very good approx
      wall_dx = 0.5*(7.0/28.5)*(62. + 77.)*2.54                     ! WAG(wild ass guess)
      wall_zz = + (512.3 + 144.25 + 81.0)*2.54 - wall_dz                         _
                            ! exact
      wall_xx = - 4.0*4.877*2.54 - wall_dx                  ! WAG
      wall_yy = - tdim_dfloor + 25.0*2.54 + wall_dy          ! very good approx
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dz = 0.5*(81.0 - 45.0)*2.54
      wall_dx = wall_dx
      wall_dy = wall_dy
      wall_zz = + (512.3 + 144.25 + (81.0 - 45.0))*2.54 - wall_dz                _
                                       ! exact
      wall_xx = wall_xx
      wall_yy = wall_yy
      CREATE WALL
      CALL AgsReset 
      CALL agml_position_begin('WALL') 
      %mother = 'CAVE' 
      %title = 'WALL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      D1 = 415  ! ExtMuDTRadius
      D2 = 1000 ! CELQ_EndOfPlatform
      D3 = 5    ! CELQ_thick/2
      wall_dx =(D2 - D1)/2
      wall_xx =(D2 + D1)/2
      wall_dy =  D3/2
      wall_dz =  500  ! CELQ_dz
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-150-D3/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(150-D3/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      D1 = 415  ! ExtMuDTRadius
      D2 = 600  ! CELQ_EndOfPlatform
      wall_dx =(D2 - D1)/2
      wall_xx =(D2 + D1)/2
      CREATE SHLD
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-150-D3/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('SHLD') 
      %mother = 'CAVE' 
      %title = 'SHLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(150-D3/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      wall_dx =  40
      wall_dy = 120
      wall_dz =  60
      CREATE CRAT
      DO i = 1, 2
      wall_yy = -150 + 300*(i-1) + wall_dy
      DO j = 1, 2
      wall_xx = 600 + 300*(j-1)
      DO k = 1, 8
      wall_zz = -260 + 65*(k-1)
      CALL AgsReset 
      CALL agml_position_begin('CRAT') 
      %mother = 'CAVE' 
      %title = 'CRAT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(wall_yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(wall_zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      END DO
      END DO
      CREATE MGWP
      DO i = 1, 2
      wall_xx = (2*i-3)*450
      DO j = 1, 2
      wall_yy = (2*j-3)*100
      CALL AgsReset 
      CALL agml_position_begin('MGWP') 
      %mother = 'CAVE' 
      %title = 'MGWP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(wall_xx) 
