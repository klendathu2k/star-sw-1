                      {              
                            wall_xx=(2*i-3)*450;              
                            /// Loop on j from 1 to 2 step=1              
                            for ( j=1; (1>0)? (j<=2):(j>=2); j+=1 )              
                            {                 
                                  wall_yy=(2*j-3)*100;                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("MGWP");                    
                                        place.SetMother("CAVE");                    
                                        /// Add daughter volume MGWP to mother CAVE                    
                                        place.TranslateX(wall_xx);                    
                                        /// Translate x = wall_xx                    
                                        place.TranslateY(wall_yy);                    
                                        /// Translate y = wall_yy                    
                                        _stacker -> Position( AgBlock::Find("MGWP"), place );                    
                                  } // end placement of MGWP                 
                            }              
                      }           
                      END_OF_CAVE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CAVE     
