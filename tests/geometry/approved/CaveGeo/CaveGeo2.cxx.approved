                      for ( i=1; (1>0)? (i<=2):(i>=2); i+=1 )           
                      {              
                            wall_yy=-150+300*(i-1)+wall_dy;              
                            /// Loop on j from 1 to 2 step=1              
                            for ( j=1; (1>0)? (j<=2):(j>=2); j+=1 )              
                            {                 
                                  wall_xx=600+300*(j-1);                 
                                  /// Loop on k from 1 to 8 step=1                 
                                  for ( k=1; (1>0)? (k<=8):(k>=8); k+=1 )                 
