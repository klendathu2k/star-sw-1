          void HALL::Block( AgCreate create )     
          {         
                ///@addtogroup HALL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Silicon	a=28.09	z=14	w=0.2           
                      /// Component Oxygen	a=15.999	z=8	w=0.5           
                      /// Component Hydrogen	a=1.00794	z=1	w=0.006           
                      /// Component Carbon	a=12.011	z=6	w=0.03           
                      /// Component Sodium	a=22.99	z=11	w=0.01           
                      /// Component Aluminium	a=26.98	z=13	w=0.03           
                      /// Component Potassium	a=39.098	z=19	w=0.01           
                      /// Component Calcium	a=40.078	z=20	w=0.2           
                      /// Component Iron	a=55.85	z=26	w=0.014           
                      /// Mixture Concrete dens=2.35           
                      {  AgMaterial &mix = AgMaterial::Get("Concrete");              
                            mix.Component("Silicon",28.09,14,0.2);              
                            mix.Component("Oxygen",15.999,8,0.5);              
                            mix.Component("Hydrogen",1.00794,1,0.006);              
                            mix.Component("Carbon",12.011,6,0.03);              
                            mix.Component("Sodium",22.99,11,0.01);              
                            mix.Component("Aluminium",26.98,13,0.03);              
                            mix.Component("Potassium",39.098,19,0.01);              
                            mix.Component("Calcium",40.078,20,0.2);              
                            mix.Component("Iron",55.85,26,0.014);              
                            mix.par("dens")=2.35;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      /// Medium Concrete           
                      {  AgMedium med = AgMedium::CopyMedium("Concrete");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HALL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      d1=cave.rmax[int(1)-1]+cave.dconc;           
                      d2=cave.rmax[int(2)-1]+cave.dconc;           
                      z1=cave.dz[int(1)-1]+cave.dconc;           
                      {  AgShape shape = AgShape("Pgon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=45;              
                            shape.par("dphi")=360;              
                            shape.par("npdiv")=4;              
                            shape.par("nz")=6;              
                            shape.Z(0)=-cave.dz[int(2)-1];              
                            shape.Z(1)=-z1;              
                            shape.Z(2)=-z1;              
                            shape.Z(3)=z1;              
                            shape.Z(4)=z1;              
                            shape.Z(5)=cave.dz[int(2)-1];              
                            shape.Rmin(0)=cave.rmin;              
                            shape.Rmin(1)=cave.rmin;              
                            shape.Rmin(2)=cave.rmin;              
                            shape.Rmin(3)=cave.rmin;              
                            shape.Rmin(4)=cave.rmin;              
                            shape.Rmin(5)=cave.rmin;              
                            shape.Rmax(0)=d2;              
                            shape.Rmax(1)=d2;              
                            shape.Rmax(2)=d1;              
                            shape.Rmax(3)=d1;              
                            shape.Rmax(4)=d2;              
                            shape.Rmax(5)=d2;              
                            /// Shape Pgon phi1=45 dphi=360 npdiv=4 nz=6               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HALL;              
                            _stacker -> Build(this);              
                      }           
                      wall_dx=d1;           
                      wall_dy=cave.dconc/2;           
                      wall_dz=z1;           
                      wall_yy=d1-wall_dy;           
                      _create = AgCreate("HOLE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HOLE              
                            Create("HOLE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HOLE");              
                            place.SetMother("HALL");              
                            /// Add daughter volume HOLE to mother HALL              
                            place.TranslateY(wall_yy);              
                            /// Translate y = wall_yy              
                            _stacker -> Position( AgBlock::Find("HOLE"), place );              
                      } // end placement of HOLE           
                      _create = AgCreate("CAVE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create CAVE              
                            Create("CAVE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("CAVE");              
                            place.SetMother("HALL");              
                            /// Add daughter volume CAVE to mother HALL              
                            _stacker -> Position( AgBlock::Find("CAVE"), place );              
                      } // end placement of CAVE           
                      END_OF_HALL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HALL     
