                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wall_dx;              
                            shape.par("dy")=wall_dy;              
                            shape.par("dz")=wall_dz;              
                            /// Shape Bbox dx=wall_dx dy=wall_dy dz=wall_dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HOLE;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_HOLE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HOLE     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *CRAT::mInstance = 0;     
          AgBlock *CRAT::Instance(){        
                   if ( mInstance==0 ) mInstance = new CRAT();        
                   return mInstance;        
          }     
          void CRAT::Block( AgCreate create )     
          {         
                ///@addtogroup CRAT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Component O	a=16	z=8	w=0.4*4*16./174.           
                      /// Mixture Electroncs dens=0.13           
                      {  AgMaterial &mix = AgMaterial::Get("Electroncs");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.Component("O",16,8,0.4*4*16./174.);              
                            mix.par("dens")=0.13;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      /// Medium Electronics           
                      {  AgMedium med = AgMedium::CopyMedium("Electronics");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("CRAT");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wall_dx;              
                            shape.par("dy")=wall_dy;              
                            shape.par("dz")=wall_dz;              
                            /// Shape Bbox dx=wall_dx dy=wall_dy dz=wall_dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CRAT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_CRAT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CRAT     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MGWP::mInstance = 0;     
          AgBlock *MGWP::Instance(){        
                   if ( mInstance==0 ) mInstance = new MGWP();        
                   return mInstance;        
          }     
          void MGWP::Block( AgCreate create )     
          {         
                ///@addtogroup MGWP_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      /// Medium Iron           
                      {  AgMedium med = AgMedium::CopyMedium("Iron");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("WGWP");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=12;              
                            shape.par("dz")=312;              
                            /// Shape Tube rmin=0 rmax=12 dz=312               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MGWP;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("MGWT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create MGWT              
                            Create("MGWT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MGWT");              
                            place.SetMother("MGWP");              
                            /// Add daughter volume MGWT to mother MGWP              
                            _stacker -> Position( AgBlock::Find("MGWT"), place );              
                      } // end placement of MGWT           
                      END_OF_MGWP:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MGWP     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MGWT::mInstance = 0;     
          AgBlock *MGWT::Instance(){        
                   if ( mInstance==0 ) mInstance = new MGWT();        
                   return mInstance;        
          }     
          void MGWT::Block( AgCreate create )     
          {         
                ///@addtogroup MGWT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component H2	a=1	z=1	w=2           
                      /// Component O	a=16	z=8	w=1           
                      /// Mixture Water dens=1.0           
                      {  AgMaterial &mix = AgMaterial::Get("Water");              
                            mix.Component("H2",1,1,2);              
                            mix.Component("O",16,8,1);              
                            mix.par("dens")=1.0;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      /// Medium Water           
                      {  AgMedium med = AgMedium::CopyMedium("Water");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("MGWT");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=10;              
                            shape.par("dz")=310;              
                            /// Shape Tube rmin=0 rmax=10 dz=310               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MGWT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MGWT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MGWT     
    // ----------------------------------------------------------------------- geoctr
       void CaveGeo2::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup CaveGeo2_revision        
             ///@{           
                   /// Author: Jason Webb, Yuri Fisyak           
             ///@}        
             ///@addtogroup CaveGeo2_revision        
             ///@{           
                   /// Created: May 2013           
             ///@}        
             AddBlock("HALL", HALL::Instance());        
             AddBlock("CAVE", CAVE::Instance());        
             AddBlock("WALL", WALL::Instance());        
             AddBlock("HOLE", HOLE::Instance());        
             AddBlock("SHLD", SHLD::Instance());        
             AddBlock("CRAT", CRAT::Instance());        
             AddBlock("MGWP", MGWP::Instance());        
             AddBlock("MGWT", MGWT::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill cvcf
++cvcf._index;
cvcf.version = 5;
// cvcf_docum.version = "  version ";
cvcf.config = 1;
// cvcf_docum.config = "  default config ";
CVCF.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill cave
++cave._index;
cave.version = 5;
// cave_docum.version = " version ";
cave.rmin = 0;
// cave_docum.rmin = " Inner radius of cave had better be zero ";
{
cave_info::rmax::Type temp = {
cave_info::rmax::BaseType(1575.02),
cave_info::rmax::BaseType(329.95)
}
;
memcpy(&cave.rmax, &temp, sizeof(temp));;
}
// cave_docum.rmax = " furthest distance to a concrete wall ";
{
cave_info::dz::Type temp = {
cave_info::dz::BaseType(807.72),
cave_info::dz::BaseType(2020.0)
}
;
memcpy(&cave.dz, &temp, sizeof(temp));;
}
// cave_docum.dz = " Dz(1) is distance to east/west wall from center of STAR, Dz(2) depth into tunnels ";
cave.dconc = 91.44;
// cave_docum.dconc = " concrete thickness 36inches";
CAVE.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill cdim
++cdim._index;
cdim.version = 1.000;
// cdim_docum.version = " version ";
cdim.dceiling = 2*170.0*2.54;
// cdim_docum.dceiling = " dist from beam to ceiling ... FAKE ";
cdim.dfloor = 169.75*2.54;
// cdim_docum.dfloor = " dist from beam to floor     ";
cdim.dnorth = 481.9*2.54;
// cdim_docum.dnorth = " dist from beam to the north (shield) wall ";
cdim.dsouth = 620.1*2.54;
// cdim_docum.dsouth = " dist from beam to south wall ";
cdim.thickceil = 20;
// cdim_docum.thickceil = " thickness of ceiling ";
CDIM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill tdim
++tdim._index;
tdim.version = 1.000;
// tdim_docum.version = " version ";
tdim.dceiling = 14.0*12.0*2.54-50.0*2.54;
// tdim_docum.dceiling = " dist from beam to ceiling  ";
tdim.dfloor = 50.0*2.54;
// tdim_docum.dfloor = " dist from beam to floor     ";
tdim.dnorth = 329.95;
// tdim_docum.dnorth = " dist from beam to the north wall ";
tdim.dsouth = 279.65;
// tdim_docum.dsouth = " dist from beam to south wall ";
TDIM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill shld
++shld._index;
shld.version = 1.000;
// shld_docum.version = " version ";
{
shld_info::xwidth::Type temp = {
shld_info::xwidth::BaseType(48.0*2.54),
shld_info::xwidth::BaseType(54.5*2.54),
shld_info::xwidth::BaseType(45.5*2.54),
shld_info::xwidth::BaseType(45.1*2.54)
}
;
memcpy(&shld.xwidth, &temp, sizeof(temp));;
}
// shld_docum.xwidth = " x widths ";
{
shld_info::ywidth::Type temp = {
shld_info::ywidth::BaseType(111.*2.54),
shld_info::ywidth::BaseType(111.*2.54),
shld_info::ywidth::BaseType(111.*2.54),
shld_info::ywidth::BaseType(108.*2.54)
}
;
memcpy(&shld.ywidth, &temp, sizeof(temp));;
}
// shld_docum.ywidth = " y widths ";
{
shld_info::zwidth::Type temp = {
shld_info::zwidth::BaseType(48.0*2.54),
shld_info::zwidth::BaseType(48.0*2.54),
shld_info::zwidth::BaseType(48.0*2.54),
shld_info::zwidth::BaseType(48.0*2.54)
}
;
memcpy(&shld.zwidth, &temp, sizeof(temp));;
}
// shld_docum.zwidth = " z widths ";
SHLD.fill();
        
             /// USE cvcf _index=1;        
             CVCF.use( __cvcf__index__ = 1 );
        
             /// USE cave version=cvcf.config;        
             CAVE.use( __cave_version__ = cvcf.config );
        
             /// USE cdim _index=1;        
             CDIM.use( __cdim__index__ = 1 );
        
             /// USE tdim _index=1;        
             TDIM.use( __tdim__index__ = 1 );
        
             // - Info -         
             Info( GetName(), Form("CaveGeoModuleiscalledCONFIG=%3i",cvcf.config)  );        
             _create = AgCreate("HALL");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HALL           
                   Create("HALL");            
             }        
       }; // CaveGeo2     
 }; // namespace CaveGeo2  
 