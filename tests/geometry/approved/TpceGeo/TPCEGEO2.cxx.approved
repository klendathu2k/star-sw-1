                            _stacker -> Position( AgBlock::Find("TIFC"), place );              
                      } // end placement of TIFC           
                      _create = AgCreate("TOFC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create TOFC              
                            Create("TOFC");               
                      }           
                      {              
