                            /// Shape Bbox dx=tecw.cardw/2 dy=tpcg.wheelthk/2 dz=tecw.cardth/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TCRX;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_TCRX:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TCRX     
