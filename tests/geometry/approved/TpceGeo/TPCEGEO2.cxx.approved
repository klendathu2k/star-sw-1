                            _stacker -> Position( AgBlock::Find("TPEA"), place );              
                      } // end placement of TPEA           
                      tpcwz=(tpcg.length-2*trdo.rdovthk-tpcg.wheelthk)/2;           
                      _create = AgCreate("TPCW");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create TPCW              
                            Create("TPCW");               
                      }           
                      {              
