          AgBlock *TWIR::mInstance = 0;     
          AgBlock *TWIR::Instance(){        
                   if ( mInstance==0 ) mInstance = new TWIR();        
                   return mInstance;        
          }     
          void TWIR::Block( AgCreate create )     
          {         
                ///@addtogroup TWIR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("TWIR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=kyellow;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material G10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("G10");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Para");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mypar(1);              
                            shape.par("dy")=mypar(2);              
                            shape.par("dz")=mypar(3);              
                            shape.par("alph")=mypar(4);              
                            shape.par("thet")=0;              
                            shape.par("phi")=0;              
                            /// Shape Para dx=mypar(1) dy=mypar(2) dz=mypar(3) alph=mypar(4) thet=0 phi=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TWIR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_TWIR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TWIR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *THOL::mInstance = 0;     
          AgBlock *THOL::Instance(){        
                   if ( mInstance==0 ) mInstance = new THOL();        
                   return mInstance;        
          }     
          void THOL::Block( AgCreate create )     
          {         
                ///@addtogroup THOL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("THOL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=kgreen;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mypar(1);              
                            shape.par("dy")=mypar(2);              
                            shape.par("dz")=mypar(3);              
                            /// Shape Bbox dx=mypar(1) dy=mypar(2) dz=mypar(3)               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_THOL;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FEES");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FEES              
                            Create("FEES");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FEES");              
                            place.SetMother("THOL");              
                            /// Add daughter volume FEES to mother THOL              
                            _stacker -> Position( AgBlock::Find("FEES"), place );              
                      } // end placement of FEES           
                      END_OF_THOL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block THOL     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FEES::mInstance = 0;     
          AgBlock *FEES::Instance(){        
                   if ( mInstance==0 ) mInstance = new FEES();        
                   return mInstance;        
          }     
          void FEES::Block( AgCreate create )     
          {         
                ///@addtogroup FEES_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material G10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("G10");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FEES");              
                            attr.par("seen")=1;              
                            attr.par("colo")=kblue;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=6.2/20;              
                            shape.par("dy")=57./20;              
                            shape.par("dz")=5.8/20;              
                            /// Shape Bbox dx=6.2/20 dy=57./20 dz=5.8/20               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FEES;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FEES:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FEES     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TPGV::mInstance = 0;     
          AgBlock *TPGV::Instance(){        
                   if ( mInstance==0 ) mInstance = new TPGV();        
                   return mInstance;        
          }     
          void TPGV::Block( AgCreate create )     
          {         
                ///@addtogroup TPGV_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("TPGV");              
                            attr.par("seen")=1;              
                            attr.par("colo")=kred;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material P10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("P10");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=tpgvir;              
                            shape.par("rmax")=tpcg.sengasor;              
                            shape.par("dz")=tpgvleng/2;              
                            /// Shape Tube rmin=tpgvir rmax=tpcg.sengasor dz=tpgvleng/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TPGV;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on isecang from 15 to 360-15 step=30           
                      for ( isecang=15; (30>0)? (isecang<=360-15):(isecang>=360-15); isecang+=30 )           
                      {              
                            _create = AgCreate("TPSS");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create TPSS                 
                                  Create("TPSS");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("TPSS");                 
                                  place.SetMother("TPGV");                 
                                  /// Add daughter volume TPSS to mother TPGV                 
                                  place.par("only")=AgPosition::kMany;                 
                                  /// Overlap: agposition::kmany                 
                                  place.AlphaZ(isecang);                 
                                  /// Rotate: AlphaZ = isecang                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("TPSS"), place );                 
                            } // end placement of TPSS              
                      }           
                      END_OF_TPGV:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TPGV     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TPSS::mInstance = 0;     
          AgBlock *TPSS::Instance(){        
                   if ( mInstance==0 ) mInstance = new TPSS();        
                   return mInstance;        
          }     
          void TPSS::Block( AgCreate create )     
          {         
                ///@addtogroup TPSS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("TPSS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=kblue;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=-15;              
                            shape.par("phi2")=15;              
                            /// Shape Tubs phi1=-15 phi2=15               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TPSS;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on kase from 1 to 2 step=1           
                      for ( kase=1; (1>0)? (kase<=2):(kase>=2); kase+=1 )           
                      {              
                            /// Loop on i_sec from 1 to 2 step=1              
                            for ( i_sec=1; (1>0)? (i_sec<=2):(i_sec>=2); i_sec+=1 )              
                            {                 
                                  /// USE tprs sec=i_sec;                 
                                  TPRS.use( __tprs_sec__ = i_sec );
                 
                                  /// USE tecw sec=i_sec;                 
                                  TECW.use( __tecw_sec__ = i_sec );
                 
                                  zwheel1=tpcg.lengthw/2-tpcg.wheelthk;                 
                                  zbeg=tpcg.membthk/2;                 
                                  zend=tpcg.zgroundgrid+tprs.danode*2;                 
                                  if ( i_sec==1 )                 
                                  {                    
                                        zded=tpcg.zgatinggrid-tpcg.ideadzone;                    
                                  }                 
                                  if ( i_sec==2 )                 
                                  {                    
                                        zded=tpcg.zgatinggrid-tpcg.deadzone;                    
                                  }                 
                                  zpmt=tpcg.zgatinggrid;                 
                                  dx=tprs.width/2;                 
                                  if ( kase==1 )                 
                                  {                    
                                        dz=(zded-zbeg)/2;                    
                                        z=(zded+zbeg)/2-tpgvz;                    
                                  }                 
                                  if ( kase==2 )                 
                                  {                    
                                        dz=(zend-zpmt)/2;                    
                                        z=(zend+zpmt)/2-tpgvz;                    
                                  }                 
                                  /// Loop on i_row from 1 to nint(tprs.nrow) step=1                 
                                  for ( i_row=1; (1>0)? (i_row<=nint(tprs.nrow)):(i_row>=nint(tprs.nrow)); i_row+=1 )                 
                                  {                    
                                        if ( (nint(tprs.super)==3||i_row==1) )                    
                                        {                       
                                              dy=tprs.npads[int(i_row)-1]*tprs.pitch/2;                       
                                              x=tprs.rpads[int(i_row)-1]-tprs.width;                       
                                              _create = AgCreate("TPAD");                       
                                              {                          
                                                    AgShape myshape; // undefined shape                          
                                                    ///Create TPAD                          
                                                    Create("TPAD");                           
                                              }                       
                                              {                          
                                                    AgPosition  place;                          
                                                    place.SetBlock("TPAD");                          
                                                    place.SetMother("TPSS");                          
                                                    /// Add daughter volume TPAD to mother TPSS                          
                                                    place.TranslateX(x);                          
                                                    /// Translate x = x                          
                                                    place.TranslateZ(z);                          
                                                    /// Translate z = z                          
                                                    place.par("dx")=dx;                          
                                                    place.par("dy")=dy;                          
                                                    place.par("dz")=dz;                          
                                                    _stacker -> Position( AgBlock::Find("TPAD"), place );                          
                                              } // end placement of TPAD                       
                                        }                    
                                        dy=tprs.npads[int(i_row)-1]*tprs.pitch/2;                    
                                        x=tprs.rpads[int(i_row)-1];                    
                                        _create = AgCreate("TPAD");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create TPAD                       
                                              Create("TPAD");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("TPAD");                       
                                              place.SetMother("TPSS");                       
                                              /// Add daughter volume TPAD to mother TPSS                       
                                              place.TranslateX(x);                       
                                              /// Translate x = x                       
                                              place.TranslateZ(z);                       
                                              /// Translate z = z                       
                                              place.par("dx")=dx;                       
                                              place.par("dy")=dy;                       
                                              place.par("dz")=dz;                       
                                              _stacker -> Position( AgBlock::Find("TPAD"), place );                       
                                        } // end placement of TPAD                    
                                        if ( (nint(tprs.super)==3||i_row==nint(tprs.nrow)) )                    
                                        {                       
                                              x=tprs.rpads[int(i_row)-1]+tprs.width;                       
                                              dy=tprs.npads[int(i_row)-1]*tprs.pitch/2;                       
                                              _create = AgCreate("TPAD");                       
                                              {                          
                                                    AgShape myshape; // undefined shape                          
                                                    ///Create TPAD                          
                                                    Create("TPAD");                           
                                              }                       
                                              {                          
                                                    AgPosition  place;                          
                                                    place.SetBlock("TPAD");                          
                                                    place.SetMother("TPSS");                          
                                                    /// Add daughter volume TPAD to mother TPSS                          
                                                    place.TranslateX(x);                          
                                                    /// Translate x = x                          
                                                    place.TranslateZ(z);                          
                                                    /// Translate z = z                          
                                                    place.par("dx")=dx;                          
                                                    place.par("dy")=dy;                          
                                                    place.par("dz")=dz;                          
                                                    _stacker -> Position( AgBlock::Find("TPAD"), place );                          
                                              } // end placement of TPAD                       
                                        }                    
                                  }                 
                            }              
                      }           
                      END_OF_TPSS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TPSS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TPAD::mInstance = 0;     
          AgBlock *TPAD::Instance(){        
                   if ( mInstance==0 ) mInstance = new TPAD();        
                   return mInstance;        
          }     
          void TPAD::Block( AgCreate create )     
          {         
                ///@addtogroup TPAD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      if ( tprs.width<1.5 )           
                      { AgAttribute attr = AgAttribute("TPAD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.par("serial")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      if ( tprs.width>1.5 )           
                      { AgAttribute attr = AgAttribute("TPAD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.par("serial")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material p10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("P10");              
                            _material = mat;              
                      }           
                      /// Material sensitive_gas isvol=1 stemax=2.5*tprs_width            
                      { AgMaterial &mat = AgMaterial::Get("Sensitive_gas");              
                            mat.par("isvol")=1;              
                            mat.par("stemax")=2.5*tprs.width;              
                            _material = mat;              
                      }           
                      /// Medium TPAD_p10           
                      ///  stemax = 2.5*tprs_width           
                      ///  deemax = 0.00175367           
                      ///  stmin = 0.0249056           
                      ///  isvol = 1           
                      {  AgMedium &med = AgMedium::Get("Tpad_p10");              
                               med.Inherit(this);              
                            med.par("stemax")=2.5*tprs.width;              
                            med.par("deemax")=0.00175367;              
                            med.par("stmin")=0.0249056;              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0;              
                            shape.par("dy")=0;              
                            shape.par("dz")=0;              
                            /// Shape Bbox dx=0 dy=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TPAD;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 1e-4 (deferred)           
                      // cut cutele = 1e-4 (deferred)           
                      // cut dcute = 1e-4 (deferred)           
                      // cut dcutm = 1e-4 (deferred)           
                      // parameter stra = 1. (deferred)           
                      // deferred module()->AddHit( "TPAD", "z", 0.0005, 0, 0, "s");           
                      // deferred module()->AddHit( "TPAD", "y", 0.0005, 0, 0, "");           
                      // deferred module()->AddHit( "TPAD", "x", 0.0005, 0, 0, "");           
                      // deferred module()->AddHit( "TPAD", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TPAD", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TPAD", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TPAD", "lptot", 18, -3, 2, "");           
                      // deferred module()->AddHit( "TPAD", "sleng", 0.1, 0, 800, "");           
                      // deferred module()->AddHit( "TPAD", "tof", 16, 0, tpcg.tofmax, "");           
                      // deferred module()->AddHit( "TPAD", "lgam", 16, -2, +2, "");           
                      // deferred module()->AddHit( "TPAD", "step", 11, 0, 10, "");           
                      // deferred module()->AddHit( "TPAD", "user", 21, -0.01, 0.01, "");           
                      END_OF_TPAD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TPAD     
    // ----------------------------------------------------------------------- geoctr
       void TpceGeo6::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup TpceGeo6_revision        
             ///@{           
                   /// Author: David Underwood corrected by Maxim Potekhin,          implmented in TGeo by Yuri, translated back          to AgSTAR by Victor, and code cleanup by Jason,         converted to iTPC by Irakli           
             ///@}        
             ///@addtogroup TpceGeo6_revision        
             ///@{           
                   /// Created:   Dec 7, 2005            
             ///@}        
             AddBlock("TPCE", TPCE::Instance());        
             AddBlock("TPCM", TPCM::Instance());        
             AddBlock("TIFC", TIFC::Instance());        
             AddBlock("TIKA", TIKA::Instance());        
             AddBlock("TINX", TINX::Instance());        
             AddBlock("TIAD", TIAD::Instance());        
             AddBlock("TOFC", TOFC::Instance());        
             AddBlock("TOFS", TOFS::Instance());        
             AddBlock("TOKA", TOKA::Instance());        
             AddBlock("TONX", TONX::Instance());        
             AddBlock("TOAD", TOAD::Instance());        
             AddBlock("TOIG", TOIG::Instance());        
             AddBlock("TOHA", TOHA::Instance());        
             AddBlock("TSWH", TSWH::Instance());        
             AddBlock("TSAW", TSAW::Instance());        
             AddBlock("TSAS", TSAS::Instance());        
             AddBlock("TWAS", TWAS::Instance());        
             AddBlock("FEEA", FEEA::Instance());        
             AddBlock("FEEP", FEEP::Instance());        
             AddBlock("FEER", FEER::Instance());        
             AddBlock("FEEI", FEEI::Instance());        
             AddBlock("TALS", TALS::Instance());        
             AddBlock("TSGT", TSGT::Instance());        
             AddBlock("TWBT", TWBT::Instance());        
             AddBlock("TWRI", TWRI::Instance());        
             AddBlock("TWRG", TWRG::Instance());        
             AddBlock("TWRC", TWRC::Instance());        
             AddBlock("TWTR", TWTR::Instance());        
             AddBlock("TWMR", TWMR::Instance());        
             AddBlock("TRDO", TRDO::Instance());        
             AddBlock("TBRW", TBRW::Instance());        
             AddBlock("TWRB", TWRB::Instance());        
             AddBlock("TCOO", TCOO::Instance());        
             AddBlock("TCAB", TCAB::Instance());        
             AddBlock("TRDC", TRDC::Instance());        
             AddBlock("TRIB", TRIB::Instance());        
             AddBlock("TWIR", TWIR::Instance());        
             AddBlock("THOL", THOL::Instance());        
             AddBlock("FEES", FEES::Instance());        
             AddBlock("TPGV", TPGV::Instance());        
             AddBlock("TPSS", TPSS::Instance());        
             AddBlock("TPAD", TPAD::Instance());        
             kinner=0;        
             kouter=1;        
             /* Export block
inch=2.54;
*/        
             /* Export block
cm=1.;
*/        
             kblack=1;        
             kred=2;        
             kgreen=3;        
             kblue=4;        
             kyellow=5;        
             kviolet=6;        
             klightblue=7;        
             kbbox=0;        
             kpara=1;        
             ktrd1=2;        
             cos15=.965925826289068312;        
             sin15=.258819045102520739;        
             tan15=.267949192431122696;        
                xholes.SetRange(0,15);        
                rmnsa.SetRange(0,1);        
                rmxsa.SetRange(0,1);        
             zzzsa.at(0) = 207.4;        
             zzzsa.at(1) = 219.1;        
             rmnsa.at(0) = 51;        
             rmnsa.at(1) = 121.07;        
             rmxsa.at(0) = 121.07;        
             rmxsa.at(1) = 194;        
                rmnwa.SetRange(0,1);        
                rmxwa.SetRange(0,1);        
             zzzwa.at(0) = 211.4;        
             zzzwa.at(1) = 229.2;        
             rmnwa.at(0) = 54;        
             rmnwa.at(1) = 121;        
             rmxwa.at(0) = 121;        
             rmxwa.at(1) = 189;        
             zzzrdo.at(0) = 232.;        
             zzzrdo.at(1) = 252.;        
             rmnrdo.at(0) = 88.;        
             rmnrdo.at(1) = 88.;        
             rmxrdo.at(0) = 198.;        
             rmxrdo.at(1) = 198.;        
                drdocooling.SetRange(0,7);        
             drdocooling.at(0) = 16.0;        
             drdocooling.at(1) = 16.0;        
             drdocooling.at(2) = 16.0;        
             drdocooling.at(3) = 16.7;        
             drdocooling.at(4) = 15.0;        
             drdocooling.at(5) = 3.5;        
             drdocooling.at(6) = 14.5;        
             drdocooling.at(7) = 0.0;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill tpcc
++tpcc._index;
tpcc.version = 6.0;
// tpcc_docum.version = "None";
tpcc.misalign = 0;
// tpcc_docum.misalign = "0: ideal 1: global position";
TPCC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill tpcg
++tpcg._index;
tpcg.version = 6.0;
// tpcg_docum.version = "// version    => current version ";
tpcg.rmin = 46.107;
// tpcg_docum.rmin = "// Rmin          => TPC envelope inner radius ";
tpcg.rmax = 207.77;
// tpcg_docum.rmax = "// Rmax          => TPC envelope outer radius ";
tpcg.rminifc = 46.6;
// tpcg_docum.rminifc = "// RminIFC    => inner radius TPC IFC  : A.Lebedev measurement 10/16/08 ";
tpcg.lengtht = 2*271.0;
// tpcg_docum.lengtht = "// LengthT    => TPC full length up to front of EEMC ";
tpcg.length = 2*259.685;
// tpcg_docum.length = "// Length        => TPC full length including RDOs ";
tpcg.lengthw = 2*229.71;
// tpcg_docum.lengthw = "// LengthW    => TPC length including Wheel ";
tpcg.lengthv = 2*210.00;
// tpcg_docum.lengthv = "// LengthV    => TPC gas volume length ";
tpcg.dzenvelop = 268.;
// tpcg_docum.dzenvelop = "// TPCE envelop dz ";
tpcg.wheelir = 38.620*inch/2;
// tpcg_docum.wheelir = "// 49.60 WheelIR    => support wheel inner radius ";
tpcg.wheelr0 = 21.500*inch;
// tpcg_docum.wheelr0 = "// WheelR0 => Distance from IP of end of inner cylindrical part ";
tpcg.wheelr1 = 47.867*inch;
// tpcg_docum.wheelr1 = "// WheelR1 => Distance from IP of middle Rib ";
tpcg.wheelr2 = 76.093*inch;
// tpcg_docum.wheelr2 = "// WheelR2 => Distance from IP of upper Rib ";
tpcg.wheeltotalribwidth = 7.6;
// tpcg_docum.wheeltotalribwidth = "// WheelTotalRibWidth => total rib width (A.Lebedev measurement) ";
tpcg.wheelribwidth = 1.9;
// tpcg_docum.wheelribwidth = "// WheelRibWidth         => rib plate width (A.Lebedev measurement) ";
tpcg.wheelribheight = 1.3;
// tpcg_docum.wheelribheight = "// WheelRibHeight        => rib plate height (A.Lebedev measurement) ";
tpcg.wheelboxdx = 4.7;
// tpcg_docum.wheelboxdx = "// WheelBoxDx (A.Lebedev measurement) ";
tpcg.wheelboxdy = 7.6;
