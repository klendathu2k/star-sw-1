      IF ( y.le.PRSW_DHole ) THEN
      dxx = (pwid-PRSW_DHole)/2.0
      x   = dxx+PRSW_DHole
      ELSE
      IF ( tb.eq.1 ) THEN
      dxx = pwid/2.0
      x   = dxx
      ELSE
      dxx = lprs4/2.0
      x   = dxx+2*PRSW_DPrs(1)
      ENDIF
      ENDIF
      xx=x+dxx+dlg
      IF ( tb.eq.1 ) THEN
      yy=+y;
      ENDIF
      IF ( tb.eq.2 ) THEN
      yy=-y;
      ENDIF
      IF ( lr.eq.1 ) THEN
      x=+x+PRSW_Xoff(serN); xx=+xx+PRSW_Xoff(serN); rot=-90
      ENDIF
      IF ( lr.eq.2 ) THEN
      x=-x-PRSW_Xoff(serN); xx=-xx-PRSW_Xoff(serN); rot=90
      ENDIF
      yy=yy+PRSW_Yoff(serN);
      IF ( tb.eq.1 .or. j.eq.1 .or. i.le.PRSW_NPrs(j)-PRSW_NSkipH ) THEN
      IF ( debug.ge.1 ) THEN
      k   = k+1
      slat(quad,layr)=slat(quad,layr)+1
      id=(quad-1)*3*21+(layr-1)*21+(slat(quad,layr)-1)
      flag=0
      DO kk = 1, npstype
      IF ( (psdim(kk,1).eq.dxx.and.psdim(kk,2).eq.dyy).or.(psdim(kk,1).eq.dyy.and.psdim(kk,
            2).eq.dxx) ) THEN
      flag=kk
      pstype(kk)=pstype(kk)+1
      ENDIF
      END DO
      IF ( flag.eq.0 ) THEN
      npstype=npstype+1
      flag=npstype
      pstype(flag)=1
      IF ( dxx.gt.dyy ) THEN
      psdim(npstype,1)=dyy
      psdim(npstype,2)=dxx
      ELSE
      psdim(npstype,1)=dxx
      psdim(npstype,2)=dyy
      ENDIF
      ENDIF
      ENDIF
      CALL AgsReset 
