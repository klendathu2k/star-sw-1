      ! ---------------------------------------------------------------------------------- FTLY
      BLOCK FTLY   is a layer of FMS Postshower
      MATERIAL Air
      MEDIUM standard
      ATTRIBUTE FTLY seen=1 colo=3 serial=serN
      SHAPE box dx=dx dy=dy dz=dz
      CREATE FOSC
      CREATE FPBB
      DO i = 1, POST_Nslat(layr,sn)
      IF ( POST_Nslat(layr,sn).gt.0 ) THEN
      IF ( layr.eq.1 ) THEN
      xxx=wid*(i-5)
      yyy=0.0
      dyy=POST_ScLth(2)/2.0
      ELSEIF ( layr.le.3 ) THEN
      IF ( i.le.7 ) THEN
      xxx=-1.5*wid*sqrt2+wid*i/sqrt2-39.085
      yyy=wid*8/sqrt2-wid*i/sqrt2
      dyy=POST_ScLth(11-i)/2.0
      ELSEIF ( i.gt.7 ) THEN
      xxx=2.5*wid*sqrt2+wid*(i-8)*sqrt2-39.085
      yyy=0.0
      dyy=POST_ScLth(3)/2.0
      ENDIF
      ELSEIF ( layr.eq.4 ) THEN
      IF ( i.le.19 ) THEN
      xxx=0.0
      yyy=-108.0375+(60+POST_scWrap)/sqrt2+wid/2.0+wid*sqrt2*19-POST_Yoff(layr,sn)-wid*i*sqrt2
      dyy=POST_ScLth(3)/2.0
      ELSE
      xxx=wid*(i-19)/sqrt2
      yyy=-108.0375+(60+POST_scWrap)/sqrt2+wid/2.0-POST_Yoff(layr,sn)-wid*(i-19)/sqrt2
      dyy=POST_ScLth(i-16)/2.0
      ENDIF
      ELSEIF ( layr.eq.5 ) THEN
      yyy=wid*(22-i)
      xxx=0.0
      dyy=POST_ScLth(2)/2.0
      ELSEIF ( layr.eq.6 ) THEN
      dyy=POST_ScLth(1)/2.0
      yyy=54.0
      xxx=wid*(i-9)
      IF ( i.gt.17 ) THEN
      xxx=wid*(i-26)
      yyy=-yyy
      ENDIF
      ENDIF
      IF ( sn.eq.2 ) THEN
      xxx=-xxx
      ENDIF
      ang=POST_AngSlat(layr,sn)
      dzz=POST_scThick/2.0
      dxx=POST_scWidth/2.0
      zzz=-dz+POST_ScThick/2.0
      IF ( layr.eq.3 ) THEN
      zzz=-zzz
      ENDIF
      CALL AgsReset 
      CALL agml_position_begin('FOSC') 
      %title = 'FOSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xxx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yyy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zzz) 
      CALL agml_translate_z( %z ) 
      %dx = real(dxx) 
      %dy = real(dyy) 
      %dz = real(dzz) 
      ag_alphaz = real(ang) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      END DO
      DO i = 1, POST_Nslat(layr,sn)
      IF ( POST_Nslat(layr,sn).gt.0 ) THEN
      IF ( layr.eq.1 ) THEN
      dxx=wid*9+1.0
      dyy=POST_ScLth(2)/2.0+1.0
      ELSEIF ( layr.le.3 ) THEN
      dxx=64.0
      dyy=POST_ScLth(2)/2.0
      ELSE
      dxx=POST_ScLth(2)/2.0+1.0
      dyy=POST_ScLth(1)+1.0
      ENDIF
      xxx=0.0
      yyy=0.0
      dzz=POST_BPdz/2.0
      zzz=dz-POST_BPdz/2.0
      IF ( layr.eq.3 ) THEN
      zzz=-zzz
      ENDIF
      CALL AgsReset 
      CALL agml_position_begin('FPBB') 
      %title = 'FPBB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xxx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yyy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zzz) 
      CALL agml_translate_z( %z ) 
      %dx = real(dxx) 
      %dy = real(dyy) 
      %dz = real(dzz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPBB
      BLOCK FPBB   is the G10 back board
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      COMPONENT O A=16 Z=8 W=0.4*4*16./174.
      MIXTURE g10 dens=1.7
      ATTRIBUTE FPBB seen=1 colo=7
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPPB
      BLOCK FPPB   is FMS PS Pb converter
      MATERIAL LEAD
      ATTRIBUTE FPPB seen=1 colo=6
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPSC
      BLOCK FPSC   is a piece of scintillator in FMS Preshower
      MATERIAL Polystyren
      MATERIAL FMSPS_scint isvol=1
      ATTRIBUTE FPSC seen=1 colo=4
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      Call GStPar(ag_imed, 'CUTGAM',0.00008)
      Call GStPar(ag_imed, 'CUTELE',0.001)
      Call GStPar(ag_imed, 'BCUTE',0.0001)
      Call GStPar(ag_imed, 'BIRK1', 1.)
      Call GStPar(ag_imed, 'BIRK2', 0.013)
      Call GStPar(ag_imed, 'BIRK3', 9.6E-6)
      HITS FPSC birk:0:(0,10)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FOSC
      BLOCK FOSC   is a piece of scintillator in FMS POST shower
      MATERIAL Polystyren
      MATERIAL FMSPOST_scint isvol=1
      ATTRIBUTE FOSC seen=1 colo=2
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      Call GStPar(ag_imed, 'CUTGAM',0.00008)
      Call GStPar(ag_imed, 'CUTELE',0.001)
      Call GStPar(ag_imed, 'BCUTE',0.0001)
      Call GStPar(ag_imed, 'BIRK1', 1.)
      Call GStPar(ag_imed, 'BIRK2', 0.013)
      Call GStPar(ag_imed, 'BIRK3', 9.6E-6)
      HITS FOSC birk:0:S(0,10)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLIG
      BLOCK FLIG   is a light guide + SiPM board for Preshower
      MATERIAL Air
      ATTRIBUTE FLIG seen=1 colo=6 serial=1
      SHAPE box dx=PRSW_DPRS(1)/2.0 dy=PRSW_Dz(1)/2.0+PRSW_DSIPM(1)/2.0,
            dz=dlg
      CREATE FLBA
      CREATE FLCO
      CREATE FPMT
      CREATE FFEE
      CALL AgsReset 
      CALL agml_position_begin('FLBA') 
      %title = 'FLBA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FLCO') 
      %title = 'FLCO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-PRSW_DPRS(1)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FLCO') 
      %title = 'FLCO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+PRSW_DPRS(1)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FPMT') 
      %title = 'FPMT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FFEE') 
      %title = 'FFEE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(PRSW_Dz(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(4)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLLG
      BLOCK FLLG   is a light guide + SiPM board for Preshower for large
      MATERIAL Air
      ATTRIBUTE FLLG seen=1 colo=6 serial=1
      SHAPE box dx=PRSW_DPRS(2)/2.0 dy=PRSW_Dz(1)/2.0+PRSW_DSIPM(1)/2.0,
            dz=dlg
      CREATE FBLL
      CREATE FCLL
      CREATE FPMT
      CREATE FFEE
      CALL AgsReset 
      CALL agml_position_begin('FBLL') 
      %title = 'FBLL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FCLL') 
      %title = 'FCLL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-PRSW_DPRS(2)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FCLL') 
      %title = 'FCLL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( PRSW_DPRS(2)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FPMT') 
      %title = 'FPMT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FFEE') 
      %title = 'FFEE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(PRSW_Dz(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(4)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLBA
      BLOCK FLBA   is a light guide base for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FLBA seen=1 colo=4 serial=1
      SHAPE box dx=PRSW_DPRS(1)/2.0 dy=PRSW_DZ(serN)/2.0,
            dz=PRSW_DLG(3)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FBLL
      BLOCK FBLL   is a light guide base for Preshower large
      MATERIAL Polystyren
      ATTRIBUTE FBLL seen=1 colo=4 serial=1
      SHAPE box dx=PRSW_DPRS(2)/2.0 dy=PRSW_DZ(serN)/2.0,
            dz=PRSW_DLG(3)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLCO
      BLOCK FLCO   is a light guide cone for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FLCO seen=1 colo=4 serial=1
      SHAPE trd2 dx1=PRSW_DPRS(1)/4.0 dx2=PRSW_DLG(1)/2.0,
            dy1=PRSW_DZ(serN)/2.0 dy2=PRSW_DLG(1)/2.0,
            dz=PRSW_DLG(2)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FCLL
      BLOCK FCLL   is a light guide cone for Preshower large
      MATERIAL Polystyren
      ATTRIBUTE FCLL seen=1 colo=4 serial=1
      SHAPE trd2 dx1=PRSW_DPRS(2)/4.0 dx2=PRSW_DLG(1)/2.0,
            dy1=PRSW_DZ(serN)/2.0 dy2=PRSW_DLG(1)/2.0,
            dz=PRSW_DLG(2)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPMT
      BLOCK FPMT   is a SiPM board for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FPMT seen=1 colo=3 serial=1
      SHAPE box dx=PRSW_DSIPM(2)/2.0 dy=PRSW_DSIPM(3)/2.0,
            dz=PRSW_DSIPM(1)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FFEE
      BLOCK FFEE   is a FEE board for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FEEE seen=1 colo=3 serial=1
      SHAPE box dx=PRSW_DSIPM(2)/2.0 dy=PRSW_DSIPM(1)/2.0,
            dz=PRSW_DSIPM(4)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPPL
      BLOCK WPPL   is a pole for west platform
      MATERIAL Iron
      ATTRIBUTE WPPL seen=1 colo=4
      SHAPE box dx=WPFM_PoleD(1)/2.0 dy=WPFM_PoleD(2)/2.0,
            dz=WPFM_PoleD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_PoleD(1)/2.0-WPFM_PoleD(4)) 
      %dy = real(WPFM_PoleD(2)/2.0) 
      %dz = real(WPFM_PoleD(3)/2.0-WPFM_PoleD(4)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPIS
      BLOCK WPIS   is a I-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPIS seen=1 colo=4
      SHAPE box dx=WPFM_IstrD(1)/2.0 dy=WPFM_IstrD(2)/2.0,
            dz=WPFM_IstrD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(+(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUF
      BLOCK WPUF   is a front U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUF seen=1 colo=4
      SHAPE box dx=WPFM_UstFD(1)/2.0 dy=WPFM_UstFD(2)/2.0,
            dz=WPFM_UstFD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstFD(4)/2.0) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstFD(1)/2.0) 
      %dy = real(WPFM_UstFD(2)/2.0-WPFM_UstFD(4)) 
      %dz = real(WPFM_UstFD(3)/2.0-WPFM_UstFD(4)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUN
      BLOCK WPUN   is a north U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUN seen=1 colo=4
      SHAPE box dx=WPFM_UstND(1)/2.0 dy=WPFM_UstND(2)/2.0,
            dz=WPFM_UstND(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstND(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstND(1)/2.0-WPFM_UstND(4)/2.0) 
      %dy = real(WPFM_UstND(2)/2.0-WPFM_UstND(4)) 
      %dz = real(WPFM_UstND(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUS
      BLOCK WPUS   is a south U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUS seen=1 colo=4
      SHAPE box dx=WPFM_UstSD(1)/2.0 dy=WPFM_UstSD(2)/2.0,
            dz=WPFM_UstSD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-WPFM_UstSD(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstSD(1)/2.0-WPFM_UstSD(4)/2.0) 
      %dy = real(WPFM_UstSD(2)/2.0-WPFM_UstSD(4)) 
      %dz = real(WPFM_UstSD(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPAR
      BLOCK WPAR   is a platform structs air
      MATERIAL Air
      ATTRIBUTE WPAR seen=1 colo=0
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      <W> '===>> 	[End AgML Module FPDMGEO4]	 <<==='; (A32,/,/);
      END! Module FPDMGEO4
      subroutine fmsdigitizationmodule(JJ,HIT)
      +CDE,TYPING,GCBANK,GCONST,GCUNIT,GCTMED,GCTRAK,GCKINE,GCSETS,AGCSTEP,GCVOLU.
      Integer JJ
      Real HIT,att,dzhit,zback,lamb
      Real zcenter, box(3), foo(3), dx, dy, dz, z
      Equivalence (box(1),dx)
      Equivalence (box(2),dy)
      Equivalence (box(3),dz)
      Integer :: npar, natt, istat, isys, iii
      Real depth
      LOGICAL isSet /.false./
      LOGICAL doAttenuation /.false./
      LOGICAL isFirst /.true./
      character*4 name
      Real zcenter_cache(2) / -1.0, -1.0 /
      Real dz_cache(2) / 45.0, 60.0 /
      STRUCTURE FMCG { Version,ChkvSim,PbPlate,FmsNorthX,FmsSouthX,Atten,int postshower}
      ENTRY FLGR HIT (jj,hit) """Entry point for FLGR hits"""
      IF (isSet.eqv..FALSE.) THEN
      lamb   = 0.04             ! attenuation = exp(-lamb * (zback-zhit))
      isSet  = .true.
      isys = 1
      ENDIF
      ENTRY FLXF HIT (jj,hit) """Entry point for FLXF hits"""
      IF (isSet.eqv..FALSE.) THEN
      lamb   = 0.03
      isSEt  = .true.
      isys = 2
      ENDIF
      att = 1.0
      !
      ! Check whether to run attenuation or not
      !
      IF ( isFirst .eqv. .true. ) THEN
      USE /DETM/FPDM/FMCG stat=istat
      isFirst = .false.
      ENDIF
      IF (istat.ge.0.) { "negative indicates failure mode"
      IF (fmcg_atten=1.0) {
      ! Obtain / cache center of this detector, but we use a hardcoded
      ! depth.
      if ( zcenter_cache(isys) .lt. 0 ) then
      zcenter_cache(isys) = gtran(3,NLEVEL)
      endif
      zcenter = zcenter_cache(isys)
      dz      = dz_cache(isys) / 2
      ! Compute the front of the detector
      zback = zcenter + dz
      ! Distance from back of detector to hit
      dzhit = zback - VECT(3)
      IF (dzhit.gt.0) THEN """ Rare -1E-3cm hit positions """
      ! Calculate attenuation
      att=exp(-lamb * dzhit)
      ELSE
      att=1.0
      ENDIF
      }
      }
      ! reset
      isSet = .false.
      ! Attenuated energy loss
      hit = deStep * att
      z = vect(3)
      call uhtoc(NAMES(NLEVEL),4,name,4)
      ! write (*,*) name, 'z=',z, zback, 'dz=',dzhit,'step=',step,'dE=',deStep, 'alpha=',att
      return
      end
