      } !//IF serN.eq.3 
      IF ( serN.le.2 ) THEN
      dx2=(lprs2-PRSW_DHole+PRSW_DxBbd(1)+PRSW_DxBbd(2))/2.0
      ELSE
      dx2=(lprs2-PRSW_DHole+PRSW_DxBbd(1)+PRSW_DxBbd(2))/2.0
      ENDIF
      dy2=(lprs3 - PRSW_DyCut + PRSW_DxBbd(2))/2.0
      x2=PRSW_xoff(serN) + dx1b*2 + dx2
      y2=dy2
