      MATERIAL Air
      ATTRIBUTE FERC seen=1 colo=6
      SHAPE tubs rmin=0.0 rmax=INSE_RMax phi1=-90,
            phi2=90 dz=INSE_GateDepth/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FESC
      BLOCK FESC   is Air Enclosure part
      MATERIAL Air
      ATTRIBUTE FESC seen=1 colo=6
      SHAPE tube rmin=0.0 rmax=INSE_Diam/2.0 dz=INSE_GateDepth/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPCT
      BLOCK FPCT   is Photo Cathode
      MATERIAL Air
      MEDIUM PhotCath isvol=1
      ATTRIBUTE LPCT seen=1 colo=6
      SHAPE tube rmin=0 rmax=FLGG_PhCathR dz=FLGG_PhCathDz/2.0
      IF ( FMCG_ChkvSim==1 ) THEN
      Call GSCKOV( %Imed,N,E,ABSCO_PhCath,EFFIC_PhCath,RINDEX_PhCath )
      HITS FPCT user:0:(0,100000)
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FUMT
      BLOCK FUMT   is mu metal
      MATERIAL iron
      ATTRIBUTE LUMT seen=1 colo=5
      SHAPE tube rmin=FLGG_PhCathR rmax=FLGG_MuMetR,
            dz=FLGG_MuMetDz/2.0
      IF ( fmcg_ChkvSim==1 ) THEN
      Call GSCKOV( %Imed,N,E,ABSCO_MuMet,EFFIC_All,RINDEX_MuMet )
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- PBPT
      BLOCK PBPT   is pb plate
      MATERIAL Lead
      ATTRIBUTE PBPT seen=1 colo=7
      SHAPE box dx=PBPD_Width/2.0 dy=PBPD_Height/2.0,
            dz=PBPD_Thick/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSHM
      BLOCK FSHM   is the SHower Max section
      MATERIAL Air
      ATTRIBUTE FSHM seen=1 colo=4
      SHAPE box dx=FMXG_G10Width/2.0 dy=FMXG_G10hgt/2.0,
            dz=ztotsmd
      wsmd=FMXG_Sbase/2.0 + FMXG_Sgap
      wtotsmd=(FMXG_Nstrip + 1)*wsmd
      zsmd= - ztotsmd + FMXG_G10Thick/2.0
      CREATE FXGT
      CALL AgsReset 
      CALL agml_position_begin('FXGT') 
      %title = 'FXGT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmd) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      xsmdv= - wtotsmd/2.0 - FMXG_Sgap/2.0 + wsmd
      ysmdv=0.0
      zsmdv=zsmd + FMXG_G10Thick/2.0 + FMXG_Sapex/2.0
      DO i = 1, FMXG_Nstrip
      IF ( mod(i,2)!=0 ) THEN
      CREATE FHMS
      CALL AgsReset 
      CALL agml_position_begin('FHMS') 
      %title = 'FHMS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xsmdv) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ysmdv) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmdv) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE FHMS
      CALL AgsReset 
      CALL agml_position_begin('FHMS') 
      %title = 'FHMS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xsmdv) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ysmdv) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmdv) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      xsmdv=xsmdv+wsmd
      END DO
      zsmd2=zsmdv + FMXG_G10Thick/2.0 + FMXG_Sapex/2.0
      CREATE FXGT
      CALL AgsReset 
      CALL agml_position_begin('FXGT') 
      %title = 'FXGT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmd2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      xsmdh=0.0
      ysmdh= - wtotsmd/2.0 - FMXG_Sgap/2.0 + wsmd
      zsmdh=zsmd2 + FMXG_G10Thick/2.0 + FMXG_Sapex/2.0
      CREATE FHMS
      DO i = 1, FMXG_Nstrip
      IF ( mod(i,2)!=0 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('FHMS') 
      %title = 'FHMS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xsmdh) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ysmdh) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmdh) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('Y-XZ'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CALL AgsReset 
      CALL agml_position_begin('FHMS') 
      %title = 'FHMS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xsmdh) 
      CALL agml_translate_x( %x ) 
      ag_y = real(ysmdh) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zsmdh) 
      CALL agml_translate_z( %z ) 
      CALL agml_ortho('YX-Z'//char(0)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ysmdh=ysmdh+wsmd
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FXGT
      BLOCK FXGT   is the G10 layer in the SMax
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      COMPONENT O A=16 Z=8 W=0.4*4*16./174.
      MIXTURE g10 dens=1.7
      ATTRIBUTE FXGT seen=1 colo=7
      SHAPE box dx=FMXG_G10Width/2 dy=FMXG_G10hgt/2,
            dz=FMXG_G10Thick/2
      Call GStPar(ag_imed, 'CUTGAM',0.00001)
      Call GStPar(ag_imed, 'CUTELE',0.00001)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHMS
      BLOCK FHMS   is sHower Max Strip
      MATERIAL POLYSTYREN
      MATERIAL Cpolystyren isvol=1
      ATTRIBUTE FHMS seen=1 colo=2
      SHAPE trd1 dx1=0 dx2=fmxg_Sbase/2.0 dy=FMXG_G10hgt/2.0,
            dz=fmxg_Sapex/2.0
      Call GStPar(ag_imed, 'CUTGAM',0.00008)
      Call GStPar(ag_imed, 'CUTELE',0.001)
      Call GStPar(ag_imed, 'BCUTE',0.0001)
      Call GStPar(ag_imed, 'BIRK1', 1.)
      Call GStPar(ag_imed, 'BIRK2', 0.0130)
      Call GStPar(ag_imed, 'BIRK3', 9.6E-6)
      HITS FHMS birk:0:(0,10)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPRS
      BLOCK FPRS   is box for plastic schinti FMS pre-shower detectors
      MATERIAL Air
      MEDIUM standard
      ATTRIBUTE FPRS seen=1 colo=2
      SHAPE pgon phi1=45 dphi=360 npdiv=4 nz=2,
            zi={-PRSW_DBox(3)/2.0,PRSW_DBox(3)/2.0} rmn={PRSW_DHole-PRSW_DxBbd(1),
            PRSW_DHole-PRSW_DxBbd(1)},
            rmx={PRSW_DBox(1)/2.0,PRSW_DBox(1)/2.0}
      debug=1
      IF ( debug.ge.1 ) THEN
      npstype=0
      cpstype(1)=1
      cpstype(2)=2
      cpstype(3)=6
      cpstype(4)=3
      cpstype(5)=4
      cpstype(6)=7
      cpstype(7)=5
      cpstype(8)=8
      open(11,file='fpsgeom.txt',status='REPLACE')
      ENDIF
      serN=1
      dx=PRSW_DBox(1)/2.0
      dy=PRSW_DBox(2)/2.0
      dz=PRSW_Dz(1)/2.0 + PRSW_DzBbd(1)/2.0 + PRSW_DSIPM(1)/2.0
      zz= - PRSW_Dbox(3)/2.0 + dz
      CREATE FPLY
      CALL AgsReset 
      CALL agml_position_begin('FPLY') 
      %mother = 'FPRS' 
      %title = 'FPLY' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      serN=2
      dx=PRSW_DBox(1)/2.0
      dy=PRSW_DBox(2)/2.0
      dz=PRSW_Dz(2)/2.0 + PRSW_DzBbd(2)/2.0 + PRSW_DSIPM(1)/2.0
      zz= - PRSW_Dbox(3)/2.0 + dz + PRSW_Zoff(2) - PRSW_Zoff(1)
      CREATE FPLY
      CALL AgsReset 
      CALL agml_position_begin('FPLY') 
      %mother = 'FPRS' 
      %title = 'FPLY' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      serN=3
      dx=PRSW_DBox(1)/2.0
      dy=PRSW_DBox(2)/2.0
      dz=PRSW_Dz(3)/2.0 + PRSW_DzBbd(3)/2.0
      zz= - PRSW_Dbox(3)/2.0 + PRSW_DSIPM(1) + dz - PRSW_DzBbd(3)/2.0 + PRSW_Zoff(3) _
            - PRSW_Zoff(1)
      dzsb = PRSW_Dz(3)/2.0 + PRSW_DzBbd(3)/4.0
      CREATE FPLY
      CALL AgsReset 
      CALL agml_position_begin('FPLY') 
      %mother = 'FPRS' 
      %title = 'FPLY' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      serN=4
      dx=PRSW_DBox(1)/2.0
      dy=PRSW_DBox(2)/2.0
      dz=PRSW_Dz(4)/2.0 + PRSW_DzBbd(4)/2.0 + PRSW_DSIPM(1)/2.0
      zz= - PRSW_Dbox(3)/2.0 + dz + PRSW_DSIPM(1) + PRSW_Zoff(4) - PRSW_Zoff(1) - _
            PRSW_DzBbd(4)
      CREATE FPLY
      CALL AgsReset 
      CALL agml_position_begin('FPLY') 
      %mother = 'FPRS' 
      %title = 'FPLY' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF ( debug.ge.1 ) THEN
      open(10,file='prs.txt',status='REPLACE')
      k=0
      DO i = 1, npstype
      DO j = 1, npstype
      IF ( i.eq.cpstype(j) ) THEN
      k=k+pstype(j)
      ENDIF
      END DO
      END DO
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPST
      BLOCK FPST   is box for plastic schinti FMS post-shower detectors layer 2-6
      MATERIAL Air
      MEDIUM standard
      ATTRIBUTE FPST seen=1 colo=2
      SHAPE pgon phi1=45 dphi=360 npdiv=4 nz=2,
            zi={-POST_DBox(3)/2.0,POST_DBox(3)/2.0} rmn={POST_DHole/2.0,
            POST_DHole/2.0} rmx={POST_DBox(1)/2.0,
            POST_DBox(1)/2.0}
      debug=0
      IF ( debug.ge.1 ) THEN
      open(12,file='fpostgeom.txt',status='REPLACE')
      ENDIF
      wid=POST_ScWidth + POST_ScWrap
      serN=0
      DO sn = 1, 2
      DO layr = 1, 6
      IF ( POST_Nslat(layr,sn).gt.0 ) THEN
      IF ( layr.eq.1 ) THEN
      dx=wid*9+1.0
      dy=POST_ScLth(2)/2.0+1.0
      ELSEIF ( layr.le.3 ) THEN
      dx=64.0
      dy=POST_ScLth(2)/2.0
      ELSE
      dx=POST_ScLth(2)/2.0+1.0
      dy=POST_ScLth(1)+1.0
      ENDIF
      xx=POST_Xoff(layr,sn)
      yy=POST_Yoff(layr,sn)
      dz=(POST_ScThick+POST_BPdz)/2.0
      zz=POST_Zoff(layr,sn)-(POST_Zoff(1,1)+POST_Dbox(3)/2.0-2.0)+POST_BPdz/2.0
      IF ( layr.eq.3 ) THEN
      zz=POST_Zoff(layr,sn)-(POST_Zoff(1,1)+POST_Dbox(3)/2.0-2.0)-POST_BPdz/2.0
      ENDIF
      serN=serN+1
      CREATE FTLY
      CALL AgsReset 
      CALL agml_position_begin('FTLY') 
      %mother = 'FPST' 
      %title = 'FTLY' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'ONLY' 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      END DO
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPLY
      BLOCK FPLY   is a layer of FMS Preshower
      MATERIAL Air
      MEDIUM standard
      ATTRIBUTE FPLY seen=0 colo=3 serial=serN
      SHAPE pgon phi1=45 dphi=360 npdiv=4 nz=2,
            zi={-dz,dz} rmn={PRSW_DHole-PRSW_DxBbd(1),PRSW_DHole-PRSW_DxBbd(1)},
            rmx={PRSW_DBox(1)/2.0,
            PRSW_DBox(1)/2.0}
      lprs1=PRSW_NPrs(1)*(PRSW_DPrs(1) + PRSW_DPrs(3))
      lprs2=PRSW_NPrs(2)*(PRSW_DPrs(2) + PRSW_DPrs(3)) + lprs1
      lprs3=(PRSW_NPrs(2) - PRSW_NSkipH)*(PRSW_DPrs(2) + PRSW_DPrs(3)) + lprs1
      lprs4=(PRSW_NPrs(1) - PRSW_NSkipV)*(PRSW_DPrs(1) + PRSW_DPrs(3)) + PRSW_NPrs(2)*(PRSW_DPrs(2) _
            + PRSW_DPrs(3))
      dlg=(PRSW_DLG(2) + PRSW_DLG(3) + PRSW_DSIPM(1))/2.0
      k   = 0
      dzz = PRSW_DZ(serN)/2.0
      IF ( serN.eq.3 ) THEN
      ! Pb in middle, back plate in front and back
      z1=0
      z2=0
      ELSEIF ( serN.eq.4 ) THEN
      ! back board first for layer3
      z1=-dz+PRSW_DzBbd(serN)+dzz       ! z for schinti
      z2=-dz+PRSW_DzBbd(serN)/2.0       ! z for back board
      ELSE
      ! back board 2nd for layer1,2
      z1=-dz+PRSW_DSIPM(1)+dzz          ! z for schinti
      z2=-dz+PRSW_DSIPM(1)+dzz*2+PRSW_DzBbd(serN)/2.0 ! z for back board
      ENDIF
      z = PRSW_Zoff(serN)
      CREATE FPSC
      CREATE FOSC
      CREATE FLIG
      CREATE FLLG
      CREATE WPAR
      CREATE FPBB
      CREATE FPPB
      IF ( debug.ge.1 .and. serN.eq.1 ) THEN
      open(1,file='prs1map.txt',status='REPLACE')
      ENDIF
      IF ( debug.ge.1 .and. serN.eq.2 ) THEN
      open(2,file='prs2map.txt',status='REPLACE')
      ENDIF
      IF ( debug.ge.1 .and. serN.eq.3 ) THEN
      open(3,file='prsCmap.txt',status='REPLACE')
      ENDIF
      IF ( debug.ge.1 .and. serN.eq.4 ) THEN
      open(4,file='prs3map.txt',status='REPLACE')
      ENDIF
      IF ( serN.le.2 ) THEN
      layr=serN
      ELSE
      layr=serN-1
      ENDIF
      IF ( serN.eq.1 ) THEN
      DO lr = 1, 2
      DO tb = 1, 2
      x=0.0
      quad=(lr-1)*2+tb
      slat(quad,layr)=0
      DO j = 1, 2
      DO i = 1, PRSW_NPrs(j)
      dxx = PRSW_DPrs(j)/2.0
      x = x + dxx + PRSW_DPrs(3)/2.0
      IF ( tb.eq.1 ) THEN
      pwid=lprs2
      ELSE
      pwid=lprs3-PRSW_DyCut
      ENDIF
      IF ( x.le.PRSW_DHole ) THEN
      dyy = (pwid-PRSW_DHole)/2.0
      y   = dyy+PRSW_DHole
      ELSE
      dyy = pwid/2.0
      y   = dyy
      ENDIF
      yy=y+dyy+dlg
      IF ( tb.eq.1 ) THEN
      rot = 0
      ENDIF
      IF ( tb.eq.2 ) THEN
      y = -y; yy = -yy; rot = 180;
      ENDIF
      IF ( lr.eq.1 ) THEN
      xx = +x+PRSW_Xoff(serN)
      ENDIF
      IF ( lr.eq.2 ) THEN
      xx = -x-PRSW_Xoff(serN)
      ENDIF
      y=y+PRSW_Yoff(serN); yy=yy+PRSW_Yoff(serN);
      IF ( tb.eq.1 .or. j.eq.2 .or. i.gt.PRSW_NSkipV ) THEN
      IF ( debug.ge.1 ) THEN
      k   = k+1
      slat(quad,layr)=slat(quad,layr)+1
      id=(quad-1)*3*21+(layr-1)*21+(slat(quad,layr)-1)
      flag=0
      DO kk = 1, npstype
      IF ( (psdim(kk,1).eq.dxx.and.psdim(kk,2).eq.dyy).or.(psdim(kk,1).eq.dyy.and.psdim(kk,
            2).eq.dxx) ) THEN
      flag=kk
      pstype(kk)=pstype(kk)+1
      ENDIF
      END DO
      IF ( flag.eq.0 ) THEN
      npstype=npstype+1
      flag=npstype
      pstype(flag)=1
      IF ( dxx.gt.dyy ) THEN
      psdim(npstype,1)=dyy
      psdim(npstype,2)=dxx
      ELSE
      psdim(npstype,1)=dxx
      psdim(npstype,2)=dyy
      ENDIF
      ENDIF
      ENDIF
      CALL AgsReset 
      CALL agml_position_begin('FPSC') 
      %title = 'FPSC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1) 
      CALL agml_translate_z( %z ) 
      %dx = real(dxx) 
      %dy = real(dyy) 
      %dz = real(dzz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF j.eq.1 { 
      CALL AgsReset 
      CALL agml_position_begin('FLIG') 
      %title = 'FLIG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      ag_alphax = -90.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = real(rot) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF j.eq.1 
      IF j.eq.2 { 
      CALL AgsReset 
      CALL agml_position_begin('FLLG') 
      %title = 'FLLG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      ag_alphax = -90.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = real(rot) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF j.eq.2 
      ENDIF
      x = x + dxx
      END DO
      END DO
      END DO
      END DO
      ELSEIF ( serN.eq.2 .or. serN.eq.4 ) THEN
      DO lr = 1, 2
      DO tb = 1, 2
      y=0.0
      quad=(lr-1)*2+tb
      slat(quad,layr)=0
      DO j = 1, 2
      DO i = 1, PRSW_NPrs(j)
      dyy = PRSW_DPrs(j)/2.0
      y = y + dyy + PRSW_DPrs(3)/2.0
