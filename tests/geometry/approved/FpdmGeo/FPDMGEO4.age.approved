      MODULE FPDMGEO4    is the Forward Pion Detector Modules GEOmetry
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Created    27 Nov 2006
      Author Akio Ogawa
      +CDE,agecom.
      +CDE,gconst.
      +CDE,gcunit.
      CONTENT FBOX,FTOW,FLXF,FWAL,FLGR,FPCT,FUMT,
      PBPT,FSHM,FHMS,FXGT,FALU,FBAS,FENC,
      FEAC,FEBC,FECC,FEDC,FETC,FERC,FESC,
      FEEC,FPRS,FPLY,FPPB,FPSC,FPBB,
      FLIG,FLBA,FLCO,FPMT,FFEE,
      FLLG,FBLL,FCLL,
      WPPL,WPIS,WPUF,WPUN,WPUS,WPAR,
      FPST,FTLY,FOSC
      STRUCTURE FMCG { Version,ChkvSim,PbPlate,FmsNorthX,FmsSouthX,Atten,int postshower}
      STRUCTURE FPOS { iMod,iType,X,Y,Z,AY,AZ}
      STRUCTURE FBXD { Type,Height,Depth,Width,NX,NY,NXL,NYL,XOffset,ZOffset,PSOffset,
            SmdOff}
      STRUCTURE FLGG { Type,Width,Depth,DGap,AlThick,PhCathDz,PhCathR,MuMetDz,MuMetR}
      STRUCTURE FLGM { Type,Density,RadLen,PbCont,CritEne,MoliereR}
      STRUCTURE PBPD { Z,Width,Height,Thick}
      STRUCTURE FMXG { Version,Sapex,Sbase,Sgap,NStrip,G10Width,G10hgt,G10Thick}
      STRUCTURE INSE { Width,Depth,Height,SheetDpt,HoleGap,HoleDepth,HoleHeight,GapDepth,
            GapHeight,GateDepth,Ra,Rb,Diam,RMax,GateGap}
      STRUCTURE PRSW { DBox(3),Xoff(4),Yoff(4),Zoff(4),Dz(4),DHole,NType,NPrs(2),
            DPrs(3),NSkipV,NSkipH,DyCut,DLG(3),DSIPM(4),DzBbd(4),DxBbd(2)}
      STRUCTURE POST { DBox(3),DHole,ScThick,ScWidth,ScWrap,ScLth(10),Xoff(6,2),Yoff(6,
            2),Zoff(6,2),Nslat(6,2),AngSlat(6,2),BPdz}
      STRUCTURE WPFM { PoleD(4),PoleP(3),IstrD(4),Ist1P(3),Ist2P(3),UstFD(4),UstFP(3),
            UstND(4),UstNP(3),UstSD(4),UstSP(3)}
      INTEGER ChkvSim,iMod,iType,Type,PbPlate

      INTEGER i,j,k,kk,m,serN,lr,tb,col,kmod,rot,id,layr,quad,slat(4,3),sn,    debug,
            npstype,pstype(20),cpstype(20),flag

      INTEGER ch

      REAL xx,yy,zz,x1,y1,z1,ztot,rtot,wid,widx,widy,bwid,x0,widL,dx,dy,dz,dxx,dyy,
            dzz,    xxx,yyy,zzz,dxxx,dyyy,xpmt,ypmt,    dx1,dy1,dz1,dx2,dy2,dz2,x2,y2,z2,dz3,
            dx1a,dx1b,dzsb,psdim(20,2),h,d,r45,ang;

      REAL sqrt2/1.414213562373095/

      REAL ztotsmd,wtotsmd,zsmd,zsmd2,wsmd

      REAL xsmdh,ysmdh,zsmdh,xsmdv,ysmdv,zsmdv

      REAL xlcOffSet,BZOffSet

      REAL basewidth,distancer,xoffFECC,xoffFEDC,xshift

      REAL xoffFENC,yoffFENC,zoffFENC,zoffFECC

      REAL tmp(7)

      INTEGER N

      PARAMETER (N = 12)
      REAL E(N)

      REAL rindex_PbG(N)

      REAL rindex_SiRub(N)

      REAL rindex_PhCath(N)

      REAL rindex_Alm(N)

      REAL rindex_MuMet(N)

      REAL absco_PbG(N)

      REAL absco_SiRub(N)

      REAL absco_PhCath(N)

      REAL absco_Alm(N)

      REAL absco_MuMet(N)

      REAL effic_PhCath(N)

      REAL effic_all(N)

      REAL lprs1,lprs2,lprs3,lprs4,pwid,x,y,z,dlg

      EXTERNAL FFPDSTEP
      EXTERNAL FPCTSTEP
      FILL FMCG		! Fpd Calorimeter basic data
      Version = 9.0 !  Geometry version
      ChkvSim = 0 !  = 0 dE, = 1 Cherenkov simulation for PbG
      PbPlate = 0 !  =0 no plate, =1 with plate
      FmsNorthX = -2.0 ! Default x-position
      FmsSouthX = +5.0 ! Default x-position
      Atten = 0.0 ! default, no attenuation, 1 = attenuation
      postshower = 0 ! 0: no postshower 1: yes postshower
      ENDFILL
      use FMCG version=9.0
      FILL FPOS		! Fpd EN positioning
      iMod = 1 !  Module# (EN=1, ES=2, WN=3, WS=4, ...)
      iType = 1 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      X = -48.19 !  X distance from beam to edge of detector
      Y = 0.0 !  Y distance from beam to edge of detector
      Z = -779.0 !  Z distance from IP to surface of detector
      AY = 180 !  Angle aroound Y (0 for west, 180 for east)
      AZ = 0 !  Angle around Z
      ENDFILL
      FILL FPOS		! Fpd ES positioning
      iMod = 2 !  Module# (EN=1, ES=2, WS=3, WS=4, ...)
      iType = 1 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      X = 48.19 !  X distance from beam to edge of detector
      Y = 0.0 !  Y distance from beam to edge of detector
      Z = -779.0 !  Z distance from IP to surface of detector
      AY = 180 !  Angle aroound Y (0 for west, 180 for east)
      AZ = 0 !  Angle around Z
      ENDFILL
      FILL FPOS		! FMS WN positioning
      iMod = 3 !  Module# (EN=1, ES=2, WN=3, WS=4, ...)
      iType = 2 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      X = FMCG_FmsNorthX !  X distance from beam to edge of detector
      Y = 0.0 !  Y distance from beam to edge of detector
      Z = 706.3 !  Z distance from IP to surface of detector
      AY = 0 !  Angle aroound Y (0 for west, 180 for east)
      ENDFILL
      FILL FPOS		! FMS WS positioning
      iMod = 4 !  Module# (EN=1, ES=2, WN=3, WS=4, ...)
      iType = 2 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      X = FMCG_FmsSouthX !  X distance from beam to edge of detector
      Y = 0.0 !  Y distance from beam to edge of detector
      Z = 706.3 !  Z distance from IP to surface of detector
      AY = 0 !  Angle aroound Y (0 for west, 180 for east)
      AZ = 0 !  Angle around Z
      ENDFILL
      FILL FBXD		! FPD Box Geometry
      Type = 1 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      Height = 100 !  Box height
      Depth = 96 !  Box Depth
      Width = 0.0 !  Box Width (only for FMS)
      NX = 7 !  Number of pbg in x
      NY = 7 !  number of pbg in y
      NXL = 0 !  Number of large pbg in x
      NYL = 0 !  number of large pbg in y
      XOffset = 2.54 !  tower x offset from box edge to PbG edge
      ZOffset = 19 !  tower z offset from box edge to PbG edge
      PSOffset = 2.0 !  PreShower z offset from box edge to PbG edge
      SmdOff = 8.0 !  SMD V-plane z offset from box edge
      ENDFILL
      FILL FBXD		! FPD Box Geometry
      Type = 2 !  Type (1=7*7+SMD+PreShower, 2=17*34+14*28)
      Height = 212 !  Box height
      Depth = 98.425 !  Box Depth
      Width = 127.0 !  Box Width (only for FMS)
      NX = 12 !  Number of pbg in x
      NY = 24 !  number of pbg in y
      NXL = 17 !  Number of large pbg in x
      NYL = 34 !  number of large pbg in y
      XOffset = (6*3.822+0.5*5.812)+(127.0-17*5.812)/2.0 !  tower x offset from box edge to PbG edge
      ZOffset = 10.4 !  tower z offset from box edge to PbG edge
      PSOffset = 0 !  PreShower z offset from box edge to PbG edge
      SmdOff = 0.0 !  SMD z offset from box edge
      ENDFILL
      FILL FLGG		! PbG detector geometry
      Type = 1 !  Type (1=Protovino Cell, 2=FLab Cell)
      Width = 3.81 !  PbG width
      Depth = 45.0 !  PbG depth
      DGap = 0.01 !  Gap between PbG
      AlThick = 0.001 !  almunim wrap thickness (real)
      PhCathDz = 2.0 !  Photo Cathode thickness
      PhCathR = 1.8 !  Photo Cathode radius  (real)
      MuMetDz = 11.0 !  Mu Metal Length
      MuMetR = 1.9 !  Mu metal outer Radius  (real)
      ENDFILL
      FILL FLGG		! PbG detector geometry
      Type = 2 !  Type (1=Protovino Cell, 2=FLab Cell)
      Width = 5.8 !  PbG width
      Depth = 60.2 !  PbG depth
      DGap = 0.01 !  Gap between PbG
      AlThick = 0.001 !  almunim wrap thickness (real)
      PhCathDz = 2.0 !  Photo Cathode thickness
      PhCathR = 1.8 !  Photo Cathode radius  (real)
      MuMetDz = 11.0 !  Mu Metal Length
      MuMetR = 1.9 !  Mu metal outer Radius  (real)
      ENDFILL
      FILL FLGM		! PbG detector materials
      Type = 1 !  Type (1=Protovino Cell, 2=FLab Cell)
      Density = 3.86 !  gdensity [/cm^3]
      RadLen = 2.5 !  radiation length [cm]
      PbCont = 65.4 !  PbO content [%]
      CritEne = 0.0158 !  critical energy [GeV]
      MoliereR = 3.32 !  Moliere radius [cm]
      ENDFILL
      FILL FLGM		! PbG detector materials
      Type = 2 !  Type (1=Protovino Cell, 2=FLab Cell)
      Density = 3.61 !  gdensity [/cm^3]
      RadLen = 3.21 !  radiation length [cm]
      PbCont = 45.0 !  PbO content [%]
      ENDFILL
      FILL PBPD		! Pb Plate dimensions
      Width = 33.02 !  Width
      Height = 33.02 !  Height
      Thick = 1.27 !  Thickness
      ENDFILL
      FILL FMXG		! SMD geometry
      Version = 2 !  Geometry version
      Sapex = 0.7 !  Scintillator strip apex
      Sbase = 1.0 !  Scintillator strip base
      Sgap = 0.0064 !  Gap between strips
      NStrip = 50 !  # of strips
      G10Width = 27.0 !  G10 plate width
      G10hgt = 27.0 !  G10 plate height
      G10Thick = 0.15 !  G10 plate thickness
      ENDFILL
      FILL INSE		! INSERT geometry
      Width = 19.30908 !  Width of the insert (x)
      Depth = 98.425 !  Depth of the insert (z)
      Height = 38.608 !  Height of the insert (y)
      SheetDpt = 1.27 !  Depth of the steel parts (x,y)
      HoleGap = 5.08 !  Distance between edge of INSERT and square hole
      HoleDepth = 25.4 !  Depth of the square hole (z)
      HoleHeight = 30.48 !  Height of the square hole (y)
      GapDepth = 19.685 !  Depth of the iron distancer (z)
      GapHeight = 7.874 !  Height of the iron distancer (y)
      GateDepth = 1.905 !  Depth of one of the three Gates (z)
      GateGap = 12.7 !  Distance between the back edge of the box and last gate
      Ra = 13.97 !  Radius of the inner circle of tubes
      Rb = 20.6375 !  Radius of the outer circle of tubes
      Diam = 6.0325 !  Diameter of the tubes
      RMax = 10.16 !  Radius of the inner tube for beampipe
      ENDFILL
      FILL POST		! Post Shower geometry
      DBox  = {  225.0,  250.0,   64.0} !  None
      DHole = 42.00 ! None
      ScThick = 1.0 ! Scintillator thickness, cm
      ScWidth = 5.0 ! Scintillator width
      ScWrap = 0.025 ! Scintillator wrapping thickness
      ScLth  = {    108.0,     85.0,  113.137,  103.087, 
                   93.037,   82.987,   72.937,   62.887, 
                   52.837,   42.787} !  length of type s1,s2,s3,s3-1,s3-2,s3-3,s3-4,s3-5,s3-6,s3-7
      Xoff  = {      0.0,   39.085,      0.0,   67.925, 
                  67.925,   68.125;
                     0.0,      0.0,  -39.085,  -67.925, 
                 -67.925,  -68.125} !  None
      Yoff  = {   65.5,   65.5,    0.0,  0.877,    0.0,    0.0, 
              ;
                   0.0,    0.0,   65.5,  0.877,    0.0,    0.0} !  None
      Zoff  = {  815.899,  838.259,    0.000,  848.419, 
                 857.944,  867.469;
                   0.000,    0.000,  840.529,  847.784, 
                 857.309,  866.834} !  None
      Nslat  = {   9,  14,   0,  25,  43,  34;
                   0,   0,  14,  25,  43,  34} !  None
      AngSlat  = {    0.0,  -45.0,  999.0,  -45.0,  -90.0, 
                      0.0;
                    999.0,  999.0,  225.0,  225.0,   90.0, 
                      0.0} !  None
      BPdz = 2.54/4.0 ! None
      ENDFILL
      FILL PRSW		! Pre Shower geometry
      DBox  = {  225.0,    250,   22.0} !  None
      Xoff  = {  1.0,  1.0,  1.0,  1.0} !  None
      Yoff  = {  0.0,  0.0,  0.0,  0.0} !  None
      Zoff  = {  675.64,  678.52,  690.29,  692.22} !  None
      Dz  = {    1.0,    1.0,  0.635,    1.0} !  None
      DHole = 20.25 ! None
      NType = 2 ! None
      NPrs  = {  12,   9} !  None
      DPrs  = {   4.0,   5.8,  0.05} !  None
      NSkipV = 2 ! None
      NSkipH = 2 ! None
      DyCut = 3.0+5.8 ! None
      DLG  = {  0.3,  6.0,  1.0} !  None
      DSIPM  = {  0.5,  3.5,  1.0,  7.0} !  None
      DzBbd  = {    2.54/8.0,    2.54/4.0,  2*2.54/4.0, 
                    2.54/4.0} !  None
      DxBbd  = {      2.54,  2.54+7.0} !  None
      ENDFILL
      FILL WPFM		! West Platform geometry
      PoleD  = {     12.0*2.54,  155.5 * 2.54,     12.0*2.54, 
                           1.0} !  None
      PoleP  = {                 72.0*2.54, 
                  (-44.36-10-155.5/2)*2.54, 
                            807.72-27*2.54} !  None
      IstrD  = {  231.0*2.54,    8.0*2.54,    8.0*2.54, 
                         1.0} !  None
      Ist1P  = {          -8.0*2.54,  (-44.36-5.0)*2.54, 
                     807.72-37*2.54} !  None
      Ist2P  = {          -8.0*2.54,  (-44.36-5.0)*2.54, 
                     807.72-17*2.54} !  None
      UstFD  = {  236.0*2.54,     12*2.54,      4*2.54, 
                         1.0} !  None
      UstFP  = {           -8.0*2.54,         -44.36*2.54, 
                  807.72-(46-2)*2.54} !  None
      UstND  = {       4*2.54,    12.0*2.54,  (46-4)*2.54, 
                          1.0} !  None
      UstNP  = {       -(118-2+8)*2.54,           -44.36*2.54, 
                  807.72-(46-4)*2.54/2} !  None
      UstSD  = {       4*2.54,    12.0*2.54,  (46-4)*2.54, 
                          1.0} !  None
      UstSP  = {       +(118-2-8)*2.54,           -44.36*2.54, 
                  807.72-(46-4)*2.54/2} !  None
      ENDFILL
      use FMCG
      Prin1 fmcg_version;
      ('****************** FPDMGEO version ', F4.2)
      DO m = 1, 4
      use FPOS iMod=m
      use FBXD Type=FPOS_iType
      IF ( FBXD_Type.eq.1 ) THEN
      use FLGG Type=1
      wid  =  FLGG_Width + FLGG_DGap + FLGG_AlThick*2.0
      ztot = (FLGG_Depth + FLGG_AlThick + FLGG_MuMetDz)/2.0
      rtot = FBXD_NX*wid/2.0
      bwid = rtot+FBXD_XOffset
      ELSE
      use FLGG Type=2
      wid  =  FLGG_Width + FLGG_DGap + FLGG_AlThick*2.0
      ztot = (FLGG_Depth + FLGG_AlThick + FLGG_MuMetDz)/2.0
      rtot = FBXD_NXL*wid/2.0
      bwid = rtot
      ENDIF
      IF ( m.ge.3 ) THEN
      bwid=FBXD_Width/2.0
      IF ( FPOS_X.gt.0.0 ) THEN
      xx=FPOS_X+bwid
      ELSEIF ( FPOS_X.eq.0.0 ) THEN
      xx=0.0
      ELSE
      xx=FPOS_X-bwid
      ENDIF
      ELSE
      IF ( FPOS_X.gt.0.0 ) THEN
      xx=FPOS_X+bwid
      ELSEIF ( FPOS_X.eq.0.0 ) THEN
      xx=0.0
      ELSE
      xx=FPOS_X-bwid
      ENDIF
      ENDIF
      IF ( FPOS_Y.gt.0.0 ) THEN
      yy=FPOS_Y+FBXD_Height/2.0
      ELSEIF ( FPOS_Y.eq.0.0 ) THEN
      yy=0.0
      ELSE
      yy=FPOS_Y-FBXD_Height/2.0
      ENDIF
      IF ( FPOS_Z.gt.0.0 ) THEN
      zz=FPOS_Z+FBXD_Depth/2.0
      ELSE
      zz=FPOS_Z-FBXD_Depth/2.0
      ENDIF
      serN=0
      IF ( m.eq.4 ) THEN
      serN=1
      ENDIF
      IF ( m.ne.7 ) THEN
      CREATE FBOX
      IF zz>0 { 
      CALL AgsReset 
      CALL agml_position_begin('FBOX') 
      %mother = 'CAVE' 
      %title = 'FBOX' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(FPOS_AY) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF zz>0 
      IF zz<0 { 
      CALL AgsReset 
      CALL agml_position_begin('FBOX') 
      %mother = 'CAVE' 
      %title = 'FBOX' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(xx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yy) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zz) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(FPOS_AY) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF zz<0 
      ENDIF
      END DO
      CREATE FPRS
      CALL AgsReset 
      CALL agml_position_begin('FPRS') 
      %mother = 'CAVE' 
      %title = 'FPRS' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_Zoff(1)-PRSW_DSIPM(1)+PRSW_Dbox(3)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF ( FMCG_postshower.eq.1 ) THEN
      CREATE FPST
      CALL AgsReset 
      CALL agml_position_begin('FPST') 
      %mother = 'CAVE' 
      %title = 'FPST' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'ONLY' 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(POST_Zoff(1,1)-2.0+POST_Dbox(3)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      CREATE WPPL
      CALL AgsReset 
      CALL agml_position_begin('WPPL') 
      %mother = 'CAVE' 
      %title = 'WPPL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_PoleP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_PoleP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_PoleP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPPL') 
      %mother = 'CAVE' 
      %title = 'WPPL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-WPFM_PoleP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_PoleP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_PoleP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPIS
      CALL AgsReset 
      CALL agml_position_begin('WPIS') 
      %mother = 'CAVE' 
      %title = 'WPIS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(WPFM_Ist1P(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_Ist1P(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_Ist1P(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPIS') 
      %mother = 'CAVE' 
      %title = 'WPIS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(WPFM_Ist2P(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_Ist2P(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_Ist2P(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUF
      CALL AgsReset 
      CALL agml_position_begin('WPUF') 
      %mother = 'CAVE' 
      %title = 'WPUF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstFP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstFP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstFP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUN
      CALL AgsReset 
      CALL agml_position_begin('WPUN') 
      %mother = 'CAVE' 
      %title = 'WPUN' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstNP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstNP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstNP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE WPUS
      CALL AgsReset 
      CALL agml_position_begin('WPUS') 
      %mother = 'CAVE' 
      %title = 'WPUS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstSP(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(WPFM_UstSP(2)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstSP(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- FBOX
      BLOCK FBOX   is one Pb-Glass fpd detector
      MATERIAL Air
      MEDIUM standard
      ATTRIBUTE FBOX seen=1 colo=2 serial=serN
      IF ( FBXD_Type.eq.2 ) THEN
      SHAPE box dx=FBXD_Width/2.0 dy=FBXD_Height/2.0,
            dz=FBXD_Depth/2.0
      ELSE
      SHAPE box dx=bwid dy=FBXD_Height/2.0 dz=FBXD_Depth/2.0
      ENDIF
      use FLGG Type=2
      widL = FLGG_Width + FLGG_DGap + FLGG_AlThick*2.0
      use FLGG Type=1
      use FLGM Type=1
      wid  =  FLGG_Width + FLGG_DGap + FLGG_AlThick*2.0
      ztot =(FLGG_Depth + FLGG_AlThick + FLGG_MuMetDz)/2.0
      rtot = FBXD_NX*wid/2.0
      bwid = rtot - FBXD_XOffset
      CREATE FTOW
      CREATE PBPT
      CREATE FSHM
      IF ( FBXD_Type.eq.2.and.FPOS_iMod.eq.4 ) THEN
      x0 = - rtot - FBXD_XOffset + wid/2.0
      widx = wid
      ELSE
      x0 =  rtot + FBXD_XOffset - wid/2.0
      widx = -wid
      ENDIF
      IF ( FBXD_Type.eq.2 ) THEN
      y1 =  FBXD_NY*wid/2.0 - wid/2.0 + (16*widL-FBXD_NY*wid)/2.0
      widy = wid+(16.0*widL-FBXD_NY*wid)/23.0
      ELSE
      y1 =  FBXD_NY*wid/2.0 - wid/2.0
      widy = wid
      ENDIF
      z1 = - FBXD_Depth/2.0 + FBXD_ZOffset + ztot
      DO i = 1, FBXD_NY
      x1=x0
      DO j = 1, FBXD_NX
      IF ( FBXD_Type.eq.2.and.j.lt.6.and.i.gt.7.and.i.lt.18 ) THEN
      x1=x1+widx
      ELSE
      CREATE FTOW
      CALL AgsReset 
      CALL agml_position_begin('FTOW') 
      %title = 'FTOW' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x1) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y1) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x1=x1+widx
      ENDIF
      END DO
      y1 =  y1-widy
      END DO
      IF ( FBXD_Type.eq.1 ) THEN
      x1=x0
      y1= -rtot + ztot
      z1=-FBXD_Depth/2.0  + FBXD_PSOffset + wid/2.0
      DO j = 1, FBXD_NX
      CREATE FTOW
      CALL AgsReset 
      CALL agml_position_begin('FTOW') 
      %title = 'FTOW' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x1) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y1) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x1=x1-wid
      END DO
      IF ( fmcg_PbPlate==1 ) THEN
      CREATE PBPT
      CALL AgsReset 
      CALL agml_position_begin('PBPT') 
      %title = 'PBPT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(PBPD_Thick/2.0-FBXD_Depth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ztotsmd=FMXG_G10Thick+FMXG_Sapex
      CREATE FSHM
      CALL AgsReset 
      CALL agml_position_begin('FSHM') 
      %title = 'FSHM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(FBXD_SmdOff+ztotsmd-FBXD_Depth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      IF ( FBXD_Type.ge.2 ) THEN
      use FLGG Type=2
      use FLGM Type=2
      wid  = FLGG_Width + FLGG_DGap +  FLGG_AlThick*2.0
      ztot = FLGG_Depth/2.0
      rtot = FBXD_NXL*wid/2.0
      bwid = rtot
      xlcOffSet = (FBXD_Width-FBXD_NXL*wid)/2.0          ! Large Cells OffSet in X
      IF ( FPOS_iMod.eq.4 ) THEN
      x0 =  -bwid + wid/2.0 - xlcOffSet
      widx = wid
      ELSEIF ( FPOS_iMod.eq.3 ) THEN
      x0 =  +bwid - wid/2.0 + xlcOffSet
      widx = -wid
      ENDIF
      y1 =  FBXD_NYL*wid/2.0 - wid/2.0
      z1 = -FBXD_Depth/2.0 + FBXD_ZOffset + ztot
      DO i = 1, FBXD_NYL
      x1=x0
      DO j = 1, FBXD_NXL
      IF ( j.lt.9.and.i.gt.9.and.i.lt.26 ) THEN
      x1=x1+widx
      ELSEIF ( (i+j).ge.45 ) THEN
      CREATE FALU
      CALL AgsReset 
      CALL agml_position_begin('FALU') 
      %title = 'FALU' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x1) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y1) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x1=x1+widx
      ELSEIF ( (j-i).ge.10 ) THEN
      x1=x1+widx
      ELSE
      CREATE FLXF
      CALL AgsReset 
      CALL agml_position_begin('FLXF') 
      %title = 'FLXF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x1) 
      CALL agml_translate_x( %x ) 
      ag_y = real(y1) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z1) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      x1=x1+widx
      ENDIF
      END DO
      y1=y1-wid
      END DO
      ENDIF
      IF ( FBXD_Type.eq.2 ) THEN
      use FLGG Type=2
      use FLGM Type=2
      BZOffSet=0.0
      wid  = FLGG_Width + FLGG_DGap
      basewidth=1.0
      CREATE FBAS
      CALL AgsReset 
      CALL agml_position_begin('FBAS') 
      %title = 'FBAS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(FPOS_X) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(FBXD_NXL*wid+basewidth/2.0)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(-FBXD_Depth/2.0+BZOffSet+INSE_Depth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      CREATE FENC
      CREATE FEAC
      CREATE FECC
      CREATE FEDC
      CREATE FEEC
      distancer=INSE_GapHeight - (INSE_Height - 2.0*INSE_SheetDpt)
      xoffFECC=(INSE_SheetDpt - FBXD_Width)/2.0
      zoffFECC= - FBXD_Depth/2.0 + BZOffSet + INSE_Depth - INSE_GateGap
      xoffFEDC=INSE_Width - INSE_SheetDpt
      xoffFENC=(INSE_Width - FBXD_Width)/2.0
      yoffFENC=(INSE_Height - INSE_SheetDpt)/2.0
      zoffFENC= - FBXD_Depth/2.0 + BZOffSet + INSE_Depth/2.0
      xshift=8*5.812 - 12*3.822 + 5*3.822 - INSE_Width    !this is to move insert to small cell edge
      IF ( FBXD_Type.eq.2 ) THEN
      IF ( FPOS_iMod.eq.4 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('FENC') 
      %title = 'FENC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFENC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-yoffFENC) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFENC) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FENC') 
      %title = 'FENC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFENC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yoffFENC) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFENC) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEAC') 
      %title = 'FEAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(INSE_Width+xshift-(FBXD_Width+INSE_SheetDpt)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-FBXD_Depth/2.0+BZOffSet+INSE_Depth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFECC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFECC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*INSE_GateDepth-3.0*INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFECC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xoffFECC+xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*INSE_GateDepth-3.0*INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEDC') 
      %title = 'FEDC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xshift+(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEDC') 
      %title = 'FEDC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xshift+(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEDC') 
      %title = 'FEDC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xshift+(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*(INSE_GateDepth+INSE_GapDepth)-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( FPOS_iMod.eq.3 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('FENC') 
      %title = 'FENC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFENC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-yoffFENC) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFENC) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FENC') 
      %title = 'FENC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFENC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(yoffFENC) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFENC) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEAC') 
      %title = 'FEAC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xshift-INSE_Width+(FBXD_Width+INSE_SheetDpt)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-FBXD_Depth/2.0+BZOffSet+INSE_Depth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFECC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFECC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*INSE_GateDepth-3.0*INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFECC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FECC') 
      %title = 'FECC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xoffFECC-xshift) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-distancer/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*INSE_GateDepth-3.0*INSE_GapDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEEC') 
      %title = 'FEEC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xshift-(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEEC') 
      %title = 'FEEC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xshift-(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-INSE_GateDepth-INSE_GapDepth-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FEEC') 
      %title = 'FEEC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-xshift-(xoffFEDC-FBXD_Width)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zoffFECC-2.0*(INSE_GateDepth+INSE_GapDepth)-INSE_GateDepth/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTOW
      BLOCK FTOW   is one PbG Tower
      MATERIAL Air
      ATTRIBUTE FTOW seen=1 colo=2
      SHAPE box dx=wid/2.0 dy=wid/2.0 dz=ztot
      CREATE FWAL
      CALL AgsReset 
      CALL agml_position_begin('FWAL') 
      %title = 'FWAL' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-ztot+(FLGG_AlThick+FLGG_depth)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
