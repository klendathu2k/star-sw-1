             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 6;
// fpos_docum.imod = " Module# (EN=1, ES=2, ET=3, EB=4, WN=5...) ";
fpos.itype = 1;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=5*5) ";
fpos.x = 28.1;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 752.4;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 7;
// fpos_docum.imod = " Module# (EN=1, ES=2, ET=3, EB=4, WN=5...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=5*5) ";
fpos.x = 0.0;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 30.8;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 590.2;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 8;
// fpos_docum.imod = " Module# (EN=1, ES=2, ET=3, EB=4, WN=5...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=5*5) ";
fpos.x = 0.0;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = -30.2;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 590.2;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 1;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=5*5) ";
fbxd.height = 100;
// fbxd_docum.height = " Box height ";
fbxd.depth = 96;
// fbxd_docum.depth = " Box Depth ";
fbxd.nx = 7;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 7;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.xoffset = 2.54;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 19;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge       ";
fbxd.psoffset = 2.0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoffset = 8.0;
// fbxd_docum.smdoffset = " SMD V-plane z offset from box edge ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 2;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=5*5) ";
fbxd.height = 20;
// fbxd_docum.height = " Box height ";
fbxd.depth = 65;
// fbxd_docum.depth = " Box Depth ";
fbxd.nx = 5;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 5;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.xoffset = 0.0;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 1;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge ";
fbxd.psoffset = 0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoffset = 0.0;
// fbxd_docum.smdoffset = " SMD z offset from box edg ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgg
++flgg._index;
flgg.width = 3.81;
// flgg_docum.width = " PbG width  ";
flgg.depth = 45.0;
// flgg_docum.depth = " PbG depth ";
flgg.dgap = 0.01;
// flgg_docum.dgap = " Gap between PbG ";
flgg.althick = 0.001;
// flgg_docum.althick = " almunim wrap thickness (real) ";
flgg.phcathdz = 2.0;
// flgg_docum.phcathdz = " Photo Cathode thickness ";
flgg.phcathr = 1.8;
// flgg_docum.phcathr = " Photo Cathode radius  (real) ";
flgg.mumetdz = 11.0;
// flgg_docum.mumetdz = " Mu Metal Length ";
flgg.mumetr = 1.9;
// flgg_docum.mumetr = " Mu metal outer Radius  (real) ";
FLGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgm
++flgm._index;
flgm.density = 3.86;
// flgm_docum.density = " gdensity [/cm^3] ";
flgm.radlen = 2.5;
// flgm_docum.radlen = " radiation length [cm] ";
flgm.pbcont = 65.4;
// flgm_docum.pbcont = " PbO content [%] ";
flgm.critene = 0.0158;
// flgm_docum.critene = " critical energy [GeV] ";
flgm.molierer = 3.32;
// flgm_docum.molierer = " Moliere radius [cm] ";
FLGM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pbpd
++pbpd._index;
pbpd.width = 33.02;
// pbpd_docum.width = " Width ";
pbpd.height = 33.02;
// pbpd_docum.height = " Height ";
pbpd.thick = 1.27;
// pbpd_docum.thick = " Thickness ";
PBPD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fmxg
++fmxg._index;
fmxg.version = 2;
// fmxg_docum.version = " Geometry version ";
fmxg.sapex = 0.7;
// fmxg_docum.sapex = " Scintillator strip apex ";
fmxg.sbase = 1.0;
// fmxg_docum.sbase = " Scintillator strip base ";
fmxg.sgap = 0.0064;
// fmxg_docum.sgap = " Gap between strips ";
fmxg.nstrip = 50;
// fmxg_docum.nstrip = " # of strips ";
fmxg.g10width = 27.0;
// fmxg_docum.g10width = " G10 plate width ";
fmxg.g10height = 27.0;
// fmxg_docum.g10height = " G10 plate height ";
fmxg.g10thick = 0.15;
// fmxg_docum.g10thick = " G10 plate thickness ";
FMXG.fill();
        
             /// USE fmcg _index=1;        
             FMCG.use( __fmcg__index__ = 1 );
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             wid=flgg.width+flgg.dgap+flgg.althick*2;        
             ztot=(flgg.depth+flgg.althick+flgg.mumetdz)/2.0;        
             /// Loop on m from 1 to 8 step=1        
             for ( m=1; (1>0)? (m<=8):(m>=8); m+=1 )        
             {           
                   /// USE fpos imod=m;           
                   FPOS.use( __fpos_imod__ = m );
           
                   /// USE fbxd type=fpos.itype;           
                   FBXD.use( __fbxd_type__ = fpos.itype );
           
                   rtot=fbxd.nx*wid/2.0;           
                   bwid=rtot+fbxd.xoffset;           
                   if ( fpos.x>0.0 )           
                   {              
                         xx=fpos.x+bwid;              
                   }           
                   else if ( fpos.x==0.0 )           
                   {              
                         xx=0.0;              
                   }           
                   else           
                   {              
                         xx=fpos.x-bwid;              
                   }           
                   if ( fpos.y>0.0 )           
                   {              
                         yy=fpos.y+fbxd.height/2.0;              
                   }           
                   else if ( fpos.y==0.0 )           
                   {              
                         yy=0.0;              
                   }           
                   else           
                   {              
                         yy=fpos.y-fbxd.height/2.0;              
                   }           
                   if ( fpos.z>0.0 )           
                   {              
                         zz=fpos.z+fbxd.depth/2.0;              
                   }           
                   else           
                   {              
                         zz=fpos.z-fbxd.depth/2.0;              
                   }           
                   _create = AgCreate("FBOX");           
                   {              
                         AgShape myshape; // undefined shape              
                         ///Create FBOX              
                         Create("FBOX");               
                   }           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FBOX");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume FBOX to mother CAVE              
                         place.TranslateX(xx);              
                         /// Translate x = xx              
                         place.TranslateY(yy);              
                         /// Translate y = yy              
                         place.TranslateZ(zz);              
                         /// Translate z = zz              
                         place.AlphaY(fpos.ay);              
                         /// Rotate: AlphaY = fpos.ay              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 0              
                         /// G3 Reference: phiz = 0              
                         _stacker -> Position( AgBlock::Find("FBOX"), place );              
                   } // end placement of FBOX           
             }        
       }; // FPDMGEO1     
 }; // namespace FPDMGEO1  
 