   struct inse_t {
float width;
float depth;
float height;
float sheetdpt;
float holegap;
float holedepth;
float holeheight;
float gapdepth;
float gapheight;
float gatedepth;
float ra;
float rb;
float diam;
float rmax;
float gategap;
int _index;
};
 
