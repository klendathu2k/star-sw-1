                            place.par("dy")=dy2;              
                            place.par("dz")=prsw.dz[int(3)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("FPPB"), place );              
                      } // end placement of FPPB           
                      if ( sern==3 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPBB");              
                            place.SetMother("FPLY");              
                            /// Add daughter volume FPBB to mother FPLY              
                            place.TranslateX(x2);              
                            /// Translate x = x2              
                            place.TranslateY(-y2);              
                            /// Translate y = -y2              
                            place.TranslateZ(z2+dzsb);              
                            /// Translate z = z2+dzsb              
                            place.par("dx")=dx2;              
                            place.par("dy")=dy2;              
                            place.par("dz")=prsw.dzbbd[int(3)-1]/4.0;              
                            _stacker -> Position( AgBlock::Find("FPBB"), place );              
                      } // end placement of FPBB           
                      if ( sern==3 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPBB");              
                            place.SetMother("FPLY");              
                            /// Add daughter volume FPBB to mother FPLY              
                            place.TranslateX(-x2);              
                            /// Translate x = -x2              
                            place.TranslateY(-y2);              
                            /// Translate y = -y2              
                            place.TranslateZ(z2-dzsb);              
                            /// Translate z = z2-dzsb              
                            place.par("dx")=dx2;              
                            place.par("dy")=dy2;              
                            place.par("dz")=prsw.dzbbd[int(3)-1]/4.0;              
                            _stacker -> Position( AgBlock::Find("FPBB"), place );              
                      } // end placement of FPBB           
                      if ( sern==3 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPPB");              
                            place.SetMother("FPLY");              
                            /// Add daughter volume FPPB to mother FPLY              
                            place.TranslateX(-x2);              
                            /// Translate x = -x2              
                            place.TranslateY(-y2);              
                            /// Translate y = -y2              
                            place.TranslateZ(z2);              
                            /// Translate z = z2              
                            place.par("dx")=dx2;              
                            place.par("dy")=dy2;              
                            place.par("dz")=prsw.dz[int(3)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("FPPB"), place );              
                      } // end placement of FPPB           
                      if ( sern==3 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPBB");              
                            place.SetMother("FPLY");              
                            /// Add daughter volume FPBB to mother FPLY              
                            place.TranslateX(-x2);              
                            /// Translate x = -x2              
                            place.TranslateY(-y2);              
                            /// Translate y = -y2              
                            place.TranslateZ(z2+dzsb);              
                            /// Translate z = z2+dzsb              
                            place.par("dx")=dx2;              
                            place.par("dy")=dy2;              
                            place.par("dz")=prsw.dzbbd[int(3)-1]/4.0;              
                            _stacker -> Position( AgBlock::Find("FPBB"), place );              
                      } // end placement of FPBB           
                      END_OF_FPLY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FPLY     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FTLY::mInstance = 0;     
          AgBlock *FTLY::Instance(){        
                   if ( mInstance==0 ) mInstance = new FTLY();        
                   return mInstance;        
          }     
          void FTLY::Block( AgCreate create )     
          {         
                ///@addtogroup FTLY_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FTLY");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.par("serial")=sern;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=dx;              
                            shape.par("dy")=dy;              
                            shape.par("dz")=dz;              
                            /// Shape Bbox dx=dx dy=dy dz=dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTLY;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FOSC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FOSC              
                            Create("FOSC");               
                      }           
                      _create = AgCreate("FPBB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPBB              
                            Create("FPBB");               
                      }           
                      /// Loop on i from 1 to post.nslat[int(sn)-1][int(layr)-1] step=1           
                      for ( i=1; (1>0)? (i<=post.nslat[int(sn)-1][int(layr)-1]):(i>=post.nslat[int(sn)-1][int(layr)-1]); i+=1 )           
                      {              
                            if ( post.nslat[int(sn)-1][int(layr)-1]>0 )              
                            {                 
                                  if ( layr==1 )                 
                                  {                    
                                        xxx=wid*(i-5);                    
                                        yyy=0.0;                    
                                        dyy=post.sclth[int(2)-1]/2.0;                    
                                  }                 
                                  else if ( layr<=3 )                 
                                  {                    
                                        if ( i<=7 )                    
                                        {                       
                                              xxx=-1.5*wid*sqrt2+wid*i/sqrt2-39.085;                       
                                              yyy=wid*8/sqrt2-wid*i/sqrt2;                       
                                              dyy=post.sclth[int(11-i)-1]/2.0;                       
                                        }                    
                                        else if ( i>7 )                    
                                        {                       
                                              xxx=2.5*wid*sqrt2+wid*(i-8)*sqrt2-39.085;                       
                                              yyy=0.0;                       
                                              dyy=post.sclth[int(3)-1]/2.0;                       
                                        }                    
                                  }                 
                                  else if ( layr==4 )                 
                                  {                    
                                        if ( i<=19 )                    
                                        {                       
                                              xxx=0.0;                       
                                              yyy=-108.0375+(60+post.scwrap)/sqrt2+wid/2.0+wid*sqrt2*19-post.yoff[int(sn)-1][int(layr)-1]-wid*i*sqrt2;                       
                                              dyy=post.sclth[int(3)-1]/2.0;                       
                                        }                    
                                        else                    
                                        {                       
                                              xxx=wid*(i-19)/sqrt2;                       
                                              yyy=-108.0375+(60+post.scwrap)/sqrt2+wid/2.0-post.yoff[int(sn)-1][int(layr)-1]-wid*(i-19)/sqrt2;                       
                                              dyy=post.sclth[int(i-16)-1]/2.0;                       
                                        }                    
                                  }                 
                                  else if ( layr==5 )                 
                                  {                    
                                        yyy=wid*(22-i);                    
                                        xxx=0.0;                    
                                        dyy=post.sclth[int(2)-1]/2.0;                    
                                  }                 
                                  else if ( layr==6 )                 
                                  {                    
                                        dyy=post.sclth[int(1)-1]/2.0;                    
                                        yyy=54.0;                    
                                        xxx=wid*(i-9);                    
                                        if ( i>17 )                    
                                        {                       
                                              xxx=wid*(i-26);                       
                                              yyy=-yyy;                       
                                        }                    
                                  }                 
                                  if ( sn==2 )                 
                                  {                    
                                        xxx=-xxx;                    
                                  }                 
                                  ang=post.angslat[int(sn)-1][int(layr)-1];                 
                                  dzz=post.scthick/2.0;                 
                                  dxx=post.scwidth/2.0;                 
                                  zzz=-dz+post.scthick/2.0;                 
                                  if ( layr==3 )                 
                                  {                    
                                        zzz=-zzz;                    
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FOSC");                    
                                        place.SetMother("FTLY");                    
                                        /// Add daughter volume FOSC to mother FTLY                    
                                        place.TranslateX(xxx);                    
                                        /// Translate x = xxx                    
                                        place.TranslateY(yyy);                    
                                        /// Translate y = yyy                    
                                        place.TranslateZ(zzz);                    
                                        /// Translate z = zzz                    
                                        place.par("dx")=dxx;                    
                                        place.par("dy")=dyy;                    
                                        place.par("dz")=dzz;                    
                                        place.AlphaZ(ang);                    
                                        /// Rotate: AlphaZ = ang                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FOSC"), place );                    
                                  } // end placement of FOSC                 
                            }              
                      }           
                      /// Loop on i from 1 to post.nslat[int(sn)-1][int(layr)-1] step=1           
                      for ( i=1; (1>0)? (i<=post.nslat[int(sn)-1][int(layr)-1]):(i>=post.nslat[int(sn)-1][int(layr)-1]); i+=1 )           
                      {              
                            if ( post.nslat[int(sn)-1][int(layr)-1]>0 )              
                            {                 
                                  if ( layr==1 )                 
                                  {                    
                                        dxx=wid*9+1.0;                    
                                        dyy=post.sclth[int(2)-1]/2.0+1.0;                    
                                  }                 
                                  else if ( layr<=3 )                 
                                  {                    
                                        dxx=64.0;                    
                                        dyy=post.sclth[int(2)-1]/2.0;                    
                                  }                 
                                  else                 
                                  {                    
                                        dxx=post.sclth[int(2)-1]/2.0+1.0;                    
                                        dyy=post.sclth[int(1)-1]+1.0;                    
                                  }                 
                                  xxx=0.0;                 
                                  yyy=0.0;                 
                                  dzz=post.bpdz/2.0;                 
                                  zzz=dz-post.bpdz/2.0;                 
                                  if ( layr==3 )                 
                                  {                    
                                        zzz=-zzz;                    
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FPBB");                    
                                        place.SetMother("FTLY");                    
                                        /// Add daughter volume FPBB to mother FTLY                    
                                        place.TranslateX(xxx);                    
                                        /// Translate x = xxx                    
                                        place.TranslateY(yyy);                    
                                        /// Translate y = yyy                    
                                        place.TranslateZ(zzz);                    
                                        /// Translate z = zzz                    
                                        place.par("dx")=dxx;                    
                                        place.par("dy")=dyy;                    
                                        place.par("dz")=dzz;                    
                                        _stacker -> Position( AgBlock::Find("FPBB"), place );                    
                                  } // end placement of FPBB                 
                            }              
                      }           
                      END_OF_FTLY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTLY     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FPBB::mInstance = 0;     
          AgBlock *FPBB::Instance(){        
                   if ( mInstance==0 ) mInstance = new FPBB();        
                   return mInstance;        
          }     
          void FPBB::Block( AgCreate create )     
          {         
                ///@addtogroup FPBB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Component O	a=16	z=8	w=0.4*4*16./174.           
                      /// Mixture g10 dens=1.7           
                      {  AgMaterial &mix = AgMaterial::Get("G10");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.Component("O",16,8,0.4*4*16./174.);              
                            mix.par("dens")=1.7;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("FPBB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.0;              
                            shape.par("dy")=0.0;              
                            shape.par("dz")=0.0;              
                            /// Shape Bbox dx=0.0 dy=0.0 dz=0.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FPBB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FPBB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FPBB     
          // ---------------------------------------------------------------------------------------------------     
