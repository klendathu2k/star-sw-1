          void PBPT::Block( AgCreate create )     
          {         
                ///@addtogroup PBPT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Lead");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PBPT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=pbpd.width/2.0;              
                            shape.par("dy")=pbpd.height/2.0;              
                            shape.par("dz")=pbpd.thick/2.0;              
                            /// Shape Bbox dx=pbpd.width/2.0 dy=pbpd.height/2.0 dz=pbpd.thick/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PBPT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PBPT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PBPT     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FSHM::mInstance = 0;     
          AgBlock *FSHM::Instance(){        
                   if ( mInstance==0 ) mInstance = new FSHM();        
                   return mInstance;        
          }     
          void FSHM::Block( AgCreate create )     
          {         
                ///@addtogroup FSHM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FSHM");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=fmxg.g10width/2.0;              
                            shape.par("dy")=fmxg.g10hgt/2.0;              
                            shape.par("dz")=ztotsmd;              
                            /// Shape Bbox dx=fmxg.g10width/2.0 dy=fmxg.g10hgt/2.0 dz=ztotsmd               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSHM;              
                            _stacker -> Build(this);              
                      }           
                      wsmd=fmxg.sbase/2.0+fmxg.sgap;           
                      wtotsmd=(fmxg.nstrip+1)*wsmd;           
                      zsmd=-ztotsmd+fmxg.g10thick/2.0;           
                      _create = AgCreate("FXGT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FXGT              
                            Create("FXGT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FXGT");              
                            place.SetMother("FSHM");              
                            /// Add daughter volume FXGT to mother FSHM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(zsmd);              
                            /// Translate z = zsmd              
                            _stacker -> Position( AgBlock::Find("FXGT"), place );              
                      } // end placement of FXGT           
                      xsmdv=-wtotsmd/2.0-fmxg.sgap/2.0+wsmd;           
                      ysmdv=0.0;           
                      zsmdv=zsmd+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      /// Loop on i from 1 to fmxg.nstrip step=1           
                      for ( i=1; (1>0)? (i<=fmxg.nstrip):(i>=fmxg.nstrip); i+=1 )           
                      {              
                            if ( mod(i,2)!=0 )              
                            {                 
                                  _create = AgCreate("FHMS");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create FHMS                    
                                        Create("FHMS");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdv);                    
                                        /// Translate x = xsmdv                    
                                        place.TranslateY(ysmdv);                    
                                        /// Translate y = ysmdv                    
                                        place.TranslateZ(zsmdv);                    
                                        /// Translate z = zsmdv                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            else              
                            {                 
                                  _create = AgCreate("FHMS");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create FHMS                    
                                        Create("FHMS");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdv);                    
                                        /// Translate x = xsmdv                    
                                        place.TranslateY(ysmdv);                    
                                        /// Translate y = ysmdv                    
                                        place.TranslateZ(zsmdv);                    
                                        /// Translate z = zsmdv                    
                                        place.AlphaX(180);                    
                                        /// Rotate: AlphaX = 180                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            xsmdv=xsmdv+wsmd;              
                      }           
                      zsmd2=zsmdv+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      _create = AgCreate("FXGT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FXGT              
                            Create("FXGT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FXGT");              
                            place.SetMother("FSHM");              
                            /// Add daughter volume FXGT to mother FSHM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(zsmd2);              
                            /// Translate z = zsmd2              
                            _stacker -> Position( AgBlock::Find("FXGT"), place );              
                      } // end placement of FXGT           
                      xsmdh=0.0;           
                      ysmdh=-wtotsmd/2.0-fmxg.sgap/2.0+wsmd;           
                      zsmdh=zsmd2+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      _create = AgCreate("FHMS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHMS              
                            Create("FHMS");               
                      }           
                      /// Loop on i from 1 to fmxg.nstrip step=1           
                      for ( i=1; (1>0)? (i<=fmxg.nstrip):(i>=fmxg.nstrip); i+=1 )           
                      {              
                            if ( mod(i,2)!=0 )              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdh);                    
                                        /// Translate x = xsmdh                    
                                        place.TranslateY(ysmdh);                    
                                        /// Translate y = ysmdh                    
                                        place.TranslateZ(zsmdh);                    
                                        /// Translate z = zsmdh                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Ortho( "Y-XZ" ); // ORT=Y-XZ                    
                                        /// Axis substitution: XYZ --> Y-XZ                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            else              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdh);                    
                                        /// Translate x = xsmdh                    
                                        place.TranslateY(ysmdh);                    
                                        /// Translate y = ysmdh                    
                                        place.TranslateZ(zsmdh);                    
                                        /// Translate z = zsmdh                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Ortho( "YX-Z" ); // ORT=YX-Z                    
                                        /// Axis substitution: XYZ --> YX-Z                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            ysmdh=ysmdh+wsmd;              
                      }           
                      END_OF_FSHM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSHM     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FXGT::mInstance = 0;     
          AgBlock *FXGT::Instance(){        
                   if ( mInstance==0 ) mInstance = new FXGT();        
                   return mInstance;        
          }     
          void FXGT::Block( AgCreate create )     
          {         
                ///@addtogroup FXGT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Component O	a=16	z=8	w=0.4*4*16./174.           
                      /// Mixture g10 dens=1.7           
                      {  AgMaterial &mix = AgMaterial::Get("G10");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.Component("O",16,8,0.4*4*16./174.);              
                            mix.par("dens")=1.7;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("FXGT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=fmxg.g10width/2;              
                            shape.par("dy")=fmxg.g10hgt/2;              
                            shape.par("dz")=fmxg.g10thick/2;              
                            /// Shape Bbox dx=fmxg.g10width/2 dy=fmxg.g10hgt/2 dz=fmxg.g10thick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FXGT;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 0.00001 (deferred)           
                      // cut cutele = 0.00001 (deferred)           
                      END_OF_FXGT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FXGT     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FHMS::mInstance = 0;     
          AgBlock *FHMS::Instance(){        
                   if ( mInstance==0 ) mInstance = new FHMS();        
                   return mInstance;        
          }     
          void FHMS::Block( AgCreate create )     
          {         
                ///@addtogroup FHMS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material POLYSTYREN            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Material Cpolystyren isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Cpolystyren");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FHMS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd1");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=0;              
                            shape.par("dx2")=fmxg.sbase/2.0;              
                            shape.par("dy")=fmxg.g10hgt/2.0;              
                            shape.par("dz")=fmxg.sapex/2.0;              
                            /// Shape Trd1 dx1=0 dx2=fmxg.sbase/2.0 dy=fmxg.g10hgt/2.0 dz=fmxg.sapex/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FHMS;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 0.00008 (deferred)           
                      // cut cutele = 0.001 (deferred)           
                      // cut bcute = 0.0001 (deferred)           
                      // parameter birk1 = 1. (deferred)           
                      // parameter birk2 = 0.0130 (deferred)           
                      // parameter birk3 = 9.6e-6 (deferred)           
                      // deferred module()->AddHit( "FHMS", "birk", 0, 0, 10, "");           
                      END_OF_FHMS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FHMS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FPRS::mInstance = 0;     
          AgBlock *FPRS::Instance(){        
                   if ( mInstance==0 ) mInstance = new FPRS();        
                   return mInstance;        
          }     
          void FPRS::Block( AgCreate create )     
          {         
                ///@addtogroup FPRS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FPRS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pgon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=45;              
                            shape.par("dphi")=360;              
                            shape.par("npdiv")=4;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-prsw.dbox[int(3)-1]/2.0;              
                            shape.Z(1)=prsw.dbox[int(3)-1]/2.0;              
                            shape.Rmin(0)=prsw.dhole-prsw.dxbbd[int(1)-1];              
                            shape.Rmin(1)=prsw.dhole-prsw.dxbbd[int(1)-1];              
                            shape.Rmax(0)=prsw.dbox[int(1)-1]/2.0;              
                            shape.Rmax(1)=prsw.dbox[int(1)-1]/2.0;              
                            /// Shape Pgon phi1=45 dphi=360 npdiv=4 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FPRS;              
                            _stacker -> Build(this);              
                      }           
                      debug=1;           
                      if ( debug>=1 )           
                      {              
                            npstype=0;              
                            cpstype(1)=1;              
                            cpstype(2)=2;              
                            cpstype(3)=6;              
                            cpstype(4)=3;              
                            cpstype(5)=4;              
                            cpstype(6)=7;              
                            cpstype(7)=5;              
                            cpstype(8)=8;              
                      }           
                      sern=1;           
                      dx=prsw.dbox[int(1)-1]/2.0;           
                      dy=prsw.dbox[int(2)-1]/2.0;           
                      dz=prsw.dz[int(1)-1]/2.0+prsw.dzbbd[int(1)-1]/2.0+prsw.dsipm[int(1)-1]/2.0;           
                      zz=-prsw.dbox[int(3)-1]/2.0+dz;           
                      _create = AgCreate("FPLY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPLY              
                            Create("FPLY");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPLY");              
                            place.SetMother("FPRS");              
                            /// Add daughter volume FPLY to mother FPRS              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("FPLY"), place );              
                      } // end placement of FPLY           
                      sern=2;           
                      dx=prsw.dbox[int(1)-1]/2.0;           
                      dy=prsw.dbox[int(2)-1]/2.0;           
                      dz=prsw.dz[int(2)-1]/2.0+prsw.dzbbd[int(2)-1]/2.0+prsw.dsipm[int(1)-1]/2.0;           
                      zz=-prsw.dbox[int(3)-1]/2.0+dz+prsw.zoff[int(2)-1]-prsw.zoff[int(1)-1];           
                      _create = AgCreate("FPLY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPLY              
                            Create("FPLY");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPLY");              
                            place.SetMother("FPRS");              
                            /// Add daughter volume FPLY to mother FPRS              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("FPLY"), place );              
                      } // end placement of FPLY           
                      sern=3;           
                      dx=prsw.dbox[int(1)-1]/2.0;           
                      dy=prsw.dbox[int(2)-1]/2.0;           
                      dz=prsw.dz[int(3)-1]/2.0+prsw.dzbbd[int(3)-1]/2.0;           
                      zz=-prsw.dbox[int(3)-1]/2.0+prsw.dsipm[int(1)-1]+dz-prsw.dzbbd[int(3)-1]/2.0+prsw.zoff[int(3)-1]-prsw.zoff[int(1)-1];           
                      dzsb=prsw.dz[int(3)-1]/2.0+prsw.dzbbd[int(3)-1]/4.0;           
                      _create = AgCreate("FPLY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPLY              
                            Create("FPLY");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPLY");              
                            place.SetMother("FPRS");              
                            /// Add daughter volume FPLY to mother FPRS              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("FPLY"), place );              
                      } // end placement of FPLY           
                      sern=4;           
                      dx=prsw.dbox[int(1)-1]/2.0;           
                      dy=prsw.dbox[int(2)-1]/2.0;           
                      dz=prsw.dz[int(4)-1]/2.0+prsw.dzbbd[int(4)-1]/2.0+prsw.dsipm[int(1)-1]/2.0;           
                      zz=-prsw.dbox[int(3)-1]/2.0+dz+prsw.dsipm[int(1)-1]+prsw.zoff[int(4)-1]-prsw.zoff[int(1)-1]-prsw.dzbbd[int(4)-1];           
                      _create = AgCreate("FPLY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPLY              
                            Create("FPLY");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPLY");              
                            place.SetMother("FPRS");              
                            /// Add daughter volume FPLY to mother FPRS              
                            place.TranslateZ(zz);              
                            /// Translate z = zz              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("FPLY"), place );              
                      } // end placement of FPLY           
                      if ( debug>=1 )           
                      {              
                            k=0;              
                            /// Loop on i from 1 to npstype step=1              
                            for ( i=1; (1>0)? (i<=npstype):(i>=npstype); i+=1 )              
                            {                 
                                  /// Loop on j from 1 to npstype step=1                 
                                  for ( j=1; (1>0)? (j<=npstype):(j>=npstype); j+=1 )                 
                                  {                    
                                        if ( i==cpstype(j) )                    
                                        {                       
                                              k=k+pstype(j);                       
                                        }                    
                                  }                 
                            }              
                      }           
                      END_OF_FPRS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FPRS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FPST::mInstance = 0;     
          AgBlock *FPST::Instance(){        
                   if ( mInstance==0 ) mInstance = new FPST();        
                   return mInstance;        
          }     
          void FPST::Block( AgCreate create )     
          {         
                ///@addtogroup FPST_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FPST");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pgon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=45;              
                            shape.par("dphi")=360;              
                            shape.par("npdiv")=4;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-post.dbox[int(3)-1]/2.0;              
                            shape.Z(1)=post.dbox[int(3)-1]/2.0;              
                            shape.Rmin(0)=post.dhole/2.0;              
                            shape.Rmin(1)=post.dhole/2.0;              
                            shape.Rmax(0)=post.dbox[int(1)-1]/2.0;              
                            shape.Rmax(1)=post.dbox[int(1)-1]/2.0;              
                            /// Shape Pgon phi1=45 dphi=360 npdiv=4 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FPST;              
                            _stacker -> Build(this);              
                      }           
                      debug=0;           
                      if ( debug>=1 )           
                      {              
                      }           
                      wid=post.scwidth+post.scwrap;           
                      sern=0;           
                      /// Loop on sn from 1 to 2 step=1           
                      for ( sn=1; (1>0)? (sn<=2):(sn>=2); sn+=1 )           
                      {              
                            /// Loop on layr from 1 to 6 step=1              
                            for ( layr=1; (1>0)? (layr<=6):(layr>=6); layr+=1 )              
                            {                 
                                  if ( post.nslat[int(sn)-1][int(layr)-1]>0 )                 
                                  {                    
                                        if ( layr==1 )                    
                                        {                       
                                              dx=wid*9+1.0;                       
                                              dy=post.sclth[int(2)-1]/2.0+1.0;                       
                                        }                    
                                        else if ( layr<=3 )                    
                                        {                       
                                              dx=64.0;                       
                                              dy=post.sclth[int(2)-1]/2.0;                       
                                        }                    
                                        else                    
                                        {                       
                                              dx=post.sclth[int(2)-1]/2.0+1.0;                       
                                              dy=post.sclth[int(1)-1]+1.0;                       
                                        }                    
                                        xx=post.xoff[int(sn)-1][int(layr)-1];                    
                                        yy=post.yoff[int(sn)-1][int(layr)-1];                    
                                        dz=(post.scthick+post.bpdz)/2.0;                    
                                        zz=post.zoff[int(sn)-1][int(layr)-1]-(post.zoff[int(1)-1][int(1)-1]+post.dbox[int(3)-1]/2.0-2.0)+post.bpdz/2.0;                    
                                        if ( layr==3 )                    
                                        {                       
                                              zz=post.zoff[int(sn)-1][int(layr)-1]-(post.zoff[int(1)-1][int(1)-1]+post.dbox[int(3)-1]/2.0-2.0)-post.bpdz/2.0;                       
                                        }                    
                                        sern=sern+1;                    
                                        _create = AgCreate("FTLY");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create FTLY                       
                                              Create("FTLY");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("FTLY");                       
                                              place.SetMother("FPST");                       
                                              /// Add daughter volume FTLY to mother FPST                       
                                              place.TranslateX(xx);                       
                                              /// Translate x = xx                       
                                              place.TranslateY(yy);                       
                                              /// Translate y = yy                       
                                              place.TranslateZ(zz);                       
                                              /// Translate z = zz                       
                                              place.par("only")=AgPosition::kOnly;                       
                                              /// Overlap: agposition::konly                       
                                              _stacker -> Position( AgBlock::Find("FTLY"), place );                       
                                        } // end placement of FTLY                    
                                  }                 
                            }              
                      }           
                      END_OF_FPST:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FPST     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FPLY::mInstance = 0;     
          AgBlock *FPLY::Instance(){        
                   if ( mInstance==0 ) mInstance = new FPLY();        
                   return mInstance;        
          }     
          void FPLY::Block( AgCreate create )     
          {         
                ///@addtogroup FPLY_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FPLY");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.par("serial")=sern;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pgon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=45;              
                            shape.par("dphi")=360;              
                            shape.par("npdiv")=4;              
                            shape.par("nz")=2;              
                            shape.Z(0)=-dz;              
                            shape.Z(1)=dz;              
                            shape.Rmin(0)=prsw.dhole-prsw.dxbbd[int(1)-1];              
                            shape.Rmin(1)=prsw.dhole-prsw.dxbbd[int(1)-1];              
                            shape.Rmax(0)=prsw.dbox[int(1)-1]/2.0;              
                            shape.Rmax(1)=prsw.dbox[int(1)-1]/2.0;              
                            /// Shape Pgon phi1=45 dphi=360 npdiv=4 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FPLY;              
                            _stacker -> Build(this);              
                      }           
                      lprs1=prsw.nprs[int(1)-1]*(prsw.dprs[int(1)-1]+prsw.dprs[int(3)-1]);           
                      lprs2=prsw.nprs[int(2)-1]*(prsw.dprs[int(2)-1]+prsw.dprs[int(3)-1])+lprs1;           
                      lprs3=(prsw.nprs[int(2)-1]-prsw.nskiph)*(prsw.dprs[int(2)-1]+prsw.dprs[int(3)-1])+lprs1;           
                      lprs4=(prsw.nprs[int(1)-1]-prsw.nskipv)*(prsw.dprs[int(1)-1]+prsw.dprs[int(3)-1])+prsw.nprs[int(2)-1]*(prsw.dprs[int(2)-1]+prsw.dprs[int(3)-1]);           
                      dlg=(prsw.dlg[int(2)-1]+prsw.dlg[int(3)-1]+prsw.dsipm[int(1)-1])/2.0;           
                      k=0;           
                      dzz=prsw.dz[int(sern)-1]/2.0;           
                      if ( sern==3 )           
                      {              
                            ;//pbinmiddle,backplateinfrontandback;              
                            z1=0;              
                            z2=0;              
                      }           
                      else if ( sern==4 )           
                      {              
                            ;//backboardfirstforlayer3;              
                            z1=-dz+prsw.dzbbd[int(sern)-1]+dzz;//zforschinti;              
                            z2=-dz+prsw.dzbbd[int(sern)-1]/2.0;//zforbackboard;              
                      }           
                      else           
                      {              
                            ;//backboard2ndforlayer1,2;              
                            z1=-dz+prsw.dsipm[int(1)-1]+dzz;//zforschinti;              
                            z2=-dz+prsw.dsipm[int(1)-1]+dzz*2+prsw.dzbbd[int(sern)-1]/2.0;//zforbackboard;              
                      }           
                      z=prsw.zoff[int(sern)-1];           
                      _create = AgCreate("FPSC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPSC              
                            Create("FPSC");               
                      }           
                      _create = AgCreate("FOSC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FOSC              
                            Create("FOSC");               
                      }           
                      _create = AgCreate("FLIG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FLIG              
                            Create("FLIG");               
                      }           
                      _create = AgCreate("FLLG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FLLG              
                            Create("FLLG");               
                      }           
                      _create = AgCreate("WPAR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create WPAR              
                            Create("WPAR");               
                      }           
                      _create = AgCreate("FPBB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPBB              
                            Create("FPBB");               
                      }           
                      _create = AgCreate("FPPB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPPB              
                            Create("FPPB");               
                      }           
                      if ( debug>=1&&sern==1 )           
                      {              
                      }           
                      if ( debug>=1&&sern==2 )           
                      {              
                      }           
                      if ( debug>=1&&sern==3 )           
                      {              
                      }           
                      if ( debug>=1&&sern==4 )           
                      {              
                      }           
                      if ( sern<=2 )           
                      {              
                            layr=sern;              
                      }           
                      else           
                      {              
                            layr=sern-1;              
                      }           
                      if ( sern==1 )           
                      {              
                            /// Loop on lr from 1 to 2 step=1              
                            for ( lr=1; (1>0)? (lr<=2):(lr>=2); lr+=1 )              
                            {                 
                                  /// Loop on tb from 1 to 2 step=1                 
                                  for ( tb=1; (1>0)? (tb<=2):(tb>=2); tb+=1 )                 
                                  {                    
                                        x=0.0;                    
                                        quad=(lr-1)*2+tb;                    
                                        slat(quad,layr)=0;                    
                                        /// Loop on j from 1 to 2 step=1                    
                                        for ( j=1; (1>0)? (j<=2):(j>=2); j+=1 )                    
                                        {                       
                                              /// Loop on i from 1 to prsw.nprs[int(j)-1] step=1                       
                                              for ( i=1; (1>0)? (i<=prsw.nprs[int(j)-1]):(i>=prsw.nprs[int(j)-1]); i+=1 )                       
                                              {                          
                                                    dxx=prsw.dprs[int(j)-1]/2.0;                          
                                                    x=x+dxx+prsw.dprs[int(3)-1]/2.0;                          
                                                    if ( tb==1 )                          
                                                    {                             
                                                          pwid=lprs2;                             
                                                    }                          
                                                    else                          
                                                    {                             
                                                          pwid=lprs3-prsw.dycut;                             
                                                    }                          
                                                    if ( x<=prsw.dhole )                          
                                                    {                             
                                                          dyy=(pwid-prsw.dhole)/2.0;                             
                                                          y=dyy+prsw.dhole;                             
                                                    }                          
                                                    else                          
                                                    {                             
                                                          dyy=pwid/2.0;                             
                                                          y=dyy;                             
                                                    }                          
                                                    yy=y+dyy+dlg;                          
                                                    if ( tb==1 )                          
                                                    {                             
                                                          rot=0;                             
                                                    }                          
                                                    if ( tb==2 )                          
                                                    {                             
                                                          y=-y;                             
                                                          yy=-yy;                             
                                                          rot=180;                             
                                                    }                          
                                                    if ( lr==1 )                          
                                                    {                             
                                                          xx=+x+prsw.xoff[int(sern)-1];                             
                                                    }                          
                                                    if ( lr==2 )                          
                                                    {                             
                                                          xx=-x-prsw.xoff[int(sern)-1];                             
                                                    }                          
                                                    y=y+prsw.yoff[int(sern)-1];yy=yy+prsw.yoff[int(sern)-1];;                          
                                                    if ( tb==1||j==2||i>prsw.nskipv )                          
                                                    {                             
                                                          if ( debug>=1 )                             
                                                          {                                
                                                                k=k+1;                                
                                                                slat(quad,layr)=slat(quad,layr)+1;                                
                                                                id=(quad-1)*3*21+(layr-1)*21+(slat(quad,layr)-1);                                
                                                                flag=0;                                
                                                                /// Loop on kk from 1 to npstype step=1                                
                                                                for ( kk=1; (1>0)? (kk<=npstype):(kk>=npstype); kk+=1 )                                
                                                                {                                   
                                                                      if ( (psdim(kk,1)==dxx&&psdim(kk,2)==dyy)||(psdim(kk,1)==dyy&&psdim(kk,2)==dxx) )                                   
                                                                      {                                      
                                                                            flag=kk;                                      
                                                                            pstype(kk)=pstype(kk)+1;                                      
                                                                      }                                   
                                                                }                                
                                                                if ( flag==0 )                                
                                                                {                                   
                                                                      npstype=npstype+1;                                   
                                                                      flag=npstype;                                   
                                                                      pstype(flag)=1;                                   
                                                                      if ( dxx>dyy )                                   
                                                                      {                                      
                                                                            psdim(npstype,1)=dyy;                                      
                                                                            psdim(npstype,2)=dxx;                                      
                                                                      }                                   
                                                                      else                                   
                                                                      {                                      
                                                                            psdim(npstype,1)=dxx;                                      
                                                                            psdim(npstype,2)=dyy;                                      
                                                                      }                                   
                                                                }                                
                                                          }                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FPSC");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FPSC to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(y);                                
                                                                /// Translate y = y                                
                                                                place.TranslateZ(z1);                                
                                                                /// Translate z = z1                                
                                                                place.par("dx")=dxx;                                
                                                                place.par("dy")=dyy;                                
                                                                place.par("dz")=dzz;                                
                                                                _stacker -> Position( AgBlock::Find("FPSC"), place );                                
                                                          } // end placement of FPSC                             
                                                          if ( j==1 )                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FLIG");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FLIG to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1-prsw.dsipm[int(1)-1]/2.0);                                
                                                                /// Translate z = z1-prsw.dsipm[int(1)-1]/2.0                                
                                                                place.AlphaX(-90);                                
                                                                /// Rotate: AlphaX = -90                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                place.AlphaZ(rot);                                
                                                                /// Rotate: AlphaZ = rot                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                _stacker -> Position( AgBlock::Find("FLIG"), place );                                
                                                          } // end placement of FLIG                             
                                                          if ( j==2 )                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FLLG");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FLLG to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1-prsw.dsipm[int(1)-1]/2.0);                                
                                                                /// Translate z = z1-prsw.dsipm[int(1)-1]/2.0                                
                                                                place.AlphaX(-90);                                
                                                                /// Rotate: AlphaX = -90                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                place.AlphaZ(rot);                                
                                                                /// Rotate: AlphaZ = rot                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                _stacker -> Position( AgBlock::Find("FLLG"), place );                                
                                                          } // end placement of FLLG                             
                                                    }                          
                                                    x=x+dxx;                          
                                              }                       
                                        }                    
                                  }                 
                            }              
                      }           
                      else if ( sern==2||sern==4 )           
                      {              
                            /// Loop on lr from 1 to 2 step=1              
                            for ( lr=1; (1>0)? (lr<=2):(lr>=2); lr+=1 )              
                            {                 
                                  /// Loop on tb from 1 to 2 step=1                 
                                  for ( tb=1; (1>0)? (tb<=2):(tb>=2); tb+=1 )                 
                                  {                    
                                        y=0.0;                    
                                        quad=(lr-1)*2+tb;                    
                                        slat(quad,layr)=0;                    
                                        /// Loop on j from 1 to 2 step=1                    
                                        for ( j=1; (1>0)? (j<=2):(j>=2); j+=1 )                    
                                        {                       
                                              /// Loop on i from 1 to prsw.nprs[int(j)-1] step=1                       
                                              for ( i=1; (1>0)? (i<=prsw.nprs[int(j)-1]):(i>=prsw.nprs[int(j)-1]); i+=1 )                       
                                              {                          
                                                    dyy=prsw.dprs[int(j)-1]/2.0;                          
                                                    y=y+dyy+prsw.dprs[int(3)-1]/2.0;                          
                                                    pwid=lprs2;                          
                                                    if ( y<=prsw.dhole )                          
                                                    {                             
                                                          dxx=(pwid-prsw.dhole)/2.0;                             
                                                          x=dxx+prsw.dhole;                             
                                                    }                          
                                                    else                          
                                                    {                             
                                                          if ( tb==1 )                             
                                                          {                                
                                                                dxx=pwid/2.0;                                
                                                                x=dxx;                                
                                                          }                             
                                                          else                             
                                                          {                                
                                                                dxx=lprs4/2.0;                                
                                                                x=dxx+2*prsw.dprs[int(1)-1];                                
                                                          }                             
                                                    }                          
                                                    xx=x+dxx+dlg;                          
                                                    if ( tb==1 )                          
                                                    {                             
                                                          yy=+y;                             
                                                    }                          
                                                    if ( tb==2 )                          
                                                    {                             
                                                          yy=-y;                             
                                                    }                          
                                                    if ( lr==1 )                          
                                                    {                             
                                                          x=+x+prsw.xoff[int(sern)-1];                             
                                                          xx=+xx+prsw.xoff[int(sern)-1];                             
                                                          rot=-90;                             
                                                    }                          
                                                    if ( lr==2 )                          
                                                    {                             
                                                          x=-x-prsw.xoff[int(sern)-1];                             
                                                          xx=-xx-prsw.xoff[int(sern)-1];                             
                                                          rot=90;                             
                                                    }                          
                                                    yy=yy+prsw.yoff[int(sern)-1];;                          
                                                    if ( tb==1||j==1||i<=prsw.nprs[int(j)-1]-prsw.nskiph )                          
                                                    {                             
                                                          if ( debug>=1 )                             
                                                          {                                
                                                                k=k+1;                                
                                                                slat(quad,layr)=slat(quad,layr)+1;                                
                                                                id=(quad-1)*3*21+(layr-1)*21+(slat(quad,layr)-1);                                
                                                                flag=0;                                
                                                                /// Loop on kk from 1 to npstype step=1                                
                                                                for ( kk=1; (1>0)? (kk<=npstype):(kk>=npstype); kk+=1 )                                
                                                                {                                   
                                                                      if ( (psdim(kk,1)==dxx&&psdim(kk,2)==dyy)||(psdim(kk,1)==dyy&&psdim(kk,2)==dxx) )                                   
                                                                      {                                      
                                                                            flag=kk;                                      
                                                                            pstype(kk)=pstype(kk)+1;                                      
                                                                      }                                   
                                                                }                                
                                                                if ( flag==0 )                                
                                                                {                                   
                                                                      npstype=npstype+1;                                   
                                                                      flag=npstype;                                   
                                                                      pstype(flag)=1;                                   
                                                                      if ( dxx>dyy )                                   
                                                                      {                                      
                                                                            psdim(npstype,1)=dyy;                                      
                                                                            psdim(npstype,2)=dxx;                                      
                                                                      }                                   
                                                                      else                                   
                                                                      {                                      
                                                                            psdim(npstype,1)=dxx;                                      
                                                                            psdim(npstype,2)=dyy;                                      
                                                                      }                                   
                                                                }                                
                                                          }                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FPSC");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FPSC to mother FPLY                                
                                                                place.TranslateX(x);                                
                                                                /// Translate x = x                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1);                                
                                                                /// Translate z = z1                                
                                                                place.par("dx")=dxx;                                
                                                                place.par("dy")=dyy;                                
                                                                place.par("dz")=dzz;                                
                                                                _stacker -> Position( AgBlock::Find("FPSC"), place );                                
                                                          } // end placement of FPSC                             
                                                          if ( j==1&&sern==2 )                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FLIG");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FLIG to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1-prsw.dsipm[int(1)-1]/2.0);                                
                                                                /// Translate z = z1-prsw.dsipm[int(1)-1]/2.0                                
                                                                place.AlphaX(-90);                                
                                                                /// Rotate: AlphaX = -90                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                place.AlphaZ(rot);                                
                                                                /// Rotate: AlphaZ = rot                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                _stacker -> Position( AgBlock::Find("FLIG"), place );                                
                                                          } // end placement of FLIG                             
                                                          if ( j==2&&sern==2 )                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FLLG");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FLLG to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1-prsw.dsipm[int(1)-1]/2.0);                                
                                                                /// Translate z = z1-prsw.dsipm[int(1)-1]/2.0                                
                                                                place.AlphaX(-90);                                
                                                                /// Rotate: AlphaX = -90                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                place.AlphaZ(rot);                                
                                                                /// Rotate: AlphaZ = rot                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                _stacker -> Position( AgBlock::Find("FLLG"), place );                                
                                                          } // end placement of FLLG                             
                                                          if ( j==1&&sern==4 )                             
                                                          {                                
                                                                AgPosition  place;                                
                                                                place.SetBlock("FLIG");                                
                                                                place.SetMother("FPLY");                                
                                                                /// Add daughter volume FLIG to mother FPLY                                
                                                                place.TranslateX(xx);                                
                                                                /// Translate x = xx                                
                                                                place.TranslateY(yy);                                
                                                                /// Translate y = yy                                
                                                                place.TranslateZ(z1+prsw.dsipm[int(1)-1]/2.0);                                
                                                                /// Translate z = z1+prsw.dsipm[int(1)-1]/2.0                                
                                                                place.AlphaX(90);                                
                                                                /// Rotate: AlphaX = 90                                
                                                                /// G3 Reference: thetax = 90                                
                                                                /// G3 Reference: phix = 0                                
                                                                /// G3 Reference: thetay = 90                                
                                                                /// G3 Reference: phiy = 90                                
                                                                /// G3 Reference: thetaz = 0                                
                                                                /// G3 Reference: phiz = 0                                
                                                                place.AlphaZ(-rot);                                
                                                                /// Rotate: AlphaZ = -rot                                
