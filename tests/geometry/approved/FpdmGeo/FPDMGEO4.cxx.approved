          void WPUF::Block( AgCreate create )     
          {         
                ///@addtogroup WPUF_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPUF");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wpfm.ustfd[int(1)-1]/2.0;              
                            shape.par("dy")=wpfm.ustfd[int(2)-1]/2.0;              
                            shape.par("dz")=wpfm.ustfd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wpfm.ustfd[int(1)-1]/2.0 dy=wpfm.ustfd[int(2)-1]/2.0 dz=wpfm.ustfd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPUF;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPUF");              
                            /// Add daughter volume WPAR to mother WPUF              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(wpfm.ustfd[int(4)-1]/2.0);              
                            /// Translate z = wpfm.ustfd[int(4)-1]/2.0              
                            place.par("dx")=wpfm.ustfd[int(1)-1]/2.0;              
                            place.par("dy")=wpfm.ustfd[int(2)-1]/2.0-wpfm.ustfd[int(4)-1];              
                            place.par("dz")=wpfm.ustfd[int(3)-1]/2.0-wpfm.ustfd[int(4)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPUF:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPUF     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *WPUN::mInstance = 0;     
          AgBlock *WPUN::Instance(){        
                   if ( mInstance==0 ) mInstance = new WPUN();        
                   return mInstance;        
          }     
          void WPUN::Block( AgCreate create )     
          {         
                ///@addtogroup WPUN_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPUN");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wpfm.ustnd[int(1)-1]/2.0;              
                            shape.par("dy")=wpfm.ustnd[int(2)-1]/2.0;              
                            shape.par("dz")=wpfm.ustnd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wpfm.ustnd[int(1)-1]/2.0 dy=wpfm.ustnd[int(2)-1]/2.0 dz=wpfm.ustnd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPUN;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPUN");              
                            /// Add daughter volume WPAR to mother WPUN              
                            place.TranslateX(+wpfm.ustnd[int(4)-1]/2.0);              
                            /// Translate x = +wpfm.ustnd[int(4)-1]/2.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            place.par("dx")=wpfm.ustnd[int(1)-1]/2.0-wpfm.ustnd[int(4)-1]/2.0;              
                            place.par("dy")=wpfm.ustnd[int(2)-1]/2.0-wpfm.ustnd[int(4)-1];              
                            place.par("dz")=wpfm.ustnd[int(3)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPUN:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPUN     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *WPUS::mInstance = 0;     
          AgBlock *WPUS::Instance(){        
                   if ( mInstance==0 ) mInstance = new WPUS();        
                   return mInstance;        
          }     
          void WPUS::Block( AgCreate create )     
          {         
                ///@addtogroup WPUS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPUS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wpfm.ustsd[int(1)-1]/2.0;              
                            shape.par("dy")=wpfm.ustsd[int(2)-1]/2.0;              
                            shape.par("dz")=wpfm.ustsd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wpfm.ustsd[int(1)-1]/2.0 dy=wpfm.ustsd[int(2)-1]/2.0 dz=wpfm.ustsd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPUS;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPUS");              
                            /// Add daughter volume WPAR to mother WPUS              
                            place.TranslateX(-wpfm.ustsd[int(4)-1]/2.0);              
                            /// Translate x = -wpfm.ustsd[int(4)-1]/2.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            place.par("dx")=wpfm.ustsd[int(1)-1]/2.0-wpfm.ustsd[int(4)-1]/2.0;              
                            place.par("dy")=wpfm.ustsd[int(2)-1]/2.0-wpfm.ustsd[int(4)-1];              
                            place.par("dz")=wpfm.ustsd[int(3)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPUS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPUS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *WPAR::mInstance = 0;     
          AgBlock *WPAR::Instance(){        
                   if ( mInstance==0 ) mInstance = new WPAR();        
                   return mInstance;        
          }     
          void WPAR::Block( AgCreate create )     
          {         
                ///@addtogroup WPAR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPAR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.0;              
                            shape.par("dy")=0.0;              
                            shape.par("dz")=0.0;              
                            /// Shape Bbox dx=0.0 dy=0.0 dz=0.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPAR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_WPAR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPAR     
