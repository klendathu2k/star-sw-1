          AgBlock *FLIG::mInstance = 0;     
          AgBlock *FLIG::Instance(){        
                   if ( mInstance==0 ) mInstance = new FLIG();        
                   return mInstance;        
          }     
          void FLIG::Block( AgCreate create )     
          {         
                ///@addtogroup FLIG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FLIG");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.par("serial")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=prsw.dprs[int(1)-1]/2.0;              
                            shape.par("dy")=prsw.dz[int(1)-1]/2.0+prsw.dsipm[int(1)-1]/2.0;              
                            shape.par("dz")=dlg;              
                            /// Shape Bbox dx=prsw.dprs[int(1)-1]/2.0 dy=prsw.dz[int(1)-1]/2.0+prsw.dsipm[int(1)-1]/2.0 dz=dlg               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FLIG;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FLBA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FLBA              
                            Create("FLBA");               
                      }           
                      _create = AgCreate("FLCO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FLCO              
                            Create("FLCO");               
                      }           
                      _create = AgCreate("FPMT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPMT              
                            Create("FPMT");               
                      }           
                      _create = AgCreate("FFEE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FFEE              
                            Create("FFEE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FLBA");              
                            place.SetMother("FLIG");              
                            /// Add daughter volume FLBA to mother FLIG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]/2.0-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]/2.0-dlg              
                            _stacker -> Position( AgBlock::Find("FLBA"), place );              
                      } // end placement of FLBA           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FLCO");              
                            place.SetMother("FLIG");              
                            /// Add daughter volume FLCO to mother FLIG              
                            place.TranslateX(-prsw.dprs[int(1)-1]/4.0);              
                            /// Translate x = -prsw.dprs[int(1)-1]/4.0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2.0-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2.0-dlg              
                            _stacker -> Position( AgBlock::Find("FLCO"), place );              
                      } // end placement of FLCO           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FLCO");              
                            place.SetMother("FLIG");              
                            /// Add daughter volume FLCO to mother FLIG              
                            place.TranslateX(+prsw.dprs[int(1)-1]/4.0);              
                            /// Translate x = +prsw.dprs[int(1)-1]/4.0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2.0-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2.0-dlg              
                            _stacker -> Position( AgBlock::Find("FLCO"), place );              
                      } // end placement of FLCO           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPMT");              
                            place.SetMother("FLIG");              
                            /// Add daughter volume FPMT to mother FLIG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(dlg-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate z = dlg-prsw.dsipm[int(1)-1]/2.0              
                            _stacker -> Position( AgBlock::Find("FPMT"), place );              
                      } // end placement of FPMT           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FFEE");              
                            place.SetMother("FLIG");              
                            /// Add daughter volume FFEE to mother FLIG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(prsw.dz[int(1)-1]/2.0);              
                            /// Translate y = prsw.dz[int(1)-1]/2.0              
                            place.TranslateZ(dlg-prsw.dsipm[int(4)-1]/2.0);              
                            /// Translate z = dlg-prsw.dsipm[int(4)-1]/2.0              
                            _stacker -> Position( AgBlock::Find("FFEE"), place );              
                      } // end placement of FFEE           
                      END_OF_FLIG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FLIG     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FLLG::mInstance = 0;     
          AgBlock *FLLG::Instance(){        
                   if ( mInstance==0 ) mInstance = new FLLG();        
                   return mInstance;        
          }     
          void FLLG::Block( AgCreate create )     
          {         
                ///@addtogroup FLLG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FLLG");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.par("serial")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=prsw.dprs[int(2)-1]/2.0;              
                            shape.par("dy")=prsw.dz[int(1)-1]/2.0+prsw.dsipm[int(1)-1]/2.0;              
                            shape.par("dz")=dlg;              
                            /// Shape Bbox dx=prsw.dprs[int(2)-1]/2.0 dy=prsw.dz[int(1)-1]/2.0+prsw.dsipm[int(1)-1]/2.0 dz=dlg               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FLLG;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FBLL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FBLL              
                            Create("FBLL");               
                      }           
                      _create = AgCreate("FCLL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FCLL              
                            Create("FCLL");               
                      }           
                      _create = AgCreate("FPMT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FPMT              
                            Create("FPMT");               
                      }           
                      _create = AgCreate("FFEE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FFEE              
                            Create("FFEE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FBLL");              
                            place.SetMother("FLLG");              
                            /// Add daughter volume FBLL to mother FLLG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]/2.0-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]/2.0-dlg              
                            _stacker -> Position( AgBlock::Find("FBLL"), place );              
                      } // end placement of FBLL           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FCLL");              
                            place.SetMother("FLLG");              
                            /// Add daughter volume FCLL to mother FLLG              
                            place.TranslateX(-prsw.dprs[int(2)-1]/4.0);              
                            /// Translate x = -prsw.dprs[int(2)-1]/4.0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2-dlg              
                            _stacker -> Position( AgBlock::Find("FCLL"), place );              
                      } // end placement of FCLL           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FCLL");              
                            place.SetMother("FLLG");              
                            /// Add daughter volume FCLL to mother FLLG              
                            place.TranslateX(prsw.dprs[int(2)-1]/4.0);              
                            /// Translate x = prsw.dprs[int(2)-1]/4.0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2-dlg);              
                            /// Translate z = prsw.dlg[int(3)-1]+prsw.dlg[int(2)-1]/2-dlg              
                            _stacker -> Position( AgBlock::Find("FCLL"), place );              
                      } // end placement of FCLL           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FPMT");              
                            place.SetMother("FLLG");              
                            /// Add daughter volume FPMT to mother FLLG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate y = -prsw.dsipm[int(1)-1]/2.0              
                            place.TranslateZ(dlg-prsw.dsipm[int(1)-1]/2.0);              
                            /// Translate z = dlg-prsw.dsipm[int(1)-1]/2.0              
                            _stacker -> Position( AgBlock::Find("FPMT"), place );              
                      } // end placement of FPMT           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FFEE");              
                            place.SetMother("FLLG");              
                            /// Add daughter volume FFEE to mother FLLG              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(prsw.dz[int(1)-1]/2.0);              
                            /// Translate y = prsw.dz[int(1)-1]/2.0              
                            place.TranslateZ(dlg-prsw.dsipm[int(4)-1]/2.0);              
                            /// Translate z = dlg-prsw.dsipm[int(4)-1]/2.0              
                            _stacker -> Position( AgBlock::Find("FFEE"), place );              
                      } // end placement of FFEE           
                      END_OF_FLLG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FLLG     
          // ---------------------------------------------------------------------------------------------------     
