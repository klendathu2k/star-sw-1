                            /// Add daughter volume FESC to mother FEDC              
                            place.TranslateX(-(xofffedc)/2.0+inse.ra*cos(pi/4.0));              
                            /// Translate x = -(xofffedc)/2.0+inse.ra*cos(pi/4.0)              
                            place.TranslateY(inse.ra*sin(pi/4.0));              
