             /// USE fmcg _index=1;        
             FMCG.use( __fmcg__index__ = 1 );
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             /// Loop on m from 1 to 4 step=1        
             for ( m=1; (1>0)? (m<=4):(m>=4); m+=1 )        
             {           
                   /// USE fpos imod=m;           
                   FPOS.use( __fpos_imod__ = m );
           
                   /// USE fbxd type=fpos.itype;           
                   FBXD.use( __fbxd_type__ = fpos.itype );
           
                   if ( fbxd.type==1 )           
                   {              
                         /// USE flgg type=1;              
                         FLGG.use( __flgg_type__ = 1 );
              
                         wid=flgg.width+flgg.dgap+flgg.althick*2.0;              
                         ztot=(flgg.depth+flgg.althick+flgg.mumetdz)/2.0;              
                         rtot=fbxd.nx*wid/2.0;              
                         bwid=rtot+fbxd.xoffset;              
                   }           
                   else           
                   {              
                         /// USE flgg type=2;              
                         FLGG.use( __flgg_type__ = 2 );
              
                         wid=flgg.width+flgg.dgap+flgg.althick*2.0;              
                         ztot=(flgg.depth+flgg.althick+flgg.mumetdz)/2.0;              
                         rtot=fbxd.nxl*wid/2.0;              
                         bwid=rtot;              
                   }           
                   if ( m>=3 )           
                   {              
                         bwid=fbxd.width/2.0;              
                         if ( fpos.x>0.0 )              
                         {                 
                               xx=fpos.x+bwid;                 
                         }              
                         else if ( fpos.x==0.0 )              
                         {                 
                               xx=0.0;                 
                         }              
                         else              
                         {                 
                               xx=fpos.x-bwid;                 
                         }              
                   }           
                   else           
                   {              
                         if ( fpos.x>0.0 )              
                         {                 
                               xx=fpos.x+bwid;                 
                         }              
                         else if ( fpos.x==0.0 )              
                         {                 
                               xx=0.0;                 
                         }              
                         else              
                         {                 
                               xx=fpos.x-bwid;                 
                         }              
                   }           
                   if ( fpos.y>0.0 )           
                   {              
                         yy=fpos.y+fbxd.height/2.0;              
                   }           
                   else if ( fpos.y==0.0 )           
                   {              
                         yy=0.0;              
                   }           
                   else           
                   {              
                         yy=fpos.y-fbxd.height/2.0;              
                   }           
                   if ( fpos.z>0.0 )           
                   {              
                         zz=fpos.z+fbxd.depth/2.0;              
                   }           
                   else           
                   {              
                         zz=fpos.z-fbxd.depth/2.0;              
                   }           
                   sern=0;           
                   if ( m==4 )           
                   {              
                         sern=1;              
                   }           
                   if ( m!=7 )           
                   {              
                         _create = AgCreate("FBOX");              
                         {                 
                               AgShape myshape; // undefined shape                 
                               ///Create FBOX                 
                               Create("FBOX");                  
                         }              
                         if ( zz>0 )              
                         {                 
                               AgPosition  place;                 
                               place.SetBlock("FBOX");                 
                               place.SetMother("CAVE");                 
                               place.SetGroup("WestRefSys");                 
                               /// Add daughter volume FBOX to mother CAVE                 
                               place.TranslateX(xx);                 
                               /// Translate x = xx                 
                               place.TranslateY(yy);                 
                               /// Translate y = yy                 
                               place.TranslateZ(zz);                 
                               /// Translate z = zz                 
                               place.par("only")=AgPosition::kMany;                 
                               /// Overlap: agposition::kmany                 
                               place.AlphaY(fpos.ay);                 
                               /// Rotate: AlphaY = fpos.ay                 
                               /// G3 Reference: thetax = 90                 
                               /// G3 Reference: phix = 0                 
                               /// G3 Reference: thetay = 90                 
                               /// G3 Reference: phiy = 90                 
                               /// G3 Reference: thetaz = 0                 
                               /// G3 Reference: phiz = 0                 
                               _stacker -> Position( AgBlock::Find("FBOX"), place );                 
                         } // end placement of FBOX              
                         if ( zz<0 )              
                         {                 
                               AgPosition  place;                 
                               place.SetBlock("FBOX");                 
                               place.SetMother("CAVE");                 
                               place.SetGroup("EastRefSys");                 
                               /// Add daughter volume FBOX to mother CAVE                 
                               place.TranslateX(xx);                 
                               /// Translate x = xx                 
                               place.TranslateY(yy);                 
                               /// Translate y = yy                 
                               place.TranslateZ(zz);                 
                               /// Translate z = zz                 
                               place.par("only")=AgPosition::kMany;                 
                               /// Overlap: agposition::kmany                 
                               place.AlphaY(fpos.ay);                 
                               /// Rotate: AlphaY = fpos.ay                 
                               /// G3 Reference: thetax = 90                 
                               /// G3 Reference: phix = 0                 
                               /// G3 Reference: thetay = 90                 
                               /// G3 Reference: phiy = 90                 
                               /// G3 Reference: thetaz = 0                 
                               /// G3 Reference: phiz = 0                 
                               _stacker -> Position( AgBlock::Find("FBOX"), place );                 
                         } // end placement of FBOX              
                   }           
             }        
             _create = AgCreate("FPRS");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create FPRS           
                   Create("FPRS");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("FPRS");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume FPRS to mother CAVE           
                   place.TranslateX(0.0);           
                   /// Translate x = 0.0           
                   place.TranslateY(0.0);           
                   /// Translate y = 0.0           
                   place.TranslateZ(prsw.zoff[int(1)-1]-prsw.dsipm[int(1)-1]+prsw.dbox[int(3)-1]/2.0);           
                   /// Translate z = prsw.zoff[int(1)-1]-prsw.dsipm[int(1)-1]+prsw.dbox[int(3)-1]/2.0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("FPRS"), place );           
             } // end placement of FPRS        
             if ( fmcg.postshower==1 )        
             {           
                   _create = AgCreate("FPST");           
                   {              
                         AgShape myshape; // undefined shape              
                         ///Create FPST              
                         Create("FPST");               
                   }           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FPST");              
                         place.SetMother("CAVE");              
                         place.SetGroup("WestRefSys");              
                         /// Add daughter volume FPST to mother CAVE              
                         place.TranslateX(0.0);              
                         /// Translate x = 0.0              
                         place.TranslateY(0.0);              
                         /// Translate y = 0.0              
                         place.TranslateZ(post.zoff[int(1)-1][int(1)-1]-2.0+post.dbox[int(3)-1]/2.0);              
                         /// Translate z = post.zoff[int(1)-1][int(1)-1]-2.0+post.dbox[int(3)-1]/2.0              
                         place.par("only")=AgPosition::kOnly;              
                         /// Overlap: agposition::konly              
                         _stacker -> Position( AgBlock::Find("FPST"), place );              
                   } // end placement of FPST           
             }        
             _create = AgCreate("WPPL");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create WPPL           
                   Create("WPPL");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPPL");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPPL to mother CAVE           
                   place.TranslateX(+wpfm.polep[int(1)-1]);           
                   /// Translate x = +wpfm.polep[int(1)-1]           
                   place.TranslateY(wpfm.polep[int(2)-1]);           
                   /// Translate y = wpfm.polep[int(2)-1]           
                   place.TranslateZ(wpfm.polep[int(3)-1]);           
                   /// Translate z = wpfm.polep[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPPL"), place );           
             } // end placement of WPPL        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPPL");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPPL to mother CAVE           
                   place.TranslateX(-wpfm.polep[int(1)-1]);           
                   /// Translate x = -wpfm.polep[int(1)-1]           
                   place.TranslateY(wpfm.polep[int(2)-1]);           
                   /// Translate y = wpfm.polep[int(2)-1]           
                   place.TranslateZ(wpfm.polep[int(3)-1]);           
                   /// Translate z = wpfm.polep[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPPL"), place );           
             } // end placement of WPPL        
             _create = AgCreate("WPIS");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create WPIS           
                   Create("WPIS");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPIS");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPIS to mother CAVE           
                   place.TranslateX(wpfm.ist1p[int(1)-1]);           
                   /// Translate x = wpfm.ist1p[int(1)-1]           
                   place.TranslateY(wpfm.ist1p[int(2)-1]);           
                   /// Translate y = wpfm.ist1p[int(2)-1]           
                   place.TranslateZ(wpfm.ist1p[int(3)-1]);           
                   /// Translate z = wpfm.ist1p[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPIS"), place );           
             } // end placement of WPIS        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPIS");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPIS to mother CAVE           
                   place.TranslateX(wpfm.ist2p[int(1)-1]);           
                   /// Translate x = wpfm.ist2p[int(1)-1]           
                   place.TranslateY(wpfm.ist2p[int(2)-1]);           
                   /// Translate y = wpfm.ist2p[int(2)-1]           
                   place.TranslateZ(wpfm.ist2p[int(3)-1]);           
                   /// Translate z = wpfm.ist2p[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPIS"), place );           
             } // end placement of WPIS        
             _create = AgCreate("WPUF");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create WPUF           
                   Create("WPUF");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPUF");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPUF to mother CAVE           
                   place.TranslateX(+wpfm.ustfp[int(1)-1]);           
                   /// Translate x = +wpfm.ustfp[int(1)-1]           
                   place.TranslateY(wpfm.ustfp[int(2)-1]);           
                   /// Translate y = wpfm.ustfp[int(2)-1]           
                   place.TranslateZ(wpfm.ustfp[int(3)-1]);           
                   /// Translate z = wpfm.ustfp[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPUF"), place );           
             } // end placement of WPUF        
             _create = AgCreate("WPUN");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create WPUN           
                   Create("WPUN");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPUN");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPUN to mother CAVE           
                   place.TranslateX(+wpfm.ustnp[int(1)-1]);           
                   /// Translate x = +wpfm.ustnp[int(1)-1]           
                   place.TranslateY(wpfm.ustnp[int(2)-1]);           
                   /// Translate y = wpfm.ustnp[int(2)-1]           
                   place.TranslateZ(wpfm.ustnp[int(3)-1]);           
                   /// Translate z = wpfm.ustnp[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPUN"), place );           
             } // end placement of WPUN        
             _create = AgCreate("WPUS");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create WPUS           
                   Create("WPUS");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("WPUS");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume WPUS to mother CAVE           
                   place.TranslateX(+wpfm.ustsp[int(1)-1]);           
                   /// Translate x = +wpfm.ustsp[int(1)-1]           
                   place.TranslateY(wpfm.ustsp[int(2)-1]);           
                   /// Translate y = wpfm.ustsp[int(2)-1]           
                   place.TranslateZ(wpfm.ustsp[int(3)-1]);           
                   /// Translate z = wpfm.ustsp[int(3)-1]           
                   _stacker -> Position( AgBlock::Find("WPUS"), place );           
             } // end placement of WPUS        
       }; // FPDMGEO4     
 }; // namespace FPDMGEO4  
 