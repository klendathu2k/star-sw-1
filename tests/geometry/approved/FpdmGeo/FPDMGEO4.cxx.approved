       void FPDMGEO4::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup FPDMGEO4_revision        
             ///@{           
                   /// Created:    27 Nov 2006            
             ///@}        
             ///@addtogroup FPDMGEO4_revision        
             ///@{           
                   /// Author: Akio Ogawa           
             ///@}        
             AddBlock("FBOX", FBOX::Instance());        
             AddBlock("FTOW", FTOW::Instance());        
             AddBlock("FLXF", FLXF::Instance());        
             AddBlock("FWAL", FWAL::Instance());        
             AddBlock("FLGR", FLGR::Instance());        
             AddBlock("FPCT", FPCT::Instance());        
             AddBlock("FUMT", FUMT::Instance());        
             AddBlock("PBPT", PBPT::Instance());        
             AddBlock("FSHM", FSHM::Instance());        
             AddBlock("FHMS", FHMS::Instance());        
             AddBlock("FXGT", FXGT::Instance());        
             AddBlock("FALU", FALU::Instance());        
             AddBlock("FBAS", FBAS::Instance());        
             AddBlock("FENC", FENC::Instance());        
             AddBlock("FEAC", FEAC::Instance());        
             AddBlock("FEBC", FEBC::Instance());        
             AddBlock("FECC", FECC::Instance());        
             AddBlock("FEDC", FEDC::Instance());        
             AddBlock("FETC", FETC::Instance());        
             AddBlock("FERC", FERC::Instance());        
             AddBlock("FESC", FESC::Instance());        
             AddBlock("FEEC", FEEC::Instance());        
             AddBlock("FPRS", FPRS::Instance());        
             AddBlock("FPLY", FPLY::Instance());        
             AddBlock("FPPB", FPPB::Instance());        
             AddBlock("FPSC", FPSC::Instance());        
             AddBlock("FPBB", FPBB::Instance());        
             AddBlock("FLIG", FLIG::Instance());        
             AddBlock("FLBA", FLBA::Instance());        
             AddBlock("FLCO", FLCO::Instance());        
             AddBlock("FPMT", FPMT::Instance());        
             AddBlock("FFEE", FFEE::Instance());        
             AddBlock("FLLG", FLLG::Instance());        
             AddBlock("FBLL", FBLL::Instance());        
             AddBlock("FCLL", FCLL::Instance());        
             AddBlock("WPPL", WPPL::Instance());        
             AddBlock("WPIS", WPIS::Instance());        
             AddBlock("WPUF", WPUF::Instance());        
             AddBlock("WPUN", WPUN::Instance());        
             AddBlock("WPUS", WPUS::Instance());        
             AddBlock("WPAR", WPAR::Instance());        
             AddBlock("FPST", FPST::Instance());        
             AddBlock("FTLY", FTLY::Instance());        
             AddBlock("FOSC", FOSC::Instance());        
             n=12;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fmcg
++fmcg._index;
fmcg.version = 9.0;
// fmcg_docum.version = " Geometry version  ";
fmcg.chkvsim = 0;
// fmcg_docum.chkvsim = " = 0 dE, = 1 Cherenkov simulation for PbG ";
fmcg.pbplate = 0;
// fmcg_docum.pbplate = " =0 no plate, =1 with plate ";
fmcg.fmsnorthx = -2.0;
// fmcg_docum.fmsnorthx = "Default x-position";
fmcg.fmssouthx = +5.0;
// fmcg_docum.fmssouthx = "Default x-position";
fmcg.atten = 0.0;
// fmcg_docum.atten = "default, no attenuation, 1 = attenuation";
fmcg.postshower = 0;
// fmcg_docum.postshower = "0: no postshower 1: yes postshower";
FMCG.fill();
        
             /// USE fmcg version=9.0;        
             FMCG.use( __fmcg_version__ = 9.0 );
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 1;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 1;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = -48.19;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = -779.0;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 180;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 2;
// fpos_docum.imod = " Module# (EN=1, ES=2, WS=3, WS=4, ...) ";
fpos.itype = 1;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = 48.19;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = -779.0;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 180;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 3;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = fmcg.fmsnorthx;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 706.3;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 4;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = fmcg.fmssouthx;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 706.3;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 1;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fbxd.height = 100;
// fbxd_docum.height = " Box height ";
fbxd.depth = 96;
// fbxd_docum.depth = " Box Depth ";
fbxd.width = 0.0;
// fbxd_docum.width = " Box Width (only for FMS) ";
fbxd.nx = 7;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 7;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.nxl = 0;
// fbxd_docum.nxl = " Number of large pbg in x ";
fbxd.nyl = 0;
// fbxd_docum.nyl = " number of large pbg in y ";
fbxd.xoffset = 2.54;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 19;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge       ";
fbxd.psoffset = 2.0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoff = 8.0;
// fbxd_docum.smdoff = " SMD V-plane z offset from box edge ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 2;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fbxd.height = 212;
// fbxd_docum.height = " Box height ";
fbxd.depth = 98.425;
// fbxd_docum.depth = " Box Depth ";
fbxd.width = 127.0;
// fbxd_docum.width = " Box Width (only for FMS) ";
fbxd.nx = 12;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 24;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.nxl = 17;
// fbxd_docum.nxl = " Number of large pbg in x ";
fbxd.nyl = 34;
// fbxd_docum.nyl = " number of large pbg in y ";
fbxd.xoffset = (6*3.822+0.5*5.812)+(127.0-17*5.812)/2.0;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 10.4;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge ";
fbxd.psoffset = 0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoff = 0.0;
// fbxd_docum.smdoff = " SMD z offset from box edge ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgg
++flgg._index;
flgg.type = 1;
// flgg_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgg.width = 3.81;
// flgg_docum.width = " PbG width  ";
flgg.depth = 45.0;
// flgg_docum.depth = " PbG depth ";
flgg.dgap = 0.01;
// flgg_docum.dgap = " Gap between PbG ";
flgg.althick = 0.001;
// flgg_docum.althick = " almunim wrap thickness (real) ";
flgg.phcathdz = 2.0;
// flgg_docum.phcathdz = " Photo Cathode thickness ";
flgg.phcathr = 1.8;
// flgg_docum.phcathr = " Photo Cathode radius  (real) ";
flgg.mumetdz = 11.0;
// flgg_docum.mumetdz = " Mu Metal Length ";
flgg.mumetr = 1.9;
// flgg_docum.mumetr = " Mu metal outer Radius  (real) ";
FLGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgg
++flgg._index;
flgg.type = 2;
// flgg_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgg.width = 5.8;
// flgg_docum.width = " PbG width  ";
flgg.depth = 60.2;
// flgg_docum.depth = " PbG depth ";
flgg.dgap = 0.01;
// flgg_docum.dgap = " Gap between PbG ";
flgg.althick = 0.001;
// flgg_docum.althick = " almunim wrap thickness (real) ";
flgg.phcathdz = 2.0;
// flgg_docum.phcathdz = " Photo Cathode thickness ";
flgg.phcathr = 1.8;
// flgg_docum.phcathr = " Photo Cathode radius  (real) ";
flgg.mumetdz = 11.0;
// flgg_docum.mumetdz = " Mu Metal Length ";
flgg.mumetr = 1.9;
// flgg_docum.mumetr = " Mu metal outer Radius  (real) ";
FLGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgm
++flgm._index;
flgm.type = 1;
// flgm_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgm.density = 3.86;
// flgm_docum.density = " gdensity [/cm^3] ";
flgm.radlen = 2.5;
// flgm_docum.radlen = " radiation length [cm] ";
flgm.pbcont = 65.4;
// flgm_docum.pbcont = " PbO content [%] ";
flgm.critene = 0.0158;
// flgm_docum.critene = " critical energy [GeV] ";
flgm.molierer = 3.32;
// flgm_docum.molierer = " Moliere radius [cm] ";
FLGM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgm
++flgm._index;
flgm.type = 2;
// flgm_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgm.density = 3.61;
// flgm_docum.density = " gdensity [/cm^3] ";
flgm.radlen = 3.21;
// flgm_docum.radlen = " radiation length [cm] ";
flgm.pbcont = 45.0;
// flgm_docum.pbcont = " PbO content [%] ";
FLGM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pbpd
++pbpd._index;
pbpd.width = 33.02;
// pbpd_docum.width = " Width ";
pbpd.height = 33.02;
// pbpd_docum.height = " Height ";
pbpd.thick = 1.27;
// pbpd_docum.thick = " Thickness ";
PBPD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fmxg
++fmxg._index;
fmxg.version = 2;
// fmxg_docum.version = " Geometry version ";
fmxg.sapex = 0.7;
// fmxg_docum.sapex = " Scintillator strip apex ";
fmxg.sbase = 1.0;
// fmxg_docum.sbase = " Scintillator strip base ";
fmxg.sgap = 0.0064;
// fmxg_docum.sgap = " Gap between strips ";
fmxg.nstrip = 50;
// fmxg_docum.nstrip = " # of strips ";
fmxg.g10width = 27.0;
// fmxg_docum.g10width = " G10 plate width ";
fmxg.g10hgt = 27.0;
// fmxg_docum.g10hgt = " G10 plate height ";
fmxg.g10thick = 0.15;
// fmxg_docum.g10thick = " G10 plate thickness ";
FMXG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill inse
++inse._index;
inse.width = 19.30908;
// inse_docum.width = " Width of the insert (x) ";
inse.depth = 98.425;
// inse_docum.depth = " Depth of the insert (z) ";
inse.height = 38.608;
// inse_docum.height = " Height of the insert (y)   ";
inse.sheetdpt = 1.27;
// inse_docum.sheetdpt = " Depth of the steel parts (x,y) ";
inse.holegap = 5.08;
// inse_docum.holegap = " Distance between edge of INSERT and square hole ";
inse.holedepth = 25.4;
// inse_docum.holedepth = " Depth of the square hole (z) ";
inse.holeheight = 30.48;
// inse_docum.holeheight = " Height of the square hole (y) ";
inse.gapdepth = 19.685;
// inse_docum.gapdepth = " Depth of the iron distancer (z) ";
inse.gapheight = 7.874;
// inse_docum.gapheight = " Height of the iron distancer (y) ";
inse.gatedepth = 1.905;
// inse_docum.gatedepth = " Depth of one of the three Gates (z) ";
inse.gategap = 12.7;
// inse_docum.gategap = " Distance between the back edge of the box and last gate ";
inse.ra = 13.97;
// inse_docum.ra = " Radius of the inner circle of tubes ";
inse.rb = 20.6375;
// inse_docum.rb = " Radius of the outer circle of tubes  ";
inse.diam = 6.0325;
// inse_docum.diam = " Diameter of the tubes ";
inse.rmax = 10.16;
// inse_docum.rmax = " Radius of the inner tube for beampipe ";
INSE.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill post
++post._index;
