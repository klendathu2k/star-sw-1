                                                    /// Translate y = y1                          
                                                    place.TranslateZ(z1);                          
                                                    /// Translate z = z1                          
                                                    _stacker -> Position( AgBlock::Find("FLXF"), place );                          
                                              } // end placement of FLXF                       
                                              x1=x1+widx;                       
