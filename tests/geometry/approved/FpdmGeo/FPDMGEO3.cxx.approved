          AgBlock *FSHM::mInstance = 0;     
          AgBlock *FSHM::Instance(){        
                   if ( mInstance==0 ) mInstance = new FSHM();        
                   return mInstance;        
          }     
          void FSHM::Block( AgCreate create )     
          {         
                ///@addtogroup FSHM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FSHM");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=fmxg.g10width/2.0;              
                            shape.par("dy")=fmxg.g10hgt/2.0;              
                            shape.par("dz")=ztotsmd;              
                            /// Shape Bbox dx=fmxg.g10width/2.0 dy=fmxg.g10hgt/2.0 dz=ztotsmd               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSHM;              
                            _stacker -> Build(this);              
                      }           
                      wsmd=fmxg.sbase/2.0+fmxg.sgap;           
                      wtotsmd=(fmxg.nstrip+1)*wsmd;           
                      zsmd=-ztotsmd+fmxg.g10thick/2.0;           
                      _create = AgCreate("FXGT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FXGT              
                            Create("FXGT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FXGT");              
                            place.SetMother("FSHM");              
                            /// Add daughter volume FXGT to mother FSHM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(zsmd);              
                            /// Translate z = zsmd              
                            _stacker -> Position( AgBlock::Find("FXGT"), place );              
                      } // end placement of FXGT           
                      xsmdv=-wtotsmd/2.0-fmxg.sgap/2.0+wsmd;           
                      ysmdv=0.0;           
                      zsmdv=zsmd+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      /// Loop on i from 1 to fmxg.nstrip step=1           
                      for ( i=1; (1>0)? (i<=fmxg.nstrip):(i>=fmxg.nstrip); i+=1 )           
                      {              
                            if ( mod(i,2)!=0 )              
                            {                 
                                  _create = AgCreate("FHMS");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create FHMS                    
                                        Create("FHMS");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdv);                    
                                        /// Translate x = xsmdv                    
                                        place.TranslateY(ysmdv);                    
                                        /// Translate y = ysmdv                    
                                        place.TranslateZ(zsmdv);                    
                                        /// Translate z = zsmdv                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            else              
                            {                 
                                  _create = AgCreate("FHMS");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create FHMS                    
                                        Create("FHMS");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdv);                    
                                        /// Translate x = xsmdv                    
                                        place.TranslateY(ysmdv);                    
                                        /// Translate y = ysmdv                    
                                        place.TranslateZ(zsmdv);                    
                                        /// Translate z = zsmdv                    
                                        place.AlphaX(180);                    
                                        /// Rotate: AlphaX = 180                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            xsmdv=xsmdv+wsmd;              
                      }           
                      zsmd2=zsmdv+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      _create = AgCreate("FXGT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FXGT              
                            Create("FXGT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FXGT");              
                            place.SetMother("FSHM");              
                            /// Add daughter volume FXGT to mother FSHM              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(zsmd2);              
                            /// Translate z = zsmd2              
                            _stacker -> Position( AgBlock::Find("FXGT"), place );              
                      } // end placement of FXGT           
                      xsmdh=0.0;           
                      ysmdh=-wtotsmd/2.0-fmxg.sgap/2.0+wsmd;           
                      zsmdh=zsmd2+fmxg.g10thick/2.0+fmxg.sapex/2.0;           
                      _create = AgCreate("FHMS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHMS              
                            Create("FHMS");               
                      }           
                      /// Loop on i from 1 to fmxg.nstrip step=1           
                      for ( i=1; (1>0)? (i<=fmxg.nstrip):(i>=fmxg.nstrip); i+=1 )           
                      {              
                            if ( mod(i,2)!=0 )              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdh);                    
                                        /// Translate x = xsmdh                    
                                        place.TranslateY(ysmdh);                    
                                        /// Translate y = ysmdh                    
                                        place.TranslateZ(zsmdh);                    
                                        /// Translate z = zsmdh                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Ortho( "Y-XZ" ); // ORT=Y-XZ                    
                                        /// Axis substitution: XYZ --> Y-XZ                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            else              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FHMS");                    
                                        place.SetMother("FSHM");                    
                                        /// Add daughter volume FHMS to mother FSHM                    
                                        place.TranslateX(xsmdh);                    
                                        /// Translate x = xsmdh                    
                                        place.TranslateY(ysmdh);                    
                                        /// Translate y = ysmdh                    
                                        place.TranslateZ(zsmdh);                    
                                        /// Translate z = zsmdh                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Ortho( "YX-Z" ); // ORT=YX-Z                    
                                        /// Axis substitution: XYZ --> YX-Z                    
                                        _stacker -> Position( AgBlock::Find("FHMS"), place );                    
                                  } // end placement of FHMS                 
                            }              
                            ysmdh=ysmdh+wsmd;              
                      }           
                      END_OF_FSHM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSHM     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FXGT::mInstance = 0;     
          AgBlock *FXGT::Instance(){        
                   if ( mInstance==0 ) mInstance = new FXGT();        
                   return mInstance;        
          }     
          void FXGT::Block( AgCreate create )     
          {         
                ///@addtogroup FXGT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Si	a=28.08	z=14	w=0.6*1*28./60.           
                      /// Component O	a=16	z=8	w=0.6*2*16./60.           
                      /// Component C	a=12	z=6	w=0.4*8*12./174.           
                      /// Component H	a=1	z=1	w=0.4*14*1./174.           
                      /// Component O	a=16	z=8	w=0.4*4*16./174.           
                      /// Mixture g10 dens=1.7           
                      {  AgMaterial &mix = AgMaterial::Get("G10");              
                            mix.Component("Si",28.08,14,0.6*1*28./60.);              
                            mix.Component("O",16,8,0.6*2*16./60.);              
                            mix.Component("C",12,6,0.4*8*12./174.);              
                            mix.Component("H",1,1,0.4*14*1./174.);              
                            mix.Component("O",16,8,0.4*4*16./174.);              
                            mix.par("dens")=1.7;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("FXGT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=fmxg.g10width/2;              
                            shape.par("dy")=fmxg.g10hgt/2;              
                            shape.par("dz")=fmxg.g10thick/2;              
                            /// Shape Bbox dx=fmxg.g10width/2 dy=fmxg.g10hgt/2 dz=fmxg.g10thick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FXGT;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 0.00001 (deferred)           
                      // cut cutele = 0.00001 (deferred)           
                      END_OF_FXGT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FXGT     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FHMS::mInstance = 0;     
          AgBlock *FHMS::Instance(){        
                   if ( mInstance==0 ) mInstance = new FHMS();        
                   return mInstance;        
          }     
          void FHMS::Block( AgCreate create )     
          {         
                ///@addtogroup FHMS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material POLYSTYREN            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Material Cpolystyren isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Cpolystyren");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FHMS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd1");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=0;              
                            shape.par("dx2")=fmxg.sbase/2.0;              
                            shape.par("dy")=fmxg.g10hgt/2.0;              
                            shape.par("dz")=fmxg.sapex/2.0;              
                            /// Shape Trd1 dx1=0 dx2=fmxg.sbase/2.0 dy=fmxg.g10hgt/2.0 dz=fmxg.sapex/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FHMS;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 0.00008 (deferred)           
                      // cut cutele = 0.001 (deferred)           
                      // cut bcute = 0.0001 (deferred)           
                      // parameter birk1 = 1. (deferred)           
                      // parameter birk2 = 0.0130 (deferred)           
                      // parameter birk3 = 9.6e-6 (deferred)           
                      // deferred module()->AddHit( "FHMS", "birk", 0, 0, 10, "");           
                      END_OF_FHMS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FHMS     
    // ----------------------------------------------------------------------- geoctr
       void FPDMGEO3::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup FPDMGEO3_revision        
             ///@{           
                   /// Created:    27 Nov 2006            
             ///@}        
             ///@addtogroup FPDMGEO3_revision        
             ///@{           
                   /// Author: Akio Ogawa           
             ///@}        
             AddBlock("FBOX", FBOX::Instance());        
             AddBlock("FTOW", FTOW::Instance());        
             AddBlock("FLXF", FLXF::Instance());        
             AddBlock("FWAL", FWAL::Instance());        
             AddBlock("FLGR", FLGR::Instance());        
             AddBlock("FPCT", FPCT::Instance());        
             AddBlock("FUMT", FUMT::Instance());        
             AddBlock("PBPT", PBPT::Instance());        
             AddBlock("FSHM", FSHM::Instance());        
             AddBlock("FHMS", FHMS::Instance());        
             AddBlock("FXGT", FXGT::Instance());        
             AddBlock("FALU", FALU::Instance());        
             AddBlock("FBAS", FBAS::Instance());        
             AddBlock("FENC", FENC::Instance());        
             AddBlock("FEAC", FEAC::Instance());        
             AddBlock("FEBC", FEBC::Instance());        
             AddBlock("FECC", FECC::Instance());        
             AddBlock("FEDC", FEDC::Instance());        
             AddBlock("FETC", FETC::Instance());        
             AddBlock("FERC", FERC::Instance());        
             AddBlock("FESC", FESC::Instance());        
             AddBlock("FEEC", FEEC::Instance());        
             n=12;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fmcg
++fmcg._index;
fmcg.version = 8.0;
// fmcg_docum.version = " Geometry version  ";
fmcg.chkvsim = 0;
// fmcg_docum.chkvsim = " = 0 dE, = 1 Cherenkov simulation for PbG ";
fmcg.pbplate = 0;
// fmcg_docum.pbplate = " =0 no plate, =1 with plate ";
fmcg.fmsnorthx = -0.3;
// fmcg_docum.fmsnorthx = "Default x-position";
fmcg.fmssouthx = +0.3;
// fmcg_docum.fmssouthx = "Default x-position";
fmcg.atten = 0.0;
// fmcg_docum.atten = "Default 0=attenuation off";
fmcg.postshower = 0;
// fmcg_docum.postshower = "ignored";
FMCG.fill();
        
             /// USE fmcg version=8.0;        
             FMCG.use( __fmcg_version__ = 8.0 );
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 1;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 1;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = -48.19;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = -779.0;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 180;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 2;
// fpos_docum.imod = " Module# (EN=1, ES=2, WS=3, WS=4, ...) ";
fpos.itype = 1;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = 48.19;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = -779.0;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 180;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 3;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = fmcg.fmsnorthx;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 706.3;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fpos
++fpos._index;
fpos.imod = 4;
// fpos_docum.imod = " Module# (EN=1, ES=2, WN=3, WS=4, ...) ";
fpos.itype = 2;
// fpos_docum.itype = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fpos.x = fmcg.fmssouthx;
// fpos_docum.x = " X distance from beam to edge of detector ";
fpos.y = 0.0;
// fpos_docum.y = " Y distance from beam to edge of detector ";
fpos.z = 706.3;
// fpos_docum.z = " Z distance from IP to surface of detector ";
fpos.ay = 0;
// fpos_docum.ay = " Angle aroound Y (0 for west, 180 for east) ";
fpos.az = 0;
// fpos_docum.az = " Angle around Z ";
FPOS.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 1;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fbxd.height = 100;
// fbxd_docum.height = " Box height ";
fbxd.depth = 96;
// fbxd_docum.depth = " Box Depth ";
fbxd.width = 0.0;
// fbxd_docum.width = " Box Width (only for FMS) ";
fbxd.nx = 7;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 7;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.nxl = 0;
// fbxd_docum.nxl = " Number of large pbg in x ";
fbxd.nyl = 0;
// fbxd_docum.nyl = " number of large pbg in y ";
fbxd.xoffset = 2.54;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 19;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge       ";
fbxd.psoffset = 2.0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoff = 8.0;
// fbxd_docum.smdoff = " SMD V-plane z offset from box edge ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fbxd
++fbxd._index;
fbxd.type = 2;
// fbxd_docum.type = " Type (1=7*7+SMD+PreShower, 2=17*34+14*28) ";
fbxd.height = 210;
// fbxd_docum.height = " Box height ";
fbxd.depth = 98.425;
// fbxd_docum.depth = " Box Depth ";
fbxd.width = 127.0;
// fbxd_docum.width = " Box Width (only for FMS) ";
fbxd.nx = 12;
// fbxd_docum.nx = " Number of pbg in x ";
fbxd.ny = 24;
// fbxd_docum.ny = " number of pbg in y ";
fbxd.nxl = 17;
// fbxd_docum.nxl = " Number of large pbg in x ";
fbxd.nyl = 34;
// fbxd_docum.nyl = " number of large pbg in y ";
fbxd.xoffset = (6*3.822+0.5*5.812)+(127.0-17*5.812)/2.0;
// fbxd_docum.xoffset = " tower x offset from box edge to PbG edge ";
fbxd.zoffset = 10.4;
// fbxd_docum.zoffset = " tower z offset from box edge to PbG edge ";
fbxd.psoffset = 0;
// fbxd_docum.psoffset = " PreShower z offset from box edge to PbG edge ";
fbxd.smdoff = 0.0;
// fbxd_docum.smdoff = " SMD z offset from box edge ";
FBXD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgg
++flgg._index;
flgg.type = 1;
// flgg_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgg.width = 3.81;
// flgg_docum.width = " PbG width  ";
flgg.depth = 45.0;
// flgg_docum.depth = " PbG depth ";
flgg.dgap = 0.01;
// flgg_docum.dgap = " Gap between PbG ";
flgg.althick = 0.001;
// flgg_docum.althick = " almunim wrap thickness (real) ";
flgg.phcathdz = 2.0;
// flgg_docum.phcathdz = " Photo Cathode thickness ";
flgg.phcathr = 1.8;
// flgg_docum.phcathr = " Photo Cathode radius  (real) ";
flgg.mumetdz = 11.0;
// flgg_docum.mumetdz = " Mu Metal Length ";
flgg.mumetr = 1.9;
// flgg_docum.mumetr = " Mu metal outer Radius  (real) ";
FLGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgg
++flgg._index;
flgg.type = 2;
// flgg_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgg.width = 5.8;
// flgg_docum.width = " PbG width  ";
flgg.depth = 60.2;
// flgg_docum.depth = " PbG depth ";
flgg.dgap = 0.01;
// flgg_docum.dgap = " Gap between PbG ";
flgg.althick = 0.001;
// flgg_docum.althick = " almunim wrap thickness (real) ";
flgg.phcathdz = 2.0;
// flgg_docum.phcathdz = " Photo Cathode thickness ";
flgg.phcathr = 1.8;
// flgg_docum.phcathr = " Photo Cathode radius  (real) ";
flgg.mumetdz = 11.0;
// flgg_docum.mumetdz = " Mu Metal Length ";
flgg.mumetr = 1.9;
// flgg_docum.mumetr = " Mu metal outer Radius  (real) ";
FLGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgm
++flgm._index;
flgm.type = 1;
// flgm_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgm.density = 3.86;
// flgm_docum.density = " gdensity [/cm^3] ";
flgm.radlen = 2.5;
// flgm_docum.radlen = " radiation length [cm] ";
flgm.pbcont = 65.4;
// flgm_docum.pbcont = " PbO content [%] ";
flgm.critene = 0.0158;
// flgm_docum.critene = " critical energy [GeV] ";
flgm.molierer = 3.32;
// flgm_docum.molierer = " Moliere radius [cm] ";
FLGM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill flgm
++flgm._index;
flgm.type = 2;
// flgm_docum.type = " Type (1=Protovino Cell, 2=FLab Cell) ";
flgm.density = 3.61;
// flgm_docum.density = " gdensity [/cm^3] ";
flgm.radlen = 3.21;
// flgm_docum.radlen = " radiation length [cm] ";
flgm.pbcont = 45.0;
// flgm_docum.pbcont = " PbO content [%] ";
FLGM.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pbpd
++pbpd._index;
pbpd.width = 33.02;
// pbpd_docum.width = " Width ";
pbpd.height = 33.02;
// pbpd_docum.height = " Height ";
pbpd.thick = 1.27;
// pbpd_docum.thick = " Thickness ";
PBPD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fmxg
++fmxg._index;
fmxg.version = 2;
// fmxg_docum.version = " Geometry version ";
fmxg.sapex = 0.7;
// fmxg_docum.sapex = " Scintillator strip apex ";
fmxg.sbase = 1.0;
// fmxg_docum.sbase = " Scintillator strip base ";
fmxg.sgap = 0.0064;
// fmxg_docum.sgap = " Gap between strips ";
fmxg.nstrip = 50;
// fmxg_docum.nstrip = " # of strips ";
fmxg.g10width = 27.0;
// fmxg_docum.g10width = " G10 plate width ";
fmxg.g10hgt = 27.0;
// fmxg_docum.g10hgt = " G10 plate height ";
fmxg.g10thick = 0.15;
// fmxg_docum.g10thick = " G10 plate thickness ";
FMXG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill inse
++inse._index;
inse.width = 19.30908;
// inse_docum.width = " Width of the insert (x) ";
inse.depth = 98.425;
// inse_docum.depth = " Depth of the insert (z) ";
inse.height = 38.608;
// inse_docum.height = " Height of the insert (y)   ";
inse.sheetdpt = 1.27;
// inse_docum.sheetdpt = " Depth of the steel parts (x,y) ";
inse.holegap = 5.08;
// inse_docum.holegap = " Distance between edge of INSERT and square hole ";
inse.holedepth = 25.4;
// inse_docum.holedepth = " Depth of the square hole (z) ";
inse.holeheight = 30.48;
// inse_docum.holeheight = " Height of the square hole (y) ";
inse.gapdepth = 19.685;
// inse_docum.gapdepth = " Depth of the iron distancer (z) ";
inse.gapheight = 7.874;
// inse_docum.gapheight = " Height of the iron distancer (y) ";
inse.gatedepth = 1.905;
// inse_docum.gatedepth = " Depth of one of the three Gates (z) ";
inse.gategap = 12.7;
// inse_docum.gategap = " Distance between the back edge of the box and last gate ";
inse.ra = 13.97;
// inse_docum.ra = " Radius of the inner circle of tubes ";
inse.rb = 20.6375;
// inse_docum.rb = " Radius of the outer circle of tubes  ";
inse.diam = 6.0325;
// inse_docum.diam = " Diameter of the tubes ";
inse.rmax = 10.16;
// inse_docum.rmax = " Radius of the inner tube for beampipe ";
INSE.fill();
        
             /// USE fmcg _index=1;        
             FMCG.use( __fmcg__index__ = 1 );
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             /// Loop on m from 1 to 4 step=1        
             for ( m=1; (1>0)? (m<=4):(m>=4); m+=1 )        
             {           
                   /// USE fpos imod=m;           
                   FPOS.use( __fpos_imod__ = m );
           
                   /// USE fbxd type=fpos.itype;           
                   FBXD.use( __fbxd_type__ = fpos.itype );
           
                   if ( fbxd.type==1 )           
                   {              
                         /// USE flgg type=1;              
                         FLGG.use( __flgg_type__ = 1 );
              
                         wid=flgg.width+flgg.dgap+flgg.althick*2.0;              
                         ztot=(flgg.depth+flgg.althick+flgg.mumetdz)/2.0;              
                         rtot=fbxd.nx*wid/2.0;              
                         bwid=rtot+fbxd.xoffset;              
                   }           
                   else           
                   {              
                         /// USE flgg type=2;              
                         FLGG.use( __flgg_type__ = 2 );
              
                         wid=flgg.width+flgg.dgap+flgg.althick*2.0;              
                         ztot=(flgg.depth+flgg.althick+flgg.mumetdz)/2.0;              
                         rtot=fbxd.nxl*wid/2.0;              
                         bwid=rtot;              
                   }           
                   if ( m>=3 )           
                   {              
                         bwid=fbxd.width/2.0;              
                         if ( fpos.x>0.0 )              
                         {                 
                               xx=fpos.x+bwid;                 
                         }              
                         else if ( fpos.x==0.0 )              
                         {                 
                               xx=0.0;                 
                         }              
                         else              
                         {                 
                               xx=fpos.x-bwid;                 
                         }              
                   }           
                   else           
                   {              
                         if ( fpos.x>0.0 )              
                         {                 
                               xx=fpos.x+bwid;                 
                         }              
                         else if ( fpos.x==0.0 )              
                         {                 
                               xx=0.0;                 
                         }              
                         else              
                         {                 
                               xx=fpos.x-bwid;                 
                         }              
                   }           
                   if ( fpos.y>0.0 )           
                   {              
                         yy=fpos.y+fbxd.height/2.0;              
                   }           
                   else if ( fpos.y==0.0 )           
                   {              
                         yy=0.0;              
                   }           
                   else           
                   {              
                         yy=fpos.y-fbxd.height/2.0;              
                   }           
                   if ( fpos.z>0.0 )           
                   {              
                         zz=fpos.z+fbxd.depth/2.0;              
                   }           
                   else           
                   {              
                         zz=fpos.z-fbxd.depth/2.0;              
                   }           
                   sern=0;           
                   if ( m==4 )           
                   {              
                         sern=1;              
                   }           
                   if ( m!=7 )           
                   {              
                         _create = AgCreate("FBOX");              
                         {                 
                               AgShape myshape; // undefined shape                 
                               ///Create FBOX                 
                               Create("FBOX");                  
                         }              
                         {                 
                               AgPosition  place;                 
                               place.SetBlock("FBOX");                 
                               place.SetMother("CAVE");                 
                               /// Add daughter volume FBOX to mother CAVE                 
                               place.TranslateX(xx);                 
                               /// Translate x = xx                 
                               place.TranslateY(yy);                 
                               /// Translate y = yy                 
                               place.TranslateZ(zz);                 
                               /// Translate z = zz                 
                               place.par("only")=AgPosition::kMany;                 
                               /// Overlap: agposition::kmany                 
                               place.AlphaY(fpos.ay);                 
                               /// Rotate: AlphaY = fpos.ay                 
                               /// G3 Reference: thetax = 90                 
                               /// G3 Reference: phix = 0                 
                               /// G3 Reference: thetay = 90                 
                               /// G3 Reference: phiy = 90                 
                               /// G3 Reference: thetaz = 0                 
                               /// G3 Reference: phiz = 0                 
                               _stacker -> Position( AgBlock::Find("FBOX"), place );                 
                         } // end placement of FBOX              
                   }           
             }        
       }; // FPDMGEO3     
 }; // namespace FPDMGEO3  
 