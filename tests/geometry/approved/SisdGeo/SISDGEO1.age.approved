      ! ---------------------------------------------------------------------------------- SFRA
      BLOCK SFRA   is the hybrid stiffneer
      MATERIAL Carbon
      ATTRIBUTE SFRA seen=2 colo=1
      SHAPE box dx=3.76 dy=0.019 dz=1.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFRS
      BLOCK SFRS   two supports of the hybrid stiffneer (piece of it)
      MATERIAL Carbon
      ATTRIBUTE SFRS seen=2 colo=1
      SHAPE box dx=0.04 dy=0.0915 dz=1.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFFX
      BLOCK SFFX   is the flex
      MATERIAL Copper
      ATTRIBUTE SFFX seen=1 colo=42
      SHAPE box dx=3.84 dy=0.0007 dz=1.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFAA
      BLOCK SFAA   is the A128C chip
      MATERIAL Silicon
      ATTRIBUTE SFAA seen=1 colo=41
      SHAPE box dx=0.3 dy=0.015 dz=0.4
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFPI
      BLOCK SFPI   are the pions
      MATERIAL Aluminium
      ATTRIBUTE SFPI seen=2 colo=33
      SHAPE tube rmin=0.15/2 rmax=0.2/2 dz=0.35
      CREATE SFPJ
      CALL AgsReset 
      CALL agml_position_begin('SFPJ') 
      %title = 'SFPJ' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-0.35+0.0125) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFPJ
      BLOCK SFPJ   is the base of the pions
      MATERIAL Aluminium
      ATTRIBUTE SFPJ seen=2 colo=33
      SHAPE tube rmin=0.075+0.025 rmax=0.3 dz=0.0125
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFSD
      BLOCK SFSD   is the strip detector
      MATERIAL Silicon
      MATERIAL Sensitive isvol=1
      ATTRIBUTE SFSD seen=2 colo=41
      SHAPE box dx=3.75 dy=0.015 dz=2.1
      Call GSTPAR( %Imed,'STRA',1. )
      HITS SFSD x:0.001:s y:0.001: z:0.001: cx:10: cy:10: cz:10: step:0.01: sleng:16:(0,500),
            tof:16:(0,1.0E-6) ptot:16:(0,100.0) eloss:16:(0,0.001)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFSM
      BLOCK SFSM   is the mother volume of the ladder (mechanic structure)
      MATERIAL Air
      ATTRIBUTE SFSM seen=0 colo=6
      SHAPE box dx=SFPA_dmWid/2 dy=SFPA_smThk/2,
            dz=SFPA_smLen/2.
      yoffset= - 1.7
      CREATE SFLT
      hight = 2.6*tan(54*pi/180) - SFPB_Hhight/tan(pi/5) - 0.02
      CALL AgsReset 
      CALL agml_position_begin('SFLT') 
      %title = 'SFLT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(SFPB_Hhight-SFPB_Khight)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(hight+yoffset) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(-90-36) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('SFLT') 
      %title = 'SFLT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((SFPB_Hhight-SFPB_Khight)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(hight+yoffset) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      ag_alphaz = real(90.+36.) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE SFLU
      CALL AgsReset 
      CALL agml_position_begin('SFLU') 
      %title = 'SFLU' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(0.-(2.6-(0.2+0.01/tan(pi/5)))) 
      CALL agml_translate_x( %x ) 
      ag_y = real(0.+yoffset) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      essai=180
      essai=essai + 27 + 27
      CALL AgsReset 
      CALL agml_position_begin('SFLU') 
      %title = 'SFLU' 
      %exname = 'POSITION' ! agml placement 
      ag_x =  _
	real(-cos(63*pi/180)*2*(SFPB_Hbase-SFPB_Kbase)-(2.6-(0.2+0.01/tan(pi/5)))) 
      CALL agml_translate_x( %x ) 
      ag_y = real(cos(27*pi/180)*2*(SFPB_Hbase-SFPB_Kbase)+yoffset) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      ag_alphaz = real(essai) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('SFLU') 
      %title = 'SFLU' 
