      ! ---------------------------------------------------------------------------------- SFLM
      BLOCK SFLM   is the mother of the ladder
      MATERIAL Air
      ATTRIBUTE SFLM seen=0 colo=6
      SHAPE box dx=SFPA_dmWid/2 dy=(SFPA_dmThk+SFPA_gpThk+SFPA_smThk)/2,
            dz=SFPA_smLen/2
      CREATE SFDM
      CALL AgsReset 
      CALL agml_position_begin('SFDM') 
      %title = 'SFDM' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-(SFPA_smThk+SFPA_gpThk)/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE SFSM
      CALL AgsReset 
      CALL agml_position_begin('SFSM') 
      %title = 'SFSM' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real((SFPA_dmThk+SFPA_gpThk)/2) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFDM
      BLOCK SFDM   is the mother of the detectors
      MATERIAL Air
      ATTRIBUTE SFDM seen=0 colo=6
      SHAPE box dx=SFPA_dmWid/2 dy=SFPA_dmThk/2,
            dz=SFPA_wpLen/2
      wafpckLen=SFPA_wpLen/(SFPA_nssd*1.)
      DO iwaf = 1, SFPA_nssd
      CREATE SFSW
      CALL AgsReset 
      CALL agml_position_begin('SFSW') 
      %title = 'SFSW' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-(SFPA_wpLen+wafpckLen)/2+iwaf*wafpckLen) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- SFSW
      BLOCK SFSW   is a single wafer container
      MATERIAL Air
      ATTRIBUTE SFSW seen=0 colo=6
      SHAPE box dx=SFPA_dmWid/2 dy=1. dz=2.25
      CREATE SFSD
      CALL AgsReset 
      CALL agml_position_begin('SFSD') 
      %title = 'SFSD' 
      %exname = 'POSITION' ! agml placement 
