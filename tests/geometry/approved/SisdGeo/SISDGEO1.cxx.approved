                      {              
                            AgPosition  place;              
                            place.SetBlock("SFRA");              
                            place.SetMother("SFSW");              
                            /// Add daughter volume SFRA to mother SFSW              
                            place.TranslateX(0.);              
                            /// Translate x = 0.              
                            place.TranslateY(0.099);              
                            /// Translate y = 0.099              
                            place.TranslateZ(1.1);              
                            /// Translate z = 1.1              
                            _stacker -> Position( AgBlock::Find("SFRA"), place );              
