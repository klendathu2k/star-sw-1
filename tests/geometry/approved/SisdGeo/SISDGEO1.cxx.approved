       void SISDGEO1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup SISDGEO1_revision        
             ///@{           
                   /// Author: Lilian Martin           
             ///@}        
             ///@addtogroup SISDGEO1_revision        
             ///@{           
                   /// Created:  23 Apr 04            
             ///@}        
             AddBlock("SFMO", SFMO::Instance());        
             AddBlock("SFLM", SFLM::Instance());        
             AddBlock("SFDM", SFDM::Instance());        
             AddBlock("SFSW", SFSW::Instance());        
             AddBlock("SFSD", SFSD::Instance());        
             AddBlock("SFSM", SFSM::Instance());        
             AddBlock("SFLT", SFLT::Instance());        
             AddBlock("SFLU", SFLU::Instance());        
             AddBlock("SFFK", SFFK::Instance());        
             AddBlock("SFFL", SFFL::Instance());        
             AddBlock("SFKK", SFKK::Instance());        
             AddBlock("SFKL", SFKL::Instance());        
             AddBlock("SFRA", SFRA::Instance());        
             AddBlock("SFRS", SFRS::Instance());        
             AddBlock("SFFX", SFFX::Instance());        
             AddBlock("SFPI", SFPI::Instance());        
             AddBlock("SFPJ", SFPJ::Instance());        
             AddBlock("SFAA", SFAA::Instance());        
             AddBlock("SFAM", SFAM::Instance());        
             AddBlock("SFAB", SFAB::Instance());        
             AddBlock("SFAS", SFAS::Instance());        
             AddBlock("SAPP", SAPP::Instance());        
             AddBlock("SAPC", SAPC::Instance());        
             AddBlock("SAPS", SAPS::Instance());        
             AddBlock("SAPT", SAPT::Instance());        
             AddBlock("SFLA", SFLA::Instance());        
             AddBlock("SFLB", SFLB::Instance());        
             AddBlock("SFLC", SFLC::Instance());        
             AddBlock("SFES", SFES::Instance());        
             AddBlock("SFEB", SFEB::Instance());        
             AddBlock("SFCO", SFCO::Instance());        
             AddBlock("SFCM", SFCM::Instance());        
             AddBlock("SFCB", SFCB::Instance());        
             AddBlock("SFCS", SFCS::Instance());        
             AddBlock("SFKF", SFKF::Instance());        
             AddBlock("SFKS", SFKS::Instance());        
             AddBlock("SSBS", SSBS::Instance());        
             AddBlock("SSBB", SSBB::Instance());        
             AddBlock("SFPR", SFPR::Instance());        
             AddBlock("SFPB", SFPB::Instance());        
             AddBlock("SSST", SSST::Instance());        
             AddBlock("SSSS", SSSS::Instance());        
             AddBlock("SSRS", SSRS::Instance());        
             AddBlock("SSRT", SSRT::Instance());        
             AddBlock("SSLB", SSLB::Instance());        
             AddBlock("SSLT", SSLT::Instance());        
             AddBlock("SCMP", SCMP::Instance());        
             AddBlock("SCVM", SCVM::Instance());        
             AddBlock("SCVB", SCVB::Instance());        
             AddBlock("SCVS", SCVS::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssdp
++ssdp._index;
ssdp.version = 1;
// ssdp_docum.version = " Version ";
ssdp.config = 1;
// ssdp_docum.config = " There are a few configuraions possible ";
ssdp.placement = 0;
// ssdp_docum.placement = " 0=cave, 1=svtt ";
SSDP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfpb
++sfpb._index;
sfpb.hhight = (0.02/tan(54*pi/180)+0.02/(2*tan(pi/5))+0.2)*sin(pi/5);
// sfpb_docum.hhight = " haut 1 ";
sfpb.khight = 0.02/sin(54*pi/180);
// sfpb_docum.khight = " haut 2 ";
sfpb.hbase = (0.02/tan(63*pi/180)+0.01/tan(27*pi/180)+0.2)*sin(27*pi/180);
// sfpb_docum.hbase = " bas 1 ";
sfpb.kbase = 0.02/sin(63*pi/180);
// sfpb_docum.kbase = " bas 2 ";
sfpb.fsize = 0.6/cos(15*pi/180)+0.02*tan(15*pi/180);
// sfpb_docum.fsize = " lenght of the side kapton film ";
sfpb.zcoor = 5.18462095393834410;
// sfpb_docum.zcoor = " z coord ";
SFPB.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfpa
++sfpa._index;
sfpa.version = 1;
// sfpa_docum.version = " geometry version ";
