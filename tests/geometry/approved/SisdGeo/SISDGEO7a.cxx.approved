       AgBlock *SFMO::mInstance = 0;  
       AgBlock *SFMO::Instance(){     
                if ( mInstance==0 ) mInstance = new SFMO();     
                return mInstance;     
       }  
       void SFMO::Block( AgCreate create )  
       {      
             ///@addtogroup SFMO_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("SFMO");           
                         attr.par("seen")=1;           
                         attr.par("colo")=6;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Tube");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=sfpa.rmin;           
                         shape.par("rmax")=sfpa.rmax;           
                         shape.par("dz")=sfpa.len/2;           
                         /// Shape Tube rmin=sfpa.rmin rmax=sfpa.rmax dz=sfpa.len/2            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_SFMO;           
                         _stacker -> Build(this);           
                   }        
                   dthk=sfpa.smthk+sfpa.gpthk;        
                   if ( configb>=7 )        
                   {           
                         _create = AgCreate("SOSK");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create SOSK              
                               Create("SOSK");               
                         }           
                   }        
                   _create = AgCreate("SFLM");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFLM           
                         Create("SFLM");            
                   }        
                   /// Loop on ilad from 1 to 20 step=1        
                   for ( ilad=1; (1>0)? (ilad<=20):(ilad>=20); ilad+=1 )        
                   {           
                         if ( sfpa.laddermap[int(ilad)-1]>0 )           
                         {              
                               if ( ssdp.misalign==1 )              
                               {                 
                                     _create = AgCreate("SFSW");                 
                                     {                    
                                           AgShape myshape; // undefined shape                    
                                           ///Create SFSW                    
                                           Create("SFSW");                     
                                     }                 
                                     /// Loop on iwaf from 1 to sfpa.nssd step=1                 
                                     for ( iwaf=1; (1>0)? (iwaf<=sfpa.nssd):(iwaf>=sfpa.nssd); iwaf+=1 )                 
                                     {                    
                                           ncopy=(ilad-1)*sfpa.nssd+iwaf;                    
                                           {                       
                                                 AgPosition  place;                       
                                                 place.SetBlock("SFSW");                       
                                                 place.SetMother("SFMO");                       
                                                 /// Add daughter volume SFSW to mother SFMO                       
                                                 place.par("only")=AgPosition::kMany;                       
                                                 /// Overlap: agposition::kmany                       
                                                 place.par("ncopy")=ncopy;                       
                                                 /// Ncopy: ncopy                       
                                                 place.AlphaZ(180);                       
                                                 /// Rotate: AlphaZ = 180                       
                                                 /// G3 Reference: thetax = 90                       
                                                 /// G3 Reference: phix = 0                       
                                                 /// G3 Reference: thetay = 90                       
                                                 /// G3 Reference: phiy = 90                       
                                                 /// G3 Reference: thetaz = 0                       
                                                 /// G3 Reference: phiz = 0                       
                                                 place.Misalign("Geometry/sst/sstSensorOnLadder",ncopy-1,"left");                       
                                                 place.Misalign("Geometry/sst/sstLadderOnSst",ilad -1,"left");                       
                                                 _stacker -> Position( AgBlock::Find("SFSW"), place );                       
                                           } // end placement of SFSW                    
                                     }                 
                               }              
                               ang=(sfpa.ladderangle[int(ilad)-1]*pi)/180.0;              
                               {                 
                                     AgPosition  place;                 
                                     place.SetBlock("SFLM");                 
                                     place.SetMother("SFMO");                 
                                     /// Add daughter volume SFLM to mother SFMO                 
                                     place.TranslateX(0.0);                 
                                     /// Translate x = 0.0                 
                                     place.TranslateY(0.0);                 
                                     /// Translate y = 0.0                 
                                     place.TranslateZ(0.0);                 
                                     /// Translate z = 0.0                 
                                     place.par("only")=AgPosition::kMany;                 
                                     /// Overlap: agposition::kmany                 
                                     place.AlphaZ(sfpa.ladderangle[int(ilad)-1]-90);                 
                                     /// Rotate: AlphaZ = sfpa.ladderangle[int(ilad)-1]-90                 
                                     /// G3 Reference: thetax = 90                 
                                     /// G3 Reference: phix = 0                 
                                     /// G3 Reference: thetay = 90                 
                                     /// G3 Reference: phiy = 90                 
                                     /// G3 Reference: thetaz = 0                 
                                     /// G3 Reference: phiz = 0                 
                                     place.Misalign("Geometry/sst/sstLadderOnSstMisalign",ilad-1,"right");                 
                                     _stacker -> Position( AgBlock::Find("SFLM"), place );                 
                               } // end placement of SFLM              
                         }           
                   }        
                   _create = AgCreate("SSST");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSST           
                         Create("SSST");            
                   }        
                   _create = AgCreate("SSSS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSSS           
                         Create("SSSS");            
                   }        
                   _create = AgCreate("SSRT");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSRT           
                         Create("SSRT");            
                   }        
                   _create = AgCreate("SSRS");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSRS           
                         Create("SSRS");            
                   }        
                   _create = AgCreate("SSLB");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSLB           
                         Create("SSLB");            
                   }        
                   _create = AgCreate("SSLT");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SSLT           
                         Create("SSLT");            
                   }        
                   _create = AgCreate("SCMP");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SCMP           
                         Create("SCMP");            
                   }        
                   _create = AgCreate("SCVM");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SCVM           
                         Create("SCVM");            
                   }        
                   END_OF_SFMO:        
                   mCurrent = _save;        
             ///@}     
       } // End Block SFMO  
       // ---------------------------------------------------------------------------------------------------  
       AgBlock *SFLM::mInstance = 0;  
       AgBlock *SFLM::Instance(){     
                if ( mInstance==0 ) mInstance = new SFLM();     
                return mInstance;     
       }  
       void SFLM::Block( AgCreate create )  
       {      
             ///@addtogroup SFLM_doc     
             ///@{        
                     AgBlock *_save = mCurrent;        
                     mCurrent = this;        
                     Bool_t _same_shape = true;        
                   /// Material Air         
                   {  AgMaterial mat = AgMaterial::CopyMaterial("Air");           
                         _material = mat;           
                   }        
                   { AgAttribute attr = AgAttribute("SFLM");           
                         attr.par("seen")=1;           
                         attr.par("colo")=7;           
                         attr.Inherit( AgBlock::previous() );            
                         _attribute = attr;           
                   }        
                   {  AgShape shape = AgShape("Tubs");           
                         shape     .Inherit( AgBlock::previous() );           
                         create     .SetParameters(shape);           
                         shape.par("rmin")=21.6;           
                         shape.par("rmax")=sfpa.rmax-0.2;           
                         shape.par("phi1")=-11+90;           
                         shape.par("phi2")=11+90;           
                         shape.par("dz")=sfpa.smlen/2;           
                         /// Shape Tubs rmin=21.6 rmax=sfpa.rmax-0.2 phi1=-11+90 phi2=11+90 dz=sfpa.smlen/2            
                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_SFLM;           
                         _stacker -> Build(this);           
                   }        
                   doff=dthk/2.0-(sfpa.smthk+sfpa.gpthk)/2;        
                   radtilt=-(sfpa.laddertilt[int(1)-1]*pi)/180.0;        
                   xc=doff*sin(radtilt);        
                   yc=sfpa.ladderradius[int(1)-1]+doff*cos(radtilt);        
                   tilt=sfpa.laddertilt[int(1)-1];        
                   wafpcklen=sfpa.wplen/(sfpa.nssd*1.);        
                   x=0;        
                   y=0;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   if ( ssdp.misalign==0 )        
                   {           
                         _create = AgCreate("SFSW");           
                         {              
                               AgShape myshape; // undefined shape              
                               ///Create SFSW              
                               Create("SFSW");               
                         }           
                         /// Loop on iwaf from 1 to sfpa.nssd step=1           
                         for ( iwaf=1; (1>0)? (iwaf<=sfpa.nssd):(iwaf>=sfpa.nssd); iwaf+=1 )           
                         {              
                               {                 
                                     AgPosition  place;                 
                                     place.SetBlock("SFSW");                 
                                     place.SetMother("SFLM");                 
                                     /// Add daughter volume SFSW to mother SFLM                 
                                     place.TranslateX(xpos);                 
                                     /// Translate x = xpos                 
                                     place.TranslateY(ypos);                 
                                     /// Translate y = ypos                 
                                     place.TranslateZ(-(sfpa.wplen+wafpcklen)/2+iwaf*wafpcklen);                 
                                     /// Translate z = -(sfpa.wplen+wafpcklen)/2+iwaf*wafpcklen                 
                                     place.par("only")=AgPosition::kMany;                 
                                     /// Overlap: agposition::kmany                 
                                     place.AlphaZ(tilt);                 
                                     /// Rotate: AlphaZ = tilt                 
                                     /// G3 Reference: thetax = 90                 
                                     /// G3 Reference: phix = 0                 
                                     /// G3 Reference: thetay = 90                 
                                     /// G3 Reference: phiy = 90                 
                                     /// G3 Reference: thetaz = 0                 
                                     /// G3 Reference: phiz = 0                 
                                     _stacker -> Position( AgBlock::Find("SFSW"), place );                 
                               } // end placement of SFSW              
                         }           
                   }        
                   doff=dthk/2.0+(sfpa.dmthk+sfpa.gpthk)/2;        
                   xc=doff*sin(radtilt);        
                   yc=sfpa.ladderradius[int(1)-1]+doff*cos(radtilt);        
                   yoffset=-1.7;        
                   _create = AgCreate("SFLT");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFLT           
                         Create("SFLT");            
                   }        
                   hight=sfjp.sfsm_ll*tan(54*pi/180)-sfpb.hhight/tan(pi/5)-0.02;        
                   x=-(sfpb.hhight-sfpb.khight);        
                   y=hight+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLT");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLT to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.0);           
                         /// Translate z = 0.0           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(-90-36+tilt);           
                         /// Rotate: AlphaZ = -90-36+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLT"), place );           
                   } // end placement of SFLT        
                   x=+(sfpb.hhight-sfpb.khight);        
                   y=hight+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLT");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLT to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0);           
                         /// Translate z = 0           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaY(180.);           
                         /// Rotate: AlphaY = 180.           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         place.AlphaZ(90.+36.+tilt);           
                         /// Rotate: AlphaZ = 90.+36.+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLT"), place );           
                   } // end placement of SFLT        
                   x=0.-(sfjp.sfsm_ll-(sfjp.sflu_bl1+sfjp.sflu_h1/2*1/tan(pi/5)));        
                   y=yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   _create = AgCreate("SFLU");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFLU           
                         Create("SFLU");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLU");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLU to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(tilt);           
                         /// Rotate: AlphaZ = tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLU"), place );           
                   } // end placement of SFLU        
                   essai=180;        
                   essai=essai+27+27;        
                   y=cos(27*pi/180)*2*(sfpb.hbase-sfpb.kbase)+yoffset;        
                   x=-cos(63*pi/180)*2*(sfpb.hbase-sfpb.kbase)-(sfjp.sfsm_ll-(0.2+0.01/tan(pi/5)));        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLU");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLU to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaY(180);           
                         /// Rotate: AlphaY = 180           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         place.AlphaZ(essai+tilt);           
                         /// Rotate: AlphaZ = essai+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLU"), place );           
                   } // end placement of SFLU        
                   x=0.+(sfjp.sfsm_ll-(0.2+0.01/tan(pi/5)));        
                   y=0.+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLU");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLU to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaY(180.);           
                         /// Rotate: AlphaY = 180.           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         place.AlphaZ(tilt);           
                         /// Rotate: AlphaZ = tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLU"), place );           
                   } // end placement of SFLU        
                   x=cos(63*pi/180)*2*(sfpb.hbase-sfpb.kbase)+(sfjp.sfsm_ll-(0.2+0.01/tan(pi/5)));        
                   y=cos(27*pi/180)*2*(sfpb.hbase-sfpb.kbase)+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFLU");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFLU to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(-essai+tilt);           
                         /// Rotate: AlphaZ = -essai+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFLU"), place );           
                   } // end placement of SFLU        
                   x=sfjp.sffk_px/2+sfjp.sffk_dxe;        
                   y=-sfjp.sffk_py1-sfjp.sffk_py2-sfjp.sffk_dy+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   _create = AgCreate("SFFK");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFFK           
                         Create("SFFK");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFFK");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFFK to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(tilt);           
                         /// Rotate: AlphaZ = tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFFK"), place );           
                   } // end placement of SFFK        
                   x=-(sfjp.sffk_px/2+sfjp.sffk_dxe);        
                   y=-sfjp.sffk_py1-sfjp.sffk_py2-sfjp.sffk_dy+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFFK");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFFK to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(tilt);           
                         /// Rotate: AlphaZ = tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFFK"), place );           
                   } // end placement of SFFK        
                   x=-sfjp.sfkl_px-sfpb.fsize*cos(15*pi/180);        
                   y=-sfjp.sffk_py1-sfjp.sffk_py2-sfjp.sffk_dy-sfpb.fsize*cos(75*pi/180)+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   _create = AgCreate("SFFL");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFFL           
                         Create("SFFL");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFFL");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFFL to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(15+tilt);           
                         /// Rotate: AlphaZ = 15+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFFL"), place );           
                   } // end placement of SFFL        
                   x=sfjp.sfkl_px+sfpb.fsize*cos(15*pi/180);        
                   y=-sfjp.sffk_py1-sfjp.sffk_py2-sfjp.sffk_dy-sfpb.fsize*cos(75*pi/180)+yoffset;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFFL");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFFL to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(-15+tilt);           
                         /// Rotate: AlphaZ = -15+tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
                         /// G3 Reference: thetay = 90           
                         /// G3 Reference: phiy = 90           
                         /// G3 Reference: thetaz = 0           
                         /// G3 Reference: phiz = 0           
                         _stacker -> Position( AgBlock::Find("SFFL"), place );           
                   } // end placement of SFFL        
                   x=0.0;        
                   y=-sfjp.sffk_py1-sfjp.sffk_py2-sfjp.sffk_py2+yoffset-sfjp.sfkk_dy/2.;        
                   sisdgeo7a_trans_to_sfm( x,y,xc,yc,tilt,xpos,ypos );// CALL sisdgeo7a_trans_to_sfm        
                   _create = AgCreate("SFKK");        
                   {           
                         AgShape myshape; // undefined shape           
                         ///Create SFKK           
                         Create("SFKK");            
                   }        
                   {           
                         AgPosition  place;           
                         place.SetBlock("SFKK");           
                         place.SetMother("SFLM");           
                         /// Add daughter volume SFKK to mother SFLM           
                         place.TranslateX(xpos);           
                         /// Translate x = xpos           
                         place.TranslateY(ypos);           
                         /// Translate y = ypos           
                         place.TranslateZ(0.);           
                         /// Translate z = 0.           
                         place.par("only")=AgPosition::kOnly;           
                         /// Overlap: agposition::konly           
                         place.AlphaZ(tilt);           
                         /// Rotate: AlphaZ = tilt           
                         /// G3 Reference: thetax = 90           
                         /// G3 Reference: phix = 0           
