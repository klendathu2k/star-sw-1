                         _same_shape &= _stacker->SearchVolume( shape, _attribute );           
                         _shape = shape;           
                         if (_same_shape) goto END_OF_SSST;           
                         _stacker -> Build(this);           
                   }        
                   END_OF_SSST:        
                   mCurrent = _save;        
             ///@}     
       } // End Block SSST  
