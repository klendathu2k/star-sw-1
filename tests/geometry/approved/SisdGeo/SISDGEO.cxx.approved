       void SISDGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup SISDGEO_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             ///@addtogroup SISDGEO_revision        
             ///@{           
                   /// Created:  17 Nov 03            
             ///@}        
             AddBlock("SFMO", SFMO::Instance());        
             AddBlock("SFLM", SFLM::Instance());        
             AddBlock("SFDM", SFDM::Instance());        
             AddBlock("SFSW", SFSW::Instance());        
             AddBlock("SFSD", SFSD::Instance());        
             AddBlock("SFSM", SFSM::Instance());        
             AddBlock("SFSS", SFSS::Instance());        
             AddBlock("SFCP", SFCP::Instance());        
             AddBlock("SFCW", SFCW::Instance());        
             AddBlock("SFCF", SFCF::Instance());        
             AddBlock("SFCT", SFCT::Instance());        
             AddBlock("SFCX", SFCX::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssdp
++ssdp._index;
ssdp.version = 1;
// ssdp_docum.version = " Version ";
ssdp.config = 1;
// ssdp_docum.config = " There are a few configuraions possible ";
ssdp.placement = 0;
// ssdp_docum.placement = " 0=cave, 1=svtt ";
SSDP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfpa
++sfpa._index;
sfpa.version = 1;
// sfpa_docum.version = " geometry version ";
sfpa.rmin = 21.8;
// sfpa_docum.rmin = " mother rmin ";
sfpa.rmax = 29.5;
// sfpa_docum.rmax = " mother rmax ";
sfpa.len = 100.;
// sfpa_docum.len = " mother Len ";
sfpa.rad = 23.;
// sfpa_docum.rad = " distance from beam axis to detector center ";
sfpa.nssd = 16;
// sfpa_docum.nssd = " number of silicon strip detectors  ";
sfpa.dmwid = 7.5;
// sfpa_docum.dmwid = " detector mother width  ";
sfpa.dmthk = 0.03;
// sfpa_docum.dmthk = " detector mother thickness ";
sfpa.dmlen = 90.;
// sfpa_docum.dmlen = " detector mother length (detectors + adc board)  ";
sfpa.smwid = 7.5;
// sfpa_docum.smwid = " structure mother width ";
sfpa.smthk = 3.5;
// sfpa_docum.smthk = " structure mother thickness ";
sfpa.smlen = 95.;
// sfpa_docum.smlen = " structure mother length (cool. pipe+carbon fiber) ";
sfpa.sslen = 95./20.;
