          ///@addtogroup SISDGEO_vars     
          ///@{        
                Int_t ilad,iwaf,nc;        
                //        
                /// Int_t ilad,iwaf,nc        
          ///@}     
          ///@addtogroup SISDGEO_vars     
          ///@{        
                Float_t wafpcklen,dthk,radtilt,ang;        
                //        
                /// Float_t wafpcklen,dthk,radtilt,ang        
