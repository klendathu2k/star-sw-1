sfpa.wplen = 68.8;
// sfpa_docum.wplen = " length of wafer pack ";
sfpa.sdlen = 4.2;
// sfpa_docum.sdlen = " lenght of one strip detector (along beam axis) ";
sfpa.tilt = 5.0;
// sfpa_docum.tilt = " tiling angle (degrees) ";
sfpa.cprad = 0.1;
// sfpa_docum.cprad = " cooling pipe outer radius ";
sfpa.cpral = 0.09;
// sfpa_docum.cpral = " cooling pipe inner radius ";
sfpa.cfrad = 0.1;
// sfpa_docum.cfrad = " carbon fiber tube radius (support structure) ";
sfpa.gpthk = 0.5;
// sfpa_docum.gpthk = " gap between structure mother and detector ";
{
