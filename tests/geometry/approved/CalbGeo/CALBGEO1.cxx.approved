                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Material Alu_CBTW isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Alu_cbtw");              
