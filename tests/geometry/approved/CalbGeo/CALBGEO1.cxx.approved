          AgBlock *CSME::mInstance = 0;     
          AgBlock *CSME::Instance(){        
                   if ( mInstance==0 ) mInstance = new CSME();        
                   return mInstance;        
          }     
          void CSME::Block( AgCreate create )     
          {         
                ///@addtogroup CSME_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Material Alu_CSME isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Alu_csme");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("CSME");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Division");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("ndiv")=nint(calg.nsmdalw);              
                            shape.par("iaxis")=2;              
                            /// Shape Division ndiv=nint(calg.nsmdalw) iaxis=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CSME;              
                            _stacker -> Build(this);              
                      }           
                      CALBPAR( ag_imed,"sensitive" );// CALL CALBPAR           
                      /// Loop on i from 1 to 2 step=1           
                      for ( i=1; (1>0)? (i<=2):(i>=2); i+=1 )           
                      {              
                            _create = AgCreate("CSHI");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create CSHI                 
                                  Create("CSHI");                  
                            }              
                            if ( i==1 )              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("CSHI");                    
                                        place.SetMother("CSME");                    
                                        /// Add daughter volume CSHI to mother CSME                    
                                        place.TranslateX(-calg.smalfthk+calg.smgasthk);                    
                                        /// Translate x = -calg.smalfthk+calg.smgasthk                    
                                        _stacker -> Position( AgBlock::Find("CSHI"), place );                    
                                  } // end placement of CSHI                 
                            }              
                            else              
                            {                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("CSHI");                    
                                        place.SetMother("CSME");                    
                                        /// Add daughter volume CSHI to mother CSME                    
                                        place.TranslateX(2.*calg.smgasthk-calg.smalfthk);                    
                                        /// Translate x = 2.*calg.smgasthk-calg.smalfthk                    
                                        _stacker -> Position( AgBlock::Find("CSHI"), place );                    
                                  } // end placement of CSHI                 
                            }              
                      }           
                      END_OF_CSME:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CSME     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *CSHI::mInstance = 0;     
          AgBlock *CSHI::Instance(){        
                   if ( mInstance==0 ) mInstance = new CSHI();        
                   return mInstance;        
          }     
          void CSHI::Block( AgCreate create )     
          {         
                ///@addtogroup CSHI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component Ar	a=39.95	z=18.	w=0.9           
                      /// Component C	a=12.01	z=6.	w=0.1*1*12.01/44.01           
                      /// Component O	a=16.	z=8.	w=0.1*2*16./44.01           
                      /// Mixture sens_gas isvol=1 dens=0.0018015           
                      {  AgMaterial &mix = AgMaterial::Get("Sens_gas");              
                            mix.Component("Ar",39.95,18.,0.9);              
                            mix.Component("C",12.01,6.,0.1*1*12.01/44.01);              
                            mix.Component("O",16.,8.,0.1*2*16./44.01);              
                            mix.par("isvol")=1;              
                            mix.par("dens")=0.0018015;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("CSHI");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      if ( i==1 )           
                      {              
                            {  AgShape shape = AgShape("Bbox");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dx")=calg.smgasthk;                 
                                  shape.par("dy")=calg.smgaswdh;                 
                                  /// Shape Bbox dx=calg.smgasthk dy=calg.smgaswdh                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_CSHI;                 
                                  _stacker -> Build(this);                 
                            }              
                      }           
                      else           
                      {              
                            {  AgShape shape = AgShape("Tubs");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("rmin")=0;                 
                                  shape.par("rmax")=calg.smgasrad;                 
                                  shape.par("phi1")=270;                 
                                  shape.par("phi2")=450;                 
                                  /// Shape Tubs rmin=0 rmax=calg.smgasrad phi1=270 phi2=450                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_CSHI;                 
                                  _stacker -> Build(this);                 
                            }              
                      }           
                      CALBPAR( ag_imed,"sensitive" );// CALL CALBPAR           
                      // parameter stra = 1.0 (deferred)           
                      h_eta1=2.*(calg.seta1wdh+calg.set12wdh);           
                      sh_eta1=calg.netfirst*h_eta1;           
                      h_eta2=2.*(calg.seta2wdh+calg.set12wdh);           
                      sh_eta2=calg.netsecon*h_eta2;           
                      h_phi1=2.*(calg.sphiwdh+calg.sphidwdh);           
                      h_phi2=h_phi1;           
                      sh_phi1=calg.nphistr*h_phi1;           
                      sh_phi2=sh_phi1;           
                      // deferred module()->AddHit( "CSDA", "type=1", 2, 0, 0, "");           
                      // deferred module()->AddHit( "CSDA", "eta", 0.1, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "etsp", h_eta1, 0, sh_eta1, "");           
                      // deferred module()->AddHit( "CSDA", "eloss", 0, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "type=2", 2, 0, 0, "");           
                      // deferred module()->AddHit( "CSDA", "eta", 0.1, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "etsp", h_eta2, 0, sh_eta2, "");           
                      // deferred module()->AddHit( "CSDA", "eloss", 0, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "type=3", 2, 0, 0, "");           
                      // deferred module()->AddHit( "CSDA", "eta", 0.1, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "etsp", h_phi1, 0, sh_phi1, "");           
                      // deferred module()->AddHit( "CSDA", "eloss", 0, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "type=4", 2, 0, 0, "");           
                      // deferred module()->AddHit( "CSDA", "eta", 0.1, 0, 1, "");           
                      // deferred module()->AddHit( "CSDA", "etsp", h_phi2, 0, sh_phi2, "");           
                      // deferred module()->AddHit( "CSDA", "eloss", 0, 0, 1, "");           
                      END_OF_CSHI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CSHI     
    // ----------------------------------------------------------------------- geoctr
       void CALBGEO1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup CALBGEO1_revision        
             ///@{           
                   /// Author: Maxim Potekhin BNL           
             ///@}        
             ///@addtogroup CALBGEO1_revision        
             ///@{           
                   /// Created:    January 20, 2004            
             ///@}        
             AddBlock("CALB", CALB::Instance());        
             AddBlock("CHLV", CHLV::Instance());        
             AddBlock("CPHI", CPHI::Instance());        
             AddBlock("CSUP", CSUP::Instance());        
             AddBlock("CPBP", CPBP::Instance());        
             AddBlock("CSCI", CSCI::Instance());        
             AddBlock("CSMD", CSMD::Instance());        
             AddBlock("CSMG", CSMG::Instance());        
             AddBlock("CSDA", CSDA::Instance());        
             AddBlock("CSMC", CSMC::Instance());        
             AddBlock("CSMB", CSMB::Instance());        
             AddBlock("CSME", CSME::Instance());        
             AddBlock("CSHI", CSHI::Instance());        
             AddBlock("CBTW", CBTW::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill calg
++calg._index;
calg.version = 3.0;
// calg_docum.version = " geometry version ";
calg.rmin = 223.5;
// calg_docum.rmin = " inner radius  ";
calg.etacut = 1.0;
// calg_docum.etacut = " calorimeter rapidity cut ";
calg.crackwd = 0.655;
// calg_docum.crackwd = " half width of the crack between modules ";
calg.frontthk = 0.9525;
// calg_docum.frontthk = " front plate half thickness  ";
calg.compthk = 0.9525;
// calg_docum.compthk = " back plate half thickness ";
calg.airthk = 0.158;
// calg_docum.airthk = " Air gap half thicness ";
calg.backthk = 1.5875;
// calg_docum.backthk = " Module back plate half thicknes ";
calg.spacethk = 0.9525;
// calg_docum.spacethk = " Spacer back plate half thicknes ";
{
calg_info::scintthk::Type temp = {
calg_info::scintthk::BaseType(0.3),
calg_info::scintthk::BaseType(0.25)
}
;
memcpy(&calg.scintthk, &temp, sizeof(temp));;
}
// calg_docum.scintthk = " active scintillator plate half thickness ";
calg.absorthk = 0.250;
// calg_docum.absorthk = " absorber plate thickness halfpThickness ";
calg.abpapthk = 0.005;
// calg_docum.abpapthk = " absorber paper plate thickness half thickness ";
calg.g10sbthk = 0.115;
// calg_docum.g10sbthk = " G10 SMD front and back plate half thickness ";
calg.smalfwdh = 11.2014;
// calg_docum.smalfwdh = " SMD Al front back plate with Ar half width ";
calg.smalfthk = 0.3893;
// calg_docum.smalfthk = " SMD Al front back plate with Ar half thickness ";
calg.smgasthk = 0.1359;
// calg_docum.smgasthk = " SMD gas BOX volume half thickness ";
calg.smgaswdh = 0.2946;
// calg_docum.smgaswdh = " SMD gas BOX volume half width ";
calg.smgasrad = 0.2946;
// calg_docum.smgasrad = " SMD gas volume TUBS radius ";
calg.smaffwdh = 0.113;
// calg_docum.smaffwdh = " SMD Al front first (last) rib half width  ";
calg.smafbwdh = 0.1664;
// calg_docum.smafbwdh = " SMD Al back first (last) rib half width ";
calg.smetawdh = 0.9806;
// calg_docum.smetawdh = " Eta=0 strip notch half width ";
calg.seta1wdh = 0.7277;
// calg_docum.seta1wdh = " strip#1-75 half witdh ";
calg.seta2wdh = 0.9398;
// calg_docum.seta2wdh = " strip#76-150 half witdh ";
calg.set12wdh = 0.04064;
// calg_docum.set12wdh = " half distance between strips in eta ";
calg.sphiwdh = 0.6680;
// calg_docum.sphiwdh = " strip#(1-NPhistr) in phi direction half witdh ";
calg.sphidwdh = 0.07874;
// calg_docum.sphidwdh = " half distance between strips in phi ";
calg.nsmdalw = 30;
// calg_docum.nsmdalw = " Number SMD gaseus interval in tile ";
calg.nsuper = 2;
// calg_docum.nsuper = " number of readout superlayer ";
calg.nsmd = 5;
// calg_docum.nsmd = " SMD positioned after sandvich type layers EMC ";
{
calg_info::nsublay::Type temp = {
calg_info::nsublay::BaseType(2),
calg_info::nsublay::BaseType(19)
}
;
memcpy(&calg.nsublay, &temp, sizeof(temp));;
}
// calg_docum.nsublay = " number of layers in a superlayer ";
calg.maxmodule = 60;
// calg_docum.maxmodule = " max number of moudle ";
calg.netat = 20;
// calg_docum.netat = " Number of eta division for tower/preshower ";
calg.nsub = 2;
// calg_docum.nsub = " Number of sub div. in phi for tower/preshower ";
calg.netasmdp = 10;
// calg_docum.netasmdp = " Number of eta division in for SMD phi plane ";
calg.nphistr = 15;
// calg_docum.nphistr = " Number of the strip in phi direction ";
calg.netfirst = 75.;
// calg_docum.netfirst = " Number of strip in first part eta=0-0.5 ";
calg.netsecon = 75.;
// calg_docum.netsecon = " Number of strip in second part eta=0.5-1.0 ";
{
calg_info::nmodule::Type temp = {
calg_info::nmodule::BaseType(60),
calg_info::nmodule::BaseType(60)
}
;
memcpy(&calg.nmodule, &temp, sizeof(temp));;
}
// calg_docum.nmodule = " number of modules ";
{
calg_info::shift::Type temp = {
calg_info::shift::BaseType(75),
calg_info::shift::BaseType(105)
}
;
memcpy(&calg.shift, &temp, sizeof(temp));;
}
// calg_docum.shift = " starting azimuth of the first module    ";
{
calg_info::modmap::Type temp = {
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(0),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1),
calg_info::modmap::BaseType(1)
}
;
memcpy(&calg.modmap, &temp, sizeof(temp));;
}
// calg_docum.modmap = " Populated modules map ";
CALG.fill();
        
             /// USE calg _index=1;        
             CALG.use( __calg__index__ = 1 );
        
             smd_width=2.*calg.g10sbthk+2.*calg.smalfthk+2.*calg.abpapthk;        
             smd_width1=2.*calg.g10sbthk+2.*calg.abpapthk;        
             smd_width2=smd_width1+calg.smgasthk+calg.smgasrad;        
             smd_width3=2.*smd_width-smd_width1-calg.smgasthk-calg.smgasrad;        
             r1=calg.rmin+2.*calg.frontthk;        
             r2=0.0;        
             /// Loop on i from 1 to nint(calg.nsuper) step=1        
             for ( i=1; (1>0)? (i<=nint(calg.nsuper)):(i>=nint(calg.nsuper)); i+=1 )        
             {           
                   layer_width(i)=calg.scintthk[int(i)-1]+calg.absorthk+2.*calg.abpapthk;           
                   r2+=(calg.nsublay[int(i)-1]-i+1)*layer_width(i)*2.0;           
                   rr(i)=r2;           
             }        
             r3=(calg.nsuper*layer_width(1)+(calg.nsmd-calg.nsuper)*layer_width(2))*2.;        
             r4=(smd_width+calg.scintthk[int(2)-1]+2.*calg.abpapthk)*2.0;        
             cut_radius=r1+r2+r4;        
             rmax=cut_radius+2.*(calg.backthk+calg.spacethk+calg.compthk+calg.airthk);        
             tan_theta=tan(2*atan(exp(-calg.etacut)));        
             cut_length=calg.rmin/tan_theta;        
             hleng=cut_radius/tan_theta;        
             nn=max(calg.nmodule[int(1)-1],calg.nmodule[int(2)-1]);        
             deta=1.0/calg.netat;        
             dphimod=360/calg.maxmodule;        
             dphit=dphimod/calg.nsub;        
             dphitot=dphimod*nn;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill calr
++calr._index;
calr.rmin = r1;
// calr_docum.rmin = " inner raduis of sensitive area ";
calr.rprs = r1+rr(1)/2.0;
// calr_docum.rprs = " mean raduis of PRS ";
calr.rsmd1 = r1+r3+smd_width2;
// calr_docum.rsmd1 = " mean raduis of SMD ";
calr.rsmd2 = r1+r3+smd_width3;
// calr_docum.rsmd2 = " mean raduis of SMD ";
calr.rmax = cut_radius;
// calr_docum.rmax = " outer raduis of sensitive area ";
CALR.fill();
        
             /// USE calr _index=1;        
             CALR.use( __calr__index__ = 1 );
        
             _create = AgCreate("CALB");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create CALB           
                   Create("CALB");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("CALB");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume CALB to mother CAVE           
                   _stacker -> Position( AgBlock::Find("CALB"), place );           
             } // end placement of CALB        
             // Print<level=%i> fmt=%s fortran format statements not supported        
       }; // CALBGEO1     
 }; // namespace CALBGEO1  
 