                            shape.Rmax(0)=rmax2;              
                            shape.Rmax(1)=rmax2;              
                            shape.Rmax(2)=rmax2;              
                            /// Shape Pcon phi1=+2.94 dphi=0.0045 nz=3               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_CSPB;              
                            _stacker -> Build(this);              
                      }           
                      CALBPAR( ag_imed,"absorber" );// CALL CALBPAR           
                      END_OF_CSPB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block CSPB     
