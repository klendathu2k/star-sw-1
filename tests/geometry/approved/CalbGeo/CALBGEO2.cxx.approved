             /// USE calg _index=1;        
             CALG.use( __calg__index__ = 1 );
        
             /// USE ccut version=1;        
             CCUT.use( __ccut_version__ = 1 );
        
             /// USE cabs version=ccut.absorber;        
             CABS.use( __cabs_version__ = ccut.absorber );
        
             /// USE csen version=ccut.sensitive;        
             CSEN.use( __csen_version__ = ccut.sensitive );
        
             zz0=0.477;//thicknessofssplateeta=0;        
             zz1=0.692;//thicknessoftotalgapeta=0;        
             zz2=0.79375;//thicknessofssplateeta=1;        
             calg.etacut=0.9835;//needstobesetelsewhereinprogram;        
             smd_width=2.*calg.g10sbthk+2.*calg.smalfthk+2.*calg.abpapthk;        
             smd_width1=2.*calg.g10sbthk+2.*calg.abpapthk;        
             smd_width2=smd_width1+calg.smgasthk+calg.smgasrad;        
             smd_width3=2.*smd_width-smd_width1-calg.smgasthk-calg.smgasrad;        
             r1=calg.rmin+2.*calg.frontthk;        
             r2=0.0;        
             /// Loop on i from 1 to nint(calg.nsuper) step=1        
             for ( i=1; (1>0)? (i<=nint(calg.nsuper)):(i>=nint(calg.nsuper)); i+=1 )        
             {           
                   layer_width(i)=calg.scintthk[int(i)-1]+calg.absorthk+2.*calg.abpapthk;           
                   r2+=(calg.nsublay[int(i)-1]-i+1)*layer_width(i)*2.0;           
                   rr(i)=r2;           
             }        
             r3=(calg.nsuper*layer_width(1)+(calg.nsmd-calg.nsuper)*layer_width(2))*2.;        
             r4=(smd_width+calg.scintthk[int(2)-1]+2.*calg.abpapthk)*2.0;        
             cut_radius=r1+r2+r4;        
             rmax=cut_radius+2.*(calg.backthk+calg.spacethk+calg.compthk+calg.airthk);        
             angle=2*atan(exp(-calg.etacut))*180./3.14159;        
             tan_theta=tan(2*atan(exp(-calg.etacut)));        
             sin_theta=sin(2*atan(exp(-calg.etacut)));        
             cut_length=calg.rmin/tan_theta;        
             hleng=cut_radius/tan_theta;        
             cut_length2=cut_length+zz2/sin_theta;        
             hleng2=hleng+zz2/sin_theta;        
             nn=max(calg.nmodule[int(1)-1],calg.nmodule[int(2)-1]);        
             deta=1.0/calg.netat;        
             dphimod=360/calg.maxmodule;        
             dphit=dphimod/calg.nsub;        
             dphitot=dphimod*nn;        
             skinthk=0.040;//thicknessofaluminumcover;        
             skinthk=(skinthk/rmax)*180./3.14159;//converttodphi;        
             skinoffset=(0.250/rmax)*180./3.14159;//converttodphi;        
             skinoffset1=-3+skinoffset;        
             skinoffset2=+3-skinoffset;        
             rmax2=cut_radius+2.*0.9525+0.291;        
             rmin2=calg.rmin+0.291;        
             cut_radius2=cut_radius+0.291;        
             strap_spacing=17.06;//15placesalongmodulez0=6.5295;        
             slug_dx=0.9525/2;//halfwidthofslug;        
             slug_dy=3.1750/2;//halfwidthofslug;        
             slug_dz=3.1750/2;//halfwidthofslug;        
             strap_dx=(rmax2-rmin2)/2;//halfwidthofstrap;        
             strap_dy=0.2/2;//halfwidthofstrap;        
             strap_dz=3.175/2;//halfwidthofstrap;        
             strap_r=(rmin2+rmax2)/2-0.291;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill calr
++calr._index;
calr.rmin = r1;
// calr_docum.rmin = " inner raduis of sensitive area ";
calr.rprs = r1+rr(1)/2.0;
// calr_docum.rprs = " mean raduis of PRS ";
calr.rsmd1 = r1+r3+smd_width2;
// calr_docum.rsmd1 = " mean raduis of SMD ";
calr.rsmd2 = r1+r3+smd_width3;
// calr_docum.rsmd2 = " mean raduis of SMD ";
calr.rmax = cut_radius;
// calr_docum.rmax = " outer raduis of sensitive area ";
CALR.fill();
        
             rmax3=rmax/cos(3.14159*dphimod/360);        
             /// USE calr _index=1;        
             CALR.use( __calr__index__ = 1 );
        
             cutang=atan2(cut_radius-calg.rmin,hleng2-cut_length2);        
             _create = AgCreate("CALB");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create CALB           
                   Create("CALB");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("CALB");           
                   place.SetMother("CAVE");           
                   place.SetGroup("MagRefSys");           
                   /// Add daughter volume CALB to mother CAVE           
                   _stacker -> Position( AgBlock::Find("CALB"), place );           
             } // end placement of CALB        
             // Print<level=%i> fmt=%s fortran format statements not supported        
       }; // CALBGEO2     
 }; // namespace CALBGEO2  
 