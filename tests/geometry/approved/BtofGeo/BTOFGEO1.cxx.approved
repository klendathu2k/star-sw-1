          void BANG::Block( AgCreate create )     
          {         
                ///@addtogroup BANG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("BANG");              
                            attr.par("seen")=1;              
