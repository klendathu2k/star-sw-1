          AgBlock *BWAT::mInstance = 0;     
          AgBlock *BWAT::Instance(){        
                   if ( mInstance==0 ) mInstance = new BWAT();        
                   return mInstance;        
          }     
          void BWAT::Block( AgCreate create )     
          {         
                ///@addtogroup BWAT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("BWAT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Component H2	a=1	z=1	w=2           
                      /// Component O	a=16	z=8	w=1           
                      /// Mixture Water dens=1.0           
                      {  AgMaterial &mix = AgMaterial::Get("Water");              
                            mix.Component("H2",1,1,2);              
                            mix.Component("O",16,8,1);              
                            mix.par("dens")=1.0;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=tray.coolinnr;              
                            /// Shape Tube rmin=0 rmax=tray.coolinnr               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_BWAT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_BWAT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block BWAT     
    // ----------------------------------------------------------------------- geoctr
       void BTOFGEO1::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup BTOFGEO1_revision        
             ///@{           
                   /// Author: W.J. Llope, Geary Eppley, Harlan Howe, Pablo Yepes           
             ///@}        
             ///@addtogroup BTOFGEO1_revision        
             ///@{           
                   /// Created:     23 March 1996            
             ///@}        
             AddBlock("BTOF", BTOF::Instance());        
             AddBlock("BTOH", BTOH::Instance());        
             AddBlock("BSEC", BSEC::Instance());        
             AddBlock("BTRA", BTRA::Instance());        
             AddBlock("BUND", BUND::Instance());        
             AddBlock("BTFT", BTFT::Instance());        
             AddBlock("BASE", BASE::Instance());        
             AddBlock("BARM", BARM::Instance());        
             AddBlock("BANG", BANG::Instance());        
             AddBlock("BWAT", BWAT::Instance());        
             AddBlock("BCOV", BCOV::Instance());        
             AddBlock("BXTR", BXTR::Instance());        
             AddBlock("BMTC", BMTC::Instance());        
             AddBlock("BTTC", BTTC::Instance());        
             AddBlock("BMTM", BMTM::Instance());        
             AddBlock("BMTD", BMTD::Instance());        
             AddBlock("BASS", BASS::Instance());        
             AddBlock("BXSA", BXSA::Instance());        
             AddBlock("BCSB", BCSB::Instance());        
             AddBlock("BCCV", BCCV::Instance());        
             AddBlock("BCPM", BCPM::Instance());        
             AddBlock("BCSK", BCSK::Instance());        
             AddBlock("BTSK", BTSK::Instance());        
             AddBlock("BZEL", BZEL::Instance());        
             AddBlock("BCEL", BCEL::Instance());        
             AddBlock("BFEE", BFEE::Instance());        
             AddBlock("BCOO", BCOO::Instance());        
             AddBlock("BRAI", BRAI::Instance());        
             AddBlock("BPIP", BPIP::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill btog
++btog._index;
btog.version = 2;
// btog_docum.version = " geometry version ";
btog.rmin = 207.80;
// btog_docum.rmin = " minimum CTB/TOF system radius (as built) ";
btog.rmax = 219.5;
// btog_docum.rmax = " maximum CTB/TOF system radius ";
btog.dz = 246.0;
// btog_docum.dz = " CTB/TOF tube half length ";
btog.choice = 4;
// btog_docum.choice = " 1=CTB, 2=TOF, 3=25% TOF+CTB, 4=1 tray TOF+CTB ";
btog.posit1 = 24;
// btog_docum.posit1 = " TOF tray position for choice 4 ";
BTOG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill tray
++tray._index;
tray.height = 8.89;
// tray_docum.height = " tray height ";
tray.width = 21.59;
// tray_docum.width = " full tray width ";
tray.length = 241.62;
// tray_docum.length = " full tray length ";
tray.wallthk = 0.13;
// tray_docum.wallthk = " tray wall thickness ";
tray.supfullh = 2.03;
// tray_docum.supfullh = " support height (radial) ";
tray.supfullw = 15.24;
// tray_docum.supfullw = " support full width with arms ";
tray.suplen = 215.9;
// tray_docum.suplen = " support length ";
tray.supbasew = 9.22;
// tray_docum.supbasew = " support base width ";
tray.supbaset = 0.32;
// tray_docum.supbaset = " support base thickness   ";
tray.suparmt = 0.64;
// tray_docum.suparmt = " support arm  thickness ";
tray.cooloutr = 0.80;
// tray_docum.cooloutr = " Cooling channel outer radius ";
tray.coolinnr = 0.48;
// tray_docum.coolinnr = " Cooling channel inner radius ";
tray.stript = 0.08;
// tray_docum.stript = " Thickness of polyethylene strip on bottom ";
tray.footinse = 1.06;
// tray_docum.footinse = " foot inset from tray edge ";
tray.footthk = 0.23;
// tray_docum.footthk = " thickness of foot material ";
tray.foot1len = 1.68;
// tray_docum.foot1len = " length (in section) of first part of foot ";
tray.foot2thk = 1.16;
// tray_docum.foot2thk = " thickness of second foot section ";
tray.foot3len = 2.16;
// tray_docum.foot3len = " length of third part of foot ";
TRAY.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ctbb
++ctbb._index;
ctbb.slab1len = 112.5;
// ctbb_docum.slab1len = " first slab (B) length ";
ctbb.slab2len = 130.0;
// ctbb_docum.slab2len = " second slab (A)length  ";
ctbb.slab1x = 5.84;
// ctbb_docum.slab1x = " first slab (B) x position ";
ctbb.slab2x = 2.67;
// ctbb_docum.slab2x = " second slab (A) x position ";
ctbb.slabthck = 1.0;
// ctbb_docum.slabthck = " scintillator slab thicknesses ";
ctbb.slabwid = 21.0;
// ctbb_docum.slabwid = " scintillator slab width ";
ctbb.convlen = 8.5;
// ctbb_docum.convlen = " optical converter length ";
ctbb.convwidm = 4.0;
// ctbb_docum.convwidm = " optical convertor min width ";
ctbb.convthck = 0.92;
// ctbb_docum.convthck = " optical convertor thickness ";
ctbb.pmtlen = 5.0;
// ctbb_docum.pmtlen = " PMT length ";
ctbb.pmtmaxr = 2.0;
// ctbb_docum.pmtmaxr = " PMT max radius ";
ctbb.pmtminr = 1.84;
// ctbb_docum.pmtminr = " PMT min radius ";
ctbb.baselen = 4.0;
// ctbb_docum.baselen = " Base length ";
ctbb.basemaxr = 2.13;
// ctbb_docum.basemaxr = " Base max radius ";
ctbb.baseminr = 1.0;
// ctbb_docum.baseminr = " Base min radius ";
ctbb.electhck = 0.25;
// ctbb_docum.electhck = " readout electronics thickness ";
ctbb.wrap = 0.13;
// ctbb_docum.wrap = " thickness of Tyvek + black plastic ";
ctbb.shim = 0.26;
// ctbb_docum.shim = " thickness of shim to position slat 2 ";
CTBB.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill toff
++toff._index;
toff.slat1len = 22.0;
// toff_docum.slat1len = " slat length ";
toff.slat1z = 101.5;
// toff_docum.slat1z = " slat 1 Z position ";
toff.slatdz = 24.;
// toff_docum.slatdz = " slat Z separation (Same as toff_ElecDz) ";
toff.slatthck = 2.0;
// toff_docum.slatthck = " scintillator slab thicknesses ";
toff.slatwid = 4.0;
// toff_docum.slatwid = " scintillator slab width ";
toff.slatang = 8.;
// toff_docum.slatang = " slat assy. angle w.r.t. tray ";
toff.pmtlen = 5.0;
// toff_docum.pmtlen = " PMT length ";
toff.pmtmaxr = 1.91;
// toff_docum.pmtmaxr = " PMT max radius ";
toff.pmtminr = 1.8;
// toff_docum.pmtminr = " PMT min radius ";
toff.baselen = 5.1;
// toff_docum.baselen = " Base length ";
toff.basemaxr = 1.91;
// toff_docum.basemaxr = " Base max radius ";
toff.baseminr = 1.8;
// toff_docum.baseminr = " Base min radius   ";
toff.elecx = 4.1;
// toff_docum.elecx = " FEE Board x position ";
toff.elec1z = 104.0;
// toff_docum.elec1z = " FEE Board 1 z position ";
toff.elecdz = toff.slatdz;
// toff_docum.elecdz = " FEE Board Dz (Same as toff_SlatDz) ";
toff.electhck = 0.17;
// toff_docum.electhck = " FEE Board thickness (67 mils) ";
toff.elecwid = 21.0;
// toff_docum.elecwid = " FEE Board width ";
toff.eleclen = 16.0;
// toff_docum.eleclen = " FEE Board length ";
toff.railthck = 0.2;
// toff_docum.railthck = " Cooling loop rail thickness ";
toff.railwid = 1.0;
// toff_docum.railwid = " Cooling loop rail width ";
toff.cooloutr = 0.375;
// toff_docum.cooloutr = " Cooling loop pipe outer radius ";
toff.coolinnr = 0.350;
// toff_docum.coolinnr = " Cooling loop pipe inner radius ";
TOFF.fill();
        
             /// USE btog _index=1;        
             BTOG.use( __btog__index__ = 1 );
        
             /// USE tray _index=1;        
             TRAY.use( __tray__index__ = 1 );
        
             /// USE ctbb _index=1;        
             CTBB.use( __ctbb__index__ = 1 );
        
             /// USE toff _index=1;        
             TOFF.use( __toff__index__ = 1 );
        
             _create = AgCreate("BTOF");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create BTOF           
                   Create("BTOF");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("BTOF");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume BTOF to mother CAVE           
                   _stacker -> Position( AgBlock::Find("BTOF"), place );           
             } // end placement of BTOF        
       }; // BTOFGEO1     
 }; // namespace BTOFGEO1  
 