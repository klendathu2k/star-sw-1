      FILL MOD7		! RUN7++ MRPC TOF Module dimensions and positions
      Height = 1.95 !  Module height (r)
      Width = 21.2 !  Module width (phi)
      Length = 9.4 !  Module length (z)
      Center = 0.35 !  Module detector center (phi)
      mrpcZ  = {    5.43,   11.42,   17.71,   23.56,   29.96, 
                   35.66,   42.71,   49.04,   55.35,   61.65, 
                   67.99,   74.42,   80.91,   87.44,   93.93, 
                  100.53,  107.30,  114.17,  121.22,  128.29, 
                  135.52,  142.80,  150.19,  157.72,  165.34, 
                  173.07,  180.92,  188.93,  197.02,  205.24, 
                  213.61,  222.08} !   mrpc Zposns 
      mrpcX  = {  3.94,  1.48,  3.94,  1.48,  3.94,  1.48, 
                  3.01,  3.54,  3.79,  3.86,  3.84,  3.89, 
                  3.89,  3.84,  3.51,  3.29,  3.29,  3.29, 
                  3.50,  3.50,  3.60,  3.60,  3.60,  3.60, 
                  3.60,  3.60,  3.60,  3.60,  3.60,  3.60, 
                  3.60,  3.60} !   mrpc Xposns 
      mrpcA  = {   0.,   0.,   0.,   0.,   0.,   0.,  16.,  16., 
                  20.,  22.,  22.,  22.,  22.,  22.,  26.,  26., 
                  26.,  26.,  30.,  30.,  32.,  32.,  32.,  32., 
                  32.,  32.,  32.,  32.,  32.,  32.,  32.,  32.} !   mrpc angles 
      X0Offset = -3.87 !  Tray inner surface to the center -tray_Height/2+tray_WallThk
      HCHgt = 0.4 !  HC->Height (r)
      HCWid = 20.8 !   HC->Width (phi)
      HCLen = 8.4 !    HC->Length (z)
      PCBHgt = 0.15 !  PCB->Height (r)
      PCBWid = 21.0 !   PCB->Width  (phi)
      PCBLen = 9.4 !    PCB->Length (z) *PCBLen =  9.4(real)
      MYHgt = 0.035 !  MYlar->Height
      MYWid = 21.2 !   MYlar->Width
      MYLen = 8.4 !    MYlar->Length
      GRHgt = 0.013 !  GRaphite->Height
      GRWid = 20.2 !   GRaphite->Width
      GRLen = 7.4 !    GRaphite->Length
      OGHgt = 0.07 !  Outer Glass->Height
      OGWid = 20.7 !   Outer Glass->Width
      OGLen = 7.8 !    Outer Glass->Length
      IGHgt = 0.054 !  Inner Glass->Height
      IGWid = 20.0 !   Inner Glass->Width
      IGLen = 6.1 !    Inner Glass->Length
      SPRMin = 0. !  SeParator Tube->RMin
      SPRMax = 0.011 !   SeParator Tube->RMax
      SPLen = 7.8 !    SeParator Tube->Length
      WGRMin = 0. !  Wedge Tube: RMin
      WGRMax = 0.15 !   Wedge Tube->RMax
      WGLen = 10.0 !    Wedge Tube->Length
      FEEH = 0.15 !  tofr fee pcb thickness
      HBWid = 0.635 !  the slim honeycomb support box width
      NGap = 6 !  Number of gaps in MRPC
      TrayEdgeZ = 0.50 ! tray posn along rail wrt TPC centerplane
      ENDFILL
      use BTOG
      use TRAY
      use GMTR
      use CTBB
      use TOFF
      use MODR
      use MOD4
      use MOD5
      use MOD7
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      COMPONENT O A=16 Z=8 W=0.4*4*16./174.
      MIXTURE G10 dens=1.7
      COMPONENT Si A=28.08 Z=14 W=.47
      COMPONENT O A=16 Z=8 W=.53
      MIXTURE Quartz dens=2.64
      COMPONENT H A=1 Z=1 W=.07
      COMPONENT C A=12 Z=6 W=.93
      MIXTURE Epoxy dens=1.2
      COMPONENT Si A=28.08 Z=14 W=.25
      COMPONENT O A=16 Z=8 W=.28
      COMPONENT H A=1 Z=1 W=.03
      COMPONENT C A=12 Z=6 W=.44
      MIXTURE FR4 dens=1.86
      COMPONENT H A=1 Z=1 W=0.90*2*1./102.+0.+0.05*10*1./58.
      COMPONENT C A=12 Z=6 W=0.90*2*12./102.+0.+0.05*4*12./58.
      COMPONENT F A=19 Z=9 W=0.90*4*19./102.+0.05*6*19./146.+0.
      COMPONENT S A=32 Z=16 W=0.+0.05*1*32./146.+0.
      MIXTURE RPCgas dens=4.55E-3
      COMPONENT Argon A=40 Z=18 W=0.90
      COMPONENT C A=14 Z=6 W=0.05
      COMPONENT O2 A=16 Z=8 W=0.05
      MIXTURE ArGAS dens=1.1
      COMPONENT Al A=27 Z=13 W=0.0105
      COMPONENT N A=14 Z=7 W=0.7395
      COMPONENT Adhesive A=9 Z=4.5 W=0.2500
      MIXTURE HoneyComb dens=0.73
      COMPONENT Cr A=51.9960 Z=24 W=0.19
      COMPONENT Ni A=58.6934 Z=28 W=0.09
      COMPONENT Fe A=55.8450 Z=26 W=0.72
      MIXTURE Steel dens=8.03
      CREATE BTOF
      CALL AgsReset 
      CALL agml_position_begin('BTOF') 
      %mother = 'CAVE' 
      %title = 'BTOF' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- BTOF
      BLOCK BTOF   is the whole CTF system envelope
      ATTRIBUTE BTOF seen=1 colo=1
      MATERIAL Air
      MEDIUM Standard
      SHAPE tube rmin=btog_Rmin+btog_X0 rmax=btog_Rmax+btog_X0,
            dz=btog_dz+btog_Z0
      Prin0 btog_choice,8;
      ('BTOF: btog_choice = ', F4.1, ' itof = ', I2)
      Prin0 YEAR;
      (' : this is the run ',I2,' geometry ...')
      choice = 1                           ! ctb
      IF ( (btog_choice==2) ) THEN
      choice= 2     ! full tofp
      ENDIF
      IF ( (btog_choice==6) ) THEN
      choice= 6     ! full tofr
      ENDIF
      IF ( (btog_choice==12) ) THEN
      choice=12     ! run-9 selection (west)
      ENDIF
      IF ( (btog_choice==13) ) THEN
      choice=13     ! run-13 selection (west)
      ENDIF
      Prin1 choice;
      (' Positioning West Barrel, choice=',I2)
      CREATE BTOH
      CALL AgsReset 
      CALL agml_position_begin('BTOH') 
      %title = 'BTOH' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(+btog_dz/2+btog_Z0) 
      CALL agml_translate_z( %z ) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      choice = btog_choice
      IF ( ((btog_choice==12) .or. (btog_choice==13)) ) THEN
      choice=-btog_choice    ! explicitly handle East Barrel (runs 9 and 13+)
      ENDIF
      Prin1 choice;
      (' Positioning East Barrel, choice=', I2)
      CREATE BTOH
      CALL AgsReset 
      CALL agml_position_begin('BTOH') 
      %title = 'BTOH' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(-btog_dz/2-btog_Z0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTOH
      BLOCK BTOH   is a half of trigger system (west-east)
      ATTRIBUTE BTOH seen=0 colo=1 serial=choice
      SHAPE tube dz=btog_dz/2
      DO is = 1, 60
      tof=0                                          !// all CTB for choice=1
      IF ( (choice==2) ) THEN
      tof=1     !// all TOFp
      ENDIF
      IF ( (choice==3&46<=is&is<=60) ) THEN
      tof=1     !// big TOFp patch, rest CTB
      ENDIF
      IF ( (choice==4&is==btog_posit1(1)) ) THEN
      tof=1     !// Run-2 (one TOFp tray)
      ENDIF
      IF ( (choice==5&is==btog_posit1(1)) ) THEN
      tof=1     !// Run-3 (one TOFp tray
      ENDIF
      IF ( (choice==5&is==btog_posit2) ) THEN
      tof=2     !      and one TOFr tray)
      ENDIF
      IF ( (choice==6) ) THEN
      tof=7     !// all TOFr
      ENDIF
      IF ( (choice==7&is==btog_posit1(2)) ) THEN
      tof=1     !// Run-4 (one TOFp tray moved 1 slot
      ENDIF
      IF ( (choice==7&is==btog_posit2) ) THEN
      tof=3     !      and one TOFrp tray)
      ENDIF
      IF ( (choice==8&is==btog_posit3) ) THEN
      tof=4     !// Run-5 (one TOFr5 tray)
      ENDIF
      IF ( (choice==9&is==btog_posit3) ) THEN
      tof=5     !// Run-6 (one TOFr6 tray)
      ENDIF
      IF ( (choice==10&is==btog_posit3) ) THEN
      tof=6     !// Run-7 (one TOFr7 tray)
      ENDIF
      IF ( (choice==11&is==btog_posit4(1)) ) THEN
      tof=7     !// Run-8 (5 TOFr8 trays)
      ENDIF
      IF ( (choice==11&is==btog_posit4(2)) ) THEN
      tof=7     !// Run-8 (5 TOFr8 trays)
      ENDIF
      IF ( (choice==11&is==btog_posit4(3)) ) THEN
      tof=7     !// Run-8 (5 TOFr8 trays)
      ENDIF
      IF ( (choice==11&is==btog_posit4(4)) ) THEN
      tof=7     !// Run-8 (5 TOFr8 trays)
      ENDIF
      IF ( (choice==11&is==btog_posit4(5)) ) THEN
      tof=7     !// Run-8 (5 TOFr8 trays)
      ENDIF
      IF ( (choice==12&btog_posit5(is)==1) ) THEN
      tof= 7 !// Run-9:TOFr8 tray (west)
      ENDIF
      IF ( (choice==12&btog_posit5(is)==0) ) THEN
      tof=-1 !// Run-9: no tray (west)
      ENDIF
      IF ( (choice==-12&btog_posit5(is+60)==1) ) THEN
      tof= 7 !// Run-9: TOFr8 tray (east)
      ENDIF
      IF ( (choice==-12&btog_posit5(is+60)==0) ) THEN
      tof=-1 !// Run-9: no tray (east)
      ENDIF
      IF ( (choice==13) ) THEN
      tof= btog_posit13(is) !// Run-13+ (west)
      ENDIF
      IF ( (choice==-13) ) THEN
      tof= btog_posit13(is+60) !// Run-13+ (east)
      ENDIF
      IF ( choice==11 ) THEN
      IF ( is==btog_posit4(1) ) THEN
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is+btog_dphi1(1)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( is==btog_posit4(2) ) THEN
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is+btog_dphi1(2)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( is==btog_posit4(3) ) THEN
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is+btog_dphi1(3)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( is==btog_posit4(4) ) THEN
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is+btog_dphi1(4)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( is==btog_posit4(5) ) THEN
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is+btog_dphi1(5)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ELSE
      CREATE BSEC
      CALL AgsReset 
      CALL agml_position_begin('BSEC') 
      %title = 'BSEC' 
      %exname = 'POSITION' ! agml placement 
      ag_alphaz = real(102+6*is) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BSEC
      BLOCK BSEC   is a sector of CTB/TOF Trigger Barrel Scintillators
      ATTRIBUTE BSEC seen=0 colo=1 serial=tof
      SHAPE tubs phi1=-3.0 phi2=3.0
      CREATE BTRA
      CALL AgsReset 
      CALL agml_position_begin('BTRA') 
      %title = 'BTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(btog_Rmin+(tray_SupFullH+tray_height+tray_StripT)/2+btog_X0) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      IF ( tof==2 ) THEN
      CREATE BRFE
      CALL AgsReset 
      CALL agml_position_begin('BRFE') 
      %title = 'BRFE' 
      %exname = 'POSITION' ! agml placement 
      ag_x =  _
	real(btog_Rmin+tray_SupFullH+tray_StripT+tray_height+modr_feeh/2+btog_X0) 
      CALL agml_translate_x( %x ) 
      ag_z = real((btog_dz-tray_length)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTRA
      BLOCK BTRA   is one full tray plus supporting structure for CTB/TOF
      ATTRIBUTE BTRA seen=1 colo=2
      SHAPE box dx=(tray_SupFullH+tray_height+tray_StripT)/2,
            dy=tray_Width/2
      IF ( tof!=-1 ) THEN
      CREATE BXTR
      CALL AgsReset 
      CALL agml_position_begin('BXTR') 
      %title = 'BXTR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((tray_SupFullH+tray_StripT)/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real((btog_dz-tray_length)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      CREATE BUND
      CALL AgsReset 
      CALL agml_position_begin('BUND') 
      %title = 'BUND' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(tray_height+tray_StripT)/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real((btog_dz-tray_SupLen)/2) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRFE
      BLOCK BRFE   is the FEE of tofr (run-3)
      ATTRIBUTE BRFE seen=0 colo=3
      MATERIAL G10
      SHAPE box dx=modr_feeh/2 dy=tray_Width/2,
            dz=tray_Length/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BXTR
      BLOCK BXTR   is a Main TRay covering box for CTB or TOF
      ATTRIBUTE BXTR seen=0 colo=2
      MATERIAL Aluminium
      SHAPE box dx=tray_height/2 dz=tray_length/2
      IF ( tof==1 ) THEN
      CREATE BTTC
      CALL AgsReset 
      CALL agml_position_begin('BTTC') 
      %title = 'BTTC' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( tof>=2 ) THEN
      CREATE BRTC
      CALL AgsReset 
      CALL agml_position_begin('BRTC') 
      %title = 'BRTC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(tray_CoverH+tray_TopThk-tray_WallThk)/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BUPC
      CALL AgsReset 
      CALL agml_position_begin('BUPC') 
      %title = 'BUPC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((tray_Height-tray_CoverH)/2-tray_CoverThk/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE BMTC
      CALL AgsReset 
      CALL agml_position_begin('BMTC') 
      %title = 'BMTC' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BMTC
      BLOCK BMTC   is the Main Tray Cavity filled with the details for CTB
      ATTRIBUTE BMTC seen=-1 colo=5
      MATERIAL Air
      SHAPE box dx=tray_height/2-tray_WallThk,
            dy=tray_Width/2-tray_WallThk dz=tray_Length/2-tray_WallThk
      zpos  =(tray_length - ctbb_Slab1Len)/2 - tray_WallThk - ctbb_Wrap
      xpos  = - tray_Height/2 + ctbb_Slab1x
      CREATE BXSA
      CALL AgsReset 
      CALL agml_position_begin('BXSA') 
      %title = 'BXSA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %dz = real(ctbb_Slab1Len/2) 
      %dx = real(ctbb_SlabThck/2) 
      %dy = real(ctbb_SlabWid/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_Slab1Len + ctbb_ConvLen)/2
      CREATE BCCV
      CALL AgsReset 
      CALL agml_position_begin('BCCV') 
      %title = 'BCCV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %dx2 = real(ctbb_SlabThck/2) 
      %dy2 = real(ctbb_SlabWid/2) 
      %dy1 = real(ctbb_ConvWidM/2) 
      %dz = real(ctbb_ConvLen/2) 
      %dx1 = real(ctbb_SlabThck/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_ConvLen + ctbb_PmtLen)/2
      CREATE BCPM
      CALL AgsReset 
      CALL agml_position_begin('BCPM') 
      %title = 'BCPM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %rmin = real(ctbb_PmtMinR) 
      %rmax = real(ctbb_PmtMaxR) 
      %dz = real(ctbb_PmtLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_PmtLen + ctbb_BaseLen)/2
      CREATE BCSK
      CALL AgsReset 
      CALL agml_position_begin('BCSK') 
      %title = 'BCSK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %rmin = real(ctbb_BaseMinR) 
      %rmax = real(ctbb_BaseMaxR) 
      %dz = real(ctbb_BaseLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BZEL
      CALL AgsReset 
      CALL agml_position_begin('BZEL') 
      %title = 'BZEL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %dz = real(ctbb_BaseLen/2) 
      %dx = real(ctbb_ElecThck/2) 
      %dy = real(ctbb_BaseMinR-0.1) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos  =(tray_length - ctbb_Slab2Len)/2 - tray_WallThk - ctbb_Wrap - ctbb_Shim
      xpos  = - tray_Height/2 + ctbb_Slab2x
      CREATE BXSA
      CALL AgsReset 
      CALL agml_position_begin('BXSA') 
      %title = 'BXSA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(-zpos) 
      CALL agml_translate_z( %z ) 
      %dz = real(ctbb_Slab2Len/2) 
      %dx = real(ctbb_SlabThck/2) 
      %dy = real(ctbb_SlabWid/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_Slab2len + ctbb_ConvLen)/2
      CALL AgsReset 
      CALL agml_position_begin('BCCV') 
      %title = 'BCCV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(-zpos) 
      CALL agml_translate_z( %z ) 
      %dx2 = real(ctbb_SlabThck/2) 
      %dy2 = real(ctbb_SlabWid/2) 
      %dy1 = real(ctbb_ConvWidM/2) 
      %dz = real(ctbb_ConvLen/2) 
      %dx1 = real(ctbb_SlabThck/2) 
      ag_alphax = 180.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_ConvLen + ctbb_PmtLen)/2
      CALL AgsReset 
      CALL agml_position_begin('BCPM') 
      %title = 'BCPM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(-zpos) 
      CALL agml_translate_z( %z ) 
      %rmin = real(ctbb_PmtMinR) 
      %rmax = real(ctbb_PmtMaxR) 
      %dz = real(ctbb_PmtLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos - (ctbb_PmtLen + ctbb_BaseLen)/2
      CALL AgsReset 
      CALL agml_position_begin('BCSK') 
      %title = 'BCSK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(-zpos) 
      CALL agml_translate_z( %z ) 
      %rmin = real(ctbb_BaseMinR) 
      %rmax = real(ctbb_BaseMaxR) 
      %dz = real(ctbb_BaseLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BZEL') 
      %title = 'BZEL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_z = real(-zpos) 
      CALL agml_translate_z( %z ) 
      %dz = real(ctbb_BaseLen/2) 
      %dx = real(ctbb_ElecThck/2) 
      %dy = real(ctbb_BaseMinR-0.1) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTTC
