      SHAPE box dx=gmtr_HVThk/2 dy=gmtr_HVW/2,
            dz=gmtr_HVL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GVBC
      BLOCK GVBC   is the HV Box Connector
      ATTRIBUTE GVBC seen=1 colo=2
      MATERIAL Steel
      SHAPE tube rmin=gmtr_GVI rmax=gmtr_GVO dz=gmtr_GVL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GFBO
