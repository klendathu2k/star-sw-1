      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BUND
      BLOCK BUND   is Undercarriage support tray - same both for CTB and TOF
      ATTRIBUTE BUND seen=0 colo=1 serial=0
      SHAPE box dx=tray_SupFullH/2 dy=tray_Width/2,
            dz=tray_SupLen/2
      MATERIAL Aluminium
      xpos =(tray_SupFullH - tray_FootThk)/2
      ypos =(tray_width - tray_Foot1Len)/2 - tray_FootInse
      CREATE BTFT
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_FootThk/2) 
      %dy = real(tray_Foot1Len/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(+ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_FootThk/2) 
      %dy = real(tray_Foot1Len/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      xpos =(tray_SupFullH - tray_Foot2Thk)/2
      ypos = ypos - (tray_Foot1Len + tray_FootThk)/2
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_Foot2Thk/2) 
      %dy = real(tray_FootThk/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(+ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_Foot2Thk/2) 
      %dy = real(tray_FootThk/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      xpos =(tray_SupFullH - tray_FootThk)/2 - tray_Foot2Thk
      ypos = ypos - (tray_FootThk + tray_Foot3Len)/2
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_FootThk/2) 
      %dy = real(tray_Foot3Len/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BTFT') 
      %title = 'BTFT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(+ypos) 
      CALL agml_translate_y( %y ) 
      %dx = real(tray_FootThk/2) 
      %dy = real(tray_Foot3Len/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      support_aile_width =(tray_SupFullH - tray_SupArmT)/tan(60*DegRad)
      support_arm_width  =(tray_SupFullW - tray_SupBaseW)/2 - support_aile_width
      support_aile_Ypos  =(tray_SupBaseW + Support_Aile_width)/2
      support_arm_Xpos   =(tray_SupFullH - tray_SupArmT)/2
      support_arm_Ypos   =(tray_SupFullW - Support_Arm_width)/2
      MATERIAL Aluminium
      CREATE BASE
      CALL AgsReset 
      CALL agml_position_begin('BASE') 
      %title = 'BASE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((-tray_SupFullH+tray_SupBaseT)/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BARM
      CALL AgsReset 
      CALL agml_position_begin('BARM') 
      %title = 'BARM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(support_arm_Xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-support_arm_Ypos) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BARM') 
      %title = 'BARM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(support_arm_Xpos) 
      CALL agml_translate_x( %x ) 
      ag_y = real(+support_arm_Ypos) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BANG
      CALL AgsReset 
      CALL agml_position_begin('BANG') 
      %title = 'BANG' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(-support_aile_Ypos) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BANG') 
      %title = 'BANG' 
      %exname = 'POSITION' ! agml placement 
      ag_y = real(+support_aile_Ypos) 
      CALL agml_translate_y( %y ) 
      %thetax = 270.0 
      %thetay = 90.0 
      %thetaz = 0.0 
      %phix = 0.0 
      %phiy = 90.0 
      %phiz = 0.0 
      CALL agml_set_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BCOV
      CALL AgsReset 
      CALL agml_position_begin('BCOV') 
      %title = 'BCOV' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-tray_SupFullH/2+tray_CoolOutR) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTFT
      BLOCK BTFT   is the Foot structure ( Material Aluminium )
      ATTRIBUTE BTFT seen=0 colo=2
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BARM
      BLOCK BARM   is a TPC cooling structure arm ( Material Aluminium )
      ATTRIBUTE BARM seen=0 colo=2
      SHAPE box dx=tray_SupArmT/2 dy=support_arm_width/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BANG
      BLOCK BANG   is an angled part of TPC cooling structure ( Aile )
      ATTRIBUTE BANG seen=0 colo=2
      SHAPE para dx=tray_SupArmT/2 dy=support_aile_width/2,
            alph=-60 thet=0 phi=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BASE
      BLOCK BASE   is a bottom of TPC coolant structure
      ATTRIBUTE BASE seen=0 colo=2
      SHAPE box dx=tray_SupBaseT/2 dy=tray_SupBaseW/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCOV
      BLOCK BCOV   is a whole TPC cooling channel
      ATTRIBUTE BCOV seen=0 colo=2
      SHAPE tube rmin=0 rmax=tray_CoolOutR
      CREATE BWAT
      CALL AgsReset 
      CALL agml_position_begin('BWAT') 
      %title = 'BWAT' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BWAT
      BLOCK BWAT   is TPC cooling water
      ATTRIBUTE BWAT seen=0 colo=3
      COMPONENT H2 A=1 Z=1 W=2
      COMPONENT O A=16 Z=8 W=1
      MIXTURE Water dens=1.0
      SHAPE tube rmin=0 rmax=tray_CoolInnR
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRMD
      BLOCK BRMD   is a six channel module for TOFr
      ATTRIBUTE BRMD seen=1 colo=6
      MATERIAL RPCgas
      SHAPE box dx=mod7_Height/2 dy=mod7_Width/2,
            dz=mod7_Length/2
      CREATE BRHC
      CREATE BRCB
      CREATE BRNY
      CREATE BRGR
      CREATE BROG
      DTHgt =(mod7_IGHgt + mod7_SPRMax*2)*(mod7_NGap - 1) + mod7_SPRMax*2
      CREATE BRDT dz=mod7_IGLen/2. dx=DTHgt/2. dy=mod7_IGWid/2.
      CREATE BRWG
      XPOS = mod7_Height/2.
      Y = 0.
      Z = mod7_Center
      CALL AgsReset 
      CALL agml_position_begin('BRHC') 
      %title = 'BRHC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_HCHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real(mod7_Center) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_HCHgt
      CALL AgsReset 
      CALL agml_position_begin('BRCB') 
      %title = 'BRCB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_PCBHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_PCBHgt
      CALL AgsReset 
      CALL agml_position_begin('BRNY') 
      %title = 'BRNY' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_MYHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real(mod7_Center) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_MYHgt
      CALL AgsReset 
      CALL agml_position_begin('BRGR') 
      %title = 'BRGR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_GRHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_GRHgt
      CALL AgsReset 
      CALL agml_position_begin('BROG') 
      %title = 'BROG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_OGHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_OGHgt
      CALL AgsReset 
      CALL agml_position_begin('BRDT') 
      %title = 'BRDT' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(XPOS-DTHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - DTHgt
      CALL AgsReset 
      CALL agml_position_begin('BROG') 
      %title = 'BROG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_OGHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_OGHgt
      CALL AgsReset 
      CALL agml_position_begin('BRGR') 
      %title = 'BRGR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_GRHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_GRHgt
      CALL AgsReset 
      CALL agml_position_begin('BRNY') 
      %title = 'BRNY' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_MYHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_MYHgt
      CALL AgsReset 
      CALL agml_position_begin('BRCB') 
      %title = 'BRCB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_PCBHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_PCBHgt
      CALL AgsReset 
      CALL agml_position_begin('BRHC') 
      %title = 'BRHC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_HCHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real(mod7_Center) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_HCHgt
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRHC
      BLOCK BRHC   is the HoneyComb in the TOFr module
      ATTRIBUTE BRHC seen=1 colo=1
      MATERIAL HoneyComb
      SHAPE box dx=mod7_HCHgt/2 dy=mod7_HCWid/2,
            dz=mod7_HCLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRCB
      BLOCK BRCB   is the PCB in the TOFr module
      ATTRIBUTE BRCB seen=1 colo=3
      MATERIAL G10
      SHAPE box dx=mod7_PCBHgt/2 dy=mod7_PCBWid/2,
            dz=mod7_PCBLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRNY
      BLOCK BRNY   is the MYlar in the TOFr module
      ATTRIBUTE BRNY seen=0 colo=1
      MATERIAL MYLAR
      SHAPE box dx=mod7_MYHgt/2 dy=mod7_MYWid/2,
            dz=mod7_MYLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRGR
      BLOCK BRGR   is the GRaphite in the TOFr module
      ATTRIBUTE BRGR seen=0 colo=1
      MATERIAL Carbon
      SHAPE box dx=mod7_GRHgt/2 dy=mod7_GRWid/2,
            dz=mod7_GrLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BROG
      BLOCK BROG   is the Outer Glass in the TOFr module
      ATTRIBUTE BROG seen=1 colo=7
      COMPONENT Si A=28 Z=14 W=1.
      COMPONENT O A=16 Z=8 W=2.
      MIXTURE Glass dens=2.5
      SHAPE box dx=mod7_OGHgt/2 dy=mod7_OGWid/2,
            dz=mod7_OGLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRDT
      BLOCK BRDT   is the middle part (including innner glass and gas)in the MRPC
      ATTRIBUTE BRDT
      SHAPE box
      CREATE BRIG
      CREATE BRSG
      XPOS = DTHgt/2.
      Y    = 0.
      Z    = 0.
      DO igap = 1, mod7_NGap-1
      CALL AgsReset 
      CALL agml_position_begin('BRSG') 
      %title = 'BRSG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(XPOS-mod7_SPRMax) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_SPRMax*2.
      CALL AgsReset 
      CALL agml_position_begin('BRIG') 
      %title = 'BRIG' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(XPOS-mod7_IGHgt/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_IGHgt
      END DO
      CALL AgsReset 
      CALL agml_position_begin('BRSG') 
      %title = 'BRSG' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(XPOS-mod7_SPRMax) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      XPOS = XPOS - mod7_SPRMax*2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRIG
      BLOCK BRIG   is the Inner Glass in the TOFr module
      ATTRIBUTE BRIG seen=1 colo=7
      MATERIAL Glass
      SHAPE box dx=mod7_IGHgt/2 dy=mod7_IGWid/2,
            dz=mod7_IGLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRSG
      BLOCK BRSG   is the sensitive gas layer in the TOFr module
      ATTRIBUTE BRSG seen=0 colo=5
      MATERIAL RPCgas
      MEDIUM sensitive isvol=1
      SHAPE box dx=mod7_SPRMax dy=mod7_IGWid/2,
            dz=mod7_IGLen/2
      HITS BRSG X:0.01:HS Y:0.01: Z:0.01: ptot:18:(0.0,100.0) sleng:0.1:(0,500) tof:16:(0.0,1.0E-7),
            step:0.01: eloss:16:(0.0,1.0E-6)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRWG
      BLOCK BRWG   is the WedGe(support) in the TOFr module
      ATTRIBUTE BRWG seen=0
      COMPONENT O A=16 Z=8 W=2
      COMPONENT C A=12 Z=6 W=5
      COMPONENT H A=1 Z=1 W=8
      MIXTURE Lucite dens=1.18
      SHAPE tube rmin=mod7_WGRMin rmax=mod7_WGRMax,
            dz=mod7_WGLen/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GMTS
      BLOCK GMTS   is the space for the geometry pertaining to the GMT
      ATTRIBUTE GMTS seen=1 colo=2
      SHAPE box dx=(gmtr_GMTSThk)/2 dy=(gmtr_GINW)/2,
            dz=(gmtr_GINL)/2
      CREATE GINO
      CALL AgsReset 
      CALL agml_position_begin('GINO') 
      %title = 'GINO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(gmtr_GINThkd) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GSBB
      CALL AgsReset 
      CALL agml_position_begin('GSBB') 
      %title = 'GSBB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(gmtr_GSBBThkd) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GNSF
      CALL AgsReset 
      CALL agml_position_begin('GNSF') 
      %title = 'GNSF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(gmtr_GNSFThkd) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE GSBE
      CALL AgsReset 
      CALL agml_position_begin('GSBE') 
      %title = 'GSBE' 
