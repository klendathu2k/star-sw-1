      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(5)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPLA') 
      %title = 'BPLA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(6)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPLA') 
      %title = 'BPLA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(7)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPLA') 
      %title = 'BPLA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(8)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPLA') 
      %title = 'BPLA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(9)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPLA') 
      %title = 'BPLA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_Elecz(10)+toff_PlasPos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BUPC
      BLOCK BUPC   is the upper cover of tofr
      ATTRIBUTE BUPC seen=0 colo=3
      MATERIAL Air
      SHAPE box dx=(tray_CoverH-tray_CoverThk)/2,
            dy=tray_Width/2-tray_CoverThk dz=tray_Length/2
      CREATE BTFE
      CALL AgsReset 
      CALL agml_position_begin('BTFE') 
      %title = 'BTFE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(tray_CoverH-tray_CoverThk)/2+tray_FEEH1+tray_FEEThk/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BTFE') 
      %title = 'BTFE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-(tray_CoverH-tray_CoverThk)/2+tray_FEEH2+tray_FEEThk/2) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTFE
      BLOCK BTFE   is the TINO/TDIG boards
      ATTRIBUTE BTFE seen=0 colo=3
      MATERIAL G10
      SHAPE box dx=tray_FEEThk/2 dy=tray_FEEW/2,
            dz=tray_FEEL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BRTC
      BLOCK BRTC   is the Main Tray Cavity filled with the details for TOFr (run3,
            or run4)
      ATTRIBUTE BRTC seen=0 colo=5
      MATERIAL HoneyComb
      SHAPE box dx=(tray_Height-tray_CoverH-tray_WallThk-tray_TopThk)/2,
            dy=tray_Width/2-tray_WallThk,
            dz=tray_Length/2-tray_WallThk
      CREATE BGMT
      CALL AgsReset 
      CALL agml_position_begin('BGMT') 
      %title = 'BGMT' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BGMT
      BLOCK BGMT   is the mixture gas box in tray that change the hc box into slim
      ATTRIBUTE BGMT seen=0 colo=2
      MATERIAL RPCgas
      SHAPE box dx=(tray_Height-tray_CoverH-tray_TopThk-tray_WallThk)/2,
            dy=tray_Width/2-tray_WallThk,
            dz=tray_Length/2-tray_WallThk
      CREATE BRMD
      IF ( tof==2 ) THEN
      z0 = tray_Length/2 - 0.05
      x0 = modr_X0Offset
      DO i = 1, 33
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+modr_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-modr_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(modr_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ELSEIF ( tof==3 ) THEN
      z0 = tray_Length/2 - 0.05 - mod4_TrayEdgeZ
      x0 = mod4_X0Offset
      DO i = 1, 32
      IF ( i.le.20.or.(i.ge.25.and.i.le.28) ) THEN
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+mod4_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-mod4_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(mod4_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      END DO
      ELSEIF ( tof==4 ) THEN
      z0 = tray_Length/2 - 0.05 - mod5_TrayEdgeZ
      x0 = mod5_X0Offset
      DO i = 1, 32
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+mod5_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-mod5_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(mod5_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ELSEIF ( tof==5 ) THEN
      ELSEIF ( tof==6 ) THEN
      z0 = tray_Length/2 - mod7_TrayEdgeZ
      x0 = -tray_Height/2 + tray_WallThk
      DO i = 1, 32
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+mod7_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-mod7_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(mod7_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ELSEIF ( tof==7 ) THEN
      z0 = tray_Length/2 - tray_WallThk
      x0 = -(tray_Height-tray_CoverH-tray_WallThk-tray_TopThk)/2
      DO i = 1, 32
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+mod7_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-mod7_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(mod7_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ELSEIF ( tof==8 ) THEN
      z0 = tray_Length/2 - tray_WallThk
      x0 = -(tray_Height-tray_CoverH-tray_WallThk-tray_TopThk)/2
      DO i = 5, 28
      CALL AgsReset 
      CALL agml_position_begin('BRMD') 
      %title = 'BRMD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+mod7_mrpcX(i)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(z0-mod7_mrpcZ(i)) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(mod7_mrpcA(i)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      CREATE GMTS
      CALL AgsReset 
      CALL agml_position_begin('GMTS') 
      %title = 'GMTS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+gmtr_POS1(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(z0-gmtr_POS1(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('GMTS') 
      %title = 'GMTS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(x0+gmtr_POS2(1)) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(z0-gmtr_POS2(3)) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BMAA
      BLOCK BMAA   is a b1ox for a 4wide AND 5wide phi column of TOF Scintillators
      ATTRIBUTE BMAA seen=0 colo=2
      IF ( iwid==4 ) THEN
      SHAPE box dx=tray_height/2-tray_WallThk,
            dy=0.8*toff_BoxWidth/2 dz=sublen/2.
      ELSE
      SHAPE box dx=tray_height/2-tray_WallThk,
            dy=toff_BoxWidth/2 dz=toff_Slat5Z
      ENDIF
      CREATE BMTD
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BMTD
      BLOCK BMTD   is a 5wide phi column of TOF Scintillators
      ATTRIBUTE BMTD seen=1 colo=1
      SHAPE division ndiv=iwid iaxis=2
      CREATE BASS
      IF ( iwid==5 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('BASS') 
      %title = 'BASS' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_Slatx(1)) 
      CALL agml_translate_x( %x ) 
      ag_alphay = real(toff_SlatAy(1)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      DO islat = 2, 10
      CALL AgsReset 
      CALL agml_position_begin('BASS') 
      %title = 'BASS' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_Slatx(islat)) 
      CALL agml_translate_x( %x ) 
      ag_z = real(toff_Slatz(islat)-subcen) 
      CALL agml_translate_z( %z ) 
      ag_alphay = real(toff_SlatAy(islat)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BASS
      BLOCK BASS   is a single TOF Slat Assembly (slat+PMT+base)
      ATTRIBUTE BASS seen=0 colo=6
      totlen = toff_SlatLen + toff_PmtLen + toff_BaseLen
      SHAPE box dx=toff_PmtMaxR dy=(tray_Width/2-tray_WallThk)/5.,
            dz=totlen/2.
      zpos = - (totlen - toff_SlatLen)/2
      CREATE BCSB
      CALL AgsReset 
      CALL agml_position_begin('BCSB') 
      %title = 'BCSB' 
      %exname = 'POSITION' ! agml placement 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos + (toff_SlatLen + toff_PmtLen)/2
      CREATE BCPM
      CALL AgsReset 
      CALL agml_position_begin('BCPM') 
      %title = 'BCPM' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %rmin = real(toff_PmtMinR) 
      %rmax = real(toff_PmtMaxR) 
      %dz = real(toff_PmtLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos + toff_PmtLen/2.
      CREATE BTSK
      CALL AgsReset 
      CALL agml_position_begin('BTSK') 
      %title = 'BTSK' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos+(toff_SockLen/2)) 
      CALL agml_translate_z( %z ) 
      %rmin = real(toff_PmtMinR) 
      %rmax = real(toff_PmtMaxR) 
      %dz = real(toff_SockLen/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BCEL
      CALL AgsReset 
      CALL agml_position_begin('BCEL') 
      %title = 'BCEL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos+(toff_ElecThck/2)) 
      CALL agml_translate_z( %z ) 
      %rmin = 0.0 
      %rmax = real(toff_PmtMinR) 
      %dz = real(toff_ElecThck/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos + toff_BaseLen/2
      CREATE BCEB dz=toff_BaseLen/2 dx=toff_ElecThck/2 dy=toff_CellWid/2
      CALL AgsReset 
      CALL agml_position_begin('BCEB') 
      %title = 'BCEB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_CellHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BCEB') 
      %title = 'BCEB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-toff_CellHgt/2) 
      CALL agml_translate_x( %x ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      zpos = zpos + toff_BaseLen/2 - 0.6
      CREATE BCON
      CALL AgsReset 
      CALL agml_position_begin('BCON') 
      %title = 'BCON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(zpos) 
      CALL agml_translate_z( %z ) 
      %dy = real(toff_BconYLen/2) 
      %dz = real(toff_BconZLen/2) 
      %dx = real((toff_CellHgt-toff_ElecThck)/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BXSA
      BLOCK BXSA   is the active trigger scintillator SLAB for ctb
      ATTRIBUTE BXSA seen=0 colo=3
      MATERIAL polystyren
      MEDIUM sensitive isvol=1
      SHAPE box dx=0 dy=0 dz=0
      HITS BXSA X:0.01:S Y:0.01: Z:0.01: ptot:18:(0.0,100.0) cx:10: cy:10: cz:10:,
            sleng:0.1:(0,500) tof:16:(0.0,1.0E-6) step:0.01: eloss:16:(0.0,0.01)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCSB
      BLOCK BCSB   is the active trigger scintillator SLAB for tof
      ATTRIBUTE BCSB seen=1 colo=7
      MATERIAL polystyren
      MEDIUM sensitive isvol=1
      SHAPE box dx=toff_SlatThck/2 dy=toff_SlatWid/2,
            dz=toff_SlatLen/2
      HITS BCSB X:0.01:S Y:0.01: Z:0.01: ptot:18:(0.0,100.0) cx:10: cy:10: cz:10:,
            sleng:0.1:(0,500) tof:16:(0.0,1.0E-6) step:0.01: eloss:16:(0.0,0.01)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCCV
      BLOCK BCCV   is a Ctb optical ConVerter
      ATTRIBUTE BCCV seen=0 colo=3
      MATERIAL polystyren
      SHAPE trd2 dx1=0 dx2=0 dy1=0 dy2=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCSK
      BLOCK BCSK   is a CTB Linear Base tube
      ATTRIBUTE BCSK seen=0 colo=2
      MATERIAL polystyren
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BZEL
      BLOCK BZEL   is a Ctb PM electronics
      ATTRIBUTE BZEL seen=0 colo=6
      MATERIAL silicon
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCPM
      BLOCK BCPM   is a PhotoMultiplier Tube (same for CTB and TOF)
      ATTRIBUTE BCPM seen=0 colo=1
      MATERIAL polystyren
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BTSK
      BLOCK BTSK   is the outer shell of a TOF CW Base
      ATTRIBUTE BTSK seen=0 colo=7
      MATERIAL polystyren
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCEL
      BLOCK BCEL   is a circular G10 board in the CW Base for TOF
      ATTRIBUTE BCEL seen=0 colo=3
      MATERIAL G10
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCEB
      BLOCK BCEB   is a square G10 board in the CW Base for TOF
      ATTRIBUTE BCEL seen=0 colo=3
      MATERIAL G10
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BPLA
      BLOCK BPLA   is the plastic angle pieces that hold the upper foam supports...
      ATTRIBUTE BPLA seen=0 colo=4
      MATERIAL polystyren
      SHAPE box dx=0 dy=0 dz=0
      CREATE BCON
      CALL AgsReset 
      CALL agml_position_begin('BCON') 
      %title = 'BCON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-toff_BconPLdz) 
      CALL agml_translate_z( %z ) 
      %dy = real(tray_Width/2-tray_WallThk-0.5) 
      %dz = real(toff_BconPLdz) 
      %dx = real(toff_BconPLdx/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BCON') 
      %title = 'BCON' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((-toff_BconPLdx-toff_BconPLdz)/2) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real((-toff_BconPLdx)/2) 
      CALL agml_translate_z( %z ) 
      %dy = real(tray_Width/2-tray_WallThk-2.0) 
      %dz = real(toff_BconPLdx/2) 
      %dx = real(toff_BconPLdz/2) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCON
