      ! ---------------------------------------------------------------------------------- GEMG
      BLOCK GEMG   is the Argon gas within the GEM
      ATTRIBUTE GEMG seen=1 colo=1
      MATERIAL ArGAS
      MEDIUM sensitive isvol=1
      SHAPE box dx=gmtr_GEMGThk/2 dy=gmtr_GEMGW/2,
            dz=gmtr_GEMGL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GEMS
