      ENDBLOCK
      ! ---------------------------------------------------------------------------------- BCOO
      BLOCK BCOO   are the cooling rails/loops
      ATTRIBUTE BCOO seen=0 colo=2
      SHAPE box dx=0 dy=0 dz=0
      CREATE BRAI dz=tray_Length/2-tray_WallThk dx=toff_RailThck/2 dy=toff_RailWid/2
      CALL AgsReset 
      CALL agml_position_begin('BRAI') 
      %title = 'BRAI' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-toff_RailThck) 
      CALL agml_translate_x( %x ) 
      ag_y = real((tray_width/2-toff_RailWid/2-tray_WallThk)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BRAI') 
      %title = 'BRAI' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-toff_RailWid/2-toff_RailThck/2) 
      CALL agml_translate_x( %x ) 
      ag_y = real((tray_width/2-toff_RailThck/2-tray_WallThk)) 
      CALL agml_translate_y( %y ) 
      ag_alphaz = 90.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BRAI') 
      %title = 'BRAI' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-toff_RailThck) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(tray_width/2-toff_RailWid/2-tray_WallThk)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BRAI') 
      %title = 'BRAI' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-toff_RailWid/2-toff_RailThck/2) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(tray_width/2-toff_RailThck/2-tray_WallThk)) 
      CALL agml_translate_y( %y ) 
      ag_alphaz = 90.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BPIP rmax=toff_CoolOutR rmin=toff_CoolInnR dz=tray_Length/2-tray_WallThk
      CALL AgsReset 
      CALL agml_position_begin('BPIP') 
      %title = 'BPIP' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = real((tray_width/2-toff_RailThck-tray_WallThk-toff_CoolOutR)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BPIP') 
      %title = 'BPIP' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(tray_width/2-toff_RailThck-tray_WallThk-toff_CoolOutR)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BPIQ rmax=toff_CoolOutR rmin=toff_CoolInnR dz=tray_width/2-tray_WallThk-2.*toff_CoolOutR-toff_RailThck
      CALL AgsReset 
      CALL agml_position_begin('BPIQ') 
      %title = 'BPIQ' 
      %exname = 'POSITION' ! agml placement 
      %konly = 'MANY' 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(tray_Length/2-tray_WallThk-toff_RailThck-toff_CoolOutR) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'KONLY_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BWAT rmax=toff_CoolInnR rmin=0 dz=tray_Length/2-tray_WallThk
      CALL AgsReset 
      CALL agml_position_begin('BWAT') 
      %title = 'BWAT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = real((tray_width/2-toff_RailThck-tray_WallThk-toff_CoolOutR)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('BWAT') 
      %title = 'BWAT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-(tray_width/2-toff_RailThck-tray_WallThk-toff_CoolOutR)) 
      CALL agml_translate_y( %y ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE BWAT rmax=toff_CoolInnR rmin=0 dz=tray_width/2-tray_WallThk-2.*toff_CoolOutR-toff_RailThck
      CALL AgsReset 
      CALL agml_position_begin('BWAT') 
      %title = 'BWAT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(toff_ElecHgt-3.*toff_RailThck/2.-toff_CoolOutR) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(tray_Length/2-tray_WallThk-toff_RailThck-toff_CoolOutR) 
      CALL agml_translate_z( %z ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
