      ! ---------------------------------------------------------------------------------- GINO
      BLOCK GINO   is the GINO boards
      ATTRIBUTE GINO seen=1 colo=2
      MATERIAL G10
      SHAPE box dx=gmtr_GINThk/2 dy=gmtr_GINW/2,
            dz=gmtr_GINL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GSBB
      BLOCK GSBB   is the gas seal bonnet base
      ATTRIBUTE GSBB seen=1 colo=4
      MATERIAL Aluminium
      SHAPE box dx=gmtr_GSBThkb/2 dy=gmtr_GSBWb/2,
            dz=gmtr_GSBLb/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GNSF
      BLOCK GNSF   is the gas seal flange
      ATTRIBUTE GNSF seen=1 colo=3
      MATERIAL Aluminium
      SHAPE box dx=gmtr_GNFThk/2 dy=gmtr_GNFW/2,
            dz=gmtr_GNFL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GSBX
      BLOCK GSBX   is the gas seal bonnet cover top
      ATTRIBUTE GSBX seen=1 colo=5
      MATERIAL Aluminium
      SHAPE box dx=gmtr_GSThk/2 dy=gmtr_GSBTW/2,
            dz=gmtr_GSBTL/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GSBY
      BLOCK GSBY   is the gas seal bonnet side
      ATTRIBUTE GSBY seen=1 colo=5
      MATERIAL Aluminium
      SHAPE box dx=(gmtr_GSBSThk)/2 dy=(gmtr_GSBSW)/2,
            dz=(gmtr_GSBSL)/2
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- GSBZ
      BLOCK GSBZ   is the gas seal bonnet front/back
      ATTRIBUTE GSBZ seen=1 colo=5
      MATERIAL Aluminium
      SHAPE box dx=gmtr_GSBFBThk/2 dy=gmtr_GSBFBW/2,
            dz=gmtr_GSBFBL/2
