      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(toff_BPIPPosZ) 
      CALL agml_translate_z( %z ) 
      %rmin = real(toff_BPIPRmin) 
      %rmax = real(toff_BPIPRmax) 
      %dz = real(toff_BPIPLenZ/2) 
