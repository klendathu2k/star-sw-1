                            AgPosition  place;              
                            place.SetBlock("BFEE");              
                            place.SetMother("BTTC");              
                            /// Add daughter volume BFEE to mother BTTC              
                            place.TranslateX(toff.elechgt);              
                            /// Translate x = toff.elechgt              
                            place.TranslateZ(toff.elec01z-toff.eleclen/2);              
