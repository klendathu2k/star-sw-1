          AgBlock *EPDM::mInstance = 0;     
          AgBlock *EPDM::Instance(){        
                   if ( mInstance==0 ) mInstance = new EPDM();        
                   return mInstance;        
          }     
          void EPDM::Block( AgCreate create )     
          {         
                ///@addtogroup EPDM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=mcdt.srad;              
                            shape.par("rmax")=mcdt.lrad;              
                            shape.par("dz")=mcdt.thick;              
                            /// Shape Tube rmin=mcdt.srad rmax=mcdt.lrad dz=mcdt.thick               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EPDM;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on ss from 0 to 11 step=1           
                      for ( ss=0; (1>0)? (ss<=11):(ss>=11); ss+=1 )           
                      {              
                            rotz=-105-(30*ss);;              
                            _create = AgCreate("EPSS");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create EPSS                 
                                  Create("EPSS");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("EPSS");                 
                                  place.SetMother("EPDM");                 
                                  /// Add daughter volume EPSS to mother EPDM                 
                                  place.TranslateX(0);                 
                                  /// Translate x = 0                 
                                  place.TranslateY(0);                 
                                  /// Translate y = 0                 
                                  place.TranslateZ(0);                 
                                  /// Translate z = 0                 
                                  place.AlphaY(180);                 
                                  /// Rotate: AlphaY = 180                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaZ(rotz);                 
                                  /// Rotate: AlphaZ = rotz                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("EPSS"), place );                 
                            } // end placement of EPSS              
                      }           
                      END_OF_EPDM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block EPDM     
