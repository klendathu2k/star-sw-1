          AgBlock *EPDT::mInstance = 0;     
          AgBlock *EPDT::Instance(){        
                   if ( mInstance==0 ) mInstance = new EPDT();        
                   return mInstance;        
          }     
          void EPDT::Block( AgCreate create )     
          {         
                ///@addtogroup EPDT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material POLYSTYREN            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Material Cpolystyren isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Cpolystyren");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      if ( icolor==6 )           
                      {              
                            { AgAttribute attr = AgAttribute("None");                 
                                  attr.par("seen")=1;                 
                                  attr.par("colo")=6;                 
                                  attr.Inherit( AgBlock::previous() );                  
                                  _attribute = attr;                 
                            }              
                      }           
                      if ( icolor==2 )           
                      {              
                            { AgAttribute attr = AgAttribute("None");                 
                                  attr.par("seen")=1;                 
                                  attr.par("colo")=2;                 
                                  attr.Inherit( AgBlock::previous() );                  
                                  _attribute = attr;                 
                            }              
                      }           
                      if ( icolor==4 )           
                      {              
                            { AgAttribute attr = AgAttribute("None");                 
                                  attr.par("seen")=1;                 
                                  attr.par("colo")=4;                 
                                  attr.Inherit( AgBlock::previous() );                  
                                  _attribute = attr;                 
                            }              
                      }           
                      if ( icolor==3 )           
                      {              
                            { AgAttribute attr = AgAttribute("None");                 
                                  attr.par("seen")=1;                 
                                  attr.par("colo")=3;                 
                                  attr.Inherit( AgBlock::previous() );                  
                                  _attribute = attr;                 
                            }              
                      }           
                      {  AgShape shape = AgShape("Trap");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=0;              
                            shape.par("thet")=0;              
                            shape.par("phi")=0;              
                            shape.par("h1")=0;              
                            shape.par("bl1")=0;              
                            shape.par("tl1")=0;              
                            shape.par("alp1")=0;              
                            shape.par("h2")=0;              
                            shape.par("bl2")=0;              
                            shape.par("tl2")=0;              
                            shape.par("alp2")=0;              
                            /// Shape Trap dz=0 thet=0 phi=0 h1=0 bl1=0 tl1=0 alp1=0 h2=0 bl2=0 tl2=0 alp2=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EPDT;              
                            _stacker -> Build(this);              
                      }           
                      // cut cutgam = 0.00008 (deferred)           
                      // cut cutele = 0.001 (deferred)           
                      // cut bcute = 0.0001 (deferred)           
                      // cut cutneu = 0.001 (deferred)           
                      // cut cuthad = 0.001 (deferred)           
                      // cut cutmuo = 0.001 (deferred)           
                      // parameter birk1 = 1.000 (deferred)           
                      // parameter birk2 = 0.013 (deferred)           
                      // parameter birk3 = 9.6e-6 (deferred)           
                      // deferred module()->AddHit( "EPDT", "eloss", 0, 0, 100.0, "S");           
                      // deferred module()->AddHit( "EPDT", "tof", 0, 0, 10, "S");           
                      END_OF_EPDT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block EPDT     
    // ----------------------------------------------------------------------- geoctr
       void EpdmGeo0::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup EpdmGeo0_revision        
             ///@{           
                   /// Author: Sam, Jason and Prashanth           
             ///@}        
             ///@addtogroup EpdmGeo0_revision        
             ///@{           
                   /// Created: 03 Dec 2017           
             ///@}        
             AddBlock("EPDM", EPDM::Instance());        
             AddBlock("EPSS", EPSS::Instance());        
             AddBlock("EPDT", EPDT::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mcdt
++mcdt._index;
mcdt.version = 1.0;
// mcdt_docum.version = "Geometry version";
mcdt.onoff = 1;
// mcdt_docum.onoff = " 0 off, 1 on";
mcdt.x = 0.0;
