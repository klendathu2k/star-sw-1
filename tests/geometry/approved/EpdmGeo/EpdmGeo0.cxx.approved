          AgBlock *EPSS::mInstance = 0;     
          AgBlock *EPSS::Instance(){        
                   if ( mInstance==0 ) mInstance = new EPSS();        
                   return mInstance;        
          }     
          void EPSS::Block( AgCreate create )     
          {         
                ///@addtogroup EPSS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=mcdt.srad;              
                            shape.par("rmax")=mcdt.lrad;              
                            shape.par("phi1")=-15;              
                            shape.par("phi2")=15;              
                            /// Shape Tubs rmin=mcdt.srad rmax=mcdt.lrad phi1=-15 phi2=15               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EPSS;              
                            _stacker -> Build(this);              
                      }           
                      icolor=2;;           
                      _create = AgCreate("EPDT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create EPDT              
                            Create("EPDT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("EPDT");              
                            place.SetMother("EPSS");              
                            /// Add daughter volume EPDT to mother EPSS              
                            place.TranslateX(cdtd.x);              
                            /// Translate x = cdtd.x              
                            place.TranslateY(-cdtd.y);              
                            /// Translate y = -cdtd.y              
                            place.TranslateZ(cdtd.z);              
                            /// Translate z = cdtd.z              
                            place.par("dz")=cdtd.dz;              
                            place.par("thet")=0.0;              
                            place.par("phi")=0.0;              
                            place.par("h1")=cdtd.h;              
                            place.par("h2")=cdtd.h;              
                            place.par("bl1")=cdtd.bl;              
                            place.par("bl2")=cdtd.bl;              
                            place.par("tl1")=cdtd.tl;              
                            place.par("tl2")=cdtd.tl;              
                            place.par("alp1")=cdtd.alp;              
                            place.par("alp2")=cdtd.alp;              
                            place.AlphaZ(-90-cdtd.rot);              
                            /// Rotate: AlphaZ = -90-cdtd.rot              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("EPDT"), place );              
                      } // end placement of EPDT           
                      icolor=6;;           
                      _create = AgCreate("EPDT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create EPDT              
                            Create("EPDT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("EPDT");              
                            place.SetMother("EPSS");              
                            /// Add daughter volume EPDT to mother EPSS              
                            place.TranslateX(cdtc.x);              
                            /// Translate x = cdtc.x              
                            place.TranslateY(-cdtc.y);              
                            /// Translate y = -cdtc.y              
                            place.TranslateZ(cdtc.z);              
                            /// Translate z = cdtc.z              
                            place.par("dz")=cdtc.dz;              
                            place.par("thet")=0.0;              
                            place.par("phi")=0.0;              
                            place.par("h1")=cdtc.h;              
                            place.par("h2")=cdtc.h;              
                            place.par("bl1")=cdtc.bl;              
                            place.par("bl2")=cdtc.bl;              
                            place.par("tl1")=cdtc.tl;              
                            place.par("tl2")=cdtc.tl;              
                            place.par("alp1")=cdtc.alp;              
                            place.par("alp2")=cdtc.alp;              
                            place.AlphaZ(-90-cdtc.rot);              
                            /// Rotate: AlphaZ = -90-cdtc.rot              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("EPDT"), place );              
                      } // end placement of EPDT           
                      /// Loop on tt from 2 to 31 step=1           
                      for ( tt=2; (1>0)? (tt<=31):(tt>=31); tt+=1 )           
                      {              
                            icolor=4;;              
                            _create = AgCreate("EPDT");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create EPDT                 
                                  Create("EPDT");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("EPDT");                 
                                  place.SetMother("EPSS");                 
                                  /// Add daughter volume EPDT to mother EPSS                 
                                  place.TranslateX(cdtb.x[int(tt)-1]);                 
                                  /// Translate x = cdtb.x[int(tt)-1]                 
                                  place.TranslateY(-cdtb.y[int(tt)-1]);                 
                                  /// Translate y = -cdtb.y[int(tt)-1]                 
                                  place.TranslateZ((0.6-cdtb.dz[int(tt)-1]));                 
                                  /// Translate z = (0.6-cdtb.dz[int(tt)-1])                 
                                  place.par("dz")=cdtb.dz[int(tt)-1];                 
                                  place.par("thet")=0.0;                 
                                  place.par("phi")=0.0;                 
                                  place.par("h1")=cdtb.h[int(tt)-1];                 
                                  place.par("h2")=cdtb.h[int(tt)-1];                 
                                  place.par("bl1")=cdtb.bl[int(tt)-1];                 
                                  place.par("bl2")=cdtb.bl[int(tt)-1];                 
                                  place.par("tl1")=cdtb.tl[int(tt)-1];                 
                                  place.par("tl2")=cdtb.tl[int(tt)-1];                 
                                  place.par("alp1")=cdtb.alp[int(tt)-1];                 
                                  place.par("alp2")=cdtb.alp[int(tt)-1];                 
                                  place.AlphaZ(-90+cdtb.rot[int(tt)-1]);                 
                                  /// Rotate: AlphaZ = -90+cdtb.rot[int(tt)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("EPDT"), place );                 
                            } // end placement of EPDT              
                            icolor=3;;              
                            _create = AgCreate("EPDT");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create EPDT                 
                                  Create("EPDT");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("EPDT");                 
                                  place.SetMother("EPSS");                 
                                  /// Add daughter volume EPDT to mother EPSS                 
                                  place.TranslateX(cdta.x[int(tt)-1]);                 
                                  /// Translate x = cdta.x[int(tt)-1]                 
                                  place.TranslateY(-cdta.y[int(tt)-1]);                 
                                  /// Translate y = -cdta.y[int(tt)-1]                 
                                  place.TranslateZ(cdta.z);                 
                                  /// Translate z = cdta.z                 
                                  place.par("dz")=cdta.dz[int(tt)-1];                 
                                  place.par("thet")=0.0;                 
                                  place.par("phi")=0.0;                 
                                  place.par("h1")=cdta.h[int(tt)-1];                 
                                  place.par("h2")=cdta.h[int(tt)-1];                 
                                  place.par("bl1")=cdta.bl[int(tt)-1];                 
                                  place.par("bl2")=cdta.bl[int(tt)-1];                 
                                  place.par("tl1")=cdta.tl[int(tt)-1];                 
                                  place.par("tl2")=cdta.tl[int(tt)-1];                 
                                  place.par("alp1")=cdta.alp[int(tt)-1];                 
                                  place.par("alp2")=cdta.alp[int(tt)-1];                 
                                  place.AlphaZ(-90+cdta.rot[int(tt)-1]);                 
                                  /// Rotate: AlphaZ = -90+cdta.rot[int(tt)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("EPDT"), place );                 
                            } // end placement of EPDT              
                      }           
                      END_OF_EPSS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block EPSS     
