             _create = AgCreate("EPDM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create EPDM           
                   Create("EPDM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("EPDM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume EPDM to mother CAVE           
                   place.TranslateX(mcdt.x);           
                   /// Translate x = mcdt.x           
                   place.TranslateY(mcdt.y);           
                   /// Translate y = mcdt.y           
                   place.TranslateZ(mcdt.z[int(1)-1]);           
                   /// Translate z = mcdt.z[int(1)-1]           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   place.AlphaY(0);           
                   /// Rotate: AlphaY = 0           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("EPDM"), place );           
             } // end placement of EPDM        
             {           
                   AgPosition  place;           
                   place.SetBlock("EPDM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume EPDM to mother CAVE           
                   place.TranslateX(mcdt.x);           
                   /// Translate x = mcdt.x           
                   place.TranslateY(mcdt.y);           
                   /// Translate y = mcdt.y           
                   place.TranslateZ(mcdt.z[int(2)-1]);           
                   /// Translate z = mcdt.z[int(2)-1]           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   place.AlphaY(180);           
                   /// Rotate: AlphaY = 180           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("EPDM"), place );           
             } // end placement of EPDM        
