      MODULE EpdmGeo0   Event Plane Detector (Full geometry)
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author Sam, Jason and Prashanth
      Created 03 Dec 2017
      +CDE,agecom, gconst, gcunit.
      CONTENT EPDM,
      EPSS,
      EPDT
      real *4 rotz

      Integer *4 tt,      ss,      icolor

      STRUCTURE mcdt { version,int onoff,x,y,z(2),thick,srad,lrad}
      STRUCTURE cdta { version,int onoff,x(31),y(31),z,rot(31),dz(31),h(31),bl(31),
            tl(31),alp(31)}
      STRUCTURE cdtb { version,int onoff,x(31),y(31),z,rot(31),dz(31),h(31),bl(31),
            tl(31),alp(31)}
      STRUCTURE cdtc { version,int onoff,x,y,z,rot,dz,h,bl,tl,alp}
      STRUCTURE cdtd { version,int onoff,x,y,z,rot,dz,h,bl,tl,alp}
      FILL mcdt		! EPD geometry
      Version = 1.0 ! Geometry version
      onoff = 1 !  0 off, 1 on
      x = 0.0 ! x cdt of mother
      y = 0.0 ! y cdt of mother
      z  = {  -374.0,   374.0} !  Distance from center of star (prototype dist, not correct)
      thick = 1.2/2 ! thickness of detector
      srad = 3.0 ! check inner radius
      lrad = 100 ! check outer radius
      ENDFILL
      FILL cdta		!  Corrdiante of a single sectors
      version = 1.0 ! None
      onoff = 1 ! None
      y  = {       0.0,    1.3875,   -1.3875,    2.0125, 
               -2.0125,      2.72,     -2.72,    3.5075, 
