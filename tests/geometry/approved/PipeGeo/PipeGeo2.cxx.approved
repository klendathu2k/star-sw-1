                            shape.Rmin(0)=0.7875*inch;              
                            shape.Rmin(1)=0.7875*inch;              
                            shape.Rmin(2)=0.7875*inch;              
                            shape.Rmin(3)=0.7875*inch;              
                            shape.Rmin(4)=0.7875*inch;              
                            shape.Rmin(5)=0.7875*inch;              
                            shape.Rmax(0)=0.7875*inch+0.055*inch;              
                            shape.Rmax(1)=0.7875*inch+0.055*inch;              
                            shape.Rmax(2)=0.7875*inch+0.065*inch;              
                            shape.Rmax(3)=0.7875*inch+0.065*inch;              
                            shape.Rmax(4)=0.7875*inch+0.5875*inch;              
                            shape.Rmax(5)=0.7875*inch+0.5875*inch;              
                            /// Shape Pcon phi1=0 dphi=360 nz=6               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PALI;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PALI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PALI     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PALJ::mInstance = 0;     
          AgBlock *PALJ::Instance(){        
                   if ( mInstance==0 ) mInstance = new PALJ();        
                   return mInstance;        
          }     
          void PALJ::Block( AgCreate create )     
          {         
                ///@addtogroup PALJ_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PALJ");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=8;              
                            shape.Z(0)=55.71*inch;              
                            shape.Z(1)=56.21*inch;              
                            shape.Z(2)=56.21*inch;              
                            shape.Z(3)=64.71*inch;              
                            shape.Z(4)=79.71*inch;              
                            shape.Z(5)=109.477*inch;              
                            shape.Z(6)=109.477*inch;              
                            shape.Z(7)=110.237*inch;              
                            shape.Rmin(0)=0.7875*inch;              
                            shape.Rmin(1)=0.7875*inch;              
                            shape.Rmin(2)=0.7875*inch;              
                            shape.Rmin(3)=0.7875*inch;              
                            shape.Rmin(4)=1.5*inch;              
                            shape.Rmin(5)=1.5*inch;              
                            shape.Rmin(6)=1.5*inch;              
                            shape.Rmin(7)=1.5*inch;              
                            shape.Rmax(0)=0.7875*inch+0.5775*inch;              
                            shape.Rmax(1)=0.7875*inch+0.5775*inch;              
                            shape.Rmax(2)=0.7875*inch+0.049*inch;              
                            shape.Rmax(3)=0.7875*inch+0.049*inch;              
                            shape.Rmax(4)=1.5*inch+0.049*inch;              
                            shape.Rmax(5)=1.5*inch+0.049*inch;              
                            shape.Rmax(6)=1.5*inch+0.8125*inch;              
                            shape.Rmax(7)=1.5*inch+0.8125*inch;              
                            /// Shape Pcon phi1=0 dphi=360 nz=8               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PALJ;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PALJ:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PALJ     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PALK::mInstance = 0;     
          AgBlock *PALK::Instance(){        
                   if ( mInstance==0 ) mInstance = new PALK();        
                   return mInstance;        
          }     
          void PALK::Block( AgCreate create )     
          {         
                ///@addtogroup PALK_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PALK");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=6;              
                            shape.Z(0)=110.237*inch;              
                            shape.Z(1)=110.997*inch;              
                            shape.Z(2)=110.997*inch;              
                            shape.Z(3)=158.241*inch;              
                            shape.Z(4)=158.241*inch;              
                            shape.Z(5)=159.000*inch;              
                            shape.Rmin(0)=1.5*inch;              
                            shape.Rmin(1)=1.5*inch;              
                            shape.Rmin(2)=1.5*inch;              
                            shape.Rmin(3)=1.5*inch;              
                            shape.Rmin(4)=1.5*inch;              
                            shape.Rmin(5)=1.5*inch;              
                            shape.Rmax(0)=1.5*inch+0.8125*inch;              
                            shape.Rmax(1)=1.5*inch+0.8125*inch;              
                            shape.Rmax(2)=1.5*inch+0.049*inch;              
                            shape.Rmax(3)=1.5*inch+0.049*inch;              
                            shape.Rmax(4)=1.5*inch+0.8125*inch;              
                            shape.Rmax(5)=1.5*inch+0.8125*inch;              
                            /// Shape Pcon phi1=0 dphi=360 nz=6               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PALK;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PALK:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PALK     
    // ----------------------------------------------------------------------- geoctr
       void PipeGeo2::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PipeGeo2_revision        
             ///@{           
                   /// Author: Amilkar Quintero           
             ///@}        
             ///@addtogroup PipeGeo2_revision        
             ///@{           
                   /// Created: 11/Jan/2013           
             ///@}        
             AddBlock("PIPE", PIPE::Instance());        
             AddBlock("PALH", PALH::Instance());        
             AddBlock("PALQ", PALQ::Instance());        
             AddBlock("PALR", PALR::Instance());        
             AddBlock("PALS", PALS::Instance());        
             AddBlock("PBES", PBES::Instance());        
             AddBlock("PALI", PALI::Instance());        
             AddBlock("PALJ", PALJ::Instance());        
             AddBlock("PALK", PALK::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipv
++pipv._index;
pipv.version = 3.0;
// pipv_docum.version = "3.0 version of the beam pipe";
pipv.config = 3;
// pipv_docum.config = "Configuration is three";
PIPV.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.version = 3.0;
// pipg_docum.version = "Default position and geometry";
pipg.vacdens = 1.0e-5;
// pipg_docum.vacdens = "Vaccuum density... needs to be verified";
pipg.xoffset = 0.0;
// pipg_docum.xoffset = "Default x position ";
pipg.yoffset = 0.0;
// pipg_docum.yoffset = "Default y position ";
pipg.zoffset = 0.0;
// pipg_docum.zoffset = "Default z position ";
pipg.zoffber = 7.875*inch;
// pipg_docum.zoffber = "Offset of beryllium as per drawing";
PIPG.fill();
        
             _create = AgCreate("PIPE");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPE           
                   Create("PIPE");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIPE");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume PIPE to mother CAVE           
                   place.TranslateX(pipg.xoffset);           
                   /// Translate x = pipg.xoffset           
                   place.TranslateY(pipg.yoffset);           
                   /// Translate y = pipg.yoffset           
                   place.TranslateZ(pipg.zoffset);           
                   /// Translate z = pipg.zoffset           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PIPE"), place );           
             } // end placement of PIPE        
       }; // PipeGeo2     
 }; // namespace PipeGeo2  
 