          void TARM::Block( AgCreate create )     
          {         
                ///@addtogroup TARM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Material TVacuum dens=(_material.par("dens")) *vacuum absl=(_material.par("absl")) /vacuum radl=(_material.par("radl")) /vacuum            
                      { AgMaterial &mat = AgMaterial::Get("Tvacuum");              
                            mat.par("dens")=(_material.par("dens"))*vacuum;              
                            mat.par("absl")=(_material.par("absl"))/vacuum;              
                            mat.par("radl")=(_material.par("radl"))/vacuum;              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("TARM");              
                            attr.par("seen")=0;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=rtot;              
                            shape.par("dz")=ztot;              
                            /// Shape Tube rmin=0 rmax=rtot dz=ztot               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TARM;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HLDR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HLDR              
                            Create("HLDR");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HLDR");              
                            place.SetMother("TARM");              
                            /// Add daughter volume HLDR to mother TARM              
                            place.TranslateX(hldg.xoffset);              
                            /// Translate x = hldg.xoffset              
                            place.TranslateY(hldg.yoffset);              
                            /// Translate y = hldg.yoffset              
                            place.TranslateZ(hldg.zoffset);              
                            /// Translate z = hldg.zoffset              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("HLDR"), place );              
                      } // end placement of HLDR           
                      _create = AgCreate("RING");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create RING              
                            Create("RING");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("RING");              
                            place.SetMother("TARM");              
                            /// Add daughter volume RING to mother TARM              
                            place.TranslateX(rngg.xoffset);              
                            /// Translate x = rngg.xoffset              
                            place.TranslateY(rngg.yoffset);              
                            /// Translate y = rngg.yoffset              
                            place.TranslateZ(rngg.zoffset);              
                            /// Translate z = rngg.zoffset              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("RING"), place );              
                      } // end placement of RING           
                      _create = AgCreate("FOIL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FOIL              
                            Create("FOIL");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FOIL");              
                            place.SetMother("TARM");              
                            /// Add daughter volume FOIL to mother TARM              
                            place.TranslateX(tflg.xoffset);              
                            /// Translate x = tflg.xoffset              
                            place.TranslateY(tflg.yoffset);              
                            /// Translate y = tflg.yoffset              
                            place.TranslateZ(tflg.zoffset);              
                            /// Translate z = tflg.zoffset              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("FOIL"), place );              
                      } // end placement of FOIL           
                      _create = AgCreate("RODM");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create RODM              
                            Create("RODM");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("RODM");              
                            place.SetMother("TARM");              
                            /// Add daughter volume RODM to mother TARM              
                            place.TranslateX(rodg.xoffset);              
                            /// Translate x = rodg.xoffset              
                            place.TranslateY(rodg.yoffset);              
                            /// Translate y = rodg.yoffset              
                            place.TranslateZ(rodg.zoffset);              
                            /// Translate z = rodg.zoffset              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("RODM"), place );              
                      } // end placement of RODM           
                      _create = AgCreate("RODM");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create RODM              
                            Create("RODM");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("RODM");              
                            place.SetMother("TARM");              
                            /// Add daughter volume RODM to mother TARM              
                            place.TranslateX(-rodg.xoffset);              
                            /// Translate x = -rodg.xoffset              
                            place.TranslateY(rodg.yoffset);              
                            /// Translate y = rodg.yoffset              
                            place.TranslateZ(rodg.zoffset);              
                            /// Translate z = rodg.zoffset              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("RODM"), place );              
                      } // end placement of RODM           
                      END_OF_TARM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TARM     
