          void FOIL::Block( AgCreate create )     
          {         
                ///@addtogroup FOIL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Gold            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Gold");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FOIL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=8;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trap");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dz")=tflg.thickness/2;              
                            shape.par("thet")=0.0;              
                            shape.par("phi")=0.0;              
                            shape.par("h1")=tflg.height/2;              
                            shape.par("bl1")=tflg.baselength/2;              
                            shape.par("tl1")=tflg.toplength/2;              
                            shape.par("alp1")=0;              
                            shape.par("h2")=tflg.height/2;              
                            shape.par("bl2")=tflg.baselength/2;              
                            shape.par("tl2")=tflg.toplength/2;              
                            shape.par("alp2")=0;              
                            /// Shape Trap dz=tflg.thickness/2 thet=0.0 phi=0.0 h1=tflg.height/2 bl1=tflg.baselength/2 tl1=tflg.toplength/2 alp1=0 h2=tflg.height/2 bl2=tflg.baselength/2 tl2=tflg.toplength/2 alp2=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FOIL;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FOIL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FOIL     
