          void HLDR::Block( AgCreate create )     
          {         
                ///@addtogroup HLDR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HLDR");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=hldg.irad;              
                            shape.par("rmax")=hldg.orad;              
                            shape.par("phi1")=180;              
                            shape.par("phi2")=0;              
                            shape.par("dz")=hldg.width/2;              
                            /// Shape Tubs rmin=hldg.irad rmax=hldg.orad phi1=180 phi2=0 dz=hldg.width/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HLDR;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_HLDR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HLDR     
