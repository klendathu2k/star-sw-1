    // ----------------------------------------------------------------------- geoctr
       void TargGeo::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup TargGeo_revision        
             ///@{           
                   /// Created: 5 Sept 2018           
             ///@}        
             ///@addtogroup TargGeo_revision        
             ///@{           
                   /// Author: Samuel Heppelmann           
             ///@}        
             AddBlock("TARM", TARM::Instance());        
             AddBlock("HLDR", HLDR::Instance());        
             AddBlock("RING", RING::Instance());        
             AddBlock("FOIL", FOIL::Instance());        
             AddBlock("RODM", RODM::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill targ
++targ._index;
targ.version = 1.0;
// targ_docum.version = " Geometry Version for 2018";
targ.onoff = 1;
// targ_docum.onoff = " 0 for Off, 1 for On ";
targ.xdis = 0;
// targ_docum.xdis = " x cord from center in star";
targ.ydis = 0;
// targ_docum.ydis = " y cord from center in star";
targ.zdis = 201;
// targ_docum.zdis = " z cord from center in star";
TARG.fill();
        
             /// USE targ _index=1;        
             TARG.use( __targ__index__ = 1 );
        
             if ( targ.version==1.0 )        
             {           
                   // ---------------------------------------------------------------------------------------------------           
                   // Fill tflg
++tflg._index;
tflg.thickness = 0.025;
// tflg_docum.thickness = "0.25 mm thickness";
tflg.height = 0.635;
// tflg_docum.height = "height of rectangular target";
tflg.baselength = 5.050;
// tflg_docum.baselength = "trap bottom length of target";
tflg.toplength = 6.106;
// tflg_docum.toplength = "trap top length of target";
tflg.xoffset = 0;
// tflg_docum.xoffset = " xoffset from center of TARG";
tflg.yoffset = -2.319;
// tflg_docum.yoffset = " yoffset from center of TARG";
tflg.zoffset = 0;
// tflg_docum.zoffset = " zoffset from center of TARG";
TFLG.fill();
           
             }        
             // ---------------------------------------------------------------------------------------------------        
             // Fill hldg
++hldg._index;
hldg.irad = 3.136;
// hldg_docum.irad = "inner radius of ring";
hldg.orad = 3.651;
// hldg_docum.orad = "outer radius of ring";
hldg.width = 0.645;
// hldg_docum.width = "width of ring";
hldg.angle = 3.14;
// hldg_docum.angle = "angle that the ring covers of full circle (half circle)";
hldg.xoffset = 0;
// hldg_docum.xoffset = " xoffset from center of TARG";
hldg.yoffset = 0;
// hldg_docum.yoffset = " yoffset from center of TARG";
hldg.zoffset = -0.318;
// hldg_docum.zoffset = " zoffset from center of TARG";
HLDG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill rngg
++rngg._index;
rngg.irad = 3.136;
// rngg_docum.irad = "inner radius of ring";
rngg.orad = 3.651;
// rngg_docum.orad = "outer radius of ring";
rngg.width = 0.635;
// rngg_docum.width = "width of ring";
rngg.xoffset = 0;
// rngg_docum.xoffset = " xoffset from center of TARG";
rngg.yoffset = 0;
// rngg_docum.yoffset = " yoffset from center of TARG";
rngg.zoffset = 180.318;
// rngg_docum.zoffset = " zoffset from center of TARG";
RNGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill rodg
++rodg._index;
rodg.rad = 0.238;
// rodg_docum.rad = "radius of rod";
rodg.length = 180;
// rodg_docum.length = "length of rod (estimate)";
rodg.xoffset = 0.953;
// rodg_docum.xoffset = " xoffset from center of TARG";
rodg.yoffset = -3.256;
// rodg_docum.yoffset = " yoffset from center of TARG";
rodg.zoffset = 90;
// rodg_docum.zoffset = " zoffset from center of TARG";
RODG.fill();
        
             /// USE hldg _index=1;        
             HLDG.use( __hldg__index__ = 1 );
        
             rtot=hldg.orad;;        
             /// USE rodg _index=1;        
             RODG.use( __rodg__index__ = 1 );
        
             ztot=rodg.length+hldg.width+rngg.width;;        
             /// Component Au	a=196.97	z=79	w=1        
             /// Mixture Gold dens=19.30        
             {  AgMaterial &mix = AgMaterial::Get("Gold");           
                   mix.Component("Au",196.97,79,1);           
                   mix.par("dens")=19.30;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("TARM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create TARM           
                   Create("TARM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("TARM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume TARM to mother CAVE           
                   place.TranslateX(targ.xdis);           
                   /// Translate x = targ.xdis           
                   place.TranslateY(targ.ydis);           
                   /// Translate y = targ.ydis           
                   place.TranslateZ(targ.zdis);           
                   /// Translate z = targ.zdis           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("TARM"), place );           
             } // end placement of TARM        
       }; // TargGeo     
 }; // namespace TargGeo  
 