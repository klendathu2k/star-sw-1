          void PIPE::Block( AgCreate create )     
          {         
                ///@addtogroup PIPE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PIPE");              
                            attr.par("seen")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=4;              
                            shape.Z(0)=-189*inch;              
                            shape.Z(1)=-79.71*inch;              
                            shape.Z(2)=-64.71*inch;              
                            shape.Z(3)=-55.71*inch;              
                            shape.Rmin(0)=0;              
                            shape.Rmin(1)=0;              
                            shape.Rmin(2)=0;              
                            shape.Rmin(3)=0;              
                            shape.Rmax(0)=1.5*inch+0.8125*inch;              
                            shape.Rmax(1)=1.5*inch+0.8125*inch;              
                            shape.Rmax(2)=0.7875*inch+0.5875*inch;              
                            shape.Rmax(3)=0.7875*inch+0.5875*inch;              
                            /// Shape Pcon phi1=0 dphi=360 nz=4               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIPE;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PIHE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIHE              
                            Create("PIHE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIHE");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PIHE to mother PIPE              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PIHE"), place );              
                      } // end placement of PIHE           
                      _create = AgCreate("PALQ");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PALQ              
                            Create("PALQ");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PALQ");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PALQ to mother PIPE              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PALQ"), place );              
                      } // end placement of PALQ           
                      _create = AgCreate("PALR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PALR              
                            Create("PALR");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PALR");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PALR to mother PIPE              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PALR"), place );              
                      } // end placement of PALR           
                      _create = AgCreate("SSCF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCF              
                            Create("SSCF");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCF");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume SSCF to mother PIPE              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-55.71*inch-0.125*inch);              
                            /// Translate z = -55.71*inch-0.125*inch              
                            _stacker -> Position( AgBlock::Find("SSCF"), place );              
                      } // end placement of SSCF           
                      _create = AgCreate("SSCG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCG              
                            Create("SSCG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCG");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume SSCG to mother PIPE              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-189*inch+0.38/2*inch);              
                            /// Translate z = -189*inch+0.38/2*inch              
                            _stacker -> Position( AgBlock::Find("SSCG"), place );              
                      } // end placement of SSCG           
                      _create = AgCreate("SSCG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCG              
                            Create("SSCG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCG");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume SSCG to mother PIPE              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-159*inch+0.38/2*inch);              
                            /// Translate z = -159*inch+0.38/2*inch              
                            _stacker -> Position( AgBlock::Find("SSCG"), place );              
                      } // end placement of SSCG           
                      _create = AgCreate("SSCG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCG              
                            Create("SSCG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCG");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume SSCG to mother PIPE              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-159*inch-0.38/2*inch);              
                            /// Translate z = -159*inch-0.38/2*inch              
                            _stacker -> Position( AgBlock::Find("SSCG"), place );              
                      } // end placement of SSCG           
                      END_OF_PIPE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIPE     
