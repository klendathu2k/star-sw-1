                            shape.Rmin(9)=0;              
                            shape.Rmax(0)=0.7875*inch+0.5875*inch;              
                            shape.Rmax(1)=0.7875*inch+0.5875*inch;              
                            shape.Rmax(2)=0.7875*inch+0.7;              
                            shape.Rmax(3)=0.7875*inch+0.7;              
                            shape.Rmax(4)=0.7875*inch+0.055*inch;              
                            shape.Rmax(5)=0.7875*inch+0.055*inch;              
                            shape.Rmax(6)=0.7875*inch+0.7;              
                            shape.Rmax(7)=0.7875*inch+0.7;              
                            shape.Rmax(8)=0.7875*inch+0.5875*inch;              
                            shape.Rmax(9)=0.7875*inch+0.5875*inch;              
                            /// Shape Pcon phi1=0 dphi=360 nz=10               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIPI;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PIHI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIHI              
                            Create("PIHI");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIHI");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PIHI to mother PIPI              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PIHI"), place );              
                      } // end placement of PIHI           
                      _create = AgCreate("PALS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PALS              
                            Create("PALS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PALS");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PALS to mother PIPI              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PALS"), place );              
                      } // end placement of PALS           
                      _create = AgCreate("PBES");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PBES              
                            Create("PBES");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PBES");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PBES to mother PIPI              
                            place.TranslateZ(pipg.zoffber);              
                            /// Translate z = pipg.zoffber              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PBES"), place );              
                      } // end placement of PBES           
                      _create = AgCreate("PALI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PALI              
                            Create("PALI");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PALI");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PALI to mother PIPI              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PALI"), place );              
                      } // end placement of PALI           
                      _create = AgCreate("SSCF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCF              
                            Create("SSCF");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCF");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume SSCF to mother PIPI              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-55.71*inch+0.125*inch);              
                            /// Translate z = -55.71*inch+0.125*inch              
                            _stacker -> Position( AgBlock::Find("SSCF"), place );              
                      } // end placement of SSCF           
                      _create = AgCreate("SSCF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create SSCF              
                            Create("SSCF");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("SSCF");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume SSCF to mother PIPI              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(+55.71*inch-0.125*inch);              
                            /// Translate z = +55.71*inch-0.125*inch              
                            _stacker -> Position( AgBlock::Find("SSCF"), place );              
                      } // end placement of SSCF           
                      END_OF_PIPI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIPI     
