          void PRWS::Block( AgCreate create )     
          {         
                ///@addtogroup PRWS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PRWB");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=piwa.s2outr;              
                            shape.par("rmax")=piwa.riboutr;              
                            shape.par("dz")=piwa.ribnum*piwa.ribspa/2.;              
                            /// Shape Tube rmin=piwa.s2outr rmax=piwa.riboutr dz=piwa.ribnum*piwa.ribspa/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PRWS;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PRWD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PRWD              
                            Create("PRWD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PRWD");              
                            place.SetMother("PRWS");              
                            /// Add daughter volume PRWD to mother PRWS              
                            _stacker -> Position( AgBlock::Find("PRWD"), place );              
                      } // end placement of PRWD           
                      END_OF_PRWS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PRWS     
