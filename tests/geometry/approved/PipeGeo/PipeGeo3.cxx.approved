    // ----------------------------------------------------------------------- geoctr
       void PipeGeo3::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PipeGeo3_revision        
             ///@{           
                   /// Author: Amilkar Quintero and FV           
             ///@}        
             ///@addtogroup PipeGeo3_revision        
             ///@{           
                   /// Created: 4/Apr/2013           
             ///@}        
             AddBlock("PIPE", PIPE::Instance());        
             AddBlock("PIHE", PIHE::Instance());        
             AddBlock("PALQ", PALQ::Instance());        
             AddBlock("PALR", PALR::Instance());        
             AddBlock("PIPI", PIPI::Instance());        
             AddBlock("PIHI", PIHI::Instance());        
             AddBlock("PALS", PALS::Instance());        
             AddBlock("PBES", PBES::Instance());        
             AddBlock("PALI", PALI::Instance());        
             AddBlock("SSCF", SSCF::Instance());        
             AddBlock("SSCG", SSCG::Instance());        
             AddBlock("PIPW", PIPW::Instance());        
             AddBlock("PIHW", PIHW::Instance());        
             AddBlock("PALJ", PALJ::Instance());        
             AddBlock("PALK", PALK::Instance());        
             AddBlock("PIPA", PIPA::Instance());        
             AddBlock("PIPB", PIPB::Instance());        
             AddBlock("PVPB", PVPB::Instance());        
             AddBlock("PIPC", PIPC::Instance());        
             AddBlock("PVPC", PVPC::Instance());        
             AddBlock("PIWA", PIWA::Instance());        
             AddBlock("PIWB", PIWB::Instance());        
             AddBlock("PVWB", PVWB::Instance());        
             AddBlock("PIWC", PIWC::Instance());        
             AddBlock("PVWC", PVWC::Instance());        
             AddBlock("PRIS", PRIS::Instance());        
             AddBlock("PRID", PRID::Instance());        
             AddBlock("PRIB", PRIB::Instance());        
             AddBlock("PRWS", PRWS::Instance());        
             AddBlock("PRWD", PRWD::Instance());        
             AddBlock("PRWB", PRWB::Instance());        
             AddBlock("PFLT", PFLT::Instance());        
             AddBlock("PFLO", PFLO::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipv
++pipv._index;
pipv.version = 3.0;
// pipv_docum.version = "3.0 version of the beam pipe";
pipv.pipeconfig = 3;
// pipv_docum.pipeconfig = "Configuration is three";
pipv.pipeflag = 1;
// pipv_docum.pipeflag = "Configuration is three";
PIPV.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.version = 3.0;
// pipg_docum.version = "Default position and geometry";
pipg.vacdens = 1.25e-8;
// pipg_docum.vacdens = "Vacuum density... needs to be verified";
pipg.xoffset = 0.0;
// pipg_docum.xoffset = "Default x position ";
pipg.yoffset = 0.0;
// pipg_docum.yoffset = "Default y position ";
pipg.zoffset = 0.0;
// pipg_docum.zoffset = "Default z position ";
pipg.zoffber = 7.875*inch;
// pipg_docum.zoffber = "Offset of beryllium as per drawing";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipa
++pipa._index;
pipa.config = 1;
// pipa_docum.config = " both material and geo params ";
pipa.s2innr = 3.81;
// pipa_docum.s2innr = " second Aluminum section inner radius ";
pipa.s2outr = 3.937;
// pipa_docum.s2outr = " second Aluminum section outer radius ";
pipa.s2leng = 31.42/2.0;
// pipa_docum.s2leng = " second Aluminum section half length ";
pipa.s3innr = 3.81;
// pipa_docum.s3innr = " Transition Stub Aluminum section inner radius ";
pipa.s3outr = 3.937;
// pipa_docum.s3outr = " Transition Stub Aluminum section outer radius ";
pipa.s3leng = 1.0;
// pipa_docum.s3leng = " Transition Stub Aluminum section half length ";
pipa.s4innr = 6.20;
// pipa_docum.s4innr = " Large OD Aluminum section inner radius ";
pipa.s4outr = 6.35;
// pipa_docum.s4outr = " Large OD Aluminum section outer radius ";
pipa.s4leng = 101.0-12.5;
// pipa_docum.s4leng = " Large OD Aluminum section half length ";
pipa.conelen = 25.0;
// pipa_docum.conelen = " length of the Bell Reducer Cone ";
pipa.flange1t = 2.0;
// pipa_docum.flange1t = " flange SET half thickness ";
pipa.flange1r = 5.85;
// pipa_docum.flange1r = " flange outer radius ";
pipa.ribnum = 8;
// pipa_docum.ribnum = " number of Ribs ";
pipa.ribspa = 1.75;
// pipa_docum.ribspa = " spacing between Ribs ";
pipa.ribthk = 0.05;
// pipa_docum.ribthk = " Rib half thickness ";
pipa.riboutr = 4.8;
// pipa_docum.riboutr = " Rib Outer Radius ";
pipa.ribcent = 495.0;
// pipa_docum.ribcent = " Rib Set center  ";
PIPA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill piwa
++piwa._index;
piwa.config = 1;
// piwa_docum.config = " both material and geo params ";
piwa.s2innr = 3.81;
// piwa_docum.s2innr = " second Aluminum section inner radius ";
piwa.s2outr = 3.937;
// piwa_docum.s2outr = " second Aluminum section outer radius ";
piwa.s2leng = 18.00;
// piwa_docum.s2leng = " second Aluminum section half length ";
piwa.s3innr = 3.81;
// piwa_docum.s3innr = " Transition Stub Aluminum section inner radius ";
piwa.s3outr = 3.937;
// piwa_docum.s3outr = " Transition Stub Aluminum section outer radius ";
piwa.s3leng = 1.0;
// piwa_docum.s3leng = " Transition Stub Aluminum section half length ";
piwa.s4innr = 6.20;
// piwa_docum.s4innr = " Large OD Aluminum section inner radius ";
piwa.s4outr = 6.35;
// piwa_docum.s4outr = " Large OD Aluminum section outer radius ";
piwa.s4leng = 139.57*2;
// piwa_docum.s4leng = " Large OD Aluminum section length ";
piwa.conelen = 25.0;
// piwa_docum.conelen = " length of the Bell Reducer Cone ";
piwa.flange1t = 2.0;
// piwa_docum.flange1t = " flange SET half thickness ";
piwa.flange1r = 5.85;
// piwa_docum.flange1r = " flange outer radius ";
piwa.ribnum = 8;
// piwa_docum.ribnum = " number of Ribs ";
piwa.ribspa = 1.75;
// piwa_docum.ribspa = " spacing between Ribs ";
piwa.ribthk = 0.05;
// piwa_docum.ribthk = " Rib half thickness ";
piwa.riboutr = 4.8;
// piwa_docum.riboutr = " Rib Outer Radius ";
piwa.ribcent = 454.5;
// piwa_docum.ribcent = " Rib Set center  ";
PIWA.fill();
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             /// Component Cr	a=51.9960	z=24	w=0.19        
             /// Component Ni	a=58.6934	z=28	w=0.09        
             /// Component Fe	a=55.8450	z=26	w=0.72        
             /// Mixture StainlessSteel dens=8.03        
             {  AgMaterial &mix = AgMaterial::Get("Stainlesssteel");           
                   mix.Component("Cr",51.9960,24,0.19);           
                   mix.Component("Ni",58.6934,28,0.09);           
                   mix.Component("Fe",55.8450,26,0.72);           
                   mix.par("dens")=8.03;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             z1=-480.06;        
             z2=z1-2.0*pipa.s2leng;        
             z3=z2-(2*pipa.s3leng+pipa.conelen);        
             z4=z2-202.768-29.96;        
             r2=pipa.s4outr+0.2;        
             z1w=403.86;        
             z2w=z1w+2.0*piwa.s2leng;        
             z3w=z2w+(2*piwa.s3leng+piwa.conelen);        
             z4w=z2w+piwa.conelen+piwa.s3leng*2+piwa.s4leng;        
             r2w=piwa.s4outr+0.2;        
             _create = AgCreate("PIPE");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPE           
                   Create("PIPE");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIPE");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PIPE to mother IDSM           
                   place.TranslateX(pipg.xoffset);           
                   /// Translate x = pipg.xoffset           
                   place.TranslateY(pipg.yoffset);           
                   /// Translate y = pipg.yoffset           
                   place.TranslateZ(pipg.zoffset);           
                   /// Translate z = pipg.zoffset           
                   _stacker -> Position( AgBlock::Find("PIPE"), place );           
             } // end placement of PIPE        
             _create = AgCreate("PIPI");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPI           
                   Create("PIPI");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIPI");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PIPI to mother IDSM           
                   place.TranslateX(pipg.xoffset);           
                   /// Translate x = pipg.xoffset           
                   place.TranslateY(pipg.yoffset);           
                   /// Translate y = pipg.yoffset           
                   place.TranslateZ(pipg.zoffset);           
                   /// Translate z = pipg.zoffset           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PIPI"), place );           
             } // end placement of PIPI        
             _create = AgCreate("PIPW");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPW           
                   Create("PIPW");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIPW");           
                   place.SetMother("IDSM");           
                   /// Add daughter volume PIPW to mother IDSM           
                   place.TranslateX(pipg.xoffset);           
                   /// Translate x = pipg.xoffset           
                   place.TranslateY(pipg.yoffset);           
                   /// Translate y = pipg.yoffset           
                   place.TranslateZ(pipg.zoffset);           
                   /// Translate z = pipg.zoffset           
                   _stacker -> Position( AgBlock::Find("PIPW"), place );           
             } // end placement of PIPW        
             _create = AgCreate("PIPA");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPA           
                   Create("PIPA");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIPA");           
                   place.SetMother("CAVE");           
                   place.SetGroup("EastRefSys");           
                   /// Add daughter volume PIPA to mother CAVE           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(0);           
                   /// Translate z = 0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PIPA"), place );           
             } // end placement of PIPA        
             _create = AgCreate("PIWA");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIWA           
                   Create("PIWA");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("PIWA");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume PIWA to mother CAVE           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(0);           
                   /// Translate y = 0           
                   place.TranslateZ(0);           
                   /// Translate z = 0           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("PIWA"), place );           
             } // end placement of PIWA        
       }; // PipeGeo3     
 }; // namespace PipeGeo3  
 