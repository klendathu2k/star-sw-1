          void PIWC::Block( AgCreate create )     
          {         
                ///@addtogroup PIWC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PIWC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=4;              
                            shape.Z(0)=z2w;              
                            shape.Z(1)=z2w+piwa.s3leng*2;              
                            shape.Z(2)=z3w;              
                            shape.Z(3)=z4w;              
                            shape.Rmin(0)=0;              
                            shape.Rmin(1)=0;              
                            shape.Rmin(2)=0;              
                            shape.Rmin(3)=0;              
                            shape.Rmax(0)=piwa.s3outr;              
                            shape.Rmax(1)=piwa.s3outr;              
                            shape.Rmax(2)=piwa.s4outr;              
                            shape.Rmax(3)=piwa.s4outr;              
                            /// Shape Pcon phi1=0 dphi=360 nz=4               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIWC;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PVWC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PVWC              
                            Create("PVWC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PVWC");              
                            place.SetMother("PIWC");              
                            /// Add daughter volume PVWC to mother PIWC              
                            _stacker -> Position( AgBlock::Find("PVWC"), place );              
                      } // end placement of PVWC           
                      END_OF_PIWC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIWC     
