          AgBlock *PIPA::mInstance = 0;     
          AgBlock *PIPA::Instance(){        
                   if ( mInstance==0 ) mInstance = new PIPA();        
                   return mInstance;        
          }     
          void PIPA::Block( AgCreate create )     
          {         
                ///@addtogroup PIPA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("PIPA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=2;              
                            shape.Z(0)=z4;              
                            shape.Z(1)=z1;              
                            shape.Rmin(0)=0;              
                            shape.Rmin(1)=0;              
                            shape.Rmax(0)=r2;              
                            shape.Rmax(1)=r2;              
                            /// Shape Pcon phi1=0 dphi=360 nz=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIPA;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PIPB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIPB              
                            Create("PIPB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPB");              
                            place.SetMother("PIPA");              
                            /// Add daughter volume PIPB to mother PIPA              
                            place.TranslateZ((z1+z2)/2);              
                            /// Translate z = (z1+z2)/2              
                            _stacker -> Position( AgBlock::Find("PIPB"), place );              
                      } // end placement of PIPB           
                      _create = AgCreate("PIPC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIPC              
                            Create("PIPC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPC");              
                            place.SetMother("PIPA");              
                            /// Add daughter volume PIPC to mother PIPA              
                            _stacker -> Position( AgBlock::Find("PIPC"), place );              
                      } // end placement of PIPC           
                      _create = AgCreate("PRIS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PRIS              
                            Create("PRIS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PRIS");              
                            place.SetMother("PIPA");              
                            /// Add daughter volume PRIS to mother PIPA              
                            place.TranslateZ((z1+z2)/2);              
                            /// Translate z = (z1+z2)/2              
                            _stacker -> Position( AgBlock::Find("PRIS"), place );              
                      } // end placement of PRIS           
                      _create = AgCreate("PFLO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PFLO              
                            Create("PFLO");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PFLO");              
                            place.SetMother("PIPA");              
                            /// Add daughter volume PFLO to mother PIPA              
                            place.TranslateZ(z1-1.0);              
                            /// Translate z = z1-1.0              
                            _stacker -> Position( AgBlock::Find("PFLO"), place );              
                      } // end placement of PFLO           
                      _create = AgCreate("PFLT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PFLT              
                            Create("PFLT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PFLT");              
                            place.SetMother("PIPA");              
                            /// Add daughter volume PFLT to mother PIPA              
                            place.TranslateZ(z2);              
                            /// Translate z = z2              
                            _stacker -> Position( AgBlock::Find("PFLT"), place );              
                      } // end placement of PFLT           
                      END_OF_PIPA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIPA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PIPB::mInstance = 0;     
          AgBlock *PIPB::Instance(){        
                   if ( mInstance==0 ) mInstance = new PIPB();        
                   return mInstance;        
          }     
          void PIPB::Block( AgCreate create )     
          {         
                ///@addtogroup PIPB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("Pipi");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=pipa.s2outr;              
                            shape.par("dz")=pipa.s2leng;              
                            /// Shape Tube rmin=0 rmax=pipa.s2outr dz=pipa.s2leng               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIPB;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PVPB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PVPB              
                            Create("PVPB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PVPB");              
                            place.SetMother("PIPB");              
                            /// Add daughter volume PVPB to mother PIPB              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PVPB"), place );              
                      } // end placement of PVPB           
                      END_OF_PIPB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIPB     
          // ---------------------------------------------------------------------------------------------------     
