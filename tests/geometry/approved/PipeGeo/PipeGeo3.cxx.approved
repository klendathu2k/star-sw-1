                            place.SetBlock("PIWB");              
                            place.SetMother("PIWA");              
                            /// Add daughter volume PIWB to mother PIWA              
                            place.TranslateZ((z1w+z2w)/2);              
                            /// Translate z = (z1w+z2w)/2              
                            _stacker -> Position( AgBlock::Find("PIWB"), place );              
                      } // end placement of PIWB           
                      _create = AgCreate("PIWC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIWC              
                            Create("PIWC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIWC");              
                            place.SetMother("PIWA");              
                            /// Add daughter volume PIWC to mother PIWA              
                            _stacker -> Position( AgBlock::Find("PIWC"), place );              
                      } // end placement of PIWC           
                      _create = AgCreate("PRWS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PRWS              
                            Create("PRWS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PRWS");              
                            place.SetMother("PIWA");              
                            /// Add daughter volume PRWS to mother PIWA              
                            place.TranslateZ((z1w+z2w)/2);              
                            /// Translate z = (z1w+z2w)/2              
                            _stacker -> Position( AgBlock::Find("PRWS"), place );              
                      } // end placement of PRWS           
                      _create = AgCreate("PFLO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PFLO              
                            Create("PFLO");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PFLO");              
                            place.SetMother("PIWA");              
                            /// Add daughter volume PFLO to mother PIWA              
                            place.TranslateZ(z1w+1.0);              
                            /// Translate z = z1w+1.0              
                            _stacker -> Position( AgBlock::Find("PFLO"), place );              
                      } // end placement of PFLO           
                      _create = AgCreate("PFLT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PFLT              
                            Create("PFLT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PFLT");              
                            place.SetMother("PIWA");              
                            /// Add daughter volume PFLT to mother PIWA              
                            place.TranslateZ(z2w);              
                            /// Translate z = z2w              
                            _stacker -> Position( AgBlock::Find("PFLT"), place );              
                      } // end placement of PFLT           
                      END_OF_PIWA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIWA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PIWB::mInstance = 0;     
          AgBlock *PIWB::Instance(){        
                   if ( mInstance==0 ) mInstance = new PIWB();        
                   return mInstance;        
          }     
          void PIWB::Block( AgCreate create )     
          {         
                ///@addtogroup PIWB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("Pipi");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=piwa.s2outr;              
                            shape.par("dz")=piwa.s2leng;              
                            /// Shape Tube rmin=0 rmax=piwa.s2outr dz=piwa.s2leng               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIWB;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PVWB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PVWB              
                            Create("PVWB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PVWB");              
                            place.SetMother("PIWB");              
                            /// Add daughter volume PVWB to mother PIWB              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("PVWB"), place );              
                      } // end placement of PVWB           
                      END_OF_PIWB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIWB     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PVWB::mInstance = 0;     
          AgBlock *PVWB::Instance(){        
                   if ( mInstance==0 ) mInstance = new PVWB();        
                   return mInstance;        
          }     
          void PVWB::Block( AgCreate create )     
          {         
                ///@addtogroup PVWB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material vacuum            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Vacuum");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmax")=piwa.s2innr;              
                            /// Shape Tube rmax=piwa.s2innr               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PVWB;              
                            _stacker -> Build(this);              
                      }           
                      { AgAttribute attr = AgAttribute("PVWB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      END_OF_PVWB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PVWB     
