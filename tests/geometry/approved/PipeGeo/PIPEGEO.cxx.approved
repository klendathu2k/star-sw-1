          AgBlock *PWRP::mInstance = 0;     
          AgBlock *PWRP::Instance(){        
                   if ( mInstance==0 ) mInstance = new PWRP();        
                   return mInstance;        
          }     
          void PWRP::Block( AgCreate create )     
          {         
                ///@addtogroup PWRP_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component C5	a=12	z=6	w=500000           
                      /// Component H4	a=1	z=1	w=400000           
                      /// Component O2	a=16	z=8	w=200000           
                      /// Component Al	a=27	z=13	w=345327           
                      /// Mixture MLI dens=1.82667           
                      {  AgMaterial &mix = AgMaterial::Get("Mli");              
                            mix.Component("C5",12,6,500000);              
                            mix.Component("H4",1,1,400000);              
                            mix.Component("O2",16,8,200000);              
                            mix.Component("Al",27,13,345327);              
                            mix.par("dens")=1.82667;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("Pwrp");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=pipg.wrpinnr;              
                            shape.par("rmax")=pipg.wrpoutr;              
                            shape.par("dz")=pipg.wrpleng/2;              
                            /// Shape Tube rmin=pipg.wrpinnr rmax=pipg.wrpoutr dz=pipg.wrpleng/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PWRP;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PWRP:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PWRP     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PSLD::mInstance = 0;     
          AgBlock *PSLD::Instance(){        
                   if ( mInstance==0 ) mInstance = new PSLD();        
                   return mInstance;        
          }     
          void PSLD::Block( AgCreate create )     
          {         
                ///@addtogroup PSLD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Component C5	a=12	z=6	w=50000           
                      /// Component H4	a=1	z=1	w=40000           
                      /// Component O2	a=16	z=8	w=20000           
                      /// Component Al	a=27	z=13	w=2302           
                      /// Mixture ALKAP dens=1.432           
                      {  AgMaterial &mix = AgMaterial::Get("Alkap");              
                            mix.Component("C5",12,6,50000);              
                            mix.Component("H4",1,1,40000);              
                            mix.Component("O2",16,8,20000);              
                            mix.Component("Al",27,13,2302);              
                            mix.par("dens")=1.432;              
                            mix.lock();              
                            _material = mix;              
                            _material.lock();              
                      }           
                      { AgAttribute attr = AgAttribute("PSLD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=pipg.sldinnr;              
                            shape.par("rmax")=pipg.sldoutr;              
                            shape.par("dz")=pipg.sldleng/2;              
                            /// Shape Tube rmin=pipg.sldinnr rmax=pipg.sldoutr dz=pipg.sldleng/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PSLD;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PSLD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PSLD     
    // ----------------------------------------------------------------------- geoctr
       void PIPEGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup PIPEGEO_revision        
             ///@{           
                   /// Created:   30-03-99            
             ///@}        
             ///@addtogroup PIPEGEO_revision        
             ///@{           
                   /// Author: W.B.Christie           
             ///@}        
             AddBlock("PIPE", PIPE::Instance());        
             AddBlock("PIPC", PIPC::Instance());        
             AddBlock("PIPO", PIPO::Instance());        
             AddBlock("PIPS", PIPS::Instance());        
             AddBlock("PIPB", PIPB::Instance());        
             AddBlock("PIPT", PIPT::Instance());        
             AddBlock("PFLO", PFLO::Instance());        
             AddBlock("PFLT", PFLT::Instance());        
             AddBlock("PVAC", PVAC::Instance());        
             AddBlock("PVAO", PVAO::Instance());        
             AddBlock("PVAS", PVAS::Instance());        
             AddBlock("PVAB", PVAB::Instance());        
             AddBlock("PRIS", PRIS::Instance());        
             AddBlock("PRID", PRID::Instance());        
             AddBlock("PRIB", PRIB::Instance());        
             AddBlock("PIPI", PIPI::Instance());        
             AddBlock("PVAI", PVAI::Instance());        
             AddBlock("PVAT", PVAT::Instance());        
             AddBlock("PWRP", PWRP::Instance());        
             AddBlock("PSLD", PSLD::Instance());        
             wrpthk=(3.+1.5)*2*mil_p;        
             sldthk=(3.+0.1)*mil_p;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipv
++pipv._index;
pipv.version = 1;
// pipv_docum.version = " geometry version ";
pipv.pipeconfig = 2;
// pipv_docum.pipeconfig = " pipe version (2 is the default, unfortunately) ";
pipv.pipeflag = 0;
// pipv_docum.pipeflag = " 1=PWRP ;//2=PSLD ";
pipv.targflag = 0;
// pipv_docum.targflag = " 0=default 1=add fixed target";
PIPV.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 2;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 3.9;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 4.0;
// pipg_docum.beoutr = " Berillium section outer radius ";
pipg.beleng = 76.2;
// pipg_docum.beleng = " Berillium section half length ";
pipg.material = "alum";
// pipg_docum.material = " pipe main section material  ";
pipg.s1innr = 3.875;
// pipg_docum.s1innr = " first Aluminum section inner radius ";
pipg.s1outr = 4.0;
// pipg_docum.s1outr = " first Aluminum section outer radius ";
pipg.s1leng = 153.4;
// pipg_docum.s1leng = " first Aluminum section half length ";
pipg.s2innr = 3.875;
// pipg_docum.s2innr = " second Aluminum section inner radius ";
pipg.s2outr = 4.00;
// pipg_docum.s2outr = " second Aluminum section outer radius ";
pipg.s2leng = 18.0;
// pipg_docum.s2leng = " second Aluminum section half length ";
pipg.s3innr = 3.875;
// pipg_docum.s3innr = " Transition Stub Aluminum section inner radius ";
pipg.s3outr = 4.0;
// pipg_docum.s3outr = " Transition Stub Aluminum section outer radius ";
pipg.s3leng = 1.0;
// pipg_docum.s3leng = " Transition Stub Aluminum section half length ";
pipg.s4innr = 6.20;
// pipg_docum.s4innr = " Large OD Aluminum section inner radius ";
pipg.s4outr = 6.35;
// pipg_docum.s4outr = " Large OD Aluminum section outer radius ";
pipg.s4leng = 150.0;
// pipg_docum.s4leng = " Large OD Aluminum section half length ";
pipg.conelen = 12.5;
// pipg_docum.conelen = " half length of the Bell Reducer Cone ";
pipg.flange1t = 2.0;
// pipg_docum.flange1t = " flange SET half thickness ";
pipg.flange1r = 5.85;
// pipg_docum.flange1r = " flange outer radius ";
pipg.ribnum = 8;
// pipg_docum.ribnum = " number of Ribs ";
pipg.ribspa = 1.75;
// pipg_docum.ribspa = " spacing between Ribs ";
pipg.ribthk = 0.05;
// pipg_docum.ribthk = " Rib half thickness ";
pipg.riboutr = 4.8;
// pipg_docum.riboutr = " Rib Outer Radius ";
pipg.ribcent = 454.5;
// pipg_docum.ribcent = " Rib Set center  ";
pipg.wrpinnr = 4.0;
// pipg_docum.wrpinnr = " inner radius of beampipe multi layer insulation ";
pipg.wrpoutr = 4.0+wrpthk;
// pipg_docum.wrpoutr = " outer radius of beampipe multi layer insulation ";
pipg.wrpleng = 300;
// pipg_docum.wrpleng = " length of beampipe multi layer insulation ";
pipg.sldinnr = 4.0+wrpthk;
// pipg_docum.sldinnr = " inner radius of SVT beam pipe shield ";
pipg.sldoutr = 4.0+wrpthk+sldthk;
// pipg_docum.sldoutr = " outer radius of SVT beam pipe shield ";
pipg.sldleng = 56;
// pipg_docum.sldleng = " length of SVT beam pipe shield ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 1;
// pipg_docum.config = " both material and geo params ";
pipg.material = "iron";
// pipg_docum.material = " material is steel ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 4;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 1.374;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 1.450;
// pipg_docum.beoutr = " Berillium section outer radius ";
pipg.material = "alum";
// pipg_docum.material = " pipe main section material  ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 5;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 1.374;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 1.424;
// pipg_docum.beoutr = " Berillium section outer radius ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 6;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 2.0;
// pipg_docum.beinnr = " Berillium section inner radius (Jan upgr16) ";
pipg.beoutr = 2.076;
// pipg_docum.beoutr = " Berillium section outer radius ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 2.1;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 3.81;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 3.91;
// pipg_docum.beoutr = " Berillium section outer radius ";
pipg.beleng = 76.2;
// pipg_docum.beleng = " Berillium section half length ";
pipg.material = "alum";
// pipg_docum.material = " pipe main section material  ";
pipg.s1innr = 3.81;
// pipg_docum.s1innr = " first Aluminum section inner radius ";
pipg.s1outr = 3.937;
// pipg_docum.s1outr = " first Aluminum section outer radius ";
pipg.s1leng = 163.83;
// pipg_docum.s1leng = " first Aluminum section half length ";
pipg.s2innr = 3.81;
// pipg_docum.s2innr = " second Aluminum section inner radius ";
pipg.s2outr = 3.937;
// pipg_docum.s2outr = " second Aluminum section outer radius ";
pipg.s2leng = 18.0;
// pipg_docum.s2leng = " second Aluminum section half length ";
pipg.s3innr = 3.81;
// pipg_docum.s3innr = " Transition Stub Aluminum section inner radius ";
pipg.s3outr = 3.937;
// pipg_docum.s3outr = " Transition Stub Aluminum section outer radius ";
pipg.s3leng = 1.0;
// pipg_docum.s3leng = " Transition Stub Aluminum section half length ";
pipg.s4innr = 6.20;
// pipg_docum.s4innr = " Large OD Aluminum section inner radius ";
pipg.s4outr = 6.35;
// pipg_docum.s4outr = " Large OD Aluminum section outer radius ";
pipg.s4leng = 139.57;
// pipg_docum.s4leng = " Large OD Aluminum section half length ";
pipg.conelen = 12.5;
// pipg_docum.conelen = " half length of the Bell Reducer Cone ";
pipg.flange1t = 2.0;
// pipg_docum.flange1t = " flange SET half thickness ";
pipg.flange1r = 5.85;
// pipg_docum.flange1r = " flange outer radius ";
pipg.ribnum = 8;
// pipg_docum.ribnum = " number of Ribs ";
pipg.ribspa = 1.75;
// pipg_docum.ribspa = " spacing between Ribs ";
pipg.ribthk = 0.05;
// pipg_docum.ribthk = " Rib half thickness ";
pipg.riboutr = 4.8;
// pipg_docum.riboutr = " Rib Outer Radius ";
pipg.ribcent = 454.5;
// pipg_docum.ribcent = " Rib Set center  ";
pipg.wrpinnr = 4.0;
// pipg_docum.wrpinnr = " inner radius of beampipe multi layer insulation ";
pipg.wrpoutr = 4.0+wrpthk;
// pipg_docum.wrpoutr = " outer radius of beampipe multi layer insulation ";
pipg.wrpleng = 300;
// pipg_docum.wrpleng = " length of beampipe multi layer insulation ";
pipg.sldinnr = 4.0+wrpthk;
// pipg_docum.sldinnr = " inner radius of SVT beam pipe shield ";
pipg.sldoutr = 4.0+wrpthk+sldthk;
// pipg_docum.sldoutr = " outer radius of SVT beam pipe shield ";
pipg.sldleng = 56;
// pipg_docum.sldleng = " length of SVT beam pipe shield ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 1.1;
// pipg_docum.config = " both material and geo params ";
pipg.material = "iron";
// pipg_docum.material = " material is steel ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 4.1;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 1.374;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 1.450;
// pipg_docum.beoutr = " Berillium section outer radius ";
pipg.material = "alum";
// pipg_docum.material = " pipe main section material  ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 5.1;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 1.374;
// pipg_docum.beinnr = " Berillium section inner radius ";
pipg.beoutr = 1.424;
// pipg_docum.beoutr = " Berillium section outer radius ";
PIPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipg
++pipg._index;
pipg.config = 6.1;
// pipg_docum.config = " both material and geo params ";
pipg.beinnr = 2.0;
// pipg_docum.beinnr = " Berillium section inner radius (Jan upgr16) ";
pipg.beoutr = 2.076;
// pipg_docum.beoutr = " Berillium section outer radius ";
PIPG.fill();
        
             /// USE pipv _index=1;        
             PIPV.use( __pipv__index__ = 1 );
        
             /// USE pipg config=pipv.pipeconfig;        
             PIPG.use( __pipg_config__ = pipv.pipeconfig );
        
             z1=pipg.beleng+2*pipg.s1leng+pipg.flange1t;        
             z2=z1-2*pipg.flange1t+2*pipg.s2leng;        
             z3=z2+pipg.flange1t+2*pipg.s3leng+2*pipg.conelen+2*pipg.s4leng;        
             z4=z2+pipg.flange1t+2*pipg.s3leng+pipg.conelen;        
             r1=pipg.sldoutr;        
             r2=pipg.s4outr;        
             _create = AgCreate("PIPE");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create PIPE           
                   Create("PIPE");            
             }        
             if ( pipv.pipeconfig>=4||pipv.targflag==1 )        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("PIPE");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume PIPE to mother CAVE              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         _stacker -> Position( AgBlock::Find("PIPE"), place );              
                   } // end placement of PIPE           
                   {              
                         AgPosition  place;              
                         place.SetBlock("PIPE");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume PIPE to mother CAVE              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 180              
                         /// G3 Reference: phiz = 0              
                         Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;              
                         place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );              
                         _stacker -> Position( AgBlock::Find("PIPE"), place );              
                   } // end placement of PIPE           
             }        
             else        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("PIPE");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume PIPE to mother CAVE              
                         _stacker -> Position( AgBlock::Find("PIPE"), place );              
                   } // end placement of PIPE           
                   {              
                         AgPosition  place;              
                         place.SetBlock("PIPE");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume PIPE to mother CAVE              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 180              
                         /// G3 Reference: phiz = 0              
                         Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;              
                         place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );              
                         _stacker -> Position( AgBlock::Find("PIPE"), place );              
                   } // end placement of PIPE           
             }        
       }; // PIPEGEO     
 }; // namespace PIPEGEO  
 