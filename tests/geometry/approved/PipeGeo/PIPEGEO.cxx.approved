                      _create = AgCreate("PIPI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIPI              
                            Create("PIPI");               
                      }           
                      if ( pipv.targflag==0 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPI");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PIPI to mother PIPE              
                            place.TranslateZ((z1+z2)/2);              
                            /// Translate z = (z1+z2)/2              
                            _stacker -> Position( AgBlock::Find("PIPI"), place );              
                      } // end placement of PIPI           
                      if ( pipv.targflag==1 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPI");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PIPI to mother PIPE              
                            place.TranslateZ((z1+z2)/2);              
                            /// Translate z = (z1+z2)/2              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("PIPI"), place );              
                      } // end placement of PIPI           
                      _create = AgCreate("PIPT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PIPT              
                            Create("PIPT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPT");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PIPT to mother PIPE              
                            place.TranslateZ(z2+pipg.flange1t+pipg.s3leng);              
                            /// Translate z = z2+pipg.flange1t+pipg.s3leng              
