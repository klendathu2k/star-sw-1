                      {              
                            AgPosition  place;              
                            place.SetBlock("PIPS");              
                            place.SetMother("PIPE");              
                            /// Add daughter volume PIPS to mother PIPE              
                            place.TranslateZ(z3-pipg.s4leng);              
                            /// Translate z = z3-pipg.s4leng              
                            _stacker -> Position( AgBlock::Find("PIPS"), place );              
