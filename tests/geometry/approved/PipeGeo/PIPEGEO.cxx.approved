          AgBlock *PIPI::mInstance = 0;     
          AgBlock *PIPI::Instance(){        
                   if ( mInstance==0 ) mInstance = new PIPI();        
                   return mInstance;        
          }     
          void PIPI::Block( AgCreate create )     
          {         
                ///@addtogroup PIPI_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material pipe            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Pipe");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("Pipi");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=pipg.s2outr;              
                            shape.par("dz")=pipg.s2leng;              
                            /// Shape Tube rmin=0 rmax=pipg.s2outr dz=pipg.s2leng               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PIPI;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PVAI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PVAI              
                            Create("PVAI");               
                      }           
                      if ( pipv.targflag==1 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PVAI");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PVAI to mother PIPI              
                            place.par("only")=AgPosition::kMany;              
                            /// Overlap: agposition::kmany              
                            _stacker -> Position( AgBlock::Find("PVAI"), place );              
                      } // end placement of PVAI           
                      if ( pipv.targflag==0 )           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PVAI");              
                            place.SetMother("PIPI");              
                            /// Add daughter volume PVAI to mother PIPI              
                            place.par("only")=AgPosition::kOnly;              
                            /// Overlap: agposition::konly              
                            _stacker -> Position( AgBlock::Find("PVAI"), place );              
                      } // end placement of PVAI           
                      END_OF_PIPI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PIPI     
          // ---------------------------------------------------------------------------------------------------     
