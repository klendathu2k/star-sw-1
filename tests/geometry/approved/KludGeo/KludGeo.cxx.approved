          void KTUB::Block( AgCreate create )     
          {         
                ///@addtogroup KTUB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material ALUMINIUM            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Material KLUDGE_MATERIAL a=ktub_aa(i) z=ktub_zz(i) dens=ktub_dd(i) isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Kludge_material");              
                            mat.par("a")=ktub.aa[int(i)-1];              
                            mat.par("z")=ktub.zz[int(i)-1];              
                            mat.par("dens")=ktub.dd[int(i)-1];              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("KTUB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=0;              
                            shape.par("dz")=0;              
                            /// Shape Tube rmin=0 rmax=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_KTUB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_KTUB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block KTUB     
