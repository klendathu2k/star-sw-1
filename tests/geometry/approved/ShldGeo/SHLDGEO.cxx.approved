    // ----------------------------------------------------------------------- geoctr
       void SHLDGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup SHLDGEO_revision        
             ///@{           
                   /// Created:   15-Aug-2005             
             ///@}        
             ///@addtogroup SHLDGEO_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             AddBlock("SHLX", SHLX::Instance());        
             AddBlock("SHBS", SHBS::Instance());        
             AddBlock("SHLS", SHLS::Instance());        
             AddBlock("SHBI", SHBI::Instance());        
             AddBlock("SHFI", SHFI::Instance());        
             AddBlock("SHOL", SHOL::Instance());        
             AddBlock("SFLR", SFLR::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill shlg
++shlg._index;
shlg.version = 1;
// shlg_docum.version = " geometry version   ";
shlg.z = 1750;
// shlg_docum.z = " position of the shielding ";
shlg.dx = 170;
// shlg_docum.dx = " half-x dimension ";
shlg.dy = 150;
// shlg_docum.dy = " half-y dimension ";
shlg.dz = 100;
// shlg_docum.dz = " half-z dimension ";
shlg.baselevel = -125;
// shlg_docum.baselevel = " base position on the floor ";
shlg.basez = 0;
// shlg_docum.basez = " base position ";
shlg.basedx = 60;
// shlg_docum.basedx = " base half-x dimension ";
shlg.basedy = 30;
// shlg_docum.basedy = " base half-y dimension ";
shlg.slabx = 0;
// shlg_docum.slabx = " slab position ";
shlg.slabz = -30;
// shlg_docum.slabz = " slab position ";
shlg.slabdy = 30;
// shlg_docum.slabdy = " slab half-y dimension ";
shlg.slabdz = 30;
// shlg_docum.slabdz = " slab half-z dimension ";
shlg.fidz = 47;
// shlg_docum.fidz = " forward iron slab half-thickness ";
shlg.fidy = 55;
// shlg_docum.fidy = " half-height ";
shlg.holex = 20;
// shlg_docum.holex = " beam hole half-size in X ";
shlg.holey = 10;
// shlg_docum.holey = " beam hole half-size in Y ";
shlg.floorthk = 70;
// shlg_docum.floorthk = " Concrete floor thickness ";
shlg.floorlen = 3900;
// shlg_docum.floorlen = " Concrete floor length ";
shlg.floorwidth = 340;
// shlg_docum.floorwidth = " Concrete floor width ";
shlg.floorpos = 2800;
// shlg_docum.floorpos = " Concrete floor z-position ";
SHLG.fill();
        
             /// USE shlg _index=1;        
             SHLG.use( __shlg__index__ = 1 );
        
             shieldhalfheight=(shlg.basedy+shlg.slabdy+shlg.fidy);        
             _create = AgCreate("SHLX");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SHLX           
                   Create("SHLX");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SHLX");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SHLX to mother CAVE           
                   place.TranslateX(0.0);           
                   /// Translate x = 0.0           
                   place.TranslateY(shlg.baselevel+shieldhalfheight);           
                   /// Translate y = shlg.baselevel+shieldhalfheight           
                   place.TranslateZ(+shlg.z);           
                   /// Translate z = +shlg.z           
                   _stacker -> Position( AgBlock::Find("SHLX"), place );           
             } // end placement of SHLX        
             {           
                   AgPosition  place;           
                   place.SetBlock("SHLX");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SHLX to mother CAVE           
                   place.TranslateX(0.0);           
                   /// Translate x = 0.0           
                   place.TranslateY(shlg.baselevel+shieldhalfheight);           
                   /// Translate y = shlg.baselevel+shieldhalfheight           
                   place.TranslateZ(-shlg.z);           
                   /// Translate z = -shlg.z           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("SHLX"), place );           
             } // end placement of SHLX        
             _create = AgCreate("SFLR");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create SFLR           
                   Create("SFLR");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("SFLR");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SFLR to mother CAVE           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(shlg.baselevel-0.5*shlg.floorthk);           
                   /// Translate y = shlg.baselevel-0.5*shlg.floorthk           
                   place.TranslateZ(+shlg.floorpos);           
                   /// Translate z = +shlg.floorpos           
                   _stacker -> Position( AgBlock::Find("SFLR"), place );           
             } // end placement of SFLR        
             {           
                   AgPosition  place;           
                   place.SetBlock("SFLR");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume SFLR to mother CAVE           
                   place.TranslateX(0);           
                   /// Translate x = 0           
                   place.TranslateY(shlg.baselevel-0.5*shlg.floorthk);           
                   /// Translate y = shlg.baselevel-0.5*shlg.floorthk           
                   place.TranslateZ(-shlg.floorpos);           
                   /// Translate z = -shlg.floorpos           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("SFLR"), place );           
             } // end placement of SFLR        
       }; // SHLDGEO     
 }; // namespace SHLDGEO  
 