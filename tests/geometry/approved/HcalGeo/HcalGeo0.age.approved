      MODULE HcalGeo0    forward hadronic calorimeter, test run, 2014
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      Author Prashanth S (KSU)
      Created 12/30/2013
      +CDE,agecom,gcunit,gconst..
      EXTERNAL hcalhit
      CONTENT HCMO,
      HTWR,
      HCEL,
      HCES,
      HCLX,
      HCLY,
      HCSX,
      HCSY,
      HFIB,
      HFIC,
      HSLD,
      HSWR,
      HSTP,
      HSFE
      Integer *4 i,j ,      m,n ,      p,q

      real *4 xtemp,      ytemp

      STRUCTURE mcdt { version,x,y,z,dx,dy,dz}
      STRUCTURE towr { version,dx,dy,dz,nTowerX,nTowerY}
      STRUCTURE cell { version,dx,dy,dz,nCellX,nCellY,nFiberXL,nFiberYL,nFiberXS,
            nFiberYS}
      STRUCTURE fibr { version,rmin,rmax,dz,startX1,startY1,startX2,startY2,stepX,
            stepY}
      STRUCTURE shld { version,xd,yd,zd,dxd,dyd,dzd}
      STRUCTURE pres { version,xP1,yP1,zP1,rP1,xP2,yP2,zP2,rP2,xFe,yFe,zFe,rFe,strpXd,
            strpYd,strpZd,FeXd,FeYd,FeZd,strips}
      FILL mcdt		!  Mother Calorimeter
      version = 1.0 ! face center of calorimeter
      x = -69.8 ! x cdt from center of TPC
      y = 4.9 ! y cdt from center of TPC
      z = 777.4 ! z cdt from center of TPC
      dx = 60/2. ! HCMO width
      dy = (60+5)/2. ! HCMO height + shild hight
      dz = 117/2. ! HCMO length
      ENDFILL
      FILL towr		! Structure containing Calorimeter towr dimention
      version = 1.0 ! towr dimention
      dx = 10.0/2. ! towr width
      dy = 10.0/2. ! towr height
      dz = 117.0/2. ! towr length
      nTowerX = 6 ! no of tower in X dir
      nTowerY = 6 ! no of tower in Y dir
      ENDFILL
      FILL cell		! Structure containing Calorimeter pixels dimention
      version = 1.0 ! pixels dimention
      dx = 3.3/2. ! pixels width
      dy = 3.3/2. ! pixels height
      dz = 117.0/2. ! towr length
      nCellX = 3 ! no of cells in X dir
      nCellY = 3 ! no of cells in Y dir
      nFiberXL = 16 ! no fibers in cell 16 fibers
      nFiberYL = 16 ! no fibers in cell 16 fibers
      nFiberXS = 15 ! no fibers in cell 15 fibers
      nFiberYS = 15 ! no fibers in cell 15 fibers
      ENDFILL
      FILL fibr		! Scintilating fibes in towers/cells
      version = 1.0 ! fiber dimention
      rmin = 0.0 ! inner radius of fiber
      rmax = 0.055 ! outer radius of fiber
      dz = 117.0/2. ! towr length
      startX1 = 0.107 ! distance from edge or from one cell boundry to other 1: for first cell
      startY1 = 0.107 ! distance from edge or from one cell boundry to other
      startX2 = 0.1065 ! distance from edge or from one cell boundry to other 2:for 2nd and 3rd cell
      startY2 = 0.1065 ! distance from edge or from one cell boundry to other
      stepX = 0.213 ! distance between fibers center to center
      stepY = 0.213 ! distance between fibers center to center
      ENDFILL
      FILL shld		! shild around calorimeter
      version = 1.0 ! None
      xd = 0.0 ! None
      yd = -32.5 ! None
      zd = 0.0 ! None
      dxd = 35.0 ! None
      dyd = 5.0/2 ! None
      dzd = 127.0/2 ! None
      ENDFILL
      FILL pres		! Pre_Shower
      version = 1.0 ! None
      xP1 = 0.0 ! None
      yP1 = 0.0 ! None
      zP1 = 707.2 ! None
      rP1 = 45.0 ! None
      xP2 = 0.0 ! None
      yP2 = 0.0 ! None
      zP2 = 711.2 ! None
      rP2 = -45.0 ! None
      xFe = 0.0 ! None
      yFe = 0.0 ! None
      zFe = 709.2 ! None
      rFe = 45.0 ! None
      strpXd = 1.25 ! None
      strpYd = 45.0 ! None
      strpZd = 0.50 ! None
      FeXd = 24.1 ! None
      FeYd = 24.1 ! None
      FeZd = 0.31 ! None
      strips = 20 ! None
      ENDFILL
      use mcdt version=1.0
      use towr version=1.0
      use cell version=1.0
      use fibr version=1.0
      use shld version=1.0
      use pres version=1.0
      CREATE HCMO
      CALL AgsReset 
      CALL agml_position_begin('HCMO') 
      %mother = 'CAVE' 
      %title = 'HCMO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(mcdt_x) 
      CALL agml_translate_x( %x ) 
      ag_y = real(mcdt_y) 
      CALL agml_translate_y( %y ) 
      ag_z = real(mcdt_z) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE HSWR
      CALL AgsReset 
      CALL agml_position_begin('HSWR') 
      %mother = 'CAVE' 
      %title = 'HSWR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(pres_xP2) 
      CALL agml_translate_x( %x ) 
      ag_y = real(pres_yP2) 
      CALL agml_translate_y( %y ) 
      ag_z = real(pres_zP2) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(pres_rP2) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE HSFE
      CALL AgsReset 
      CALL agml_position_begin('HSFE') 
      %mother = 'CAVE' 
      %title = 'HSFE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(pres_xFe) 
      CALL agml_translate_x( %x ) 
      ag_y = real(pres_yFe) 
      CALL agml_translate_y( %y ) 
      ag_z = real(pres_zFe) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(pres_rFe) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE HSWR
      CALL AgsReset 
      CALL agml_position_begin('HSWR') 
      %mother = 'CAVE' 
      %title = 'HSWR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(pres_xP1) 
      CALL agml_translate_x( %x ) 
      ag_y = real(pres_yP1) 
      CALL agml_translate_y( %y ) 
      ag_z = real(pres_zP1) 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(pres_rP1) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- HCMO
      BLOCK HCMO   Mother Calorimeter
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE None seen=0 colo=2
      SHAPE box dx=mcdt_dx dy=mcdt_dy dz=mcdt_dz
      DO i = 0, towr_nTowerX-1
      DO j = 0, towr_nTowerY-1
      CREATE HTWR
      CALL AgsReset 
      CALL agml_position_begin('HTWR') 
      %title = 'HTWR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-((towr_nTowerX-1)*towr_dx)+(i*towr_dx*2)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-((towr_nTowerY-1)*towr_dy)+(j*towr_dy*2)) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      END DO
      CREATE HSLD
      CALL AgsReset 
      CALL agml_position_begin('HSLD') 
      %title = 'HSLD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(shld_xd) 
      CALL agml_translate_x( %x ) 
      ag_y = real(shld_yd) 
      CALL agml_translate_y( %y ) 
      ag_z = real(shld_zd) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HTWR
      BLOCK HTWR   Towrs  of Calorimeter
      MATERIAL Lead
      MEDIUM standard
      ATTRIBUTE None seen=0 colo=4
      SHAPE box dx=towr_dx dy=towr_dy dz=towr_dz
      xtemp=fibr_startX1;
      DO m = 0, cell_nCellX-1
      ytemp=fibr_startY1;
      DO n = 0, cell_nCellY-1
      IF ( m.eq.n ) THEN
      CREATE HCES
      CALL AgsReset 
      CALL agml_position_begin('HCES') 
      %title = 'HCES' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-3.33+(3.33*m)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-3.33+(n*3.33)) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSE
      CREATE HCEL
      CALL AgsReset 
      CALL agml_position_begin('HCEL') 
      %title = 'HCEL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-3.33+(3.33*m)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-3.33+(n*3.33)) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ytemp=fibr_startY2;
      END DO
      xtemp=fibr_startX2;
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCES
      BLOCK HCES   3*3 cell in tower, HCES has 15*15 fibers
      MATERIAL Lead
      MATERIAL Lead isvol=1
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=cell_dx dy=cell_dy dz=cell_dz
      CREATE HCSX
      HITS HCES hcal:0:S(0,100.0) elos:0:S(0,100.0) birk:0:S(0,100.0)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCEL
      BLOCK HCEL   3*3 cell in tower, HCES has 16*16 fibers
      MATERIAL Lead
      MATERIAL Lead isvol=1
      ATTRIBUTE None seen=1 colo=4
      SHAPE box dx=cell_dx dy=cell_dy dz=cell_dz
      CREATE HCLX
      HITS HCEL hcal:0:S(0,100.0) elos:0:S(0,100.0) birk:0:S(0,100.0)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCSX
      BLOCK HCSX   3*3 cell in tower x divisions
      MATERIAL Lead isvol=0
      ATTRIBUTE None seen=1 colo=4
      SHAPE division ndiv=cell_nFiberXS iaxis=1
      CREATE HCSY
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCSY
      BLOCK HCSY   3*3 cell in tower y divisions
      MATERIAL Lead isvol=0
      ATTRIBUTE None seen=0 colo=4
      SHAPE division ndiv=cell_nFiberYS iaxis=2
      CREATE HFIB
      CALL AgsReset 
      CALL agml_position_begin('HFIB') 
      %title = 'HFIB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCLX
      BLOCK HCLX   3*3 cell in tower x divisions
      MATERIAL Lead isvol=0
      ATTRIBUTE None seen=1 colo=4
      SHAPE division ndiv=cell_nFiberXL iaxis=1
      CREATE HCLY
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HCLY
      BLOCK HCLY   3*3 cell in tower y divisions
      MATERIAL Lead isvol=0
      ATTRIBUTE None seen=1 colo=4
      SHAPE division ndiv=cell_nFiberYL iaxis=2
      CREATE HFIC
      CALL AgsReset 
      CALL agml_position_begin('HFIC') 
      %title = 'HFIC' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HFIB
      BLOCK HFIB   fiber in cells
      MATERIAL Polystyren
      MATERIAL SensPoly isvol=1
      MEDIUM standard
      ATTRIBUTE None seen=1 colo=7
      SHAPE tube rmin=fibr_rmin rmax=fibr_rmax,
            dz=fibr_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HFIC
      BLOCK HFIC   fiber in cells
      MATERIAL Polystyren
      MATERIAL SensPoly isvol=1
      MEDIUM standard
      ATTRIBUTE None seen=1 colo=7
      SHAPE tube rmin=fibr_rmin rmax=fibr_rmax,
            dz=fibr_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HSLD
      BLOCK HSLD   Base Iron plate
      MATERIAL Iron isvol=0
      MEDIUM standard
      ATTRIBUTE None seen=1 colo=2
      SHAPE box dx=shld_dxd dy=shld_dyd dz=shld_dzd
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HSWR
      BLOCK HSWR   Mother of pre shower
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE None seen=0 colo=2
      SHAPE box dx=25.0 dy=50.0 dz=8.0
      DO i = 0, pres_strips-1
      CREATE HSTP
      CALL AgsReset 
      CALL agml_position_begin('HSTP') 
      %title = 'HSTP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-23.75+(i*2*pres_strpXd)) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      END DO
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HSTP
      BLOCK HSTP   single strips in pre shower
      MATERIAL Polystyren
      MATERIAL SensPoly isvol=1
      MEDIUM standard
      ATTRIBUTE None seen=1 colo=7
      SHAPE box dx=pres_strpXd dy=pres_strpYd,
            dz=pres_strpZd
      HITS HSTP birk:0:C(0,250.0)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- HSFE
      BLOCK HSFE   Fe in between two pre shower
      MATERIAL Iron
      MEDIUM standard
      ATTRIBUTE None seen=1 colo=2
      SHAPE box dx=pres_FeXd dy=pres_FeYd dz=pres_FeZd
      ENDBLOCK
      <W> '===>> 	[End AgML Module HcalGeo0]	 <<==='; (A32,/,/);
      END! Module HcalGeo0
      subroutine hcalhit(JJ,HIT)
      +CDE,TYPING,GCBANK,GCONST,GCUNIT,GCTMED,GCTRAK,GCKINE,GCSETS,AGCSTEP,GCVOLU.
      Integer JJ
      Real HIT,att,zhcal
      character*4 name
      call uhtoc(NAMES(NLEVEL),4,name,4)
      !write (*,*) name, nlevel
      ! activate following for fiber only
      !if(nlevel.eq.8) then        ! nlevel == 8 is fiber
      zhcal=718.9+117-VECT(3)        ! Also... hardcoded positions...
      att=exp(-zhcal/220)
      !Write (*,*) name, nlevel,' z=',zhcal,' deStep = ', deStep, adestep, att
      hit = deStep * att
      !endif
      !deStep = deStep * att ! huh??
      !Write (*,*) deStep
      return
      end
