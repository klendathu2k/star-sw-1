       HcalGeo0a::HcalGeo0a()     
         : AgModule("HcalGeo0a"," forward hadronic calorimeter, Proposed Full Geometry, 2016")     
       {        
       }     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HCMO::mInstance = 0;     
          AgBlock *HCMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new HCMO();        
                   return mInstance;        
          }     
          void HCMO::Block( AgCreate create )     
          {         
                ///@addtogroup HCMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mcdt.dx;              
                            shape.par("dy")=mcdt.dy;              
                            shape.par("dz")=mcdt.dz;              
                            /// Shape Bbox dx=mcdt.dx dy=mcdt.dy dz=mcdt.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCMO;              
                            _stacker -> Build(this);              
                      }           
                      mmi=0;;           
                      mmj=4;;           
                      nni=0;;           
                      nnj=13;;           
                      ooi=16;;           
                      ooj=1;;           
                      ppi=16;;           
                      ppj=16;;           
                      q1i=9;q1j=8;;           
                      q2i=9;q2j=9;;           
                      q3i=10;q3j=8;;           
                      q4i=10;q4j=9;;           
                      /// Loop on i from 0 to towr.ntowerx-1 step=1           
                      for ( i=0; (1>0)? (i<=towr.ntowerx-1):(i>=towr.ntowerx-1); i+=1 )           
                      {              
                            /// Loop on j from 0 to towr.ntowery-1 step=1              
                            for ( j=0; (1>0)? (j<=towr.ntowery-1):(j>=towr.ntowery-1); j+=1 )              
                            {                 
                                  flag1=((i==mmi)&&(j<mmj))||((i==nni)&&(j>nnj))||((i==ooi)&&(j<ooj))||((i==ppi)&&(j>ppj));;                 
                                  flag2=((i==q1i)&&(j==q1j))||((i==q2i)&&(j==q2j))||((i==q3i)&&(j==q3j))||((i==q4i)&&(j==q4j));;                 
                                  flag=flag1+flag2;;                 
                                  flag3=((i==mmi)&&(j<mmj))||((i==ooi)&&(j<ooj));;                 
                                  if ( (flag==0) )                 
                                  {                    
                                        _create = AgCreate("HTWR");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HTWR                       
                                              Create("HTWR");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HTWR");                       
                                              place.SetMother("HCMO");                       
                                              /// Add daughter volume HTWR to mother HCMO                       
                                              place.TranslateX(-(((towr.ntowerx/2)*towr.dx*2)-towr.dx)+(i*towr.dx*2));                       
                                              /// Translate x = -(((towr.ntowerx/2)*towr.dx*2)-towr.dx)+(i*towr.dx*2)                       
                                              place.TranslateY(-(((towr.ntowery/2)*towr.dy*2)-towr.dy)+(j*towr.dy*2));                       
                                              /// Translate y = -(((towr.ntowery/2)*towr.dy*2)-towr.dy)+(j*towr.dy*2)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HTWR"), place );                       
                                        } // end placement of HTWR                    
                                  }                 
                                  if ( (flag3==1) )                 
                                  {                    
                                        _create = AgCreate("HACL");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HACL                       
                                              Create("HACL");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HACL");                       
                                              place.SetMother("HCMO");                       
                                              /// Add daughter volume HACL to mother HCMO                       
                                              place.TranslateX(-(((towr.ntowerx/2)*towr.dx*2)-towr.dx)+(i*towr.dx*2));                       
                                              /// Translate x = -(((towr.ntowerx/2)*towr.dx*2)-towr.dx)+(i*towr.dx*2)                       
                                              place.TranslateY(-(((towr.ntowery/2)*towr.dy*2)-towr.dy)+(j*towr.dy*2));                       
                                              /// Translate y = -(((towr.ntowery/2)*towr.dy*2)-towr.dy)+(j*towr.dy*2)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HACL"), place );                       
                                        } // end placement of HACL                    
                                  }                 
                            }              
                            if ( i==mmi )              
                            {                 
                                  mmi=mmi+1;                 
                                  mmj=mmj-1;                 
                            }              
                            if ( i==nni )              
                            {                 
                                  nni=nni+1;                 
                                  nnj=nnj+1;                 
                            }              
                            if ( i==ooi )              
                            {                 
                                  ooi=ooi+1;                 
                                  ooj=ooj+1;                 
                            }              
                            if ( i==ppi )              
                            {                 
                                  ppi=ppi+1;                 
                                  ppj=ppj-1;                 
                            }              
                      }           
                      END_OF_HCMO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCMO     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HTWR::mInstance = 0;     
          AgBlock *HTWR::Instance(){        
                   if ( mInstance==0 ) mInstance = new HTWR();        
                   return mInstance;        
          }     
          void HTWR::Block( AgCreate create )     
          {         
                ///@addtogroup HTWR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Lead");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=towr.dx;              
                            shape.par("dy")=towr.dy;              
                            shape.par("dz")=towr.dz;              
                            /// Shape Bbox dx=towr.dx dy=towr.dy dz=towr.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HTWR;              
                            _stacker -> Build(this);              
                      }           
                      xtemp=fibr.startx1;;           
                      /// Loop on m from 0 to cell.ncellx-1 step=1           
                      for ( m=0; (1>0)? (m<=cell.ncellx-1):(m>=cell.ncellx-1); m+=1 )           
                      {              
                            ytemp=fibr.starty1;;              
                            /// Loop on l from 0 to cell.ncelly-1 step=1              
                            for ( l=0; (1>0)? (l<=cell.ncelly-1):(l>=cell.ncelly-1); l+=1 )              
                            {                 
                                  if ( m==l )                 
                                  {                    
                                        _create = AgCreate("HCES");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCES                       
                                              Create("HCES");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCES");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCES to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(l*3.33));                       
                                              /// Translate y = -3.33+(l*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCES"), place );                       
                                        } // end placement of HCES                    
                                  }                 
                                  else                 
                                  {                    
                                        _create = AgCreate("HCEL");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCEL                       
                                              Create("HCEL");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCEL");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCEL to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(l*3.33));                       
                                              /// Translate y = -3.33+(l*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCEL"), place );                       
                                        } // end placement of HCEL                    
                                  }                 
                                  ytemp=fibr.starty2;;                 
                            }              
                            xtemp=fibr.startx2;;              
                      }           
                      END_OF_HTWR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HTWR     
          // ---------------------------------------------------------------------------------------------------     
