                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPUN;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPUN");              
                            /// Add daughter volume WPAR to mother WPUN              
                            place.TranslateX(+wpfm.ustnd[int(4)-1]/2.0);              
                            /// Translate x = +wpfm.ustnd[int(4)-1]/2.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            place.par("dx")=wpfm.ustnd[int(1)-1]/2.0-wpfm.ustnd[int(4)-1]/2.0;              
                            place.par("dy")=wpfm.ustnd[int(2)-1]/2.0-wpfm.ustnd[int(4)-1];              
                            place.par("dz")=wpfm.ustnd[int(3)-1]/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPUN:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPUN     
