          AgBlock *WPPL::mInstance = 0;     
          AgBlock *WPPL::Instance(){        
                   if ( mInstance==0 ) mInstance = new WPPL();        
                   return mInstance;        
          }     
          void WPPL::Block( AgCreate create )     
          {         
                ///@addtogroup WPPL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPPL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wpfm.poled[int(1)-1]/2.0;              
                            shape.par("dy")=wpfm.poled[int(2)-1]/2.0;              
                            shape.par("dz")=wpfm.poled[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wpfm.poled[int(1)-1]/2.0 dy=wpfm.poled[int(2)-1]/2.0 dz=wpfm.poled[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPPL;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPPL");              
                            /// Add daughter volume WPAR to mother WPPL              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            place.par("dx")=wpfm.poled[int(1)-1]/2.0-wpfm.poled[int(4)-1];              
                            place.par("dy")=wpfm.poled[int(2)-1]/2.0;              
                            place.par("dz")=wpfm.poled[int(3)-1]/2.0-wpfm.poled[int(4)-1];              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPPL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPPL     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *WPIS::mInstance = 0;     
          AgBlock *WPIS::Instance(){        
                   if ( mInstance==0 ) mInstance = new WPIS();        
                   return mInstance;        
          }     
          void WPIS::Block( AgCreate create )     
          {         
                ///@addtogroup WPIS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Iron            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Iron");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("WPIS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=wpfm.istrd[int(1)-1]/2.0;              
                            shape.par("dy")=wpfm.istrd[int(2)-1]/2.0;              
                            shape.par("dz")=wpfm.istrd[int(3)-1]/2.0;              
                            /// Shape Bbox dx=wpfm.istrd[int(1)-1]/2.0 dy=wpfm.istrd[int(2)-1]/2.0 dz=wpfm.istrd[int(3)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_WPIS;              
                            _stacker -> Build(this);              
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPIS");              
                            /// Add daughter volume WPAR to mother WPIS              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(+(wpfm.istrd[int(3)-1]/4.0-wpfm.istrd[int(4)-1]/2.0));              
                            /// Translate z = +(wpfm.istrd[int(3)-1]/4.0-wpfm.istrd[int(4)-1]/2.0)              
                            place.par("dx")=wpfm.istrd[int(1)-1]/2.0;              
                            place.par("dy")=wpfm.istrd[int(2)-1]/2.0-wpfm.istrd[int(4)-1];              
                            place.par("dz")=(wpfm.istrd[int(3)-1]/2.0-wpfm.istrd[int(4)-1]/2.0)/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      {              
                            AgPosition  place;              
                            place.SetBlock("WPAR");              
                            place.SetMother("WPIS");              
                            /// Add daughter volume WPAR to mother WPIS              
                            place.TranslateX(0.0);              
                            /// Translate x = 0.0              
                            place.TranslateY(0.0);              
                            /// Translate y = 0.0              
                            place.TranslateZ(-(wpfm.istrd[int(3)-1]/4.0-wpfm.istrd[int(4)-1]/2.0));              
                            /// Translate z = -(wpfm.istrd[int(3)-1]/4.0-wpfm.istrd[int(4)-1]/2.0)              
                            place.par("dx")=wpfm.istrd[int(1)-1]/2.0;              
                            place.par("dy")=wpfm.istrd[int(2)-1]/2.0-wpfm.istrd[int(4)-1];              
                            place.par("dz")=(wpfm.istrd[int(3)-1]/2.0-wpfm.istrd[int(4)-1]/2.0)/2.0;              
                            _stacker -> Position( AgBlock::Find("WPAR"), place );              
                      } // end placement of WPAR           
                      END_OF_WPIS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block WPIS     
          // ---------------------------------------------------------------------------------------------------     
