    // ----------------------------------------------------------------------- geoctr
       void HcalGeo0a::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup HcalGeo0a_revision        
             ///@{           
                   /// Author: Prashanth S (KSU), FPS by Akio           
             ///@}        
             ///@addtogroup HcalGeo0a_revision        
             ///@{           
                   /// Created: 01/12/2014           
             ///@}        
             AddBlock("HCMO", HCMO::Instance());        
             AddBlock("HTWR", HTWR::Instance());        
             AddBlock("HCEL", HCEL::Instance());        
             AddBlock("HCES", HCES::Instance());        
             AddBlock("HCLX", HCLX::Instance());        
             AddBlock("HCLY", HCLY::Instance());        
             AddBlock("HCSX", HCSX::Instance());        
             AddBlock("HCSY", HCSY::Instance());        
             AddBlock("HFIB", HFIB::Instance());        
             AddBlock("HFIC", HFIC::Instance());        
             AddBlock("HACL", HACL::Instance());        
             AddBlock("FPRS", FPRS::Instance());        
             AddBlock("FPLY", FPLY::Instance());        
             AddBlock("FPPB", FPPB::Instance());        
             AddBlock("FPSC", FPSC::Instance());        
             AddBlock("FPBB", FPBB::Instance());        
             AddBlock("FLIG", FLIG::Instance());        
             AddBlock("FLBA", FLBA::Instance());        
             AddBlock("FLCO", FLCO::Instance());        
             AddBlock("FPMT", FPMT::Instance());        
             AddBlock("FFEE", FFEE::Instance());        
             AddBlock("FLLG", FLLG::Instance());        
             AddBlock("FBLL", FBLL::Instance());        
             AddBlock("FCLL", FCLL::Instance());        
             AddBlock("WPPL", WPPL::Instance());        
             AddBlock("WPIS", WPIS::Instance());        
             AddBlock("WPUF", WPUF::Instance());        
             AddBlock("WPUN", WPUN::Instance());        
             AddBlock("WPUS", WPUS::Instance());        
             AddBlock("WPAR", WPAR::Instance());        
             n=12;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mcdt
++mcdt._index;
mcdt.version = 1.0;
// mcdt_docum.version = "face center of calorimeter";
mcdt.x = 0.0;
// mcdt_docum.x = "x cdt from center of TPC";
mcdt.y = 0.0;
// mcdt_docum.y = "y cdt from center of TPC";
mcdt.z = 777.4;
// mcdt_docum.z = "z cdt from center of TPC";
mcdt.dx = 20*10/2.;
// mcdt_docum.dx = "HCMO width";
mcdt.dy = 18*10/2.;
// mcdt_docum.dy = "HCMO height";
mcdt.dz = 117/2.;
// mcdt_docum.dz = "HCMO length";
MCDT.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill towr
++towr._index;
towr.version = 1.0;
// towr_docum.version = "towr dimention";
