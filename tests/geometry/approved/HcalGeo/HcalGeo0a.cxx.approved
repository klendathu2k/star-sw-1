          AgBlock *FLCO::mInstance = 0;     
          AgBlock *FLCO::Instance(){        
                   if ( mInstance==0 ) mInstance = new FLCO();        
                   return mInstance;        
          }     
          void FLCO::Block( AgCreate create )     
          {         
                ///@addtogroup FLCO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Polystyren            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FLCO");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.par("serial")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd2");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=prsw.dprs[int(1)-1]/4.0;              
                            shape.par("dx2")=prsw.dlg[int(1)-1]/2.0;              
                            shape.par("dy1")=prsw.dz[int(sern)-1]/2.0;              
                            shape.par("dy2")=prsw.dlg[int(1)-1]/2.0;              
                            shape.par("dz")=prsw.dlg[int(2)-1]/2.0;              
                            /// Shape Trd2 dx1=prsw.dprs[int(1)-1]/4.0 dx2=prsw.dlg[int(1)-1]/2.0 dy1=prsw.dz[int(sern)-1]/2.0 dy2=prsw.dlg[int(1)-1]/2.0 dz=prsw.dlg[int(2)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FLCO;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FLCO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FLCO     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FCLL::mInstance = 0;     
          AgBlock *FCLL::Instance(){        
                   if ( mInstance==0 ) mInstance = new FCLL();        
                   return mInstance;        
          }     
          void FCLL::Block( AgCreate create )     
          {         
                ///@addtogroup FCLL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Polystyren            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FCLL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.par("serial")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Trd2");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=prsw.dprs[int(2)-1]/4.0;              
                            shape.par("dx2")=prsw.dlg[int(1)-1]/2.0;              
                            shape.par("dy1")=prsw.dz[int(sern)-1]/2.0;              
                            shape.par("dy2")=prsw.dlg[int(1)-1]/2.0;              
                            shape.par("dz")=prsw.dlg[int(2)-1]/2.0;              
                            /// Shape Trd2 dx1=prsw.dprs[int(2)-1]/4.0 dx2=prsw.dlg[int(1)-1]/2.0 dy1=prsw.dz[int(sern)-1]/2.0 dy2=prsw.dlg[int(1)-1]/2.0 dz=prsw.dlg[int(2)-1]/2.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FCLL;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FCLL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FCLL     
