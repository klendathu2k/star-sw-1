          void HCSX::Block( AgCreate create )     
          {         
                ///@addtogroup HCSX_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Lead");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("HCSX");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Division");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("ndiv")=cell.nfiberxs;              
                            shape.par("iaxis")=1;              
                            /// Shape Division ndiv=cell.nfiberxs iaxis=1               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCSX;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HCSY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HCSY              
                            Create("HCSY");               
                      }           
                      END_OF_HCSX:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCSX     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HCSY::mInstance = 0;     
          AgBlock *HCSY::Instance(){        
                   if ( mInstance==0 ) mInstance = new HCSY();        
                   return mInstance;        
          }     
          void HCSY::Block( AgCreate create )     
          {         
                ///@addtogroup HCSY_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Lead");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("HCSY");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Division");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("ndiv")=cell.nfiberys;              
                            shape.par("iaxis")=2;              
                            /// Shape Division ndiv=cell.nfiberys iaxis=2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCSY;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HFIB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HFIB              
                            Create("HFIB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HFIB");              
                            place.SetMother("HCSY");              
                            /// Add daughter volume HFIB to mother HCSY              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            _stacker -> Position( AgBlock::Find("HFIB"), place );              
                      } // end placement of HFIB           
                      END_OF_HCSY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCSY     
