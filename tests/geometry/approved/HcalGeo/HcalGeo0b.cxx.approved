    // ----------------------------------------------------------------------- geoctr
       void HcalGeo0b::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup HcalGeo0b_revision        
             ///@{           
                   /// Author: Prashanth S (KSU)           
             ///@}        
             ///@addtogroup HcalGeo0b_revision        
             ///@{           
                   /// Created: 12/30/2013           
             ///@}        
             AddBlock("HCMO", HCMO::Instance());        
             AddBlock("HTWR", HTWR::Instance());        
             AddBlock("HCEL", HCEL::Instance());        
             AddBlock("HCES", HCES::Instance());        
             AddBlock("HCLX", HCLX::Instance());        
             AddBlock("HCLY", HCLY::Instance());        
             AddBlock("HCSX", HCSX::Instance());        
             AddBlock("HCSY", HCSY::Instance());        
             AddBlock("HFIB", HFIB::Instance());        
             AddBlock("HFIC", HFIC::Instance());        
             AddBlock("BBCF", BBCF::Instance());        
             AddBlock("BBCB", BBCB::Instance());        
             AddBlock("LEDG", LEDG::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mcdt
++mcdt._index;
mcdt.version = 1.0;
// mcdt_docum.version = "face center of calorimeter";
mcdt.x = 0.0;
// mcdt_docum.x = "x cdt from center of TPC";
mcdt.y = 0.0;
// mcdt_docum.y = "y cdt from center of TPC";
mcdt.z = 750.0;
// mcdt_docum.z = "z cdt from center of TPC";
mcdt.dx = 30/2.;
// mcdt_docum.dx = "HCMO width";
mcdt.dy = (30)/2.;
// mcdt_docum.dy = "HCMO height + shild hight";
mcdt.dz = 117/2.;
// mcdt_docum.dz = "HCMO length";
MCDT.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill towr
++towr._index;
towr.version = 1.0;
// towr_docum.version = "towr dimention";
towr.dx = 10.0/2.;
// towr_docum.dx = "towr width";
towr.dy = 10.0/2.;
// towr_docum.dy = "towr height";
towr.dz = 117.0/2.;
// towr_docum.dz = "towr length";
towr.ntowerx = 3;
// towr_docum.ntowerx = "no of tower in X dir";
towr.ntowery = 3;
// towr_docum.ntowery = "no of tower in Y dir";
TOWR.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill cell
++cell._index;
cell.version = 1.0;
// cell_docum.version = "pixels dimention";
cell.dx = 3.3/2.;
// cell_docum.dx = "pixels width";
cell.dy = 3.3/2.;
// cell_docum.dy = "pixels height";
cell.dz = 117.0/2.;
// cell_docum.dz = "towr length";
cell.ncellx = 3;
// cell_docum.ncellx = "no of cells in X dir";
cell.ncelly = 3;
// cell_docum.ncelly = "no of cells in Y dir";
cell.nfiberxl = 16;
// cell_docum.nfiberxl = "no fibers in cell 16 fibers";
cell.nfiberyl = 16;
// cell_docum.nfiberyl = "no fibers in cell 16 fibers";
cell.nfiberxs = 15;
// cell_docum.nfiberxs = "no fibers in cell 15 fibers";
cell.nfiberys = 15;
// cell_docum.nfiberys = "no fibers in cell 15 fibers";
CELL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fibr
++fibr._index;
fibr.version = 1.0;
// fibr_docum.version = "fiber dimention";
fibr.rmin = 0.0;
// fibr_docum.rmin = "inner radius of fiber";
fibr.rmax = 0.055;
// fibr_docum.rmax = "outer radius of fiber";
fibr.dz = 117.0/2.;
// fibr_docum.dz = "towr length";
fibr.startx1 = 0.107;
// fibr_docum.startx1 = "distance from edge or from one cell boundry to other 1: for first cell ";
fibr.starty1 = 0.107;
// fibr_docum.starty1 = "distance from edge or from one cell boundry to other ";
fibr.startx2 = 0.1065;
// fibr_docum.startx2 = "distance from edge or from one cell boundry to other 2:for 2nd and 3rd cell";
fibr.starty2 = 0.1065;
// fibr_docum.starty2 = "distance from edge or from one cell boundry to other ";
fibr.stepx = 0.213;
// fibr_docum.stepx = "distance between fibers center to center";
fibr.stepy = 0.213;
// fibr_docum.stepy = "distance between fibers center to center";
FIBR.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill lgla
++lgla._index;
lgla.version = 1.0;
// lgla_docum.version = "face center of calorimeter";
lgla.x = 0.0;
// lgla_docum.x = "x cdt from center of TPC";
lgla.y = 0.0;
// lgla_docum.y = "y cdt from center of TPC";
lgla.z = -600.0;
// lgla_docum.z = "z cdt from center of TPC";
lgla.dx = 14.5/2.0;
// lgla_docum.dx = "HCMO width";
lgla.dy = 14.5/2.0;
// lgla_docum.dy = "HCMO height + shild hight";
lgla.dz = 35.0/2.0;
// lgla_docum.dz = "HCMO length";
lgla.density = 3.86;
// lgla_docum.density = " gdensity [/cm^3] ";
lgla.radlen = 2.5;
// lgla_docum.radlen = " radiation length [cm] ";
lgla.pbcont = 65.4;
// lgla_docum.pbcont = " PbO content [%] ";
lgla.critene = 0.0158;
// lgla_docum.critene = " critical energy [GeV] ";
lgla.molierer = 3.32;
// lgla_docum.molierer = " Moliere radius [cm] ";
LGLA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill trap
++trap._index;
trap.version = 1.0;
// trap_docum.version = "pixels dimention";
trap.xf = -8.35;
// trap_docum.xf = "x cdt from center of TPC";
trap.yf = 0.0;
// trap_docum.yf = "y cdt from center of TPC";
trap.zf = -86.5;
// trap_docum.zf = "z cdt from center of TPC";
trap.xb = 0.0;
// trap_docum.xb = "x cdt from center of TPC";
trap.yb = -8.35;
// trap_docum.yb = "y cdt from center of TPC";
trap.zb = -83.5;
// trap_docum.zb = "z cdt from center of TPC";
trap.dx1 = 9.8/2.0;
// trap_docum.dx1 = "pixels width";
trap.dx2 = 1.8/2.0;
// trap_docum.dx2 = "pixels width";
trap.dy = 1.0/2.0;
// trap_docum.dy = "pixels height";
trap.dz = 20.0/2.0;
// trap_docum.dz = "towr length";
TRAP.fill();
        
             /// USE mcdt version=1.0;        
             MCDT.use( __mcdt_version__ = 1.0 );
        
             /// USE towr version=1.0;        
             TOWR.use( __towr_version__ = 1.0 );
        
             /// USE cell version=1.0;        
             CELL.use( __cell_version__ = 1.0 );
        
             /// USE fibr version=1.0;        
             FIBR.use( __fibr_version__ = 1.0 );
        
             /// USE lgla version=1.0;        
             LGLA.use( __lgla_version__ = 1.0 );
        
             /// USE trap version=1.0;        
             TRAP.use( __trap_version__ = 1.0 );
        
             _create = AgCreate("HCMO");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HCMO           
                   Create("HCMO");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("HCMO");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume HCMO to mother CAVE           
                   place.TranslateX(mcdt.x);           
                   /// Translate x = mcdt.x           
                   place.TranslateY(mcdt.y);           
                   /// Translate y = mcdt.y           
                   place.TranslateZ(mcdt.z);           
                   /// Translate z = mcdt.z           
                   _stacker -> Position( AgBlock::Find("HCMO"), place );           
             } // end placement of HCMO        
       }; // HcalGeo0b     
 }; // namespace HcalGeo0b  
 