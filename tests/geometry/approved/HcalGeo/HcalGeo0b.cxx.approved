          AgBlock *HCMO::mInstance = 0;     
          AgBlock *HCMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new HCMO();        
                   return mInstance;        
          }     
          void HCMO::Block( AgCreate create )     
          {         
                ///@addtogroup HCMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HCMO");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mcdt.dx;              
                            shape.par("dy")=mcdt.dy;              
                            shape.par("dz")=mcdt.dz;              
                            /// Shape Bbox dx=mcdt.dx dy=mcdt.dy dz=mcdt.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCMO;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on i from 0 to towr.ntowerx-1 step=1           
                      for ( i=0; (1>0)? (i<=towr.ntowerx-1):(i>=towr.ntowerx-1); i+=1 )           
                      {              
                            /// Loop on j from 0 to towr.ntowery-1 step=1              
                            for ( j=0; (1>0)? (j<=towr.ntowery-1):(j>=towr.ntowery-1); j+=1 )              
                            {                 
                                  _create = AgCreate("HTWR");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create HTWR                    
                                        Create("HTWR");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("HTWR");                    
                                        place.SetMother("HCMO");                    
                                        /// Add daughter volume HTWR to mother HCMO                    
                                        place.TranslateX(-((towr.ntowerx-1)*towr.dx)+(i*towr.dx*2));                    
                                        /// Translate x = -((towr.ntowerx-1)*towr.dx)+(i*towr.dx*2)                    
                                        place.TranslateY(-((towr.ntowery-1)*towr.dy)+(j*towr.dy*2));                    
                                        /// Translate y = -((towr.ntowery-1)*towr.dy)+(j*towr.dy*2)                    
                                        place.TranslateZ(0.0);                    
                                        /// Translate z = 0.0                    
                                        _stacker -> Position( AgBlock::Find("HTWR"), place );                    
                                  } // end placement of HTWR                 
                            }              
                      }           
                      _create = AgCreate("LEDG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create LEDG              
                            Create("LEDG");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("LEDG");              
                            place.SetMother("HCMO");              
                            /// Add daughter volume LEDG to mother HCMO              
                            place.TranslateX(lgla.x);              
                            /// Translate x = lgla.x              
                            place.TranslateY(lgla.y);              
                            /// Translate y = lgla.y              
                            place.TranslateZ(lgla.z);              
                            /// Translate z = lgla.z              
                            _stacker -> Position( AgBlock::Find("LEDG"), place );              
                      } // end placement of LEDG           
                      _create = AgCreate("BBCF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create BBCF              
                            Create("BBCF");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("BBCF");              
                            place.SetMother("HCMO");              
                            /// Add daughter volume BBCF to mother HCMO              
                            place.TranslateX(trap.xf);              
                            /// Translate x = trap.xf              
                            place.TranslateY(trap.yf);              
                            /// Translate y = trap.yf              
                            place.TranslateZ(trap.zf);              
                            /// Translate z = trap.zf              
                            place.AlphaX(-90);              
                            /// Rotate: AlphaX = -90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            place.AlphaZ(-90);              
                            /// Rotate: AlphaZ = -90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("BBCF"), place );              
                      } // end placement of BBCF           
                      _create = AgCreate("BBCB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create BBCB              
                            Create("BBCB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("BBCB");              
                            place.SetMother("HCMO");              
                            /// Add daughter volume BBCB to mother HCMO              
                            place.TranslateX(trap.xb);              
                            /// Translate x = trap.xb              
                            place.TranslateY(trap.yb);              
                            /// Translate y = trap.yb              
                            place.TranslateZ(trap.zb);              
                            /// Translate z = trap.zb              
                            place.AlphaX(-90);              
                            /// Rotate: AlphaX = -90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("BBCB"), place );              
                      } // end placement of BBCB           
                      END_OF_HCMO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCMO     
