          AgBlock *HTWR::mInstance = 0;     
          AgBlock *HTWR::Instance(){        
                   if ( mInstance==0 ) mInstance = new HTWR();        
                   return mInstance;        
          }     
          void HTWR::Block( AgCreate create )     
          {         
                ///@addtogroup HTWR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Lead");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HTWR");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=towr.dx;              
                            shape.par("dy")=towr.dy;              
                            shape.par("dz")=towr.dz;              
                            /// Shape Bbox dx=towr.dx dy=towr.dy dz=towr.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HTWR;              
                            _stacker -> Build(this);              
                      }           
                      xtemp=fibr.startx1;;           
                      /// Loop on m from 0 to cell.ncellx-1 step=1           
                      for ( m=0; (1>0)? (m<=cell.ncellx-1):(m>=cell.ncellx-1); m+=1 )           
                      {              
                            ytemp=fibr.starty1;;              
                            /// Loop on n from 0 to cell.ncelly-1 step=1              
                            for ( n=0; (1>0)? (n<=cell.ncelly-1):(n>=cell.ncelly-1); n+=1 )              
                            {                 
                                  if ( m==n )                 
                                  {                    
                                        _create = AgCreate("HCES");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCES                       
                                              Create("HCES");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCES");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCES to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(n*3.33));                       
                                              /// Translate y = -3.33+(n*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCES"), place );                       
                                        } // end placement of HCES                    
                                  }                 
                                  else                 
                                  {                    
                                        _create = AgCreate("HCEL");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCEL                       
                                              Create("HCEL");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCEL");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCEL to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(n*3.33));                       
                                              /// Translate y = -3.33+(n*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCEL"), place );                       
                                        } // end placement of HCEL                    
                                  }                 
                                  ytemp=fibr.starty2;;                 
                            }              
                            xtemp=fibr.startx2;;              
                      }           
                      END_OF_HTWR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HTWR     
