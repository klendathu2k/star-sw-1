          }     
          void HFIB::Block( AgCreate create )     
          {         
                ///@addtogroup HFIB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Polystyren            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Material SensPoly isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Senspoly");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("HFIB");              
                            attr.par("seen")=0;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=fibr.rmin;              
                            shape.par("rmax")=fibr.rmax;              
                            shape.par("dz")=fibr.dz;              
                            /// Shape Tube rmin=fibr.rmin rmax=fibr.rmax dz=fibr.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HFIB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_HFIB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HFIB     
