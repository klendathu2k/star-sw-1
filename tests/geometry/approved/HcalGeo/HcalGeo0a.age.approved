      %dz = real(PRSW_Dz(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF serN.eq.3 
      IF serN.eq.3 { 
      CALL AgsReset 
      CALL agml_position_begin('FPBB') 
      %title = 'FPBB' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-x2) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-y2) 
      CALL agml_translate_y( %y ) 
      ag_z = real(z2+dzsb) 
      CALL agml_translate_z( %z ) 
      %dx = real(dx2) 
      %dy = real(dy2) 
      %dz = real(PRSW_DzBbd(3)/4.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      } !//IF serN.eq.3 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPBB
      BLOCK FPBB   is the G10 back board
      COMPONENT Si A=28.08 Z=14 W=0.6*1*28./60.
      COMPONENT O A=16 Z=8 W=0.6*2*16./60.
      COMPONENT C A=12 Z=6 W=0.4*8*12./174.
      COMPONENT H A=1 Z=1 W=0.4*14*1./174.
      COMPONENT O A=16 Z=8 W=0.4*4*16./174.
      MIXTURE g10 dens=1.7
      ATTRIBUTE FPBB seen=1 colo=7
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPPB
      BLOCK FPPB   is FMS PS Pb converter
      MATERIAL LEAD
      ATTRIBUTE FPPB seen=1 colo=6
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPSC
      BLOCK FPSC   is a piece of scintillator in FMS Preshower
      MATERIAL Polystyren
      MATERIAL FMSPS_scint isvol=1
      ATTRIBUTE FPSC seen=1 colo=4
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      Call GStPar(ag_imed, 'CUTGAM', 0.00008)
      Call GStPar(ag_imed, 'CUTELE', 0.001)
      Call GStPar(ag_imed, 'BCUTE', 0.0001)
      Call GStPar(ag_imed, 'BIRK1', 1.)
      Call GStPar(ag_imed, 'BIRK2', 0.013)
      Call GStPar(ag_imed, 'BIRK3', 9.6E-6)
      HITS FPSC birk:0:(0,10)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLIG
      BLOCK FLIG   is a light guide + SiPM board for Preshower
      MATERIAL Air
      ATTRIBUTE FLIG seen=1 colo=6 serial=1
      SHAPE box dx=PRSW_DPRS(1)/2.0 dy=PRSW_Dz(1)/2.0+PRSW_DSIPM(1)/2.0,
            dz=dlg
      CREATE FLBA
      CREATE FLCO
      CREATE FPMT
      CREATE FFEE
      CALL AgsReset 
      CALL agml_position_begin('FLBA') 
      %title = 'FLBA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FLCO') 
      %title = 'FLCO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-PRSW_DPRS(1)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FLCO') 
      %title = 'FLCO' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+PRSW_DPRS(1)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FPMT') 
      %title = 'FPMT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FFEE') 
      %title = 'FFEE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(PRSW_Dz(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(4)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLLG
      BLOCK FLLG   is a light guide + SiPM board for Preshower for large
      MATERIAL Air
      ATTRIBUTE FLLG seen=1 colo=6 serial=1
      SHAPE box dx=PRSW_DPRS(2)/2.0 dy=PRSW_Dz(1)/2.0+PRSW_DSIPM(1)/2.0,
            dz=dlg
      CREATE FBLL
      CREATE FCLL
      CREATE FPMT
      CREATE FFEE
      CALL AgsReset 
      CALL agml_position_begin('FBLL') 
      %title = 'FBLL' 
      %exname = 'POSITION' ! agml placement 
