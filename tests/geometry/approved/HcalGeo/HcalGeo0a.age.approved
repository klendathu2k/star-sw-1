      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)/2.0-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FCLL') 
      %title = 'FCLL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-PRSW_DPRS(2)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FCLL') 
      %title = 'FCLL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( PRSW_DPRS(2)/4.0) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(PRSW_DLG(3)+PRSW_DLG(2)/2-dlg) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FPMT') 
      %title = 'FPMT' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(1)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FFEE') 
      %title = 'FFEE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(PRSW_Dz(1)/2.0) 
      CALL agml_translate_y( %y ) 
      ag_z = real(dlg-PRSW_DSIPM(4)/2.0) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLBA
      BLOCK FLBA   is a light guide base for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FLBA seen=1 colo=4 serial=1
      SHAPE box dx=PRSW_DPRS(1)/2.0 dy=PRSW_DZ(serN)/2.0,
            dz=PRSW_DLG(3)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FBLL
      BLOCK FBLL   is a light guide base for Preshower large
      MATERIAL Polystyren
      ATTRIBUTE FBLL seen=1 colo=4 serial=1
      SHAPE box dx=PRSW_DPRS(2)/2.0 dy=PRSW_DZ(serN)/2.0,
            dz=PRSW_DLG(3)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FLCO
      BLOCK FLCO   is a light guide cone for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FLCO seen=1 colo=4 serial=1
      SHAPE trd2 dx1=PRSW_DPRS(1)/4.0 dx2=PRSW_DLG(1)/2.0,
            dy1=PRSW_DZ(serN)/2.0 dy2=PRSW_DLG(1)/2.0,
            dz=PRSW_DLG(2)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FCLL
      BLOCK FCLL   is a light guide cone for Preshower large
      MATERIAL Polystyren
      ATTRIBUTE FCLL seen=1 colo=4 serial=1
      SHAPE trd2 dx1=PRSW_DPRS(2)/4.0 dx2=PRSW_DLG(1)/2.0,
            dy1=PRSW_DZ(serN)/2.0 dy2=PRSW_DLG(1)/2.0,
            dz=PRSW_DLG(2)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FPMT
      BLOCK FPMT   is a SiPM board for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FPMT seen=1 colo=3 serial=1
      SHAPE box dx=PRSW_DSIPM(2)/2.0 dy=PRSW_DSIPM(3)/2.0,
            dz=PRSW_DSIPM(1)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FFEE
      BLOCK FFEE   is a FEE board for Preshower
      MATERIAL Polystyren
      ATTRIBUTE FEEE seen=1 colo=3 serial=1
      SHAPE box dx=PRSW_DSIPM(2)/2.0 dy=PRSW_DSIPM(1)/2.0,
            dz=PRSW_DSIPM(4)/2.0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPPL
      BLOCK WPPL   is a pole for west platform
      MATERIAL Iron
      ATTRIBUTE WPPL seen=1 colo=4
      SHAPE box dx=WPFM_PoleD(1)/2.0 dy=WPFM_PoleD(2)/2.0,
            dz=WPFM_PoleD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_PoleD(1)/2.0-WPFM_PoleD(4)) 
      %dy = real(WPFM_PoleD(2)/2.0) 
      %dz = real(WPFM_PoleD(3)/2.0-WPFM_PoleD(4)) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPIS
      BLOCK WPIS   is a I-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPIS seen=1 colo=4
      SHAPE box dx=WPFM_IstrD(1)/2.0 dy=WPFM_IstrD(2)/2.0,
            dz=WPFM_IstrD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(+(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-(WPFM_IstrD(3)/4.0-WPFM_IstrD(4)/2.0)) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_IstrD(1)/2.0) 
      %dy = real(WPFM_IstrD(2)/2.0-WPFM_IstrD(4)) 
      %dz = real((WPFM_IstrD(3)/2.0-WPFM_IstrD(4)/2.0)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUF
      BLOCK WPUF   is a front U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUF seen=1 colo=4
      SHAPE box dx=WPFM_UstFD(1)/2.0 dy=WPFM_UstFD(2)/2.0,
            dz=WPFM_UstFD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(WPFM_UstFD(4)/2.0) 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstFD(1)/2.0) 
      %dy = real(WPFM_UstFD(2)/2.0-WPFM_UstFD(4)) 
      %dz = real(WPFM_UstFD(3)/2.0-WPFM_UstFD(4)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUN
      BLOCK WPUN   is a north U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUN seen=1 colo=4
      SHAPE box dx=WPFM_UstND(1)/2.0 dy=WPFM_UstND(2)/2.0,
            dz=WPFM_UstND(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(+WPFM_UstND(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstND(1)/2.0-WPFM_UstND(4)/2.0) 
      %dy = real(WPFM_UstND(2)/2.0-WPFM_UstND(4)) 
      %dz = real(WPFM_UstND(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPUS
      BLOCK WPUS   is a south U-struct for west platform
      MATERIAL Iron
      ATTRIBUTE WPUS seen=1 colo=4
      SHAPE box dx=WPFM_UstSD(1)/2.0 dy=WPFM_UstSD(2)/2.0,
            dz=WPFM_UstSD(3)/2.0
      CALL AgsReset 
      CALL agml_position_begin('WPAR') 
      %title = 'WPAR' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-WPFM_UstSD(4)/2.0) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      %dx = real(WPFM_UstSD(1)/2.0-WPFM_UstSD(4)/2.0) 
      %dy = real(WPFM_UstSD(2)/2.0-WPFM_UstSD(4)) 
      %dz = real(WPFM_UstSD(3)/2.0) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- WPAR
      BLOCK WPAR   is a platform structs air
      MATERIAL Air
      ATTRIBUTE WPAR seen=1 colo=0
      SHAPE box dx=0.0 dy=0.0 dz=0.0
      ENDBLOCK
