                            AgShape myshape; // undefined shape              
                            ///Create HFIC              
                            Create("HFIC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HFIC");              
                            place.SetMother("HCLY");              
                            /// Add daughter volume HFIC to mother HCLY              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            _stacker -> Position( AgBlock::Find("HFIC"), place );              
                      } // end placement of HFIC           
                      END_OF_HCLY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCLY     
