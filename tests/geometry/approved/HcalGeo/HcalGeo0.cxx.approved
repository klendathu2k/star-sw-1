          AgBlock *HSWR::mInstance = 0;     
          AgBlock *HSWR::Instance(){        
                   if ( mInstance==0 ) mInstance = new HSWR();        
                   return mInstance;        
          }     
          void HSWR::Block( AgCreate create )     
          {         
                ///@addtogroup HSWR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=25.0;              
                            shape.par("dy")=50.0;              
                            shape.par("dz")=8.0;              
                            /// Shape Bbox dx=25.0 dy=50.0 dz=8.0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HSWR;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on i from 0 to pres.strips-1 step=1           
                      for ( i=0; (1>0)? (i<=pres.strips-1):(i>=pres.strips-1); i+=1 )           
                      {              
                            _create = AgCreate("HSTP");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create HSTP                 
                                  Create("HSTP");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("HSTP");                 
                                  place.SetMother("HSWR");                 
                                  /// Add daughter volume HSTP to mother HSWR                 
                                  place.TranslateX(-23.75+(i*2*pres.strpxd));                 
                                  /// Translate x = -23.75+(i*2*pres.strpxd)                 
                                  place.TranslateY(0.0);                 
                                  /// Translate y = 0.0                 
                                  place.TranslateZ(0.0);                 
                                  /// Translate z = 0.0                 
                                  _stacker -> Position( AgBlock::Find("HSTP"), place );                 
                            } // end placement of HSTP              
                      }           
                      END_OF_HSWR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HSWR     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HSTP::mInstance = 0;     
          AgBlock *HSTP::Instance(){        
                   if ( mInstance==0 ) mInstance = new HSTP();        
                   return mInstance;        
