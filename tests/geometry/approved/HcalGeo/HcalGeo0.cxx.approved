                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCSY;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HFIB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HFIB              
                            Create("HFIB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HFIB");              
                            place.SetMother("HCSY");              
                            /// Add daughter volume HFIB to mother HCSY              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0.0);              
                            /// Translate z = 0.0              
                            _stacker -> Position( AgBlock::Find("HFIB"), place );              
                      } // end placement of HFIB           
                      END_OF_HCSY:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCSY     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HCLX::mInstance = 0;     
          AgBlock *HCLX::Instance(){        
                   if ( mInstance==0 ) mInstance = new HCLX();        
                   return mInstance;        
          }     
          void HCLX::Block( AgCreate create )     
          {         
                ///@addtogroup HCLX_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Lead");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Division");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("ndiv")=cell.nfiberxl;              
                            shape.par("iaxis")=1;              
                            /// Shape Division ndiv=cell.nfiberxl iaxis=1               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCLX;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("HCLY");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HCLY              
                            Create("HCLY");               
                      }           
                      END_OF_HCLX:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCLX     
          // ---------------------------------------------------------------------------------------------------     
