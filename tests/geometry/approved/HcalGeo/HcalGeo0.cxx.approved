    // ----------------------------------------------------------------------- geoctr
       void HcalGeo0::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup HcalGeo0_revision        
             ///@{           
                   /// Author: Prashanth S (KSU)           
             ///@}        
             ///@addtogroup HcalGeo0_revision        
             ///@{           
                   /// Created: 12/30/2013           
             ///@}        
             AddBlock("HCMO", HCMO::Instance());        
             AddBlock("HTWR", HTWR::Instance());        
             AddBlock("HCEL", HCEL::Instance());        
             AddBlock("HCES", HCES::Instance());        
             AddBlock("HCLX", HCLX::Instance());        
             AddBlock("HCLY", HCLY::Instance());        
             AddBlock("HCSX", HCSX::Instance());        
             AddBlock("HCSY", HCSY::Instance());        
             AddBlock("HFIB", HFIB::Instance());        
             AddBlock("HFIC", HFIC::Instance());        
             AddBlock("HSLD", HSLD::Instance());        
             AddBlock("HSWR", HSWR::Instance());        
             AddBlock("HSTP", HSTP::Instance());        
             AddBlock("HSFE", HSFE::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mcdt
++mcdt._index;
mcdt.version = 1.0;
// mcdt_docum.version = "face center of calorimeter";
mcdt.x = -69.8;
// mcdt_docum.x = "x cdt from center of TPC";
mcdt.y = 4.9;
// mcdt_docum.y = "y cdt from center of TPC";
mcdt.z = 777.4;
// mcdt_docum.z = "z cdt from center of TPC";
mcdt.dx = 60/2.;
// mcdt_docum.dx = "HCMO width";
mcdt.dy = (60+5)/2.;
// mcdt_docum.dy = "HCMO height + shild hight";
mcdt.dz = 117/2.;
// mcdt_docum.dz = "HCMO length";
MCDT.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill towr
++towr._index;
towr.version = 1.0;
// towr_docum.version = "towr dimention";
towr.dx = 10.0/2.;
// towr_docum.dx = "towr width";
towr.dy = 10.0/2.;
// towr_docum.dy = "towr height";
towr.dz = 117.0/2.;
// towr_docum.dz = "towr length";
towr.ntowerx = 6;
// towr_docum.ntowerx = "no of tower in X dir";
towr.ntowery = 6;
// towr_docum.ntowery = "no of tower in Y dir";
TOWR.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill cell
++cell._index;
cell.version = 1.0;
// cell_docum.version = "pixels dimention";
cell.dx = 3.3/2.;
// cell_docum.dx = "pixels width";
cell.dy = 3.3/2.;
// cell_docum.dy = "pixels height";
cell.dz = 117.0/2.;
// cell_docum.dz = "towr length";
cell.ncellx = 3;
// cell_docum.ncellx = "no of cells in X dir";
cell.ncelly = 3;
// cell_docum.ncelly = "no of cells in Y dir";
cell.nfiberxl = 16;
// cell_docum.nfiberxl = "no fibers in cell 16 fibers";
cell.nfiberyl = 16;
// cell_docum.nfiberyl = "no fibers in cell 16 fibers";
cell.nfiberxs = 15;
// cell_docum.nfiberxs = "no fibers in cell 15 fibers";
cell.nfiberys = 15;
// cell_docum.nfiberys = "no fibers in cell 15 fibers";
CELL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fibr
++fibr._index;
fibr.version = 1.0;
// fibr_docum.version = "fiber dimention";
fibr.rmin = 0.0;
// fibr_docum.rmin = "inner radius of fiber";
fibr.rmax = 0.055;
// fibr_docum.rmax = "outer radius of fiber";
fibr.dz = 117.0/2.;
// fibr_docum.dz = "towr length";
fibr.startx1 = 0.107;
// fibr_docum.startx1 = "distance from edge or from one cell boundry to other 1: for first cell ";
fibr.starty1 = 0.107;
// fibr_docum.starty1 = "distance from edge or from one cell boundry to other ";
fibr.startx2 = 0.1065;
// fibr_docum.startx2 = "distance from edge or from one cell boundry to other 2:for 2nd and 3rd cell";
fibr.starty2 = 0.1065;
// fibr_docum.starty2 = "distance from edge or from one cell boundry to other ";
fibr.stepx = 0.213;
// fibr_docum.stepx = "distance between fibers center to center";
fibr.stepy = 0.213;
// fibr_docum.stepy = "distance between fibers center to center";
FIBR.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill shld
++shld._index;
shld.version = 1.0;
// shld_docum.version = "None";
shld.xd = 0.0;
// shld_docum.xd = "None";
shld.yd = -32.5;
// shld_docum.yd = "None";
shld.zd = 0.0;
// shld_docum.zd = "None";
shld.dxd = 35.0;
// shld_docum.dxd = "None";
shld.dyd = 5.0/2;
// shld_docum.dyd = "None";
shld.dzd = 127.0/2;
// shld_docum.dzd = "None";
SHLD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pres
++pres._index;
pres.version = 1.0;
// pres_docum.version = "None";
pres.xp1 = 0.0;
// pres_docum.xp1 = "None";
pres.yp1 = 0.0;
// pres_docum.yp1 = "None";
pres.zp1 = 707.2;
// pres_docum.zp1 = "None";
pres.rp1 = 45.0;
// pres_docum.rp1 = "None";
pres.xp2 = 0.0;
// pres_docum.xp2 = "None";
pres.yp2 = 0.0;
// pres_docum.yp2 = "None";
pres.zp2 = 711.2;
// pres_docum.zp2 = "None";
pres.rp2 = -45.0;
// pres_docum.rp2 = "None";
pres.xfe = 0.0;
// pres_docum.xfe = "None";
pres.yfe = 0.0;
// pres_docum.yfe = "None";
pres.zfe = 709.2;
// pres_docum.zfe = "None";
pres.rfe = 45.0;
// pres_docum.rfe = "None";
pres.strpxd = 1.25;
// pres_docum.strpxd = "None";
pres.strpyd = 45.0;
// pres_docum.strpyd = "None";
pres.strpzd = 0.50;
// pres_docum.strpzd = "None";
pres.fexd = 24.1;
// pres_docum.fexd = "None";
pres.feyd = 24.1;
// pres_docum.feyd = "None";
pres.fezd = 0.31;
// pres_docum.fezd = "None";
pres.strips = 20;
// pres_docum.strips = "None";
PRES.fill();
        
             /// USE mcdt version=1.0;        
             MCDT.use( __mcdt_version__ = 1.0 );
        
             /// USE towr version=1.0;        
             TOWR.use( __towr_version__ = 1.0 );
        
             /// USE cell version=1.0;        
             CELL.use( __cell_version__ = 1.0 );
        
             /// USE fibr version=1.0;        
             FIBR.use( __fibr_version__ = 1.0 );
        
             /// USE shld version=1.0;        
             SHLD.use( __shld_version__ = 1.0 );
        
             /// USE pres version=1.0;        
             PRES.use( __pres_version__ = 1.0 );
        
             _create = AgCreate("HCMO");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HCMO           
                   Create("HCMO");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("HCMO");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume HCMO to mother CAVE           
                   place.TranslateX(mcdt.x);           
                   /// Translate x = mcdt.x           
                   place.TranslateY(mcdt.y);           
                   /// Translate y = mcdt.y           
                   place.TranslateZ(mcdt.z);           
                   /// Translate z = mcdt.z           
                   _stacker -> Position( AgBlock::Find("HCMO"), place );           
             } // end placement of HCMO        
             _create = AgCreate("HSWR");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HSWR           
                   Create("HSWR");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("HSWR");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume HSWR to mother CAVE           
                   place.TranslateX(pres.xp2);           
                   /// Translate x = pres.xp2           
                   place.TranslateY(pres.yp2);           
                   /// Translate y = pres.yp2           
                   place.TranslateZ(pres.zp2);           
                   /// Translate z = pres.zp2           
                   place.AlphaZ(pres.rp2);           
                   /// Rotate: AlphaZ = pres.rp2           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("HSWR"), place );           
             } // end placement of HSWR        
             _create = AgCreate("HSFE");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HSFE           
                   Create("HSFE");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("HSFE");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume HSFE to mother CAVE           
                   place.TranslateX(pres.xfe);           
                   /// Translate x = pres.xfe           
                   place.TranslateY(pres.yfe);           
                   /// Translate y = pres.yfe           
                   place.TranslateZ(pres.zfe);           
                   /// Translate z = pres.zfe           
                   place.AlphaZ(pres.rfe);           
                   /// Rotate: AlphaZ = pres.rfe           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("HSFE"), place );           
             } // end placement of HSFE        
             _create = AgCreate("HSWR");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create HSWR           
                   Create("HSWR");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("HSWR");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume HSWR to mother CAVE           
                   place.TranslateX(pres.xp1);           
                   /// Translate x = pres.xp1           
                   place.TranslateY(pres.yp1);           
                   /// Translate y = pres.yp1           
                   place.TranslateZ(pres.zp1);           
                   /// Translate z = pres.zp1           
                   place.AlphaZ(pres.rp1);           
                   /// Rotate: AlphaZ = pres.rp1           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 0           
                   /// G3 Reference: phiz = 0           
                   _stacker -> Position( AgBlock::Find("HSWR"), place );           
             } // end placement of HSWR        
       }; // HcalGeo0     
 }; // namespace HcalGeo0  
 