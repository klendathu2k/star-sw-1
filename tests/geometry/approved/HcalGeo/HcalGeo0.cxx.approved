          AgBlock *HCMO::mInstance = 0;     
          AgBlock *HCMO::Instance(){        
                   if ( mInstance==0 ) mInstance = new HCMO();        
                   return mInstance;        
          }     
          void HCMO::Block( AgCreate create )     
          {         
                ///@addtogroup HCMO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mcdt.dx;              
                            shape.par("dy")=mcdt.dy;              
                            shape.par("dz")=mcdt.dz;              
                            /// Shape Bbox dx=mcdt.dx dy=mcdt.dy dz=mcdt.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HCMO;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on i from 0 to towr.ntowerx-1 step=1           
                      for ( i=0; (1>0)? (i<=towr.ntowerx-1):(i>=towr.ntowerx-1); i+=1 )           
                      {              
                            /// Loop on j from 0 to towr.ntowery-1 step=1              
                            for ( j=0; (1>0)? (j<=towr.ntowery-1):(j>=towr.ntowery-1); j+=1 )              
                            {                 
                                  _create = AgCreate("HTWR");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create HTWR                    
                                        Create("HTWR");                     
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("HTWR");                    
                                        place.SetMother("HCMO");                    
                                        /// Add daughter volume HTWR to mother HCMO                    
                                        place.TranslateX(-((towr.ntowerx-1)*towr.dx)+(i*towr.dx*2));                    
                                        /// Translate x = -((towr.ntowerx-1)*towr.dx)+(i*towr.dx*2)                    
                                        place.TranslateY(-((towr.ntowery-1)*towr.dy)+(j*towr.dy*2));                    
                                        /// Translate y = -((towr.ntowery-1)*towr.dy)+(j*towr.dy*2)                    
                                        place.TranslateZ(0.0);                    
                                        /// Translate z = 0.0                    
                                        _stacker -> Position( AgBlock::Find("HTWR"), place );                    
                                  } // end placement of HTWR                 
                            }              
                      }           
                      _create = AgCreate("HSLD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create HSLD              
                            Create("HSLD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("HSLD");              
                            place.SetMother("HCMO");              
                            /// Add daughter volume HSLD to mother HCMO              
                            place.TranslateX(shld.xd);              
                            /// Translate x = shld.xd              
                            place.TranslateY(shld.yd);              
                            /// Translate y = shld.yd              
                            place.TranslateZ(shld.zd);              
                            /// Translate z = shld.zd              
                            _stacker -> Position( AgBlock::Find("HSLD"), place );              
                      } // end placement of HSLD           
                      END_OF_HCMO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HCMO     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *HTWR::mInstance = 0;     
          AgBlock *HTWR::Instance(){        
                   if ( mInstance==0 ) mInstance = new HTWR();        
                   return mInstance;        
          }     
          void HTWR::Block( AgCreate create )     
          {         
                ///@addtogroup HTWR_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Lead            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Lead");              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("None");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=towr.dx;              
                            shape.par("dy")=towr.dy;              
                            shape.par("dz")=towr.dz;              
                            /// Shape Bbox dx=towr.dx dy=towr.dy dz=towr.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_HTWR;              
                            _stacker -> Build(this);              
                      }           
                      xtemp=fibr.startx1;;           
                      /// Loop on m from 0 to cell.ncellx-1 step=1           
                      for ( m=0; (1>0)? (m<=cell.ncellx-1):(m>=cell.ncellx-1); m+=1 )           
                      {              
                            ytemp=fibr.starty1;;              
                            /// Loop on n from 0 to cell.ncelly-1 step=1              
                            for ( n=0; (1>0)? (n<=cell.ncelly-1):(n>=cell.ncelly-1); n+=1 )              
                            {                 
                                  if ( m==n )                 
                                  {                    
                                        _create = AgCreate("HCES");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCES                       
                                              Create("HCES");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCES");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCES to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(n*3.33));                       
                                              /// Translate y = -3.33+(n*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCES"), place );                       
                                        } // end placement of HCES                    
                                  }                 
                                  else                 
                                  {                    
                                        _create = AgCreate("HCEL");                    
                                        {                       
                                              AgShape myshape; // undefined shape                       
                                              ///Create HCEL                       
                                              Create("HCEL");                        
                                        }                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("HCEL");                       
                                              place.SetMother("HTWR");                       
                                              /// Add daughter volume HCEL to mother HTWR                       
                                              place.TranslateX(-3.33+(3.33*m));                       
                                              /// Translate x = -3.33+(3.33*m)                       
                                              place.TranslateY(-3.33+(n*3.33));                       
                                              /// Translate y = -3.33+(n*3.33)                       
                                              place.TranslateZ(0.0);                       
                                              /// Translate z = 0.0                       
                                              _stacker -> Position( AgBlock::Find("HCEL"), place );                       
                                        } // end placement of HCEL                    
                                  }                 
                                  ytemp=fibr.starty2;;                 
                            }              
                            xtemp=fibr.startx2;;              
                      }           
                      END_OF_HTWR:           
                      mCurrent = _save;           
                ///@}        
          } // End Block HTWR     
