                   if ( mInstance==0 ) mInstance = new FSBA();        
                   return mInstance;        
          }     
          void FSBA::Block( AgCreate create )     
          {         
                ///@addtogroup FSBA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FSBA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=ftpg.sbsrdx;              
                            shape.par("dy")=ftpg.sbsrdy;              
                            shape.par("dz")=ftpg.sbsrdz;              
                            /// Shape Bbox dx=ftpg.sbsrdx dy=ftpg.sbsrdy dz=ftpg.sbsrdz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSBA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FSBA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSBA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FPAD::mInstance = 0;     
          AgBlock *FPAD::Instance(){        
                   if ( mInstance==0 ) mInstance = new FPAD();        
                   return mInstance;        
          }     
          void FPAD::Block( AgCreate create )     
          {         
                ///@addtogroup FPAD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material MYLAR            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Mylar");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FPAD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=ftpg.rgasout-0.25;              
                            shape.par("rmax")=ftpg.rgasout;              
                            shape.par("dz")=ftpg.gasvoldz;              
                            /// Shape Tube rmin=ftpg.rgasout-0.25 rmax=ftpg.rgasout dz=ftpg.gasvoldz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FPAD;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FPAD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FPAD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FFRA::mInstance = 0;     
          AgBlock *FFRA::Instance(){        
                   if ( mInstance==0 ) mInstance = new FFRA();        
                   return mInstance;        
          }     
          void FFRA::Block( AgCreate create )     
          {         
                ///@addtogroup FFRA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("FFRA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      temp1=(ftpg.rgasout-(ftpg.rinnerms+ftpg.drinall1+ftpg.drinisol+ftpg.drinall2))/18;           
                      temp2=ftpg.rinnerms+ftpg.drinall1+ftpg.drinisol+ftpg.drinall2;           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=temp2+iring*temp1-ffcc.ridr/2;              
                            shape.par("rmax")=temp2+iring*temp1+ffcc.ridr/2;              
                            shape.par("dz")=ffcc.rithick/2;              
                            /// Shape Tube rmin=temp2+iring*temp1-ffcc.ridr/2 rmax=temp2+iring*temp1+ffcc.ridr/2 dz=ffcc.rithick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FFRA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FFRA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FFRA     
    // ----------------------------------------------------------------------- geoctr
       void FTPCGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup FTPCGEO_revision        
             ///@{           
                   /// Author: Andreas Schuettauf           
             ///@}        
             ///@addtogroup FTPCGEO_revision        
             ///@{           
                   /// Created:   03-Apr-98            
             ///@}        
             AddBlock("FTPC", FTPC::Instance());        
             AddBlock("FIAL", FIAL::Instance());        
             AddBlock("FMPT", FMPT::Instance());        
             AddBlock("FOAL", FOAL::Instance());        
             AddBlock("FGAS", FGAS::Instance());        
             AddBlock("FSEN", FSEN::Instance());        
             AddBlock("FSEC", FSEC::Instance());        
             AddBlock("FIFR", FIFR::Instance());        
             AddBlock("FKWI", FKWI::Instance());        
             AddBlock("FFSL", FFSL::Instance());        
             AddBlock("FFCE", FFCE::Instance());        
             AddBlock("FROS", FROS::Instance());        
             AddBlock("FROM", FROM::Instance());        
             AddBlock("FROB", FROB::Instance());        
             AddBlock("FROE", FROE::Instance());        
             AddBlock("FROL", FROL::Instance());        
             AddBlock("FROP", FROP::Instance());        
             AddBlock("FROT", FROT::Instance());        
             AddBlock("FREL", FREL::Instance());        
             AddBlock("FRCC", FRCC::Instance());        
             AddBlock("FRCE", FRCE::Instance());        
             AddBlock("FSER", FSER::Instance());        
             AddBlock("FSRA", FSRA::Instance());        
             AddBlock("FSRB", FSRB::Instance());        
             AddBlock("FSPG", FSPG::Instance());        
             AddBlock("FSPI", FSPI::Instance());        
             AddBlock("FSSM", FSSM::Instance());        
             AddBlock("FSRI", FSRI::Instance());        
             AddBlock("FSBA", FSBA::Instance());        
             AddBlock("FPAD", FPAD::Instance());        
             AddBlock("FFRA", FFRA::Instance());        
             iflaga.at(0) = 0;        
             iflaga.at(1) = 1;        
             iflaga.at(2) = 1;        
             iflaga.at(3) = 2;        
             iflaga.at(4) = 2;        
             iflagb.at(0) = 0;        
             iflagb.at(1) = 0;        
             iflagb.at(2) = 1;        
             iflagb.at(3) = 1;        
             iflagb.at(4) = 2;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ftpg
++ftpg._index;
ftpg.version = 1;
// ftpg_docum.version = " geometry Version ";
ftpg.rinnerms = 7.55;
// ftpg_docum.rinnerms = " innermost radius of envelope ";
ftpg.routerms = 36.4;
// ftpg_docum.routerms = " outermost radius of envelope ";
ftpg.rgasout = 30.6;
// ftpg_docum.rgasout = " outer radius of the gas-volume ";
ftpg.rrom = 29.42;
// ftpg_docum.rrom = " outer radius for one readout module in a ring ";
ftpg.relcard = 32.4;
// ftpg_docum.relcard = " outer radius for the electronic card   ";
ftpg.rcooplm = 33.7;
// ftpg_docum.rcooplm = " outer radius for the cooling plate middle ";
ftpg.rcoople = 36.0;
// ftpg_docum.rcoople = " outer radius for the cooling plate ends ";
ftpg.zstart = 150;
// ftpg_docum.zstart = " distance from the interaction point ";
ftpg.totlen = 119;
// ftpg_docum.totlen = " overall length ";
ftpg.laylen = 2.0;
// ftpg_docum.laylen = " thickness of the sensitive Layer ";
ftpg.hitlay = 10;
// ftpg_docum.hitlay = " # of padrows in one FTPC : 10 ";
ftpg.drinall1 = 0.05;
// ftpg_docum.drinall1 = " thickness of inner Al-Layer of inner Tube ";
ftpg.drinall2 = 0.05;
// ftpg_docum.drinall2 = " thickness of outer Al-Layer of inner Tube ";
ftpg.drinisol = 0.4;
// ftpg_docum.drinisol = " thickness of plastic insulation of inner tube ";
ftpg.dzkapton = 0.02;
// ftpg_docum.dzkapton = " thickness of a double kapton-windows ";
ftpg.drifr = 1.15;
// ftpg_docum.drifr = " thickness (r) of inner flange ring ";
ftpg.dzifr = 0.4;
// ftpg_docum.dzifr = " thickness (z) of inner flange ring ";
ftpg.dzer = 10.35;
// ftpg_docum.dzer = " thickness (z) of Endring ";
ftpg.dzrom = 21.3;
// ftpg_docum.dzrom = " Distance of one Readout module Ring to coor.  ";
ftpg.dzsura = 10.65;
// ftpg_docum.dzsura = " Distance to inner(a) Support Ring from coor.  ";
ftpg.dzsurb = 31.95;
// ftpg_docum.dzsurb = " Distance to outer(b) Support Ring from coor. ";
ftpg.dzsmpr = 8.5;
// ftpg_docum.dzsmpr = " Distance Small between to Pad Rows ";
ftpg.dzbipr = 12.80;
// ftpg_docum.dzbipr = " Distance Big between to Pad Rows   ";
ftpg.msrdz = 4.1;
// ftpg_docum.msrdz = " half length of main support ring ";
ftpg.serhole = 0.5;
// ftpg_docum.serhole = " half Support End Ring Hole length Z ";
ftpg.risring = 30.8;
// ftpg_docum.risring = " outer Radius for innner Support Ring ";
ftpg.isringdz = 3.1;
// ftpg_docum.isringdz = " Half length for inner Support Ring ";
ftpg.sbsrdx = 0.7;
// ftpg_docum.sbsrdx = " Half width of Stabil. Block for Supp.Ring  ";
ftpg.sbsrdy = 2.8;
// ftpg_docum.sbsrdy = " Half thick. of Stabil. Block for Supp.Ring  ";
ftpg.sbsrdz = 3.1;
// ftpg_docum.sbsrdz = " Half length of Stabil. Block for Supp.Ring ";
ftpg.gasvoldz = 59.5;
// ftpg_docum.gasvoldz = " Half length of active volume ";
FTPG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ffcc
++ffcc._index;
ffcc.version = 1;
// ffcc_docum.version = " geometry Version ";
ffcc.stileng = 21;
// ffcc_docum.stileng = " lenth of the ceramic-holders ";
ffcc.stidia = .8;
// ffcc_docum.stidia = " diameter of ceramic-holders ";
ffcc.stirpos = 19.25;
// ffcc_docum.stirpos = " r-pos. of ceramic-holders ";
ffcc.rithick = .06;
// ffcc_docum.rithick = " thickness of the FC rings ";
ffcc.ridr = 1;
// ffcc_docum.ridr = " width (r) if the FC rings ";
ffcc.rigap = .3;
// ffcc_docum.rigap = " gap between two FC rings ";
ffcc.barleng = 29;
// ffcc_docum.barleng = " length of stabilizer bar for FC  ";
ffcc.barwidt = 2;
// ffcc_docum.barwidt = " width of stabilizer bar for FC ";
ffcc.barthik = .8;
// ffcc_docum.barthik = " thickness of stabilizer bar for FC   ";
FFCC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill frbd
++frbd._index;
frbd.version = 1;
// frbd_docum.version = " geometry Version ";
frbd.phi1 = 0;
// frbd_docum.phi1 = " phi 1 ";
frbd.phi2 = 30;
// frbd_docum.phi2 = " phi 2 ";
frbd.phi3 = 60;
// frbd_docum.phi3 = " phi 3 ";
frbd.phi4 = 90;
