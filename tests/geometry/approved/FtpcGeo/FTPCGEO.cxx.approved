FSSD.fill();
        
             /// USE ftpg version=1;        
             FTPG.use( __ftpg_version__ = 1 );
        
             /// USE ffcc version=1;        
             FFCC.use( __ffcc_version__ = 1 );
        
             /// USE frbd version=1;        
             FRBD.use( __frbd_version__ = 1 );
        
             /// USE fssd version=1;        
             FSSD.use( __fssd_version__ = 1 );
        
             position=ftpg.zstart+ftpg.totlen/2;        
             _create = AgCreate("FTPC");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create FTPC           
                   Create("FTPC");            
             }        
             if ( agexist("svtt")!=0 )        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FTPC");              
                         place.SetMother("SVTT");              
                         /// Add daughter volume FTPC to mother SVTT              
                         place.TranslateZ(position);              
                         /// Translate z = position              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         _stacker -> Position( AgBlock::Find("FTPC"), place );              
                   } // end placement of FTPC           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FTPC");              
                         place.SetMother("SVTT");              
                         /// Add daughter volume FTPC to mother SVTT              
                         place.TranslateZ(-position);              
                         /// Translate z = -position              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 180              
                         /// G3 Reference: phiz = 0              
                         Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;              
                         place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );              
                         _stacker -> Position( AgBlock::Find("FTPC"), place );              
                   } // end placement of FTPC           
             }        
             else        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FTPC");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume FTPC to mother CAVE              
                         place.TranslateZ(position);              
                         /// Translate z = position              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         _stacker -> Position( AgBlock::Find("FTPC"), place );              
                   } // end placement of FTPC           
                   {              
                         AgPosition  place;              
                         place.SetBlock("FTPC");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume FTPC to mother CAVE              
                         place.TranslateZ(-position);              
                         /// Translate z = -position              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 180              
                         /// G3 Reference: phiz = 0              
                         Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;              
                         place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );              
                         _stacker -> Position( AgBlock::Find("FTPC"), place );              
                   } // end placement of FTPC           
             }        
       }; // FTPCGEO     
 }; // namespace FTPCGEO  
 