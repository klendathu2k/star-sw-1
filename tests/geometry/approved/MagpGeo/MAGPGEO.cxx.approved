          void COIL::Block( AgCreate create )     
          {         
                ///@addtogroup COIL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("COIL");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=mbar.coilrmn;              
                            shape.par("rmax")=mbar.coilrmx;              
                            shape.par("dz")=mbar.coillen/2;              
                            /// Shape Tube rmin=mbar.coilrmn rmax=mbar.coilrmx dz=mbar.coillen/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_COIL;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on i_coil from 1 to nint(mbar.ncoil/2) step=1           
                      for ( i_coil=1; (1>0)? (i_coil<=nint(mbar.ncoil/2)):(i_coil>=nint(mbar.ncoil/2)); i_coil+=1 )           
                      {              
                            _create = AgCreate("MCSE");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create MCSE                 
                                  Create("MCSE");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MCSE");                 
                                  place.SetMother("COIL");                 
                                  /// Add daughter volume MCSE to mother COIL                 
                                  place.TranslateZ(+mbar.zcoil[int(i_coil)-1]);                 
                                  /// Translate z = +mbar.zcoil[int(i_coil)-1]                 
                                  _stacker -> Position( AgBlock::Find("MCSE"), place );                 
                            } // end placement of MCSE              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MCSE");                 
                                  place.SetMother("COIL");                 
                                  /// Add daughter volume MCSE to mother COIL                 
                                  place.TranslateZ(-mbar.zcoil[int(i_coil)-1]);                 
                                  /// Translate z = -mbar.zcoil[int(i_coil)-1]                 
                                  _stacker -> Position( AgBlock::Find("MCSE"), place );                 
                            } // end placement of MCSE              
                      }           
                      END_OF_COIL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block COIL     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MCSE::mInstance = 0;     
          AgBlock *MCSE::Instance(){        
                   if ( mInstance==0 ) mInstance = new MCSE();        
                   return mInstance;        
          }     
          void MCSE::Block( AgCreate create )     
          {         
                ///@addtogroup MCSE_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      if ( magg.version==1.0 )           
                      {              
                            /// Material Aluminium               
                            {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");                 
                                  _material = mat;                 
                            }              
                            { AgAttribute attr = AgAttribute("MCSE");                 
                                  attr.par("seen")=1;                 
                                  attr.par("colo")=3;                 
                                  attr.Inherit( AgBlock::previous() );                  
                                  _attribute = attr;                 
                            }              
                            {  AgShape shape = AgShape("Tube");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dz")=mbar.dzcoil[int(i_coil)-1]/2;                 
                                  /// Shape Tube dz=mbar.dzcoil[int(i_coil)-1]/2                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_MCSE;                 
                                  _stacker -> Build(this);                 
                            }              
                      }           
                      else           
                      {              
                            /// Component C	a=12	z=6	w=8.0*12.0/174.0              
                            /// Component H	a=1	z=1	w=14.0*1.0/174.0              
                            /// Component O	a=16	z=8	w=4.0*16.0/174.0              
                            /// Mixture epoxy dens=1.3              
                            {  AgMaterial &mix = AgMaterial::Get("Epoxy");                 
                                  mix.Component("C",12,6,8.0*12.0/174.0);                 
                                  mix.Component("H",1,1,14.0*1.0/174.0);                 
                                  mix.Component("O",16,8,4.0*16.0/174.0);                 
                                  mix.par("dens")=1.3;                 
                                  mix.lock();                 
                                  _material = mix;                 
                                  _material.lock();                 
                            }              
                            {  AgShape shape = AgShape("Tube");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dz")=mbar.dzcoil[int(i_coil)-1]/2;                 
                                  /// Shape Tube dz=mbar.dzcoil[int(i_coil)-1]/2                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_MCSE;                 
                                  _stacker -> Build(this);                 
                            }              
                            nzpancakes=mbar.dzcoil[int(i_coil)-1]/mbar.dzpancake;              
                            dz=mbar.dzcoil[int(i_coil)-1]/nzpancakes;              
                            nypancakes=(mbar.coilrmx-mbar.coilrmn)/mbar.dypancake;              
                            dr=(mbar.coilrmx-mbar.coilrmn)/nypancakes;              
                            /// Loop on i from 1 to nzpancakes step=1              
                            for ( i=1; (1>0)? (i<=nzpancakes):(i>=nzpancakes); i+=1 )              
                            {                 
                                  r1=mbar.coilrmn+dr*(i-0.5)-mbar.dypancake/2;                 
                                  r2=r1+mbar.dypancake;                 
                                  _create = AgCreate("PANC");                 
                                  {                    
                                        AgShape myshape; // undefined shape                    
                                        ///Create PANC                    
                                        Create("PANC");                     
                                  }                 
                                  /// Loop on j from 1 to nypancakes step=1                 
                                  for ( j=1; (1>0)? (j<=nypancakes):(j>=nypancakes); j+=1 )                 
                                  {                    
                                        {                       
                                              AgPosition  place;                       
                                              place.SetBlock("PANC");                       
                                              place.SetMother("MCSE");                       
                                              /// Add daughter volume PANC to mother MCSE                       
                                              place.TranslateZ(-mbar.dzcoil[int(i_coil)-1]/2+dz*(j-0.5));                       
                                              /// Translate z = -mbar.dzcoil[int(i_coil)-1]/2+dz*(j-0.5)                       
                                              _stacker -> Position( AgBlock::Find("PANC"), place );                       
                                        } // end placement of PANC                    
                                  }                 
                            }              
                      }           
                      END_OF_MCSE:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MCSE     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *PANC::mInstance = 0;     
          AgBlock *PANC::Instance(){        
                   if ( mInstance==0 ) mInstance = new PANC();        
                   return mInstance;        
          }     
          void PANC::Block( AgCreate create )     
          {         
                ///@addtogroup PANC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PANC");              
                            attr.par("seen")=0;              
                            attr.par("colo")=0;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=r1;              
                            shape.par("rmax")=r2;              
                            shape.par("dz")=mbar.dzpancake/2;              
                            /// Shape Tube rmin=r1 rmax=r2 dz=mbar.dzpancake/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PANC;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("PAWT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create PAWT              
                            Create("PAWT");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("PAWT");              
                            place.SetMother("PANC");              
                            /// Add daughter volume PAWT to mother PANC              
                            _stacker -> Position( AgBlock::Find("PAWT"), place );              
                      } // end placement of PAWT           
                      END_OF_PANC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PANC     
