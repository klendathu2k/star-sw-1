          AgBlock *PAWT::mInstance = 0;     
          AgBlock *PAWT::Instance(){        
                   if ( mInstance==0 ) mInstance = new PAWT();        
                   return mInstance;        
          }     
          void PAWT::Block( AgCreate create )     
          {         
                ///@addtogroup PAWT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material water            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Water");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("PAWT");              
                            attr.par("seen")=0;              
                            attr.par("colo")=2;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=(r1+r2)/2-mbar.rwater;              
                            shape.par("rmax")=(r1+r2)/2+mbar.rwater;              
                            shape.par("dz")=mbar.rwater;              
                            /// Shape Tube rmin=(r1+r2)/2-mbar.rwater rmax=(r1+r2)/2+mbar.rwater dz=mbar.rwater               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PAWT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PAWT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PAWT     
