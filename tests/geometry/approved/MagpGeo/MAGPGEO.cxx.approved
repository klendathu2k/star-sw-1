                            place.SetBlock("COIL");              
                            place.SetMother("MAGP");              
                            /// Add daughter volume COIL to mother MAGP              
                            _stacker -> Position( AgBlock::Find("COIL"), place );              
                      } // end placement of COIL           
                      _create = AgCreate("MRET");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create MRET              
                            Create("MRET");               
