    // ----------------------------------------------------------------------- geoctr
       void BbcmGeo::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup BbcmGeo_revision        
             ///@{           
                   /// Created: 15 march 2002           
             ///@}        
             ///@addtogroup BbcmGeo_revision        
             ///@{           
                   /// Author: Yiqun Wang           
             ///@}        
             AddBlock("BBCM", BBCM::Instance());        
             AddBlock("BBCA", BBCA::Instance());        
             AddBlock("THXM", THXM::Instance());        
             AddBlock("SHXT", SHXT::Instance());        
             AddBlock("BPOL", BPOL::Instance());        
             AddBlock("CLAD", CLAD::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill bbcg
++bbcg._index;
bbcg.version = 1.0;
// bbcg_docum.version = " Geometry version ";
{
bbcg_info::onoff::Type temp = {
bbcg_info::onoff::BaseType(3),
bbcg_info::onoff::BaseType(3),
bbcg_info::onoff::BaseType(3)
}
;
memcpy(&bbcg.onoff, &temp, sizeof(temp));;
}
// bbcg_docum.onoff = " 0 off, 1 west on, 2 east on, 3 both on: for BBC,Small tiles,Large tiles ";
{
bbcg_info::zdis::Type temp = {
bbcg_info::zdis::BaseType(374.24),
bbcg_info::zdis::BaseType(-374.24)
}
;
memcpy(&bbcg.zdis, &temp, sizeof(temp));;
}
// bbcg_docum.zdis = " z-coord from center in STAR (715/2+6*2.54+1=373.8) ";
BBCG.fill();
        
             /// USE bbcg _index=1;        
             BBCG.use( __bbcg__index__ = 1 );
        
             if ( bbcg.version==1.0 )        
             {           
                   // ---------------------------------------------------------------------------------------------------           
                   // Fill hexg
++hexg._index;
hexg.type = 1;
// hexg_docum.type = "1 for small hex tile, 2 for large tile ";
hexg.irad = 4.174;
// hexg_docum.irad = "inscribing circle radius =9.64/2*sin(60)=4.174 ";
hexg.clad = 0.1;
// hexg_docum.clad = "cladding thickness ";
hexg.thick = 1.0;
// hexg_docum.thick = "thickness of tile ";
hexg.zoffset = 1.5;
// hexg_docum.zoffset = "z-offset from center of BBCW (1), or BBCE (2) ";
hexg.xoffset = 0.0;
// hexg_docum.xoffset = "x-offset center from beam for BBCW (1), or BBCE (2) ";
hexg.yoffset = 0.0;
// hexg_docum.yoffset = "y-offset center from beam for BBCW (1), or BBCE (2) ";
HEXG.fill();
           
             }        
             if ( bbcg.version==1.0 )        
             {           
                   // ---------------------------------------------------------------------------------------------------           
                   // Fill hexg
++hexg._index;
hexg.type = 2;
// hexg_docum.type = "1 for small hex tile, 2 for large tile ";
hexg.irad = 16.697;
// hexg_docum.irad = "inscribing circle radius (4x that of small one) ";
hexg.clad = 0.1;
// hexg_docum.clad = "cladding of tile ";
hexg.thick = 1.0;
// hexg_docum.thick = "thickness of tile ";
hexg.zoffset = -1.5;
// hexg_docum.zoffset = "z-offset from center of BBCW (1), or BBCE (2) ";
hexg.xoffset = 0.0;
// hexg_docum.xoffset = "x-offset center from beam for BBCW (1), or BBCE (2) ";
hexg.yoffset = 0.0;
// hexg_docum.yoffset = "y-offset center from beam for BBCW (1), or BBCE (2) ";
HEXG.fill();
           
             }        
             if ( bbcg.version==2.0 )        
             {           
                   // ---------------------------------------------------------------------------------------------------           
                   // Fill hexg
++hexg._index;
hexg.type = 1;
// hexg_docum.type = "1 for small hex tile, 2 for large tile ";
hexg.irad = 4.174;
// hexg_docum.irad = "inscribing circle radius =9.64/2*sin(60)=4.174 ";
hexg.clad = 0.1;
// hexg_docum.clad = "cladding thickness ";
hexg.thick = 1.0;
// hexg_docum.thick = "thickness of tile ";
hexg.zoffset = 0.0;
// hexg_docum.zoffset = "z-offset from center of BBCW (1), or BBCE (2) ";
hexg.xoffset = 0.0;
// hexg_docum.xoffset = "x-offset center from beam for BBCW (1), or BBCE (2) ";
hexg.yoffset = 0.0;
// hexg_docum.yoffset = "y-offset center from beam for BBCW (1), or BBCE (2) ";
HEXG.fill();
           
             }        
             if ( bbcg.version==2.0 )        
             {           
                   // ---------------------------------------------------------------------------------------------------           
                   // Fill hexg
++hexg._index;
hexg.type = 2;
// hexg_docum.type = "1 for small hex tile, 2 for large tile ";
hexg.irad = 16.697;
// hexg_docum.irad = "inscribing circle radius (4x that of small one) ";
hexg.clad = 0.1;
// hexg_docum.clad = "cladding of tile ";
hexg.thick = 1.0;
// hexg_docum.thick = "thickness of tile ";
hexg.zoffset = 0.0;
// hexg_docum.zoffset = "z-offset from center of BBCW (1), or BBCE (2) ";
hexg.xoffset = 0.0;
// hexg_docum.xoffset = "x-offset center from beam for BBCW (1), or BBCE (2) ";
hexg.yoffset = 0.0;
// hexg_docum.yoffset = "y-offset center from beam for BBCW (1), or BBCE (2) ";
HEXG.fill();
           
             }        
             /// USE bbcg _index=1;        
             BBCG.use( __bbcg__index__ = 1 );
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             /// Component C5	a=12	z=6	w=5      *10000        
             /// Component H4	a=1	z=1	w=4      *10000        
             /// Component O2	a=16	z=8	w=2      *10000        
             /// Component Al	a=27	z=13	w=0.2302 *10000        
             /// Mixture ALKAP dens=1.432        
             {  AgMaterial &mix = AgMaterial::Get("Alkap");           
                   mix.Component("C5",12,6,5*10000);           
                   mix.Component("H4",1,1,4*10000);           
                   mix.Component("O2",16,8,2*10000);           
                   mix.Component("Al",27,13,0.2302*10000);           
                   mix.par("dens")=1.432;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// USE hexg type=1;        
             HEXG.use( __hexg_type__ = 1 );
        
             srad=hexg.irad*6.0;;        
             ztotal=hexg.thick+2*abs(hexg.zoffset);;        
             /// USE hexg type=2;        
             HEXG.use( __hexg_type__ = 2 );
        
             lrad=hexg.irad*6.0;;        
             ztotal=ztotal+hexg.thick+2*abs(hexg.zoffset);;        
             _create = AgCreate("BBCM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create BBCM           
                   Create("BBCM");            
             }        
             if ( bbcg.onoff[int(1)-1]==1||bbcg.onoff[int(1)-1]==3 )        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("BBCM");              
                         place.SetMother("CAVE");              
                         place.SetGroup("MagRefSys");              
                         /// Add daughter volume BBCM to mother CAVE              
                         place.TranslateX(0);              
                         /// Translate x = 0              
                         place.TranslateY(0);              
                         /// Translate y = 0              
                         place.TranslateZ(bbcg.zdis[int(1)-1]);              
                         /// Translate z = bbcg.zdis[int(1)-1]              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         _stacker -> Position( AgBlock::Find("BBCM"), place );              
                   } // end placement of BBCM           
             }        
             if ( bbcg.onoff[int(1)-1]==2||bbcg.onoff[int(1)-1]==3 )        
             {           
                   {              
                         AgPosition  place;              
                         place.SetBlock("BBCM");              
                         place.SetMother("CAVE");              
                         place.SetGroup("MagRefSys");              
                         /// Add daughter volume BBCM to mother CAVE              
                         place.TranslateX(0);              
                         /// Translate x = 0              
                         place.TranslateY(0);              
                         /// Translate y = 0              
                         place.TranslateZ(bbcg.zdis[int(2)-1]);              
                         /// Translate z = bbcg.zdis[int(2)-1]              
                         place.AlphaY(180);              
                         /// Rotate: AlphaY = 180              
                         /// G3 Reference: thetax = 90              
                         /// G3 Reference: phix = 0              
                         /// G3 Reference: thetay = 90              
                         /// G3 Reference: phiy = 90              
                         /// G3 Reference: thetaz = 0              
                         /// G3 Reference: phiz = 0              
                         _stacker -> Position( AgBlock::Find("BBCM"), place );              
                   } // end placement of BBCM           
             }        
             // Print<level=%i> fmt=%s fortran format statements not supported        
       }; // BbcmGeo     
 }; // namespace BbcmGeo  
 