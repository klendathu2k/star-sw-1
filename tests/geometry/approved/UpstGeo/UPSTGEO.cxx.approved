                            create     .SetParameters(shape);              
                            shape.par("rmax")=pipu.pginnr;              
                            /// Shape Tube rmax=pipu.pginnr               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_PVAG;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_PVAG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block PVAG     
    // ----------------------------------------------------------------------- geoctr
       void UPSTGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup UPSTGEO_revision        
             ///@{           
                   /// Created:   27-Dec-1996             
             ///@}        
             ///@addtogroup UPSTGEO_revision        
             ///@{           
                   /// Author: W.B.Christie           
             ///@}        
             AddBlock("UPST", UPST::Instance());        
             AddBlock("PUPD", PUPD::Instance());        
             AddBlock("PUPE", PUPE::Instance());        
             AddBlock("PUPF", PUPF::Instance());        
             AddBlock("DXMG", DXMG::Instance());        
             AddBlock("PVAD", PVAD::Instance());        
             AddBlock("PVAE", PVAE::Instance());        
             AddBlock("DCON", DCON::Instance());        
             AddBlock("PUPG", PUPG::Instance());        
             AddBlock("DVAC", DVAC::Instance());        
             AddBlock("PVAG", PVAG::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill pipu
++pipu._index;
pipu.version = 1;
// pipu_docum.version = " geometry version   ";
pipu.zposit = 1131.83;
// pipu_docum.zposit = " position of the upstream part ";
pipu.dz_upst = 385.63;
// pipu_docum.dz_upst = " Half length of the UPSTREAM mother volume ";
pipu.p1innr = 6.08;
// pipu_docum.p1innr = " Inner radius of Pipe in Hall ";
pipu.p1outr = 6.35;
// pipu_docum.p1outr = " Outer radius of pipe in Hall ";
pipu.p1leng = 105.5;
// pipu_docum.p1leng = " Length of Pipe in hall ";
pipu.p2innr = 6.99;
// pipu_docum.p2innr = " Large OD steel section inner radius ";
pipu.p2outr = 7.14;
// pipu_docum.p2outr = " Large OD steel section outer radius ";
pipu.p2leng = 207.92;
// pipu_docum.p2leng = " Large OD steel section half length ";
pipu.p3innr = 9.53;
// pipu_docum.p3innr = " Inner radius of large DX Pipe ";
pipu.p3outr = 10.16;
// pipu_docum.p3outr = " Outer radius of Large DX pipe ";
pipu.p3leng = 207.92;
// pipu_docum.p3leng = " Length of Large DX Pipe ";
pipu.dxinnr = 15.34;
// pipu_docum.dxinnr = " Inner RAdius of DX Iron Yoke. ";
pipu.dxoutr = 37.0;
// pipu_docum.dxoutr = " Outer RAdius of DX Iron Yoke.  ";
pipu.dxleng = 207.92;
// pipu_docum.dxleng = " HALF Length of DX MAgnet. ";
pipu.csinnr = 7.14;
// pipu_docum.csinnr = " Inner radius of Start of DX Cone ";
pipu.csoutr = 7.77;
// pipu_docum.csoutr = " Outer radius of Start of DX cone ";
pipu.ceinnr = 14.60;
// pipu_docum.ceinnr = " Inner radius at End of DX cone ";
pipu.ceoutr = 15.24;
// pipu_docum.ceoutr = " Outer radius at End of DX cone ";
pipu.cleng = 21.21;
// pipu_docum.cleng = " Half Length of Cone at end of DX. ";
pipu.pginnr = 14.60;
// pipu_docum.pginnr = " Inner radius of last Pipe ";
pipu.pgoutr = 15.24;
// pipu_docum.pgoutr = " Outer radius of last Pipe ";
pipu.pgleng = 51.0;
// pipu_docum.pgleng = " Half length of last pipe ";
PIPU.fill();
        
             /// USE pipu version=1;        
             PIPU.use( __pipu_version__ = 1 );
        
             z1=746.2;//endofthestdstarbeampipeplus2mm;        
             z2=pipu.p1leng-pipu.dz_upst;//centerofbeampipebeforedx;        
             z3=z2+pipu.p1leng+pipu.p2leng;//centerofdxmagnet(33.29);        
             z4=z3+pipu.p2leng;//endofdxmagnet(241.21);        
             z5=z4+pipu.cleng;//centerofdxcone(262.42);        
             z6=z5+pipu.cleng;//endofdxcone(283.63);        
             _create = AgCreate("UPST");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create UPST           
                   Create("UPST");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("UPST");           
                   place.SetMother("CAVE");           
                   place.SetGroup("WestRefSys");           
                   /// Add daughter volume UPST to mother CAVE           
                   place.TranslateZ(+pipu.zposit);           
                   /// Translate z = +pipu.zposit           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   _stacker -> Position( AgBlock::Find("UPST"), place );           
             } // end placement of UPST        
             {           
                   AgPosition  place;           
                   place.SetBlock("UPST");           
                   place.SetMother("CAVE");           
                   place.SetGroup("EastRefSys");           
                   /// Add daughter volume UPST to mother CAVE           
                   place.TranslateZ(-pipu.zposit);           
                   /// Translate z = -pipu.zposit           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("UPST"), place );           
             } // end placement of UPST        
       }; // UPSTGEO     
 }; // namespace UPSTGEO  
 