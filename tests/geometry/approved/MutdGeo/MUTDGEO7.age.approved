      MODULE MUTDGEO7    is the geometry of the STAR MTD
      """ AGML variables """
      REAL :: agml_rotm(9), agml_thetax, agml_phix, agml_thetay, agml_phiy, agml_thetaz,
             agml_phiz
      COMMON /agml_vars/ agml_rotm, agml_thetax, agml_phix, agml_thetay, agml_phiy,
             agml_thetaz, agml_phiz
      +CDE,agecom.
      +CDE,gcunit.
      Author W.J. Llope
      Created    13 Dec 2013
      CONTENT MUTD,
      MTTG,MTRA,MTBP,MTTP,MCHL,
      MCAL,MCHS,MCAS,MIGS,MIGG
      STRUCTURE MTDG { Version,Config}
      STRUCTURE MTDD { version,Rmin,Rmax,Ri(30),RiRun15(30),YShift08,YShift24,dZmother,
            BackLegR,BemcElectBoxdX,BemcElectBoxdY,BemcElectBoxdZ3,BemcElectBoxdZ5,Rgap,
            MtdMotherdX,MtdMotherdY,MtdMotherdZ3,MtdMotherdZ5,MtdTraydX,MtdTraydY,MtdTraydZ,
            MtdBPlate,MtdTPlate,MtdIGstackdY,MtdIGstackdZ,MtdIGstackNgaps,MtdIGstackGapThick,
            MtdIGstackThinGlassThick}
      INTEGER kTrayConfig,iphi,iBL,Ntrayplaced,igap,ngaps,	    nTrayGroup

      REAL thisphi,thisx,thisy,chandim,thish,thisr,degrad,thisphib,thisxb,thisyb,
            thisrb

      FILL MTDG		! Muon system configuration parameters
      Version = 1 !  version number
      Config = 1 !  =1 single backleg (Run11), =2 full system (Run13)
      ENDFILL
      FILL MTDD		! Muon system geometry parameters
      version = 1.0 ! default version
      Rmin = 364.25 !  integration radius lower
      Rmax = 430.0 !  integration radius upper
      Ri  = {  154.664,  154.664,  154.664,  154.664,  154.664, 
               154.664,  154.664,  160.809,  -1.0000,  154.730, 
               162.960,  162.960,  162.960,  162.960,  162.960, 
               162.960,  162.960,  162.960,  162.960,  162.960, 
               160.664,  154.730,  -1.0000,  155.664,  154.664, 
               154.664,  154.664,  154.664,  154.664,  154.664} !   radius to tray centroid in inches by Backleg ID 
      RiRun15  = {  154.814,  154.814,  154.814,  154.814, 
                    154.814,  154.814,  157.440,  158.404, 
                    -1.0000,  157.440,  160.940,  163.192, 
                    163.192,  163.192,  163.192,  163.192, 
                    163.192,  163.192,  163.192,  163.192, 
                    160.940,  157.440,  -1.0000,  163.483, 
                    157.440,  154.814,  154.814,  154.814, 
                    154.814,  154.814} !   radius to tray centroid in inches by Backleg ID in Run15
      YShift08 = 5.222 !  Backleg 8 shift for bus cover clearance
      YShift24 = -3.394 !  Backleg 24 shift for bus cover clearance
      dZmother = 300.0 !  integration half length in Z
      BackLegR = 364.2 !  radius of a backleg at phi-center
      BemcElectBoxdX = 11.035 !  BEMC electronics box half-length X (height)
      BemcElectBoxdY = 30.65 !  BEMC electronics box half-length Y (width)
      BemcElectBoxdZ5 = 290.0 !  BEMC electronics box half-length Z (length 5-pack)
      BemcElectBoxdZ3 = 200.0 !  BEMC electronics box half-length Z (length 3-pack)
      Rgap = 3.81 !  Distance top of Bemc box to underside of lowest tray
      MtdMotherdX = 4.9911 !  Tray Mother half-length X (height) (2*1.965in)*2.54/2
      MtdMotherdY = 33.8 !  Tray Mother half-length Y (width) ***was 32***
      MtdMotherdZ5 = 285.0 !  Tray Mother half-length Z (length long)
      MtdMotherdZ3 = 195.0 !  Tray Mother half-length Z (length short)
      MtdTraydX = 2.49555 !  Tray half-height (1.965in)*2.54/2
      MtdTraydY = 33.765 !  Tray half-width
      MtdTraydZ = 54.005 !  Tray half-length
      MtdBPlate = 0.3175 !  Tray bottom plate full thickness (0.125in)
      MtdTPlate = 0.2286 !  Tray top plate full thickness (0.090in)
      MtdIGstackdY = 26.1 !  WMRPC inner glass stack volume half-length Y
      MtdIGstackdZ = 43.5 !  WMRPC inner glass stack volume half-length Y
      MtdIGstackNgaps = 5.0 !  WMPRC number of gas gaps
      MtdIGstackGapThick = 0.025 !  WMRPC gas thickness (0.25mm)
      MtdIGstackThinGlassThick = 0.07 !  WMRPC thin glass thickness (0.7mm)
      ENDFILL
      FILL MTDD		! Muon system geometry parameters (revision 03/2016)
      version = 1.1 ! revision 3/16
      YShift08 = -5.222 !  Backleg 8 shift for bus cover clearance
      YShift24 = 3.394 !  Backleg 24 shift for bus cover clearance
      ENDFILL
      use MTDG
      use MTDD version=MTDG_version
      Prin0 MTDG_Version;
      (' MuTD: MTDG_Version = ', F5.3)
      Prin0 MTDG_Config;
      (' MuTD: MTDG_Config = ', F5.3)
      kTrayConfig = NINT(MTDG_Config)
      ngaps       = MTDD_MtdIGstackNgaps
      degrad      = 57.2957795;
      COMPONENT H A=1 Z=1 W=0.90*2*1./102.+0.+0.05*10*1./58.
      COMPONENT C A=12 Z=6 W=0.90*2*12./102.+0.+0.05*4*12./58.
      COMPONENT F A=19 Z=9 W=0.90*4*19./102.+0.05*6*19./146.+0.
      COMPONENT S A=32 Z=16 W=0.+0.05*1*32./146.+0.
      MIXTURE RPCgas dens=4.55E-3
      COMPONENT Si A=28 Z=14 W=1.
      COMPONENT O A=16 Z=8 W=2.
      MIXTURE Glass dens=2.5
      CREATE MUTD
      CALL AgsReset 
      CALL agml_position_begin('MUTD') 
      %mother = 'CAVE' 
      %title = 'MUTD' 
      %exname = 'POSITION' ! agml placement 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ! ---------------------------------------------------------------------------------- MUTD
      BLOCK MUTD   is the muon detector mother
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE MUTD seen=0 colo=1
      SHAPE tube rmin=MTDD_Rmin rmax=MTDD_Rmax,
            dz=MTDD_dZmother
      Ntrayplaced     = 0
      IF ( kTrayConfig.eq.4 ) THEN
      thisphi = 156
      nTrayGroup=3;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = 156.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 3
      ELSEIF ( kTrayConfig.eq.5 ) THEN
      <W> kTrayConfig;  ('MTD configuration is OBSOLETE kTrayConfig=', I3);
      ELSEIF ( kTrayConfig.eq.12 ) THEN
      <W> kTrayConfig;  ('Creating Run-12 MTD geometry with kTrayConfig=', I3);
      DO iBL = 26, 28
      thisphi = 90.0 + (iBL-1)*(-12.0)
      thisr   = MTDD_Ri(iBL)*2.54 + 0.965*2.54
      thisx   = thisr*COS(thisphi/degrad)
      thisy   = thisr*SIN(thisphi/degrad)
      IF ( iBL.eq.26 ) THEN
      nTrayGroup=3;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 3
      ELSE
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      END DO
      ELSEIF ( kTrayConfig.eq.13 ) THEN
      <W> kTrayConfig;  ('Creating Run-13 MTD geometry with kTrayConfig=', I3);
      DO iBL = 1, 30
      thisphi = 90.0 + (iBL-1)*(-12.0)
      thisr   = MTDD_Ri(iBL)*2.54 + 0.965*2.54
      thisx   = thisr*COS(thisphi/degrad)
      thisy   = thisr*SIN(thisphi/degrad)
      IF ( (iBL.ne.8.and.iBL.ne.9.and.iBL.ne.23.and.iBL.ne.24) ) THEN
      IF ( iBL.le.10.or.iBL.ge.22 ) THEN
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      ENDIF
      END DO
      ELSEIF ( kTrayConfig.eq.14 ) THEN
      DO iBL = 1, 30
      thisphi = 90.0 + (iBL-1)*(-12.0)
      thisr   = MTDD_Ri(iBL)*2.54 + 0.965*2.54
      thisx   = thisr*COS(thisphi/degrad)
      thisy   = thisr*SIN(thisphi/degrad)
      IF ( thisr.gt.0 ) THEN
      IF ( iBL.ge.12.and.iBL.le.20 ) THEN
      nTrayGroup=3;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 3
      ENDIF
      IF ( iBL.lt.12.or.iBL.gt.20 ) THEN
      IF ( iBL.ne.8.and.iBL.ne.24 ) THEN
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      IF ( iBL.eq.8 ) THEN
      thisrb   = SQRT(thisr*thisr + 2.54*MTDD_YShift08*2.54*MTDD_YShift08)
      thisphib = degrad*ATAN(2.54*MTDD_YShift08/thisr) + thisphi
      thisxb   = thisrb*COS(thisphib/degrad)
      thisyb   = thisrb*SIN(thisphib/degrad)
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisxb) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisyb) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      IF ( iBL.eq.24 ) THEN
      thisrb   = SQRT(thisr*thisr + 2.54*MTDD_YShift24*2.54*MTDD_YShift24)
      thisphib = degrad*ATAN(2.54*MTDD_YShift24/thisr) + thisphi
      thisxb   = thisrb*COS(thisphib/degrad)
      thisyb   = thisrb*SIN(thisphib/degrad)
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisxb) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisyb) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      ENDIF
      ENDIF
      END DO
      ELSEIF ( kTrayConfig.ge.15 ) THEN
      DO iBL = 1, 30
      thisphi = 90.0 + (iBL-1)*(-12.0)
      thisr   = MTDD_RiRun15(iBL)*2.54 + 0.965*2.54
      thisx   = thisr*COS(thisphi/degrad)
      thisy   = thisr*SIN(thisphi/degrad)
      IF ( thisr.gt.0 ) THEN
      IF ( iBL.ge.12.and.iBL.le.20 ) THEN
      nTrayGroup=3;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 3
      ENDIF
      IF ( iBL.lt.12.or.iBL.gt.20 ) THEN
      IF ( iBL.ne.8.and.iBL.ne.24 ) THEN
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisx) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisy) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      IF ( iBL.eq.8 ) THEN
      thisrb   = SQRT(thisr*thisr + 2.54*MTDD_YShift24*2.54*MTDD_YShift24)
      thisphib = degrad*ATAN(2.54*MTDD_YShift24/thisr) + thisphi
      thisxb   = thisrb*COS(thisphib/degrad)
      thisyb   = thisrb*SIN(thisphib/degrad)
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisxb) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisyb) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      IF ( iBL.eq.24 ) THEN
      thisrb   = SQRT(thisr*thisr + 2.54*MTDD_YShift08*2.54*MTDD_YShift08)
      thisphib = degrad*ATAN(2.54*MTDD_YShift08/thisr) + thisphi
      thisxb   = thisrb*COS(thisphib/degrad)
      thisyb   = thisrb*SIN(thisphib/degrad)
      nTrayGroup=5;
      CREATE MTTG
      CALL AgsReset 
      CALL agml_position_begin('MTTG') 
      %title = 'MTTG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(thisxb) 
      CALL agml_translate_x( %x ) 
      ag_y = real(thisyb) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = real(thisphi) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      Ntrayplaced = Ntrayplaced + 5
      ENDIF
      ENDIF
      ENDIF
      END DO
      ENDIF
      <W> Ntrayplaced;  ('Number of MTD trays placed=', I3);
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTTG
      BLOCK MTTG   Is the MTD tray group
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE MTTT seen=0 colo=3
      IF ( nTrayGroup==3 ) THEN
      SHAPE box dx=MTDD_MtdMotherdX dy=MTDD_MtdMotherdY,
            dz=MTDD_MtdMotherdZ3
      CREATE MTRA
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = -87.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = 87.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      IF ( nTrayGroup==5 ) THEN
      SHAPE box dx=MTDD_MtdMotherdX dy=MTDD_MtdMotherdY,
            dz=MTDD_MtdMotherdZ5
      CREATE MTRA
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = -174.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = -87.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = 87.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MTRA') 
      %title = 'MTRA' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(MTDD_MtdTraydX) 
      CALL agml_translate_x( %x ) 
      ag_z = 174.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTRA
      BLOCK MTRA   is an MTD11-style tray
      MATERIAL RPCgas
      MEDIUM Standard
      ATTRIBUTE MTRA seen=1 colo=6
      SHAPE box dx=MTDD_MtdTraydX dy=MTDD_MtdTraydY,
            dz=MTDD_MtdTraydZ
      CREATE MTBP dx=MTDD_MtdBPlate/2.
      CALL AgsReset 
      CALL agml_position_begin('MTBP') 
      %title = 'MTBP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX+(MTDD_MtdBPlate/2.)) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE MTTP dx=MTDD_MtdTPlate/2.
      CALL AgsReset 
      CALL agml_position_begin('MTTP') 
      %title = 'MTTP' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(MTDD_MtdTraydX-(MTDD_MtdTPlate/2.)) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      chandim = MTDD_MtdTraydX - MTDD_MtdBPlate/2. - MTDD_MtdBPlate/2.
      CREATE MCHL dz=MTDD_MtdTraydZ-2.*chandim dx=chandim dy=chandim
      CALL AgsReset 
      CALL agml_position_begin('MCHL') 
      %title = 'MCHL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX+MTDD_MtdBPlate+chandim) 
      CALL agml_translate_x( %x ) 
      ag_y = real(MTDD_MtdTraydY-chandim) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MCHL') 
      %title = 'MCHL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX+MTDD_MtdBPlate+chandim) 
      CALL agml_translate_x( %x ) 
      ag_y = real(-MTDD_MtdTraydY+chandim) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      ag_alphaz = 180.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE MCHS dz=chandim dx=chandim dy=MTDD_MtdTraydY
      CALL AgsReset 
      CALL agml_position_begin('MCHS') 
      %title = 'MCHS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX+MTDD_MtdBPlate+chandim) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(MTDD_MtdTraydZ-chandim) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MCHS') 
      %title = 'MCHS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-MTDD_MtdTraydX+MTDD_MtdBPlate+chandim) 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(-MTDD_MtdTraydZ+chandim) 
      CALL agml_translate_z( %z ) 
      ag_alphay = 180.0 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      thish = MTDD_MtdIGstackNgaps*MTDD_MtdIGstackGapThick + (MTDD_MtdIGstackNgaps _
            - 1.0)*MTDD_MtdIGstackThinGlassThick
      CREATE MIGS dz=MTDD_MtdIGstackdZ dx=thish/2.0 dy=MTDD_MtdIGstackdY
      CALL AgsReset 
      CALL agml_position_begin('MIGS') 
      %title = 'MIGS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MIGS
      BLOCK MIGS   is the inner glass stack
      ATTRIBUTE MIGS seen=0 colo=4
      MATERIAL Glass
      SHAPE box
      CREATE MIGG dz=MTDD_MtdIGstackdZ dx=MTDD_MtdIGstackGapThick/2.0 dy=MTDD_MtdIGstackdY
      IF ( ngaps.eq.6 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-2.5*MTDD_MtdIGstackThinGlassThick-2.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-1.5*MTDD_MtdIGstackThinGlassThick-1.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-0.5*MTDD_MtdIGstackThinGlassThick-0.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 0.5*MTDD_MtdIGstackThinGlassThick+0.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 1.5*MTDD_MtdIGstackThinGlassThick+1.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 2.5*MTDD_MtdIGstackThinGlassThick+2.5*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ELSEIF ( ngaps.eq.5 ) THEN
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-2.0*MTDD_MtdIGstackThinGlassThick-2.0*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(-1.0*MTDD_MtdIGstackThinGlassThick-1.0*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 0.0*MTDD_MtdIGstackThinGlassThick+0.0*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 1.0*MTDD_MtdIGstackThinGlassThick+1.0*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('MIGG') 
      %title = 'MIGG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real( 2.0*MTDD_MtdIGstackThinGlassThick+2.0*MTDD_MtdIGstackGapThick) 
      CALL agml_translate_x( %x ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDIF
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MIGG
      BLOCK MIGG   is a single gas gap
      ATTRIBUTE MIGG seen=0 colo=7
      MATERIAL RPCgas
      MEDIUM RPCgas_sensitive isvol=1
      SHAPE box
      HITS MIGG x:.01:S y:.01: z:.01: ptot:18:(0,100) cx:10: cy:10: cz:10: sleng:.1:(0,500),
            tof:16:(0,1.0E-7) step:.01: eloss:16:(0,1.0E-6)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTBP
      BLOCK MTBP   is the MTD11 bottom plate
      MATERIAL Aluminium
      MEDIUM Standard
      ATTRIBUTE MTBP seen=1 colo=6
      SHAPE box
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MTTP
      BLOCK MTTP   is the MTD11 top plate
      MATERIAL Aluminium
      MEDIUM Standard
      ATTRIBUTE MTTP seen=1 colo=6
      SHAPE box
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MCHL
      BLOCK MCHL   is the MTD11 architectural channel long side
      MATERIAL Aluminium
      MEDIUM Standard
      ATTRIBUTE MCHL seen=1 colo=6
      SHAPE box
      CREATE MCAL dz=MTDD_MtdTraydZ-2.*chandim dx=chandim-0.3175 dy=chandim-0.3175/2.
      CALL AgsReset 
      CALL agml_position_begin('MCAL') 
      %title = 'MCAL' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = real(0.3175/2.) 
      CALL agml_translate_y( %y ) 
      ag_z = 0.0 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MCAL
      BLOCK MCAL   is the air in the MTD11 architectural channel long side
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE MCAL seen=1 colo=7
      SHAPE box
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MCHS
      BLOCK MCHS   is the MTD11 architectural channel short side
      MATERIAL Aluminium
      MEDIUM Standard
      ATTRIBUTE MCHS seen=1 colo=6
      SHAPE box
      CREATE MCAS dz=chandim-0.3175/2. dx=chandim-0.3175 dy=MTDD_MtdTraydY
      CALL AgsReset 
      CALL agml_position_begin('MCAS') 
      %title = 'MCAS' 
      %exname = 'POSITION' ! agml placement 
      ag_x = 0.0 
      CALL agml_translate_x( %x ) 
      ag_y = 0.0 
      CALL agml_translate_y( %y ) 
      ag_z = real(+0.3175/2.) 
      CALL agml_translate_z( %z ) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- MCAS
      BLOCK MCAS   is the air in the MTD11 architectural channel short side
      MATERIAL Air
      MEDIUM Standard
      ATTRIBUTE MCAS seen=1 colo=7
      SHAPE box
      ENDBLOCK
