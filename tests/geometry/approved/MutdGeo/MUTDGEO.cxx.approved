          AgBlock *MMTC::mInstance = 0;     
          AgBlock *MMTC::Instance(){        
                   if ( mInstance==0 ) mInstance = new MMTC();        
                   return mInstance;        
          }     
          void MMTC::Block( AgCreate create )     
          {         
                ///@addtogroup MMTC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MMTC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=5;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mtry.height/2-mtry.wallthk;              
                            shape.par("dy")=mtry.width/2-mtry.wallthk;              
                            shape.par("dz")=mtry.length/2-mtry.wallthk;              
                            /// Shape Bbox dx=mtry.height/2-mtry.wallthk dy=mtry.width/2-mtry.wallthk dz=mtry.length/2-mtry.wallthk               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MMTC;              
                            _stacker -> Build(this);              
                      }           
                      zpos=(mtry.length-mtbb.slab1len)/2-mtry.wallthk-mtbb.wrap;           
                      xpos=-mtry.height/2+mtbb.slab1x;           
                      _create = AgCreate("MXSA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create MXSA              
                            Create("MXSA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MXSA");              
                            place.SetMother("MMTC");              
                            /// Add daughter volume MXSA to mother MMTC              
                            place.TranslateX(xpos);              
                            /// Translate x = xpos              
                            place.TranslateZ(zpos);              
                            /// Translate z = zpos              
                            place.par("dx")=mtbb.slabthck/2;              
                            place.par("dy")=mtbb.slabwid/2;              
                            place.par("dz")=mtbb.slab1len/2;              
                            _stacker -> Position( AgBlock::Find("MXSA"), place );              
                      } // end placement of MXSA           
                      zpos=(mtry.length-mtbb.slab2len)/2-mtry.wallthk-mtbb.wrap-mtbb.shim;           
                      xpos=-mtry.height/2+mtbb.slab2x;           
                      _create = AgCreate("MXSA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create MXSA              
                            Create("MXSA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MXSA");              
                            place.SetMother("MMTC");              
                            /// Add daughter volume MXSA to mother MMTC              
                            place.TranslateX(xpos);              
                            /// Translate x = xpos              
                            place.TranslateZ(-zpos);              
                            /// Translate z = -zpos              
                            place.par("dx")=mtbb.slabthck/2;              
                            place.par("dy")=mtbb.slabwid/2;              
                            place.par("dz")=mtbb.slab2len/2;              
                            _stacker -> Position( AgBlock::Find("MXSA"), place );              
                      } // end placement of MXSA           
                      END_OF_MMTC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MMTC     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MXSA::mInstance = 0;     
          AgBlock *MXSA::Instance(){        
                   if ( mInstance==0 ) mInstance = new MXSA();        
                   return mInstance;        
          }     
          void MXSA::Block( AgCreate create )     
          {         
                ///@addtogroup MXSA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MXSA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material polystyren            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Polystyren");              
                            _material = mat;              
                      }           
                      /// Medium sensitive           
                      ///  isvol = 1            
                      {  AgMedium &med = AgMedium::Get("Sensitive");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0;              
                            shape.par("dy")=0;              
                            shape.par("dz")=0;              
                            /// Shape Bbox dx=0 dy=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MXSA;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "MXSA", "x", 0.01, 0, 0, "S");           
                      // deferred module()->AddHit( "MXSA", "y", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "z", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "ptot", 18, 0, 100, "");           
                      // deferred module()->AddHit( "MXSA", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "sleng", 0.1, 0, 500, "");           
                      // deferred module()->AddHit( "MXSA", "tof", 16, 0, 1.0e-6, "");           
                      // deferred module()->AddHit( "MXSA", "step", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MXSA", "eloss", 16, 0, 0.01, "");           
                      END_OF_MXSA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MXSA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MPMT::mInstance = 0;     
          AgBlock *MPMT::Instance(){        
                   if ( mInstance==0 ) mInstance = new MPMT();        
                   return mInstance;        
          }     
          void MPMT::Block( AgCreate create )     
          {         
                ///@addtogroup MPMT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MPMT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=3.12/2.;              
                            shape.par("dy")=57.20/2.;              
                            shape.par("dz")=mtdg.length/2;              
                            /// Shape Bbox dx=3.12/2. dy=57.20/2. dz=mtdg.length/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MPMT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_MPMT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MPMT     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MMRP::mInstance = 0;     
          AgBlock *MMRP::Instance(){        
                   if ( mInstance==0 ) mInstance = new MMRP();        
                   return mInstance;        
          }     
          void MMRP::Block( AgCreate create )     
          {         
                ///@addtogroup MMRP_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MMRP");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material RPCgas            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Rpcgas");              
                            _material = mat;              
                      }           
                      /// Medium sensitive           
                      ///  isvol = 1            
                      {  AgMedium &med = AgMedium::Get("Sensitive");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=2.50/2.;              
                            shape.par("dy")=57.20/2.;              
                            shape.par("dz")=210.82/2;              
                            /// Shape Bbox dx=2.50/2. dy=57.20/2. dz=210.82/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MMRP;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "MMRP", "x", 0.01, 0, 0, "HS");           
                      // deferred module()->AddHit( "MMRP", "y", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MMRP", "z", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MMRP", "ptot", 18, 0, 100, "");           
                      // deferred module()->AddHit( "MMRP", "sleng", 0.1, 0, 500, "");           
                      // deferred module()->AddHit( "MMRP", "tof", 16, 0, 1.0e-7, "");           
                      // deferred module()->AddHit( "MMRP", "step", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "MMRP", "eloss", 16, 0, 1.0e-6, "");           
                      END_OF_MMRP:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MMRP     
    // ----------------------------------------------------------------------- geoctr
       void MUTDGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup MUTDGEO_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             ///@addtogroup MUTDGEO_revision        
             ///@{           
                   /// Created:    21 March 2006            
             ///@}        
             AddBlock("MUTD", MUTD::Instance());        
             AddBlock("MUSC", MUSC::Instance());        
             AddBlock("MTRA", MTRA::Instance());        
             AddBlock("MXTR", MXTR::Instance());        
             AddBlock("MMTC", MMTC::Instance());        
             AddBlock("MXSA", MXSA::Instance());        
             AddBlock("MPMT", MPMT::Instance());        
             AddBlock("MMRP", MMRP::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mtdg
++mtdg._index;
mtdg.version = 1;
// mtdg_docum.version = " version number ";
mtdg.rpmtin = 364.25;
// mtdg_docum.rpmtin = " pmt box inner radius ";
mtdg.rpmtout = 386.15;
// mtdg_docum.rpmtout = " pmt box outer radius       ";
mtdg.rmrpcin = 403.60;
// mtdg_docum.rmrpcin = " mrpc box inner radius ";
mtdg.rmrpcout = 411.22;
// mtdg_docum.rmrpcout = " mrpc box outer radius       ";
mtdg.rmin = 390.00;
// mtdg_docum.rmin = " inner radius of the magnet system ";
mtdg.rmax = 435.00;
// mtdg_docum.rmax = " outer radius of the magnet system ";
mtdg.dz = 246.0;
// mtdg_docum.dz = " CTB/TOF tube half length ";
mtdg.length = 500.00;
// mtdg_docum.length = " slightly longer than full length of the trays ";
{
mtdg_info::radii::Type temp = {
mtdg_info::radii::BaseType(390.093),
mtdg_info::radii::BaseType(420.093)
}
;
memcpy(&mtdg.radii, &temp, sizeof(temp));;
}
// mtdg_docum.radii = " radii of trays ";
MTDG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mtry
++mtry._index;
mtry.height = 8.89;
// mtry_docum.height = " tray height(8.89) ";
mtry.width = 21.59;
// mtry_docum.width = " full tray width ";
mtry.length = 241.62;
// mtry_docum.length = " full tray length(241.62) ";
mtry.wallthk = 0.13;
// mtry_docum.wallthk = " tray wall thickness ";
mtry.supfullh = 2.03;
// mtry_docum.supfullh = " support height (radial) ";
mtry.supfullw = 15.24;
// mtry_docum.supfullw = " support full width with arms ";
mtry.suplen = 215.9;
// mtry_docum.suplen = " support length ";
mtry.supbasew = 9.22;
// mtry_docum.supbasew = " support base width ";
mtry.supbaset = 0.32;
// mtry_docum.supbaset = " support base thickness   ";
mtry.suparmt = 0.64;
// mtry_docum.suparmt = " support arm  thickness ";
mtry.cooloutr = 0.80;
// mtry_docum.cooloutr = " Cooling channel outer radius ";
mtry.coolinnr = 0.48;
// mtry_docum.coolinnr = " Cooling channel inner radius ";
mtry.stript = 0.08;
// mtry_docum.stript = " Thickness of polyethylene strip on bottom ";
mtry.footinse = 1.06;
// mtry_docum.footinse = " foot inset from tray edge ";
mtry.footthk = 0.23;
// mtry_docum.footthk = " thickness of foot material ";
mtry.foot1len = 1.68;
// mtry_docum.foot1len = " length (in section) of first part of foot ";
mtry.foot2thk = 1.16;
// mtry_docum.foot2thk = " thickness of second foot section ";
mtry.foot3len = 2.16;
// mtry_docum.foot3len = " length of third part of foot ";
MTRY.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mtbb
++mtbb._index;
mtbb.slab1len = 112.5;
// mtbb_docum.slab1len = " first slab (B) length ";
mtbb.slab2len = 130.0;
// mtbb_docum.slab2len = " second slab (A)length  ";
mtbb.slab1x = 5.84;
// mtbb_docum.slab1x = " first slab (B) x position ";
mtbb.slab2x = 2.67;
// mtbb_docum.slab2x = " second slab (A) x position ";
mtbb.slabthck = 1.0;
// mtbb_docum.slabthck = " scintillator slab thicknesses ";
mtbb.slabwid = 21.0;
// mtbb_docum.slabwid = " scintillator slab width ";
mtbb.convlen = 8.5;
// mtbb_docum.convlen = " optical converter length ";
mtbb.convwidm = 4.0;
// mtbb_docum.convwidm = " optical convertor min width ";
mtbb.convthck = 0.92;
// mtbb_docum.convthck = " optical convertor thickness ";
mtbb.pmtlen = 5.0;
// mtbb_docum.pmtlen = " PMT length ";
mtbb.pmtmaxr = 2.0;
// mtbb_docum.pmtmaxr = " PMT max radius ";
mtbb.pmtminr = 1.84;
// mtbb_docum.pmtminr = " PMT min radius ";
mtbb.baselen = 4.0;
// mtbb_docum.baselen = " Base length ";
mtbb.basemaxr = 2.13;
// mtbb_docum.basemaxr = " Base max radius ";
mtbb.baseminr = 1.0;
// mtbb_docum.baseminr = " Base min radius ";
mtbb.electhck = 0.25;
// mtbb_docum.electhck = " readout electronics thickness ";
mtbb.wrap = 0.13;
// mtbb_docum.wrap = " thickness of Tyvek + black plastic ";
mtbb.shim = 0.26;
// mtbb_docum.shim = " thickness of shim to position slat 2 ";
MTBB.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill moff
++moff._index;
moff.boxwidth = 21.0875;
// moff_docum.boxwidth = " width of the 5w box (BMTD) ";
moff.slatlen = 20.0;
// moff_docum.slatlen = " slat length ";
moff.slat01z = 104.938;
// moff_docum.slat01z = " 5_wide_slat Z position for row 1 from AutoCAD ";
moff.slat02z = 84.060;
// moff_docum.slat02z = " 4_wide_slat Z position for row 2 from AutoCAD ";
moff.slat03z = 62.860;
// moff_docum.slat03z = " 4_wide_slat Z position for row 3 from AutoCAD ";
moff.slat04z = 41.254;
// moff_docum.slat04z = " 4_wide_slat Z position for row 4 from AutoCAD ";
moff.slat05z = 18.966;
// moff_docum.slat05z = " 4_wide_slat Z position for row 5 from AutoCAD ";
moff.slat06z = -3.954;
// moff_docum.slat06z = " 4_wide_slat Z position for row 6 from AutoCAD ";
moff.slat07z = -27.528;
// moff_docum.slat07z = " 4_wide_slat Z position for row 7 from AutoCAD ";
moff.slat08z = -51.254;
// moff_docum.slat08z = " 4_wide_slat Z position for row 8 from AutoCAD ";
moff.slat09z = -75.634;
// moff_docum.slat09z = " 4_wide_slat Z position for row 9 from AutoCAD ";
moff.slat10z = -100.683;
// moff_docum.slat10z = " 4_wide_slat Z position for row 10 from AutoCAD ";
moff.slatthck = 2.0;
// moff_docum.slatthck = " scintillator slab thicknesses ";
moff.slatwid = 3.81;
// moff_docum.slatwid = " scintillator slab width (4.0) ";
moff.slatang = 11.5;
// moff_docum.slatang = " slat assy. angle w.r.t. tray ";
moff.pmtlen = 5.0;
// moff_docum.pmtlen = " PMT length ";
moff.pmtmaxr = 1.91;
// moff_docum.pmtmaxr = " PMT max radius ";
moff.pmtminr = 1.8;
// moff_docum.pmtminr = " PMT min radius ";
moff.socklen = 1.0;
// moff_docum.socklen = " thickness of socket ";
moff.baselen = 5.0;
// moff_docum.baselen = " Base length ";
moff.basemaxr = 1.91;
// moff_docum.basemaxr = " Base max radius ";
moff.baseminr = 1.8;
// moff_docum.baseminr = " Base min radius   ";
moff.cellwid = 3.1;
// moff_docum.cellwid = " Cell width  ";
moff.cellhgt = 1.6;
// moff_docum.cellhgt = " Cell height ";
moff.elechgt = 3.0;
// moff_docum.elechgt = " FEE Board height in tray... (rails/loop too). ";
moff.electhck = 0.17;
// moff_docum.electhck = " FEE Board thickness (67 mils) ";
moff.elecwid = 20.3;
// moff_docum.elecwid = " FEE Board width (was 21) ";
moff.eleclen = 5.715;
// moff_docum.eleclen = " FEE Board length (was 16) ";
moff.elec01z = 105.610;
// moff_docum.elec01z = " FEE Z position for row 1 from AutoCAD ";
moff.elec02z = 84.573;
// moff_docum.elec02z = " FEE Z position for row 2 from AutoCAD ";
moff.elec03z = 63.224;
// moff_docum.elec03z = " FEE Z position for row 3 from AutoCAD ";
moff.elec04z = 41.667;
// moff_docum.elec04z = " FEE Z position for row 4 from AutoCAD ";
moff.elec05z = 19.379;
// moff_docum.elec05z = " FEE Z position for row 5 from AutoCAD ";
moff.elec06z = -3.542;
// moff_docum.elec06z = " FEE Z position for row 6 from AutoCAD ";
moff.elec07z = -27.165;
// moff_docum.elec07z = " FEE Z position for row 7 from AutoCAD ";
moff.elec08z = -50.841;
// moff_docum.elec08z = " FEE Z position for row 8 from AutoCAD ";
moff.elec09z = -75.170;
// moff_docum.elec09z = " FEE Z position for row 9 from AutoCAD ";
moff.elec10z = -100.270;
// moff_docum.elec10z = " FEE Z position for row 10 from AutoCAD ";
moff.railthck = 0.2;
// moff_docum.railthck = " Cooling loop rail thickness ";
moff.railwid = 1.5;
// moff_docum.railwid = " Cooling loop rail width ";
moff.cooloutr = 0.635;
// moff_docum.cooloutr = " Cooling loop pipe outer radius, 0.5in/2 ";
moff.coolinnr = 0.561;
// moff_docum.coolinnr = " Cooling loop pipe inner radius, (0.5in-0.058in)/2 ";
MOFF.fill();
        
             /// USE mtdg _index=1;        
             MTDG.use( __mtdg__index__ = 1 );
        
             /// USE mtry _index=1;        
             MTRY.use( __mtry__index__ = 1 );
        
             /// USE mtbb _index=1;        
             MTBB.use( __mtbb__index__ = 1 );
        
             /// USE moff _index=1;        
             MOFF.use( __moff__index__ = 1 );
        
             /// Component H	a=1	z=1	w=0.90*2*1./102.+0.+0.05*10*1./58.        
             /// Component C	a=12	z=6	w=0.90*2*12./102.+0.+0.05*4*12./58.        
             /// Component F	a=19	z=9	w=0.90*4*19./102.+0.05*6*19./146.+0.        
             /// Component S	a=32	z=16	w=0.+0.05*1*32./146.+0.        
             /// Mixture RPCgas dens=4.55e-3        
             {  AgMaterial &mix = AgMaterial::Get("Rpcgas");           
                   mix.Component("H",1,1,0.90*2*1./102.+0.+0.05*10*1./58.);           
                   mix.Component("C",12,6,0.90*2*12./102.+0.+0.05*4*12./58.);           
                   mix.Component("F",19,9,0.90*4*19./102.+0.05*6*19./146.+0.);           
                   mix.Component("S",32,16,0.+0.05*1*32./146.+0.);           
                   mix.par("dens")=4.55e-3;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("MUTD");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create MUTD           
                   Create("MUTD");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("MUTD");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MUTD to mother CAVE           
                   _stacker -> Position( AgBlock::Find("MUTD"), place );           
             } // end placement of MUTD        
       }; // MUTDGEO     
 }; // namespace MUTDGEO  
 