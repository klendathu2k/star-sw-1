          void MMRP::Block( AgCreate create )     
          {         
                ///@addtogroup MMRP_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MMRP");              
