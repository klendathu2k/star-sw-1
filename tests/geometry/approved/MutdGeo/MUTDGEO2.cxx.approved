       void MUTDGEO2::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup MUTDGEO2_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             ///@addtogroup MUTDGEO2_revision        
             ///@{           
                   /// Created:    21 March 2006            
             ///@}        
             AddBlock("MUTD", MUTD::Instance());        
             AddBlock("MUSC", MUSC::Instance());        
             AddBlock("MPMT", MPMT::Instance());        
             AddBlock("MMRP", MMRP::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mtdg
++mtdg._index;
mtdg.version = 1;
// mtdg_docum.version = " version number ";
mtdg.rpmtin = 364.25;
// mtdg_docum.rpmtin = " pmt box inner radius ";
mtdg.rpmtout = 386.15;
// mtdg_docum.rpmtout = " pmt box outer radius       ";
mtdg.rmrpcin = 403.60;
// mtdg_docum.rmrpcin = " mrpc box inner radius ";
mtdg.rmrpcout = 411.22;
// mtdg_docum.rmrpcout = " mrpc box outer radius       ";
mtdg.rmin = 390.00;
// mtdg_docum.rmin = " inner radius of the magnet system ";
mtdg.rmax = 435.00;
// mtdg_docum.rmax = " outer radius of the magnet system ";
mtdg.dz = 246.0;
// mtdg_docum.dz = " CTB/TOF tube half length ";
mtdg.length = 500.00;
// mtdg_docum.length = " slightly longer than full length of the trays ";
{
mtdg_info::radii::Type temp = {
mtdg_info::radii::BaseType(390.093),
mtdg_info::radii::BaseType(420.093)
}
;
memcpy(&mtdg.radii, &temp, sizeof(temp));;
}
// mtdg_docum.radii = " radii of trays ";
MTDG.fill();
        
             /// USE mtdg _index=1;        
             MTDG.use( __mtdg__index__ = 1 );
        
             /// Component H	a=1	z=1	w=0.90*2*1./102.+0.+0.05*10*1./58.        
             /// Component C	a=12	z=6	w=0.90*2*12./102.+0.+0.05*4*12./58.        
             /// Component F	a=19	z=9	w=0.90*4*19./102.+0.05*6*19./146.+0.        
             /// Component S	a=32	z=16	w=0.+0.05*1*32./146.+0.        
             /// Mixture RPCgas dens=4.55e-3        
             {  AgMaterial &mix = AgMaterial::Get("Rpcgas");           
                   mix.Component("H",1,1,0.90*2*1./102.+0.+0.05*10*1./58.);           
                   mix.Component("C",12,6,0.90*2*12./102.+0.+0.05*4*12./58.);           
                   mix.Component("F",19,9,0.90*4*19./102.+0.05*6*19./146.+0.);           
                   mix.Component("S",32,16,0.+0.05*1*32./146.+0.);           
                   mix.par("dens")=4.55e-3;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("MUTD");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create MUTD           
                   Create("MUTD");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("MUTD");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume MUTD to mother CAVE           
                   _stacker -> Position( AgBlock::Find("MUTD"), place );           
             } // end placement of MUTD        
       }; // MUTDGEO2     
 }; // namespace MUTDGEO2  
 