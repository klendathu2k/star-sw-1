          void MCHS::Block( AgCreate create )     
          {         
                ///@addtogroup MCHS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("MCHS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            /// Shape Bbox               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MCHS;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("MCAS");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MCAS");              
                            createin.par("dx")=chandim-0.3175;              
                            createin.par("dy")=mtdd.mtdtraydy;              
                            createin.par("dz")=chandim-0.3175/2.;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = chandim-0.3175              
                            myshape.par("dx")=chandim-0.3175;              
                            /// Set shape par: dy = mtdd.mtdtraydy              
                            myshape.par("dy")=mtdd.mtdtraydy;              
                            /// Set shape par: dz = chandim-0.3175/2.              
                            myshape.par("dz")=chandim-0.3175/2.;              
                            ///Create MCAS              
                            Create("MCAS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCAS");              
                            place.SetMother("MCHS");              
                            /// Add daughter volume MCAS to mother MCHS              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(+0.3175/2.);              
                            /// Translate z = +0.3175/2.              
                            _stacker -> Position( AgBlock::Find("MCAS"), place );              
                      } // end placement of MCAS           
                      END_OF_MCHS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MCHS     
