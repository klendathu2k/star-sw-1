          AgBlock *MCHL::mInstance = 0;     
          AgBlock *MCHL::Instance(){        
                   if ( mInstance==0 ) mInstance = new MCHL();        
                   return mInstance;        
          }     
          void MCHL::Block( AgCreate create )     
          {         
                ///@addtogroup MCHL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("MCHL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            /// Shape Bbox               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MCHL;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("MCAL");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MCAL");              
                            createin.par("dx")=chandim-0.3175;              
                            createin.par("dy")=chandim-0.3175/2.;              
                            createin.par("dz")=mtdd.mtdtraydz-2.*chandim;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = chandim-0.3175              
                            myshape.par("dx")=chandim-0.3175;              
                            /// Set shape par: dy = chandim-0.3175/2.              
                            myshape.par("dy")=chandim-0.3175/2.;              
                            /// Set shape par: dz = mtdd.mtdtraydz-2.*chandim              
                            myshape.par("dz")=mtdd.mtdtraydz-2.*chandim;              
                            ///Create MCAL              
                            Create("MCAL");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCAL");              
                            place.SetMother("MCHL");              
                            /// Add daughter volume MCAL to mother MCHL              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0.3175/2.);              
                            /// Translate y = 0.3175/2.              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("MCAL"), place );              
                      } // end placement of MCAL           
                      END_OF_MCHL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MCHL     
          // ---------------------------------------------------------------------------------------------------     
