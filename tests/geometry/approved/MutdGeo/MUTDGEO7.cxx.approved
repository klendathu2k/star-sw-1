mtdd.mtdmotherdz5 = 285.0;
// mtdd_docum.mtdmotherdz5 = " Tray Mother half-length Z (length long) ";
mtdd.mtdmotherdz3 = 195.0;
// mtdd_docum.mtdmotherdz3 = " Tray Mother half-length Z (length short) ";
mtdd.mtdtraydx = 2.49555;
// mtdd_docum.mtdtraydx = " Tray half-height (1.965in)*2.54/2 ";
mtdd.mtdtraydy = 33.765;
// mtdd_docum.mtdtraydy = " Tray half-width ";
mtdd.mtdtraydz = 54.005;
// mtdd_docum.mtdtraydz = " Tray half-length ";
mtdd.mtdbplate = 0.3175;
// mtdd_docum.mtdbplate = " Tray bottom plate full thickness (0.125in)";
mtdd.mtdtplate = 0.2286;
// mtdd_docum.mtdtplate = " Tray top plate full thickness (0.090in)";
mtdd.mtdigstackdy = 26.1;
// mtdd_docum.mtdigstackdy = " WMRPC inner glass stack volume half-length Y ";
mtdd.mtdigstackdz = 43.5;
// mtdd_docum.mtdigstackdz = " WMRPC inner glass stack volume half-length Y ";
mtdd.mtdigstackngaps = 5.0;
// mtdd_docum.mtdigstackngaps = " WMPRC number of gas gaps ";
mtdd.mtdigstackgapthick = 0.025;
// mtdd_docum.mtdigstackgapthick = " WMRPC gas thickness (0.25mm)  ";
mtdd.mtdigstackthinglassthick = 0.07;
// mtdd_docum.mtdigstackthinglassthick = " WMRPC thin glass thickness (0.7mm)  ";
MTDD.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mtdd
++mtdd._index;
mtdd.version = 1.1;
// mtdd_docum.version = "revision 3/16";
mtdd.yshift08 = -5.222;
// mtdd_docum.yshift08 = " Backleg 8 shift for bus cover clearance ";
mtdd.yshift24 = 3.394;
// mtdd_docum.yshift24 = " Backleg 24 shift for bus cover clearance ";
MTDD.fill();
        
             /// USE mtdg _index=1;        
             MTDG.use( __mtdg__index__ = 1 );
        
             /// USE mtdd version=mtdg.version;        
             MTDD.use( __mtdd_version__ = mtdg.version );
        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             // Print<level=%i> fmt=%s fortran format statements not supported        
             ktrayconfig=nint(mtdg.config);        
             ngaps=mtdd.mtdigstackngaps;        
             degrad=57.2957795;;        
             /// Component H	a=1	z=1	w=0.90*2*1./102.+0.+0.05*10*1./58.        
             /// Component C	a=12	z=6	w=0.90*2*12./102.+0.+0.05*4*12./58.        
             /// Component F	a=19	z=9	w=0.90*4*19./102.+0.05*6*19./146.+0.        
             /// Component S	a=32	z=16	w=0.+0.05*1*32./146.+0.        
             /// Mixture RPCgas dens=4.55e-3        
             {  AgMaterial &mix = AgMaterial::Get("Rpcgas");           
                   mix.Component("H",1,1,0.90*2*1./102.+0.+0.05*10*1./58.);           
                   mix.Component("C",12,6,0.90*2*12./102.+0.+0.05*4*12./58.);           
                   mix.Component("F",19,9,0.90*4*19./102.+0.05*6*19./146.+0.);           
                   mix.Component("S",32,16,0.+0.05*1*32./146.+0.);           
                   mix.par("dens")=4.55e-3;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Si	a=28	z=14	w=1.        
             /// Component O	a=16	z=8	w=2.        
             /// Mixture Glass dens=2.5        
             {  AgMaterial &mix = AgMaterial::Get("Glass");           
                   mix.Component("Si",28,14,1.);           
                   mix.Component("O",16,8,2.);           
                   mix.par("dens")=2.5;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("MUTD");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create MUTD           
                   Create("MUTD");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("MUTD");           
                   place.SetMother("CAVE");           
                   place.SetGroup("MagRefSys");           
                   /// Add daughter volume MUTD to mother CAVE           
                   _stacker -> Position( AgBlock::Find("MUTD"), place );           
             } // end placement of MUTD        
       }; // MUTDGEO7     
 }; // namespace MUTDGEO7  
 