                                              {                          
                                                    thisrb=sqrt(thisr*thisr+2.54*mtdd.yshift24*2.54*mtdd.yshift24);                          
                                                    thisphib=degrad*atan(2.54*mtdd.yshift24/thisr)+thisphi;                          
                                                    thisxb=thisrb*cos(thisphib/degrad);                          
                                                    thisyb=thisrb*sin(thisphib/degrad);                          
                                                    ntraygroup=5;                          
                                                    _create = AgCreate("MTTG");                          
                                                    {                             
                                                          AgShape myshape; // undefined shape                             
                                                          ///Create MTTG                             
                                                          Create("MTTG");                              
                                                    }                          
                                                    {                             
                                                          AgPosition  place;                             
                                                          place.SetBlock("MTTG");                             
                                                          place.SetMother("MUTD");                             
                                                          /// Add daughter volume MTTG to mother MUTD                             
                                                          place.TranslateX(thisxb);                             
                                                          /// Translate x = thisxb                             
                                                          place.TranslateY(thisyb);                             
                                                          /// Translate y = thisyb                             
                                                          place.TranslateZ(0);                             
                                                          /// Translate z = 0                             
                                                          place.AlphaZ(thisphi);                             
                                                          /// Rotate: AlphaZ = thisphi                             
                                                          /// G3 Reference: thetax = 90                             
                                                          /// G3 Reference: phix = 0                             
                                                          /// G3 Reference: thetay = 90                             
                                                          /// G3 Reference: phiy = 90                             
                                                          /// G3 Reference: thetaz = 0                             
                                                          /// G3 Reference: phiz = 0                             
                                                          _stacker -> Position( AgBlock::Find("MTTG"), place );                             
                                                    } // end placement of MTTG                          
                                                    ntrayplaced=ntrayplaced+5;                          
                                              }                       
                                              if ( ibl==24 )                       
                                              {                          
                                                    thisrb=sqrt(thisr*thisr+2.54*mtdd.yshift08*2.54*mtdd.yshift08);                          
                                                    thisphib=degrad*atan(2.54*mtdd.yshift08/thisr)+thisphi;                          
                                                    thisxb=thisrb*cos(thisphib/degrad);                          
                                                    thisyb=thisrb*sin(thisphib/degrad);                          
                                                    ntraygroup=5;                          
                                                    _create = AgCreate("MTTG");                          
                                                    {                             
                                                          AgShape myshape; // undefined shape                             
                                                          ///Create MTTG                             
                                                          Create("MTTG");                              
                                                    }                          
                                                    {                             
                                                          AgPosition  place;                             
                                                          place.SetBlock("MTTG");                             
                                                          place.SetMother("MUTD");                             
                                                          /// Add daughter volume MTTG to mother MUTD                             
                                                          place.TranslateX(thisxb);                             
                                                          /// Translate x = thisxb                             
                                                          place.TranslateY(thisyb);                             
                                                          /// Translate y = thisyb                             
                                                          place.TranslateZ(0);                             
                                                          /// Translate z = 0                             
                                                          place.AlphaZ(thisphi);                             
                                                          /// Rotate: AlphaZ = thisphi                             
                                                          /// G3 Reference: thetax = 90                             
                                                          /// G3 Reference: phix = 0                             
                                                          /// G3 Reference: thetay = 90                             
                                                          /// G3 Reference: phiy = 90                             
                                                          /// G3 Reference: thetaz = 0                             
                                                          /// G3 Reference: phiz = 0                             
                                                          _stacker -> Position( AgBlock::Find("MTTG"), place );                             
                                                    } // end placement of MTTG                          
                                                    ntrayplaced=ntrayplaced+5;                          
                                              }                       
                                        }                    
                                  }                 
                            }              
                      }           
                      // - Info -            
                      Info( GetName(), Form("NumberofMTDtraysplaced=%3i",ntrayplaced)  );           
                      END_OF_MUTD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MUTD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MTTG::mInstance = 0;     
          AgBlock *MTTG::Instance(){        
                   if ( mInstance==0 ) mInstance = new MTTG();        
                   return mInstance;        
          }     
          void MTTG::Block( AgCreate create )     
          {         
                ///@addtogroup MTTG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("MTTT");              
                            attr.par("seen")=0;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      if ( ntraygroup==3 )           
                      {              
                            {  AgShape shape = AgShape("Bbox");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dx")=mtdd.mtdmotherdx;                 
                                  shape.par("dy")=mtdd.mtdmotherdy;                 
                                  shape.par("dz")=mtdd.mtdmotherdz3;                 
                                  /// Shape Bbox dx=mtdd.mtdmotherdx dy=mtdd.mtdmotherdy dz=mtdd.mtdmotherdz3                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_MTTG;                 
                                  _stacker -> Build(this);                 
                            }              
                            _create = AgCreate("MTRA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create MTRA                 
                                  Create("MTRA");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(-mtdd.mtdtraydx);                 
                                  /// Translate x = -mtdd.mtdtraydx                 
                                  place.TranslateZ(-87);                 
                                  /// Translate z = -87                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(mtdd.mtdtraydx);                 
                                  /// Translate x = mtdd.mtdtraydx                 
                                  place.TranslateZ(0);                 
                                  /// Translate z = 0                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(-mtdd.mtdtraydx);                 
                                  /// Translate x = -mtdd.mtdtraydx                 
                                  place.TranslateZ(87);                 
                                  /// Translate z = 87                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                      }           
                      if ( ntraygroup==5 )           
                      {              
                            {  AgShape shape = AgShape("Bbox");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("dx")=mtdd.mtdmotherdx;                 
                                  shape.par("dy")=mtdd.mtdmotherdy;                 
                                  shape.par("dz")=mtdd.mtdmotherdz5;                 
                                  /// Shape Bbox dx=mtdd.mtdmotherdx dy=mtdd.mtdmotherdy dz=mtdd.mtdmotherdz5                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_MTTG;                 
                                  _stacker -> Build(this);                 
                            }              
                            _create = AgCreate("MTRA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create MTRA                 
                                  Create("MTRA");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(mtdd.mtdtraydx);                 
                                  /// Translate x = mtdd.mtdtraydx                 
                                  place.TranslateZ(-174);                 
                                  /// Translate z = -174                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(-mtdd.mtdtraydx);                 
                                  /// Translate x = -mtdd.mtdtraydx                 
                                  place.TranslateZ(-87);                 
                                  /// Translate z = -87                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(mtdd.mtdtraydx);                 
                                  /// Translate x = mtdd.mtdtraydx                 
                                  place.TranslateZ(0);                 
                                  /// Translate z = 0                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(-mtdd.mtdtraydx);                 
                                  /// Translate x = -mtdd.mtdtraydx                 
                                  place.TranslateZ(87);                 
                                  /// Translate z = 87                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MTRA");                 
                                  place.SetMother("MTTG");                 
                                  /// Add daughter volume MTRA to mother MTTG                 
                                  place.TranslateX(mtdd.mtdtraydx);                 
                                  /// Translate x = mtdd.mtdtraydx                 
                                  place.TranslateZ(174);                 
                                  /// Translate z = 174                 
                                  _stacker -> Position( AgBlock::Find("MTRA"), place );                 
                            } // end placement of MTRA              
                      }           
                      END_OF_MTTG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTTG     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MTRA::mInstance = 0;     
          AgBlock *MTRA::Instance(){        
                   if ( mInstance==0 ) mInstance = new MTRA();        
                   return mInstance;        
          }     
          void MTRA::Block( AgCreate create )     
          {         
                ///@addtogroup MTRA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material RPCgas            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Rpcgas");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("MTRA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=mtdd.mtdtraydx;              
                            shape.par("dy")=mtdd.mtdtraydy;              
                            shape.par("dz")=mtdd.mtdtraydz;              
                            /// Shape Bbox dx=mtdd.mtdtraydx dy=mtdd.mtdtraydy dz=mtdd.mtdtraydz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MTRA;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("MTBP");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MTBP");              
                            createin.par("dx")=mtdd.mtdbplate/2.;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = mtdd.mtdbplate/2.              
                            myshape.par("dx")=mtdd.mtdbplate/2.;              
                            ///Create MTBP              
                            Create("MTBP");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MTBP");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MTBP to mother MTRA              
                            place.TranslateX(-mtdd.mtdtraydx+(mtdd.mtdbplate/2.));              
                            /// Translate x = -mtdd.mtdtraydx+(mtdd.mtdbplate/2.)              
                            _stacker -> Position( AgBlock::Find("MTBP"), place );              
                      } // end placement of MTBP           
                      _create = AgCreate("MTTP");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MTTP");              
                            createin.par("dx")=mtdd.mtdtplate/2.;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = mtdd.mtdtplate/2.              
                            myshape.par("dx")=mtdd.mtdtplate/2.;              
                            ///Create MTTP              
                            Create("MTTP");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MTTP");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MTTP to mother MTRA              
                            place.TranslateX(mtdd.mtdtraydx-(mtdd.mtdtplate/2.));              
                            /// Translate x = mtdd.mtdtraydx-(mtdd.mtdtplate/2.)              
                            _stacker -> Position( AgBlock::Find("MTTP"), place );              
                      } // end placement of MTTP           
                      chandim=mtdd.mtdtraydx-mtdd.mtdbplate/2.-mtdd.mtdbplate/2.;           
                      _create = AgCreate("MCHL");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MCHL");              
                            createin.par("dx")=chandim;              
                            createin.par("dy")=chandim;              
                            createin.par("dz")=mtdd.mtdtraydz-2.*chandim;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = chandim              
                            myshape.par("dx")=chandim;              
                            /// Set shape par: dy = chandim              
                            myshape.par("dy")=chandim;              
                            /// Set shape par: dz = mtdd.mtdtraydz-2.*chandim              
                            myshape.par("dz")=mtdd.mtdtraydz-2.*chandim;              
                            ///Create MCHL              
                            Create("MCHL");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCHL");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MCHL to mother MTRA              
                            place.TranslateX(-mtdd.mtdtraydx+mtdd.mtdbplate+chandim);              
                            /// Translate x = -mtdd.mtdtraydx+mtdd.mtdbplate+chandim              
                            place.TranslateY(mtdd.mtdtraydy-chandim);              
                            /// Translate y = mtdd.mtdtraydy-chandim              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("MCHL"), place );              
                      } // end placement of MCHL           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCHL");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MCHL to mother MTRA              
                            place.TranslateX(-mtdd.mtdtraydx+mtdd.mtdbplate+chandim);              
                            /// Translate x = -mtdd.mtdtraydx+mtdd.mtdbplate+chandim              
                            place.TranslateY(-mtdd.mtdtraydy+chandim);              
                            /// Translate y = -mtdd.mtdtraydy+chandim              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            place.AlphaZ(180);              
                            /// Rotate: AlphaZ = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("MCHL"), place );              
                      } // end placement of MCHL           
                      _create = AgCreate("MCHS");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MCHS");              
                            createin.par("dx")=chandim;              
                            createin.par("dy")=mtdd.mtdtraydy;              
                            createin.par("dz")=chandim;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = chandim              
                            myshape.par("dx")=chandim;              
                            /// Set shape par: dy = mtdd.mtdtraydy              
                            myshape.par("dy")=mtdd.mtdtraydy;              
                            /// Set shape par: dz = chandim              
                            myshape.par("dz")=chandim;              
                            ///Create MCHS              
                            Create("MCHS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCHS");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MCHS to mother MTRA              
                            place.TranslateX(-mtdd.mtdtraydx+mtdd.mtdbplate+chandim);              
                            /// Translate x = -mtdd.mtdtraydx+mtdd.mtdbplate+chandim              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(mtdd.mtdtraydz-chandim);              
                            /// Translate z = mtdd.mtdtraydz-chandim              
                            _stacker -> Position( AgBlock::Find("MCHS"), place );              
                      } // end placement of MCHS           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MCHS");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MCHS to mother MTRA              
                            place.TranslateX(-mtdd.mtdtraydx+mtdd.mtdbplate+chandim);              
                            /// Translate x = -mtdd.mtdtraydx+mtdd.mtdbplate+chandim              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-mtdd.mtdtraydz+chandim);              
                            /// Translate z = -mtdd.mtdtraydz+chandim              
                            place.AlphaY(180);              
                            /// Rotate: AlphaY = 180              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("MCHS"), place );              
                      } // end placement of MCHS           
                      thish=mtdd.mtdigstackngaps*mtdd.mtdigstackgapthick+(mtdd.mtdigstackngaps-1.0)*mtdd.mtdigstackthinglassthick;           
                      _create = AgCreate("MIGS");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MIGS");              
                            createin.par("dx")=thish/2.0;              
                            createin.par("dy")=mtdd.mtdigstackdy;              
                            createin.par("dz")=mtdd.mtdigstackdz;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = thish/2.0              
                            myshape.par("dx")=thish/2.0;              
                            /// Set shape par: dy = mtdd.mtdigstackdy              
                            myshape.par("dy")=mtdd.mtdigstackdy;              
                            /// Set shape par: dz = mtdd.mtdigstackdz              
                            myshape.par("dz")=mtdd.mtdigstackdz;              
                            ///Create MIGS              
                            Create("MIGS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("MIGS");              
                            place.SetMother("MTRA");              
                            /// Add daughter volume MIGS to mother MTRA              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(0);              
                            /// Translate z = 0              
                            _stacker -> Position( AgBlock::Find("MIGS"), place );              
                      } // end placement of MIGS           
                      END_OF_MTRA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MTRA     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MIGS::mInstance = 0;     
          AgBlock *MIGS::Instance(){        
                   if ( mInstance==0 ) mInstance = new MIGS();        
                   return mInstance;        
          }     
          void MIGS::Block( AgCreate create )     
          {         
                ///@addtogroup MIGS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MIGS");              
                            attr.par("seen")=0;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material Glass            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Glass");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            /// Shape Bbox               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MIGS;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("MIGG");           
                      { // Paramters passed in via the Create operator              
                            AgCreate createin("MIGG");              
                            createin.par("dx")=mtdd.mtdigstackgapthick/2.0;              
                            createin.par("dy")=mtdd.mtdigstackdy;              
                            createin.par("dz")=mtdd.mtdigstackdz;              
                            _create = createin;              
                      }           
                      {              
                            AgShape myshape; // undefined shape              
                            /// Set shape par: dx = mtdd.mtdigstackgapthick/2.0              
                            myshape.par("dx")=mtdd.mtdigstackgapthick/2.0;              
                            /// Set shape par: dy = mtdd.mtdigstackdy              
                            myshape.par("dy")=mtdd.mtdigstackdy;              
                            /// Set shape par: dz = mtdd.mtdigstackdz              
                            myshape.par("dz")=mtdd.mtdigstackdz;              
                            ///Create MIGG              
                            Create("MIGG");               
                      }           
                      if ( ngaps==6 )           
                      {              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(-2.5*mtdd.mtdigstackthinglassthick-2.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = -2.5*mtdd.mtdigstackthinglassthick-2.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(-1.5*mtdd.mtdigstackthinglassthick-1.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = -1.5*mtdd.mtdigstackthinglassthick-1.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(-0.5*mtdd.mtdigstackthinglassthick-0.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = -0.5*mtdd.mtdigstackthinglassthick-0.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(0.5*mtdd.mtdigstackthinglassthick+0.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 0.5*mtdd.mtdigstackthinglassthick+0.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(1.5*mtdd.mtdigstackthinglassthick+1.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 1.5*mtdd.mtdigstackthinglassthick+1.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(2.5*mtdd.mtdigstackthinglassthick+2.5*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 2.5*mtdd.mtdigstackthinglassthick+2.5*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                      }           
                      else if ( ngaps==5 )           
                      {              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(-2.0*mtdd.mtdigstackthinglassthick-2.0*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = -2.0*mtdd.mtdigstackthinglassthick-2.0*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(-1.0*mtdd.mtdigstackthinglassthick-1.0*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = -1.0*mtdd.mtdigstackthinglassthick-1.0*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(0.0*mtdd.mtdigstackthinglassthick+0.0*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 0.0*mtdd.mtdigstackthinglassthick+0.0*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(1.0*mtdd.mtdigstackthinglassthick+1.0*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 1.0*mtdd.mtdigstackthinglassthick+1.0*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("MIGG");                 
                                  place.SetMother("MIGS");                 
                                  /// Add daughter volume MIGG to mother MIGS                 
                                  place.TranslateX(2.0*mtdd.mtdigstackthinglassthick+2.0*mtdd.mtdigstackgapthick);                 
                                  /// Translate x = 2.0*mtdd.mtdigstackthinglassthick+2.0*mtdd.mtdigstackgapthick                 
                                  _stacker -> Position( AgBlock::Find("MIGG"), place );                 
                            } // end placement of MIGG              
                      }           
                      END_OF_MIGS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MIGS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *MIGG::mInstance = 0;     
          AgBlock *MIGG::Instance(){        
                   if ( mInstance==0 ) mInstance = new MIGG();        
                   return mInstance;        
          }     
          void MIGG::Block( AgCreate create )     
          {         
                ///@addtogroup MIGG_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("MIGG");              
                            attr.par("seen")=0;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material RPCgas            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Rpcgas");              
                            _material = mat;              
                      }           
                      /// Medium RPCgas_sensitive           
                      ///  isvol = 1           
                      {  AgMedium &med = AgMedium::Get("Rpcgas_sensitive");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            /// Shape Bbox               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_MIGG;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "MIGG", "x", .01, 0, 0, "S");           
                      // deferred module()->AddHit( "MIGG", "y", .01, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "z", .01, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "ptot", 18, 0, 100, "");           
                      // deferred module()->AddHit( "MIGG", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "sleng", .1, 0, 500, "");           
                      // deferred module()->AddHit( "MIGG", "tof", 16, 0, 1.0e-7, "");           
                      // deferred module()->AddHit( "MIGG", "step", .01, 0, 0, "");           
                      // deferred module()->AddHit( "MIGG", "eloss", 16, 0, 1.0e-6, "");           
                      END_OF_MIGG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block MIGG     
