          void EGAP::Block( AgCreate create )     
          {         
                ///@addtogroup EGAP_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material RPCgas a=17.4875239923 z=8.3896353167 dens=0.00427            
                      { AgMaterial &mat = AgMaterial::Get("Rpcgas");              
                            mat.par("a")=17.4875239923;              
                            mat.par("z")=8.3896353167;              
                            mat.par("dens")=0.00427;              
                            _material = mat;              
                      }           
                      /// Medium RPCgas           
                      ///  ifield = 1.0           
                      ///  fieldm = 15.0           
                      ///  tmaxfd = -1.0           
                      ///  epsil = 0.001           
                      ///  stemax = -1.0           
                      ///  deemax = -1.0           
                      ///  stmin = -1.0           
                      ///  isvol = 0           
                      {  AgMedium &med = AgMedium::Get("Rpcgas");              
                               med.Inherit(this);              
                            med.par("ifield")=1.0;              
                            med.par("fieldm")=15.0;              
                            med.par("tmaxfd")=-1.0;              
                            med.par("epsil")=0.001;              
                            med.par("stemax")=-1.0;              
                            med.par("deemax")=-1.0;              
                            med.par("stmin")=-1.0;              
                            med.par("isvol")=0;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("EGAP");              
                            attr.par("seen")=1;              
                            attr.par("colo")=632;              
                            attr.par("lwid")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=16.0;              
                            shape.par("dy")=13.5;              
                            shape.par("dz")=0.007;              
                            /// Shape Bbox dx=16.0 dy=13.5 dz=0.007               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EGAP;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("ECEL");           
                      {              
                            AgShape myshape; // undefined shape              
