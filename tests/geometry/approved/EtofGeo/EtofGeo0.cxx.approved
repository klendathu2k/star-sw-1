          AgBlock *EGLA::mInstance = 0;     
          AgBlock *EGLA::Instance(){        
                   if ( mInstance==0 ) mInstance = new EGLA();        
                   return mInstance;        
          }     
          void EGLA::Block( AgCreate create )     
          {         
                ///@addtogroup EGLA_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material RPCglass a=22.3680270836 z=11.1529065514 dens=2.5            
                      { AgMaterial &mat = AgMaterial::Get("Rpcglass");              
                            mat.par("a")=22.3680270836;              
                            mat.par("z")=11.1529065514;              
                            mat.par("dens")=2.5;              
                            _material = mat;              
                      }           
                      /// Medium RPCglass           
                      ///  ifield = 1.0           
                      ///  fieldm = 15.0           
                      ///  tmaxfd = -1.0           
                      ///  epsil = 0.001           
                      ///  stemax = -1.0           
                      ///  deemax = -1.0           
                      ///  stmin = -1.0           
                      {  AgMedium &med = AgMedium::Get("Rpcglass");              
                               med.Inherit(this);              
                            med.par("ifield")=1.0;              
                            med.par("fieldm")=15.0;              
                            med.par("tmaxfd")=-1.0;              
                            med.par("epsil")=0.001;              
                            med.par("stemax")=-1.0;              
                            med.par("deemax")=-1.0;              
                            med.par("stmin")=-1.0;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("EGLA");              
                            attr.par("seen")=1;              
                            attr.par("colo")=616;              
                            attr.par("lwid")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=16.0;              
                            shape.par("dy")=13.5;              
                            shape.par("dz")=0.014;              
                            /// Shape Bbox dx=16.0 dy=13.5 dz=0.014               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EGLA;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_EGLA:           
                      mCurrent = _save;           
                ///@}        
          } // End Block EGLA     
