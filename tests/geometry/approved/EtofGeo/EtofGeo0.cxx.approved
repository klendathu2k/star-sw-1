          AgBlock *ECEL::mInstance = 0;     
          AgBlock *ECEL::Instance(){        
                   if ( mInstance==0 ) mInstance = new ECEL();        
                   return mInstance;        
          }     
          void ECEL::Block( AgCreate create )     
          {         
                ///@addtogroup ECEL_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material RPCgas a=17.4875239923 z=8.3896353167 dens=0.00427            
                      { AgMaterial &mat = AgMaterial::Get("Rpcgas");              
                            mat.par("a")=17.4875239923;              
                            mat.par("z")=8.3896353167;              
                            mat.par("dens")=0.00427;              
                            _material = mat;              
                      }           
                      /// Medium RPCgas_sens           
                      ///  ifield = 1.0           
                      ///  fieldm = 15.0           
                      ///  tmaxfd = -1.0           
                      ///  epsil = 0.001           
                      ///  stemax = -1.0           
                      ///  deemax = -1.0           
                      ///  stmin = -1.0           
                      ///  isvol = 1.0           
                      {  AgMedium &med = AgMedium::Get("Rpcgas_sens");              
                               med.Inherit(this);              
                            med.par("ifield")=1.0;              
                            med.par("fieldm")=15.0;              
                            med.par("tmaxfd")=-1.0;              
                            med.par("epsil")=0.001;              
                            med.par("stemax")=-1.0;              
                            med.par("deemax")=-1.0;              
                            med.par("stmin")=-1.0;              
                            med.par("isvol")=1.0;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("ECEL");              
                            attr.par("seen")=1;              
                            attr.par("colo")=1;              
                            attr.par("lwid")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=0.5;              
                            shape.par("dy")=13.5;              
                            shape.par("dz")=0.007;              
                            /// Shape Bbox dx=0.5 dy=13.5 dz=0.007               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_ECEL;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "ECEL", "X", 0.01, 0, 0, "HS");           
                      // deferred module()->AddHit( "ECEL", "Y", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "Z", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "ptot", 18, 0.0, 100.0, "");           
                      // deferred module()->AddHit( "ECEL", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "px", 16, -250.0, +250.0, "");           
                      // deferred module()->AddHit( "ECEL", "py", 16, -250.0, +250.0, "");           
                      // deferred module()->AddHit( "ECEL", "pz", 16, -250.0, +250.0, "");           
                      // deferred module()->AddHit( "ECEL", "sleng", 0.1, 0, 500, "");           
                      // deferred module()->AddHit( "ECEL", "tof", 16, 0.0, 1.0e-7, "");           
                      // deferred module()->AddHit( "ECEL", "step", 0.01, 0, 0, "");           
                      // deferred module()->AddHit( "ECEL", "eloss", 16, 0.0, 1.0e-6, "");           
                      END_OF_ECEL:           
                      mCurrent = _save;           
                ///@}        
          } // End Block ECEL     
