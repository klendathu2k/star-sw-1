{
etog_info::sector::Type temp = {
etog_info::sector::BaseType(21),
etog_info::sector::BaseType(22),
etog_info::sector::BaseType(23),
etog_info::sector::BaseType(24),
etog_info::sector::BaseType(13),
etog_info::sector::BaseType(14),
etog_info::sector::BaseType(15),
etog_info::sector::BaseType(16),
etog_info::sector::BaseType(17),
etog_info::sector::BaseType(18),
etog_info::sector::BaseType(19),
etog_info::sector::BaseType(20)
}
;
memcpy(&etog.sector, &temp, sizeof(temp));;
}
// etog_docum.sector = "sector numbering";
ETOG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill etog
++etog._index;
etog.version = 14.1;
// etog_docum.version = "default version, not ready for prime time";
{
etog_info::zplane::Type temp = {
