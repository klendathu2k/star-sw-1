          AgBlock *EPCB::mInstance = 0;     
          AgBlock *EPCB::Instance(){        
                   if ( mInstance==0 ) mInstance = new EPCB();        
                   return mInstance;        
          }     
          void EPCB::Block( AgCreate create )     
          {         
                ///@addtogroup EPCB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material carbon a=12.011 z=6.0 dens=2.265            
                      { AgMaterial &mat = AgMaterial::Get("Carbon");              
                            mat.par("a")=12.011;              
                            mat.par("z")=6.0;              
                            mat.par("dens")=2.265;              
                            _material = mat;              
                      }           
                      /// Medium carbon           
                      ///  ifield = 1.0           
                      ///  fieldm = 20.0           
                      ///  tmaxfd = -1.0           
                      ///  epsil = 0.001           
                      ///  stemax = -1.0           
                      ///  deemax = -1.0           
                      ///  stmin = -1.0           
                      {  AgMedium &med = AgMedium::Get("Carbon");              
                               med.Inherit(this);              
                            med.par("ifield")=1.0;              
                            med.par("fieldm")=20.0;              
                            med.par("tmaxfd")=-1.0;              
                            med.par("epsil")=0.001;              
                            med.par("stemax")=-1.0;              
                            med.par("deemax")=-1.0;              
                            med.par("stmin")=-1.0;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("EPCB");              
                            attr.par("seen")=1;              
                            attr.par("colo")=416;              
                            attr.par("lwid")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Bbox");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx")=17.0;              
                            shape.par("dy")=5.0;              
                            shape.par("dz")=0.15;              
                            /// Shape Bbox dx=17.0 dy=5.0 dz=0.15               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_EPCB;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_EPCB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block EPCB     
    // ----------------------------------------------------------------------- geoctr
       void EtofGeo0::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup EtofGeo0_revision        
             ///@{           
                   /// Author: root2agml           
             ///@}        
             ///@addtogroup EtofGeo0_revision        
             ///@{           
                   /// Created: now           
             ///@}        
             AddBlock("ETOF", ETOF::Instance());        
             AddBlock("EGAS", EGAS::Instance());        
             AddBlock("ECOU", ECOU::Instance());        
             AddBlock("EGLA", EGLA::Instance());        
             AddBlock("EGAP", EGAP::Instance());        
             AddBlock("ECEL", ECEL::Instance());        
             AddBlock("EPCB", EPCB::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill etoc
++etoc._index;
etoc.version = 14.0;
// etoc_docum.version = "2019 and later";
ETOC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill etog
++etog._index;
etog.version = 14.0;
// etog_docum.version = "default version, not ready for prime time";
{
etog_info::zplane::Type temp = {
etog_info::zplane::BaseType(-277.65),
etog_info::zplane::BaseType(-290.52),
etog_info::zplane::BaseType(-303.37)
}
;
memcpy(&etog.zplane, &temp, sizeof(temp));;
}
// etog_docum.zplane = "z position of the three planes";
{
etog_info::active::Type temp = {
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1),
etog_info::active::BaseType(1)
}
;
memcpy(&etog.active, &temp, sizeof(temp));;
}
