      CREATE ETOF
      IF ETOG_active(1).eq.1 { 
      CALL AgsReset 
      CALL agml_position_begin('ETOF') 
      %mother = 'CAVE' 
      %title = 'ETOF' 
      %exname = 'POSITION' ! agml placement 
      %ncopy = 121.0 
