                            shape.Rmax(0)=ssup.con3idmn+roffset+ssup.cabthk/2;              
                            shape.Rmax(1)=ssup.con4idmn+roffset+ssup.cabthk/2;              
                            shape.Rmax(2)=ssup.con4idmx+roffset+ssup.cabthk/2;              
