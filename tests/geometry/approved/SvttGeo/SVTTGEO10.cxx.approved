          void SWCW::Block( AgCreate create )     
          {         
                ///@addtogroup SWCW_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Water            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Water");              
                            _material = mat;              
                      }           
                      { AgAttribute attr = AgAttribute("SWCW");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
