    // ----------------------------------------------------------------------- geoctr
       void SVTTGEO10::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup SVTTGEO10_revision        
             ///@{           
                   /// Author: Maxim Potekhin           
             ///@}        
             ///@addtogroup SVTTGEO10_revision        
             ///@{           
                   /// Created:  15 Aug 2007            
             ///@}        
             AddBlock("SVTT", SVTT::Instance());        
             AddBlock("SLYD", SLYD::Instance());        
             AddBlock("SLSD", SLSD::Instance());        
             AddBlock("SLDI", SLDI::Instance());        
             AddBlock("STLI", STLI::Instance());        
             AddBlock("STSI", STSI::Instance());        
             AddBlock("SVTD", SVTD::Instance());        
             AddBlock("SBER", SBER::Instance());        
             AddBlock("STAB", STAB::Instance());        
             AddBlock("STRU", STRU::Instance());        
             AddBlock("SPCB", SPCB::Instance());        
             AddBlock("SRHC", SRHC::Instance());        
             AddBlock("SBWC", SBWC::Instance());        
             AddBlock("SWCM", SWCM::Instance());        
             AddBlock("SXAI", SXAI::Instance());        
             AddBlock("SXBI", SXBI::Instance());        
             AddBlock("STRA", STRA::Instance());        
             AddBlock("SSID", SSID::Instance());        
             AddBlock("SSIR", SSIR::Instance());        
             AddBlock("SELE", SELE::Instance());        
             AddBlock("SWCH", SWCH::Instance());        
             AddBlock("SWCW", SWCW::Instance());        
             AddBlock("SWCS", SWCS::Instance());        
             AddBlock("SBOI", SBOI::Instance());        
             AddBlock("SAGP", SAGP::Instance());        
             AddBlock("SDYE", SDYE::Instance());        
             AddBlock("SECA", SECA::Instance());        
             AddBlock("SIRP", SIRP::Instance());        
             AddBlock("SIRT", SIRT::Instance());        
             AddBlock("SOER", SOER::Instance());        
             AddBlock("SCON", SCON::Instance());        
             AddBlock("SROD", SROD::Instance());        
             AddBlock("SGRA", SGRA::Instance());        
             AddBlock("STAP", STAP::Instance());        
             AddBlock("STAC", STAC::Instance());        
             AddBlock("SHLA", SHLA::Instance());        
             AddBlock("SHLB", SHLB::Instance());        
             AddBlock("SHMA", SHMA::Instance());        
             AddBlock("SHMB", SHMB::Instance());        
             AddBlock("SWHO", SWHO::Instance());        
             AddBlock("SHWA", SHWA::Instance());        
             AddBlock("SCMY", SCMY::Instance());        
             AddBlock("SCAL", SCAL::Instance());        
             AddBlock("SWMM", SWMM::Instance());        
             AddBlock("SWMB", SWMB::Instance());        
             AddBlock("SWRP", SWRP::Instance());        
             AddBlock("SXRL", SXRL::Instance());        
             AddBlock("SYRU", SYRU::Instance());        
             AddBlock("SWMT", SWMT::Instance());        
             AddBlock("SWMS", SWMS::Instance());        
             AddBlock("SWMW", SWMW::Instance());        
             AddBlock("SOTB", SOTB::Instance());        
             AddBlock("SITB", SITB::Instance());        
             AddBlock("SBRG", SBRG::Instance());        
             AddBlock("SBRM", SBRM::Instance());        
             AddBlock("SBRI", SBRI::Instance());        
             AddBlock("SOES", SOES::Instance());        
             AddBlock("SIES", SIES::Instance());        
             AddBlock("SOSM", SOSM::Instance());        
             AddBlock("SISM", SISM::Instance());        
             AddBlock("SCRW", SCRW::Instance());        
             AddBlock("SGLA", SGLA::Instance());        
             AddBlock("SBSP", SBSP::Instance());        
             AddBlock("SAKM", SAKM::Instance());        
             AddBlock("SCKM", SCKM::Instance());        
             AddBlock("SBSR", SBSR::Instance());        
             AddBlock("SBCR", SBCR::Instance());        
             AddBlock("SBRX", SBRX::Instance());        
             AddBlock("SBRL", SBRL::Instance());        
             AddBlock("SBMM", SBMM::Instance());        
             AddBlock("SBMO", SBMO::Instance());        
             AddBlock("SBMI", SBMI::Instance());        
             AddBlock("SMRD", SMRD::Instance());        
             AddBlock("SALM", SALM::Instance());        
             AddBlock("SISH", SISH::Instance());        
             AddBlock("SSSH", SSSH::Instance());        
             AddBlock("SOSH", SOSH::Instance());        
             AddBlock("SCBM", SCBM::Instance());        
             AddBlock("SCBL", SCBL::Instance());        
             AddBlock("SFED", SFED::Instance());        
             AddBlock("SPLS", SPLS::Instance());        
             AddBlock("SOUM", SOUM::Instance());        
             AddBlock("SOUR", SOUR::Instance());        
             radii(1)=6.37;        
             radii(2)=7.38;        
             radii(3)=10.38;        
             radii(4)=11.27;        
             radii(5)=14.19;        
             radii(6)=15.13;        
             rad_offset=0.015;        
             shield_phi(1)=9.0;        
             shield_phi(2)=27.0;        
             shield_phi(3)=45.0;        
             shield_phi(4)=63.0;        
             // ---------------------------------------------------------------------------------------------------        
             // Fill svtg
++svtg._index;
svtg.version = 2;
// svtg_docum.version = " geometry version ";
svtg.nlayer = 7;
// svtg_docum.nlayer = " number of svt layers (was 7) ";
svtg.rsizemin = 4.100;
// svtg_docum.rsizemin = " STV innermost radius ";
svtg.rsizemax = 46.107;
// svtg_docum.rsizemax = " STV outermost radius ";
svtg.zsizemax = 270;
// svtg_docum.zsizemax = " SVT+FTPC length ";
svtg.angoff = 0;
// svtg_docum.angoff = " angular offset x1 for slayer 2 x2 for slayer 3 ";
svtg.supportver = 1;
// svtg_docum.supportver = " versioning of the shield ";
svtg.conever = 1;
// svtg_docum.conever = " versioning of the support cone ";
svtg.ifmany = 0;
// svtg_docum.ifmany = " whether we use the geant MANY option ";
svtg.nmin = 1;
// svtg_docum.nmin = " the index of the innermost layer ";
SVTG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill swca
++swca._index;
swca.version = 1;
// swca_docum.version = " geometry version ";
swca.length = 56.04;
// swca_docum.length = " ladder length ";
swca.waferwid = 6.305;
// swca_docum.waferwid = " wafer width ";
swca.waferlen = 6.305;
// swca_docum.waferlen = " wafer length ";
swca.waferthk = 0.0300;
// swca_docum.waferthk = " wafer thickness ";
swca.rohathk = 0.0381;
// swca_docum.rohathk = " Roha cell plus glue thickness  ";
swca.wafcarwd = 1.5;
// swca_docum.wafcarwd = " wafer carrier rails width ";
swca.wafcarth = 0.0300;
// swca_docum.wafcarth = " wafer carrier thickness  ";
swca.wafergap = 0.0;
// swca_docum.wafergap = " inter-wafer gap - there is a 50 micron uncertainty ";
swca.drift = 1;
// swca_docum.drift = " drift direction ";
swca.strutlen = 1.0;
