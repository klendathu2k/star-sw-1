                      _create = AgCreate("STSI");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create STSI              
                            Create("STSI");               
                      }           
                      END_OF_STLI:           
                      mCurrent = _save;           
                ///@}        
          } // End Block STLI     
