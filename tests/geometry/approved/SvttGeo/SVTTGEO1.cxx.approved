                      // deferred module()->AddHit( "SVTD", "tof", 16, 0, 1.0e-6, "");           
                      // deferred module()->AddHit( "SVTD", "step", .01, 0, 0, "");           
                      // deferred module()->AddHit( "SVTD", "eloss", 22, 0., 0.01, "");           
                      END_OF_SVTD:           
