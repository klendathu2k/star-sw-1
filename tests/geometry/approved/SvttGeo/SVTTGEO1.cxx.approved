                            shape.par("dy")=swca.length/2;              
                            shape.par("dz")=(selc.watthk/2);              
                            /// Shape Bbox dx=(selc.elcawid-2.0*selc.bethk)/2 dy=swca.length/2 dz=(selc.watthk/2)               
