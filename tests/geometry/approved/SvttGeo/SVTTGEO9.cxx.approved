                            /// Shape Tube rmin=ir_rmin rmax=serg.irngtrmx dz=0.5*(brack_z-endrng_z)               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SIES;              
