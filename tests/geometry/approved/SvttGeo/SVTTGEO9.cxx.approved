swca.strutlen = 1.0;
// swca_docum.strutlen = " len (z) of strut between waf car. rails (approx) ";
SWCA.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ssup
++ssup._index;
ssup.version = 1;
// ssup_docum.version = " geometry version ";
ssup.cabthk = 0.05;
// ssup_docum.cabthk = " thickness of layer of cables on support cone ";
ssup.hosrmn = 0.75;
