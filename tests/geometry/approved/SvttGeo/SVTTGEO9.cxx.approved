ssld.sinrinn = 5.9;
// ssld_docum.sinrinn = " inner shield cylinder, inner radius ";
ssld.sinrout = 5.908;
// ssld_docum.sinrout = " inner shield cylinder, outer radius ";
SSLD.fill();
        
             /// Loop on i from 1 to 4 step=1        
             for ( i=1; (1>0)? (i<=4):(i>=4); i+=1 )        
             {           
                   rad_cones_in(i)=8.5+2.60*(i-1);           
                   rad_cones_out(i)=15.0+0.85*(i-1);           
             }        
             // ---------------------------------------------------------------------------------------------------        
             // Fill scbp
++scbp._index;
scbp.layer = 1;
// scbp_docum.layer = " Layer ";
scbp.len = 1.85;
// scbp_docum.len = " Length ";
scbp.rmin1 = rad_cones_in(1);
// scbp_docum.rmin1 = " Min radius closer to wafers ";
scbp.rmin2 = rad_cones_out(1);
// scbp_docum.rmin2 = " Min radius further from wafers ";
scbp.vol = 7.24+3.21;
// scbp_docum.vol = " Volume of copper, LV+HV cables ";
SCBP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill scbp
++scbp._index;
scbp.layer = 2;
// scbp_docum.layer = " Layer ";
scbp.rmin1 = rad_cones_in(2);
// scbp_docum.rmin1 = " Min radius closer to wafers ";
scbp.rmin2 = rad_cones_out(2);
// scbp_docum.rmin2 = " Min radius further from wafers ";
scbp.vol = 15.54+5.7;
// scbp_docum.vol = " Volume of copper, LV+HV cables ";
SCBP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill scbp
++scbp._index;
scbp.layer = 3;
// scbp_docum.layer = " Layer ";
scbp.rmin1 = rad_cones_in(3);
// scbp_docum.rmin1 = " Min radius closer to wafers ";
scbp.rmin2 = rad_cones_out(3);
// scbp_docum.rmin2 = " Min radius further from wafers ";
scbp.vol = 4.05+2.02+3.67+1.69;
// scbp_docum.vol = " Volume of copper, LV+HV cables -- 3+4 layers coalesce ";
SCBP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill scbp
++scbp._index;
scbp.layer = 4;
// scbp_docum.layer = " Layer (former 5th) ";
scbp.rmin1 = rad_cones_in(4);
// scbp_docum.rmin1 = " Min radius closer to wafers ";
scbp.rmin2 = rad_cones_out(4);
// scbp_docum.rmin2 = " Min radius further from wafers ";
scbp.vol = 6.95+2.43;
// scbp_docum.vol = " Volume of copper, LV+HV cables ";
SCBP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfep
++sfep._index;
sfep.layer = 1;
// sfep_docum.layer = " Layer ";
sfep.len = 1.85;
// sfep_docum.len = " Length ";
sfep.rmin1 = 0.5*(rad_cones_in(1)+rad_cones_in(2));
// sfep_docum.rmin1 = " Min radius closer to wafers ";
sfep.rmin2 = 0.5*(rad_cones_out(1)+rad_cones_out(2));
// sfep_docum.rmin2 = " Min radius further from wafers ";
sfep.vol = 16.0;
// sfep_docum.vol = " Volume of water ";
sfep.volplast = 38.4;
// sfep_docum.volplast = " Volume of plastic ";
SFEP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfep
++sfep._index;
sfep.layer = 2;
// sfep_docum.layer = " Layer ";
sfep.rmin1 = 0.5*(rad_cones_in(2)+rad_cones_in(3));
// sfep_docum.rmin1 = " Min radius closer to wafers ";
sfep.rmin2 = 0.5*(rad_cones_out(2)+rad_cones_out(3));
// sfep_docum.rmin2 = " Min radius further from wafers ";
sfep.vol = 24.0;
// sfep_docum.vol = " Volume of water ";
sfep.volplast = 57.6;
// sfep_docum.volplast = " Volume of plastic ";
SFEP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill sfep
++sfep._index;
sfep.layer = 3;
// sfep_docum.layer = " Layer ";
sfep.rmin1 = 0.5*(rad_cones_in(3)+rad_cones_in(4));
// sfep_docum.rmin1 = " Min radius closer to wafers ";
sfep.rmin2 = 0.5*(rad_cones_out(3)+rad_cones_out(4));
// sfep_docum.rmin2 = " Min radius further from wafers ";
sfep.vol = 32;
// sfep_docum.vol = " Volume of water ";
sfep.volplast = 76.8;
// sfep_docum.volplast = " Volume of plastic ";
SFEP.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill swcx
++swcx._index;
swcx.layer = 1;
// swcx_docum.layer = " version ";
swcx.length = 2.8;
// swcx_docum.length = " of the ring in the Z direction ";
swcx.dr = 0.72;
// swcx_docum.dr = " thickness of the mother layer ";
swcx.rad = 0.2;
// swcx_docum.rad = " inner plastic tube radius ";
swcx.offset = -2.0;
// swcx_docum.offset = " from the edge of the ladder support, inward ";
swcx.roffset = 1.0;
// swcx_docum.roffset = " Radial offset ";
swcx.wall = 0.16;
// swcx_docum.wall = " thickness of the plastic pipe wall ";
SWCX.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill soup
++soup._index;
soup.version = 1;
// soup_docum.version = " Version ";
soup.length = 82.5;
// soup_docum.length = " Length ";
soup.rout = 19.41;
// soup_docum.rout = " Outer radius of the shield ";
soup.dr = 0.711;
// soup_docum.dr = " Diameter of the tubes constituting the cage (also dR of the mother) ";
soup.phi1 = 0.0;
// soup_docum.phi1 = " Starting angle of the mother ";
soup.phi2 = 70.0;
// soup_docum.phi2 = " Finishing angle of the mother ";
soup.diamout = 0.711;
// soup_docum.diamout = " Outer diam of the carbon tube ";
soup.diamin = 0.620;
// soup_docum.diamin = " Inner diam of the carbon tube ";
SOUP.fill();
        
             /// USE svtg _index=1;        
             SVTG.use( __svtg__index__ = 1 );
        
             /// USE swca _index=1;        
             SWCA.use( __swca__index__ = 1 );
        
             /// USE selc _index=1;        
             SELC.use( __selc__index__ = 1 );
        
             /// USE ssup version=svtg.conever;        
             SSUP.use( __ssup_version__ = svtg.conever );
        
             /// USE ssub _index=1;        
             SSUB.use( __ssub__index__ = 1 );
        
             /// USE serg _index=1;        
             SERG.use( __serg__index__ = 1 );
        
             /// USE swam _index=1;        
             SWAM.use( __swam__index__ = 1 );
        
             /// USE selc _index=1;        
             SELC.use( __selc__index__ = 1 );
        
             /// USE ssld version=svtg.supportver;        
             SSLD.use( __ssld_version__ = svtg.supportver );
        
             /// USE scbp _index=1;        
             SCBP.use( __scbp__index__ = 1 );
        
             /// USE swcx _index=1;        
             SWCX.use( __swcx__index__ = 1 );
        
             /// USE soup _index=1;        
             SOUP.use( __soup__index__ = 1 );
        
             if ( svtg.supportver==2 )        
             {           
                   svtg.rsizemin=6.0;           
             }        
             /// Component Si	a=28.08	z=14	w=0.6*1*28./60.        
             /// Component O	a=16	z=8	w=0.6*2*16./60. + 0.4*4*16./174.        
             /// Component C	a=12	z=6	w=0.4*8*12./174.        
             /// Component H	a=1	z=1	w=0.4*14*1./174.        
             /// Mixture G10 dens=1.7        
             {  AgMaterial &mix = AgMaterial::Get("G10");           
                   mix.Component("Si",28.08,14,0.6*1*28./60.);           
                   mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);           
                   mix.Component("C",12,6,0.4*8*12./174.);           
                   mix.Component("H",1,1,0.4*14*1./174.);           
                   mix.par("dens")=1.7;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component C5	a=12	z=6	w=10000*5        
             /// Component H4	a=1	z=1	w=10000*4        
             /// Component O2	a=16	z=8	w=10000*2        
             /// Component Al	a=27	z=13	w=10000*0.2302        
             /// Mixture ALKAP dens=1.432        
             {  AgMaterial &mix = AgMaterial::Get("Alkap");           
                   mix.Component("C5",12,6,10000*5);           
                   mix.Component("H4",1,1,10000*4);           
                   mix.Component("O2",16,8,10000*2);           
                   mix.Component("Al",27,13,10000*0.2302);           
                   mix.par("dens")=1.432;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             if ( swam.len>0 )        
             {           
                   /// Component H2	a=1	z=1	w=2           
                   /// Component O	a=16	z=8	w=1           
                   /// Mixture Water dens=1.0           
                   {  AgMaterial &mix = AgMaterial::Get("Water");              
                         mix.Component("H2",1,1,2);              
                         mix.Component("O",16,8,1);              
                         mix.par("dens")=1.0;              
                         mix.lock();              
                         _material = mix;              
                         _material.lock();              
                   }           
             }        
             else        
             {           
                   /// Mixture Water dens=0.0009           
                   {  AgMaterial &mix = AgMaterial::Get("Water");              
                         mix.par("dens")=0.0009;              
                         mix.lock();              
                         _material = mix;              
                         _material.lock();              
                   }           
             }        
             if ( svtg.ifmany>0 )        
             {           
                   _create = AgCreate("SVTT");           
                   {              
                         AgShape myshape; // undefined shape              
                         ///Create SVTT              
                         Create("SVTT");               
                   }           
                   {              
                         AgPosition  place;              
                         place.SetBlock("SVTT");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume SVTT to mother CAVE              
                         place.par("only")=AgPosition::kMany;              
                         /// Overlap: agposition::kmany              
                         _stacker -> Position( AgBlock::Find("SVTT"), place );              
                   } // end placement of SVTT           
             }        
             else        
             {           
                   _create = AgCreate("SVTT");           
                   {              
                         AgShape myshape; // undefined shape              
                         ///Create SVTT              
                         Create("SVTT");               
                   }           
                   {              
                         AgPosition  place;              
                         place.SetBlock("SVTT");              
                         place.SetMother("CAVE");              
                         /// Add daughter volume SVTT to mother CAVE              
                         _stacker -> Position( AgBlock::Find("SVTT"), place );              
                   } // end placement of SVTT           
             }        
       }; // SVTTGEO9     
 }; // namespace SVTTGEO9  
 