// ssld_docum.sseprinn = " separation shield cylinder, inner radius ";
ssld.sseprout = 22.018;
// ssld_docum.sseprout = " separation shield cylinder, outer radius ";
ssld.sseplen = 55.4;
// ssld_docum.sseplen = " separation shield cylinder, half length ";
ssld.soutrinn = 29.5;
// ssld_docum.soutrinn = " outer shield cylinder, inner radius ";
ssld.soutrout = 29.52;
// ssld_docum.soutrout = " outer shield cylinder, outer radius ";
ssld.soutlen = 65.4;
// ssld_docum.soutlen = " outer shield cylinder, half length ";
ssld.almeshid = 9.7;
// ssld_docum.almeshid = " Aluminum shield mesh inner diameter ";
ssld.almeshod = 44;
// ssld_docum.almeshod = " Aluminum shield mesh outer diameter ";
ssld.almshthk = 0.03;
// ssld_docum.almshthk = " Aluminum shield mesh effective thickness ";
ssld.almshpos = 53.5;
// ssld_docum.almshpos = " Aluminum shield mesh z position ";
