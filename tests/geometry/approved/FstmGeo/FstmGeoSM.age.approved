      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FHOD') 
      %mother = 'FTRO' 
      %title = 'FHOD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(heatsink_x(4)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(heatsink_y(4)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(heatsink_z(4)) 
      CALL agml_translate_z( %z ) 
      %dx = real(heatsink_dx(4)) 
      %dy = real(heatsink_dy(4)) 
      %dz = real(heatsink_dz(4)) 
      ag_alphay = real(heatsink_rotz(4)) 
      CALL agml_rotate_y(%alphay) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSWT
      BLOCK FSWT   Tube for FST outer wedges
      ATTRIBUTE FSWT seen=1 colo=14
      MATERIAL PEEK
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTUW
      BLOCK FTUW   Tube segment for FST inner wedge
      ATTRIBUTE FTUW seen=1 colo=14
      MATERIAL PEEK_FTUW
      SHAPE tubs rmin=innerbaseb_rmin rmax=innerbaseb_rmax,
            phi1=innerbaseb_phi1 phi2=innerbaseb_phi2,
            dz=innerbaseb_dz
      CREATE FHBE
      CREATE FHBF
      CREATE FHBG
      CREATE FHBH
      CALL AgsReset 
      CALL agml_position_begin('FHBE') 
      %mother = 'FTUW' 
      %title = 'FHBE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(heatsink_x(5)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(heatsink_y(5)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(heatsink_z(5)) 
      CALL agml_translate_z( %z ) 
      %dx = real(heatsink_dx(5)) 
      %dy = real(heatsink_dy(5)) 
      %dz = real(heatsink_dz(5)) 
      ag_alphaz = real(heatsink_rotz(5)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FHBF') 
      %mother = 'FTUW' 
      %title = 'FHBF' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(heatsink_x(6)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(heatsink_y(6)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(heatsink_z(6)) 
      CALL agml_translate_z( %z ) 
      %dx = real(heatsink_dx(6)) 
      %dy = real(heatsink_dy(6)) 
      %dz = real(heatsink_dz(6)) 
      ag_alphaz = real(heatsink_rotz(6)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FHBG') 
      %mother = 'FTUW' 
      %title = 'FHBG' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(heatsink_x(7)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(heatsink_y(7)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(heatsink_z(7)) 
      CALL agml_translate_z( %z ) 
      %dx = real(heatsink_dx(7)) 
      %dy = real(heatsink_dy(7)) 
      %dz = real(heatsink_dz(7)) 
      ag_alphaz = real(heatsink_rotz(7)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CALL AgsReset 
      CALL agml_position_begin('FHBH') 
      %mother = 'FTUW' 
      %title = 'FHBH' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real(heatsink_x(8)) 
      CALL agml_translate_x( %x ) 
      ag_y = real(heatsink_y(8)) 
      CALL agml_translate_y( %y ) 
      ag_z = real(heatsink_z(8)) 
      CALL agml_translate_z( %z ) 
      %dx = real(heatsink_dx(8)) 
      %dy = real(heatsink_dy(8)) 
      %dz = real(heatsink_dz(8)) 
      ag_alphaz = real(heatsink_rotz(8)) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'MOTHER_X_Y_Z_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTIA
      BLOCK FTIA   Trapizoid for FST inner wedge
      ATTRIBUTE FTIA seen=1 colo=14
      MATERIAL PEEK
      SHAPE trd1 dx1=innerbasea_dx1(1) dx2=innerbasea_dx2(1),
            dy=innerbasea_dy dz=innerbasea_dz(1)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTIB
      BLOCK FTIB   Trapizoid for FST inner wedge
      ATTRIBUTE FTIB seen=1 colo=14
      MATERIAL PEEK
      MATERIAL PEEKapprox dens=1.66651
      SHAPE trd1 dx1=innerbasea_dx1(2) dx2=innerbasea_dx2(2),
            dy=innerbasea_dy dz=innerbasea_dz(2)
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHOA
      BLOCK FHOA   Box for the FST heat sink A
      ATTRIBUTE FHOA seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSa dens=7.258035
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHOB
      BLOCK FHOB   Box for the FST heat sink B
      ATTRIBUTE FHOB seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSb dens=7.118835
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHOC
      BLOCK FHOC   Box for the FST heat sink C
      ATTRIBUTE FHOC seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSc dens=7.11903
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHOD
      BLOCK FHOD   Box for the FST heat sink D
      ATTRIBUTE FHOD seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSd dens=6.997245
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHBE
      BLOCK FHBE   Box for the FST heat sink E
      ATTRIBUTE FHBE seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSe dens=5.7105412
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHBF
      BLOCK FHBF   Box for the FST heat sink F
      ATTRIBUTE FHBF seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSf dens=6.4503684
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHBG
      BLOCK FHBG   Box for the FST heat sink G
      ATTRIBUTE FHBG seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSg dens=6.4503684
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHBH
      BLOCK FHBH   Box for the FST heat sink H
      ATTRIBUTE FHBH seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSh dens=5.7105412
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSCT
      BLOCK FSCT   Tube for FST cooling tube
      ATTRIBUTE FSCT seen=1 colo=795
      MATERIAL SteelNOVECMix
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSCL
      BLOCK FSCL   Tube for FST coolant
      ATTRIBUTE FSCL seen=1 colo=432
      MATERIAL NOVEC7200
      SHAPE tube rmin=0 rmax=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSAC
      BLOCK FSAC   Box for the FST APV chips
      ATTRIBUTE FSAC seen=1 colo=8
      MATERIAL APVMix
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSTB
      BLOCK FSTB   Box for the FST T-board
      ATTRIBUTE FSTB seen=1 colo=8
      MATERIAL G10
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTHC
      BLOCK FTHC   Box for the FST T-board connectors
      ATTRIBUTE FTHC seen=1 colo=1
      MATERIAL DELRIN
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTOH
      BLOCK FTOH   Tube segment for FST outer hybrid
      ATTRIBUTE FTOH seen=1 colo=797
      MATERIAL Kapton
      SHAPE tubs rmin=outerhybrida_rmin rmax=outerhybrida_rmax,
            phi1=outerhybrida_phi1 phi2=outerhybrida_phi2,
            dz=outerhybrida_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTIH
      BLOCK FTIH   Tube segment for FST inner hybrid
      ATTRIBUTE FTIH seen=1 colo=797
      MATERIAL Kapton
      SHAPE tubs rmin=innerhybrida_rmin rmax=innerhybrida_rmax,
            phi1=innerhybrida_phi1 phi2=innerhybrida_phi2,
            dz=innerhybrida_dz
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FSBH
      BLOCK FSBH   Box for FST hybrid
      ATTRIBUTE FSBH seen=1 colo=797
      MATERIAL Kapton
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FTUS
      BLOCK FTUS   Tube segment for FST silicon (active area)
      ATTRIBUTE FTUS seen=1 colo=4
      MATERIAL silicon
      MATERIAL silicon isvol=1
      SHAPE tubs rmin=0 rmax=0 phi1=0 phi2=0 dz=0
      Call GStPar(ag_imed, 'CUTGAM', 1 MeV)
      Call GStPar(ag_imed, 'CUTELE', 1 MeV)
      Call GStPar(ag_imed, 'CUTNEU', 10 keV)
      Call GStPar(ag_imed, 'CUTHAD', 10 keV)
      Call GStPar(ag_imed, 'CUTMUO', 10 keV)
      Call GStPar(ag_imed, 'BCUTE', 1 MeV)
      Call GStPar(ag_imed, 'DCUTE', 10000 GeV)
      Call GStPar(ag_imed, 'DCUTM', 10000 GeV)
      Call GStPar(ag_imed, 'PPCUTM', 10 keV)
      HITS FTUS zz:0.00001:S yy:0.00001:S xx:0.00001:S z:0.00001:S y:0.00001:S x:0.00001:S,
            ptot:16:(0,100) cx:10: cy:10: cz:10: sleng:16:(0,500) tof:0: step:.0001:,
            eloss:16:
      ENDBLOCK
      <W> '===>> 	[End AgML Module FstmGeoSM]	 <<==='; (A32,/,/);
      END! Module FstmGeoSM
