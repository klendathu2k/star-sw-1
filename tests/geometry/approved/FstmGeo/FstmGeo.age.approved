      ! ---------------------------------------------------------------------------------- FTUS
      BLOCK FTUS   Tube segment for FST silicon (active area)
      ATTRIBUTE FTUS seen=1 colo=4
      MATERIAL silicon
      MATERIAL silicon isvol=1
      SHAPE tubs rmin=0 rmax=0 phi1=0 phi2=0 dz=0
      Call GStPar(ag_imed, 'CUTGAM', 1 MeV)
      Call GStPar(ag_imed, 'CUTELE', 1 MeV)
      Call GStPar(ag_imed, 'CUTNEU', 10 keV)
      Call GStPar(ag_imed, 'CUTHAD', 10 keV)
      Call GStPar(ag_imed, 'CUTMUO', 10 keV)
      Call GStPar(ag_imed, 'BCUTE', 1 MeV)
      Call GStPar(ag_imed, 'DCUTE', 10000 GeV)
      Call GStPar(ag_imed, 'DCUTM', 10000 GeV)
      Call GStPar(ag_imed, 'PPCUTM', 10 keV)
      HITS FTUS zz:0.00001:S yy:0.00001:S xx:0.00001:S z:0.00001:S y:0.00001:S x:0.00001:S,
            ptot:16:(0,100) cx:10: cy:10: cz:10: sleng:16:(0,500) tof:0: step:.0001:,
            eloss:16:
      ENDBLOCK
