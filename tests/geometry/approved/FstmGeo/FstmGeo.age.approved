      MATERIAL Aluminium
      MATERIAL AluminiumHSh dens=3.18136
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHBE
      BLOCK FHBE   Box for the FST heat sink E
      ATTRIBUTE FHBE seen=1 colo=430
      MATERIAL Aluminium
      MATERIAL AluminiumHSe dens=3.18136
