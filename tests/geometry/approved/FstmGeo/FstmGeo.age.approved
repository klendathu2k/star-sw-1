      MATERIAL Aluminium
      MATERIAL AluminiumHSg dens=3.59352
      SHAPE box dx=0 dy=0 dz=0
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FHAH
      BLOCK FHAH   Box for the FST heat sink H
