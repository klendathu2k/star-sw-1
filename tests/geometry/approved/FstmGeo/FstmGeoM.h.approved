         size_t iadd = (size_t)innersilicon_info::address;
         iadd += Offset();
         return (void *)iadd;}
  typedef int BaseType;
  typedef int Type;
  static const int rank = 0;};
static void              *address;
static AgMLStructureBase *structure;
};
#endif
 
