          void FTUS::Block( AgCreate create )     
          {         
                ///@addtogroup FTUS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FTUS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=4;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material silicon            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Silicon");              
                            _material = mat;              
                      }           
                      /// Material silicon isvol=1            
                      { AgMaterial &mat = AgMaterial::Get("Silicon");              
                            mat.par("isvol")=1;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=0;              
                            shape.par("phi1")=0;              
                            shape.par("phi2")=0;              
                            shape.par("dz")=0;              
                            /// Shape Tubs rmin=0 rmax=0 phi1=0 phi2=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTUS;              
                            _stacker -> Build(this);              
                      }           
                      // parameter cutgam = 1*0.001 (deferred)           
                      // parameter cutele = 1*0.001 (deferred)           
                      // parameter cutneu = 10*1.0e-6 (deferred)           
                      // parameter cuthad = 10*1.0e-6 (deferred)           
                      // parameter cutmuo = 10*1.0e-6 (deferred)           
                      // parameter bcute = 1*0.001 (deferred)           
                      // parameter dcute = 10000*1.0 (deferred)           
                      // parameter dcutm = 10000*1.0 (deferred)           
                      // parameter ppcutm = 10*1.0e-6 (deferred)           
                      // deferred module()->AddHit( "FTUS", "zz", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "yy", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "xx", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "z", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "y", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "x", 0.00001, 0, 0, "S");           
                      // deferred module()->AddHit( "FTUS", "ptot", 16, 0, 100, "");           
                      // deferred module()->AddHit( "FTUS", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "FTUS", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "FTUS", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "FTUS", "sleng", 16, 0, 500, "");           
                      // deferred module()->AddHit( "FTUS", "tof", 0, 0, 0, "");           
                      // deferred module()->AddHit( "FTUS", "step", .0001, 0, 0, "");           
                      // deferred module()->AddHit( "FTUS", "eloss", 16, 0, 0, "");           
                      END_OF_FTUS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTUS     
    // ----------------------------------------------------------------------- geoctr
       void FstmGeoSM::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup FstmGeoSM_revision        
             ///@{           
                   /// Author: Te-Chuan Huang, Flemming Videbaek, Gavin Wilks            
             ///@}        
             ///@addtogroup FstmGeoSM_revision        
             ///@{           
                   /// Created: 09 March, 2020           
             ///@}        
             AddBlock("FSTM", FSTM::Instance());        
             AddBlock("FSTW", FSTW::Instance());        
             AddBlock("FTUO", FTUO::Instance());        
             AddBlock("FTUR", FTUR::Instance());        
             AddBlock("FTRO", FTRO::Instance());        
             AddBlock("FSWT", FSWT::Instance());        
             AddBlock("FTUW", FTUW::Instance());        
             AddBlock("FTIA", FTIA::Instance());        
             AddBlock("FTIB", FTIB::Instance());        
             AddBlock("FHOA", FHOA::Instance());        
             AddBlock("FHOB", FHOB::Instance());        
             AddBlock("FHOC", FHOC::Instance());        
             AddBlock("FHOD", FHOD::Instance());        
             AddBlock("FHBE", FHBE::Instance());        
             AddBlock("FHBF", FHBF::Instance());        
             AddBlock("FHBG", FHBG::Instance());        
             AddBlock("FHBH", FHBH::Instance());        
             AddBlock("FSCT", FSCT::Instance());        
             AddBlock("FSCL", FSCL::Instance());        
             AddBlock("FSAC", FSAC::Instance());        
             AddBlock("FSTB", FSTB::Instance());        
             AddBlock("FTHC", FTHC::Instance());        
             AddBlock("FTIH", FTIH::Instance());        
             AddBlock("FTOH", FTOH::Instance());        
             AddBlock("FSBH", FSBH::Instance());        
             AddBlock("FTUS", FTUS::Instance());        
             obase2=sringthickness+obasethickness;        
             ibase1=obase2+iotubelength+ibasethicknessab;        
             ibase2=ibase1+ibasethickness;        
             ibaseab=ibase1-ibasethicknessab;        
             zcool=obase2+0.418;        
             dcool=obasethickness-0.15;        
             // - Info -         
             Info( GetName(), Form("FSTMsimplifiedcodeversion=%6.1f",codeversion)  );        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fstg
++fstg._index;
fstg.version = 1.3;
// fstg_docum.version = "None";
FSTG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill mothervol
++mothervol._index;
mothervol.version = 1.0;
// mothervol_docum.version = "None";
mothervol.x = 0.0;
// mothervol_docum.x = "None";
mothervol.y = 0.0;
// mothervol_docum.y = "None";
mothervol.z = 134.0;
// mothervol_docum.z = "None";
mothervol.rmin = 4.1;
// mothervol_docum.rmin = "None";
mothervol.rmax = 34.00;
// mothervol_docum.rmax = "None";
mothervol.dz = 30.0;
// mothervol_docum.dz = "None";
{
mothervol_info::zdisk::Type temp = {
mothervol_info::zdisk::BaseType(151.750),
mothervol_info::zdisk::BaseType(165.248),
mothervol_info::zdisk::BaseType(178.781)
}
;
memcpy(&mothervol.zdisk, &temp, sizeof(temp));;
}
// mothervol_docum.zdisk = "None";
MOTHERVOL.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill wholewedge
++wholewedge._index;
wholewedge.version = 1.0;
// wholewedge_docum.version = "None";
wholewedge.rmin = 5;
// wholewedge_docum.rmin = "None";
wholewedge.rmax = 34;
// wholewedge_docum.rmax = "None";
wholewedge.phi1 = -17;
// wholewedge_docum.phi1 = "None";
wholewedge.phi2 = 17;
// wholewedge_docum.phi2 = "None";
wholewedge.dz = 4.0/2;
// wholewedge_docum.dz = "None";
{
wholewedge_info::modulus2::Type temp = {
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1),
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1),
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1),
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1),
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1),
wholewedge_info::modulus2::BaseType(0),
wholewedge_info::modulus2::BaseType(1)
}
;
memcpy(&wholewedge.modulus2, &temp, sizeof(temp));;
}
// wholewedge_docum.modulus2 = "None";
WHOLEWEDGE.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill ring
++ring._index;
ring.version = 1.0;
// ring_docum.version = "None";
ring.rmin = 30.0;
// ring_docum.rmin = "None";
ring.rmid = 32.23;
// ring_docum.rmid = "None";
ring.rmax = 33.5;
// ring_docum.rmax = "None";
ring.phi1 = 15.0;
// ring_docum.phi1 = "None";
ring.phi2 = 7.08451;
// ring_docum.phi2 = "None";
ring.dz = sringthickness/2;
// ring_docum.dz = "None";
RING.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill iring
++iring._index;
iring.version = 1.0;
// iring_docum.version = "None";
iring.rmin = 4.8;
// iring_docum.rmin = "None";
iring.rmax = 4.9;
// iring_docum.rmax = "None";
iring.dz = 3.2/2.0;
// iring_docum.dz = "None";
IRING.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill outerbase
++outerbase._index;
outerbase.version = 1.0;
// outerbase_docum.version = "None";
outerbase.x = (obasez2+obasez1)/2;
// outerbase_docum.x = "None";
outerbase.y = 0;
// outerbase_docum.y = "None";
outerbase.z = sringthickness+obasethickness/2;
// outerbase_docum.z = "None";
outerbase.dx1 = obasez1*tan(17*pi/180);
// outerbase_docum.dx1 = "None";
outerbase.dx2 = obasez2*tan(17*pi/180);
// outerbase_docum.dx2 = "None";
outerbase.dy = obasethickness/2;
// outerbase_docum.dy = "None";
outerbase.dz = (obasez2-obasez1)/2;
// outerbase_docum.dz = "None";
OUTERBASE.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill outertube
++outertube._index;
outertube.version = 1.0;
// outertube_docum.version = "None";
{
outertube_info::x::Type temp = {
outertube_info::x::BaseType(17.705),
outertube_info::x::BaseType(16.588),
outertube_info::x::BaseType(17.705),
outertube_info::x::BaseType(16.588),
outertube_info::x::BaseType(15.544),
outertube_info::x::BaseType(15.694),
outertube_info::x::BaseType(15.544)
}
;
memcpy(&outertube.x, &temp, sizeof(temp));;
}
// outertube_docum.x = "None";
{
outertube_info::y::Type temp = {
outertube_info::y::BaseType(3.5),
outertube_info::y::BaseType(4.231),
outertube_info::y::BaseType(-3.5),
outertube_info::y::BaseType(-4.231),
outertube_info::y::BaseType(1.826),
outertube_info::y::BaseType(0),
outertube_info::y::BaseType(-1.826)
}
;
memcpy(&outertube.y, &temp, sizeof(temp));;
}
// outertube_docum.y = "None";
outertube.z = sringthickness+obasethickness+iotubelength/2;
// outertube_docum.z = "None";
outertube.rmin = 0.125;
// outertube_docum.rmin = "None";
{
outertube_info::rmax::Type temp = {
outertube_info::rmax::BaseType(0.3),
outertube_info::rmax::BaseType(0.3),
outertube_info::rmax::BaseType(0.3),
outertube_info::rmax::BaseType(0.3),
outertube_info::rmax::BaseType(0.5),
outertube_info::rmax::BaseType(0.5),
outertube_info::rmax::BaseType(0.5)
}
;
memcpy(&outertube.rmax, &temp, sizeof(temp));;
}
// outertube_docum.rmax = "None";
