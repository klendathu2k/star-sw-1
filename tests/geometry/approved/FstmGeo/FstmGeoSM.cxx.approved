          AgBlock *FTRO::mInstance = 0;     
          AgBlock *FTRO::Instance(){        
                   if ( mInstance==0 ) mInstance = new FTRO();        
                   return mInstance;        
          }     
          void FTRO::Block( AgCreate create )     
          {         
                ///@addtogroup FTRO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FTRO");              
                            attr.par("seen")=1;              
                            attr.par("colo")=14;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material PEEK_FTRO            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Peek_ftro");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Trd1");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("dx1")=outerbase.dx1;              
                            shape.par("dx2")=outerbase.dx2;              
                            shape.par("dy")=outerbase.dy;              
                            shape.par("dz")=outerbase.dz;              
                            /// Shape Trd1 dx1=outerbase.dx1 dx2=outerbase.dx2 dy=outerbase.dy dz=outerbase.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTRO;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FHOA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHOA              
                            Create("FHOA");               
                      }           
                      _create = AgCreate("FHOB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHOB              
                            Create("FHOB");               
                      }           
                      _create = AgCreate("FHOC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHOC              
                            Create("FHOC");               
                      }           
                      _create = AgCreate("FHOD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHOD              
                            Create("FHOD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHOA");              
                            place.SetMother("FTRO");              
                            /// Add daughter volume FHOA to mother FTRO              
                            place.TranslateX(heatsink.x[int(1)-1]);              
                            /// Translate x = heatsink.x[int(1)-1]              
                            place.TranslateY(heatsink.y[int(1)-1]);              
                            /// Translate y = heatsink.y[int(1)-1]              
                            place.TranslateZ(heatsink.z[int(1)-1]);              
                            /// Translate z = heatsink.z[int(1)-1]              
                            place.par("dx")=heatsink.dx[int(1)-1];              
                            place.par("dy")=heatsink.dy[int(1)-1];              
                            place.par("dz")=heatsink.dz[int(1)-1];              
                            place.AlphaY(heatsink.rotz[int(1)-1]);              
                            /// Rotate: AlphaY = heatsink.rotz[int(1)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHOA"), place );              
                      } // end placement of FHOA           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHOB");              
                            place.SetMother("FTRO");              
                            /// Add daughter volume FHOB to mother FTRO              
                            place.TranslateX(heatsink.x[int(2)-1]);              
                            /// Translate x = heatsink.x[int(2)-1]              
                            place.TranslateY(heatsink.y[int(2)-1]);              
                            /// Translate y = heatsink.y[int(2)-1]              
                            place.TranslateZ(heatsink.z[int(2)-1]);              
                            /// Translate z = heatsink.z[int(2)-1]              
                            place.par("dx")=heatsink.dx[int(2)-1];              
                            place.par("dy")=heatsink.dy[int(2)-1];              
                            place.par("dz")=heatsink.dz[int(2)-1];              
                            place.AlphaY(heatsink.rotz[int(2)-1]);              
                            /// Rotate: AlphaY = heatsink.rotz[int(2)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHOB"), place );              
                      } // end placement of FHOB           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHOC");              
                            place.SetMother("FTRO");              
                            /// Add daughter volume FHOC to mother FTRO              
                            place.TranslateX(heatsink.x[int(3)-1]);              
                            /// Translate x = heatsink.x[int(3)-1]              
                            place.TranslateY(heatsink.y[int(3)-1]);              
                            /// Translate y = heatsink.y[int(3)-1]              
                            place.TranslateZ(heatsink.z[int(3)-1]);              
                            /// Translate z = heatsink.z[int(3)-1]              
                            place.par("dx")=heatsink.dx[int(3)-1];              
                            place.par("dy")=heatsink.dy[int(3)-1];              
                            place.par("dz")=heatsink.dz[int(3)-1];              
                            place.AlphaY(heatsink.rotz[int(3)-1]);              
                            /// Rotate: AlphaY = heatsink.rotz[int(3)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHOC"), place );              
                      } // end placement of FHOC           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHOD");              
                            place.SetMother("FTRO");              
                            /// Add daughter volume FHOD to mother FTRO              
                            place.TranslateX(heatsink.x[int(4)-1]);              
                            /// Translate x = heatsink.x[int(4)-1]              
                            place.TranslateY(heatsink.y[int(4)-1]);              
                            /// Translate y = heatsink.y[int(4)-1]              
                            place.TranslateZ(heatsink.z[int(4)-1]);              
                            /// Translate z = heatsink.z[int(4)-1]              
                            place.par("dx")=heatsink.dx[int(4)-1];              
                            place.par("dy")=heatsink.dy[int(4)-1];              
                            place.par("dz")=heatsink.dz[int(4)-1];              
                            place.AlphaY(heatsink.rotz[int(4)-1]);              
                            /// Rotate: AlphaY = heatsink.rotz[int(4)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHOD"), place );              
                      } // end placement of FHOD           
                      END_OF_FTRO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTRO     
