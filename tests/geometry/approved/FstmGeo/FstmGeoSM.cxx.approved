          AgBlock *FSWT::mInstance = 0;     
          AgBlock *FSWT::Instance(){        
                   if ( mInstance==0 ) mInstance = new FSWT();        
                   return mInstance;        
          }     
          void FSWT::Block( AgCreate create )     
          {         
                ///@addtogroup FSWT_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FSWT");              
                            attr.par("seen")=1;              
                            attr.par("colo")=14;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material PEEK            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Peek");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=0;              
                            shape.par("dz")=0;              
                            /// Shape Tube rmin=0 rmax=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSWT;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FSWT:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSWT     
