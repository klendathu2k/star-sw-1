          AgBlock *FTUW::mInstance = 0;     
          AgBlock *FTUW::Instance(){        
                   if ( mInstance==0 ) mInstance = new FTUW();        
                   return mInstance;        
          }     
          void FTUW::Block( AgCreate create )     
          {         
                ///@addtogroup FTUW_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FTUW");              
                            attr.par("seen")=1;              
                            attr.par("colo")=14;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material PEEK_FTUW            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Peek_ftuw");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=innerbaseb.rmin;              
                            shape.par("rmax")=innerbaseb.rmax;              
                            shape.par("phi1")=innerbaseb.phi1;              
                            shape.par("phi2")=innerbaseb.phi2;              
                            shape.par("dz")=innerbaseb.dz;              
                            /// Shape Tubs rmin=innerbaseb.rmin rmax=innerbaseb.rmax phi1=innerbaseb.phi1 phi2=innerbaseb.phi2 dz=innerbaseb.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTUW;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FHBE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHBE              
                            Create("FHBE");               
                      }           
                      _create = AgCreate("FHBF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHBF              
                            Create("FHBF");               
                      }           
                      _create = AgCreate("FHBG");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHBG              
                            Create("FHBG");               
                      }           
                      _create = AgCreate("FHBH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FHBH              
                            Create("FHBH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHBE");              
                            place.SetMother("FTUW");              
                            /// Add daughter volume FHBE to mother FTUW              
                            place.TranslateX(heatsink.x[int(5)-1]);              
                            /// Translate x = heatsink.x[int(5)-1]              
                            place.TranslateY(heatsink.y[int(5)-1]);              
                            /// Translate y = heatsink.y[int(5)-1]              
                            place.TranslateZ(heatsink.z[int(5)-1]);              
                            /// Translate z = heatsink.z[int(5)-1]              
                            place.par("dx")=heatsink.dx[int(5)-1];              
                            place.par("dy")=heatsink.dy[int(5)-1];              
                            place.par("dz")=heatsink.dz[int(5)-1];              
                            place.AlphaZ(heatsink.rotz[int(5)-1]);              
                            /// Rotate: AlphaZ = heatsink.rotz[int(5)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHBE"), place );              
                      } // end placement of FHBE           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHBF");              
                            place.SetMother("FTUW");              
                            /// Add daughter volume FHBF to mother FTUW              
                            place.TranslateX(heatsink.x[int(6)-1]);              
                            /// Translate x = heatsink.x[int(6)-1]              
                            place.TranslateY(heatsink.y[int(6)-1]);              
                            /// Translate y = heatsink.y[int(6)-1]              
                            place.TranslateZ(heatsink.z[int(6)-1]);              
                            /// Translate z = heatsink.z[int(6)-1]              
                            place.par("dx")=heatsink.dx[int(6)-1];              
                            place.par("dy")=heatsink.dy[int(6)-1];              
                            place.par("dz")=heatsink.dz[int(6)-1];              
                            place.AlphaZ(heatsink.rotz[int(6)-1]);              
                            /// Rotate: AlphaZ = heatsink.rotz[int(6)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHBF"), place );              
                      } // end placement of FHBF           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHBG");              
                            place.SetMother("FTUW");              
                            /// Add daughter volume FHBG to mother FTUW              
                            place.TranslateX(heatsink.x[int(7)-1]);              
                            /// Translate x = heatsink.x[int(7)-1]              
                            place.TranslateY(heatsink.y[int(7)-1]);              
                            /// Translate y = heatsink.y[int(7)-1]              
                            place.TranslateZ(heatsink.z[int(7)-1]);              
                            /// Translate z = heatsink.z[int(7)-1]              
                            place.par("dx")=heatsink.dx[int(7)-1];              
                            place.par("dy")=heatsink.dy[int(7)-1];              
                            place.par("dz")=heatsink.dz[int(7)-1];              
                            place.AlphaZ(heatsink.rotz[int(7)-1]);              
                            /// Rotate: AlphaZ = heatsink.rotz[int(7)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHBG"), place );              
                      } // end placement of FHBG           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FHBH");              
                            place.SetMother("FTUW");              
                            /// Add daughter volume FHBH to mother FTUW              
                            place.TranslateX(heatsink.x[int(8)-1]);              
                            /// Translate x = heatsink.x[int(8)-1]              
                            place.TranslateY(heatsink.y[int(8)-1]);              
                            /// Translate y = heatsink.y[int(8)-1]              
                            place.TranslateZ(heatsink.z[int(8)-1]);              
                            /// Translate z = heatsink.z[int(8)-1]              
                            place.par("dx")=heatsink.dx[int(8)-1];              
                            place.par("dy")=heatsink.dy[int(8)-1];              
                            place.par("dz")=heatsink.dz[int(8)-1];              
                            place.AlphaZ(heatsink.rotz[int(8)-1]);              
                            /// Rotate: AlphaZ = heatsink.rotz[int(8)-1]              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FHBH"), place );              
                      } // end placement of FHBH           
                      END_OF_FTUW:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTUW     
