isEqual<innersilicon_t, float> __innersilicon_dz__( __innersilicon, &__innersilicon->dz );
isEqual<innersilicon_t, int> __innersilicon__index__( __innersilicon, &__innersilicon->_index );
     
          
	void              *innersilicon_info::address   = &innersilicon;
	AgMLStructureBase   *innersilicon_info::structure = &INNERSILICON;
     
       FstmGeoSM::FstmGeoSM()     
         : AgModule("FstmGeoSM","Forward Silicon Tracker (Simplified Misaligned geometry)")     
       {        
       }     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FSTM::mInstance = 0;     
          AgBlock *FSTM::Instance(){        
                   if ( mInstance==0 ) mInstance = new FSTM();        
                   return mInstance;        
          }     
          void FSTM::Block( AgCreate create )     
          {         
                ///@addtogroup FSTM_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Material air isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Air");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      /// Medium standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("FSTM");              
                            attr.par("seen")=0;              
                            attr.par("colo")=1;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tube");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=4.8;              
                            shape.par("rmax")=mothervol.rmax;              
                            shape.par("dz")=mothervol.dz;              
                            /// Shape Tube rmin=4.8 rmax=mothervol.rmax dz=mothervol.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSTM;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FSTW");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSTW              
                            Create("FSTW");               
                      }           
                      _create = AgCreate("FTUS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTUS              
                            Create("FTUS");               
                      }           
                      _create = AgCreate("FTUO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTUO              
                            Create("FTUO");               
                      }           
                      /// Loop on idisk from 0 to 2 step=1           
                      for ( idisk=0; (1>0)? (idisk<=2):(idisk>=2); idisk+=1 )           
                      {              
                            /// Loop on iwedgem from 0 to 11 step=1              
                            for ( iwedgem=0; (1>0)? (iwedgem<=11):(iwedgem>=11); iwedgem+=1 )              
                            {                 
                                  wedge_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter+wholewedge.dz;                 
                                  inner_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter+innersilicon.z;                 
                                  outer_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter+outersilicon.z;                 
                                  wedge_xrot=0.0;                 
                                  ringmotherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-ring.dz;                 
                                  if ( idisk!=1 )                 
                                  {                    
                                        if ( wholewedge.modulus2[int(iwedgem+1)-1]==0 )                    
                                        {                       
                                              wedge_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-wholewedge.dz;                       
                                              inner_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-innersilicon.z;                       
                                              outer_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-outersilicon.z;                       
                                              wedge_xrot=180.0;                       
                                              ringmotherz=mothervol.zdisk[int(idisk+1)-1]-zcenter+ring.dz;                       
                                        }                    
                                  }                 
                                  if ( idisk==1 )                 
                                  {                    
                                        if ( wholewedge.modulus2[int(iwedgem+1)-1]==1 )                    
                                        {                       
                                              wedge_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-wholewedge.dz;                       
                                              inner_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-innersilicon.z;                       
                                              outer_silicon_motherz=mothervol.zdisk[int(idisk+1)-1]-zcenter-outersilicon.z;                       
                                              wedge_xrot=180.0;                       
                                              ringmotherz=mothervol.zdisk[int(idisk+1)-1]-zcenter+ring.dz;                       
                                        }                    
                                  }                 
                                  wedge_zrot=75.0-30.0*iwedgem;                 
                                  halfid=0;                 
                                  if ( iwedgem>=5 )                 
                                  {                    
                                        halfid=1;                    
                                  }                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FSTW");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FSTW to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(wedge_motherz);                    
                                        /// Translate z = wedge_motherz                    
                                        place.par("only")=AgPosition::kMany;                    
                                        /// Overlap: agposition::kmany                    
                                        place.par("ncopy")=1+iwedgem+12*idisk;                    
                                        /// Ncopy: 1+iwedgem+12*idisk                    
                                        place.AlphaX(wedge_xrot);                    
                                        /// Rotate: AlphaX = wedge_xrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Misalign("Geometry/fst/fstWedgeOnHss",iwedgem+12*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/hssOnFst",halfid,"+xyzr");                    
                                        _stacker -> Position( AgBlock::Find("FSTW"), place );                    
                                  } // end placement of FSTW                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUS");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUS to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(inner_silicon_motherz);                    
                                        /// Translate z = inner_silicon_motherz                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        place.par("ncopy")=1+3*iwedgem+36*idisk;                    
                                        /// Ncopy: 1+3*iwedgem+36*idisk                    
                                        place.par("dz")=innersilicon.dz;                    
                                        place.par("rmin")=innersilicon.rmin;                    
                                        place.par("rmax")=innersilicon.rmax;                    
                                        place.par("phi1")=innersilicon.phi1;                    
                                        place.par("phi2")=innersilicon.phi2;                    
                                        place.AlphaX(wedge_xrot);                    
                                        /// Rotate: AlphaX = wedge_xrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Misalign("Geometry/fst/fstSensorOnWedge",3*iwedgem+36*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/fstWedgeOnHss",iwedgem+12*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/hssOnFst",halfid,"+xyzr");                    
                                        _stacker -> Position( AgBlock::Find("FTUS"), place );                    
                                  } // end placement of FTUS                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUS");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUS to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(outer_silicon_motherz);                    
                                        /// Translate z = outer_silicon_motherz                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        place.par("ncopy")=2+3*iwedgem+36*idisk;                    
                                        /// Ncopy: 2+3*iwedgem+36*idisk                    
                                        place.par("dz")=outersilicon.dz;                    
                                        place.par("rmin")=outersilicon.rmin;                    
                                        place.par("rmax")=outersilicon.rmax;                    
                                        place.par("phi1")=outersilicon.phi1[int(1)-1];                    
                                        place.par("phi2")=outersilicon.phi2[int(1)-1];                    
                                        place.AlphaX(wedge_xrot);                    
                                        /// Rotate: AlphaX = wedge_xrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Misalign("Geometry/fst/fstSensorOnWedge",1+3*iwedgem+36*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/fstWedgeOnHss",iwedgem+12*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/hssOnFst",halfid,"+xyzr");                    
                                        _stacker -> Position( AgBlock::Find("FTUS"), place );                    
                                  } // end placement of FTUS                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUS");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUS to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(outer_silicon_motherz);                    
                                        /// Translate z = outer_silicon_motherz                    
                                        place.par("only")=AgPosition::kOnly;                    
                                        /// Overlap: agposition::konly                    
                                        place.par("ncopy")=3+3*iwedgem+36*idisk;                    
                                        /// Ncopy: 3+3*iwedgem+36*idisk                    
                                        place.par("dz")=outersilicon.dz;                    
                                        place.par("rmin")=outersilicon.rmin;                    
                                        place.par("rmax")=outersilicon.rmax;                    
                                        place.par("phi1")=outersilicon.phi1[int(2)-1];                    
                                        place.par("phi2")=outersilicon.phi2[int(2)-1];                    
                                        place.AlphaX(wedge_xrot);                    
                                        /// Rotate: AlphaX = wedge_xrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        place.Misalign("Geometry/fst/fstSensorOnWedge",2+3*iwedgem+36*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/fstWedgeOnHss",iwedgem+12*idisk,"+xyzr");                    
                                        place.Misalign("Geometry/fst/hssOnFst",halfid,"+xyzr");                    
                                        _stacker -> Position( AgBlock::Find("FTUS"), place );                    
                                  } // end placement of FTUS                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUO");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUO to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(ringmotherz);                    
                                        /// Translate z = ringmotherz                    
                                        place.par("dz")=ring.dz;                    
                                        place.par("rmin")=ring.rmid;                    
                                        place.par("rmax")=ring.rmax;                    
                                        place.par("phi1")=-ring.phi1;                    
                                        place.par("phi2")=ring.phi1;                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FTUO"), place );                    
                                  } // end placement of FTUO                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUO");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUO to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(ringmotherz);                    
                                        /// Translate z = ringmotherz                    
                                        place.par("dz")=ring.dz;                    
                                        place.par("rmin")=ring.rmin;                    
                                        place.par("rmax")=ring.rmid;                    
                                        place.par("phi1")=-ring.phi1;                    
                                        place.par("phi2")=-ring.phi2;                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FTUO"), place );                    
                                  } // end placement of FTUO                 
                                  {                    
                                        AgPosition  place;                    
                                        place.SetBlock("FTUO");                    
                                        place.SetMother("FSTM");                    
                                        /// Add daughter volume FTUO to mother FSTM                    
                                        place.TranslateX(0);                    
                                        /// Translate x = 0                    
                                        place.TranslateY(0);                    
                                        /// Translate y = 0                    
                                        place.TranslateZ(ringmotherz);                    
                                        /// Translate z = ringmotherz                    
                                        place.par("dz")=ring.dz;                    
                                        place.par("rmin")=ring.rmin;                    
                                        place.par("rmax")=ring.rmid;                    
                                        place.par("phi1")=ring.phi2;                    
                                        place.par("phi2")=ring.phi1;                    
                                        place.AlphaZ(wedge_zrot);                    
                                        /// Rotate: AlphaZ = wedge_zrot                    
                                        /// G3 Reference: thetax = 90                    
                                        /// G3 Reference: phix = 0                    
                                        /// G3 Reference: thetay = 90                    
                                        /// G3 Reference: phiy = 90                    
                                        /// G3 Reference: thetaz = 0                    
                                        /// G3 Reference: phiz = 0                    
                                        _stacker -> Position( AgBlock::Find("FTUO"), place );                    
                                  } // end placement of FTUO                 
                            }              
                      }           
                      END_OF_FSTM:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSTM     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FSTW::mInstance = 0;     
          AgBlock *FSTW::Instance(){        
                   if ( mInstance==0 ) mInstance = new FSTW();        
                   return mInstance;        
          }     
          void FSTW::Block( AgCreate create )     
          {         
                ///@addtogroup FSTW_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FSTW");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material air            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Air");              
                            _material = mat;              
                      }           
                      /// Material air isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Air");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=wholewedge.rmin;              
                            shape.par("rmax")=wholewedge.rmax;              
                            shape.par("phi1")=wholewedge.phi1;              
                            shape.par("phi2")=wholewedge.phi2;              
                            shape.par("dz")=wholewedge.dz;              
                            /// Shape Tubs rmin=wholewedge.rmin rmax=wholewedge.rmax phi1=wholewedge.phi1 phi2=wholewedge.phi2 dz=wholewedge.dz               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FSTW;              
                            _stacker -> Build(this);              
                      }           
                      _create = AgCreate("FTUR");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTUR              
                            Create("FTUR");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTUR");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTUR to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+ring.dz);              
                            /// Translate z = -wholewedge.dz+ring.dz              
                            place.par("dz")=ring.dz;              
                            place.par("rmin")=ring.rmid;              
                            place.par("rmax")=ring.rmax;              
                            place.par("phi1")=-ring.phi1;              
                            place.par("phi2")=ring.phi1;              
                            _stacker -> Position( AgBlock::Find("FTUR"), place );              
                      } // end placement of FTUR           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTUR");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTUR to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+ring.dz);              
                            /// Translate z = -wholewedge.dz+ring.dz              
                            place.par("dz")=ring.dz;              
                            place.par("rmin")=ring.rmin;              
                            place.par("rmax")=ring.rmid;              
                            place.par("phi1")=-ring.phi1;              
                            place.par("phi2")=-ring.phi2;              
                            _stacker -> Position( AgBlock::Find("FTUR"), place );              
                      } // end placement of FTUR           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTUR");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTUR to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+ring.dz);              
                            /// Translate z = -wholewedge.dz+ring.dz              
                            place.par("dz")=ring.dz;              
                            place.par("rmin")=ring.rmin;              
                            place.par("rmax")=ring.rmid;              
                            place.par("phi1")=ring.phi2;              
                            place.par("phi2")=ring.phi1;              
                            _stacker -> Position( AgBlock::Find("FTUR"), place );              
                      } // end placement of FTUR           
                      _create = AgCreate("FTRO");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTRO              
                            Create("FTRO");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTRO");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTRO to mother FSTW              
                            place.TranslateX(outerbase.x);              
                            /// Translate x = outerbase.x              
                            place.TranslateY(outerbase.y);              
                            /// Translate y = outerbase.y              
                            place.TranslateZ(-wholewedge.dz+outerbase.z);              
                            /// Translate z = -wholewedge.dz+outerbase.z              
                            place.AlphaY(90);              
                            /// Rotate: AlphaY = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            place.AlphaX(90);              
                            /// Rotate: AlphaX = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FTRO"), place );              
                      } // end placement of FTRO           
                      _create = AgCreate("FSWT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSWT              
                            Create("FSWT");               
                      }           
                      /// Loop on itube from 1 to 7 step=1           
                      for ( itube=1; (1>0)? (itube<=7):(itube>=7); itube+=1 )           
                      {              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FSWT");                 
                                  place.SetMother("FSTW");                 
                                  /// Add daughter volume FSWT to mother FSTW                 
                                  place.TranslateX(outertube.x[int(itube)-1]);                 
                                  /// Translate x = outertube.x[int(itube)-1]                 
                                  place.TranslateY(outertube.y[int(itube)-1]);                 
                                  /// Translate y = outertube.y[int(itube)-1]                 
                                  place.TranslateZ(-wholewedge.dz+outertube.z);                 
                                  /// Translate z = -wholewedge.dz+outertube.z                 
                                  place.par("dz")=outertube.dz;                 
                                  place.par("rmin")=outertube.rmin;                 
                                  place.par("rmax")=outertube.rmax[int(itube)-1];                 
                                  _stacker -> Position( AgBlock::Find("FSWT"), place );                 
                            } // end placement of FSWT              
                      }           
                      _create = AgCreate("FTUW");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTUW              
                            Create("FTUW");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTUW");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTUW to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+innerbaseb.z);              
                            /// Translate z = -wholewedge.dz+innerbaseb.z              
                            _stacker -> Position( AgBlock::Find("FTUW"), place );              
                      } // end placement of FTUW           
                      _create = AgCreate("FTIA");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTIA              
                            Create("FTIA");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTIA");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTIA to mother FSTW              
                            place.TranslateX(innerbasea.x[int(1)-1]);              
                            /// Translate x = innerbasea.x[int(1)-1]              
                            place.TranslateY(innerbasea.y);              
                            /// Translate y = innerbasea.y              
                            place.TranslateZ(-wholewedge.dz+innerbasea.z);              
                            /// Translate z = -wholewedge.dz+innerbasea.z              
                            place.AlphaY(90);              
                            /// Rotate: AlphaY = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            place.AlphaX(90);              
                            /// Rotate: AlphaX = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FTIA"), place );              
                      } // end placement of FTIA           
                      _create = AgCreate("FTIB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTIB              
                            Create("FTIB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTIB");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTIB to mother FSTW              
                            place.TranslateX(innerbasea.x[int(2)-1]);              
                            /// Translate x = innerbasea.x[int(2)-1]              
                            place.TranslateY(innerbasea.y);              
                            /// Translate y = innerbasea.y              
                            place.TranslateZ(-wholewedge.dz+innerbasea.z);              
                            /// Translate z = -wholewedge.dz+innerbasea.z              
                            place.AlphaY(90);              
                            /// Rotate: AlphaY = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            place.AlphaX(90);              
                            /// Rotate: AlphaX = 90              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FTIB"), place );              
                      } // end placement of FTIB           
                      _create = AgCreate("FSCT");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSCT              
                            Create("FSCT");               
                      }           
                      /// Loop on itube from 1 to 7 step=1           
                      for ( itube=1; (1>0)? (itube<=7):(itube>=7); itube+=1 )           
                      {              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FSCT");                 
                                  place.SetMother("FSTW");                 
                                  /// Add daughter volume FSCT to mother FSTW                 
                                  place.TranslateX(coolingtubes.x[int(itube)-1]);                 
                                  /// Translate x = coolingtubes.x[int(itube)-1]                 
                                  place.TranslateY(coolingtubes.y[int(itube)-1]);                 
                                  /// Translate y = coolingtubes.y[int(itube)-1]                 
                                  place.TranslateZ(-wholewedge.dz+coolingtubes.z[int(itube)-1]);                 
                                  /// Translate z = -wholewedge.dz+coolingtubes.z[int(itube)-1]                 
                                  place.par("dz")=coolingtubes.dz[int(itube)-1];                 
                                  place.par("rmin")=coolingtubes.rmin;                 
                                  place.par("rmax")=coolingtubes.rmax;                 
                                  place.AlphaY(90.0);                 
                                  /// Rotate: AlphaY = 90.0                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaZ(coolingtubes.rotz[int(itube)-1]);                 
                                  /// Rotate: AlphaZ = coolingtubes.rotz[int(itube)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  place.AlphaX(coolingtubes.rotx[int(itube)-1]);                 
                                  /// Rotate: AlphaX = coolingtubes.rotx[int(itube)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("FSCT"), place );                 
                            } // end placement of FSCT              
                      }           
                      _create = AgCreate("FSCL");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSCL              
                            Create("FSCL");               
                      }           
                      _create = AgCreate("FSAC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSAC              
                            Create("FSAC");               
                      }           
                      /// Loop on ichip from 1 to 8 step=1           
                      for ( ichip=1; (1>0)? (ichip<=8):(ichip>=8); ichip+=1 )           
                      {              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FSAC");                 
                                  place.SetMother("FSTW");                 
                                  /// Add daughter volume FSAC to mother FSTW                 
                                  place.TranslateX(apvchip.x[int(ichip)-1]);                 
                                  /// Translate x = apvchip.x[int(ichip)-1]                 
                                  place.TranslateY(apvchip.y[int(ichip)-1]);                 
                                  /// Translate y = apvchip.y[int(ichip)-1]                 
                                  place.TranslateZ(-wholewedge.dz+apvchip.z[int(ichip)-1]);                 
                                  /// Translate z = -wholewedge.dz+apvchip.z[int(ichip)-1]                 
                                  place.par("dx")=apvchip.dx[int(ichip)-1];                 
                                  place.par("dy")=apvchip.dy[int(ichip)-1];                 
                                  place.par("dz")=apvchip.dz;                 
                                  place.AlphaZ(apvchip.rotz[int(ichip)-1]);                 
                                  /// Rotate: AlphaZ = apvchip.rotz[int(ichip)-1]                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("FSAC"), place );                 
                            } // end placement of FSAC              
                      }           
                      _create = AgCreate("FSTB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSTB              
                            Create("FSTB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FSTB");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FSTB to mother FSTW              
                            place.TranslateX(tboard.x);              
                            /// Translate x = tboard.x              
                            place.TranslateY(tboard.y);              
                            /// Translate y = tboard.y              
                            place.TranslateZ(-wholewedge.dz+tboard.z);              
                            /// Translate z = -wholewedge.dz+tboard.z              
                            place.par("dx")=tboard.dx;              
                            place.par("dy")=tboard.dy;              
                            place.par("dz")=tboard.dz;              
                            _stacker -> Position( AgBlock::Find("FSTB"), place );              
                      } // end placement of FSTB           
                      _create = AgCreate("FTHC");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTHC              
                            Create("FTHC");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTHC");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTHC to mother FSTW              
                            place.TranslateX(connectors.x[int(1)-1]);              
                            /// Translate x = connectors.x[int(1)-1]              
                            place.TranslateY(connectors.y[int(1)-1]);              
                            /// Translate y = connectors.y[int(1)-1]              
                            place.TranslateZ(-wholewedge.dz+connectors.z[int(1)-1]);              
                            /// Translate z = -wholewedge.dz+connectors.z[int(1)-1]              
                            place.par("dx")=connectors.dx;              
                            place.par("dy")=connectors.dy;              
                            place.par("dz")=connectors.dz[int(1)-1];              
                            _stacker -> Position( AgBlock::Find("FTHC"), place );              
                      } // end placement of FTHC           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTHC");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTHC to mother FSTW              
                            place.TranslateX(connectors.x[int(2)-1]);              
                            /// Translate x = connectors.x[int(2)-1]              
                            place.TranslateY(connectors.y[int(2)-1]);              
                            /// Translate y = connectors.y[int(2)-1]              
                            place.TranslateZ(-wholewedge.dz+connectors.z[int(2)-1]);              
                            /// Translate z = -wholewedge.dz+connectors.z[int(2)-1]              
                            place.par("dx")=connectors.dx;              
                            place.par("dy")=connectors.dy;              
                            place.par("dz")=connectors.dz[int(2)-1];              
                            _stacker -> Position( AgBlock::Find("FTHC"), place );              
                      } // end placement of FTHC           
                      _create = AgCreate("FTOH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTOH              
                            Create("FTOH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTOH");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTOH to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+outerhybrida.z);              
                            /// Translate z = -wholewedge.dz+outerhybrida.z              
                            _stacker -> Position( AgBlock::Find("FTOH"), place );              
                      } // end placement of FTOH           
                      _create = AgCreate("FSBH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FSBH              
                            Create("FSBH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FSBH");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FSBH to mother FSTW              
                            place.TranslateX(outerhybridb.x);              
                            /// Translate x = outerhybridb.x              
                            place.TranslateY(outerhybridb.y);              
                            /// Translate y = outerhybridb.y              
                            place.TranslateZ(-wholewedge.dz+outerhybridb.z);              
                            /// Translate z = -wholewedge.dz+outerhybridb.z              
                            place.par("dx")=outerhybridb.dx;              
                            place.par("dy")=outerhybridb.dy;              
                            place.par("dz")=outerhybridb.dz;              
                            _stacker -> Position( AgBlock::Find("FSBH"), place );              
                      } // end placement of FSBH           
                      _create = AgCreate("FTIH");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FTIH              
                            Create("FTIH");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FTIH");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FTIH to mother FSTW              
                            place.TranslateX(0);              
                            /// Translate x = 0              
                            place.TranslateY(0);              
                            /// Translate y = 0              
                            place.TranslateZ(-wholewedge.dz+innerhybrida.z);              
                            /// Translate z = -wholewedge.dz+innerhybrida.z              
                            _stacker -> Position( AgBlock::Find("FTIH"), place );              
                      } // end placement of FTIH           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FSBH");              
                            place.SetMother("FSTW");              
                            /// Add daughter volume FSBH to mother FSTW              
                            place.TranslateX(innerhybridb.x);              
                            /// Translate x = innerhybridb.x              
                            place.TranslateY(innerhybridb.y);              
                            /// Translate y = innerhybridb.y              
                            place.TranslateZ(-wholewedge.dz+innerhybridb.z);              
                            /// Translate z = -wholewedge.dz+innerhybridb.z              
                            place.par("dx")=innerhybridb.dx;              
                            place.par("dy")=innerhybridb.dy;              
                            place.par("dz")=innerhybridb.dz;              
                            _stacker -> Position( AgBlock::Find("FSBH"), place );              
                      } // end placement of FSBH           
                      END_OF_FSTW:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FSTW     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *FTUO::mInstance = 0;     
          AgBlock *FTUO::Instance(){        
                   if ( mInstance==0 ) mInstance = new FTUO();        
                   return mInstance;        
          }     
          void FTUO::Block( AgCreate create )     
          {         
                ///@addtogroup FTUO_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FTUO");              
                            attr.par("seen")=1;              
                            attr.par("colo")=3;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material aluminium            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Aluminium");              
                            _material = mat;              
                      }           
                      /// Material aluminium isvol=0            
                      { AgMaterial &mat = AgMaterial::Get("Aluminium");              
                            mat.par("isvol")=0;              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=0;              
                            shape.par("rmax")=0;              
                            shape.par("phi1")=0;              
                            shape.par("phi2")=0;              
                            shape.par("dz")=0;              
                            /// Shape Tubs rmin=0 rmax=0 phi1=0 phi2=0 dz=0               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FTUO;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_FTUO:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FTUO     
          // ---------------------------------------------------------------------------------------------------     
