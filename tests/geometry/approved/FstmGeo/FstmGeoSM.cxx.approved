             zcenter=mothervol.z+mothervol.dz;        
             _create = AgCreate("FSTM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create FSTM           
                   Create("FSTM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("FSTM");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume FSTM to mother CAVE           
                   place.TranslateX(0.0);           
                   /// Translate x = 0.0           
                   place.TranslateY(0.0);           
                   /// Translate y = 0.0           
                   place.TranslateZ(zcenter);           
                   /// Translate z = zcenter           
                   place.Misalign("Geometry/fst/fstOnTpc",0,"+xyzr");           
                   _stacker -> Position( AgBlock::Find("FSTM"), place );           
             } // end placement of FSTM        
       }; // FstmGeoSM     
