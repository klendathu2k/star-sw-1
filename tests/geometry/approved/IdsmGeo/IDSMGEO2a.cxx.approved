    // ----------------------------------------------------------------------- geoctr
       void IDSMGEO2a::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup IDSMGEO2a_revision        
             ///@{           
                   /// Created:   10/04/2011            
             ///@}        
             ///@addtogroup IDSMGEO2a_revision        
             ///@{           
                   /// Author: Jan Balewski MIT, Willie Leight MIT (material mixes),Flemming Videbaek           
             ///@}        
             AddBlock("IDSM", IDSM::Instance());        
             AddBlock("TPRR", TPRR::Instance());        
             AddBlock("TPRT", TPRT::Instance());        
             AddBlock("OSCA", OSCA::Instance());        
             AddBlock("SUCB", SUCB::Instance());        
             AddBlock("SUCC", SUCC::Instance());        
             AddBlock("SUCD", SUCD::Instance());        
             AddBlock("SUCE", SUCE::Instance());        
             AddBlock("SUCF", SUCF::Instance());        
             AddBlock("SUCG", SUCG::Instance());        
             AddBlock("FGRL", FGRL::Instance());        
             AddBlock("FGHV", FGHV::Instance());        
             AddBlock("EFSA", EFSA::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill idsc
++idsc._index;
idsc.version = 2.0;
// idsc_docum.version = "Versioning of the IDSM geometry Default y2013 version.";
IDSC.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill idsg
++idsg._index;
idsg.version = 1.0;
// idsg_docum.version = "2012 Version of the IDS geometry ";
idsg.rf = 2.25;
// idsg_docum.rf = " radii of inner volume boundary";
idsg.angflat = 106.;
// idsg_docum.angflat = " angle (deg) for center of flat";
idsg.rrres = 43.;
// idsg_docum.rrres = " radial distance of  for TPC resistor tubes";
idsg.r1res = 1.17;
// idsg_docum.r1res = " inner radii for TPC resistor tubes";
idsg.r2res = 1.27;
// idsg_docum.r2res = " outer radii for TPC resistor tubes";
idsg.dangres = 11.3;
// idsg_docum.dangres = " opening angle (deg) for TPC resistor tubes";
idsg.dxres = 0.13;
// idsg_docum.dxres = " thicknessfor TPC resistor";
idsg.dyres = 2.;
// idsg_docum.dyres = " dy for TPC resistor";
idsg.fgtstartz = 70.;
// idsg_docum.fgtstartz = " position of sensitive volume of the 1st disk";
idsg.fgtdiskstepz = 10.;
// idsg_docum.fgtdiskstepz = " disk separation along Z";
idsg.fgtndisk = 6;
// idsg_docum.fgtndisk = "number of disks";
idsg.ewcsinnerrad = 39.91;
// idsg_docum.ewcsinnerrad = "Inner radius of ESC OSC ";
idsg.ewcsouterrad = 40.005;
// idsg_docum.ewcsouterrad = "Inner radius of ESC OSC ";
IDSG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill idsg
++idsg._index;
idsg.version = 2.0;
// idsg_docum.version = "2013 versioning of the IDS geometry ";
idsg.rf = 0.0;
// idsg_docum.rf = " radii of inner volume boundary";
idsg.angflat = 106.;
// idsg_docum.angflat = " angle (deg) for center of flat";
idsg.rrres = 43.;
// idsg_docum.rrres = " radial distance of  for TPC resistor tubes";
idsg.r1res = 1.17;
// idsg_docum.r1res = " inner radii for TPC resistor tubes";
idsg.r2res = 1.27;
// idsg_docum.r2res = " outer radii for TPC resistor tubes";
idsg.dangres = 11.3;
// idsg_docum.dangres = " opening angle (deg) for TPC resistor tubes";
idsg.dxres = 0.13;
// idsg_docum.dxres = " thicknessfor TPC resistor";
idsg.dyres = 2.;
// idsg_docum.dyres = " dy for TPC resistor";
idsg.fgtstartz = 70.;
// idsg_docum.fgtstartz = " position of sensitive volume of the 1st disk";
idsg.fgtdiskstepz = 10.;
// idsg_docum.fgtdiskstepz = " disk separation along Z";
idsg.fgtndisk = 6;
// idsg_docum.fgtndisk = "number of disks";
idsg.ewcsinnerrad = 39.91;
// idsg_docum.ewcsinnerrad = "Inner radius of ESC OSC ";
idsg.ewcsouterrad = 40.005;
// idsg_docum.ewcsouterrad = "Inner radius of ESC OSC ";
IDSG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill idsg
++idsg._index;
idsg.version = 14;
// idsg_docum.version = "Year 14, strip out the FGT cables";
IDSG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill idsa
++idsa._index;
idsa.version = 1.0;
// idsa_docum.version = "Default alignment of IDSM at (0,0,0) with no rotation";
idsa.x = 0.0;
// idsa_docum.x = "x-alignment";
idsa.y = 0.0;
// idsa_docum.y = "y-alignment";
idsa.z = 0.0;
// idsa_docum.z = "z-alignment";
idsa.thetax = 90.0;
// idsa_docum.thetax = "align x`-axis 90 degrees in theta wrt cave";
idsa.phix = 0.0;
// idsa_docum.phix = "align x`-axis  0 degrees in phi   wrt cave";
idsa.thetay = 90.0;
// idsa_docum.thetay = "align y`-axis 90 degrees in theta wrt cave";
idsa.phiy = 90.0;
// idsa_docum.phiy = "align y`-axis  0 degrees in phi   wrt cave";
idsa.thetaz = 0.0;
// idsa_docum.thetaz = "align z`-axis  0 degrees in theta wrt cave";
idsa.phiz = 0.0;
// idsa_docum.phiz = "align z`-axis  0 degrees in phi   wrt cave";
IDSA.fill();
        
             /// Component O	a=16	z=8	w=0.062        
             /// Component C	a=12	z=6	w=0.892        
             /// Component H	a=1	z=1	w=0.019        
             /// Component Cl	a=35.5	z=17	w=0.027        
             /// Mixture CFRPMix dens=1.78        
             {  AgMaterial &mix = AgMaterial::Get("Cfrpmix");           
                   mix.Component("O",16,8,0.062);           
                   mix.Component("C",12,6,0.892);           
                   mix.Component("H",1,1,0.019);           
                   mix.Component("Cl",35.5,17,0.027);           
                   mix.par("dens")=1.78;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component AL	a=27	z=13	w=1.        
             /// Mixture AlPure dens=2.80        
             {  AgMaterial &mix = AgMaterial::Get("Alpure");           
                   mix.Component("AL",27,13,1.);           
                   mix.par("dens")=2.80;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.043        
             /// Component C	a=12	z=6	w=0.635        
             /// Component H	a=1	z=1	w=0.014        
             /// Component Cl	a=35.5	z=17	w=0.019        
             /// Component AL	a=27	z=13	w=0.017        
             /// Component Ti	a=47.9	z=22	w=0.260        
