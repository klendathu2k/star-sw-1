             /// USE idsc _index=1;        
             IDSC.use( __idsc__index__ = 1 );
        
             /// USE idsg version=idsc.version;        
             IDSG.use( __idsg_version__ = idsc.version );
        
             /// USE idsa version=1.0;        
             IDSA.use( __idsa_version__ = 1.0 );
        
             // - Info -         
             Info( GetName(), Form("InnerDetectorSupportModulewithIDSC.version=%5.2f",idsc.version)  );        
             inr=idsg.rf;        
             outr=idsg.rrres+idsg.r2res;        
             lengthz=470.;        
             eastz=-189*inch;        
             westz=403.8;        
             eastb=-360.0;        
             westb=360.0;        
             sina=sin(idsg.angflat*degrad);        
             cosa=cos(idsg.angflat*degrad);        
             rrail=41.5;        
             dphihv=0.03;        
             dzc=7.4/2.0;        
             _create = AgCreate("IDSM");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create IDSM           
                   Create("IDSM");            
             }        
             {           
                   AgPosition  place;           
                   place.SetBlock("IDSM");           
                   place.SetMother("CAVE");           
                   place.SetGroup("TpcRefSys");           
                   /// Add daughter volume IDSM to mother CAVE           
                   place.par("only")=AgPosition::kMany;           
                   /// Overlap: agposition::kmany           
                   place.Misalign("Geometry/pxl/idsOnTpc",0,"left");           
                   place.Misalign("Geometry/tpc/TpcPosition",0,"left");           
                   _stacker -> Position( AgBlock::Find("IDSM"), place );           
             } // end placement of IDSM        
       }; // IDSMGEO2a     
 }; // namespace IDSMGEO2a  
 