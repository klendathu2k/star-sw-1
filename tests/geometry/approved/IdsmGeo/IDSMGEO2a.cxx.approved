          void SUCC::Block( AgCreate create )     
          {         
                ///@addtogroup SUCC_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("SUCC");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material CFRPMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Cfrpmix");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Pcon");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("phi1")=0.0;              
                            shape.par("dphi")=360;              
                            shape.par("nz")=6;              
                            shape.Z(0)=-dzc;              
                            shape.Z(1)=-dzc+0.6;              
                            shape.Z(2)=-dzc+0.6;              
                            shape.Z(3)=dzc-0.6;              
                            shape.Z(4)=dzc-0.6;              
                            shape.Z(5)=dzc;              
                            shape.Rmin(0)=37.61;              
                            shape.Rmin(1)=36.30;              
                            shape.Rmin(2)=36.30;              
                            shape.Rmin(3)=22.76;              
                            shape.Rmin(4)=21.6;              
                            shape.Rmin(5)=21.6;              
                            shape.Rmax(0)=39.9;              
                            shape.Rmax(1)=39.9;              
                            shape.Rmax(2)=37.6;              
                            shape.Rmax(3)=24.06;              
                            shape.Rmax(4)=24.06;              
                            shape.Rmax(5)=22.75;              
                            /// Shape Pcon phi1=0.0 dphi=360 nz=6               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_SUCC;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_SUCC:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SUCC     
          // ---------------------------------------------------------------------------------------------------     
