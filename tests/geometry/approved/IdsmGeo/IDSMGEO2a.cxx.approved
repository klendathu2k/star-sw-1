                            _attribute = attr;              
                      }           
                      /// Material AlPure            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Alpure");              
                            _material = mat;              
                      }           
                      if ( idsc.version==1 )           
                      {              
                            {  AgShape shape = AgShape("Tube");                 
