                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_SUCG;                 
                                  _stacker -> Build(this);                 
                            }              
                      }           
                      else           
                      {              
                            {  AgShape shape = AgShape("Tube");                 
                                  shape     .Inherit( AgBlock::previous() );                 
                                  create     .SetParameters(shape);                 
                                  shape.par("rmin")=21.62;                 
                                  shape.par("rmax")=40.5;                 
                                  shape.par("dz")=0.16/2.;                 
                                  /// Shape Tube rmin=21.62 rmax=40.5 dz=0.16/2.                  
                                  _same_shape &= _stacker->SearchVolume( shape, _attribute );                 
                                  _shape = shape;                 
                                  if (_same_shape) goto END_OF_SUCG;                 
                                  _stacker -> Build(this);                 
                            }              
                      }           
                      END_OF_SUCG:           
                      mCurrent = _save;           
                ///@}        
          } // End Block SUCG     
