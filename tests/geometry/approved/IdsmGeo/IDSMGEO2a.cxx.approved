                                  create     .SetParameters(shape);                 
                                  shape.par("rmin")=10.3;                 
                                  shape.par("rmax")=40.5;                 
                                  shape.par("dz")=0.16/2.;                 
                                  /// Shape Tube rmin=10.3 rmax=40.5 dz=0.16/2.                  
