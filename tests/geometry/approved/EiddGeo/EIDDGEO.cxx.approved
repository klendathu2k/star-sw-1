                            shape.par("dz")=eidg.trdthick/2;              
                            /// Shape Tubs rmin=eidg.rmin rmax=eidg.rmax phi1=-eidg.dphi/2 phi2=eidg.dphi/2 dz=eidg.trdthick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_ETRD;              
                            _stacker -> Build(this);              
                      }           
                      zposrad=-eidg.trdthick/2+eidg.trathick/2;           
                      _create = AgCreate("TRAD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create TRAD              
                            Create("TRAD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("TRAD");              
                            place.SetMother("ETRD");              
                            /// Add daughter volume TRAD to mother ETRD              
                            place.TranslateZ(zposrad);              
                            /// Translate z = zposrad              
                            _stacker -> Position( AgBlock::Find("TRAD"), place );              
                      } // end placement of TRAD           
                      zposabs=-eidg.trdthick/2+eidg.trathick+eidg.tabthick/2;           
                      _create = AgCreate("TABS");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create TABS              
                            Create("TABS");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("TABS");              
                            place.SetMother("ETRD");              
                            /// Add daughter volume TABS to mother ETRD              
                            place.TranslateZ(zposabs);              
                            /// Translate z = zposabs              
                            _stacker -> Position( AgBlock::Find("TABS"), place );              
                      } // end placement of TABS           
                      zposbod=-eidg.trdthick/2+eidg.trathick+eidg.tabthick+eidg.tbdthick/2;           
                      _create = AgCreate("TBOD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create TBOD              
                            Create("TBOD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("TBOD");              
                            place.SetMother("ETRD");              
                            /// Add daughter volume TBOD to mother ETRD              
                            place.TranslateZ(zposbod);              
                            /// Translate z = zposbod              
                            _stacker -> Position( AgBlock::Find("TBOD"), place );              
                      } // end placement of TBOD           
                      END_OF_ETRD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block ETRD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TRAD::mInstance = 0;     
          AgBlock *TRAD::Instance(){        
                   if ( mInstance==0 ) mInstance = new TRAD();        
                   return mInstance;        
          }     
          void TRAD::Block( AgCreate create )     
          {         
                ///@addtogroup TRAD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Radiator            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Radiator");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("TRAD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=eidg.rmin;              
                            shape.par("rmax")=eidg.rmax;              
                            shape.par("phi1")=-eidg.dphi/2;              
                            shape.par("phi2")=eidg.dphi/2;              
                            shape.par("dz")=eidg.trdthick/2;              
                            /// Shape Tubs rmin=eidg.rmin rmax=eidg.rmax phi1=-eidg.dphi/2 phi2=eidg.dphi/2 dz=eidg.trdthick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TRAD;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_TRAD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TRAD     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TABS::mInstance = 0;     
          AgBlock *TABS::Instance(){        
                   if ( mInstance==0 ) mInstance = new TABS();        
                   return mInstance;        
          }     
          void TABS::Block( AgCreate create )     
          {         
                ///@addtogroup TABS_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material Xe15CO2            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Xe15co2");              
                            _material = mat;              
                      }           
                      /// Medium Sensitive           
                      ///  isvol = 1           
                      {  AgMedium &med = AgMedium::Get("Sensitive");              
                               med.Inherit(this);              
                            med.par("isvol")=1;              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("TABS");              
                            attr.par("seen")=1;              
                            attr.par("colo")=8;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=eidg.rmin;              
                            shape.par("rmax")=eidg.rmax;              
                            shape.par("phi1")=-eidg.dphi/2;              
                            shape.par("phi2")=eidg.dphi/2;              
                            shape.par("dz")=eidg.tabthick/2;              
                            /// Shape Tubs rmin=eidg.rmin rmax=eidg.rmax phi1=-eidg.dphi/2 phi2=eidg.dphi/2 dz=eidg.tabthick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TABS;              
                            _stacker -> Build(this);              
                      }           
                      // deferred module()->AddHit( "TABS", "z", 0.0005, 0, 0, "s");           
                      // deferred module()->AddHit( "TABS", "y", 0.0005, 0, 0, "");           
                      // deferred module()->AddHit( "TABS", "z", 0.0005, 0, 0, "");           
                      // deferred module()->AddHit( "TABS", "cx", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TABS", "cy", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TABS", "cz", 10, 0, 0, "");           
                      // deferred module()->AddHit( "TABS", "lptot", 18, -3, 2, "");           
                      // deferred module()->AddHit( "TABS", "sleng", 0.1, 0, 800, "");           
                      // deferred module()->AddHit( "TABS", "tof", 16, 0, 1.0e-6, "");           
                      // deferred module()->AddHit( "TABS", "lgam", 16, -2, +4, "");           
                      // deferred module()->AddHit( "TABS", "step", 11, 0, 10, "");           
                      // deferred module()->AddHit( "TABS", "eloss", 16, 0, 0.01, "");           
                      END_OF_TABS:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TABS     
          // ---------------------------------------------------------------------------------------------------     
          AgBlock *TBOD::mInstance = 0;     
          AgBlock *TBOD::Instance(){        
                   if ( mInstance==0 ) mInstance = new TBOD();        
                   return mInstance;        
          }     
          void TBOD::Block( AgCreate create )     
          {         
                ///@addtogroup TBOD_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      /// Material G10            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("G10");              
                            _material = mat;              
                      }           
                      /// Medium Standard           
                      {  AgMedium med = AgMedium::CopyMedium("Standard");              
                            _medium = med;              
                      }           
                      { AgAttribute attr = AgAttribute("TBOD");              
                            attr.par("seen")=1;              
                            attr.par("colo")=7;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=eidg.rmin;              
                            shape.par("rmax")=eidg.rmax;              
                            shape.par("phi1")=-eidg.dphi/2;              
                            shape.par("phi2")=eidg.dphi/2;              
                            shape.par("dz")=eidg.tbdthick/2;              
                            /// Shape Tubs rmin=eidg.rmin rmax=eidg.rmax phi1=-eidg.dphi/2 phi2=eidg.dphi/2 dz=eidg.tbdthick/2               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_TBOD;              
                            _stacker -> Build(this);              
                      }           
                      END_OF_TBOD:           
                      mCurrent = _save;           
                ///@}        
          } // End Block TBOD     
    // ----------------------------------------------------------------------- geoctr
       void EIDDGEO::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup EIDDGEO_revision        
             ///@{           
                   /// Author: Ming Shao           
             ///@}        
             ///@addtogroup EIDDGEO_revision        
             ///@{           
                   /// Created:  28 September 2011            
             ///@}        
             AddBlock("ETTV", ETTV::Instance());        
             AddBlock("ETRV", ETRV::Instance());        
             AddBlock("ETFV", ETFV::Instance());        
             AddBlock("ECLV", ECLV::Instance());        
             AddBlock("ETOF", ETOF::Instance());        
             AddBlock("TECL", TECL::Instance());        
             AddBlock("ETRD", ETRD::Instance());        
             AddBlock("TBOX", TBOX::Instance());        
             AddBlock("TGAS", TGAS::Instance());        
             AddBlock("TPCB", TPCB::Instance());        
             AddBlock("TGLA", TGLA::Instance());        
             AddBlock("TGAP", TGAP::Instance());        
             AddBlock("TEAA", TEAA::Instance());        
             AddBlock("TEAB", TEAB::Instance());        
             AddBlock("SCIN", SCIN::Instance());        
             AddBlock("TRAD", TRAD::Instance());        
             AddBlock("TABS", TABS::Instance());        
             AddBlock("TBOD", TBOD::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill eidv
++eidv._index;
eidv.version = 1;
// eidv_docum.version = " version ";
eidv.eidconfig = 1;
// eidv_docum.eidconfig = " EID configuration ";
EIDV.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill eidg
++eidg._index;
eidg.version = 1;
// eidg_docum.version = " geometry version ";
eidg.ettz = 286.00;
// eidg_docum.ettz = " Z position of ETTIE Detector ";
eidg.etrvz = 280.00;
// eidg_docum.etrvz = " Z position of ETRD ";
eidg.etfvz = 299.00;
// eidg_docum.etfvz = " Z position ETOF ";
eidg.eclvz = 305.00;
// eidg_docum.eclvz = " Z position TECL ";
eidg.rmin = 46.107;
// eidg_docum.rmin = " mothervolume rmin (TPC inner radius) ";
eidg.rmax = 206.75;
// eidg_docum.rmax = " mothervolume rmin (TPC outer radius) ";
eidg.dphi = 28.0;
// eidg_docum.dphi = " sector phi acceptan (follow TPC sectors) ";
eidg.ettthick = 48.000;
// eidg_docum.ettthick = " ETTIE volume thick ";
eidg.tfvthick = 2.0000;
// eidg_docum.tfvthick = " ETFV volume thick ";
eidg.tofthick = 1.5202;
// eidg_docum.tofthick = " ETOF total thick ";
eidg.tbxthick = 0.300;
// eidg_docum.tbxthick = " ETOF box thick ";
eidg.tpbthick = 0.150;
// eidg_docum.tpbthick = " ETOF PCB thick ";
eidg.tglthick = 0.050;
// eidg_docum.tglthick = " ETOF glass thick ";
eidg.tgpthick = 0.022;
// eidg_docum.tgpthick = " ETOF gas gap thick ";
eidg.elvthick = 10.00;
// eidg_docum.elvthick = " ECLV volume thick ";
eidg.eclthick = 8.52;
// eidg_docum.eclthick = " TECL total thick ";
eidg.eaathick = 1.68;
// eidg_docum.eaathick = " Absorber 1 thick ";
eidg.eabthick = 0.84;
// eidg_docum.eabthick = " Absorber 2 thick ";
eidg.scnthick = 3.00;
// eidg_docum.scnthick = " Scintillator thick ";
eidg.trvthick = 36.0;
// eidg_docum.trvthick = " ETRV volume thick ";
eidg.trdthick = 12.0;
// eidg_docum.trdthick = " ETRD layer thick ";
eidg.trathick = 5.916;
// eidg_docum.trathick = " TR radiator thick ";
eidg.tabthick = 3.83;
// eidg_docum.tabthick = " TR absorber thick ";
eidg.tbdthick = 2.00;
// eidg_docum.tbdthick = " ETRD mother board thick ";
EIDG.fill();
        
             /// USE eidv _index=1;        
             EIDV.use( __eidv__index__ = 1 );
        
             /// USE eidg version=eidv.eidconfig;        
             EIDG.use( __eidg_version__ = eidv.eidconfig );
        
             /// Component Si	a=28.08	z=14	w=0.6*1*28./60.        
             /// Component O	a=16	z=8	w=0.6*2*16./60. + 0.4*4*16./174.        
             /// Component C	a=12	z=6	w=0.4*8*12./174.        
             /// Component H	a=1	z=1	w=0.4*14*1./174.        
             /// Mixture G10 dens=1.7        
             {  AgMaterial &mix = AgMaterial::Get("G10");           
                   mix.Component("Si",28.08,14,0.6*1*28./60.);           
                   mix.Component("O",16,8,0.6*2*16./60.+0.4*4*16./174.);           
                   mix.Component("C",12,6,0.4*8*12./174.);           
                   mix.Component("H",1,1,0.4*14*1./174.);           
                   mix.par("dens")=1.7;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component H	a=1	z=1	w=0.90*2*1./102.+0.+0.05*10*1./58.        
             /// Component C	a=12	z=6	w=0.90*2*12./102.+0.+0.05*4*12./58.        
             /// Component F	a=19	z=9	w=0.90*4*19./102.+0.05*6*19./146.+0.        
             /// Component S	a=32	z=16	w=0.+0.05*1*32./146.+0.        
             /// Mixture Freon dens=4.55e-3        
             {  AgMaterial &mix = AgMaterial::Get("Freon");           
                   mix.Component("H",1,1,0.90*2*1./102.+0.+0.05*10*1./58.);           
                   mix.Component("C",12,6,0.90*2*12./102.+0.+0.05*4*12./58.);           
                   mix.Component("F",19,9,0.90*4*19./102.+0.05*6*19./146.+0.);           
                   mix.Component("S",32,16,0.+0.05*1*32./146.+0.);           
                   mix.par("dens")=4.55e-3;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Si	a=28	z=14	w=1.        
             /// Component O	a=16	z=8	w=2.        
             /// Mixture Glass dens=2.5        
             {  AgMaterial &mix = AgMaterial::Get("Glass");           
                   mix.Component("Si",28,14,1.);           
                   mix.Component("O",16,8,2.);           
                   mix.par("dens")=2.5;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component N	a=14.01	z=14	w=0.008        
             /// Component O	a=16	z=8	w=0.301        
             /// Component C	a=12	z=6	w=0.653        
             /// Component H	a=1	z=1	w=0.038        
             /// Mixture Radiator dens=0.10416        
             {  AgMaterial &mix = AgMaterial::Get("Radiator");           
                   mix.Component("N",14.01,14,0.008);           
                   mix.Component("O",16,8,0.301);           
                   mix.Component("C",12,6,0.653);           
                   mix.Component("H",1,1,0.038);           
                   mix.par("dens")=0.10416;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Xe	a=131.29	z=54	w=0.979        
             /// Component O	a=16	z=8	w=0.0147        
             /// Component C	a=12	z=6	w=0.0063        
             /// Mixture Xe15CO2 dens=0.0049        
             {  AgMaterial &mix = AgMaterial::Get("Xe15co2");           
                   mix.Component("Xe",131.29,54,0.979);           
                   mix.Component("O",16,8,0.0147);           
                   mix.Component("C",12,6,0.0063);           
                   mix.par("dens")=0.0049;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component C	a=12	z=6	w=0.923        
             /// Component H	a=1	z=1	w=0.077        
             /// Mixture Polystyrene dens=1.06        
             {  AgMaterial &mix = AgMaterial::Get("Polystyrene");           
                   mix.Component("C",12,6,0.923);           
                   mix.Component("H",1,1,0.077);           
                   mix.par("dens")=1.06;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             _create = AgCreate("ETTV");        
             {           
                   AgShape myshape; // undefined shape           
                   ///Create ETTV           
                   Create("ETTV");            
             }        
             zposett=eidg.ettz;        
             {           
                   AgPosition  place;           
                   place.SetBlock("ETTV");           
                   place.SetMother("CAVE");           
                   /// Add daughter volume ETTV to mother CAVE           
                   place.TranslateZ(-zposett);           
                   /// Translate z = -zposett           
                   /// G3 Reference: thetax = 90           
                   /// G3 Reference: phix = 0           
                   /// G3 Reference: thetay = 90           
                   /// G3 Reference: phiy = 90           
                   /// G3 Reference: thetaz = 180           
                   /// G3 Reference: phiz = 0           
                   Double_t _thetax=90,_phix=0,_thetay=90,_phiy=90,_thetaz=180,_phiz=0;           
                   place.Reference( _thetax, _phix, _thetay, _phiy, _thetaz, _phiz );           
                   _stacker -> Position( AgBlock::Find("ETTV"), place );           
             } // end placement of ETTV        
       }; // EIDDGEO     
 }; // namespace EIDDGEO  
 