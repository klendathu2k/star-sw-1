      ATTRIBUTE FGWC seen=1 colo=1
      MATERIAL ConMix
      SHAPE box dx=0.3/2. dy=elecCdy/2. dz=3.15/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FGWD
      BLOCK FGWD   gas feed connection
      ATTRIBUTE FGWD seen=1 colo=1
      MATERIAL Brass
      SHAPE tube rmin=0.2 rmax=0.5 dz=2.1/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FGWE
      BLOCK FGWE   HV board
      ATTRIBUTE FGWE seen=1 colo=1
      MATERIAL HVMix
      SHAPE box dx=elecElen/2. dy=elecWidth/2.,
            dz=volElecDZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FWEB
      BLOCK FWEB   HV board
      ATTRIBUTE FWEB seen=1 colo=1
      MATERIAL HVMix
      SHAPE box dx=elecElenT/2. dy=elecWidth/2.,
            dz=volElecDZ/2.
      ENDBLOCK
