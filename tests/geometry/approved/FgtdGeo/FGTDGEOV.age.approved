      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE FGWD
      CALL AgsReset 
      CALL agml_position_begin('FGWD') 
      %title = 'FGWD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((diskOutR-frameWidth/2.)*cos(elecDang*degrad)) 
      CALL agml_translate_x( %x ) 
      ag_y = real((diskOutR-frameWidth/2.)*sin(elecDang*degrad)) 
      CALL agml_translate_y( %y ) 
      ag_alphax = 90.0 
