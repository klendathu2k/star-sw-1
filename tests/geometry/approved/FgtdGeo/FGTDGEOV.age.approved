      MATERIAL FR4
      SHAPE box dx=(diskOutR-diskInRT-frameWidth)/2.,
            dy=gridWidth/2. dz=frameDZ/2.
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FGXD
