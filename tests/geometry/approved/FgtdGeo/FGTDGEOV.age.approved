      ag_y = real((diskOutR-frameWidth/2.)*sin(elecDang*degrad)) 
      CALL agml_translate_y( %y ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE FGWD
      CALL AgsReset 
      CALL agml_position_begin('FGWD') 
      %title = 'FGWD' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((diskOutR-frameWidth/2.)*sin(elecDang*degrad)) 
      CALL agml_translate_x( %x ) 
      ag_y = real((diskOutR-frameWidth/2.)*cos(elecDang*degrad)) 
      CALL agml_translate_y( %y ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = 90.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      CREATE FGWE
      CALL AgsReset 
      CALL agml_position_begin('FGWE') 
      %title = 'FGWE' 
      %exname = 'POSITION' ! agml placement 
      ag_x = real((flatOutR-frameWidth/2.)*cos(flatPerpAng*degrad)) 
      CALL agml_translate_x( %x ) 
      ag_y = real((flatOutR-frameWidth/2.)*sin(flatPerpAng*degrad)) 
      CALL agml_translate_y( %y ) 
      ag_alphaz = real(flatPerpAng-90.) 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
      CALL agml_get_angles(%thetax,%phix,%thetay,%phiy,%thetaz,%phiz) 
      %parlist = 'X_Y_THETAX_PHIX_THETAY_PHIY_THETAZ_PHIZ' 
      CALL AxPosition 
      ENDBLOCK
      ! ---------------------------------------------------------------------------------- FVEB
