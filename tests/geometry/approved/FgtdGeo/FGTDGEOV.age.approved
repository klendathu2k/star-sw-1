      ag_y = real((diskOutR-frameWidth/2.)*cos(elecDang*degrad)) 
      CALL agml_translate_y( %y ) 
      ag_alphax = 90.0 
      CALL agml_rotate_x(%alphax) 
      ag_alphaz = 90.0 
      CALL agml_rotate_z(%alphaz) 
      CALL agml_get_translation( %x, %y, %z ) 
