                                  /// Add daughter volume FGQA to mother FVNB                 
                                  place.TranslateX(framewidth/2.+framexyoff);                 
                                  /// Translate x = framewidth/2.+framexyoff                 
                                  place.TranslateY((diskoutr+diskinrt)/2.);                 
                                  /// Translate y = (diskoutr+diskinrt)/2.                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQA"), place );                 
                            } // end placement of FGQA              
                            _create = AgCreate("FGQB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQB                 
                                  Create("FGQB");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQB");                 
                                  place.SetMother("FVNB");                 
                                  /// Add daughter volume FGQB to mother FVNB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQB"), place );                 
                            } // end placement of FGQB              
                            _create = AgCreate("FGQC");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQC                 
                                  Create("FGQC");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQC");                 
                                  place.SetMother("FVNB");                 
                                  /// Add daughter volume FGQC to mother FVNB                 
                                  place.TranslateX((diskoutr+diskinrt)/2.);                 
                                  /// Translate x = (diskoutr+diskinrt)/2.                 
                                  place.TranslateY(framewidth/2.+framexyoff);                 
                                  /// Translate y = framewidth/2.+framexyoff                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQC"), place );                 
                            } // end placement of FGQC              
                            _create = AgCreate("FGQD");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQD                 
                                  Create("FGQD");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQD");                 
                                  place.SetMother("FVNB");                 
                                  /// Add daughter volume FGQD to mother FVNB                 
