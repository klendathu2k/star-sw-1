                            shape.par("rmin")=diskinrt;              
                            shape.par("rmax")=diskoutr;              
                            shape.par("phi1")=0.;              
                            shape.par("phi2")=90.;              
                            shape.par("dz")=volreaddz/2.;              
                            /// Shape Tubs rmin=diskinrt rmax=diskoutr phi1=0. phi2=90. dz=volreaddz/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FVRB;              
                            _stacker -> Build(this);              
                      }           
                      zzfgz=-volreaddz/2.+framedz/1.5;           
                      _create = AgCreate("FQAB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FQAB              
                            Create("FQAB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FQAB");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FQAB to mother FVRB              
                            place.TranslateX(framewidth/2.+framexyoff);              
                            /// Translate x = framewidth/2.+framexyoff              
                            place.TranslateY((diskoutr+diskinrt)/2.);              
                            /// Translate y = (diskoutr+diskinrt)/2.              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            _stacker -> Position( AgBlock::Find("FQAB"), place );              
                      } // end placement of FQAB           
                      _create = AgCreate("FQBB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FQBB              
                            Create("FQBB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FQBB");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FQBB to mother FVRB              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            _stacker -> Position( AgBlock::Find("FQBB"), place );              
                      } // end placement of FQBB           
                      _create = AgCreate("FQCB");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FQCB              
                            Create("FQCB");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FQCB");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FQCB to mother FVRB              
                            place.TranslateX((diskoutr+diskinrt)/2.);              
                            /// Translate x = (diskoutr+diskinrt)/2.              
                            place.TranslateY(framewidth/2.+framexyoff);              
                            /// Translate y = framewidth/2.+framexyoff              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            _stacker -> Position( AgBlock::Find("FQCB"), place );              
                      } // end placement of FQCB           
                      _create = AgCreate("FGQD");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FGQD              
                            Create("FGQD");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FGQD");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FGQD to mother FVRB              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            _stacker -> Position( AgBlock::Find("FGQD"), place );              
                      } // end placement of FGQD           
                      _create = AgCreate("FGQE");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FGQE              
                            Create("FGQE");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FGQE");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FGQE to mother FVRB              
                            place.TranslateX((flatoutr-framewidth/2.)*cos(flatperpang*degrad));              
                            /// Translate x = (flatoutr-framewidth/2.)*cos(flatperpang*degrad)              
                            place.TranslateY((flatoutr-framewidth/2.)*sin(flatperpang*degrad));              
                            /// Translate y = (flatoutr-framewidth/2.)*sin(flatperpang*degrad)              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            place.AlphaZ(flatperpang-90.);              
                            /// Rotate: AlphaZ = flatperpang-90.              
                            /// G3 Reference: thetax = 90              
                            /// G3 Reference: phix = 0              
                            /// G3 Reference: thetay = 90              
                            /// G3 Reference: phiy = 90              
                            /// G3 Reference: thetaz = 0              
                            /// G3 Reference: phiz = 0              
                            _stacker -> Position( AgBlock::Find("FGQE"), place );              
                      } // end placement of FGQE           
                      _create = AgCreate("FGQF");           
                      {              
                            AgShape myshape; // undefined shape              
                            ///Create FGQF              
                            Create("FGQF");               
                      }           
                      {              
                            AgPosition  place;              
                            place.SetBlock("FGQF");              
                            place.SetMother("FVRB");              
                            /// Add daughter volume FGQF to mother FVRB              
                            place.TranslateZ(zzfgz);              
                            /// Translate z = zzfgz              
                            _stacker -> Position( AgBlock::Find("FGQF"), place );              
                      } // end placement of FGQF           
                      END_OF_FVRB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FVRB     
