                                  /// Translate x = (flatoutr-framewidth/2.)*cos(flatperpang*degrad)                 
                                  place.TranslateY((flatoutr-framewidth/2.)*sin(flatperpang*degrad));                 
                                  /// Translate y = (flatoutr-framewidth/2.)*sin(flatperpang*degrad)                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
