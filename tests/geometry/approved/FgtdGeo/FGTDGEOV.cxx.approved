       void FGTDGEOV::ConstructGeometry( const Char_t *dummy )     
       {        
             ///@addtogroup FGTDGEOV_revision        
             ///@{           
                   /// Created: 08/2012           
             ///@}        
             ///@addtogroup FGTDGEOV_revision        
             ///@{           
                   /// Author: Jan Balewski MIT, Wei-Ming Zhang KSU, Willie Leight MIT (material mixes), Anselm Vossen CEEM: Extension to 12 Discs           
             ///@}        
             AddBlock("FGTM", FGTM::Instance());        
             AddBlock("FGTD", FGTD::Instance());        
             AddBlock("FGTQ", FGTQ::Instance());        
             AddBlock("FGVN", FGVN::Instance());        
             AddBlock("FGZC", FGZC::Instance());        
             AddBlock("FGVG", FGVG::Instance());        
             AddBlock("FGVR", FGVR::Instance());        
             AddBlock("FGVE", FGVE::Instance());        
             AddBlock("FGQA", FGQA::Instance());        
             AddBlock("FGQB", FGQB::Instance());        
             AddBlock("FGQC", FGQC::Instance());        
             AddBlock("FGQD", FGQD::Instance());        
             AddBlock("FGQE", FGQE::Instance());        
             AddBlock("FGQF", FGQF::Instance());        
             AddBlock("FGXA", FGXA::Instance());        
             AddBlock("FGXB", FGXB::Instance());        
             AddBlock("FGXC", FGXC::Instance());        
             AddBlock("FGXD", FGXD::Instance());        
             AddBlock("FGWA", FGWA::Instance());        
             AddBlock("FGWB", FGWB::Instance());        
             AddBlock("FGWC", FGWC::Instance());        
             AddBlock("FGWD", FGWD::Instance());        
             AddBlock("FGWE", FGWE::Instance());        
             AddBlock("FGCT", FGCT::Instance());        
             AddBlock("FGCN", FGCN::Instance());        
             AddBlock("FGCM", FGCM::Instance());        
             AddBlock("FGDB", FGDB::Instance());        
             AddBlock("FTQB", FTQB::Instance());        
             AddBlock("FVNB", FVNB::Instance());        
             AddBlock("FZCB", FZCB::Instance());        
             AddBlock("FVGB", FVGB::Instance());        
             AddBlock("FVRB", FVRB::Instance());        
             AddBlock("FVEB", FVEB::Instance());        
             AddBlock("FXCB", FXCB::Instance());        
             AddBlock("FXDB", FXDB::Instance());        
             AddBlock("FQAB", FQAB::Instance());        
             AddBlock("FQBB", FQBB::Instance());        
             AddBlock("FQCB", FQCB::Instance());        
             AddBlock("FWEB", FWEB::Instance());        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fggg
++fggg._index;
fggg.fgstconfig = 1.0;
// fggg_docum.fgstconfig = "selection of no. of disks and quadrants ";
FGGG.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fgst
++fgst._index;
fgst.config = 3.0;
// fgst_docum.config = "versioning of the FGST geometry data";
fgst.ndisk = 6;
// fgst_docum.ndisk = "number of disks";
fgst.nquad = 4;
// fgst_docum.nquad = "number quadrants in a disks";
{
fgst_info::zdisca::Type temp = {
fgst_info::zdisca::BaseType(67.3990),
fgst_info::zdisca::BaseType(77.8765),
fgst_info::zdisca::BaseType(87.0840),
fgst_info::zdisca::BaseType(97.4821),
fgst_info::zdisca::BaseType(108.9121),
fgst_info::zdisca::BaseType(118.9927)
}
;
memcpy(&fgst.zdisca, &temp, sizeof(temp));;
}
// fgst_docum.zdisca = " z-center of disk senstive volume from center in STAR , as measured in 2011-10  ";
fgst.ctubedz = 150.0;
// fgst_docum.ctubedz = "Cooling tube DZ";
FGST.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fgst
++fgst._index;
fgst.config = 2.0;
// fgst_docum.config = "versioning of the FGST geometry data";
fgst.ndisk = 6;
// fgst_docum.ndisk = "number of disks";
fgst.nquad = 4;
// fgst_docum.nquad = "number quadrants in a disks";
{
fgst_info::zdisca::Type temp = {
fgst_info::zdisca::BaseType(70.),
fgst_info::zdisca::BaseType(80.),
fgst_info::zdisca::BaseType(90.),
fgst_info::zdisca::BaseType(100.),
fgst_info::zdisca::BaseType(110.),
fgst_info::zdisca::BaseType(120.)
}
;
memcpy(&fgst.zdisca, &temp, sizeof(temp));;
}
// fgst_docum.zdisca = " z-center of disk senstive volume from center in STAR , ideal location ";
fgst.ctubedz = 150.0;
// fgst_docum.ctubedz = "Cooling tube DZ";
FGST.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fgst
++fgst._index;
fgst.config = 1.0;
// fgst_docum.config = "versioning of the FGST geometry data";
fgst.ndisk = 12;
// fgst_docum.ndisk = "number of disks";
fgst.nquad = 4;
// fgst_docum.nquad = "number quadrants in a disks";
{
fgst_info::zdisca::Type temp = {
fgst_info::zdisca::BaseType(67.3990),
fgst_info::zdisca::BaseType(77.8765),
fgst_info::zdisca::BaseType(87.0840),
fgst_info::zdisca::BaseType(97.4821),
fgst_info::zdisca::BaseType(108.9121),
fgst_info::zdisca::BaseType(118.9927),
fgst_info::zdisca::BaseType(130.0000),
fgst_info::zdisca::BaseType(140.0000),
fgst_info::zdisca::BaseType(150.0000),
fgst_info::zdisca::BaseType(170.0000),
fgst_info::zdisca::BaseType(190.0000),
fgst_info::zdisca::BaseType(200.0000)
}
;
memcpy(&fgst.zdisca, &temp, sizeof(temp));;
}
// fgst_docum.zdisca = " z-center of disk senstive volume from center in STAR , as measured in 2011-10  ";
fgst.ctubedz = 150.0;
// fgst_docum.ctubedz = "Cooling tube DZ";
FGST.fill();
        
             // ---------------------------------------------------------------------------------------------------        
             // Fill fgst
++fgst._index;
fgst.config = 4.0;
// fgst_docum.config = "versioning of the FGST geometry data";
fgst.ndisk = 6;
// fgst_docum.ndisk = "number of disks";
fgst.nquad = 4;
// fgst_docum.nquad = "number quadrants in a disks";
{
fgst_info::zdisca::Type temp = {
fgst_info::zdisca::BaseType(93.500),
fgst_info::zdisca::BaseType(100.000),
fgst_info::zdisca::BaseType(193.500),
fgst_info::zdisca::BaseType(200.000),
fgst_info::zdisca::BaseType(293.500),
fgst_info::zdisca::BaseType(300.00)
}
;
memcpy(&fgst.zdisca, &temp, sizeof(temp));;
}
// fgst_docum.zdisca = " z-center";
fgst.ctubedz = 270.0;
// fgst_docum.ctubedz = "Cooling tube DZ";
FGST.fill();
        
             /// Component Si	a=28.08	z=14	w=0.281        
             /// Component O	a=16	z=8	w=0.467        
             /// Component C	a=12	z=6	w=0.220        
             /// Component H	a=1	z=1	w=0.032        
             /// Mixture FR4 dens=1.80        
             {  AgMaterial &mix = AgMaterial::Get("Fr4");           
                   mix.Component("Si",28.08,14,0.281);           
                   mix.Component("O",16,8,0.467);           
                   mix.Component("C",12,6,0.220);           
                   mix.Component("H",1,1,0.032);           
                   mix.par("dens")=1.80;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.062        
             /// Component C	a=12	z=6	w=0.892        
             /// Component H	a=1	z=1	w=0.019        
             /// Component Cl	a=35.5	z=17	w=0.027        
             /// Mixture CFRPMix dens=1.78        
             {  AgMaterial &mix = AgMaterial::Get("Cfrpmix");           
                   mix.Component("O",16,8,0.062);           
                   mix.Component("C",12,6,0.892);           
                   mix.Component("H",1,1,0.019);           
                   mix.Component("Cl",35.5,17,0.027);           
                   mix.par("dens")=1.78;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.142        
             /// Component C	a=12	z=6	w=0.637        
             /// Component H	a=1	z=1	w=0.097        
             /// Component N	a=14	z=7	w=0.124        
             /// Mixture Nylon dens=1.15        
             {  AgMaterial &mix = AgMaterial::Get("Nylon");           
                   mix.Component("O",16,8,0.142);           
                   mix.Component("C",12,6,0.637);           
                   mix.Component("H",1,1,0.097);           
                   mix.Component("N",14,7,0.124);           
                   mix.par("dens")=1.15;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.129        
             /// Component C	a=12	z=6	w=0.579        
             /// Component H	a=1	z=1	w=0.088        
             /// Component N	a=14	z=7	w=0.112        
             /// Component Al	a=27	z=13	w=0.092        
             /// Mixture CoolMix dens=1.214        
             {  AgMaterial &mix = AgMaterial::Get("Coolmix");           
                   mix.Component("O",16,8,0.129);           
                   mix.Component("C",12,6,0.579);           
                   mix.Component("H",1,1,0.088);           
                   mix.Component("N",14,7,0.112);           
                   mix.Component("Al",27,13,0.092);           
                   mix.par("dens")=1.214;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.090        
             /// Component C	a=12	z=6	w=0.796        
             /// Component H	a=1	z=1	w=0.023        
             /// Component Cl	a=35.5	z=17	w=0.019        
             /// Component N	a=14	z=7	w=0.025        
             /// Component Al	a=27	z=13	w=0.002        
             /// Component Cu	a=63.5	z=29	w=0.039        
             /// Component Ar	a=39.9	z=18	w=0.006        
             /// Mixture NomexMix dens=0.090        
             {  AgMaterial &mix = AgMaterial::Get("Nomexmix");           
                   mix.Component("O",16,8,0.090);           
                   mix.Component("C",12,6,0.796);           
                   mix.Component("H",1,1,0.023);           
                   mix.Component("Cl",35.5,17,0.019);           
                   mix.Component("N",14,7,0.025);           
                   mix.Component("Al",27,13,0.002);           
                   mix.Component("Cu",63.5,29,0.039);           
                   mix.Component("Ar",39.9,18,0.006);           
                   mix.par("dens")=0.090;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.095        
             /// Component C	a=12	z=6	w=0.301        
             /// Component H	a=1	z=1	w=0.011        
             /// Component N	a=14	z=7	w=0.032        
             /// Component Cu	a=63.5	z=29	w=0.547        
             /// Component Ar	a=39.9	z=18	w=0.014        
             /// Mixture GemMix dens=0.079        
             {  AgMaterial &mix = AgMaterial::Get("Gemmix");           
                   mix.Component("O",16,8,0.095);           
                   mix.Component("C",12,6,0.301);           
                   mix.Component("H",1,1,0.011);           
                   mix.Component("N",14,7,0.032);           
                   mix.Component("Cu",63.5,29,0.547);           
                   mix.Component("Ar",39.9,18,0.014);           
                   mix.par("dens")=0.079;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component O	a=16	z=8	w=0.160        
             /// Component C	a=12	z=6	w=0.508        
             /// Component H	a=1	z=1	w=0.020        
             /// Component N	a=14	z=7	w=0.051        
             /// Component Al	a=27	z=13	w=0.003        
             /// Component Cu	a=63.5	z=29	w=0.255        
             /// Component Ar	a=39.9	z=18	w=0.003        
             /// Mixture ReadMix dens=0.356        
             {  AgMaterial &mix = AgMaterial::Get("Readmix");           
                   mix.Component("O",16,8,0.160);           
                   mix.Component("C",12,6,0.508);           
                   mix.Component("H",1,1,0.020);           
                   mix.Component("N",14,7,0.051);           
                   mix.Component("Al",27,13,0.003);           
                   mix.Component("Cu",63.5,29,0.255);           
                   mix.Component("Ar",39.9,18,0.003);           
                   mix.par("dens")=0.356;           
                   mix.lock();           
                   _material = mix;           
                   _material.lock();           
             }        
             /// Component Si	a=28.1	z=14	w=0.191        
             /// Component O	a=16	z=8	w=0.339        
             /// Component C	a=12	z=6	w=0.213        
             /// Component H	a=1	z=1	w=0.028        
             /// Component Cl	a=35.5	z=17	w=0.009        
