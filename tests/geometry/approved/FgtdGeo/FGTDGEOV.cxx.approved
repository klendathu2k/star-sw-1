                      /// Loop on k from 0 to 1 step=1           
                      for ( k=0; (1>0)? (k<=1):(k>=1); k+=1 )           
                      {              
                            zzfgz=(-volsensdz+framedz)/2.*(1.-2.*k);              
                            _create = AgCreate("FGQA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
