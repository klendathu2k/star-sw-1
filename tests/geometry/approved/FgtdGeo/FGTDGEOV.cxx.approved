                                  /// Add daughter volume FGQB to mother FZCB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQB"), place );                 
                            } // end placement of FGQB              
                            _create = AgCreate("FGQC");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQC                 
                                  Create("FGQC");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQC");                 
                                  place.SetMother("FZCB");                 
                                  /// Add daughter volume FGQC to mother FZCB                 
                                  place.TranslateX((diskoutr+diskinrt)/2.);                 
                                  /// Translate x = (diskoutr+diskinrt)/2.                 
                                  place.TranslateY(framewidth/2.+framexyoff);                 
                                  /// Translate y = framewidth/2.+framexyoff                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
