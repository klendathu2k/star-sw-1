          AgBlock *FVGB::mInstance = 0;     
          AgBlock *FVGB::Instance(){        
                   if ( mInstance==0 ) mInstance = new FVGB();        
                   return mInstance;        
          }     
          void FVGB::Block( AgCreate create )     
          {         
                ///@addtogroup FVGB_doc        
                ///@{           
                        AgBlock *_save = mCurrent;           
                        mCurrent = this;           
                        Bool_t _same_shape = true;           
                      { AgAttribute attr = AgAttribute("FVGB");              
                            attr.par("seen")=0;              
                            attr.par("colo")=6;              
                            attr.Inherit( AgBlock::previous() );               
                            _attribute = attr;              
                      }           
                      /// Material GemMix            
                      {  AgMaterial mat = AgMaterial::CopyMaterial("Gemmix");              
                            _material = mat;              
                      }           
                      {  AgShape shape = AgShape("Tubs");              
                            shape     .Inherit( AgBlock::previous() );              
                            create     .SetParameters(shape);              
                            shape.par("rmin")=diskinrt;              
                            shape.par("rmax")=diskoutr;              
                            shape.par("phi1")=0.;              
                            shape.par("phi2")=90.;              
                            shape.par("dz")=volgemdz/2.;              
                            /// Shape Tubs rmin=diskinrt rmax=diskoutr phi1=0. phi2=90. dz=volgemdz/2.               
                            _same_shape &= _stacker->SearchVolume( shape, _attribute );              
                            _shape = shape;              
                            if (_same_shape) goto END_OF_FVGB;              
                            _stacker -> Build(this);              
                      }           
                      /// Loop on k from 0 to 2 step=1           
                      for ( k=0; (1>0)? (k<=2):(k>=2); k+=1 )           
                      {              
                            zzfgz=(-volgemdz+framedz-0.01)/2.*(-1+k);              
                            _create = AgCreate("FGQA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQA                 
                                  Create("FGQA");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQA");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQA to mother FVGB                 
                                  place.TranslateX(framewidth/2.+framexyoff);                 
                                  /// Translate x = framewidth/2.+framexyoff                 
                                  place.TranslateY((diskoutr+diskinrt)/2.);                 
                                  /// Translate y = (diskoutr+diskinrt)/2.                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQA"), place );                 
                            } // end placement of FGQA              
                            _create = AgCreate("FGQB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQB                 
                                  Create("FGQB");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQB");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQB to mother FVGB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQB"), place );                 
                            } // end placement of FGQB              
                            _create = AgCreate("FGQC");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQC                 
                                  Create("FGQC");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQC");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQC to mother FVGB                 
                                  place.TranslateX((diskoutr+diskinrt)/2.);                 
                                  /// Translate x = (diskoutr+diskinrt)/2.                 
                                  place.TranslateY(framewidth/2.+framexyoff);                 
                                  /// Translate y = framewidth/2.+framexyoff                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQC"), place );                 
                            } // end placement of FGQC              
                            _create = AgCreate("FGQD");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQD                 
                                  Create("FGQD");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQD");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQD to mother FVGB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQD"), place );                 
                            } // end placement of FGQD              
                            _create = AgCreate("FGQE");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQE                 
                                  Create("FGQE");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQE");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQE to mother FVGB                 
                                  place.TranslateX((flatoutr-framewidth/2.)*cos(flatperpang*degrad));                 
                                  /// Translate x = (flatoutr-framewidth/2.)*cos(flatperpang*degrad)                 
                                  place.TranslateY((flatoutr-framewidth/2.)*sin(flatperpang*degrad));                 
                                  /// Translate y = (flatoutr-framewidth/2.)*sin(flatperpang*degrad)                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  place.AlphaZ(flatperpang-90.);                 
                                  /// Rotate: AlphaZ = flatperpang-90.                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("FGQE"), place );                 
                            } // end placement of FGQE              
                            _create = AgCreate("FGQF");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGQF                 
                                  Create("FGQF");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGQF");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGQF to mother FVGB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGQF"), place );                 
                            } // end placement of FGQF              
                            _create = AgCreate("FGXA");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGXA                 
                                  Create("FGXA");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGXA");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGXA to mother FVGB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGXA"), place );                 
                            } // end placement of FGXA              
                            _create = AgCreate("FGXB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FGXB                 
                                  Create("FGXB");                  
                            }              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FGXB");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FGXB to mother FVGB                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  _stacker -> Position( AgBlock::Find("FGXB"), place );                 
                            } // end placement of FGXB              
                            _create = AgCreate("FXCB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FXCB                 
                                  Create("FXCB");                  
                            }              
                            xxfgz=(diskoutr+diskinrt)/2.;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FXCB");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FXCB to mother FVGB                 
                                  place.TranslateX(xxfgz*cos(gridraylongphi*degrad));                 
                                  /// Translate x = xxfgz*cos(gridraylongphi*degrad)                 
                                  place.TranslateY(xxfgz*sin(gridraylongphi*degrad));                 
                                  /// Translate y = xxfgz*sin(gridraylongphi*degrad)                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  place.AlphaZ(gridraylongphi);                 
                                  /// Rotate: AlphaZ = gridraylongphi                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("FXCB"), place );                 
                            } // end placement of FXCB              
                            _create = AgCreate("FXDB");              
                            {                 
                                  AgShape myshape; // undefined shape                 
                                  ///Create FXDB                 
                                  Create("FXDB");                  
                            }              
                            xxfgz=(flatoutr+diskinrt)/2.;              
                            {                 
                                  AgPosition  place;                 
                                  place.SetBlock("FXDB");                 
                                  place.SetMother("FVGB");                 
                                  /// Add daughter volume FXDB to mother FVGB                 
                                  place.TranslateX(xxfgz*cos(gridrayshortphi*degrad));                 
                                  /// Translate x = xxfgz*cos(gridrayshortphi*degrad)                 
                                  place.TranslateY(xxfgz*sin(gridrayshortphi*degrad));                 
                                  /// Translate y = xxfgz*sin(gridrayshortphi*degrad)                 
                                  place.TranslateZ(zzfgz);                 
                                  /// Translate z = zzfgz                 
                                  place.AlphaZ(gridrayshortphi);                 
                                  /// Rotate: AlphaZ = gridrayshortphi                 
                                  /// G3 Reference: thetax = 90                 
                                  /// G3 Reference: phix = 0                 
                                  /// G3 Reference: thetay = 90                 
                                  /// G3 Reference: phiy = 90                 
                                  /// G3 Reference: thetaz = 0                 
                                  /// G3 Reference: phiz = 0                 
                                  _stacker -> Position( AgBlock::Find("FXDB"), place );                 
                            } // end placement of FXDB              
                      }           
                      END_OF_FVGB:           
                      mCurrent = _save;           
                ///@}        
          } // End Block FVGB     
