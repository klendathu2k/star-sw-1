# Doxyfile for StSsdSimulationMaker
# Run from this directory: doxygen Doxyfile

PROJECT_NAME           = "StSsdSimulationMaker"
PROJECT_BRIEF          = "STAR Silicon Strip Detector slow simulation"
PROJECT_NUMBER         = ""

OUTPUT_DIRECTORY       = .

# ---- Input ----
INPUT                  = .. \
                         .
FILE_PATTERNS          = *.h *.cxx *.dox
RECURSIVE              = NO
EXCLUDE                =
EXCLUDE_PATTERNS       =

# ---- Extraction ----
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ---- Preprocessing ----
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

# ---- Aliases (STAR convention helpers) ----
ALIASES               += "starauthor{1}=\author \1"

# ---- Output formats ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---- Diagrams (set to NO if Graphviz not available) ----
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

# ---- Verbosity ----
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

# ---- Source browsing ----
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# ---- Sorting ----
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# ---- Other ----
TAB_SIZE               = 2
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
