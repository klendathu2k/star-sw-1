// File documentation blocks
// ============================================================

/**
 * @file St_sls_Maker.h
 * @ingroup StSsdSimulationMaker
 * @brief Header for St_sls_Maker: GEANT-hit → strip-signal conversion.
 *
 * Declares the St_sls_Maker class, its private geometry and control-parameter
 * data members, and the public interface for the SSD lazy simulator.
 *
 * @authors B. Hippolyte, W. Pinganaud
 * @date 2000
 */

/**
 * @file St_sls_Maker.cxx
 * @ingroup StSsdSimulationMaker
 * @brief Implementation of St_sls_Maker.
 *
 * Contains the full simulation of GEANT-hit propagation, ideal-to-real geometry
 * correction, charge-sharing calculation, and strip-table output for the STAR SSD.
 *
 * @authors B. Hippolyte, W. Pinganaud
 * @date 2000
 */

