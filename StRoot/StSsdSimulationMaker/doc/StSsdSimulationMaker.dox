 * @file St_spa_Maker.h
 * @ingroup StSsdSimulationMaker
 * @brief Header for St_spa_Maker: electronics and DAQ simulation.
 *
 * Declares the St_spa_Maker class that applies noise, pedestal subtraction, and
 * DAQ threshold cuts to the raw strip signals produced by St_sls_Maker.
 *
 * @authors B. Hippolyte, W. Pinganaud
 * @date 2000
 */

/**
 * @file St_spa_Maker.cxx
 * @ingroup StSsdSimulationMaker
 * @brief Implementation of St_spa_Maker.
 *
 * Reads the @c sls_strip table, adds per-strip Gaussian noise from the
 * calibration database, applies the zero-suppression cut, and writes surviving
 * strips to the @c spa_strip table.
 *
 * @authors B. Hippolyte, W. Pinganaud
 * @date 2000
 */

/**
 * @file StSsdEmbeddingMaker.h
