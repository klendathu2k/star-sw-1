 *
 * Extends StEmcSimpleSimulator with MIP photo-electron references and
 * a StPmtSignal member to model primary and secondary dynode statistics.
 *
 * @author A. Pavlinov, A. Suaide, A. Kocoloski
 */

/**
 * @file StEmcPmtSimulator.cxx
