 * Defines the pure-virtual API (setters and makeRawHit()) that both concrete
 * simulator classes — StEmcSimpleSimulator and StEmcPmtSimulator — must
 * satisfy, as well as the shared StEmcSimulatorMode enumeration.
 *
 * @author A. Pavlinov, A. Suaide, A. Kocoloski
 */

/**
 * @file StEmcVirtualSimulator.cxx
 * @ingroup StEmcSimulatorMaker
 * @brief Trivial implementation of the StEmcVirtualSimulator ctor/dtor and
 *        ROOT ClassImp registration.
 */

/**
 * @file StEmcSimpleSimulator.h
 * @ingroup StEmcSimulatorMaker
 * @brief Header for the simple energy-to-ADC BEMC channel simulator.
 *
 * Declares StEmcSimpleSimulator: data members for the sampling fraction,
 * database pointer, ADC limits, embedding flag, and calibration smearing
 * parameters.
 *
 * @author A. Pavlinov, A. Suaide, A. Kocoloski
 */

/**
 * @file StEmcSimpleSimulator.cxx
 * @ingroup StEmcSimulatorMaker
