PROJECT_NAME           = "StFstSimMaker"
PROJECT_BRIEF          = "STAR Forward Silicon Tracker — Fast Monte Carlo Simulator"
PROJECT_NUMBER         = ""

OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO

INPUT                  = ..
FILE_PATTERNS          = *.h *.cxx *.dox
RECURSIVE              = NO
EXCLUDE_PATTERNS       =

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

GENERATE_HTML          = YES
