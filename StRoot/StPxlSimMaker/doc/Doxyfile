# Doxyfile for StPxlSimMaker
# Generated documentation configuration for the STAR PXL detector simulation package.

#---------------------------------------------------------------------------
# Project identity
#---------------------------------------------------------------------------
PROJECT_NAME           = "StPxlSimMaker"
PROJECT_BRIEF          = "STAR Pixel (PXL) Detector Monte Carlo Simulation"
PROJECT_NUMBER         = ""

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# INPUT is relative to the location of this Doxyfile (doc/).
# ".." therefore points at StRoot/StPxlSimMaker/ which contains the 7 source
# files.  DIGMAPS/ is excluded from RECURSIVE processing to keep the output
# focused on the STAR wrapper classes; add DIGMAPS to INPUT explicitly if
# full DIGMAPS class documentation is required.
INPUT                  = ..
RECURSIVE              = NO

# Also pull in the .dox narrative file from this directory
INPUT                 += .

FILE_PATTERNS          = *.h *.cxx *.dox

# Exclude the auto-generated CVS log blocks and the DIGMAPS subdirectory
EXCLUDE                = ../DIGMAPS
EXCLUDE_PATTERNS       = */DIGMAPS/*

#---------------------------------------------------------------------------
# Extraction settings
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

#---------------------------------------------------------------------------
# Build settings
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = YES
SUBGROUPING            = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = ClassDef(name,id)= \
                         ClassImp(name)=

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
OUTPUT_DIRECTORY       = .

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Graph / dot
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

#---------------------------------------------------------------------------
# Verbosity
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
