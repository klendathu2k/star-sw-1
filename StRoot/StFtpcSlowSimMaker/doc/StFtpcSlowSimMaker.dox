/**
 * @file StFtpcSlowSimMaker.h
 * @brief Declaration of StFtpcSlowSimMaker, the STAR Maker wrapper for the
 *        FTPC slow simulator.
 *
 * Holds pointers to all offline-database table objects required by the
 * simulator (geometry, calibrations, gas parameters) and the three
 * monitoring histograms produced per event.
 */

/**
 * @file StFtpcSlowSimMaker.cxx
 * @brief Implementation of StFtpcSlowSimMaker.
 *
 * Contains InitRun() (database loading, magnetic-field flavour selection,
 * time-bin calibration), Init() (histogram booking), Make() (per-event
 * simulation dispatch), and MakeHistograms() (histogram filling).
 */

/**
 * @file StFtpcSlowSimulator.hh
 * @brief Declaration of StFtpcSlowSimulator, the main simulation loop.
 */

/**
 * @file StFtpcSlowSimulator.cc
 * @brief Implementation of StFtpcSlowSimulator::simulate(), the loop that
 *        processes every GEANT hit through the full detector simulation chain.
 */

/**
 * @file StFtpcSlowSimField.hh
 * @brief Declaration of StFtpcSlowSimField.
 *
 * Defines the radial E-field grid and provides fast lookup of drift
 * velocity and Lorentz angle as a function of radius, pad row, and
 * azimuthal angle (for cathode-offset correction).
 */

/**
 * @file StFtpcSlowSimField.cc
 * @brief Implementation of StFtpcSlowSimField.
 *
 * Builds the grid from the slow-sim gas table and the Magboltz database
 * tables; applies independent pressure/temperature corrections for
 * FTPC West and FTPC East; implements cathode-offset geometry correction.
 *
 * Original author: W.G. Gong, gong\@mppmu.mpg.de, Oct 25, 1996.
 */

/**
 * @file StFtpcSlowSimCluster.hh
 * @brief Declaration of StFtpcSlowSimCluster.
 *
 * Represents a single cloud of primary electrons at one GEANT hit point;
 * carries the cluster state (position, spread, charge, drift time) through
 * the drift and diffusion step.
 */

/**
 * @file StFtpcSlowSimCluster.cc
 * @brief Implementation of StFtpcSlowSimCluster.
 *
 * Implements the radial drift loop with Lorentz deflection, longitudinal
 * and transverse diffusion, divergence broadening, and electron attenuation.
 *
 * Original author: W.G. Gong, gong\@mppmu.mpg.de, Oct 25, 1996.
 */

/**
 * @file StFtpcSlowSimReadout.hh
 * @brief Declaration of StFtpcSlowSimReadout.
 *
 * Handles gas amplification (Polya-distributed avalanche), pad-response
 * function, shaper-electronics response, and digitisation into the
 * floating-point ADC array.
 */

/**
 * @file StFtpcSlowSimReadout.cc
 * @brief Implementation of StFtpcSlowSimReadout.
 *
 * Includes the Polya distribution generator for gain fluctuation, the
 * Gaussian integral helper InteGauss(), the Marsaglia–Zaman universal
 * random-number generator (ranmar/rmarin), and the hardware-to-DAQ
 * pad/sector mapping routines GetHardPad() / GetHardSec().
 *
 * Original author: W.G. Gong, gong\@mppmu.mpg.de, Oct 25, 1996.
 */

/**
 * @file StFtpcSlowSimLibs.cc
 * @brief Utility functions shared across the FTPC slow simulator.
 *
 * Currently provides only Locate(), a binary-search routine for
 * monotone arrays.
 *
 * Original author: W.G. Gong, gong\@mppmu.mpg.de, Oct 25, 1996.
 */

/**
 * @file StFtpcRawWriter.hh
 * @brief Declaration of StFtpcRawWriter.
 *
 * Writes simulated ADC data into the three STAR DAQ tables used by the
 * offline cluster finder: fcl_ftpcndx (FTPC index), fcl_ftpcsqndx
 * (sequence index), and fcl_ftpcadc (ADC values).
 */

/**
 * @file StFtpcRawWriter.cc
 * @brief Implementation of StFtpcRawWriter.
 *
 * Applies hardware pad/sector remapping to account for the inversion of
 * pad order in the West FTPC (and optionally in FTPC East for pre-2003
 * data), then encodes the data using the STAR SEQD run-length format with
 * a two-threshold zero-suppression algorithm.
 */

/**
 * @file StFssSectorReader.hh
 * @brief Declaration of StFssSectorReader.
 *
 * Provides a sector-level interface to read back the simulated raw-data
 * tables as if they were real DAQ data, implementing the same API used by
 * the real FTPC DAQ reader.
 */

/**
 * @file StFssSectorReader.cc
 * @brief Implementation of StFssSectorReader.
 *
 * Parses the fcl_ftpcsqndx and fcl_ftpcadc tables for a single hardware
 * sector, building the Pad_array and Row_array internal structures that
 * allow the cluster finder to iterate over pad-rows and sequences in
 * exactly the same way as for real data.
 */

