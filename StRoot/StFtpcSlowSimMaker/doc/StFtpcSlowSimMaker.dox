/**
 * @class StFtpcSlowSimMaker
 * @brief STAR Maker that drives the full FTPC slow simulation for one event.
 * @ingroup StFtpcSlowSimMaker
 *
 * Inherits from StMaker.  Responsibilities:
 * - Load all required offline-database table objects in InitRun().
 * - Select the correct Magboltz drift-map flavour based on the STAR solenoidal
 *   field sign and magnitude (ffp10kv / hfp10kv / zf10kv / hfn10kv / ffn10kv).
 * - Calculate the ADC time-bin width from the RHIC RF clock frequency.
 * - For embedding runs, obtain the ambient gas temperature and pressure from
 *   the online conditions database and compute per-FTPC temperature-corrected
 *   pressures.
 * - Instantiate and invoke StFtpcSlowSimulator for every event that contains
 *   GEANT FTPC hits.
 * - Book and fill three diagnostic histograms.
 *
 * @section data_members Data Members
 *
 * | Member                       | Type                   | Description |
 * |------------------------------|------------------------|-------------|
 * | mDbMaker                     | St_db_Maker *          | Pointer to the STAR database maker |
 * | m_clusterpars                | St_ftpcClusterPars *   | Cluster-finder parameters (StarDb/ftpc) |
 * | m_slowsimgas                 | St_ftpcSlowSimGas *    | Slow-sim gas table (StarDb/ftpc) |
 * | m_slowsimpars                | St_ftpcSlowSimPars *   | Slow-sim tuning parameters (StarDb/ftpc) |
 * | m_dimensions                 | St_ftpcDimensions *    | Geometry: radii, pad counts, timebin count |
 * | m_asicmap                    | St_ftpcAsicMap *       | ASIC mapping flags |
 * | m_efield                     | St_ftpcEField *        | Cathode voltage |
 * | m_vdrift                     | St_ftpcVDrift *        | Magboltz drift velocity table |
 * | m_deflection                 | St_ftpcDeflection *    | Magboltz Lorentz-angle table |
 * | m_dvdriftdp                  | St_ftpcdVDriftdP *     | dv/dP pressure derivative table |
 * | m_ddeflectiondp              | St_ftpcdDeflectiondP * | dθ_L/dP pressure derivative table |
 * | m_ampslope                   | St_ftpcAmpSlope *      | Per-channel gain slope |
 * | m_ampoffset                  | St_ftpcAmpOffset *     | Per-channel gain offset |
 * | m_timeoffset                 | St_ftpcTimeOffset *    | Per-channel time offset (timebins) |
 * | m_driftfield                 | St_ftpcDriftField *    | Radial field geometry (r·E product) |
 * | m_gas                        | St_ftpcGas *           | Gas gain, ionisation potential, attenuation |
 * | m_electronics                | St_ftpcElectronics *   | t₀, µs/timebin |
 * | m_cathode                    | St_ftpcInnerCathode *  | Cathode offset and angle |
 * | m_temps                      | St_ftpcTemps *         | Body temperature sensors |
 * | microsecondsPerTimebin        | float                  | ADC time-bin width (µs), from RHIC clock |
 * | m_nadc                       | TH1F *                 | Histogram: total ADC count per event |
 * | m_nsqndx                     | TH1F *                 | Histogram: sequence index distribution |
 * | m_nadc_index1                | TH2F *                 | Histogram: total ADC vs. FTPC East ADC |
 */

/**
 * @fn StFtpcSlowSimMaker::StFtpcSlowSimMaker(const char *name)
 * @brief Constructor.
 * @param name  Maker name registered with the STAR chain (default "ftpc_raw").
 *
 * Initialises all database-table pointers to zero; histogram pointers are
 * initialised by Init().
 */

/**
 * @fn StFtpcSlowSimMaker::~StFtpcSlowSimMaker()
 * @brief Destructor.  No dynamic memory owned directly by this class.
 */

/**
 * @fn Int_t StFtpcSlowSimMaker::InitRun(int runnumber)
 * @brief Per-run initialisation.
 * @param runnumber  STAR run number for the current run.
 * @return kStOK (0) on success, kStWarn on database failure.
 *
 * Actions performed:
 * -# Query StarMagField for the magnetic field at the origin to compute
 *    the g-factor \f$g = B_z / 4.980\f$ and set the Magboltz drift-map
 *    flavour accordingly.
 * -# Derive \c microsecondsPerTimebin from the RHIC clock frequency
 *    via StDetectorDbClock; fall back to the database default if the
 *    clock is unavailable.
 * -# Retrieve all geometry and calibration database table objects for the
 *    current run timestamp.
 * -# Initialise StFtpcTrackingParams for coordinate rotations.
 * -# Load the StarDb/ftpc parameter tables (\c ftpcClusterPars,
 *    \c ftpcSlowSimGas, \c ftpcSlowSimPars).
 */

/**
 * @fn Int_t StFtpcSlowSimMaker::Init()
 * @brief One-time initialisation.  Books the three monitoring histograms
 *        and delegates to StMaker::Init().
 * @return Return value of StMaker::Init().
 */

/**
 * @fn Int_t StFtpcSlowSimMaker::Make()
 * @brief Per-event simulation.
 * @return kStOK on success, kStWarn if GEANT input tables are absent or
 *         the database reader cannot be constructed.
 *
 * Retrieves the GEANT hit tables (g2t_vertex, g2t_track, g2t_ftp_hit),
 * allocates the output DAQ tables (fcl_ftpcndx, fcl_ftpcsqndx, fcl_ftpcadc),
 * constructs the reader/writer/simulator objects, runs the simulation, and
 * fills the monitoring histograms.  For embedding, also fetches temperature
 * and pressure from the online conditions database and computes
 * per-FTPC adjusted pressures.
 */

/**
 * @fn void StFtpcSlowSimMaker::MakeHistograms()
 * @brief Fills the three diagnostic histograms after simulation.
 *
 * Reads the fcl_ftpcadc, fcl_ftpcndx, and fcl_ftpcsqndx tables from the
 * data store and fills:
 * - \c fss_total_adc  — total number of ADC samples in both FTPCs.
 * - \c fss_sqndx      — sequence-index values.
 * - \c fss_nadc_index1 — (total ADC count) vs. (FTPC East ADC count).
 */

//===========================================================================

/**
 * @class StFtpcSlowSimulator
 * @brief Core simulation loop: iterates over all GEANT hits in the FTPC
 *        sensitive volume and applies the full detector response chain.
 * @ingroup StFtpcSlowSimMaker
 *
 * Owns no persistent state beyond the four pointers set in the constructor.
 * The single public entry point simulate() creates the field and readout
 * objects, allocates the ADC array, loops over hits, and writes the result.
 *
 * @section ss_data_members Data Members
 *
 * | Member   | Type                  | Description |
 * |----------|-----------------------|-------------|
 * | mGeant   | StFtpcGeantReader *   | Access to GEANT hit table (position, momentum, dE) |
 * | mParam   | StFtpcParamReader *   | Access to StarDb parameter tables |
 * | mDb      | StFtpcDbReader *      | Access to offline calibration database |
 * | mWriter  | StFtpcRawWriter *     | Output: encodes ADC data into DAQ tables |
 */

/**
 * @fn StFtpcSlowSimulator::StFtpcSlowSimulator(StFtpcGeantReader *geantReader, StFtpcParamReader *paramReader, StFtpcDbReader *dbReader, StFtpcRawWriter *rawWriter)
 * @brief Constructor.  Stores the four reader/writer pointers; no additional
 *        initialisation is performed.
 * @param geantReader  Provides GEANT hit data (positions, momenta, dE).
 * @param paramReader  Provides StarDb slow-sim and cluster-finder parameters.
 * @param dbReader     Provides offline calibration database values.
 * @param rawWriter    Receives the simulated ADC output.
 */

/**
 * @fn int StFtpcSlowSimulator::simulate()
 * @brief Run the full FTPC simulation for all hits in the current event.
 * @return 1 on success (always).
 *
 * Algorithm outline:
 * -# Construct StFtpcSlowSimField and StFtpcSlowSimReadout.
 * -# Allocate the floating-point ADC array of size
 *    \f$N_\text{row}\times N_\text{sec}\times N_\text{pad}\times N_\text{bin}\f$.
 * -# For each GEANT hit:
 *    - Skip if outside the radial sensitive-volume bounds.
 *    - Rotate global coordinates to local FTPC frame.
 *    - Compute dip angle \f$\lambda\f$ and crossing angle \f$\alpha\f$.
 *    - Calculate \f$N_e\f$, \f$\delta r\f$, \f$\delta\phi\f$.
 *    - Create StFtpcSlowSimCluster, call DriftDiffuse, Avalanche,
 *      PadResponse, ShaperResponse, Digitize.
 * -# Call OutputADC() (apply gain, noise, suppression).
 * -# Call writeArray() (encode to DAQ tables).
 */

/**
 * @fn StFtpcSlowSimulator::~StFtpcSlowSimulator()
 * @brief Destructor.  No dynamic allocations owned by this class.
 */

//===========================================================================

/**
 * @class StFtpcSlowSimField
 * @brief Radial electric field model and drift-parameter lookup for the FTPC.
 * @ingroup StFtpcSlowSimMaker
 *
 * Builds and caches two levels of field description:
 * - A coarse grid (numSlowSimGridPoints points) interpolated from the
 *   slow-sim gas table, used for diffusion accumulation during drift.
 * - A fine Magboltz table (nMagboltzBins × nPadrowPositions) giving
 *   precise drift velocity and Lorentz angle per pad row, corrected for
 *   ambient pressure and temperature independently for each FTPC half.
 *
 * The optional cathode-offset correction modifies the effective inner
 * radius as a function of azimuth \f$\phi\f$, changing the local E-field
 * and hence the drift velocity seen by each cluster.
 *
 * @section field_data_members Data Members
 *
 * | Member                       | Type      | Units             | Description |
 * |------------------------------|-----------|-------------------|-------------|
 * | del_r                        | float     | cm                | Coarse grid step size |
 * | inverseDeltaRadius           | float     | cm⁻¹              | 1/del_r, precomputed for speed |
 * | twoDeltaRadius               | float     | cm                | 2·del_r |
 * | finalVelocity                | float     | cm/µs             | Drift velocity at outer radius (for time→space conversion) |
 * | nMagboltzBins                | int       | —                 | Number of E-field bins in Magboltz table |
 * | nPadrowPositions             | int       | —                 | Number of pad-row positions per side |
 * | EFieldMin                    | float     | V/cm              | Minimum E-field in Magboltz table |
 * | EFieldStep                   | float     | V/cm              | E-field step in Magboltz table |
 * | EFieldStepInverted           | float     | cm/V              | 1/EFieldStep |
 * | EFieldStepInvConverted       | float     | rad·cm/V          | EFieldStepInverted × (π/180) |
 * | radTimesField                | float     | V                 | r·E product (= V/ln(r_out/r_in)) |
 * | innerRadius                  | float     | cm                | Inner sensitive-volume radius |
 * | outerRadius                  | float     | cm                | Outer sensitive-volume radius |
 * | preciseEField                | float *   | V/cm              | E-field values for Magboltz bins |
 * | inverseDriftVelocityWest     | float *   | µs/cm             | 1/v_drift for each (E,padrow) — West |
 * | preciseLorentzAngleWest      | float *   | rad               | Lorentz angle for each (E,padrow) — West |
 * | inverseDriftVelocityEast     | float *   | µs/cm             | 1/v_drift for each (E,padrow) — East |
 * | preciseLorentzAngleEast      | float *   | rad               | Lorentz angle for each (E,padrow) — East |
 * | angleFactor                  | float     | —                 | Lorentz angle correction factor (currently unused) |
 * | mOffsetCathodeWest           | float     | cm                | Cathode offset for West FTPC |
 * | mOffsetCathodeEast           | float     | cm                | Cathode offset for East FTPC |
 * | mAngleOffsetWest             | float     | rad               | Cathode angle offset for West FTPC |
 * | mAngleOffsetEast             | float     | rad               | Cathode angle offset for East FTPC |
 * | grid_point                   | grid_data*| —                 | Array of coarse grid points |
 *
 * The nested \c grid_data struct stores per-grid-point values:
 *
 * | Field       | Type  | Units          | Description |
 * |-------------|-------|----------------|-------------|
 * | rhit        | float | cm             | Radial position |
 * | ef          | float | V/cm           | Electric field magnitude |
 * | vel_z       | float | cm/µs          | Longitudinal drift velocity |
 * | diff_z      | float | µm²/cm         | \f$D_L^2\f$, longitudinal diffusion coefficient squared |
 * | diff_x      | float | µm²/cm         | \f$D_T^2\f$, transverse diffusion coefficient squared |
 * | diff_y      | float | µm²/cm         | Transverse (y) diffusion coefficient squared (not used separately) |
 * | lorentz     | float | rad            | Lorentz deflection angle |
 * | dlnv_dr     | float | cm⁻¹           | \f$d\ln v / dr\f$, drift-velocity gradient |
 */

/**
 * @fn StFtpcSlowSimField::StFtpcSlowSimField(StFtpcParamReader *paramReader, StFtpcDbReader *dbReader)
 * @brief Constructor.  Builds the complete field model from parameter and
 *        database tables.
 * @param paramReader  StarDb slow-sim gas and parameter tables.
 * @param dbReader     Offline calibration database values.
 *
 * Steps performed:
 * -# Allocate and fill the coarse grid from the slow-sim gas table using
 *    Newton polynomial interpolation (Interpolate / InterpValue).
 * -# Compute drift-velocity gradients \f$d\ln v/dr\f$ by backward
 *    differencing on the coarse grid.
 * -# Allocate and fill the precise Magboltz tables for West and East,
 *    applying the pressure correction \f$v = v_0 + (dv/dP)\,\Delta P\f$.
 * -# Store the cathode-offset parameters.
 */

/**
 * @fn StFtpcSlowSimField::~StFtpcSlowSimField()
 * @brief Destructor.  Frees all dynamically allocated arrays.
 */

/**
 * @fn float StFtpcSlowSimField::Interpolate(const int npt, const float *x, const float *y, const int ich, const float xx)
 * @brief Interpolate using Newton's polynomial method.
 * @param npt  Total number of data points in the table.
 * @param x    Array of independent-variable values (size \p npt).
 * @param y    Array of dependent-variable values (size \p npt).
 * @param ich  Index of the nearest lower data point (from Locate()).
 * @param xx   Value at which to interpolate.
 * @return Interpolated value at \p xx.
 *
 * Uses 2-point linear interpolation near the table boundaries and
 * 5-point polynomial interpolation in the interior.
 */

/**
 * @fn float StFtpcSlowSimField::InterpValue(const int npt, const float *x, const float *y, const float xx)
 * @brief Newton-form polynomial interpolation over \p npt points.
 * @param npt  Number of data points (2 or 5).
 * @param x    Independent-variable values.
 * @param y    Dependent-variable values.
 * @param xx   Evaluation point.
 * @return Interpolated value.
 */

/**
 * @fn void StFtpcSlowSimField::GetVelocityZ(const float inverseRadius, const int padrow, const float phi, float *inverseVelocity, float *angle)
 * @brief Return the inverse drift velocity and Lorentz angle at a given
 *        radial position, pad row, and azimuthal angle.
 * @param inverseRadius     \f$1/r\f$ (cm⁻¹) of the current cluster position.
 * @param padrow            Full (0–19) pad-row index; rows 0–9 are West,
 *                          rows 10–19 are East.
 * @param phi               Azimuthal angle of the cluster (rad).
 * @param[out] inverseVelocity  Set to \f$1/v_\text{drift}\f$ (µs/cm).
 * @param[out] angle            Set to the Lorentz deflection angle (rad).
 *
 * If the cathode offset is non-zero, the effective inner radius (and hence
 * the local E-field) is corrected using
 * \f[ r_\text{eff} = \frac{r_\text{in}\,\sin(\pi - \phi - \arcsin(x_\text{off}/r_\text{in}\cdot\sin\phi))}{\sin\phi} \f]
 * The corrected E-field is
 * \f[ E_\text{eff} = r\cdot E_0 \cdot \frac{\ln(r_\text{out}/r_\text{in})}{\ln(r_\text{out}/r_\text{eff})} \cdot \frac{1}{r} \f]
 */

/**
 * @fn void StFtpcSlowSimField::Output() const
 * @brief Debug: write the coarse field grid to the file \c field.dat.
 */

/**
 * @fn int StFtpcSlowSimField::GetGridIndex(const float r) const
 * @brief Convert a radius to a coarse grid index.
 * @param r  Radius (cm).
 * @return Integer grid index \f$\lfloor (r - r_\text{in}) / \delta r \rfloor\f$.
 */

/**
 * @fn float StFtpcSlowSimField::GetVelAtReadout() const
 * @brief Return the drift velocity at the outer sensitive-volume boundary.
 * @return Drift velocity at \f$r_\text{out}\f$ (cm/µs).
 */

/**
 * @fn float StFtpcSlowSimField::GetDeltaRadius() const
 * @brief Return the coarse grid step size \f$\delta r\f$ (cm).
 */

/**
 * @fn float StFtpcSlowSimField::GetInverseDeltaRadius() const
 * @brief Return \f$1/\delta r\f$ (cm⁻¹).
 */

/**
 * @fn float StFtpcSlowSimField::GetTwoDeltaRadius() const
 * @brief Return \f$2\delta r\f$ (cm).
 */

/**
 * @fn float StFtpcSlowSimField::GetDiffusionXSqr(const int i) const
 * @brief Return the transverse diffusion coefficient squared \f$D_T^2\f$
 *        at grid point \p i (µm²/cm).
 */

/**
 * @fn float StFtpcSlowSimField::GetDiffusionZSqr(const int i) const
 * @brief Return the longitudinal diffusion coefficient squared \f$D_L^2\f$
 *        at grid point \p i (µm²/cm).
 */

/**
 * @fn float StFtpcSlowSimField::GetDlnvDr(const int i) const
 * @brief Return \f$d\ln v/dr\f$ at grid point \p i (cm⁻¹), used to
 *        account for the velocity-gradient broadening of the radial cluster
 *        width during drift.
 */

