/**
 * @class StFtpcSlowSimCluster
 * @brief Represents one cloud of primary electrons from a single GEANT hit
 *        during its drift through the FTPC gas.
 * @ingroup StFtpcSlowSimMaker
 *
 * Created per GEANT hit; updated in-place by DriftDiffuse(); read by
 * StFtpcSlowSimReadout for the subsequent avalanche and digitisation steps.
 *
 * @section cluster_data_members Data Members
 *
 * | Member               | Type  | Units   | Description |
 * |----------------------|-------|---------|-------------|
 * | electron             | float | —       | Number of primary electrons in the cluster |
 * | electronLoss         | float | —       | Electrons lost per drift step (\f$= -\delta r \cdot \epsilon_\text{att}\f$) |
 * | sigma_rad_squared    | float | µm²     | Variance of cluster in radial direction |
 * | sigma_phi_squared    | float | µm²     | Variance of cluster in azimuthal direction |
 * | radialDipWidth       | float | cm      | Track-dip geometric width in radial direction |
 * | azimuthalCrossWidth  | float | cm      | Track-crossing geometric width in azimuthal direction |
 * | currentRadius        | float | cm      | Current radial position |
 * | currentPhi           | float | rad     | Current azimuthal position |
 * | drift_time           | float | µs      | Accumulated drift time |
 * | padrow               | int   | —       | Full padrow index 0–19 (used in field lookup) |
 * | original_padrow      | int   | —       | Padrow at creation (debug only) |
 * | outerRadius          | float | cm      | Drift stop radius \f$r_\text{out}\f$ |
 * | deltaRadius          | float | cm      | Drift step size from StFtpcSlowSimField |
 * | twoDeltaRadius       | float | cm      | 2 × drift step size |
 * | mIntDiffCoarseness   | int   | —       | Number of steps between diffusion updates |
 * | mFlDiffCoarseness    | float | —       | Float cast of mIntDiffCoarseness |
 */

/**
 * @fn StFtpcSlowSimCluster::StFtpcSlowSimCluster(StFtpcParamReader *paramReader, StFtpcDbReader *dbReader, StFtpcSlowSimField *field, const float el, const float rad_offset, const float pad_offset, const float r, const float ph, const float time, const int call_padrow)
 * @brief Constructor.  Initialises the cluster state from the GEANT hit
 *        parameters and derives drift step sizes from the field object.
 * @param paramReader  Provides diffusionCoarseness.
 * @param dbReader     Provides sensitiveVolumeOuterRadius, gasAttenuation.
 * @param field        Provides deltaRadius, twoDeltaRadius.
 * @param el           Number of primary electrons (\f$\Delta E / W_i\f$).
 * @param rad_offset   Track-dip geometric spread in radial direction (cm).
 * @param pad_offset   Track-crossing geometric spread in azimuthal direction (cm).
 * @param r            Initial radial position (cm).
 * @param ph           Initial azimuthal position (rad).
 * @param time         Initial drift time (µs); typically \f$-t_0\f$.
 * @param call_padrow  Full padrow index 0–19.
 */

/**
 * @fn void StFtpcSlowSimCluster::DriftDiffuse(StFtpcSlowSimField *field)
 * @brief Drift the cluster radially outward, accumulating Lorentz deflection,
 *        drift time, and azimuthal/radial diffusion.
 * @param field  Electric field model providing drift velocity, Lorentz angle,
 *               and diffusion coefficients at each grid point.
 *
 * The cluster is stepped from \c currentRadius to \c outerRadius in
 * increments of \c deltaRadius.  At each step the Lorentz deflection
 * \f$d\phi = (\delta r / r)\,\theta_L\f$ and time increment
 * \f$dt = \delta r / v_z\f$ are applied.  Every \c mIntDiffCoarseness
 * steps the diffusion variances are updated (see the @ref ftpc_pipeline
 * section for formulas).
 */

/**
 * @fn void StFtpcSlowSimCluster::Print() const
 * @brief Log cluster state to StMessMgr at INFO level (debug helper).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetElectron() const
 * @brief Return the current number of primary electrons.
 */

/**
 * @fn float StFtpcSlowSimCluster::GetSigRad() const
 * @brief Return the radial sigma \f$\sigma_r = \sqrt{\sigma_r^2}\f$ (µm).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetSigPhi() const
 * @brief Return the azimuthal sigma \f$\sigma_\phi = \sqrt{\sigma_\phi^2}\f$ (µm).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetRadOff() const
 * @brief Return the track-dip geometric width in the radial direction (cm).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetPadOff() const
 * @brief Return the track-crossing geometric width in the azimuthal direction (cm).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetRad() const
 * @brief Return the current radial position (cm).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetPhi() const
 * @brief Return the current azimuthal position (rad).
 */

/**
 * @fn float StFtpcSlowSimCluster::GetDriftTime() const
 * @brief Return the accumulated drift time (µs).
 */

