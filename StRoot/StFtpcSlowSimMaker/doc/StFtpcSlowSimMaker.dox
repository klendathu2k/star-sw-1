/**
 * @class StFtpcSlowSimReadout
 * @brief Simulates the FTPC readout electronics: gas avalanche, pad-response
 *        function, shaper-electronics response, and digitisation.
 * @ingroup StFtpcSlowSimMaker
 *
 * @section readout_data_members Data Members
 *
 * | Member                  | Type     | Units    | Description |
 * |-------------------------|----------|----------|-------------|
 * | mParam                  | StFtpcParamReader * | — | Parameter reader |
 * | mDb                     | StFtpcDbReader *    | — | Database reader |
 * | mMaxAdc                 | int      | ADC cnt  | ADC saturation value (typically 255) |
 * | mGaussIntSteps          | int      | —        | Integration sub-steps for InteGauss |
 * | mGasGain                | float    | —        | Mean gas gain |
 * | mOuterRadius            | float    | cm       | Outer sensitive-volume radius |
 * | mInverseFinalVelocity   | float    | µs/cm    | \f$1/v_\text{final}\f$ for time conversion |
 * | mRandomNumberGenerator  | int      | —        | 0 = ROOT TRandom, 1 = ranmar |
 * | mADCArray               | float *  | electrons| Floating-point ADC accumulation array |
 * | mFinalElectrons         | float    | —        | Amplified electrons after avalanche |
 * | sigma_pad               | float    | µm       | Azimuthal sigma after PRF convolution |
 * | pad_off                 | float    | cm       | Azimuthal track-crossing offset |
 * | sigma_tim               | float    | ns       | Radial sigma after shaper convolution |
 * | time_off                | float    | ns       | Radial dip-angle time offset |
 * | number_plane            | int      | —        | Pad rows per FTPC half |
 * | pad_pitch               | float    | cm       | Centre-to-centre pad spacing |
 * | pad_length              | float    | cm       | Pad length in radial direction |
 * | sigma_prf               | float    | µm       | Pad-response function Gaussian sigma |
 * | shaper_time             | float    | ns       | Shaper FWHM |
 * | slice                   | float    | µs       | ADC time-bin width |
 * | pcum                    | float *  | —        | Cumulative Polya CDF (gnch bins) |
 * | gnch                    | int      | —        | Number of bins in Polya CDF (50) |
 * | glow / ghigh / gdelta   | float    | —        | Polya table range and step (0.1–2.5) |
 * | phiMin / phiMax         | float    | rad      | Azimuthal range of one sector |
 * | uc                      | raset1   | —        | Internal state for Marsaglia–Zaman RNG |
 */

/**
 * @fn StFtpcSlowSimReadout::StFtpcSlowSimReadout(StFtpcParamReader *paramReader, StFtpcDbReader *dbReader, float *adcIn, const StFtpcSlowSimField *field)
 * @brief Constructor.  Initialises all readout parameters, zeros the ADC
 *        array, and pre-computes the Polya cumulative distribution.
 * @param paramReader  Provides sigma_prf, shaper_time, adcConversion,
 *                     randomNumberGenerator, maxAdc, gaussIntegrationSteps,
 *                     zeroSuppressThreshold.
 * @param dbReader     Provides pad geometry, gas gain, time-bin width,
 *                     sector angular boundaries, gain calibration tables.
 * @param adcIn        Pre-allocated floating-point array of size
 *                     \f$N_\text{row}\times N_\text{sec}\times N_\text{pad}\times N_\text{bin}\f$.
 * @param field        Provides \c GetVelAtReadout() for the time–space conversion.
 */

/**
 * @fn void StFtpcSlowSimReadout::Avalanche(const StFtpcSlowSimCluster *cl)
 * @brief Sample the gas multiplication using the Polya distribution.
 * @param cl  Input cluster; only GetElectron() is used.
 *
 * Electrons are grouped into bundles of 10 to save CPU.  Each bundle
 * draws one sample from the Polya CDF via sample_polya() and the total
 * is rescaled by the group size.  The result is stored in
 * \c mFinalElectrons.
 *
 * The Polya distribution used is
 * \f[ P(k;\,m) = \frac{m\,(mk)^{m-1} e^{-mk}}{\Gamma(m)}, \quad m=\tfrac{3}{2} \f]
 * which gives a relative variance \f$\sigma^2/\mu^2 = 1/m = 2/3\f$.
 */

/**
 * @fn void StFtpcSlowSimReadout::PadResponse(const StFtpcSlowSimCluster *cl)
 * @brief Convolve the azimuthal cluster width with the pad-response function.
 * @param cl  Cluster after drift; provides GetSigPhi() and GetPadOff().
 *
 * \f[ \sigma_\text{pad} = \sqrt{\sigma_\phi^2 + \sigma_\text{PRF}^2} \f]
 * Units: µm.
 */

/**
 * @fn void StFtpcSlowSimReadout::ShaperResponse(const StFtpcSlowSimCluster *cl)
 * @brief Convolve the radial time width with the electronics shaper response.
 * @param cl  Cluster after drift; provides GetSigRad() and GetRadOff().
 *
 * The radial sigma in µm is converted to nanoseconds via
 * \f$\sigma_t = \sigma_r / v_\text{final}\f$.
 * The shaper sigma is \f$\sigma_s = \tau_\text{FWHM} / 2.355\f$.
 * The combined time sigma is \f$\sigma_\text{tim} = \sqrt{\sigma_t^2 + \sigma_s^2}\f$.
 */

/**
 * @fn void StFtpcSlowSimReadout::Digitize(const StFtpcSlowSimCluster *cl, const int irow)
 * @brief Map the cluster onto the pad/timebin grid and accumulate charge.
 * @param cl    Cluster after PRF and shaper convolution.
 * @param irow  FTPC row index 0–19.
 *
 * The cluster is optionally split into \f$2n_\text{sub}+1\f$ sub-hits along
 * the track direction.  For each sub-hit the azimuthal Gaussian is
 * integrated over each pad cell via InteGauss() and the time Gaussian is
 * integrated over each timebin cell; the product weights \c mFinalElectrons
 * into \c mADCArray.  A per-channel time offset from the database is applied
 * before the time binning.  Clusters spanning multiple azimuthal sectors
 * are handled by looping over the required sector range.
 */

/**
 * @fn void StFtpcSlowSimReadout::OutputADC()
 * @brief Convert the floating-point ADC array to integer ADC counts,
 *        applying gain calibration, white noise, zero-suppression, and
 *        saturation clipping.
 *
 * For each non-zero cell:
 * -# Scale by \c 1/adcConversion.
 * -# Subtract the per-channel amplitude offset and divide by the
 *    per-channel amplitude slope (from \c ftpcAmpOffset / \c ftpcAmpSlope).
 * -# Add Gaussian noise of \f$\sigma = 1.5\f$ ADC counts.
 * -# Zero values below the suppression threshold.
 * -# Clip to \c maxAdc (255).
 */

/**
 * @fn float StFtpcSlowSimReadout::PhiOfPad(const int pad, const int deg_or_rad)
 * @brief Return the azimuthal centre of pad \p pad (within one sector).
 * @param pad         0-based pad index within a sector.
 * @param deg_or_rad  Ignored; always returns radians.
 * @return \f$(\text{pad}+0.5)\,\Delta\phi_\text{pad} + \Delta\phi_\text{boundary}/2\f$ (rad).
 */

/**
 * @fn int StFtpcSlowSimReadout::WhichPad(const float phi, int &isec)
 * @brief Find the pad index and sector number for azimuthal angle \p phi.
 * @param phi    Azimuthal position (rad).
 * @param[out] isec  Set to the 0-based sector index (0–5).
 * @return 0-based pad index within the sector (clamped to [0, nPads-1]).
 */

/**
 * @fn int StFtpcSlowSimReadout::WhichSlice(const float time)
 * @brief Convert a drift time to a timebin index.
 * @param time  Drift time (ns).
 * @return Timebin index (clamped to valid range).
 */

/**
 * @fn float StFtpcSlowSimReadout::TimeOfSlice(const int slice)
 * @brief Return the centre time of timebin \p slice (ns).
 * @param slice  Timebin index.
 * @return \f$(\text{slice}+0.5)\times 1000 \times \mu\text{s/timebin}\f$ (ns).
 */

/**
 * @fn float StFtpcSlowSimReadout::InteGauss(const float x_1, const float x_2, const float x_0, const float sig)
 * @brief Numerically integrate a Gaussian over the interval [x_1, x_2].
 * @param x_1  Lower integration bound.
 * @param x_2  Upper integration bound.
 * @param x_0  Gaussian mean.
 * @param sig  Gaussian sigma.
 * @return \f$\int_{x_1}^{x_2} \frac{1}{\sigma\sqrt{2\pi}}\exp\left(-\frac{(x-x_0)^2}{2\sigma^2}\right)dx\f$
 *         (approximated by a midpoint Riemann sum with \c mGaussIntSteps sub-intervals).
 */

/**
 * @fn int StFtpcSlowSimReadout::GetHardPad(const int daqsec, const int daqpad, const int irow)
 * @brief Map a DAQ pad number to the corresponding hardware pad number.
 * @param daqsec  DAQ sector index.
 * @param daqpad  DAQ pad index.
 * @param irow    FTPC row index 0–19.
 * @return Hardware pad index for database gain/offset table access.
 *
 * In the West FTPC (rows 0–9) and the outer FEE cards of the East FTPC
 * (rows 10–19, excluding pads 64–95 for pre-2003 data), the pad order is
 * reversed: \f$\text{hwPad} = N_\text{pads} - \text{daqpad} - 1\f$.
 */

/**
 * @fn int StFtpcSlowSimReadout::GetHardSec(const int daqsec, const int irow)
 * @brief Map a DAQ sector number to the corresponding hardware sector number.
 * @param daqsec  DAQ sector index.
 * @param irow    FTPC row index 0–19.
 * @return Hardware sector index for database access.
 *
 * For the West FTPC the sector order is reversed:
 * \f$\text{hwSec} = N_\text{sectors} - \text{daqsec} - 1\f$.
 * The East FTPC sector order matches DAQ.
 */

/**
 * @fn void StFtpcSlowSimReadout::polya(const int nch, const float low, const float high, const float delta)
 * @brief Pre-compute the cumulative Polya distribution CDF table.
 * @param nch    Number of bins (50).
 * @param low    Lower bound of relative gain range (0.1).
 * @param high   Upper bound of relative gain range (2.5).
 * @param delta  Bin width \f$= (\text{high}-\text{low})/\text{nch}\f$.
 *
 * Uses \f$m=3/2\f$, \f$C = m^m/\Gamma(m) = 1.6926\f$.
 */

/**
 * @fn int StFtpcSlowSimReadout::sample_polya(const float gain)
 * @brief Sample the Polya distribution for a given mean gain.
 * @param gain  Mean gas gain \f$G\f$.
 * @return Number of electrons produced by one input electron, drawn from
 *         \f$G\cdot P(k;\,m=3/2)\f$.
 */

/**
 * @fn float StFtpcSlowSimReadout::ranmar()
 * @brief Marsaglia–Zaman universal random number generator.
 * @return Uniform pseudorandom float on [0, 1).
 *
 * Based on the Marsaglia–Zaman algorithm (FSU-SCRI-87-50), as described
 * by F. James (CERN SOFTWR 88-20).  Used only when
 * \c randomNumberGenerator == 1.
 */

/**
 * @fn void StFtpcSlowSimReadout::rmarin(int ij, int kl)
 * @brief Initialise the Marsaglia–Zaman RNG.
 * @param ij  First seed integer (0–31328).
 * @param kl  Second seed integer (0–30081).
 *
 * Standard Marsaglia–Zaman seed values: ij=1802, kl=9373.
 */

//===========================================================================

/**
 * @class StFtpcRawWriter
 * @brief Writes simulated FTPC ADC data into the three STAR DAQ tables
 *        (\c fcl_ftpcndx, \c fcl_ftpcsqndx, \c fcl_ftpcadc).
 * @ingroup StFtpcSlowSimMaker
 *
 * Implements the same run-length encoding used by the real STAR FTPC
 * DAQ, so the output can be processed by the offline cluster finder
 * without modification.
 *
 * @section raw_data_members Data Members
 *
 * | Member                | Type                 | Description |
 * |-----------------------|----------------------|-------------|
 * | mAsic2EastNotInverted | int (bool)           | Flag: if true, centre FEE card pads in East FTPC are not reversed (pre-2003 data) |
 * | ndx                   | FCL_FTPCNDX_ST *     | Pointer to ndx table rows |
 * | numNdx / maxNdx       | int                  | Current / maximum rows in ndx |
 * | sqndx                 | FCL_FTPCSQNDX_ST *   | Pointer to sqndx table rows |
 * | numSqndx / maxSqndx   | int                  | Current / maximum rows in sqndx |
 * | adc                   | FCL_FTPCADC_ST *     | Pointer to adc table rows |
 * | numAdc / maxAdc       | int                  | Current / maximum rows in adc |
 * | ftpcndx/sqndx/adc     | St_fcl_ftpc* *       | ROOT table objects |
 */

/**
 * @fn StFtpcRawWriter::StFtpcRawWriter(St_fcl_ftpcndx *ftpcndxIn, St_fcl_ftpcsqndx *ftpcsqndxIn, St_fcl_ftpcadc *ftpcadcIn, const int inAsic2EastNotInverted)
 * @brief Constructor.  Stores the three output table objects and caches
 *        their current row counts and maximum capacities.
 * @param ftpcndxIn              FTPC index table (2 rows: West start, East start).
 * @param ftpcsqndxIn            FTPC sequence-index table (up to 500000 rows).
 * @param ftpcadcIn              FTPC ADC table (up to 2000000 rows).
 * @param inAsic2EastNotInverted ASIC mapping flag for pre-2003 East FTPC data.
 */

/**
 * @fn StFtpcRawWriter::~StFtpcRawWriter()
 * @brief Destructor.  Updates the \c NRows fields of the three ROOT tables
 *        to reflect the actual number of filled rows.
 */

/**
 * @fn int StFtpcRawWriter::writeArray(float *array, int numberPadrows, int numberSectors, int numberPads, int numberTimebins, int threshold)
 * @brief Convert the floating-point ADC array to the STAR SEQD DAQ format.
 * @param array           Floating-point ADC array
 *                        [row × sector × pad × timebin] (simulation ordering).
 * @param numberPadrows   Total pad rows (both FTPCs combined; typically 20).
 * @param numberSectors   Number of sectors per pad row (typically 6).
 * @param numberPads      Number of pads per sector (typically 160).
 * @param numberTimebins  Number of time bins (typically 256).
 * @param threshold       Zero-suppression threshold (ADC counts).
 * @return 1 on success.
 *
 * Algorithm:
 * -# Create a copy array \c cArray with hardware-ordered pad/sector indices
 *    (West FTPC: pads and sectors reversed; East FTPC: pads reversed,
 *    sectors unchanged; with special handling for the centre FEE card in
 *    pre-2003 East data).
 * -# Apply a two-threshold zero-suppression: a sequence is valid if it
 *    contains at least one sample above \c th_high (5 ADC) and at least
 *    \c minAboveLow (2) samples above \c th_low (2 ADC).
 * -# Encode valid samples into the SEQD format:
 *    - \c ndx[0].index = 0 (West FTPC start), \c ndx[1].index = first East sequence.
 *    - Each sequence header in \c sqndx encodes pad/sector/row address
 *      (when the pad changes) or length and start bin (for data sequences).
 *    - Each ADC byte is written to \c adc.
 */

//===========================================================================

/**
 * @class StFssSectorReader
 * @brief Read the simulated FTPC raw-data tables as if they were real DAQ
 *        data for one hardware sector.
 * @ingroup StFtpcSlowSimMaker
 *
 * Implements the same pad-list and sequence-access API as the real FTPC
 * DAQ reader, allowing the offline cluster finder to process simulated and
 * real data identically.
 *
 * @section sector_reader_data_members Data Members
 *
 * | Member        | Type              | Description |
 * |---------------|-------------------|-------------|
 * | mSector       | int               | Hardware sector number (1-based) |
 * | m_ftpcsqndx   | unsigned short *  | Pointer to sequence-index array |
 * | m_ftpcadc     | char *            | Pointer to ADC byte array |
 * | m_numSqndx    | int               | Number of entries in sqndx |
 * | m_numAdc      | int               | Number of ADC bytes |
 * | Pad_array     | Pad[FTP_PADROWS][FTP_MAXPADS] | Per-pad sequence metadata |
 * | Row_array     | PadRow[FTP_PADROWS] | Per-row pad count |
 * | padlist       | uint8_t[FTP_PADROWS][FTP_MAXPADS] | Pad numbers that have data |
 */

/**
 * @fn StFssSectorReader::StFssSectorReader(int sector, unsigned short *fcl_ftpcsqndx, int nSeq, char *fcl_ftpcadc, int nAdc)
 * @brief Constructor.  Stores the sector number and pointers to the two
 *        raw-data arrays.  Call initialize() before use.
 * @param sector         Hardware sector number (1-based).
 * @param fcl_ftpcsqndx  Sequence-index array from \c fcl_ftpcsqndx table.
 * @param nSeq           Number of entries in the sequence-index array.
 * @param fcl_ftpcadc    ADC byte array from \c fcl_ftpcadc table.
 * @param nAdc           Number of ADC bytes.
 */

/**
 * @fn StFssSectorReader::~StFssSectorReader()
 * @brief Destructor.  Frees the Sequence arrays allocated by initialize().
 */

/**
 * @fn int StFssSectorReader::initialize()
 * @brief Parse the raw-data tables and build the internal Pad_array and
 *        Row_array structures.
 * @return TRUE on success, FALSE if a format error is detected.
 *
 * Makes two passes over the sequence-index table:
 * -# First pass: count sequences per pad to determine malloc sizes.
 * -# Second pass: fill the Sequence structs with start time, length, and
 *    pointer into the ADC array.
 */

/**
 * @fn int StFssSectorReader::getPadList(int PadRow, unsigned char **padList)
 * @brief Return the list of pads with data in \p PadRow.
 * @param PadRow          1-based pad row index.
 * @param[out] padList    Set to point to the padlist array for this row.
 * @return Number of pads with data, or -1 on invalid row number.
 */

/**
 * @fn int StFssSectorReader::getSequences(int PadRow, int Pad, int *nSeq, Sequence **SeqData)
 * @brief Return the sequences for a given pad row and pad.
 * @param PadRow          1-based pad row index.
 * @param Pad             1-based pad index.
 * @param[out] nSeq       Set to the number of sequences on this pad.
 * @param[out] SeqData    Set to point to the Sequence array for this pad.
 * @return 0 always.
 */

//===========================================================================

/**
 * @fn int Locate(const int npt, const float *x, const float xx)
 * @brief Binary search for a value in a sorted array.
 * @ingroup StFtpcSlowSimMaker
 * @param npt  Number of elements in array \p x.
 * @param x    Monotonically increasing or decreasing array of \p npt floats.
 * @param xx   Value to locate.
 * @return Index \f$j\f$ such that \f$x[j] \le xx \le x[j+1]\f$ (or 0 if
 *         \p xx is out of range, with a warning).
 *
 * Used by both StFtpcSlowSimField (to locate the E-field bin in the
 * gas table) and StFtpcSlowSimReadout::sample_polya (to invert the
 * cumulative Polya CDF).
 */
